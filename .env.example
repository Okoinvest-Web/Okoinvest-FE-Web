# .env.example – Vorlage für Umgebungsvariablen der ÖkoInvest-Website (W0-1)
#
# KEINE GEHEIMNISSE IN DIESE DATEI. Sie ist eingecheckt; echte Werte gehören
# in .env.local (lokal, per .gitignore ausgeschlossen) bzw. in die
# Secret-Verwaltung des Hostings. Leere Werte = nicht gesetzt.
# Variablen mit NEXT_PUBLIC_ werden zur Build-Zeit in den Browser-Code
# eingebaut – dort nie etwas Vertrauliches eintragen.

# ---------------------------------------------------------------------------
# Website, Domain und Indexierung (Paket I, src/lib/indexsteuerung.js)
# ---------------------------------------------------------------------------
# Basis-URL ohne abschließenden Schrägstrich und ohne Pfad. PFLICHT in jedem
# Produktions-Build (next build / next start) – ohne Wert bricht der Build ab.
# Produktion: https://www.oekoinvest.com · Staging: eigene URL der Staging-Umgebung.
NEXT_PUBLIC_SITE_URL=

# Umgebung: production | staging | preview | development
# Indexiert wird NUR bei production UND NEXT_PUBLIC_SITE_URL=https://www.oekoinvest.com.
# Alles andere (auch ein fehlender Wert) liefert noindex und robots.txt „Disallow: /“.
NEXT_PUBLIC_SITE_ENV=

# Bestätigungscodes Google Search Console / Bing Webmaster Tools (öffentlich, optional; Welle 3, Paket NL)
# Nur der Code aus dem content-Attribut, NICHT das ganze Meta-Tag – erlaubt sind Buchstaben, Ziffern, „-“, „_“
# (6–100 Zeichen, src/lib/verifizierung.js). Ohne Wert entsteht kein Meta-Tag. Wirksam nach neuem Build.
# Ablauf (Inhaber, nach Domainkauf): Property „https://www.oekoinvest.com“ in Search Console bzw. Bing anlegen,
# Methode „HTML-Tag“ wählen, Code hier eintragen, bauen, dann bestätigen. Bing kann die Search-Console-Property
# auch importieren (dann bleibt NEXT_PUBLIC_BING_VERIFICATION leer). Sitemap: https://www.oekoinvest.com/sitemap.xml
#   Google: <meta name="google-site-verification" content="CODE">  → NEXT_PUBLIC_GSC_VERIFICATION=CODE
#   Bing:   <meta name="msvalidate.01" content="CODE">              → NEXT_PUBLIC_BING_VERIFICATION=CODE
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

# Google Analytics 4 Mess-ID (öffentlich; nur nach Einwilligung aktiv)
NEXT_PUBLIC_GA_ID=

# Abweichendes Build-Verzeichnis (nur für Prüf-Builds neben einem laufenden Server)
NEXT_DIST_DIR=

# ---------------------------------------------------------------------------
# Plattform-Backend (src/lib/plattform/backend)
# ---------------------------------------------------------------------------
# frappe = produktives Backend; ohne Wert läuft das Demo-Backend
# (im Produktions-Build 503, außer PLATTFORM_DEMO=1).
PLATTFORM_BACKEND=
PLATTFORM_DEMO=
# Öffentliche Basis-URL der Plattform (Links in Mails usw.); Standard: NEXT_PUBLIC_SITE_URL
PLATTFORM_BASIS_URL=
# Zusätzlich erlaubte Origins für Plattform-Anfragen, kommagetrennt
PLATTFORM_ORIGINS=
PLATTFORM_RATE_FAKTOR=
PLATTFORM_2FA_PFLICHT=
PLATTFORM_HIBP=
PLATTFORM_KYC_GATING=
PLATTFORM_BONITAET_VOR_LOI=

# Frappe/ERPNext-Verbindung (src/lib/apiBaseUrl.js) – API_KEY/API_SECRET sind Geheimnisse
SERVER=
API_KEY=
API_SECRET=

# Postfächer für Anfragen je Land (Funktionspostfächer – noch nicht freigegeben, W0-3)
ANFRAGE_POSTFACH_AT=
ANFRAGE_POSTFACH_CH=

# ---------------------------------------------------------------------------
# Sicherheit (Geheimnisse – nur im Secret-Store setzen)
# ---------------------------------------------------------------------------
SESSION_SECRET=
PLATTFORM_2FA_SCHLUESSEL=
PLATTFORM_KYC_SCHLUESSEL=
PLATTFORM_KYC_SCHLUESSEL_ALT=
SPERRLISTE_PFEFFER=
EID_BPK_PEPPER=
IDENT_WEBHOOK_SECRET=
# Anzahl vertrauenswürdiger Proxy-Hops für die Client-IP (ganze Zahl 1–10, src/lib/ipAdresse.js)
TRUSTED_PROXY_HOPS=
# Nur Demo/Entwicklung
PLATTFORM_DEMO_PASSWORT=

# ---------------------------------------------------------------------------
# KI-Dienst (src/lib/plattform/ki) – Triage bleibt aus, bis Strang R sie freigibt
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
KI_MODELL=
KI_FALLBACK=
KI_AUS=
KI_TRIAGE=
KI_TAGESKONTINGENT=
KI_TAGESKONTINGENT_ADMIN=

# ---------------------------------------------------------------------------
# Externe Dienste (URLs öffentlich, Schlüssel/Token geheim)
# ---------------------------------------------------------------------------
GEODATEN_URL=
GEODATEN_TOKEN=
CAD_KONVERTER_URL=
CAD_KONVERTER_TOKEN=
ANLAGEN_DATEN_URL=
ANLAGEN_DATEN_TOKEN=
ANLAGEN_MQTT_HOST=
ANLAGEN_MQTT_PORT=
ANLAGEN_SIMULATOR=
BONITAET_ANBIETER=
BONITAET_PRODUKT=
BONITAET_API_URL=
BONITAET_API_KEY=
IDENT_ANBIETER=
IDENT_STUFE=
IDENT_API_URL=
IDENT_API_KEY=
IDENT_API_SECRET=
FIRMENBUCH_API_URL=
FIRMENBUCH_API_KEY=
HANDELSREGISTER_API_URL=
HANDELSREGISTER_API_KEY=
ZEFIX_API_URL=
ZEFIX_BENUTZER=
ZEFIX_PASSWORT=

# Bankverbindung für Rechnungen/Finanzen (keine Geheimnisse, aber nicht im Repo pflegen)
FINANZEN_IBAN=
FINANZEN_BIC=
FINANZEN_UID=

# Nur Entwicklung/Simulation
EDA_SIM_ZEITRAFFER_MS=
