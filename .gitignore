# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Vorlage ohne Geheimnisse wird eingecheckt (W0-1)
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# isoliertes Build-Verzeichnis fuer Verifikation
.next-verify/
.next-dev2/

.next-dev3/

# Demo-Datenbank des Portals (lokal)
/.data/
# Lokale Sicherungen der Demo-Datenbank (scripts/demo-sicherung.mjs)
/.data-sicherungen/
.next-verify/

# Python
__pycache__/
*.pyc
.data-alt-*/
.dev-server.log

# temporäre Skripte (z. B. Agenten-Läufe), W0-1
*.tmp.js

# Rohes Sitzungsprotokoll (groß, reist nur per Ordnerkopie mit)
uebergabe/chatverlauf/*.jsonl

# Versehentlich im Projekt angelegter Werkzeug-Ordner
/Claude/
