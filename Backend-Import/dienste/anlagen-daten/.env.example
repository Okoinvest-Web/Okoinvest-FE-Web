# Ingest-Dienst „anlagen-daten“ – Beispielwerte OHNE echte Geheimnisse. Als .env kopieren (steht in .gitignore).
# Geheimnisse erzeugen z. B. mit: openssl rand -base64 48

# TimescaleDB (docker-compose setzt DATABASE_URL daraus)
POSTGRES_PASSWORD=bitte-zufaellig-erzeugen
# DATABASE_URL=postgres://anlagen:...@timescaledb:5432/anlagen   (außerhalb von Compose)
# DATABASE_CA_DATEI=/zertifikate/db-ca.crt
DATABASE_POOL=10

# MQTT – Dienstkonto zum Abonnieren (nicht in Frappe; Prüfung im Auth-Hook zeitkonstant), mind. 24 Zeichen
# MQTT_URL=mqtts://mosquitto:8883
# MQTT_CA_DATEI=/zertifikate/ca.crt
DIENST_MQTT_BENUTZER=anlagen-dienst
DIENST_MQTT_PASSWORT=bitte-zufaellig-erzeugen-mind-24-zeichen

# Abfrage-API für die Website (Bearer-Token, mind. 32 Zeichen) – derselbe Wert als ANLAGEN_DATEN_TOKEN auf der Website
HTTP_PORT=8443
DIENST_TOKEN=bitte-zufaellig-erzeugen-mind-32-zeichen
# HTTP_TLS_KEY_DATEI=/zertifikate/api.key
# HTTP_TLS_CERT_DATEI=/zertifikate/api.crt
LIVE_MAX_JE_ANLAGE=50

# Broker-Auth-Hook (nur internes Netz, Port nicht veröffentlichen)
AUTH_PORT=8081
# AUTH_HOOK_TOKEN=   (optional, für EMQX als Kopfzeile X-Auth-Token)

# Frappe: eigener API-Benutzer NUR mit Rolle „ÖkoInvest Anlagen-Dienst“
FRAPPE_URL=https://erp.example.com
FRAPPE_API_KEY=api-key-des-dienstbenutzers
FRAPPE_API_SECRET=api-secret-des-dienstbenutzers
# Eigene CA für Frappe/HTTPS: NODE_EXTRA_CA_CERTS=/zertifikate/ca.crt

# Störungsregeln
REGEL_OFFLINE_MINUTEN=15
REGEL_MINDERLEISTUNG_QUOTE=0.6
REGEL_SONNE_MIN_ANTEIL=0.2
REGEL_SPRUNG_FAKTOR=1.5
REGEL_INTERVALL_S=60
ZUGAENGE_AKTUALISIEREN_S=60
LOG_STUFE=info
