# EDA-Gateway – Beispielkonfiguration. Kopieren nach .env (steht nicht im Repository) und echte Werte eintragen.
# Keine Zugangsdaten in Code, Tickets oder Logs. Zertifikate/Schlüssel als Dateien mit Rechten 0600.

# Adapter: email | kep | datei | simulator (simulator nur Test/Demo)
EDA_ADAPTER=datei
EDA_INTERVALL_S=60
EDA_TIMEOUT_S=30
EDA_VERSUCHE=4
EDA_ORDNER=/var/lib/eda-gateway

# Plattform (Frappe): API-Benutzer mit Rolle „ÖkoInvest EDA-Gateway“ (bis zur Fixture: „ÖkoInvest API“)
EDA_FRAPPE_URL=https://backend.example.com
EDA_FRAPPE_API_KEY=
EDA_FRAPPE_API_SECRET=
# eigene CA (optional), TLS-Prüfung bleibt immer an
EDA_CA_DATEI=

# E-Mail-Anbindung (EDA-Plattformvertrag; Adressen je Marktpartner laut EDA, JSON {"AT003000": "…"})
EDA_SMTP_HOST=
EDA_SMTP_PORT=465
EDA_IMAP_HOST=
EDA_IMAP_PORT=993
EDA_IMAP_ORDNER=INBOX
EDA_IMAP_ORDNER_ERLEDIGT=
EDA_EMAIL_BENUTZER=
EDA_EMAIL_PASSWORT=
EDA_EMAIL_ABSENDER=
EDA_EMAIL_ADRESSEN=/etc/eda-gateway/adressen.json
# S/MIME (optional, benötigt das Programm openssl): eigenes Zertifikat + Schlüssel, Partnerzertifikate als <Marktpartner>.pem
EDA_SMIME_ZERT=
EDA_SMIME_SCHLUESSEL=
EDA_SMIME_PARTNER_ORDNER=
EDA_SMIME_CA=

# KEP (Kommunikationsendpunkt): ordner | https
EDA_KEP_MODUS=ordner
EDA_KEP_ORDNER=
EDA_KEP_URL=
EDA_KEP_ZERT=
EDA_KEP_SCHLUESSEL=

# Simulator (nur Test/Demo)
EDA_SIM_SEED=gateway
EDA_SIM_SEKUNDEN_JE_TAG=60
