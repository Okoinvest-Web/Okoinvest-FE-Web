<script setup lang="ts">
/** Einheitliche Statusfarben für Protokolle, Mängel, Berichte und Messwerte. */
import { computed } from 'vue'

const props = defineProps<{ wert?: string | null; klein?: boolean }>()

const STIL: Record<string, string> = {
  // Prüfstatus
  OK: 'bg-ov-100 text-ov-800 dark:bg-ov-900/50 dark:text-ov-300',
  Warnung: 'bg-amber-100 text-amber-900 dark:bg-amber-900/50 dark:text-amber-200',
  Fehler: 'bg-red-100 text-red-800 dark:bg-red-900/50 dark:text-red-300',
  Offen: 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300',
  Uebersprungen: 'bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-400',

  // Protokoll
  Entwurf: 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300',
  'In Arbeit': 'bg-navy-100 text-navy-800 dark:bg-navy-900/50 dark:text-navy-300',
  Abgeschlossen: 'bg-marke-100 text-marke-700 dark:bg-marke-900/50 dark:text-marke-300',
  Verifiziert: 'bg-ov-100 text-ov-800 dark:bg-ov-900/50 dark:text-ov-300',
  Storniert: 'bg-slate-200 text-slate-500 line-through dark:bg-slate-800',

  // Mangel
  'In Bearbeitung': 'bg-navy-100 text-navy-800 dark:bg-navy-900/50 dark:text-navy-300',
  Erledigt: 'bg-marke-100 text-marke-700 dark:bg-marke-900/50 dark:text-marke-300',
  Verworfen: 'bg-slate-200 text-slate-500 dark:bg-slate-800',

  // Tagesbericht
  Eingereicht: 'bg-amber-100 text-amber-900 dark:bg-amber-900/50 dark:text-amber-200',
  Genehmigt: 'bg-ov-100 text-ov-800 dark:bg-ov-900/50 dark:text-ov-300',
  Abgelehnt: 'bg-red-100 text-red-800 dark:bg-red-900/50 dark:text-red-300',

  // Gesamtbewertung
  Bestanden: 'bg-ov-100 text-ov-800 dark:bg-ov-900/50 dark:text-ov-300',
  'Bestanden mit Auflagen': 'bg-amber-100 text-amber-900 dark:bg-amber-900/50 dark:text-amber-200',
  'Nicht bestanden': 'bg-red-100 text-red-800 dark:bg-red-900/50 dark:text-red-300',

  // Anlagenstatus
  Geplant: 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300',
  'In Bau': 'bg-amber-100 text-amber-900 dark:bg-amber-900/50 dark:text-amber-200',
  'In Betrieb': 'bg-ov-100 text-ov-800 dark:bg-ov-900/50 dark:text-ov-300',
  'Ausser Betrieb': 'bg-slate-200 text-slate-500 dark:bg-slate-800',

  // Schweregrade
  A: 'bg-red-100 text-red-800 dark:bg-red-900/50 dark:text-red-300',
  B: 'bg-amber-100 text-amber-900 dark:bg-amber-900/50 dark:text-amber-200',
  C: 'bg-navy-100 text-navy-800 dark:bg-navy-900/50 dark:text-navy-300',
}

const klasse = computed(
  () => STIL[props.wert ?? ''] ?? 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300',
)
const beschriftung = computed(() => (props.wert === 'Ausser Betrieb' ? 'Außer Betrieb' : props.wert))
</script>

<template>
  <span v-if="wert" class="abzeichen" :class="[klasse, klein ? 'px-2 py-0 text-[10px]' : '']">
    {{ beschriftung }}
  </span>
</template>
