<script setup lang="ts">
/** Startseite mit KPIs, offenen Aufgaben und anstehenden Wartungen (Kapitel 6.1). */
import { computed, onMounted, ref } from 'vue'
import { useRouter } from 'vue-router'

import AppIcon from '@/components/AppIcon.vue'
import StatusAbzeichen from '@/components/StatusAbzeichen.vue'
import { baudoku } from '@/lib/api'
import { db } from '@/lib/db'
import { datum, prozent, relativ, tageBis } from '@/lib/format'
import type { Protokoll } from '@/lib/typen'
import { useStammdaten } from '@/stores/stammdaten'
import { useSync } from '@/stores/sync'

const router = useRouter()
const stammdaten = useStammdaten()
const sync = useSync()

interface Kennzahlen {
  offene_maengel: number
  ueberfaellige_maengel: number
  meine_maengel: number
  protokolle_in_arbeit: number
  protokolle_zu_verifizieren: number
  berichte_zur_freigabe: number
  anlagen_in_bau: number
  anlagen_gesamt: number
  wartungen_faellig: number
}

interface Aufgabe {
  name: string
  titel: string
  anlage: string
  schweregrad: string
  status: string
  faellig_am?: string
  ueberfaellig?: 0 | 1
}

const kennzahlen = ref<Kennzahlen | null>(null)
const wartungen = ref<{ name: string; anlage_name: string; naechste_wartung: string; ort?: string }[]>([])
const aufgaben = ref<Aufgabe[]>([])
const lokaleEntwuerfe = ref<Protokoll[]>([])
const laedt = ref(true)

const kacheln = computed(() => {
  const k = kennzahlen.value
  if (!k) return []
  const liste = [
    { titel: 'Offene Mängel', wert: k.offene_maengel, hinweis: `${k.ueberfaellige_maengel} überfällig`,
      symbol: 'mangel', farbe: k.ueberfaellige_maengel ? 'text-fehler' : 'text-warnung',
      ziel: { name: 'maengel' } },
    { titel: 'Protokolle in Arbeit', wert: k.protokolle_in_arbeit, hinweis: 'unvollständig',
      symbol: 'protokoll', farbe: 'text-navy-600', ziel: { name: 'protokolle' } },
    { titel: 'Wartungen fällig', wert: k.wartungen_faellig, hinweis: 'nächste 30 Tage',
      symbol: 'uhr', farbe: 'text-ov-600', ziel: { name: 'anlagen' } },
    { titel: 'Anlagen', wert: k.anlagen_gesamt, hinweis: `${k.anlagen_in_bau} in Bau`,
      symbol: 'anlage', farbe: 'text-ink-500', ziel: { name: 'anlagen' } },
  ]
  if (stammdaten.istBauleiter) {
    liste.push(
      { titel: 'Zu verifizieren', wert: k.protokolle_zu_verifizieren, hinweis: 'Protokolle',
        symbol: 'check', farbe: 'text-ov-600', ziel: { name: 'protokolle' } },
      { titel: 'Berichte zur Freigabe', wert: k.berichte_zur_freigabe, hinweis: 'Tagesberichte',
        symbol: 'bericht', farbe: 'text-warnung', ziel: { name: 'tagesberichte' } },
    )
  }
  return liste
})

async function laden() {
  laedt.value = true
  try {
    const [k, w, a] = await Promise.allSettled([
      baudoku.kennzahlen(),
      baudoku.anstehendeWartungen(30),
      baudoku.meineAufgaben(),
    ])
    if (k.status === 'fulfilled') kennzahlen.value = k.value as Kennzahlen
    if (w.status === 'fulfilled') wartungen.value = w.value as typeof wartungen.value
    if (a.status === 'fulfilled') aufgaben.value = a.value as Aufgabe[]
  } finally {
    // Lokale, noch nicht abgeschlossene Protokolle sind auch offline verfügbar.
    lokaleEntwuerfe.value = await db.protokolle
      .filter((p) => p.status === 'In Arbeit' || p.status === 'Entwurf')
      .toArray()
    laedt.value = false
  }
}

function anlagenName(name: string) {
  return stammdaten.anlage(name)?.anlage_name ?? name
}

function fristText(aufgabe: Aufgabe): string {
  const tage = tageBis(aufgabe.faellig_am)
  if (tage === null) return 'ohne Frist'
  if (tage < 0) return `${Math.abs(tage)} Tage überfällig`
  if (tage === 0) return 'heute fällig'
  return `in ${tage} Tagen`
}

onMounted(laden)
</script>

<template>
  <div class="space-y-6">
    <header class="flex flex-wrap items-end gap-3">
      <div class="flex-1">
        <p class="uebertitel">
          {{ new Date().toLocaleDateString('de-AT', { weekday: 'long', day: 'numeric', month: 'long' }) }}
        </p>
        <h2 class="mt-1 font-display text-[26px] font-extrabold tracking-tight">
          Servus {{ stammdaten.benutzer?.vollname?.split(' ')[0] ?? '' }}
        </h2>
      </div>
      <button class="knopf-primaer px-4" @click="router.push({ name: 'protokoll-neu' })">
        <AppIcon name="plus" :groesse="18" /> Protokoll starten
      </button>
    </header>

    <!-- KPI-Kacheln -->
    <section class="grid grid-cols-2 gap-3 tablet:grid-cols-3 desktop:grid-cols-6">
      <RouterLink
        v-for="kachel in kacheln"
        :key="kachel.titel"
        :to="kachel.ziel"
        class="karte-aktiv p-4"
      >
        <span
          class="flex h-9 w-9 items-center justify-center rounded-xl bg-ink-100 dark:bg-white/5"
        >
          <AppIcon :name="kachel.symbol" :groesse="20" :class="kachel.farbe" />
        </span>
        <div class="zahl mt-3 text-[32px] leading-none">{{ kachel.wert }}</div>
        <div class="mt-1.5 text-sm font-semibold">{{ kachel.titel }}</div>
        <div class="text-xs text-ink-400">{{ kachel.hinweis }}</div>
      </RouterLink>

      <div v-if="laedt && !kacheln.length" class="karte col-span-full p-6 text-center text-sm text-ink-500">
        Kennzahlen werden geladen …
      </div>
    </section>

    <!-- Mir zugewiesene Mängel: überfällige zuerst -->
    <section v-if="aufgaben.length">
      <h3 class="mb-2.5 flex items-center gap-2 font-display text-lg font-extrabold tracking-tight">
        <AppIcon name="mangel" :groesse="20" class="text-warnung" />
        Meine Mängel
        <RouterLink
          :to="{ name: 'maengel' }"
          class="ml-auto text-sm font-semibold text-ov-700 hover:underline dark:text-ov-300"
        >
          alle ansehen
        </RouterLink>
      </h3>
      <ul class="space-y-2">
        <li v-for="aufgabe in aufgaben.slice(0, 5)" :key="aufgabe.name">
          <RouterLink
            :to="{ name: 'mangel-detail', params: { lokaleId: aufgabe.name } }"
            class="karte-aktiv flex items-center gap-3 p-3"
            :class="aufgabe.ueberfaellig ? 'border-l-4 border-l-fehler' : ''"
          >
            <StatusAbzeichen :wert="aufgabe.schweregrad" />
            <div class="min-w-0 flex-1">
              <div class="truncate font-semibold">{{ aufgabe.titel }}</div>
              <div class="truncate text-xs text-ink-500">{{ anlagenName(aufgabe.anlage) }}</div>
            </div>
            <div class="shrink-0 text-right text-xs">
              <div :class="aufgabe.ueberfaellig ? 'font-semibold text-fehler' : 'text-ink-400'">
                {{ fristText(aufgabe) }}
              </div>
              <StatusAbzeichen :wert="aufgabe.status" klein />
            </div>
          </RouterLink>
        </li>
      </ul>
    </section>

    <!-- Angefangene Protokolle -->
    <section v-if="lokaleEntwuerfe.length">
      <h3 class="mb-2.5 flex items-center gap-2 font-display text-lg font-extrabold tracking-tight">
        <AppIcon name="protokoll" :groesse="20" class="text-navy-600" />
        Angefangene Protokolle
      </h3>
      <ul class="space-y-2">
        <li v-for="protokoll in lokaleEntwuerfe" :key="protokoll.lokale_id">
          <RouterLink
            :to="{ name: 'protokoll-ausfuehren', params: { lokaleId: protokoll.lokale_id } }"
            class="karte-aktiv flex items-center gap-3 p-3"
          >
            <div class="min-w-0 flex-1">
              <div class="truncate font-semibold">{{ anlagenName(protokoll.anlage) }}</div>
              <div class="text-xs text-ink-500">
                {{ protokoll.vorlage_typ }} · begonnen {{ relativ(protokoll.pruef_datum) }}
              </div>
              <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-ink-200 dark:bg-white/10">
                <div class="h-full rounded-full bg-ov-500 transition-[width] duration-500"
                     :style="{ width: `${protokoll.fortschritt ?? 0}%` }" />
              </div>
            </div>
            <div class="shrink-0 text-right">
              <div class="zahl text-sm">{{ prozent(protokoll.fortschritt) }}</div>
              <StatusAbzeichen :wert="protokoll.status" klein />
            </div>
          </RouterLink>
        </li>
      </ul>
    </section>

    <!-- Anstehende Wartungen -->
    <section v-if="wartungen.length">
      <h3 class="mb-2.5 flex items-center gap-2 font-display text-lg font-extrabold tracking-tight">
        <AppIcon name="uhr" :groesse="20" class="text-marke-600" />
        Anstehende Wartungen
      </h3>
      <ul class="space-y-2">
        <li v-for="anlage in wartungen.slice(0, 6)" :key="anlage.name">
          <RouterLink
            :to="{ name: 'anlage-detail', params: { name: anlage.name } }"
            class="karte-aktiv flex items-center gap-3 p-3"
          >
            <div class="min-w-0 flex-1">
              <div class="truncate font-semibold">{{ anlage.anlage_name }}</div>
              <div class="text-xs text-ink-500">{{ anlage.ort }}</div>
            </div>
            <div class="shrink-0 text-right text-sm">
              <div class="font-medium">{{ datum(anlage.naechste_wartung) }}</div>
              <div
                class="text-xs"
                :class="(tageBis(anlage.naechste_wartung) ?? 0) < 0 ? 'text-fehler' : 'text-ink-400'"
              >
                {{
                  (tageBis(anlage.naechste_wartung) ?? 0) < 0
                    ? `${Math.abs(tageBis(anlage.naechste_wartung) ?? 0)} Tage überfällig`
                    : `in ${tageBis(anlage.naechste_wartung)} Tagen`
                }}
              </div>
            </div>
          </RouterLink>
        </li>
      </ul>
    </section>

    <!-- Sync-Hinweis -->
    <section v-if="sync.hatAusstehende || sync.konflikte" class="karte p-4">
      <h3 class="mb-2 flex items-center gap-2 font-display font-extrabold tracking-tight">
        <AppIcon name="wolke" :groesse="18" class="text-warnung" /> Synchronisation
      </h3>
      <p class="text-sm text-ink-600 dark:text-ink-300">
        {{ sync.ausstehend }} Dokument(e) warten auf Übertragung.
        <span v-if="sync.konflikte" class="text-fehler">
          {{ sync.konflikte }} Konflikt(e) — siehe Einstellungen.
        </span>
      </p>
      <button class="knopf-sekundaer mt-3 px-4 text-sm" @click="sync.jetztSynchronisieren()">
        Jetzt synchronisieren
      </button>
    </section>
  </div>
</template>
