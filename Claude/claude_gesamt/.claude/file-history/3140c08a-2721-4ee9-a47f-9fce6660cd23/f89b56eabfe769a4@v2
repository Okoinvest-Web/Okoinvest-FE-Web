phase('Einsatz')
const ergebnisse = await Promise.all(PAKETE.map((p) => slot(async () => {
  const bau = await agent(`${REGELN}\n\nDEIN PAKET ${p.k}: ${p.name}\n${p.a}`, { label: `Plattform · ${p.k} Einsatz`, phase: 'Einsatz' })
  const pruef = await agent(`${REGELN}\n\nDu bist unabhängiger PRÜFER für Paket ${p.k} (${p.name}). Bericht des Fachteams:\n${bau}\n\nAuftrag war:\n${p.a}\n\nPrüfe kritisch und BEHEBE Fehler direkt:\n1. Stimmen die behaupteten Fixes (Code lesen, Tests laufen lassen, im Browser gegen das Demo-Backend nachstellen)?\n2. Hat das Team etwas kaputtgemacht (npm test, npx eslint auf geänderte Dateien, betroffene Portal-Seiten laden)?\n3. Sicherheitsregeln eingehalten (keine Produktivpfade, keine neuen Abhängigkeiten, keine Geheimnisse, Demo-only)?\n4. Fehlende Punkte des Auftrags nachziehen, sofern klein; sonst als offen dokumentieren.\nRückgabe: Prüfbericht (bestanden/behoben/offen) mit Dateiliste.`, { label: `Plattform · ${p.k} Prüfung`, phase: 'Prüfung' })
  return { k: p.k, name: p.name, bau, pruef }
})))

phase('Abnahme')
