import Link from "next/link";
import { connection } from "next/server";
import { db } from "@/lib/data";
import { OPPORTUNITY_STAGES } from "@/lib/types";
import { date, isWithinDays, LEAD_STATUS_LABEL, money, PRIORITY_LABEL, relative, STAGE_LABEL } from "@/lib/format";
import { Avatar, Badge, PageHeader } from "@/components/ui";
import { ToDoCheck } from "@/components/interactive";

export const metadata = { title: "Übersicht" };

export default async function Dashboard() {
  await connection();
  const [leads, opps, todos] = await Promise.all([db().listLeads(), db().listOpportunities(), db().listToDos({ filters: { status: "Open" } })]);

  const open = opps.filter((o) => o.status === "Open" || o.status === "Quotation");
  const pipeline = open.reduce((s, o) => s + o.opportunity_amount, 0);
  const weighted = open.reduce((s, o) => s + (o.opportunity_amount * o.probability) / 100, 0);
  const newLeads = leads.filter((l) => isWithinDays(l.creation, 14)).length;
  const maxStage = Math.max(1, ...OPPORTUNITY_STAGES.map((s) => open.filter((o) => o.sales_stage === s).reduce((a, o) => a + o.opportunity_amount, 0)));

  const kpis = [
    { label: "Pipeline offen", value: money(pipeline) },
    { label: "Gewichtet", value: money(weighted) },
    { label: "Offene Chancen", value: String(open.length) },
    { label: "Neue Leads (14 Tage)", value: String(newLeads) },
  ];

  return (
    <>
      <PageHeader title="Übersicht" />
      <div className="grid gap-5 p-5">
        <div className="grid grid-cols-2 gap-3 lg:grid-cols-4">
          {kpis.map((k) => (
            <div key={k.label} className="rounded-lg border border-gray-200 p-4">
              <div className="text-xs text-gray-500">{k.label}</div>
              <div className="mt-1 text-2xl font-semibold tabular-nums text-gray-900">{k.value}</div>
            </div>
          ))}
        </div>

        <div className="grid gap-5 lg:grid-cols-2">
          <section className="rounded-lg border border-gray-200">
            <h2 className="border-b border-gray-200 px-4 py-2.5 font-medium">Pipeline nach Phase</h2>
            <div className="grid gap-3 p-4">
              {OPPORTUNITY_STAGES.map((s) => {
                const sum = open.filter((o) => o.sales_stage === s).reduce((a, o) => a + o.opportunity_amount, 0);
                return (
                  <div key={s} className="grid grid-cols-[120px_1fr_90px] items-center gap-3">
                    <span className="text-gray-600">{STAGE_LABEL[s]}</span>
                    <div className="h-2 rounded-full bg-gray-100">
                      <div className="h-2 rounded-full bg-gray-900" style={{ width: `${(sum / maxStage) * 100}%` }} />
                    </div>
                    <span className="text-right tabular-nums text-gray-900">{money(sum)}</span>
                  </div>
                );
              })}
            </div>
          </section>

          <section className="rounded-lg border border-gray-200">
            <h2 className="flex items-center justify-between border-b border-gray-200 px-4 py-2.5 font-medium">
              Offene Aufgaben
              <Link href="/todos" className="text-xs font-normal text-gray-500 hover:text-gray-900">
                Alle anzeigen
              </Link>
            </h2>
            <ul className="divide-y divide-gray-100">
              {todos.slice(0, 5).map((t) => (
                <li key={t.name} className="flex items-center gap-3 px-4 py-2.5">
                  <ToDoCheck name={t.name} done={false} />
                  <span className="min-w-0 flex-1 truncate">{t.description}</span>
                  <Badge value={t.priority} label={PRIORITY_LABEL[t.priority]} />
                  <span className="w-24 text-right text-xs text-gray-500">{date(t.date)}</span>
                </li>
              ))}
              {todos.length === 0 && <li className="px-4 py-6 text-center text-gray-500">Keine offenen Aufgaben</li>}
            </ul>
          </section>
        </div>

        <section className="rounded-lg border border-gray-200">
          <h2 className="border-b border-gray-200 px-4 py-2.5 font-medium">Zuletzt geänderte Leads</h2>
          <ul className="divide-y divide-gray-100">
            {leads.slice(0, 5).map((l) => (
              <li key={l.name}>
                <Link href={`/leads/${encodeURIComponent(l.name)}`} className="flex items-center gap-3 px-4 py-2.5 hover:bg-gray-50">
                  <Avatar name={l.lead_name} />
                  <span className="font-medium">{l.lead_name}</span>
                  <span className="text-gray-500">{l.company_name}</span>
                  <span className="ml-auto">
                    <Badge value={l.status} label={LEAD_STATUS_LABEL[l.status]} />
                  </span>
                  <span className="w-28 text-right text-xs text-gray-500">{relative(l.modified)}</span>
                </Link>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </>
  );
}
