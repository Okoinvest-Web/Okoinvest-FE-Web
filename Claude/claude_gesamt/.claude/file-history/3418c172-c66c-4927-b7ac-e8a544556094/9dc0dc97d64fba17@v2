type Store = ReturnType<typeof seed>;
const g = globalThis as unknown as { __crmMock?: Store };
const store = (g.__crmMock ??= seed());

function applyList<T extends { modified: string }>(rows: T[], opts: ListOptions = {}, searchKeys: (keyof T)[]) {
  let out = rows;
  for (const [k, v] of Object.entries(opts.filters ?? {})) {
    if (v) out = out.filter((r) => String(r[k as keyof T]) === v);
  }
  if (opts.search) {
    const q = opts.search.toLowerCase();
    out = out.filter((r) => searchKeys.some((k) => String(r[k] ?? "").toLowerCase().includes(q)));
  }
  return [...out].sort((a, b) => b.modified.localeCompare(a.modified)).slice(0, opts.limit ?? 100);
}

// Kleine künstliche Latenz, damit Ladezustände sichtbar werden
const tick = () => new Promise((r) => setTimeout(r, 120));

export const mockSource: DataSource = {
  kind: "mock",

  async listLeads(o) {
    await tick();
    return applyList(store.leads, o, ["lead_name", "company_name", "email_id", "mobile_no"]);
  },
  async getLead(n) {
    await tick();
    return store.leads.find((l) => l.name === n) ?? null;
  },
  async createLead(data) {
    await tick();
    store.leadCounter += 1;
    const now = new Date().toISOString();
    const lead: Lead = {
      ...data,
      name: `CRM-LEAD-2026-${String(store.leadCounter).padStart(5, "0")}`,
      lead_name: [data.first_name, data.last_name].filter(Boolean).join(" "),
      status: data.status ?? "Lead",
      creation: now,
      modified: now,
    };
    store.leads.push(lead);
    return lead;
  },
  async setLeadStatus(n, status) {
    const l = store.leads.find((x) => x.name === n);
    if (!l) throw new Error("Lead nicht gefunden");
    l.status = status;
    l.modified = new Date().toISOString();
  },

  async listOpportunities(o) {
    await tick();
    return applyList(store.opportunities, o, ["title", "customer_name", "party_name"]);
  },
  async getOpportunity(n) {
    await tick();
    return store.opportunities.find((x) => x.name === n) ?? null;
  },
  async setOpportunityStage(n, stage) {
    const o = store.opportunities.find((x) => x.name === n);
    if (!o) throw new Error("Opportunity nicht gefunden");
    o.sales_stage = stage;
    o.modified = new Date().toISOString();
  },

  async listCustomers(o) {
    await tick();
    return applyList(store.customers, o, ["customer_name", "email_id", "territory"]);
  },
  async getCustomer(n) {
    await tick();
    return store.customers.find((x) => x.name === n) ?? null;
  },

  async listContacts(o) {
    await tick();
    return applyList(store.contacts, o, ["full_name", "email_id", "company_name", "mobile_no"]);
  },

  async listToDos(o) {
    await tick();
    return applyList(store.todos, o, ["description", "reference_name"]);
  },
  async setToDoStatus(n, status) {
    const t = store.todos.find((x) => x.name === n);
    if (!t) throw new Error("Aufgabe nicht gefunden");
    t.status = status;
    t.modified = new Date().toISOString();
  },
};
