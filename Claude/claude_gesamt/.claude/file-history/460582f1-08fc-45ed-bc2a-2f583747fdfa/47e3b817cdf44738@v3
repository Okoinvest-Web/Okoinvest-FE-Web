def add(p, text, bold=False, size=None, color=None, italic=False):
    for part in re.split(r"(\[[^\]]+\])", text):
        if not part:
            continue
        r = p.add_run(part)
        r.bold, r.italic = bold, italic
        if size:
            r.font.size = Pt(size)
        if part.startswith("["):
            r.font.color.rgb, r.bold = PH, True
        elif color:
            r.font.color.rgb = color
    return p


def h1(t):
    p = add(d.add_paragraph(), t, bold=True, size=14, color=ACCENT)
    p.paragraph_format.space_before = Pt(12)
    p.paragraph_format.keep_with_next = True


def h2(t):
    p = add(d.add_paragraph(), t, bold=True, size=11.5, color=ACCENT)
    p.paragraph_format.space_before = Pt(6)
    p.paragraph_format.keep_with_next = True


def para(t, **kw):
    p = add(d.add_paragraph(), t, **kw)
    p.alignment = WD_ALIGN_PARAGRAPH.JUSTIFY
    return p


def bullets(items):
    for it in items:
        p = d.add_paragraph(style="List Bullet")
        if isinstance(it, tuple):
            add(p, it[0] + " ", bold=True)
            add(p, it[1])
        else:
            add(p, it)


def shade(c, hexcolor):
    tcPr = c._tc.get_or_add_tcPr()
    sh = OxmlElement("w:shd")
    sh.set(qn("w:val"), "clear")
    sh.set(qn("w:fill"), hexcolor)
    tcPr.append(sh)


def table(header, rows, widths):
    t = d.add_table(rows=len(rows) + 1, cols=len(header))
    t.style = "Table Grid"
    for j, hd in enumerate(header):
        c = t.rows[0].cells[j]
        c.paragraphs[0].text = ""
        add(c.paragraphs[0], hd, bold=True, size=9.5, color=WHITE)
        shade(c, "1F4E3D")
    for i, r in enumerate(rows, start=1):
        for j, txt in enumerate(r):
            c = t.rows[i].cells[j]
            c.paragraphs[0].text = ""
            add(c.paragraphs[0], txt, size=9, bold=(j == 0))
            if i % 2 == 0:
                shade(c, "EEF3F1")
    for row in t.rows:
        for j, w in enumerate(widths):
            row.cells[j].width = Cm(w)
    d.add_paragraph()


