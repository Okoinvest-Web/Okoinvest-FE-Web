from openpyxl import Workbook
from openpyxl.styles import Font, PatternFill, Alignment
from openpyxl.worksheet.datavalidation import DataValidation
wb = Workbook()
sheets = {
    "Medienspiegel": ["Datum", "Medium", "Land", "Art (Print/Online/Radio/TV/Social)", "Titel", "Link", "Ton (positiv/neutral/negativ)", "Salzburg AG zitiert? (ja/nein)", "Falsche Fakten? Welche", "Handlungsbedarf", "PDF gesichert (ja/nein)", "Erledigt von"],
    "Kommentare": ["Datum", "Uhrzeit", "Plattform", "Beitrag", "Ampel (grün/gelb/rot/schwarz)", "Kurzinhalt (ohne Namen)", "Maßnahme", "Screenshot-Datei", "Erledigt von"],
    "Anfragen": ["Datum", "Uhrzeit", "Medium", "Journalist/in", "Kontakt", "Thema/Frage", "Frist", "Antwort durch", "Beantwortet am", "Ergebnis/Beitrag"],
}
fill = PatternFill("solid", fgColor="1F4E3D")
first = True
for name, cols in sheets.items():
    ws = wb.active if first else wb.create_sheet()
    first = False
    ws.title = name
    ws.append(cols)
    for i, c in enumerate(ws[1], start=1):
        c.font = Font(bold=True, color="FFFFFF")
        c.fill = fill
        c.alignment = Alignment(wrap_text=True, vertical="top")
        ws.column_dimensions[c.column_letter].width = 22 if i > 1 else 12
    ws.freeze_panes = "A2"
    ws.auto_filter.ref = f"A1:{ws.cell(1, len(cols)).column_letter}1"
    ws.row_dimensions[1].height = 34
ws = wb["Kommentare"]
dv = DataValidation(type="list", formula1='"grün,gelb,rot,schwarz"', allow_blank=True)
ws.add_data_validation(dv); dv.add("E2:E1000")
ws = wb["Medienspiegel"]
