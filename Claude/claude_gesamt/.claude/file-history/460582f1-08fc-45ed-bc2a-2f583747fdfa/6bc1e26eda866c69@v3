def t(x, y, s, size, color, weight=800, font=HF, anchor="start", ls=1.15):
    lines = s.split("\n")
    out = [f'<text x="{x}" y="{y}" font-family="{font}" font-size="{size}" font-weight="{weight}" fill="{color}" text-anchor="{anchor}">']
    for i, line in enumerate(lines):
        dy = 0 if i == 0 else size * ls
        out.append(f'<tspan x="{x}" dy="{dy}">{html.escape(line)}</tspan>')
    out.append("</text>")
    return "".join(out)


def logo(x, y, color=L, size=22):
    return t(x, y, "ÖKOVOLT", size, color, 800) + f'<rect x="{x}" y="{y+8}" width="36" height="4" fill="{color}"/>'


def svg(name, body, bg=N):
    return {"file": name.replace(".svg", ""), "body": body, "bg": bg}


def card(x, y, w, h, fill, stroke=None, r=22):
    st = f' stroke="{stroke}" stroke-width="3"' if stroke else ""
    return f'<rect x="{x}" y="{y}" width="{w}" height="{h}" rx="{r}" fill="{fill}"{st}/>'


