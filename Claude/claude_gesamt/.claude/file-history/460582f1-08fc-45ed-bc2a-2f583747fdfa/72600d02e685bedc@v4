adrat_1080x1080/AT4_geld_der_salzburger_Instagram_Quadrat_1080x1080.svg", "Story_1080x1920": "Story_1080x1920/AT4_geld_der_salzburger_Story_1080x1920.svg"}}, {"welle": "AT · Welle 5", "dateien": {"LinkedIn_1200x627": "LinkedIn_1200x627/AT5_eigentuemer_schweigen_LinkedIn_1200x627.svg", "Facebook_1200x630": "Facebook_1200x630/AT5_eigentuemer_schweigen_Facebook_1200x630.svg", "X_1600x900": "X_1600x900/AT5_eigentuemer_schweigen_X_1600x900.svg", "Instagram_Feed_1080x1350": "Instagram_Feed_1080x1350/AT5_eigentuemer_schweigen_Instagram_Feed_1080x1350.svg", "Instagram_Quadrat_1080x1080": "Instagram_Quadrat_1080x1080/AT5_eigentuemer_schweigen_Instagram_Quadrat_1080x1080.svg", "Story_1080x1920": "Story_1080x1920/AT5_eigentuemer_schweigen_Story_1080x1920.svg"}}, {"welle": "DE · Welle 1", "dateien": {"LinkedIn_1200x627": "LinkedIn_1200x627/DE1_dreimal_gescheitert_LinkedIn_1200x627.svg", "Facebook_1200x630": "Facebook_1200x630/DE1_dreimal_gescheitert_Facebook_1200x630.svg", "X_1600x900": "X_1600x900/DE1_dreimal_gescheitert_X_1600x900.svg", "Instagram_Feed_1080x1350": "Instagram_Feed_1080x1350/DE1_dreimal_gescheitert_Instagram_Feed_1080x1350.svg", "Instagram_Quadrat_1080x1080": "Instagram_Quadrat_1080x1080/DE1_dreimal_gescheitert_Instagram_Quadrat_1080x1080.svg", "Story_1080x1920": "Story_1080x1920/DE1_dreimal_gescheitert_Story_1080x1920.svg"}}, {"welle": "DE · Welle 2", "dateien": {"LinkedIn_1200x627": "LinkedIn_1200x627/DE2_partner_auf_dem_papier_LinkedIn_1200x627.svg", "Facebook_1200x630": "Facebook_1200x630/DE2_partner_auf_dem_papier_Facebook_1200x630.svg", "X_1600x900": "X_1600x900/DE2_partner_auf_dem_papier_X_1600x900.svg", "Instagram_Feed_1080x1350": "Instagram_Feed_1080x1350/DE2_partner_auf_dem_papier_Instagram_Feed_1080x1350.svg", "Instagram_Quadrat_1080x1080": "Instagram_Quadrat_1080x1080/DE2_partner_auf_dem_papier_Instagram_Quadrat_1080x1080.svg", "Story_1080x1920": "Story_1080x1920/DE2_partner_auf_dem_papier_Story_1080x1920.svg"}}, {"welle": "DE · Welle 3", "dateien": {"LinkedIn_1200x627": "LinkedIn_1200x627/DE3_fluesterton_LinkedIn_1200x627.svg", "Facebook_1200x630": "Facebook_1200x630/DE3_fluesterton_Facebook_1200x630.svg", "X_1600x900": "X_1600x900/DE3_fluesterton_X_1600x900.svg", "Instagram_Feed_1080x1350": "Instagram_Feed_1080x1350/DE3_fluesterton_Instagram_Feed_1080x1350.svg", "Instagram_Quadrat_1080x1080": "Instagram_Quadrat_1080x1080/DE3_fluesterton_Instagram_Quadrat_1080x1080.svg", "Story_1080x1920": "Story_1080x1920/DE3_fluesterton_Story_1080x1920.svg"}}, {"welle": "DE · Welle 4", "dateien": {"LinkedIn_1200x627": "LinkedIn_1200x627/DE4_drei_lehren_LinkedIn_1200x627.svg", "Facebook_1200x630": "Facebook_1200x630/DE4_drei_lehren_Facebook_1200x630.svg", "X_1600x900": "X_1600x900/DE4_drei_lehren_X_1600x900.svg", "Instagram_Feed_1080x1350": "Instagram_Feed_1080x1350/DE4_drei_lehren_Instagram_Feed_1080x1350.svg", "Instagram_Quadrat_1080x1080": "Instagram_Quadrat_1080x1080/DE4_drei_lehren_Instagram_Quadrat_1080x1080.svg", "Story_1080x1920": "Story_1080x1920/DE4_drei_lehren_Story_1080x1920.svg"}}, {"welle": "DE · Welle 5", "dateien": {"LinkedIn_1200x627": "LinkedIn_1200x627/DE5_hauptverhandlung_LinkedIn_1200x627.svg", "Facebook_1200x630": "Facebook_1200x630/DE5_hauptverhandlung_Facebook_1200x630.svg", "X_1600x900": "X_1600x900/DE5_hauptverhandlung_X_1600x900.svg", "Instagram_Feed_1080x1350": "Instagram_Feed_1080x1350/DE5_hauptverhandlung_Instagram_Feed_1080x1350.svg", "Instagram_Quadrat_1080x1080": "Instagram_Quadrat_1080x1080/DE5_hauptverhandlung_Instagram_Quadrat_1080x1080.svg", "Story_1080x1920": "Story_1080x1920/DE5_hauptverhandlung_Story_1080x1920.svg"}}]};
var LOCAL=location.protocol==='file:';
var IDX, CUR, FONTCSS;
var HINT={
 "LinkedIn_1200x627":"LinkedIn-Beitrag des Geschäftsführers und der Unternehmensseite.",
 "Facebook_1200x630":"Facebook-Beitrag der Unternehmensseite.",
 "X_1600x900":"X und Bluesky (16:9).",
 "Instagram_Feed_1080x1350":"Instagram- und Facebook-Feed im Hochformat 4:5. Dieses Format bekommt im Feed die meiste Fläche; als erstes Karussell-Bild verwenden. Unten steht „Alle Belege: Link in Bio“.",
 "Instagram_Quadrat_1080x1080":"Quadratisch: Instagram, falls das Karussell quadratisch ist, sowie LinkedIn-Dokument/Karussell.",
 "Story_1080x1920":"Instagram- und Facebook-Story. Oben und unten sind je 250 px frei für die App-Leisten. Den Link-Sticker in der App auf den grünen Knopf „Alle Belege“ legen."
};
function el(h){var d=document.createElement('div');d.innerHTML=h;return d.firstChild}
async function fontCSS(){
  if(FONTCSS!==undefined) return FONTCSS;
  try{
    var css=await (await fetch('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap')).text();
    var blocks=css.split('/*').filter(function(b){return /^ (latin|latin-ext) \*\//.test(b)}).map(function(b){return b.replace(/^[^*]*\*\//,'')});
    var out=blocks.join('\n');
    var urls=[...new Set([...out.matchAll(/url\((https:[^)]+)\)/g)].map(function(m){return m[1]}))];
    for(var u of urls){
      var blob=await (await fetch(u)).blob();
      var data=await new Promise(function(r){var fr=new FileReader();fr.onload=function(){r(fr.result)};fr.readAsDataURL(blob)});
      out=out.split(u).join(data);
    }
    FONTCSS=out;
  }catch(e){FONTCSS='';}
  return FONTCSS;
}
async function toPNG(path){
  var svg=await (await fetch('grafiken/'+path)).text();
  var css=await fontCSS();
  var w=+svg.match(/width="(\d+)"/)[1], h=+svg.match(/height="(\d+)"/)[1];
  svg=svg.replace(/(<svg[^>]*>)/,'$1<defs><style>'+css+'</style></defs>');
  var img=new Image();
  await new Promise(function(r,j){img.onload=r;img.onerror=j;img.src='data:image/svg+xml;charset=utf-8,'+encodeURIComponent(svg)});
  await new Promise(function(r){setTimeout(r,150)});
  var c=document.createElement('canvas');c.width=w;c.height=h;c.getContext('2d').drawImage(img,0,0,w,h);
  return await new Promise(function(r){c.toBlob(r,'image/png')});
}
function save(blob,name){var a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;a.click();setTimeout(function(){URL.revokeObjectURL(a.href)},2000)}
function show(folder){
  CUR=folder;
  document.querySelectorAll('#tabs button[data-f]').forEach(function(b){b.classList.toggle('on',b.dataset.f===folder)});
  var fm=IDX.formate.find(function(f){return f.ordner===folder});
  document.getElementById('hint').innerHTML='<b>'+fm.w+' × '+fm.h+' px</b> · '+(HINT[folder]||fm.hinweis);
  var m=document.getElementById('m');m.innerHTML='';
  var col=fm.h>fm.w? (fm.h>1500?'repeat(auto-fill,minmax(min(260px,100%),1fr))':'repeat(auto-fill,minmax(min(340px,100%),1fr))') : (fm.w===fm.h?'repeat(auto-fill,minmax(min(380px,100%),1fr))':'repeat(auto-fill,minmax(min(560px,100%),1fr))');
  m.style.gridTemplateColumns=col;
  IDX.motive.forEach(function(mo){
    var p=mo.dateien[folder], name=p.split('/').pop();
    var d=el('<div class="g"><div class="art"></div><div class="meta"><b>'+mo.welle+'</b><span class="f">'+name+'</span><a href="grafiken/'+p+'" download>SVG</a><button type="button">PNG</button></div></div>');
    m.appendChild(d);
    if(LOCAL){
      var png='grafiken/'+p.replace('.svg','.png');
      d.querySelector('.art').innerHTML='<img src="'+png+'" style="width:100%;display:block" alt="">';
      d.querySelector('button').outerHTML='<a href="'+png+'" download style="background:var(--green)">PNG</a>';
      return;
    }
    fetch('grafiken/'+p).then(function(r){return r.text()}).then(function(s){d.querySelector('.art').innerHTML=s});
    d.querySelector('button').onclick=async function(){var b=this;b.textContent='…';save(await toPNG(p),name.replace('.svg','.png'));b.textContent='PNG ✓'};
  });
}
Promise.resolve(INDEX).then(function(j){
  IDX=j;var t=document.getElementById('tabs');
  j.formate.forEach(function(f){var b=el('<button type="button" data-f="'+f.ordner+'">'+f.ordner.replace(/_/g,' ')+'</button>');b.onclick=function(){show(f.ordner)};t.appendChild(b)});
  var z=el('<button type="button" class="zip">Alle PNG dieses Kanals als ZIP</button>');
  z.onclick=async function(){
    if(!window.JSZip){alert('ZIP-Bibliothek nicht geladen (Internet nötig).');return}
    var zip=new JSZip(), n=0;
    for(var mo of IDX.motive){var p=mo.dateien[CUR];z.textContent='PNG '+(++n)+'/'+IDX.motive.length+' …';zip.file(p.split('/').pop().replace('.svg','.png'),await toPNG(p))}
    save(await zip.generateAsync({type:'blob'}),'Oekovolt_'+CUR+'.zip');z.textContent='Alle PNG dieses Kanals als ZIP';
  };
  if(!LOCAL) t.appendChild(z);
  show(j.formate[0].ordner);
});
</script></body></html>
