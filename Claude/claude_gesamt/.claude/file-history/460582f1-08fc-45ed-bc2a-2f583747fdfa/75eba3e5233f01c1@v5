def add(p, text, bold=False, size=None, color=None, italic=False):
    for part in re.split(r"(\[[^\]]+\])", text):
        if not part:
            continue
        r = p.add_run(part)
        r.bold, r.italic = bold, italic
        if size:
            r.font.size = Pt(size)
        if part.startswith("["):
            r.font.color.rgb, r.bold = PH, True
        elif color:
            r.font.color.rgb = color
    return p


def para(text="", **kw):
    after = kw.pop("after", None)
    p = add(doc.add_paragraph(), text, **kw)
    p.alignment = WD_ALIGN_PARAGRAPH.JUSTIFY
    if after is not None:
        p.paragraph_format.space_after = Pt(after)
    return p


def head(text):
    p = add(doc.add_paragraph(), text, bold=True, size=11.5, color=ACCENT)
    p.paragraph_format.space_before = Pt(8)
    p.paragraph_format.space_after = Pt(3)
    p.paragraph_format.keep_with_next = True


def mixed(*parts):
    """Absatz aus (text, stil)-Teilen; stil 'q' = Zitat, sonst normal."""
    p = doc.add_paragraph()
    p.alignment = WD_ALIGN_PARAGRAPH.JUSTIFY
    for text, style in parts:
        if style == "q":
            add(p, text, bold=True, color=ACCENT)
        else:
            add(p, text)
    return p


