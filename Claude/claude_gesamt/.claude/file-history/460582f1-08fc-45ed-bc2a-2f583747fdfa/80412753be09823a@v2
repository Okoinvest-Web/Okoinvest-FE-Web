EL = re.compile(r"<text[^>]*>.*?</text>|<rect[^>]*/>|<circle[^>]*/>", re.S)


def fx_of(el):
    txt = re.sub(r"<[^>]+>", "", el)
    if el.startswith("<circle") and 'fill="none"' in el:
        return "pulse", None
    if el.startswith("<circle"):
        return "pop", None
    if el.startswith("<rect"):
        h = float(re.search(r'height="([\d.]+)"', el).group(1))
        w = float(re.search(r'width="([\d.]+)"', el).group(1))
        fill = re.search(r'fill="([^"]+)"', el).group(1)
        if h <= 8 or (fill in (G, R) and h in (70, 95) and w >= 500):
            return "grow", None
        return "fade", None
    if "treuwidrig" in txt or txt.strip() in ("[X]", "3 : 0") or "Flüsterton" in txt:
        return "pop", ("score" if txt.strip() == "3 : 0" else None)
    if txt.strip().startswith("151 Tage"):
        return "up", "151"
    if "1,14 Mio" in txt:
        return "up", "1,14"
    if txt.strip() == "21":
        return "pop", "21"
    return "up", None


def annotate(body):
    out, t0, i = [], 0.25, 0
    for m in EL.finditer(body):
        el = m.group(0)
        fx, cnt = fx_of(el)
        if fx == "pop":
            t0 += 0.25  # kurze Spannungspause vor dem Höhepunkt
        dur = {"pop": 0.7, "grow": 0.9, "fade": 0.45, "pulse": 0.45, "up": 0.55}[fx]
        extra = f' data-count="{cnt}"' if cnt else ""
        out.append(f'<g class="a" data-fx="{fx}" data-t="{t0:.2f}" data-d="{dur}"{extra}>{el}</g>')
        t0 += 0.13 if fx not in ("pop", "grow") else 0.45
        i += 1
    return "".join(out), t0 + 0.6


def wrap(body, bg, W, H):
    if H == 1080:
        inner = body
    else:
        inner = f'<g transform="translate(0 330)">{body}</g>'
        dark = bg != BG
        inner += ('<g class="a" data-fx="pop" data-t="{T}" data-d="0.7">'
                  f'<rect x="240" y="1520" width="600" height="96" rx="48" fill="{L if dark else G}"/>'
                  + t(540, 1580, "Alle Belege: Link im Sticker", 32, N if dark else "#fff", 800, anchor="middle") + "</g>")
    return (f'<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}" viewBox="0 0 {W} {H}">'
            f'<rect width="{W}" height="{H}" fill="{bg}"/>{inner}</svg>')


items = []
for key, info in F.g.made.items():
    body, end = annotate(F.SQ[key])
    welle = ("AT · " + key) if key.startswith("Welle") else "DE · Welle " + key[1:]
    for fmt, W, H in [("Quadrat_1080x1080", 1080, 1080), ("Story_1080x1920", 1080, 1920)]:
        e = end + (0.8 if H == 1920 else 0)
        svg = wrap(body, info["bg"], W, H).replace("{T}", f"{end:.2f}")
        dur = max(8.0, min(11.0, round(e + 4.5, 1)))
        items.append({"id": f'{info["file"]}_{fmt}', "welle": welle, "fmt": fmt, "w": W, "h": H, "dur": dur, "svg": svg})

