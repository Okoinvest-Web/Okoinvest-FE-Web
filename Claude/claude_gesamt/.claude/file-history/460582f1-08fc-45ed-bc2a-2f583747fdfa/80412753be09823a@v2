/* ---------- Render-Engine (Einzelbilder für MP4) ---------- */
var FONTCSS=null;
async function fonts(){
  if(FONTCSS!==null) return FONTCSS;
  var css=await (await fetch('https://fonts.googleapis.com/css2?family=Inter:wght@400..700&family=Manrope:wght@600..800&display=swap')).text();
  var out=css.split('/*').filter(function(b){return /^ latin \\*\\//.test(b)}).map(function(b){return b.replace(/^[^*]*\\*\\//,'')}).join('\\n');
  for(var u of [...new Set([...out.matchAll(/url\\((https:[^)]+)\\)/g)].map(function(m){return m[1]}))]){
    var bl=await (await fetch(u)).blob();
    var data=await new Promise(function(r){var fr=new FileReader();fr.onload=function(){r(fr.result)};fr.readAsDataURL(bl)});
    out=out.split(u).join(data);
  }
  return FONTCSS=out;
}
async function renderVideo(id,fps){
  var x=ITEMS.find(function(i){return i.id===id}), css=await fonts();
  var host=document.createElement('div');host.style.cssText='position:fixed;left:-99999px;top:0;width:'+x.w+'px';host.innerHTML=x.svg;document.body.appendChild(host);
