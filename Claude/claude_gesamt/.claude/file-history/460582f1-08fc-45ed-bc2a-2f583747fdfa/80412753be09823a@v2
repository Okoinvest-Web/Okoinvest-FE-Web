  for(var f=0;f<n;f++){
    setTime(svg,f/fps);
    var s=ser.serializeToString(svg).replace(/(<svg[^>]*>)/,'$1<defs><style>'+css+'</style></defs>');
    var img=new Image();
    await new Promise(function(r,j){img.onload=r;img.onerror=j;img.src='data:image/svg+xml;charset=utf-8,'+encodeURIComponent(s)});
    ctx.drawImage(img,0,0);
    var blob=await new Promise(function(r){c.toBlob(r,'image/jpeg',0.95)});
    var r=await fetch('/frames/'+id+'/f'+String(f).padStart(5,'0')+'.jpg',{method:'PUT',body:blob});
