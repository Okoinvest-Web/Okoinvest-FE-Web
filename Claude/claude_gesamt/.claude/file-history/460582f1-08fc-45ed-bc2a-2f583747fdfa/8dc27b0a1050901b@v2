def esc(t):
    t = html.escape(t)
    return re.sub(r"(\[[^\]]+\])", r'<span class="ph">\1</span>', t).replace("\n", "<br>")


def wave_html(w, country, link):
    cls = "at" if country == "AT" else "de"
    slides = [s for s in w["ig_slides"] if not s.startswith("(kein")]
    out = [f'<section class="wave {cls}" id="{cls}-{re.sub(r"[^a-z0-9]", "", w["nr"].lower())}">']
    out.append(f'<div class="whead"><span class="wnr">{esc(w["nr"])}</span><h2>{esc(w["titel"])}</h2>'
               f'<span class="wwhen">{esc(w["wann"])}</span></div>')
    out.append(f'<p class="brief"><b>Bildidee:</b> {esc(w["bild"])}</p>')
    if slides:
        out.append('<h3>Instagram-Karussell · 1080 × 1080 px</h3><div class="carousel">')
        n = len(slides)
        for i, s in enumerate(slides, start=1):
            kind = "first" if i == 1 else ("last" if i == n else "mid")
            out.append(f'<div class="slide {kind}"><div class="s-top"><span class="s-logo">ÖKOVOLT</span>'
                       f'<span class="s-no">{i}/{n}</span></div><div class="s-text">{esc(s)}</div>'
                       f'<div class="s-foot">{"Wischen →" if i < n else "Alle Belege: Link in Bio"}</div></div>')
        out.append("</div>")
    out.append('<div class="posts">')
    for label, key, size in [("LinkedIn · Geschäftsführer", "li", "Bild 1200 × 627 px"),
                             ("Facebook · Unternehmensseite", "fb", "Bild 1200 × 630 px"),
                             ("Instagram · Bildunterschrift", "ig_caption", ""),
                             ("X / Bluesky", "x", "Bild 1600 × 900 px, max. 280 Zeichen")]:
        txt = w[key].replace("{L}", link if key != "ig_caption" else "Link in Bio")
        if txt.startswith("(kein") or txt in ("–", "Nur nach positivem Urteil."):
            continue
        chars = f' · {len(txt)} Zeichen' if key == "x" else ""
        out.append(f'<div class="post"><div class="p-head"><span class="p-ch">{label}</span>'
                   f'<span class="p-sz">{size}{chars}</span><button class="copy" type="button">Text kopieren</button></div>'
                   f'<div class="p-body">{esc(txt)}</div></div>')
    out.append("</div></section>")
    return "\n".join(out)


