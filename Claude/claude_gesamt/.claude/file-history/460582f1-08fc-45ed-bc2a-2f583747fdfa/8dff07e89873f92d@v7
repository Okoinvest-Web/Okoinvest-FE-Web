def para(text="", bold=False, size=None, color=None, italic=False, align=None, after=None):
    p = doc.add_paragraph()
    add(p, text, bold, size, color, italic)
    if align:
        p.alignment = align
    if after is not None:
        p.paragraph_format.space_after = Pt(after)
    return p


def add(p, text, bold=False, size=None, color=None, italic=False):
    """Text mit [Platzhaltern] – Platzhalter werden rot markiert."""
    import re
    for part in re.split(r"(\[[^\]]+\])", text):
        if not part:
            continue
        r = p.add_run(part)
        r.bold = bold
        r.italic = italic
        if size:
            r.font.size = Pt(size)
        if part.startswith("["):
            r.font.color.rgb = PH
            r.bold = True
        elif color:
            r.font.color.rgb = color
    return p


def head(text):
    p = para(text, bold=True, size=12.5, color=ACCENT, after=4)
    p.paragraph_format.space_before = Pt(12)
    p.paragraph_format.keep_with_next = True


def sager(text, who="Andreas Wegscheider, Geschäftsführer der Ökovolt-Gruppe"):
    """Hervorgehobenes Zitat (Pull-Quote) mit Akzentbalken links."""
    from docx.oxml.ns import qn
    from docx.oxml import OxmlElement
    p = doc.add_paragraph()
    p.paragraph_format.left_indent = Cm(0.6)
    p.paragraph_format.space_before = Pt(4)
    p.paragraph_format.space_after = Pt(10)
    pPr = p._p.get_or_add_pPr()
    bdr = OxmlElement("w:pBdr")
    left = OxmlElement("w:left")
    for k, v in (("w:val", "single"), ("w:sz", "24"), ("w:space", "10"), ("w:color", "1F4E3D")):
        left.set(qn(k), v)
    bdr.append(left)
    pPr.append(bdr)
    add(p, f"„{text}“", bold=True, size=12.5, color=ACCENT, italic=True)
    add(p, f"\n– {who}", size=9.5, color=GREY)


