<style>
  :root{
    --green:#558227; --green-dark:#44691f; --navy:#151a24; --navy-2:#03122b;
    --ink:#171717; --muted:#4e5667; --line:#e3e6ec; --bg:#fbfaf6; --card:#ffffff; --soft:#eef0f4;
    --radius:16px;
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0;font-family:Inter,system-ui,"Segoe UI",Arial,sans-serif;color:var(--ink);background:var(--bg);line-height:1.6;font-size:17px}
  h1,h2,h3{font-family:Manrope,Inter,system-ui,sans-serif;line-height:1.2;margin:0 0 .5em}
  a{color:var(--green)}
  .wrap{max-width:1080px;margin:0 auto;padding:0 20px}
  .hidden{display:none!important}

  /* Kopf */
  .top{background:var(--navy);color:#fff}
  .top .bar{display:flex;justify-content:space-between;align-items:center;padding:16px 20px;max-width:1080px;margin:0 auto}
  .logo{font-family:Manrope,sans-serif;font-weight:800;font-size:20px;color:#fff;text-decoration:none}
  .logo span{color:#9bc46a}
  .btn{display:inline-block;background:var(--green);color:#fff;text-decoration:none;font-weight:600;padding:12px 22px;border-radius:999px;border:0;cursor:pointer}
  .btn:hover{background:var(--green-dark)}
  .btn.ghost{background:transparent;border:1.5px solid rgba(255,255,255,.5)}
  .hero{padding:72px 20px 80px;max-width:1080px;margin:0 auto}
  .eyebrow{text-transform:uppercase;letter-spacing:.12em;font-size:13px;font-weight:600;color:#9bc46a}
  .hero h1{font-size:clamp(34px,5.5vw,58px);font-weight:800;margin:.3em 0}
  .hero p{font-size:20px;color:rgba(255,255,255,.8);max-width:720px}
  .hero .actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}
  .stand{margin-top:22px;font-size:14px;color:rgba(255,255,255,.55)}

  /* Kennzahlen */
  .stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin-top:-44px}
  .stat{background:var(--card);border-radius:var(--radius);padding:24px;box-shadow:0 8px 30px rgba(21,26,36,.08)}
  .stat .n{font-family:Manrope,sans-serif;font-weight:800;font-size:40px;color:var(--green);line-height:1}
  .stat .t{margin-top:8px;font-weight:600}
  .stat .s{font-size:14px;color:var(--muted);margin-top:4px}

  section{padding:72px 0}
  section h2{font-size:clamp(26px,3.5vw,36px);font-weight:800}
  .lead{font-size:19px;color:var(--muted);max-width:760px}

  /* Zeitstrahl */
  .timeline{position:relative;margin-top:36px;padding-left:28px}
  .timeline::before{content:"";position:absolute;left:8px;top:6px;bottom:6px;width:2px;background:var(--line)}
  .ev{position:relative;margin-bottom:26px;background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:18px 20px}
  .ev::before{content:"";position:absolute;left:-26px;top:22px;width:14px;height:14px;border-radius:50%;background:#fff;border:3px solid var(--green)}
  .ev.key{border-color:var(--green);box-shadow:0 0 0 3px rgba(85,130,39,.12)}
  .ev.key::before{background:var(--green)}
  .ev .d{font-family:Manrope,sans-serif;font-weight:800;color:var(--green)}
  .ev h3{font-size:18px;margin:.2em 0 .3em}
  .ev p{margin:0;color:var(--muted)}
  .src{display:inline-block;margin-top:10px;font-size:12.5px;background:var(--soft);color:var(--muted);padding:3px 10px;border-radius:999px}

  /* E-Mails */
  .mails{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:30px}
  @media(max-width:860px){.mails{grid-template-columns:1fr}}
  .mail{margin:0;background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:20px;display:flex;flex-direction:column;gap:12px}
  .mail.key{border-color:var(--green);box-shadow:0 0 0 3px rgba(85,130,39,.12)}
  .mail .meta{font-size:14px;color:var(--muted)}
  .mail .meta .d{font-family:Manrope,sans-serif;font-weight:800;color:var(--green)}
  .mail img{width:100%;height:auto;border-radius:10px;border:1px solid var(--line)}
  .mail .shot.todo{border:2px dashed #e0b4b4;background:#fff5f5;color:#b00000;border-radius:10px;padding:34px 16px;text-align:center;font-weight:600;font-size:14px}
  .mail figcaption{font-family:Manrope,sans-serif;font-weight:700;font-size:17px;line-height:1.4}
  .mail .why{margin:0;font-size:14.5px;color:var(--muted);border-top:1px solid var(--line);padding-top:10px}

  /* Zitate */
  .quotes{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:18px;margin-top:32px}
  blockquote{margin:0;background:var(--navy);color:#fff;border-radius:var(--radius);padding:26px}
  blockquote p{font-family:Manrope,sans-serif;font-size:19px;font-weight:700;margin:0 0 14px}
  blockquote cite{font-style:normal;font-size:13.5px;color:rgba(255,255,255,.65)}

  /* Fragen / Standards */
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:28px;margin-top:28px}
  @media(max-width:820px){.grid2{grid-template-columns:1fr}}
  .card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:26px}
  ol.q{counter-reset:q;list-style:none;padding:0;margin:0}
  ol.q li{counter-increment:q;position:relative;padding:0 0 16px 48px;font-weight:600}
  ol.q li::before{content:counter(q);position:absolute;left:0;top:-2px;width:32px;height:32px;border-radius:50%;background:var(--green);color:#fff;display:grid;place-items:center;font-family:Manrope,sans-serif}
  ul.check{list-style:none;padding:0;margin:0}
  ul.check li{position:relative;padding:0 0 12px 30px}
  ul.check li::before{content:"✓";position:absolute;left:0;top:0;color:var(--green);font-weight:800}

  /* Einordnung */
  .note{background:#fff8e6;border:1px solid #f0dca8;border-radius:var(--radius);padding:22px 24px;margin-top:28px}
  .note h3{font-size:17px}
  .note ul{margin:.3em 0 0;padding-left:20px}
  .other{background:var(--soft);border-radius:var(--radius);padding:22px 24px;margin-top:18px}

  /* Dokumente */
  table.docs{width:100%;border-collapse:collapse;margin-top:26px;background:var(--card);border-radius:var(--radius);overflow:hidden}
  table.docs th,table.docs td{text-align:left;padding:14px 16px;border-bottom:1px solid var(--line);font-size:15px;vertical-align:top}
  table.docs th{background:var(--navy);color:#fff;font-weight:600}
  @media(max-width:640px){table.docs thead{display:none}table.docs td{display:block;border:0;padding:6px 16px}table.docs tr{display:block;border-bottom:1px solid var(--line);padding:10px 0}}

  /* FAQ */
  details{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px 20px;margin-bottom:12px}
  summary{cursor:pointer;font-weight:600;font-family:Manrope,sans-serif}
  details p{color:var(--muted);margin:.7em 0 0}

  .contact{background:var(--navy);color:#fff;border-radius:var(--radius);padding:36px;display:flex;flex-wrap:wrap;justify-content:space-between;gap:20px;align-items:center}
  .contact p{margin:0;color:rgba(255,255,255,.8)}
  footer{padding:28px 0 48px;font-size:13.5px;color:var(--muted)}
  .wait{color:#c0392b;font-weight:700}
  /* Ankündigung ohne Gewerbe */
  .gap{margin-top:30px;background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:10px 24px}
  .gap-row{display:grid;grid-template-columns:120px 1fr;gap:16px;padding:14px 0;border-bottom:1px solid var(--line);align-items:baseline}
  .gap-row:last-child{border-bottom:0}
  .gap-d{font-family:Manrope,sans-serif;font-weight:800;color:var(--green)}
  .gap-row.hot{background:#fff6e0;margin:0 -24px;padding:14px 24px}
  .gap-row.hot .gap-d{color:#b36b00}
  .gap-bar{margin:6px 0;height:44px;border-radius:10px;background:repeating-linear-gradient(135deg,#fde2e2 0 12px,#fbd0d0 12px 24px);display:flex;align-items:center;justify-content:center}
  .gap-bar.long{height:64px}
  .gap-bar span{font-family:Manrope,sans-serif;font-weight:800;color:#b00000;font-size:15px;background:rgba(255,255,255,.85);padding:4px 12px;border-radius:999px}
  .bigq{margin-top:22px;background:var(--navy);color:#fff;border-radius:var(--radius);padding:28px}
  .bigq-t{font-family:Manrope,sans-serif;font-weight:800;font-size:clamp(24px,3.2vw,34px);color:#9bc46a;margin-bottom:8px}
  .bigq p{margin:0;color:rgba(255,255,255,.88);font-size:17.5px}
  @media(max-width:560px){.gap-row{grid-template-columns:1fr;gap:2px}}
  /* Rechner */
  .calc{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:28px}
  @media(max-width:860px){.calc{grid-template-columns:1fr}}
  .inputs{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:24px;display:flex;flex-direction:column;gap:18px}
  .inputs label{font-weight:600;display:flex;flex-direction:column;gap:6px}
  .inputs input{font:inherit;font-size:18px;padding:10px 12px;border:1.5px solid var(--line);border-radius:10px;background:#fff}
  .inputs input:focus{outline:none;border-color:var(--green)}
  .inputs small{font-weight:400;color:var(--muted);font-size:13px}
  .results{display:flex;flex-direction:column;gap:14px}
  .res{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:18px 22px}
  .res .lbl{font-size:14px;color:var(--muted)}
  .res .val{font-family:Manrope,sans-serif;font-weight:800;font-size:30px;color:var(--green)}
  .res.neg .val{color:#c0392b}
  .res.big{background:var(--navy);border:0}
  .res.big .lbl{color:rgba(255,255,255,.7)}
  .res.big .val{color:#9bc46a;font-size:40px}
  .split{margin-top:6px;font-size:14px;color:rgba(255,255,255,.8)}
  .calcnote{font-size:13.5px;color:var(--muted);margin-top:16px}
  .ph{background:#ffe7e7;color:#b00000;border-radius:4px;padding:0 4px;font-weight:600}
</style>
</head>
<body>

<header class="top">
  <div class="bar">
    <a class="logo" href="/">Ökovolt<span> Solartechnik</span></a>
