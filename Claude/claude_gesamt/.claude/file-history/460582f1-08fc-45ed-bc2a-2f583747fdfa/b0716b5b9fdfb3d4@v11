def new_doc(landscape=False, size=10.5):
    d = Document()
    s = d.sections[0]
    if landscape:
        s.orientation = WD_ORIENT.LANDSCAPE
        s.page_width, s.page_height = s.page_height, s.page_width
    s.left_margin = s.right_margin = Cm(1.8)
    s.top_margin = s.bottom_margin = Cm(1.5)
    n = d.styles["Normal"]
    n.font.name = "Calibri"
    n.font.size = Pt(size)
    n.paragraph_format.space_after = Pt(6)
    return d


def add(p, text, bold=False, size=None, color=None, italic=False):
    for part in re.split(r"(\[[^\]]+\])", text):
        if not part:
            continue
        r = p.add_run(part)
        r.bold, r.italic = bold, italic
        if size:
            r.font.size = Pt(size)
        if part.startswith("["):
            r.font.color.rgb, r.bold = PH, True
        elif color:
            r.font.color.rgb = color
    return p


def shade(c, hexcolor):
    tcPr = c._tc.get_or_add_tcPr()
    sh = OxmlElement("w:shd")
    sh.set(qn("w:val"), "clear")
    sh.set(qn("w:fill"), hexcolor)
    tcPr.append(sh)


def cell(c, text, **kw):
    c.paragraphs[0].text = ""
    add(c.paragraphs[0], text, **kw).paragraph_format.space_after = Pt(1)


def table(d, header, rows, widths, size=9):
    t = d.add_table(rows=len(rows) + 1, cols=len(header))
    t.style = "Table Grid"
    for j, h in enumerate(header):
        cell(t.rows[0].cells[j], h, bold=True, size=size + 0.5, color=WHITE)
        shade(t.rows[0].cells[j], "1F4E3D")
    for i, r in enumerate(rows, start=1):
        for j, txt in enumerate(r):
            cell(t.rows[i].cells[j], txt, size=size, bold=(j == 0))
            if i % 2 == 0:
                shade(t.rows[i].cells[j], "EEF3F1")
    for row in t.rows:
        for j, w in enumerate(widths):
            row.cells[j].width = Cm(w)
    return t


def h(d, text, size=13):
    p = add(d.add_paragraph(), text, bold=True, size=size, color=ACCENT)
    p.paragraph_format.space_before = Pt(10)
    p.paragraph_format.keep_with_next = True


