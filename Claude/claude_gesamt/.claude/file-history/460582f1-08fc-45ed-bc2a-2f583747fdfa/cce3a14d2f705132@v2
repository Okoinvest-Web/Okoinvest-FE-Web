def add(p, text, bold=False, size=None, color=None, italic=False):
    for part in re.split(r"(\[[^\]]+\])", text):
        if not part:
            continue
        r = p.add_run(part)
        r.bold, r.italic = bold, italic
        if size:
            r.font.size = Pt(size)
        if part.startswith("["):
            r.font.color.rgb, r.bold = PH, True
        elif color:
            r.font.color.rgb = color
    return p


def shade(c, hexcolor):
    tcPr = c._tc.get_or_add_tcPr()
    sh = OxmlElement("w:shd")
    sh.set(qn("w:val"), "clear")
    sh.set(qn("w:fill"), hexcolor)
    tcPr.append(sh)


def new_doc():
    d = Document()
    s = d.sections[0]
    s.left_margin = s.right_margin = Cm(2.0)
    s.top_margin = s.bottom_margin = Cm(1.6)
    n = d.styles["Normal"]
    n.font.name = "Calibri"
    n.font.size = Pt(10.5)
    n.paragraph_format.space_after = Pt(4)
    return d


def h(d, t, size=13, color=GREEN, before=10):
    p = add(d.add_paragraph(), t, bold=True, size=size, color=color)
    p.paragraph_format.space_before = Pt(before)
    p.paragraph_format.keep_with_next = True


def mailbox(d, betreff, text, color):
    t = d.add_table(rows=2, cols=1)
    t.style = "Table Grid"
    c0, c1 = t.rows[0].cells[0], t.rows[1].cells[0]
    shade(c0, "E9EEF0")
    c0.paragraphs[0].text = ""
    add(c0.paragraphs[0], "Betreff: ", bold=True, color=color, size=10)
    add(c0.paragraphs[0], betreff, bold=True, size=10)
    c1.paragraphs[0].text = ""
    for i, line in enumerate(text.strip("\n").split("\n")):
        p = c1.paragraphs[0] if i == 0 else c1.add_paragraph()
        add(p, line, size=10)
        p.paragraph_format.space_after = Pt(1)
    d.add_paragraph()


def table(d, header, rows, widths, color="1F4E3D", size=9.5):
    t = d.add_table(rows=len(rows) + 1, cols=len(header))
    t.style = "Table Grid"
    for j, hd in enumerate(header):
        c = t.rows[0].cells[j]
        c.paragraphs[0].text = ""
        add(c.paragraphs[0], hd, bold=True, size=size, color=WHITE)
        shade(c, color)
    for i, r in enumerate(rows, start=1):
        for j, txt in enumerate(r):
            c = t.rows[i].cells[j]
            c.paragraphs[0].text = ""
            add(c.paragraphs[0], txt, size=size, bold=(j == 0))
            if i % 2 == 0:
                shade(c, "EEF3F1")
    for row in t.rows:
        for j, w in enumerate(widths):
            row.cells[j].width = Cm(w)
    d.add_paragraph()


