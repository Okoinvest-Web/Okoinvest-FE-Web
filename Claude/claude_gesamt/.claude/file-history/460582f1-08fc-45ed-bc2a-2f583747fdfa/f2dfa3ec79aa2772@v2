def add(p, text, bold=False, size=None, color=None, italic=False):
    for part in re.split(r"(\[[^\]]+\])", text):
        if not part:
            continue
        r = p.add_run(part)
        r.bold, r.italic = bold, italic
        if size:
            r.font.size = Pt(size)
        if part.startswith("["):
            r.font.color.rgb, r.bold = PH, True
        elif color:
            r.font.color.rgb = color
    return p


def shade(c, hexcolor):
    tcPr = c._tc.get_or_add_tcPr()
    sh = OxmlElement("w:shd")
    sh.set(qn("w:val"), "clear")
    sh.set(qn("w:fill"), hexcolor)
    tcPr.append(sh)


def new_doc(landscape=False, size=10.5):
    d = Document()
    s = d.sections[0]
    if landscape:
        s.orientation = WD_ORIENT.LANDSCAPE
        s.page_width, s.page_height = s.page_height, s.page_width
    s.left_margin = s.right_margin = Cm(1.9)
    s.top_margin = s.bottom_margin = Cm(1.5)
    n = d.styles["Normal"]
    n.font.name = "Calibri"
    n.font.size = Pt(size)
    n.paragraph_format.space_after = Pt(5)
    n.paragraph_format.line_spacing = 1.12
    return d


def table(d, header, rows, widths, size=9):
    t = d.add_table(rows=len(rows) + 1, cols=len(header))
    t.style = "Table Grid"
    for j, h in enumerate(header):
        c = t.rows[0].cells[j]
        c.paragraphs[0].text = ""
        add(c.paragraphs[0], h, bold=True, size=size + 0.5, color=WHITE)
        shade(c, "1F3A5F")
    for i, r in enumerate(rows, start=1):
        for j, txt in enumerate(r):
            c = t.rows[i].cells[j]
            c.paragraphs[0].text = ""
            add(c.paragraphs[0], txt, size=size, bold=(j == 0))
            if i % 2 == 0:
                shade(c, "EDF1F6")
    for row in t.rows:
        for j, w in enumerate(widths):
            row.cells[j].width = Cm(w)
    d.add_paragraph()


def h(d, t, size=13):
    p = add(d.add_paragraph(), t, bold=True, size=size, color=ACCENT)
    p.paragraph_format.space_before = Pt(10)
    p.paragraph_format.keep_with_next = True


def para(d, t, **kw):
    p = add(d.add_paragraph(), t, **kw)
    p.alignment = WD_ALIGN_PARAGRAPH.JUSTIFY
    return p


def bullets(d, items):
    for it in items:
        p = d.add_paragraph(style="List Bullet")
        if isinstance(it, tuple):
            add(p, it[0] + " ", bold=True)
            add(p, it[1])
        else:
            add(p, it)


