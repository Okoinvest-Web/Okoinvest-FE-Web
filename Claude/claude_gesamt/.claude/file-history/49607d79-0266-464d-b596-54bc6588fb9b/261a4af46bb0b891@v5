<template>
  <div>
    <PageHeader title="Drift" :subtitle="untertitel">
      <template #actions>
        <Button v-if="!formularOffen" variant="solid" @click="neuAnlegen">
          Konnektor anlegen
        </Button>
      </template>
    </PageHeader>

    <div class="p-6">
      <!-- Anlegen und Bearbeiten -->
      <section
        v-if="formularOffen"
        class="mb-8 rounded-lg border border-outline-gray-2 bg-surface-white p-4"
      >
        <h2 class="mb-1 text-base font-semibold text-ink-gray-8">
          {{ bearbeitet ? 'Konnektor bearbeiten' : 'Neuer Konnektor' }}
        </h2>
        <p class="mb-4 text-sm text-ink-gray-6">
          Zugangsdaten gehören nach Passbolt. Dieses Formular nimmt nur den Verweis darauf entgegen
          – und die Server-Methode lehnt jedes Feld ab, das nach einem Geheimnis aussieht.
        </p>
        <div class="max-w-xl">
          <ConnectorForm
            :optionen="optionen.data"
            :vorhanden="bearbeitet"
            @gespeichert="nachSpeichern"
            @abbrechen="formularZu"
          />
        </div>
      </section>

      <section class="mb-8">
        <h2 class="mb-3 text-base font-semibold text-ink-gray-8">Konnektoren</h2>
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-2 xl:grid-cols-4">
          <div
            v-for="k in konnektoren.data || []"
            :key="k.name"
            class="rounded-lg border border-outline-gray-2 bg-surface-white p-4"
          >
            <div class="flex items-start justify-between gap-2">
              <p class="min-w-0 truncate text-base font-medium text-ink-gray-9">
                {{ k.connector_name }}
              </p>
              <Badge v-if="k.read_only" theme="gray">nur lesen</Badge>
            </div>
            <p class="mt-0.5 text-sm text-ink-gray-6">{{ k.kind }} · {{ k.target || '–' }}</p>

            <StatusDot
              class="mt-2"
              :level="gesundheitStufe(k.health)"
              :text="GESUNDHEIT[k.health] || k.health"
            />

            <dl class="mt-3 space-y-1 text-sm text-ink-gray-6">
              <div class="flex justify-between gap-2">
                <dt>Letzter Lauf</dt>
                <dd class="tabular-nums">
                  {{ k.last_run_age_hours === null ? 'nie' : k.last_run_age_hours + ' h her' }}
                </dd>
              </div>
              <div class="flex justify-between gap-2">
                <dt>Objekte</dt>
                <dd class="tabular-nums">{{ k.last_objects_read ?? '–' }}</dd>
              </div>
              <div class="flex justify-between gap-2">
                <dt>Offene Befunde</dt>
                <dd class="tabular-nums">{{ k.open_findings }}</dd>
              </div>
              <div v-if="k.scope_note" class="pt-1 text-sm text-ink-gray-5">
                Liest: {{ k.scope_note }}
              </div>
              <div v-if="!k.read_only" class="pt-1">
                <StatusDot
                  level="warning"
                  :text="'Schreibend: ' + (k.write_reason || 'ohne Grund')"
                  klein
                />
              </div>
            </dl>

            <div class="mt-3 flex flex-wrap gap-2 border-t border-outline-gray-2 pt-3">
              <Button size="sm" @click="bearbeiten(k)">Bearbeiten</Button>
              <Button v-if="k.enabled" size="sm" variant="subtle" @click="abschaltenFragen(k)">
                Abschalten
              </Button>
              <Button v-else size="sm" @click="einschalten(k)">Einschalten</Button>
            </div>
          </div>
        </div>
      </section>

      <section>
        <div class="mb-3 flex items-center justify-between gap-3">
          <h2 class="text-base font-semibold text-ink-gray-8">Abweichungen</h2>
          <FormControl v-model="zustand" type="select" :options="zustandOptionen" />
        </div>

        <DataTable
          tabellen-id="DriftView"
          :columns="spalten"
          :rows="befunde.data || []"
          :loading="befunde.loading"
          empty-text="Keine Abweichung mit diesem Filter."
        >
          <template #zelle-finding_kind="{ zeile }">
            <StatusDot
              :level="artStufe(zeile.finding_kind)"
              :text="ART[zeile.finding_kind] || zeile.finding_kind"
            />
          </template>
          <template #zelle-object_name="{ zeile }">
            <span class="block text-ink-gray-8">{{ zeile.object_name }}</span>
            <span class="block text-sm text-ink-gray-5">{{ zeile.object_type }}</span>
          </template>
          <template #zelle-werte="{ zeile }">
            <span class="block text-sm text-ink-gray-5">
              Soll: <span class="text-ink-gray-8">{{ zeile.soll_value || '–' }}</span>
            </span>
            <span class="block text-sm text-ink-gray-5">
              Ist: <span class="text-ink-gray-8">{{ zeile.ist_value || '–' }}</span>
            </span>
          </template>
          <template #zelle-aktion="{ zeile }">
            <div v-if="zeile.state === 'open'" class="flex justify-end gap-2">
              <Button size="sm" @click="setze(zeile, 'accepted')">Übernehmen</Button>
              <Button size="sm" @click="setze(zeile, 'rejected')">Verwerfen</Button>
            </div>
            <Badge v-else :theme="zeile.state === 'accepted' ? 'green' : 'gray'">
              {{ ZUSTAND[zeile.state] }}
            </Badge>
          </template>
        </DataTable>

        <p class="mt-3 text-xs text-ink-gray-4">
          „Übernehmen“ schließt den Befund ab und ändert das Soll-Dokument
          <strong>nicht</strong> – dafür ist der Change-Workflow zuständig (Fachkonzept 2.10).
          Konnektoren schreiben grundsätzlich nie ins Soll.
        </p>
      </section>
    </div>

    <!--
      Abschalten statt Loeschen: ein geloeschter Konnektor nimmt seine
      Historie mit, und die Frage "seit wann kommt von dort nichts mehr?"
      laesst sich dann nicht mehr beantworten.
    -->
    <Dialog v-model="abschaltDialog" :options="{ title: 'Konnektor abschalten' }">
      <template #body-content>
        <p class="mb-3 text-sm text-ink-gray-6">
          {{ abzuschalten?.connector_name }} liefert danach keine Daten mehr. Der Datensatz bleibt
          erhalten – gelöscht wird nichts.
        </p>
        <FormControl
          v-model="abschaltGrund"
          label="Grund (kommt ins Protokoll)"
          type="text"
          placeholder="Quelle wird abgelöst"
        />
      </template>
      <template #actions>
        <Button variant="solid" :disabled="!abschaltGrund" @click="abschaltenAusfuehren">
          Abschalten
        </Button>
      </template>
    </Dialog>
  </div>
</template>

<script setup>
import { computed, ref, watch } from 'vue'
import { Badge, Button, Dialog, FormControl, createResource, toast } from 'frappe-ui'
import PageHeader from '@/components/PageHeader.vue'
import DataTable from '@/components/DataTable.vue'
import StatusDot from '@/components/StatusDot.vue'
import ConnectorForm from '@/components/ConnectorForm.vue'
import { fehlerText, mengeText } from '@/viz'

const ART = { changed: 'Abweichung', unknown_object: 'Unbekanntes Objekt', missing: 'Fehlt' }
const ZUSTAND = { open: 'Offen', accepted: 'Übernommen', rejected: 'Verworfen' }
const GESUNDHEIT = {
  ok: 'Läuft',
  warning: 'Warnung',
  error: 'Fehler',
  stale: 'Überfällig',
  disabled: 'Abgeschaltet',
}

const zustand = ref('open')

const konnektoren = createResource({ url: 'netops.api.ops.connector_status', auto: true })
const optionen = createResource({ url: 'netops.api.ops.connector_options', auto: true })

const formularOffen = ref(false)
const bearbeitet = ref(null)
const abschaltDialog = ref(false)
const abzuschalten = ref(null)
const abschaltGrund = ref('')

const abschalten = createResource({ url: 'netops.api.ops.disable_connector' })
const anschalten = createResource({ url: 'netops.api.ops.enable_connector' })

const untertitel = computed(() => {
  const k = konnektoren.data || []
  const still = k.filter((x) => x.overdue && x.enabled).length
  const schreibend = k.filter((x) => !x.read_only).length
  return (
    mengeText(k.length, 'Konnektor', 'Konnektoren') +
    (still ? ' · ' + still + ' überfällig' : '') +
    (schreibend ? ' · ' + schreibend + ' schreibend' : ' · alle nur lesend')
  )
})

function neuAnlegen() {
  bearbeitet.value = null
  formularOffen.value = true
}

function bearbeiten(k) {
  bearbeitet.value = k
  formularOffen.value = true
}

function formularZu() {
  formularOffen.value = false
  bearbeitet.value = null
}

async function nachSpeichern() {
  toast.create({
    message: bearbeitet.value ? 'Gespeichert' : 'Konnektor angelegt',
    type: 'success',
  })
  formularZu()
  await konnektoren.fetch()
}

function abschaltenFragen(k) {
  abzuschalten.value = k
  abschaltGrund.value = ''
  abschaltDialog.value = true
}

async function abschaltenAusfuehren() {
  try {
    await abschalten.submit({ name: abzuschalten.value.name, reason: abschaltGrund.value })
    toast.create({ message: 'Abgeschaltet', type: 'success' })
    abschaltDialog.value = false
    await konnektoren.fetch()
  } catch (fehler) {
    toast.create({ message: fehlerText(fehler), type: 'error' })
  }
}

async function einschalten(k) {
  try {
    await anschalten.submit({ name: k.name })
    toast.create({ message: 'Eingeschaltet', type: 'success' })
    await konnektoren.fetch()
  } catch (fehler) {
    toast.create({ message: fehlerText(fehler), type: 'error' })
  }
}

const befunde = createResource({
  url: 'netops.api.ops.drift_list',
  makeParams: () => ({ state: zustand.value || null }),
  auto: true,
})

watch(zustand, () => befunde.fetch())

const zustandOptionen = [
  { label: 'Offen', value: 'open' },
  { label: 'Übernommen', value: 'accepted' },
  { label: 'Verworfen', value: 'rejected' },
  { label: 'Alle', value: '' },
]

const spalten = [
  { key: 'finding_kind', label: 'Art', width: '180px' },
  { key: 'object_name', label: 'Objekt', width: '220px' },
  { key: 'field', label: 'Feld', width: '140px' },
  { key: 'werte', label: 'Soll / Ist' },
  { key: 'connector', label: 'Konnektor', muted: true, width: '180px' },
  { key: 'aktion', label: '', align: 'right', width: '220px' },
]

const setzen = createResource({ url: 'netops.api.ops.set_drift_state' })

async function setze(befund, neuerZustand) {
  await setzen.submit({ name: befund.name, state: neuerZustand })
  toast.create({
    message: neuerZustand === 'accepted' ? 'Befund übernommen' : 'Befund verworfen',
    type: 'success',
  })
  befunde.fetch()
  konnektoren.fetch()
}

function artStufe(art) {
  return { changed: 'warning', unknown_object: 'critical', missing: 'serious' }[art] || 'neutral'
}

function gesundheitStufe(gesundheit) {
  return (
    { ok: 'ok', warning: 'warning', error: 'critical', stale: 'serious', disabled: 'neutral' }[
      gesundheit
    ] || 'neutral'
  )
}
</script>
