await klick(`[...document.querySelectorAll('button')].filter(x => x.innerText.trim() === 'Genehmigen').at(-1)`)
await schlafe(1600)
console.log('  Zustand jetzt:', await js(`(() => { const r=[...document.querySelectorAll('tbody tr')].find(x=>x.innerText.includes('Beweissicherung')); return r ? r.innerText.split(String.fromCharCode(10)).slice(0,4).join(' / ') : 'Zeile weg' })()`))
