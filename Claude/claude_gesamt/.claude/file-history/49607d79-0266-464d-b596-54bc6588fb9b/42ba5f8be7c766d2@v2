/**
 * Einziger Ort, an dem entschieden wird, wohin Datenabfragen gehen.
 *
 *   VITE_USE_MOCK=true   -> Browser-Mock, kein Backend noetig (Standard)
 *   VITE_USE_MOCK=false  -> echtes Frappe ueber den Vite-Proxy
 *
 * Alle Komponenten nutzen ausschliesslich createResource/createListResource
 * aus frappe-ui. Sie merken vom Unterschied nichts.
 */
import { setConfig, frappeRequest } from 'frappe-ui'
import { aktuellerMandant } from '@/stores/ui'

export const USE_MOCK = import.meta.env.VITE_USE_MOCK !== 'false'

/** Methoden, die von sich aus keinen Mandantenfilter kennen. */
const OHNE_MANDANT = new Set([
  'frappe.auth.get_logged_user',
  'logout',
  'netops.api.audit.verify_chain',
  'netops.api.audit.audit_log',
])

/**
 * Setzt den gewählten Mandanten in jede Abfrage.
 *
 * Im echten Frappe passiert die Mandantentrennung über die Rechteregeln auf
 * dem Server - der Client bittet nicht darum, er bekommt gar nichts anderes.
 * Diese Schicht bildet das nach, damit die Oberfläche sich schon jetzt so
 * verhält. Sie ist ausdrücklich **keine** Sicherheitsmaßnahme: ohne Backend
 * gibt es keine, die Daten liegen ohnehin alle im Browser.
 */
function mitMandant(fetcher) {
  return function (options = {}) {
    const mandant = aktuellerMandant()
    const pfad = String(options.url || '').replace(/^\/?api\/method\//, '')

    if (!mandant || OHNE_MANDANT.has(pfad)) return fetcher(options)

    const params = { ...(options.params || {}) }

    if (pfad === 'frappe.client.get_list' || pfad === 'frappe.client.get_count') {
      // Bei Listen wird der Mandant zum Filter, nicht zum Argument.
      const filter = params.filters
      if (Array.isArray(filter)) {
        params.filters = [...filter, ['tenant', '=', mandant]]
      } else {
        params.filters = { ...(filter || {}), tenant: mandant }
      }
    } else if (params.tenant === undefined) {
      params.tenant = mandant
    }

    return fetcher({ ...options, params })
  }
}

export async function setupApi() {
  if (USE_MOCK) {
    const { mockRequest } = await import('./mock/server.js')
    setConfig('resourceFetcher', mitMandant(mockRequest))
  } else {
    setConfig('resourceFetcher', mitMandant(frappeRequest))
  }
}
