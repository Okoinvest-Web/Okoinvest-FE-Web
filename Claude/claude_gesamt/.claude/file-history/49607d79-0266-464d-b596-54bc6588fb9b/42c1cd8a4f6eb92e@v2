describe('Inventur', () => {
  it('friert beim Start den Sollbestand ein', async () => {
    const e = await ruf('netops.api.inventar.count_start', {
      count_name: 'Test Passau',
      site: 'SITE-0005',
    })
    expect(e.lines).toBeGreaterThan(0)
    const detail = await ruf('netops.api.inventar.count_detail', { name: e.count })
    expect(detail.lines.every((z) => z.line_state === 'pending')).toBe(true)
  })

  it('lässt für denselben Umfang keine zweite Inventur zu', async () => {
    await expect(
      ruf('netops.api.inventar.count_start', { count_name: 'Zweite', site: 'SITE-0001' }),
    ).rejects.toThrow(/läuft bereits/)
  })

  it('liest eine gescannte QR-URL und findet die Inventarnummer darin', async () => {
    const e = await ruf('netops.api.inventar.count_scan', {
      count: 'INV-Z-0001',
      asset_tag: 'https://netops.oekovolt.test/netops/inventory/INV-000320',
    })
    expect(e.ok).toBe(true)
    expect(e.asset).toBe('INV-000320')
  })

  it('meldet einen unbekannten Code, statt zu scheitern', async () => {
    const e = await ruf('netops.api.inventar.count_scan', {
      count: 'INV-Z-0001',
      asset_tag: 'GIBTSNICHT',
    })
    expect(e.ok).toBe(false)
    expect(e.reason).toBe('unknown_tag')
  })

  it('erkennt ein Gerät an einem anderen Ort als verschoben', async () => {
    const e = await ruf('netops.api.inventar.count_scan', {
      count: 'INV-Z-0001',
      asset_tag: 'INV-000101',
      found_room: 'A.09',
    })
    expect(e.line_state).toBe('moved')
    expect(e.expected_room).toBe('A.02')
  })

  it('erklärt ein fehlendes Gerät, wenn es ausgegeben ist', async () => {
    // Ein Gerät, das jemand in der Hand hat, fehlt im Regal zu Recht.
    const detail = await ruf('netops.api.inventar.count_detail', { name: 'INV-Z-0001' })
    const zeile = detail.lines.find((z) => z.explained_by_assignment)
    if (zeile) expect(zeile.level).toBe('neutral')
    expect(detail.summary.missing).toBeLessThanOrEqual(detail.summary.total)
  })

  it('übernimmt beim Abschluss die gefundenen Standorte', async () => {
    await ruf('netops.api.inventar.count_scan', {
      count: 'INV-Z-0001',
      asset_tag: 'INV-000101',
      found_room: 'A.09',
    })
    const e = await ruf('netops.api.inventar.count_close', { name: 'INV-Z-0001' })
    expect(e.corrected).toBeGreaterThan(0)
    const asset = await ruf('netops.api.inventar.asset_detail', { name: 'INV-000101' })
    expect(asset.room).toBe('A.09')
  })

  it('lässt sich nicht zweimal abschließen', async () => {
    await ruf('netops.api.inventar.count_close', { name: 'INV-Z-0001' })
    await expect(ruf('netops.api.inventar.count_close', { name: 'INV-Z-0001' })).rejects.toThrow(
      /bereits abgeschlossen/,
    )
  })

  it('nimmt nach dem Abschluss keinen Scan mehr an', async () => {
    await ruf('netops.api.inventar.count_close', { name: 'INV-Z-0001' })
    await expect(
      ruf('netops.api.inventar.count_scan', { count: 'INV-Z-0001', asset_tag: 'INV-000101' }),
    ).rejects.toThrow(/abgeschlossen/)
  })
})

describe('Entsorgung', () => {
  it('verlangt bei einem Datenträger den Löschnachweis', async () => {
    // Artikel 17 DSGVO verlangt den Nachweis der Löschung.
    await expect(
      ruf('netops.api.inventar.dispose_asset', {
        asset: 'INV-000121',
        method: 'recycled',
        data_carrier: true,
      }),
    ).rejects.toThrow(/Löschverfahren/)
  })

  it('verlangt zusätzlich das Datum der Löschbestätigung', async () => {
    await expect(
      ruf('netops.api.inventar.dispose_asset', {
        asset: 'INV-000121',
        method: 'recycled',
        data_carrier: true,
        erasure_method: 'BSI TL-03423',
      }),
    ).rejects.toThrow(/Löschbestätigung/)
  })

  it('entsorgt ein Gerät ohne Datenträger ohne Löschnachweis', async () => {
    const e = await ruf('netops.api.inventar.dispose_asset', {
      asset: 'INV-000501',
      method: 'donated',
      recipient: 'Sozialmarkt',
    })
    expect(e.ok).toBe(true)
    expect(e.asset_state).toBe('disposed')
  })

  it('entsorgt kein Gerät, das noch jemand hat', async () => {
    await expect(
      ruf('netops.api.inventar.dispose_asset', { asset: 'INV-000101', method: 'recycled' }),
    ).rejects.toThrow(/noch ausgegeben/)
  })

  it('markiert einen Nachweis ohne Löschbeleg als unvollständig', async () => {
    const liste = await ruf('netops.api.inventar.disposal_list', {})
    for (const e of liste) {
      expect(e.complete).toBe(!e.data_carrier || !!(e.erasure_method && e.erasure_verified_on))
    }
  })

  it('behält das entsorgte Gerät im Bestand, damit der Nachweis bleibt', async () => {
    const detail = await ruf('netops.api.inventar.asset_detail', { name: 'INV-000105' })
    expect(detail.asset_state).toBe('disposed')
    expect(detail.disposal).toBeTruthy()
    expect(detail.disposal.erasure_method).toMatch(/BSI/)
  })
})

describe('Etiketten', () => {
  it('enthält keine Personen- und keine Gerätedaten im Code', async () => {
    // Ein Etikett hängt sichtbar am Gerät. Wer es fotografiert, soll
    // daraus nichts über Menschen oder Seriennummern erfahren.
    const { labels } = await ruf('netops.api.inventar.label_payload', {})
    const assets = await ruf('netops.api.inventar.asset_list', {})

    for (const etikett of labels) {
      const asset = assets.find((a) => a.name === etikett.asset)
      expect(etikett.qr_content).toContain(asset.asset_tag)
      if (asset.serial) expect(etikett.qr_content).not.toContain(asset.serial)
      if (asset.holder_name) {
        const nachname = asset.holder_name.split(' ').at(-1)
        expect(etikett.qr_content).not.toContain(nachname)
      }
    }
  })

  it('liefert eine auflösbare Adresse auf die eigene Instanz', async () => {
    const { labels, base_url } = await ruf('netops.api.inventar.label_payload', {
      assets: ['INV-000101'],
    })
    expect(labels[0].qr_content.startsWith(base_url)).toBe(true)
    expect(labels[0].barcode_content).toBe('INV-000101')
  })
})

describe('Fristen', () => {
  it('sammelt Garantie, Prüfung, Lizenz, Vertrag und Zertifikat in einer Liste', async () => {
    const f = await ruf('netops.api.inventar.deadline_overview', { days: 365 })
    const arten = new Set(f.entries.map((e) => e.kind))
    expect(arten.has('warranty')).toBe(true)
    expect(arten.has('inspection')).toBe(true)
    expect(arten.has('license')).toBe(true)
  })

  it('sortiert das Überfällige nach vorn', async () => {
    const f = await ruf('netops.api.inventar.deadline_overview', { days: 90 })
    const tage = f.entries.map((e) => e.days)
    expect([...tage].sort((a, b) => a - b)).toEqual(tage)
    expect(f.entries[0].days).toBeLessThan(0)
  })

  it('stuft Überfälliges kritisch und die nächsten 30 Tage als Warnung', async () => {
    const f = await ruf('netops.api.inventar.deadline_overview', { days: 90 })
    for (const e of f.entries) {
      if (e.days < 0) expect(e.level).toBe('critical')
      else if (e.days <= 30) expect(e.level).toBe('warning')
      else expect(e.level).toBe('ok')
    }
  })

  it('hält sich an das Zeitfenster', async () => {
    const f = await ruf('netops.api.inventar.deadline_overview', { days: 30 })
    expect(f.entries.every((e) => e.days <= 30)).toBe(true)
  })
})

