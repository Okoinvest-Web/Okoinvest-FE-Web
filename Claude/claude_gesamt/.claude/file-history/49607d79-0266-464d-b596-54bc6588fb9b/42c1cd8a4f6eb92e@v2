describe('Bestandsübersicht', () => {
  it('summiert Anschaffungs- und Restbuchwert über den aktiven Bestand', async () => {
    const u = await ruf('netops.api.inventar.inventory_overview', {})
    expect(u.summary.book_value_cents).toBeLessThan(u.summary.purchase_value_cents)
    expect(u.summary.active).toBe(u.summary.total - u.summary.by_state.disposed)
  })

  it('gruppiert nach Kostenstelle für die Buchhaltung', async () => {
    const u = await ruf('netops.api.inventar.inventory_overview', {})
    expect(u.by_cost_center.length).toBeGreaterThan(1)
    const summe = u.by_cost_center.reduce((s, k) => s + k.book_value_cents, 0)
    expect(summe).toBe(u.summary.book_value_cents)
  })

  it('filtert nach Mandant', async () => {
    const at = await ruf('netops.api.inventar.asset_list', { tenant: 'TEN-0001' })
    const de = await ruf('netops.api.inventar.asset_list', { tenant: 'TEN-0002' })
    expect(at.every((a) => a.tenant === 'TEN-0001')).toBe(true)
    expect(de.every((a) => a.tenant === 'TEN-0002')).toBe(true)
    expect(de.length).toBeGreaterThan(0)
  })

  it('findet ein Gerät über die Seriennummer', async () => {
    const treffer = await ruf('netops.api.inventar.asset_list', { search: 'PF3X9K21' })
    expect(treffer).toHaveLength(1)
    expect(treffer[0].name).toBe('INV-000101')
  })
})

