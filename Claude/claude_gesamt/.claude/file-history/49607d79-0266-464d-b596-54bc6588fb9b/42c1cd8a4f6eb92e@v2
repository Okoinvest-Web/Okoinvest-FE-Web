describe('Trennung zu Frappe HR', () => {
  it('gibt zu Beschäftigten nur die Felder aus, die das Inventar braucht', async () => {
    // Keine Personalakte über die API: Datenminimierung ist hier eine
    // Zusicherung, kein Zufall.
    const p = await ruf('netops.api.personal.employee_equipment', { employee: 'HR-EMP-00001' })
    const erlaubt = new Set([
      'name',
      'employee_name',
      'status',
      'department',
      'designation',
      'company_email',
      'user_id',
      'date_of_joining',
      'relieving_date',
      'company',
    ])
    for (const feld of Object.keys(p.employee)) {
      expect(erlaubt.has(feld)).toBe(true)
    }
  })

  it('nennt niemals ein Geheimnis zu einem Zugangsverweis', async () => {
