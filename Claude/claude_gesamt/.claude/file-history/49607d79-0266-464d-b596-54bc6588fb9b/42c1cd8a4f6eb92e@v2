/**
 * Tests für Inventar, Ausgabe, Inventur, Abschreibung und Austritt.
 *
 * Die Regeln, die hier geprüft werden, sind der eigentliche Wert der
 * Methoden. Eine Inventarsoftware, die alles erlaubt, ist eine Tabelle mit
 * mehr Klicks.
 */
import { beforeEach, describe, expect, it } from 'vitest'
import { mockRequest, resetMockData } from '@/api/mock/server.js'

const ruf = (url, params) => mockRequest({ url, params })

beforeEach(() => {
  resetMockData()
})

describe('Abschreibung', () => {
  it('rechnet linear über die Nutzungsdauer der Kategorie', async () => {
    // Notebook: 36 Monate laut Kategorie, 1.899,00 € Anschaffung.
    const plan = await ruf('netops.api.inventar.depreciation_schedule', { asset: 'INV-000101' })
    expect(plan.method).toBe('linear')
    expect(plan.months).toBe(36)
    expect(plan.rows).toHaveLength(3)
    // Jede Jahreszeile ein Drittel, Rundung auf ganze Cent.
    expect(plan.rows[0].amount_cents).toBe(63300)
    // Am Ende ist der Buchwert der Restwert, hier null.
    expect(plan.rows.at(-1).book_value_cents).toBe(0)
    expect(plan.rows.at(-1).accumulated_cents).toBe(plan.purchase_price_cents)
  })

  it('schreibt nie unter den Restbuchwert null', async () => {
    const liste = await ruf('netops.api.inventar.asset_list', {})
    for (const a of liste) {
      if (a.book_value_cents === null) continue
      expect(a.book_value_cents).toBeGreaterThanOrEqual(0)
      expect(a.book_value_cents).toBeLessThanOrEqual(a.purchase_price_cents)
    }
  })

  it('meldet ein altes Gerät als vollständig abgeschrieben', async () => {
    // Hypervisor: vor vier Jahren gekauft, 60 Monate Nutzungsdauer.
    const plan = await ruf('netops.api.inventar.depreciation_schedule', { asset: 'INV-000203' })
    expect(plan.months_elapsed).toBeGreaterThan(40)
    expect(plan.book_value_cents).toBeLessThan(plan.purchase_price_cents)
  })

  it('sagt beim fehlenden Anschaffungswert warum, statt null zu rechnen', async () => {
    await ruf('frappe.client.set_value', {
      doctype: 'Asset',
      name: 'INV-000501',
      fieldname: 'purchase_price_cents',
      value: 0,
    })
    const plan = await ruf('netops.api.inventar.depreciation_schedule', { asset: 'INV-000501' })
    expect(plan.rows).toHaveLength(0)
    expect(plan.reason).toMatch(/Anschaffungswert/)
  })
})

describe('Ausgabe', () => {
  it('gibt ein Gerät aus dem Lager aus und setzt den Besitz', async () => {
    const e = await ruf('netops.api.inventar.assign_asset', {
      asset: 'INV-000103',
      employee: 'HR-EMP-00003',
      purpose: 'Test',
    })
    expect(e.ok).toBe(true)
    const detail = await ruf('netops.api.inventar.asset_detail', { name: 'INV-000103' })
    expect(detail.asset_state).toBe('issued')
    expect(detail.holder).toBe('HR-EMP-00003')
  })

  it('verweigert die Ausgabe eines Messgeräts mit überfälliger Prüfung', async () => {
    // Das ist die wichtigste Regel hier: wer mit einem unkalibrierten
    // Gerät eine Anlage abnimmt, unterschreibt eine ungültige Messung.
    await ruf('netops.api.inventar.return_asset', { asset: 'INV-000301' })
    const e = await ruf('netops.api.inventar.assign_asset', {
      asset: 'INV-000301',
      employee: 'HR-EMP-00005',
    })
    expect(e.ok).toBe(false)
    expect(e.blocked.map((b) => b.kind)).toContain('inspection_overdue')
  })

  it('lässt sich bei überfälliger Prüfung auch mit force nicht übergehen', async () => {
    await ruf('netops.api.inventar.return_asset', { asset: 'INV-000301' })
    const e = await ruf('netops.api.inventar.assign_asset', {
      asset: 'INV-000301',
      employee: 'HR-EMP-00005',
      force: true,
    })
    expect(e.ok).toBe(false)
    expect(e.blocked.map((b) => b.kind)).toContain('inspection_overdue')
  })

  it('verweigert die Ausgabe an eine ausgetretene Person', async () => {
    const e = await ruf('netops.api.inventar.assign_asset', {
      asset: 'INV-000103',
      employee: 'HR-EMP-00011',
    })
    expect(e.ok).toBe(false)
    expect(e.blocked.map((b) => b.kind)).toContain('employee_inactive')
  })

  it('verweigert die doppelte Ausgabe desselben Geräts', async () => {
    const e = await ruf('netops.api.inventar.assign_asset', {
      asset: 'INV-000101',
      employee: 'HR-EMP-00003',
    })
    expect(e.ok).toBe(false)
    expect(e.blocked.map((b) => b.kind)).toContain('already_issued')
  })

  it('nennt bei der doppelten Ausgabe, wer es hat', async () => {
    const e = await ruf('netops.api.inventar.assign_asset', {
      asset: 'INV-000101',
      employee: 'HR-EMP-00003',
    })
    expect(e.blocked.find((b) => b.kind === 'already_issued').text).toContain('Benny Höfler')
  })

  it('hält eine bestätigte Reservierung anderer Leute frei', async () => {
    // INV-000103 ist ab in vier Tagen für HR-EMP-00009 bestätigt.
    const e = await ruf('netops.api.inventar.assign_asset', {
      asset: 'INV-000103',
      employee: 'HR-EMP-00003',
      due_on: new Date(Date.now() + 8 * 86400000).toISOString().slice(0, 10),
    })
    expect(e.ok).toBe(false)
    expect(e.blocked.map((b) => b.kind)).toContain('reserved')
  })
})

describe('Rücknahme', () => {
  it('stellt ein Gerät ohne Schaden zurück ins Lager', async () => {
    const e = await ruf('netops.api.inventar.return_asset', {
      asset: 'INV-000101',
      condition_in: 'ohne Beanstandung',
    })
    expect(e.asset_state).toBe('in_stock')
  })

  it('schickt ein beschädigtes Gerät in Reparatur, nicht ins Lager', async () => {
    // Sonst gibt es beim nächsten Griff jemand anderes weiter aus.
    const e = await ruf('netops.api.inventar.return_asset', {
      asset: 'INV-000101',
      damaged: true,
      damage_summary: 'Scharnier gebrochen',
      damage_severity: 'high',
    })
    expect(e.asset_state).toBe('repair')
    expect(e.damage).toBeTruthy()
  })

  it('verlangt zu einem Schaden eine Beschreibung', async () => {
    await expect(
      ruf('netops.api.inventar.return_asset', { asset: 'INV-000101', damaged: true }),
    ).rejects.toThrow(/Beschreibung/)
  })

  it('weist die Rücknahme ohne offene Ausgabe ab', async () => {
    await expect(ruf('netops.api.inventar.return_asset', { asset: 'INV-000103' })).rejects.toThrow(
      /keine offene Ausgabe/,
    )
  })

  it('setzt ein repariertes Gerät zurück in den Bestand', async () => {
    const schaeden = await ruf('netops.api.inventar.damage_list', { damage_state: 'in_repair' })
    const e = await ruf('netops.api.inventar.set_damage_state', {
      name: schaeden[0].name,
      state: 'repaired',
    })
    expect(e.asset_state).toBe('in_stock')
  })

  it('mustert ein abgeschriebenes Gerät aus statt es freizugeben', async () => {
    const schaeden = await ruf('netops.api.inventar.damage_list', { damage_state: 'in_repair' })
    const e = await ruf('netops.api.inventar.set_damage_state', {
      name: schaeden[0].name,
      state: 'written_off',
    })
    expect(e.asset_state).toBe('retired')
  })
})

