<template>
  <div>
    <PageHeader title="Lage" :subtitle="untertitel">
      <template #actions>
        <FormControl v-model="fenster" type="select" :options="fensterOptionen" />
      </template>
    </PageHeader>

    <ErrorState
      v-if="lage.error"
      class="m-6"
      :error="lage.error"
      titel="Lagebild nicht abrufbar"
      :on-retry="() => lage.fetch()"
    />

    <p v-else-if="lage.loading && !lage.data" class="p-6 text-sm text-ink-gray-5">Wird geladen …</p>

    <div v-else-if="lage.data" class="p-6">
      <!-- ============ Gesamtlage ============ -->
      <section
        class="mb-6 rounded-lg border p-4"
        :class="
          lage.data.overall.level === 'critical'
            ? 'border-outline-red-2 bg-surface-red-1'
            : 'border-outline-gray-2 bg-surface-white'
        "
        :aria-live="'polite'"
      >
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div class="min-w-0">
            <StatusDot :level="lage.data.overall.level" :text="lage.data.overall.text" />
            <p v-if="lage.data.overall.critical_areas.length" class="mt-1 text-sm text-ink-gray-7">
              Kritisch in: {{ lage.data.overall.critical_areas.join(', ') }}
            </p>
            <p v-else class="mt-1 text-sm text-ink-gray-6">Alle Bereiche ohne kritischen Befund.</p>
          </div>
          <dl class="flex flex-wrap gap-x-8 gap-y-2">
            <div v-for="z in kopfzahlen" :key="z.label">
              <dt class="text-sm text-ink-gray-6">{{ z.label }}</dt>
              <dd class="text-2xl font-semibold tabular-nums text-ink-gray-9">{{ z.wert }}</dd>
            </div>
          </dl>
        </div>
      </section>

      <!-- ============ Was zuerst ============ -->
      <section v-if="lage.data.hotspots.length" class="mb-8">
        <h2 class="mb-1 text-base font-semibold text-ink-gray-8">Was zuerst</h2>
        <p class="mb-3 text-sm text-ink-gray-6">
          Die dringendsten Befunde quer über alle Bereiche, in der Reihenfolge, in der sie zu
          bearbeiten sind.
        </p>
        <ol class="space-y-2">
          <li v-for="(p, i) in lage.data.hotspots" :key="i">
            <RouterLink
              :to="p.to"
              class="flex flex-wrap items-baseline gap-x-3 gap-y-1 rounded-lg border border-outline-gray-2 bg-surface-white p-3 hover:bg-surface-gray-1"
            >
              <span class="w-6 shrink-0 text-right text-sm tabular-nums text-ink-gray-4">
                {{ i + 1 }}
              </span>
              <Badge theme="gray">{{ p.bereich }}</Badge>
              <span class="min-w-0 flex-1 font-medium text-ink-gray-9">{{ p.title }}</span>
              <span class="text-sm text-ink-gray-6">{{ p.detail }}</span>
            </RouterLink>
          </li>
        </ol>
      </section>

      <!-- ============ Bereiche ============ -->
      <section class="mb-8">
        <h2 class="mb-3 text-base font-semibold text-ink-gray-8">Bereiche</h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
          <RouterLink
            v-for="bereich in lage.data.areas"
            :key="bereich.key"
            :to="bereich.to"
            class="rounded-lg border bg-surface-white p-4 hover:bg-surface-gray-1"
            :class="bereich.level === 'critical' ? 'border-outline-red-2' : 'border-outline-gray-2'"
          >
            <div class="flex items-center gap-2">
              <AppIcon :name="bereich.icon" :size="16" class="shrink-0 text-ink-gray-6" />
              <p class="text-sm font-medium text-ink-gray-7">{{ bereich.label }}</p>
            </div>
            <p class="mt-1 text-2xl font-semibold tabular-nums text-ink-gray-9">
              {{ bereich.zahl }}
            </p>
            <p class="text-sm text-ink-gray-5">{{ bereich.einheit }}</p>
            <StatusDot
              class="mt-2"
              :level="bereich.level"
              :text="bereich.reasons[0] || 'ohne Befund'"
              klein
            />
            <p v-if="bereich.reasons.length > 1" class="mt-0.5 pl-4 text-sm text-ink-gray-6">
              {{ bereich.reasons.slice(1).join(' · ') }}
            </p>
          </RouterLink>
        </div>
      </section>

      <div class="grid grid-cols-1 gap-8 xl:grid-cols-2">
        <!-- ============ Verlauf ============ -->
        <section>
          <h2 class="mb-1 text-base font-semibold text-ink-gray-8">
            Verlauf über {{ fenster }} Tage
          </h2>
          <p class="mb-3 text-sm text-ink-gray-6">
            Eine Zahl sagt, wie viel offen ist. Eine Reihe sagt, ob es schlimmer wird.
          </p>

          <div class="rounded-lg border border-outline-gray-2 bg-surface-white p-4">
            <div class="mb-3 flex flex-wrap items-center gap-x-4 gap-y-1">
              <span
                v-for="reihe in reihen"
                :key="reihe.label"
                class="flex items-center gap-1.5 text-sm text-ink-gray-7"
              >
                <span
                  class="inline-block h-0.5 w-4 rounded"
                  :style="{ background: reihe.farbe }"
                  aria-hidden="true"
                />
                {{ reihe.label }} ({{ reihe.summe }})
              </span>
            </div>

            <svg
              :viewBox="`0 0 ${BREITE} ${HOEHE}`"
              class="w-full"
              :style="{ height: HOEHE + 'px' }"
              role="img"
              :aria-label="verlaufText"
              preserveAspectRatio="none"
            >
              <!-- Waagrechte Hilfslinien, zurückhaltend -->
              <line
                v-for="n in 3"
                :key="n"
                x1="0"
                :y1="(HOEHE / 3) * (n - 1)"
                :x2="BREITE"
                :y2="(HOEHE / 3) * (n - 1)"
                stroke="var(--viz-grid)"
                stroke-width="1"
              />
              <path
                v-for="reihe in reihen"
                :key="reihe.label"
                :d="reihe.pfad"
                fill="none"
                :stroke="reihe.farbe"
                stroke-width="2"
                stroke-linejoin="round"
                stroke-linecap="round"
              />
            </svg>

            <div class="mt-1 flex justify-between text-xs tabular-nums text-ink-gray-5">
              <span>{{ ersterTag }}</span>
              <span>heute</span>
            </div>

            <p v-if="!hatAusschlag" class="mt-2 text-sm text-ink-gray-5">
              In diesem Zeitraum wurde nichts Neues gemeldet.
            </p>
          </div>
        </section>

        <!-- ============ Kapazität ============ -->
        <section>
          <h2 class="mb-1 text-base font-semibold text-ink-gray-8">Kapazität</h2>
          <p class="mb-3 text-sm text-ink-gray-6">
            {{ lage.data.capacity.checked }} Ressourcen geprüft:
            <span v-if="!lage.data.capacity.rows.length">nichts wird eng.</span>
            <span v-else>
              {{ lage.data.capacity.critical }} kritisch, {{ lage.data.capacity.warning }} knapp.
            </span>
          </p>

          <div class="rounded-lg border border-outline-gray-2 bg-surface-white p-4">
            <p
              v-if="lage.data.capacity.rows.length"
              class="mb-2 text-sm font-medium text-ink-gray-7"
            >
              Auffällig
            </p>
            <div v-for="z in lage.data.capacity.rows" :key="z.art + z.name" class="mb-3">
              <AuslastungsBalken :zeile="z" />
            </div>

            <p class="mb-2 text-sm font-medium text-ink-gray-7">Höchste Auslastung je Art</p>
            <div v-for="z in lage.data.capacity.peaks" :key="'s' + z.art + z.name" class="mb-3">
              <AuslastungsBalken :zeile="z" />
            </div>
          </div>
        </section>
      </div>

      <!-- ============ Abdeckung ============ -->
      <section class="mt-8">
        <h2 class="mb-1 text-base font-semibold text-ink-gray-8">Abdeckung</h2>
        <p class="mb-3 text-sm text-ink-gray-6">
          Der blinde Fleck jeder Dokumentation: ein Gerät, das niemand überwacht, meldet auch
          nichts. Eine Ampel bleibt dafür grün – deshalb steht das hier.
        </p>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">
          <RouterLink
            v-for="a in lage.data.coverage"
            :key="a.key"
            :to="a.to"
            class="rounded-lg border border-outline-gray-2 bg-surface-white p-4 hover:bg-surface-gray-1"
          >
            <div class="flex items-baseline justify-between gap-2">
              <p class="text-sm text-ink-gray-6">{{ a.label }}</p>
              <p class="text-xl font-semibold tabular-nums text-ink-gray-9">
                {{ a.fehlend
                }}<span class="text-sm font-normal text-ink-gray-5">/{{ a.gesamt }}</span>
              </p>
            </div>
            <!--
              Der Balken zeigt die FEHLMENGE, nicht die Abdeckung. Vorher
              zeigten Zahl (6 von 9 fehlen) und Balken (33 % abgedeckt) in
              entgegengesetzte Richtungen - ein kurzer roter Balken sah nach
              kleinem Problem aus und war das groesste.
            -->
            <div class="mt-2 h-2 w-full rounded" style="background: var(--viz-neutral-soft)">
              <div
                class="h-full rounded"
                :style="{ width: 100 - a.prozent + '%', background: balkenFarbe(a.level) }"
              />
            </div>
            <StatusDot
              class="mt-2"
              :level="a.level"
              :text="
                a.fehlend
                  ? a.fehlend + ' fehlen · ' + a.prozent + ' % abgedeckt'
                  : 'vollständig abgedeckt'
              "
              klein
            />
            <p v-if="a.beispiele.length" class="mt-1 text-sm text-ink-gray-5">
              {{ a.beispiele.join(', ') }}<span v-if="a.fehlend > a.beispiele.length"> …</span>
            </p>
          </RouterLink>
        </div>
      </section>

      <!-- ============ Bestand ============ -->
      <section class="mt-8">
        <h2 class="mb-3 text-base font-semibold text-ink-gray-8">Bestand</h2>
        <div class="grid grid-cols-2 gap-4 lg:grid-cols-4 xl:grid-cols-6">
          <StatCard
            v-for="kachel in bestandskacheln"
            :key="kachel.label"
            :label="kachel.label"
            :wert="kachel.wert"
            :hinweis="kachel.hinweis"
            :level="kachel.level"
            :to="kachel.to"
          />
        </div>
      </section>

      <p class="mt-8 text-xs text-ink-gray-4">
        Das Lagebild kommt aus einem einzigen Aufruf
        (<code>netops.api.ops.situation_overview</code>), nicht aus zwölf parallelen. Die Kette des
        Protokolls zählt {{ lage.data.overall.audit_entries }} Einträge – sie ist die
        Vertrauensgrundlage für jede Zahl auf dieser Seite.
      </p>
    </div>
  </div>
</template>

<script setup>
import { computed, h, ref, watch } from 'vue'
import { Badge, FormControl, createResource } from 'frappe-ui'
import PageHeader from '@/components/PageHeader.vue'
import StatCard from '@/components/StatCard.vue'
import StatusDot from '@/components/StatusDot.vue'
import ErrorState from '@/components/ErrorState.vue'
import AppIcon from '@/components/AppIcon.vue'
import { useUiStore } from '@/stores/ui'
import { balkenFarbe } from '@/viz'

const BREITE = 600
const HOEHE = 120

const ui = useUiStore()
const fenster = ref('30')

const lage = createResource({
  url: 'netops.api.ops.situation_overview',
  makeParams: () => ({ tenant: ui.mandant || null, days: Number(fenster.value) }),
  auto: true,
})

const bestand = createResource({
  url: 'netops.api.dcim.dashboard_counters',
  makeParams: () => ({ tenant: ui.mandant || null }),
  auto: true,
})

watch([fenster, () => ui.mandant], () => {
  lage.fetch()
  bestand.fetch()
})

const fensterOptionen = [
  { label: '14 Tage', value: '14' },
  { label: '30 Tage', value: '30' },
  { label: '90 Tage', value: '90' },
]

/**
 * Kleine Anzeigekomponente für einen Auslastungsbalken. Lokal definiert,
 * weil sie nur hier vorkommt - eine eigene Datei für sechs Zeilen wäre
 * mehr Weg als Nutzen.
 */
const AuslastungsBalken = (props) => {
  const z = props.zeile
  const prozent = Math.round(z.prozent)
  return h('div', {}, [
    h('div', { class: 'flex items-baseline justify-between gap-2' }, [
      h('span', { class: 'min-w-0 truncate text-sm text-ink-gray-8' }, [
        h('span', { class: 'text-ink-gray-5' }, z.art + ' · '),
        z.name,
      ]),
      h(
        'span',
        { class: 'shrink-0 text-sm tabular-nums text-ink-gray-7' },
        `${prozent} % · ${z.genutzt} / ${z.gesamt}${z.einheit ? ' ' + z.einheit : ''}`,
      ),
    ]),
    h('div', { class: 'mt-1 h-2 w-full rounded', style: 'background: var(--viz-neutral-soft)' }, [
      h('div', {
        class: 'h-full rounded',
        style: {
          width: Math.min(100, prozent) + '%',
          // Auslastung ist eine Größenordnung, kein Zustand - deshalb eine
          // Hue, solange nichts eng ist, und erst über der Schwelle eine
          // Statusfarbe.
          background: z.level === 'ok' ? 'var(--viz-seq-400)' : balkenFarbe(z.level),
        },
      }),
    ]),
  ])
}
AuslastungsBalken.props = ['zeile']

// --- Kopf ------------------------------------------------------------------

const untertitel = computed(() => {
  const d = lage.data
  if (!d) return ''
  const kritisch = d.areas.filter((a) => a.level === 'critical').length
  return kritisch
    ? `${kritisch} von ${d.areas.length} Bereichen kritisch`
    : `${d.areas.length} Bereiche, keiner kritisch`
})

const kopfzahlen = computed(() => {
  const d = lage.data
  if (!d) return []
  return [
    { label: 'Dringend', wert: d.hotspots.length },
    { label: 'Bereiche kritisch', wert: d.areas.filter((a) => a.level === 'critical').length },
    { label: 'Kapazität knapp', wert: d.capacity.rows.length },
  ]
})

// --- Verlauf ---------------------------------------------------------------

const reihen = computed(() => {
  const punkte = lage.data?.timeline || []
  if (!punkte.length) return []

  const hoechst = Math.max(1, ...punkte.flatMap((p) => [p.alarme, p.vorfaelle]))

  const pfad = (feld) =>
    punkte
      .map((p, i) => {
        const x = (i / Math.max(1, punkte.length - 1)) * BREITE
        const y = HOEHE - (p[feld] / hoechst) * (HOEHE - 6) - 3
        return `${i === 0 ? 'M' : 'L'}${x.toFixed(1)} ${y.toFixed(1)}`
      })
      .join(' ')

  return [
    {
      label: 'Alarme',
      farbe: 'var(--viz-series-1)',
      pfad: pfad('alarme'),
      summe: punkte.reduce((s, p) => s + p.alarme, 0),
    },
    {
      label: 'Vorfälle',
      farbe: 'var(--viz-series-2)',
      pfad: pfad('vorfaelle'),
      summe: punkte.reduce((s, p) => s + p.vorfaelle, 0),
    },
  ]
})

const hatAusschlag = computed(() => reihen.value.some((r) => r.summe > 0))

const ersterTag = computed(() => lage.data?.timeline?.[0]?.tag || '')

const verlaufText = computed(() =>
  reihen.value.map((r) => `${r.label}: ${r.summe} im Zeitraum`).join(', '),
)

// --- Bestand ---------------------------------------------------------------

const bestandskacheln = computed(() => {
  const k = bestand.data
  return [
    { label: 'Geräte', wert: k?.devices ?? null, to: '/devices' },
    { label: 'Standorte', wert: k?.sites ?? null },
    { label: 'VLANs', wert: k?.vlans ?? null, to: '/vlans' },
    { label: 'Präfixe', wert: k?.prefixes ?? null, to: '/ipam' },
    { label: 'IP-Adressen', wert: k?.ip_addresses ?? null, to: '/ipam' },
    { label: 'Schnittstellen', wert: k?.interfaces ?? null },
    {
      label: 'Support < 6 Monate',
      wert: k?.support_expiring ?? null,
      hinweis: (k?.support_expiring ?? 0) > 0 ? 'Beschaffung prüfen' : null,
      level: 'warning',
      to: '/devices',
    },
    {
      label: 'Support abgelaufen',
      wert: k?.support_expired ?? null,
      hinweis: (k?.support_expired ?? 0) > 0 ? 'ohne Herstellersupport' : null,
      level: 'critical',
      to: '/devices',
    },
  ]
})
</script>
