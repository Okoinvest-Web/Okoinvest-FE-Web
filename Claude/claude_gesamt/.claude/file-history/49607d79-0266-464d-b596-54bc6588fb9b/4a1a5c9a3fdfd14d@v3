  { path: '/audit', name: 'Audit', component: () => import('@/pages/AuditView.vue'), meta: { title: 'Audit' } },

  { path: '/services', name: 'Services', component: () => import('@/pages/ServiceView.vue'), meta: { title: 'Dienste' } },
  { path: '/virtualization', name: 'Virtualization', component: () => import('@/pages/VirtualizationView.vue'), meta: { title: 'Virtualisierung' } },
