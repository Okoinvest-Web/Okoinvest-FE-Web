  {
    path: '/:pathMatch(.*)*',
    name: 'NotFound',
    component: () => import('@/pages/NotFound.vue'),
    meta: { title: 'Nicht gefunden' },
  },
]

const router = createRouter({
  // Wird in vite.config.js gesetzt: '/' im Dev-Server, '/netops' in Frappe.
  history: createWebHistory(__FRONTEND_ROUTE__),
  routes,
})

router.afterEach((to) => {
  document.title = to.meta.title ? to.meta.title + ' · NetOps' : 'NetOps'
})

export default router
