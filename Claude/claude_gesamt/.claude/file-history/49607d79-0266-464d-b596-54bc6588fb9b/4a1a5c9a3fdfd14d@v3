  { path: '/cloud', name: 'Cloud', component: () => import('@/pages/CloudView.vue'), meta: { title: 'Cloud' } },
  { path: '/changes', name: 'Changes', component: () => import('@/pages/ChangeView.vue'), meta: { title: 'Changes' } },
