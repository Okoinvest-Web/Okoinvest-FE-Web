  /* Etiketten sind physisch weiß bedruckt - dunkler Grund wäre hier
     falsch, auch im Dunkelmodus. */
  color: #000000;
  break-inside: avoid;
}

.groesse-klein .etikett {
  width: 38mm;
  height: 20mm;
}
.groesse-mittel .etikett {
  width: 50mm;
  height: 25mm;
}
.groesse-gross .etikett {
  width: 70mm;
  height: 35mm;
}

.etikett-text {
  min-width: 0;
  flex: 1;
}

.etikett-nummer {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 2.6mm;
  font-weight: 600;
  line-height: 1.2;
}

.etikett-zeile {
  overflow: hidden;
  font-size: 2.2mm;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.etikett-schwach {
  color: #555555;
}

/* Im Druck bleibt nur der Bogen übrig. Ohne das kämen Navigation,
   Filter und Tabelle mit aufs Papier. */
@media print {
  :global(aside),
  :global(header),
