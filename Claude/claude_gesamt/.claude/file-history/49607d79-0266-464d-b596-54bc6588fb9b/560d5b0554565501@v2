<template>
  <div>
    <PageHeader title="Geräte" :subtitle="anzahlText" />

    <div class="p-6">
      <div class="mb-4 flex flex-wrap gap-2">
        <FormControl
          v-model="suchtext"
          type="text"
          placeholder="Hostname, Seriennummer, IP …"
          class="w-72"
        />
        <FormControl
          v-model="rolle"
          type="select"
          :options="rollenOptionen"
        />
        <FormControl
          v-model="mandant"
          type="select"
          :options="mandantenOptionen"
        />
      </div>

      <div class="overflow-hidden rounded-lg border border-outline-gray-2 bg-surface-white">
        <table class="w-full text-left">
          <thead class="border-b border-outline-gray-2 bg-surface-gray-1">
            <tr class="text-sm text-ink-gray-6">
              <th class="px-4 py-2 font-medium">{{ fieldLabel('hostname') }}</th>
              <th class="px-4 py-2 font-medium">{{ fieldLabel('device_role') }}</th>
              <th class="px-4 py-2 font-medium">{{ fieldLabel('model') }}</th>
              <th class="px-4 py-2 font-medium">{{ fieldLabel('site') }}</th>
              <th class="px-4 py-2 font-medium">{{ fieldLabel('management_ip') }}</th>
              <th class="px-4 py-2 font-medium">{{ fieldLabel('lifecycle_status') }}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-outline-gray-2">
            <tr
              v-for="geraet in gefiltert"
              :key="geraet.name"
              class="cursor-pointer hover:bg-surface-gray-1"
              @click="$router.push('/devices/' + geraet.name)"
            >
              <td class="px-4 py-2.5 text-base font-medium text-ink-gray-8">
                {{ geraet.hostname }}
              </td>
              <td class="px-4 py-2.5 text-base text-ink-gray-7">{{ geraet.device_role }}</td>
              <td class="px-4 py-2.5 text-base text-ink-gray-7">{{ geraet.model }}</td>
              <td class="px-4 py-2.5 text-base text-ink-gray-7">{{ geraet.site_name }}</td>
              <td class="px-4 py-2.5 text-base tabular-nums text-ink-gray-7">
                {{ geraet.management_ip || '–' }}
              </td>
              <td class="px-4 py-2.5">
                <Badge :theme="statusTheme(geraet.lifecycle_status)">
                  {{ valueLabel('lifecycle_status', geraet.lifecycle_status) }}
                </Badge>
              </td>
            </tr>
          </tbody>
        </table>

        <p v-if="geraete.loading" class="px-4 py-8 text-center text-sm text-ink-gray-5">
          Wird geladen …
        </p>
        <p
          v-else-if="!gefiltert.length"
          class="px-4 py-8 text-center text-sm text-ink-gray-5"
        >
          Kein Gerät gefunden.
        </p>
      </div>
    </div>
  </div>
</template>

<script setup>
import { computed, ref } from 'vue'
import { Badge, FormControl, createResource } from 'frappe-ui'
import PageHeader from '@/components/PageHeader.vue'
import { fieldLabel, statusTheme, valueLabel } from '@/labels'

const suchtext = ref('')
const rolle = ref('')
const mandant = ref('')

const geraete = createResource({
  url: 'netops.api.dcim.device_list',
  auto: true,
})

const mandanten = createResource({
  url: 'frappe.client.get_list',
  params: { doctype: 'Tenant', fields: ['name', 'tenant_name'], limit_page_length: 0 },
  auto: true,
})

// Die Liste ist klein genug, um lokal zu filtern. Sobald echte Datenmengen
// dazukommen, wandert das in die Parameter von device_list.
const gefiltert = computed(() => {
  const text = suchtext.value.trim().toLowerCase()
  return (geraete.data || []).filter((g) => {
    if (rolle.value && g.device_role !== rolle.value) return false
    if (mandant.value && g.tenant !== mandant.value) return false
    if (!text) return true
    return ['hostname', 'serial', 'asset_tag', 'management_ip', 'model'].some((f) =>
      String(g[f] || '').toLowerCase().includes(text),
    )
  })
})

const rollenOptionen = computed(() => [
  { label: 'Alle Rollen', value: '' },
  ...[...new Set((geraete.data || []).map((g) => g.device_role))]
    .sort()
    .map((r) => ({ label: r, value: r })),
])

const mandantenOptionen = computed(() => [
  { label: 'Alle Mandanten', value: '' },
  ...(mandanten.data || []).map((m) => ({ label: m.tenant_name, value: m.name })),
])

const anzahlText = computed(() => {
  const anzahl = gefiltert.value.length
  return anzahl === 1 ? '1 Gerät' : anzahl + ' Geräte'
})
</script>
