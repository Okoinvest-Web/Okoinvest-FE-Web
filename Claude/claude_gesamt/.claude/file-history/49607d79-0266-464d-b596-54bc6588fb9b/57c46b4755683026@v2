/**
 * Serverseitige DCIM-Auswertungen: Geraeteliste mit aufgeloesten Bezuegen
 * und das Gerätedetail mit allen Tabs in einem Aufruf.
 *
 * Ein Aufruf statt sechs: das Detail laedt Geraet, Schnittstellen, IPs,
 * VLANs und Verkabelung gebuendelt - so wie es die Python-Methode
 * `netops.api.dcim.device_detail` spaeter auch tun wird.
 */
import { FrappeMockError, table } from '../db.js'
import { ipToInt } from '../ip.js'

export function device_list({ tenant = null, site = null, device_role = null, query = null } = {}) {
  const geraetetypen = new Map(table('Device Type').map((t) => [t.name, t]))
  const standorte = new Map(table('Site').map((s) => [s.name, s]))

  let geraete = table('Network Device')
  if (tenant) geraete = geraete.filter((d) => d.tenant === tenant)
  if (site) geraete = geraete.filter((d) => d.site === site)
  if (device_role) geraete = geraete.filter((d) => d.device_role === device_role)
  if (query) {
    const suchtext = String(query).toLowerCase()
    geraete = geraete.filter((d) =>
      ['hostname', 'serial', 'asset_tag', 'management_ip'].some((f) =>
        String(d[f] || '').toLowerCase().includes(suchtext),
      ),
    )
  }

  return geraete
    .map((d) => ({
      name: d.name,
      hostname: d.hostname,
      device_role: d.device_role,
      device_type: d.device_type,
      model: geraetetypen.get(d.device_type)?.model || d.device_type,
      site: d.site,
      site_name: standorte.get(d.site)?.site_name || d.site,
      rack: d.rack,
      position_u: d.position_u,
      management_ip: d.management_ip,
      serial: d.serial,
      firmware: d.firmware,
      lifecycle_status: d.lifecycle_status,
      status: d.status,
      tenant: d.tenant,
      support_end: d.support_end,
    }))
    .sort((a, b) => a.hostname.localeCompare(b.hostname))
}

export function device_detail({ name } = {}) {
  const geraet = table('Network Device').find((d) => d.name === name)
  if (!geraet) {
    throw new FrappeMockError('DoesNotExistError: Network Device ' + name + ' existiert nicht', 404)
  }

  const geraetetyp = table('Device Type').find((t) => t.name === geraet.device_type) || null
  const standort = table('Site').find((s) => s.name === geraet.site) || null
  const rack = table('Rack').find((r) => r.name === geraet.rack) || null
  const vlans = new Map(table('VLAN').map((v) => [v.name, v]))
  const adressen = table('IP Address')
  const kabel = table('Cable')

  const schnittstellen = table('Device Interface')
    .filter((i) => i.device === name)
    .map((i) => {
      const vlan = i.untagged_vlan ? vlans.get(i.untagged_vlan) : null
      const ip = adressen.filter(
        (a) => a.assigned_object_type === 'Device Interface' && a.assigned_object === i.name,
      )
      const verbindung = kabel.find(
        (c) =>
          (c.a_endpoint_type === 'Device Interface' && c.a_endpoint === i.name) ||
          (c.b_endpoint_type === 'Device Interface' && c.b_endpoint === i.name),
      )

      return {
        ...i,
        vlan_label: vlan ? vlan.vid + ' · ' + vlan.vlan_name : null,
        security_zone: vlan ? vlan.security_zone : null,
        ip_addresses: ip.map((a) => a.address),
        cable: verbindung ? verbindung.label : null,
        cable_peer: verbindung ? gegenstelle(verbindung, i.name) : null,
      }
    })
    .sort((a, b) => a.interface_name.localeCompare(b.interface_name, 'de', { numeric: true }))

  const eigeneSchnittstellen = new Set(schnittstellen.map((i) => i.name))
  const verkabelung = kabel
    .filter(
      (c) =>
        (c.a_endpoint_type === 'Device Interface' && eigeneSchnittstellen.has(c.a_endpoint)) ||
        (c.b_endpoint_type === 'Device Interface' && eigeneSchnittstellen.has(c.b_endpoint)),
    )
    .map((c) => ({ ...c }))

  const ip_addresses = adressen
    .filter(
      (a) =>
        (a.assigned_object_type === 'Device Interface' && eigeneSchnittstellen.has(a.assigned_object)) ||
        a.address.split('/')[0] === geraet.management_ip,
    )
    .sort((a, b) => ipToInt(a.address.split('/')[0]) - ipToInt(b.address.split('/')[0]))

  const genutzteVlans = [...new Set(schnittstellen.map((i) => i.untagged_vlan).filter(Boolean))]
    .map((v) => vlans.get(v))
    .filter(Boolean)

  return {
    device: geraet,
    device_type: geraetetyp,
    site: standort,
    rack,
    interfaces: schnittstellen,
    cables: verkabelung,
    ip_addresses,
    vlans: genutzteVlans,
  }
}

function gegenstelle(verbindung, schnittstelle) {
  return verbindung.a_endpoint === schnittstelle ? verbindung.b_endpoint : verbindung.a_endpoint
}

/** Kennzahlen fuer das Lagebild. */
export function dashboard_counters({ tenant = null } = {}) {
  const filtern = (rows) => (tenant ? rows.filter((r) => r.tenant === tenant) : rows)

  const geraete = filtern(table('Network Device'))
  const heute = new Date().toISOString().slice(0, 10)
  const inSechsMonaten = new Date(Date.now() + 182 * 86400000).toISOString().slice(0, 10)

  return {
    devices: geraete.length,
    devices_production: geraete.filter((d) => d.lifecycle_status === 'production').length,
    sites: filtern(table('Site')).length,
    racks: filtern(table('Rack')).length,
    vlans: filtern(table('VLAN')).length,
    prefixes: filtern(table('IP Prefix')).length,
    ip_addresses: filtern(table('IP Address')).length,
    interfaces: filtern(table('Device Interface')).length,
    support_expiring: geraete.filter(
      (d) => d.support_end && d.support_end >= heute && d.support_end <= inSechsMonaten,
    ).length,
    support_expired: geraete.filter((d) => d.support_end && d.support_end < heute).length,
  }
}
