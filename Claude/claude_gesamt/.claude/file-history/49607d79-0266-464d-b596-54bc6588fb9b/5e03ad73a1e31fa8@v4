<template>
  <div>
    <PageHeader title="Schwachstellen" :subtitle="untertitel">
      <template #actions>
        <FormControl v-model="zustand" type="select" :options="zustandOptionen" />
      </template>
    </PageHeader>

    <div class="p-6">
      <div v-if="uebersicht.data" class="mb-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
        <StatCard
          v-for="kachel in kacheln"
          :key="kachel.label"
          :label="kachel.label"
          :wert="kachel.wert"
          :hinweis="kachel.hinweis"
          :level="kachel.level"
        />
      </div>

      <DataTable
        tabellen-id="VulnerabilityList"
        :columns="spalten"
        :rows="liste.data || []"
        :loading="liste.loading"
        empty-text="Keine Schwachstelle mit diesem Filter."
      >
        <template #zelle-risk_score="{ zeile }">
          <!-- Risiko als Größenordnung: eine Hue, Wert immer daneben -->
          <div class="flex items-center gap-2">
            <div class="h-2.5 w-16 shrink-0" style="background: var(--viz-neutral-soft)">
              <div
                class="h-full"
                :style="{
                  width: zeile.risk_score + '%',
                  background: zeile.risk_score >= 80 ? 'var(--viz-critical)' : 'var(--viz-seq-400)',
                  borderTopRightRadius: '4px',
                  borderBottomRightRadius: '4px',
                }"
              />
            </div>
            <span class="tabular-nums text-ink-gray-8">{{ zeile.risk_score }}</span>
          </div>
        </template>
        <template #zelle-cve="{ zeile }">
          <span class="block font-mono text-sm text-ink-gray-9">{{ zeile.cve }}</span>
          <span class="block text-sm text-ink-gray-5">{{ zeile.title }}</span>
        </template>
        <template #zelle-kev="{ zeile }">
          <StatusDot
            v-if="zeile.kev"
            level="critical"
            text="aktiv ausgenutzt"
            klein
            titel="In der KEV-Liste der CISA – Frist 72 Stunden"
          />
          <span v-else class="text-ink-gray-4">–</span>
        </template>
        <template #zelle-object_name="{ zeile }">
          <RouterLink
            v-if="zeile.object_type === 'Network Device'"
            :to="'/devices/' + zeile.object_name"
            class="text-ink-gray-8 underline decoration-outline-gray-3 underline-offset-2"
          >
            {{ zeile.object_name }}
          </RouterLink>
          <span v-else>{{ zeile.object_name }}</span>
        </template>
        <template #zelle-frist="{ zeile }">
          <StatusDot
            v-if="zeile.overdue"
            level="critical"
            :text="'überfällig seit ' + zeile.due_date"
            klein
          />
          <StatusDot
            v-else-if="
              zeile.vuln_state === 'open' && zeile.days_left !== null && zeile.days_left <= 7
            "
            level="warning"
            :text="'noch ' + zeile.days_left + ' Tage'"
            klein
          />
          <span v-else-if="zeile.due_date" class="tabular-nums text-ink-gray-6">{{
            zeile.due_date
          }}</span>
          <span v-else class="text-ink-gray-4">–</span>
        </template>
        <template #zelle-vuln_state="{ zeile }">
          <Badge :theme="zustandThema(zeile.vuln_state)">
            {{ VULN_ZUSTAND[zeile.vuln_state] || zeile.vuln_state }}
          </Badge>
        </template>
      </DataTable>

      <p class="mt-3 text-xs text-ink-gray-4">
        Behebungsfristen aus Fachkonzept 2.13: aktiv ausgenutzt 72 Stunden, kritisch 7 Tage, hoch 30
        Tage. Der Risikowert kombiniert CVSS, aktive Ausnutzung und EPSS – eine mittelschwere, aber
        ausgenutzte Lücke steht deshalb vor einer schweren ohne bekannte Ausnutzung. Eine Behebung
        gilt erst nach bestätigendem Nachscan als erledigt.
      </p>
    </div>
  </div>
</template>

<script setup>
import { computed, ref, watch } from 'vue'
import { Badge, FormControl, createResource } from 'frappe-ui'
import PageHeader from '@/components/PageHeader.vue'
import DataTable from '@/components/DataTable.vue'
import StatCard from '@/components/StatCard.vue'

const VULN_ZUSTAND = {
  open: 'Offen',
  fixed: 'Behoben',
  accepted_risk: 'Ausnahme',
}

const zustand = ref('open')

const liste = createResource({
  url: 'netops.api.security.vulnerability_list',
  makeParams: () => ({ state: zustand.value || null }),
  auto: true,
})

const uebersicht = createResource({ url: 'netops.api.security.security_overview', auto: true })

watch(zustand, () => liste.fetch())

const zustandOptionen = [
  { label: 'Offen', value: 'open' },
  { label: 'Behoben', value: 'fixed' },
  { label: 'Ausnahme', value: 'accepted_risk' },
  { label: 'Alle', value: '' },
]

const spalten = [
  { key: 'risk_score', label: 'Risiko', width: '140px' },
  { key: 'cve', label: 'Schwachstelle', width: '320px' },
  { key: 'cvss', label: 'CVSS', align: 'right', numeric: true, width: '80px' },
  { key: 'kev', label: 'KEV', width: '160px' },
  { key: 'object_name', label: 'Objekt', width: '160px' },
  { key: 'source', label: 'Quelle', muted: true, width: '120px' },
  { key: 'frist', label: 'Frist', width: '200px' },
  { key: 'vuln_state', label: 'Zustand', width: '120px' },
]

const kacheln = computed(() => {
  const z = uebersicht.data
  if (!z) return []
  return [
    { label: 'Offen', wert: z.vulnerabilities_open },
    {
      label: 'Kritisch',
      wert: z.vulnerabilities_critical,
      level: 'critical',
      hinweis: z.vulnerabilities_critical ? 'sofort' : null,
    },
    {
      label: 'Aktiv ausgenutzt',
      wert: z.vulnerabilities_kev,
      level: 'critical',
      hinweis: z.vulnerabilities_kev ? 'Frist 72 h' : null,
    },
    {
      label: 'Frist überschritten',
      wert: z.vulnerabilities_overdue,
      level: 'critical',
      hinweis: z.vulnerabilities_overdue ? 'eskalieren' : null,
    },
  ]
})

const untertitel = computed(() => (liste.data || []).length + ' Einträge')

function zustandThema(zustandWert) {
  return { open: 'orange', fixed: 'green', accepted_risk: 'gray' }[zustandWert] || 'gray'
}
</script>
