    "import { schweregradStufe } from '@/viz'",
)
ersetze(
    "src/pages/ServiceView.vue",
    [("\n" + KRIT + "\n", "\n")],
    "import { kritikalitaetStufe } from '@/viz'",
)
ersetze(
    "src/pages/ChangeView.vue",
    [("\n" + RISIKO + "\n", "\n")],
    "import { risikoStufe } from '@/viz'",
