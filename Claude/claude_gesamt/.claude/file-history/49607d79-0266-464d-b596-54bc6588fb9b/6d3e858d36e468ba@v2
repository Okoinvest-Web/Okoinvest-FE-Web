/** Deutsche Bezeichnung eines DocType. */
export function doctypeLabel(doctype) {
  return DOCTYPES[doctype] || doctype
}

/** Deutsche Bezeichnung eines Feldes. */
export function fieldLabel(fieldname) {
  return FELDER[fieldname] || fieldname
}

/** Deutsche Bezeichnung eines Feldwertes, z. B. status="active" -> "Aktiv". */
export function valueLabel(fieldname, value) {
  if (value === null || value === undefined || value === '') return '–'
  return WERTE[fieldname]?.[value] ?? String(value)
}

/** Farbthema fuer Badges, abgeleitet vom Wert. */
export function statusTheme(value) {
  switch (value) {
    case 'active':
    case 'production':
      return 'green'
    case 'planned':
    case 'staged':
    case 'testing':
      return 'blue'
    case 'offline':
    case 'deprecated':
    case 'retired':
      return 'red'
    default:
      return 'gray'
  }
}

/** Zonen werden nach Schutzbedarf eingefaerbt. */
export function zoneTheme(zone) {
  switch (zone) {
    case 'ot':
    case 'soc':
      return 'orange'
    case 'management':
      return 'violet'
    case 'dmz':
    case 'guest':
      return 'red'
    default:
      return 'gray'
  }
}
