import { defineConfig, loadEnv } from 'vite'
import vue from '@vitejs/plugin-vue'
import frappeui from 'frappe-ui/vite'
import path from 'node:path'
import { fileURLToPath } from 'node:url'

const root = path.dirname(fileURLToPath(import.meta.url))

// Name der Frappe-App. Bestimmt, unter welchem Pfad Frappe die gebauten
// Assets ausliefert: /assets/<APP_NAME>/frontend/
// Die SPA selbst liegt spaeter unter FRONTEND_ROUTE (www/netops.html).
const APP_NAME = 'netops'
const FRONTEND_ROUTE = '/netops'

export default defineConfig(({ mode }) => {
  const env = loadEnv(mode, root, '')
  const useMock = env.VITE_USE_MOCK !== 'false'

  return {
    base: mode === 'production' ? `/assets/${APP_NAME}/frontend/` : '/',
    plugins: [
      // Vom frappe-ui-Plugin brauchen wir nur die Icon-Aufloesung (~icons/lucide/*).
      // Die uebrigen Teile setzen eine laufende Frappe-Bench voraus und sind
      // deshalb aus - beim Anschluss an ein echtes Frappe wieder einschalten.
      frappeui({
        lucideIcons: true,
        frappeProxy: false,
        jinjaBootData: false,
        buildConfig: false,
      }),
      vue(),
    ],
    resolve: {
      alias: { '@': path.resolve(root, 'src') },
    },
    define: {
      // Basis fuer den vue-router. Im Dev-Server liegt die App auf '/',
      // in Frappe spaeter unter /netops.
      __FRONTEND_ROUTE__: JSON.stringify(mode === 'production' ? FRONTEND_ROUTE : '/'),
    },
    optimizeDeps: {
      // frappe-ui wird als Quellcode ausgeliefert und nutzt virtuelle
      // Icon-Module (~icons/lucide/*). Der esbuild-Optimizer kennt die
      // Vite-Plugins nicht und scheitert daran - also nicht vorbuendeln.
      exclude: ['frappe-ui'],
      include: ['highlight.js/lib/core', 'interactjs'],
    },
    server: {
      port: 8080,
      // Im Mock-Modus gibt es nichts zu proxyen - die App laeuft vollstaendig
      // im Browser. Erst wenn ein echtes Frappe existiert, greift der Proxy.
      proxy: useMock
        ? undefined
        : {
            '^/(api|assets|files|private)': {
              target: env.VITE_FRAPPE_URL || 'http://localhost:8000',
              ws: true,
              changeOrigin: true,
            },
          },
    },
    build: {
      // Sobald die Frappe-App existiert, hier auf
      // `../${APP_NAME}/public/frontend` umstellen.
      outDir: 'dist',
      emptyOutDir: true,
      sourcemap: true,
    },
  }
})
