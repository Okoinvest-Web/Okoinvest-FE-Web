const SCHNITTSTELLEN = GERAETE.flatMap((geraet) =>
  buildInterfaces(geraet, PORT_BELEGUNG[geraet.hostname] || {}),
)

/** Dokumentname einer Schnittstelle über Gerät und Portbezeichnung. */
const IF = (device, port) => {
  const treffer = SCHNITTSTELLEN.find((i) => i.device === device && i.interface_name === port)
  if (!treffer) throw new Error('Unbekannter Port: ' + device + ' / ' + port)
  return treffer.name
}

