<template>
  <div>
    <PageHeader
      title="Pfadanalyse"
      subtitle="Kann A das Ziel B auf Port X erreichen – und über welche Regel?"
    />

    <div class="p-6">
      <form
        class="mb-6 flex flex-wrap items-end gap-3 rounded-lg border border-outline-gray-2 bg-surface-white p-4"
        @submit.prevent="analysiere"
      >
        <FormControl v-model="quelle" label="Quelle" class="w-48" placeholder="10.10.30.50" />
        <FormControl v-model="ziel" label="Ziel" class="w-48" placeholder="10.10.20.10" />
        <FormControl
          v-model="protokoll"
          label="Protokoll"
          type="select"
          :options="protokollOptionen"
        />
        <FormControl v-model="port" label="Port" type="number" class="w-28" />
        <Button variant="solid" :loading="analyse.loading" @click="analysiere">Prüfen</Button>

        <div class="ml-auto flex flex-wrap gap-2">
          <button
            v-for="beispiel in BEISPIELE"
            :key="beispiel.label"
            type="button"
            class="rounded border border-outline-gray-2 px-2 py-1 text-sm text-ink-gray-6 hover:bg-surface-gray-2"
            @click="uebernimm(beispiel)"
          >
            {{ beispiel.label }}
          </button>
        </div>
      </form>

      <ErrorState
        v-if="analyse.error"
        class="mb-4"
        :error="analyse.error"
        titel="Weg nicht berechenbar"
        :on-retry="() => analyse.fetch()"
      />

      <div v-if="analyse.data && !analyse.error">
        <!-- Ergebnis: Text zuerst, Farbe als Verstärkung -->
        <div
          class="mb-6 rounded-lg border p-4"
          :class="
            analyse.data.allowed
              ? 'border-outline-gray-2 bg-surface-white'
              : 'border-outline-red-2 bg-surface-red-1'
          "
        >
          <StatusDot
            :level="analyse.data.allowed ? 'ok' : 'critical'"
            :text="
              analyse.data.undetermined
                ? 'Keine Aussage möglich'
                : analyse.data.allowed
                  ? 'Verbindung ist erlaubt'
                  : 'Verbindung wird blockiert'
            "
          />
          <p class="mt-1 text-sm text-ink-gray-6">
            {{ analyse.data.request.source }} → {{ analyse.data.request.destination }} ·
            {{ analyse.data.request.protocol }}/{{ analyse.data.request.port }}
            <template v-if="analyse.data.blocked_at">
              · blockiert auf {{ analyse.data.blocked_at }}
            </template>
            <template v-else-if="analyse.data.undetermined">
              · keine Firewall-Ebene liegt zwischen Quelle und Ziel
            </template>
          </p>
        </div>

        <!-- Der Weg durch die Ebenen -->
        <ol class="space-y-3">
          <li
            v-for="(hop, i) in analyse.data.hops"
            :key="hop.firewall"
            class="rounded-lg border border-outline-gray-2 bg-surface-white p-4"
          >
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div class="min-w-0">
                <p class="text-base font-medium text-ink-gray-9">
                  <span class="mr-2 text-ink-gray-4">{{ i + 1 }}.</span>
                  {{ hop.firewall }}
                  <span class="ml-2 text-sm font-normal text-ink-gray-5">
                    {{ EBENE[hop.layer] || hop.layer }} · {{ hop.vendor }}
                  </span>
                </p>
                <p v-if="hop.rule" class="mt-1 text-sm text-ink-gray-6">
                  Regel {{ hop.rule.rule_index }} · {{ hop.rule.rule_name }}
                </p>
                <p v-else class="mt-1 text-sm text-ink-gray-6">{{ hop.reason }}</p>
              </div>

              <StatusDot
                :level="ergebnisStufe(hop.result)"
                :text="ERGEBNIS[hop.result] || hop.result"
              />
            </div>

            <div
              v-if="hop.rule"
              class="mt-3 grid grid-cols-1 gap-x-6 gap-y-1 border-t border-outline-gray-2 pt-3 text-sm sm:grid-cols-2 lg:grid-cols-4"
            >
              <p><span class="text-ink-gray-5">Quelle</span> {{ hop.rule.source_prefix }}</p>
              <p><span class="text-ink-gray-5">Ziel</span> {{ hop.rule.destination_prefix }}</p>
              <p>
                <span class="text-ink-gray-5">Dienst</span>
                {{ hop.rule.protocol }}/{{ hop.rule.port_from
                }}<template v-if="hop.rule.port_to !== hop.rule.port_from"
                  >–{{ hop.rule.port_to }}</template
                >
              </p>
              <p><span class="text-ink-gray-5">Ticket</span> {{ hop.rule.ticket || '–' }}</p>
              <p class="sm:col-span-2 lg:col-span-4">
                <span class="text-ink-gray-5">Begründung</span>
                {{ hop.rule.justification || 'fehlt' }}
              </p>
            </div>
          </li>
        </ol>

        <p v-if="analyse.data.not_evaluated.length" class="mt-3 text-sm text-ink-gray-5">
          Nicht mehr geprüft, weil vorher blockiert:
          {{ analyse.data.not_evaluated.join(', ') }}
        </p>
      </div>

      <p class="mt-8 text-xs text-ink-gray-4">
        Ausgewertet wird wie bei paketfilternden Firewalls: die erste passende Regel gewinnt. Eine
        Ebene wird nur bewertet, wenn sie laut ihrem Geltungsbereich zwischen Quelle und Ziel liegt.
        Grundlage sind die normalisierten Regelwerke mit aufgelösten Aliasen – im Betrieb kommen sie
        aus den Konnektoren, hier aus Testdaten.
      </p>
    </div>
  </div>
</template>

<script setup>
import { ref } from 'vue'
import { Button, FormControl, createResource } from 'frappe-ui'
import ErrorState from '@/components/ErrorState.vue'
import PageHeader from '@/components/PageHeader.vue'
import StatusDot from '@/components/StatusDot.vue'

const EBENE = { perimeter: 'Perimeter', internal: 'Intern', host: 'Host' }
const ERGEBNIS = {
  allow: 'Erlaubt',
  deny: 'Verworfen',
  not_in_path: 'Nicht im Pfad',
}

const BEISPIELE = [
  {
    label: 'Client → ERP',
    quelle: '10.10.30.50',
    ziel: '10.10.20.10',
    port: 443,
    protokoll: 'tcp',
  },
  {
    label: 'Client → OT',
    quelle: '10.10.30.50',
    ziel: '10.100.100.5',
    port: 502,
    protokoll: 'tcp',
  },
  {
    label: 'Internet → DMZ',
    quelle: '203.0.113.9',
    ziel: '10.10.70.10',
    port: 443,
    protokoll: 'tcp',
  },
  { label: 'Admin → SSH', quelle: '10.10.10.5', ziel: '10.10.20.10', port: 22, protokoll: 'tcp' },
]

const quelle = ref('10.10.30.50')
const ziel = ref('10.10.20.10')
const port = ref(443)
const protokoll = ref('tcp')

const protokollOptionen = [
  { label: 'TCP', value: 'tcp' },
  { label: 'UDP', value: 'udp' },
  { label: 'ICMP', value: 'icmp' },
  { label: 'beliebig', value: 'any' },
]

const analyse = createResource({
  url: 'netops.api.firewall.path_analysis',
  makeParams: () => ({
    source: quelle.value,
    destination: ziel.value,
    port: Number(port.value),
    protocol: protokoll.value,
  }),
  auto: true,
})

function analysiere() {
  analyse.fetch()
}

function uebernimm(beispiel) {
  quelle.value = beispiel.quelle
  ziel.value = beispiel.ziel
  port.value = beispiel.port
  protokoll.value = beispiel.protokoll
  analyse.fetch()
}

function ergebnisStufe(ergebnis) {
  return { allow: 'ok', deny: 'critical', not_in_path: 'neutral' }[ergebnis] || 'neutral'
}
</script>
