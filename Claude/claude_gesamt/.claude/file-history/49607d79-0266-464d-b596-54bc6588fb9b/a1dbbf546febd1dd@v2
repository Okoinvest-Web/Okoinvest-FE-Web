export function damage_list({ damage_state = null, tenant = null } = {}) {
  const assets = new Map(table('Asset').map((a) => [a.name, a]))
  const mitarbeitende = new Map(table('Employee').map((e) => [e.name, e]))

  let liste = table('Damage Report')
  if (damage_state) liste = liste.filter((s) => s.damage_state === damage_state)
  if (tenant) liste = liste.filter((s) => s.tenant === tenant)

  return liste
    .map((s) => ({
      ...s,
      asset_name: assets.get(s.asset)?.asset_name || s.asset,
      asset_tag: assets.get(s.asset)?.asset_tag || s.asset,
      reported_by_name: mitarbeitende.get(s.reported_by)?.employee_name || s.reported_by,
      open: ['new', 'in_repair'].includes(s.damage_state),
      age_days: Math.abs(tageBis(String(s.reported_on).slice(0, 10))),
    }))
    .sort(
      (a, b) =>
        Number(b.open) - Number(a.open) ||
        String(b.reported_on).localeCompare(String(a.reported_on)),
    )
}

export function set_damage_state({ name = null, state = null, repair_cost_cents = null } = {}) {
  const erlaubt = ['new', 'in_repair', 'repaired', 'accepted', 'written_off']
  if (!erlaubt.includes(state)) {
    throw new FrappeMockError(
      'ValidationError: Zustand muss einer von ' + erlaubt.join(', ') + ' sein',
    )
  }
  const doc = table('Damage Report').find((s) => s.name === name)
  if (!doc) {
    throw new FrappeMockError(`DoesNotExistError: Damage Report ${name} existiert nicht`, 404)
  }

  doc.damage_state = state
  if (repair_cost_cents !== null) doc.repair_cost_cents = repair_cost_cents
  if (['repaired', 'accepted', 'written_off'].includes(state)) doc.resolved_on = jetzt()
  touch(doc)

  // Ein repariertes Gerät gehört zurück in den Bestand, ein abgeschriebenes
  // nicht. Das hier zu vergessen ist der Grund, warum in vielen Systemen
  // Geräte dauerhaft in „Reparatur" hängen.
  const asset = table('Asset').find((a) => a.name === doc.asset)
  if (asset && asset.asset_state === 'repair') {
    if (['repaired', 'accepted'].includes(state)) {
      asset.asset_state = 'in_stock'
      touch(asset)
    } else if (state === 'written_off') {
      asset.asset_state = 'retired'
      touch(asset)
    }
  }

  protokolliere({
    action: 'damage_' + state,
    object_type: 'Damage Report',
    object_name: name,
    payload: { state },
  })

  return { ...doc, asset_state: asset?.asset_state || null }
}

