/**
 * Entsorgung mit Nachweis.
 *
 * Trägt das Gerät einen Datenträger, verlangt die Methode ein
 * Löschverfahren und ein Datum der Bestätigung. Das ist kein Formalismus:
 * Artikel 17 DSGVO verlangt den Nachweis der Löschung, und der Nachweis
 * ist genau dieser Datensatz. Ohne ihn ist ein entsorgtes Notebook ein
 * offener Punkt, kein erledigter.
 */
export function dispose_asset({
  asset = null,
  method = null,
  recipient = null,
  certificate_ref = null,
  data_carrier = false,
  erasure_method = null,
  erasure_verified_on = null,
  verified_by = null,
  proceeds_cents = null,
} = {}) {
  const erlaubt = ['recycled', 'shredded', 'sold', 'returned', 'donated']
  if (!erlaubt.includes(method)) {
    throw new FrappeMockError(
      'ValidationError: Verfahren muss eines von ' + erlaubt.join(', ') + ' sein',
    )
  }

  const doc = holeAsset(asset)

  if (doc.asset_state === 'issued') {
    throw new FrappeMockError(
      'ValidationError: Das Gerät ist noch ausgegeben – zuerst zurücknehmen',
    )
  }
  if (doc.asset_state === 'disposed') {
    throw new FrappeMockError('ValidationError: Das Gerät ist bereits entsorgt')
  }

  if (data_carrier) {
    if (!erasure_method) {
      throw new FrappeMockError(
        'ValidationError: Bei einem Datenträger ist das Löschverfahren nachzuweisen',
      )
    }
    if (!erasure_verified_on) {
      throw new FrappeMockError(
        'ValidationError: Bei einem Datenträger ist das Datum der Löschbestätigung erforderlich',
      )
    }
  }

  const nachweis = {
    doctype: 'Disposal Record',
    name: naechsterName('Disposal Record', 'ENT-'),
    asset: doc.name,
    disposed_on: heute(),
    method,
    recipient: recipient || null,
    certificate_ref: certificate_ref || null,
    data_carrier: data_carrier ? 1 : 0,
    erasure_method: erasure_method || null,
    erasure_verified_on: erasure_verified_on || null,
    verified_by: verified_by || null,
    proceeds_cents: proceeds_cents || null,
    tenant: doc.tenant,
    owner: SESSION_USER,
    creation: jetzt(),
    modified: jetzt(),
    modified_by: SESSION_USER,
  }
  table('Disposal Record').push(nachweis)

  doc.asset_state = 'disposed'
  doc.holder = null
  touch(doc)

  protokolliere({
    action: 'asset_disposed',
    object_type: 'Asset',
    object_name: doc.name,
    payload: { method, data_carrier: !!data_carrier, certificate_ref },
  })

  return { ok: true, record: nachweis.name, asset_state: doc.asset_state }
}

export function disposal_list({ tenant = null } = {}) {
  const assets = new Map(table('Asset').map((a) => [a.name, a]))
  const mitarbeitende = new Map(table('Employee').map((e) => [e.name, e]))

  let liste = table('Disposal Record')
  if (tenant) liste = liste.filter((e) => e.tenant === tenant)

  return liste
    .map((e) => ({
      ...e,
      asset_name: assets.get(e.asset)?.asset_name || e.asset,
      asset_tag: assets.get(e.asset)?.asset_tag || e.asset,
      verified_by_name: mitarbeitende.get(e.verified_by)?.employee_name || e.verified_by,
      // Ein Datenträger ohne dokumentierte Löschung ist ein Befund, kein
      // erledigter Vorgang.
      complete: !e.data_carrier || !!(e.erasure_method && e.erasure_verified_on),
      level: !e.data_carrier || (e.erasure_method && e.erasure_verified_on) ? 'ok' : 'critical',
    }))
    .sort((a, b) => String(b.disposed_on).localeCompare(String(a.disposed_on)))
}
