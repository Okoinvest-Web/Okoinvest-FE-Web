/** Stabiler Dokumentname einer Schnittstelle: IF-<Gerät>-<laufende Nummer>. */
export function interfaceName(device, index) {
  return 'IF-' + device + '-' + String(index).padStart(2, '0')
}

/**
 * Erzeugt die Schnittstellen eines Geräts aus der Vorlage seines Typs.
 *
 * @param {{hostname: string, device_type: string, tenant: string}} device
 * @param {Record<string, object>} overrides - je Schnittstellenname die
 *        abweichenden Felder (VLAN, Modus, abgeschaltet, Beschreibung).
 */
export function buildInterfaces(device, overrides = {}) {
  const layout = PORT_LAYOUTS[device.device_type]
  if (!layout) return []

  const schnittstellen = []
  let laufend = 0

  for (const [reiheIndex, reihe] of layout.rows.entries()) {
    for (let i = 0; i < reihe.count; i++) {
      laufend += 1
      const nummer = reihe.zeroBased ? i : i + 1
      const bezeichnung = reihe.prefix + nummer

      schnittstellen.push({
        name: interfaceName(device.hostname, laufend),
        device: device.hostname,
        interface_name: bezeichnung,
        interface_type: reihe.type,
        speed_mbps: reihe.speed,
        poe_enabled: reihe.poe,
        enabled: 1,
        mode: 'access',
        untagged_vlan: null,
        mac_address: macAdresse(device.hostname, laufend),
        // Nur fuer die Frontplatte: wo der Port physisch sitzt.
        panel_block: reihe.block,
        panel_row: reiheIndex,
        panel_position: i,
        panel_staggered: reihe.staggered ? 1 : 0,
        tenant: device.tenant,
        ...(overrides[bezeichnung] || {}),
      })
    }
  }

  return schnittstellen
}

/**
 * Erzeugt eine stabile, offensichtlich erfundene Testadresse aus dem
 * Hostnamen. 02:... ist lokal verwaltet und kollidiert mit keinem Hersteller.
 */
function macAdresse(hostname, index) {
  let hash = 0
  for (const zeichen of hostname) {
    hash = (hash * 31 + zeichen.charCodeAt(0)) % 0xffffff
  }
  const teile = [
    '02',
    hex((hash >> 16) & 0xff),
    hex((hash >> 8) & 0xff),
    hex(hash & 0xff),
    hex((index >> 8) & 0xff),
    hex(index & 0xff),
  ]
  return teile.join(':')
}

function hex(wert) {
  return wert.toString(16).toUpperCase().padStart(2, '0')
}
