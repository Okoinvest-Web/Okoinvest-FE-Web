console.log('  OEK040L9:', await js(`(() => { const r=[...document.querySelectorAll('tbody tr')].find(x=>x.innerText.includes('OEK040L9')); return r ? r.innerText.split(String.fromCharCode(10)).filter(Boolean).slice(0,5).join(' / ') : '?' })()`))
