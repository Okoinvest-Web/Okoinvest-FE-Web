await schlafe(2200)
console.log('  Zustand:', await js(`document.body.innerText.includes('Ausgeworfen') ? 'ausgeworfen' : 'noch bereit'`))
if (fehler.length) { console.log('  FEHLER:', fehler.join(' ; ')); fehler = [] }

