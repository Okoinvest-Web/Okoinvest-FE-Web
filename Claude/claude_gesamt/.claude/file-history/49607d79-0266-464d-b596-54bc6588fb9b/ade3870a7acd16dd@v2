/** Klickt den Bandwechsel durch: auswerfen, falsch quittieren, richtig quittieren. */
import { spawn } from 'node:child_process'
import { mkdtempSync, writeFileSync } from 'node:fs'
import { tmpdir } from 'node:os'
import { join } from 'node:path'

const EDGE = 'C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe'
const port = 9393
const profil = mkdtempSync(join(tmpdir(), 'edge-cdp-'))
const kind = spawn(
  EDGE,
  ['--headless=new','--disable-gpu','--no-first-run','--no-default-browser-check',
   `--remote-debugging-port=${port}`, `--user-data-dir=${profil}`, 'about:blank'],
  { stdio: 'ignore' },
)
const schlafe = (ms) => new Promise((r) => setTimeout(r, ms))
let ziel = null
for (let i = 0; i < 40 && !ziel; i++) {
  await schlafe(250)
  try { ziel = (await (await fetch(`http://127.0.0.1:${port}/json/list`)).json()).find((t) => t.type === 'page') } catch {}
}
const ws = new WebSocket(ziel.webSocketDebuggerUrl)
await new Promise((r) => (ws.onopen = r))
let id = 0
const offen = new Map()
let fehler = []
ws.onmessage = (ev) => {
  const m = JSON.parse(ev.data)
  if (m.id && offen.has(m.id)) { offen.get(m.id)(m.result); offen.delete(m.id) }
  if (m.method === 'Runtime.exceptionThrown') fehler.push(String(m.params.exceptionDetails.text).slice(0, 140))
  if (m.method === 'Runtime.consoleAPICalled' && m.params.type === 'error')
    fehler.push('console: ' + m.params.args.map((a) => a.description || a.value).join(' ').split('\n')[0].slice(0, 140))
}
const sende = (me, p = {}) => new Promise((r) => { const n = ++id; offen.set(n, r); ws.send(JSON.stringify({ id: n, method: me, params: p })) })
const js = async (a) => (await sende('Runtime.evaluate', { returnByValue: true, expression: a, awaitPromise: true })).result.value
await sende('Runtime.enable'); await sende('Page.enable')
await sende('Emulation.setDeviceMetricsOverride', { width: 1500, height: 1200, deviceScaleFactor: 1, mobile: false })
const SCRATCH = process.argv[2] || '.'

async function klick(ausdruck) {
  const r = await js(`(() => { const e = ${ausdruck}; if (!e) return null;
    e.scrollIntoView({ block: 'center' });
    const b = e.getBoundingClientRect();
    return JSON.stringify({ x: b.x + b.width / 2, y: b.y + b.height / 2 }) })()`)
  if (!r) return 'nicht gefunden'
  const { x, y } = JSON.parse(r)
  await sende('Input.dispatchMouseEvent', { type: 'mouseMoved', x, y })
  await sende('Input.dispatchMouseEvent', { type: 'mousePressed', x, y, button: 'left', buttons: 1, clickCount: 1 })
  await sende('Input.dispatchMouseEvent', { type: 'mouseReleased', x, y, button: 'left', buttons: 0, clickCount: 1 })
  return 'geklickt'
}
const LETZTER = (t) => `[...document.querySelectorAll('button')].filter(x => x.innerText.trim() === ${JSON.stringify(t)}).at(-1)`
const FREI = (t) => `[...document.querySelectorAll('button')].find(x => x.innerText.trim() === ${JSON.stringify(t)} && !x.disabled)`

/** Feld über seinen Platzhalter treffen – stabiler als über die Position. */
async function tippeIn(platzhalter, wert) {
  return js(`(() => {
    const i = [...document.querySelectorAll('input, textarea')]
      .find(x => (x.placeholder || '').includes(${JSON.stringify(platzhalter)}))
    if (!i) return 'kein Feld: ' + [...document.querySelectorAll('input')].map(x=>x.placeholder||'(leer)').join(' / ')
    const proto = i.tagName === 'TEXTAREA' ? window.HTMLTextAreaElement : window.HTMLInputElement
    Object.getOwnPropertyDescriptor(proto.prototype, 'value').set.call(i, ${JSON.stringify(wert)})
    i.dispatchEvent(new Event('input', { bubbles: true }))
    return 'ok'
  })()`)
}

await sende('Page.navigate', { url: 'http://localhost:8080/backup/band' })
for (let i = 0; i < 80; i++) { if ((await js('document.body.innerText.trim().length')) > 600) break; await schlafe(250) }
await schlafe(1500)
fehler = []

console.log('=== Auswerfen ===')
