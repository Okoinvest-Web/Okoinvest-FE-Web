console.log('  Dialog offen:', await js(`document.body.innerText.includes('noch im Serverraum')`))
console.log('  ohne Grund gesperrt:', await js(`${LETZTER('Auswerfen')}?.disabled`))
console.log('  Grundfeld:', await tippeIn('Wochenwechsel', 'Wochenwechsel KW 39'))
await schlafe(600)
console.log('  mit Grund frei:', await js(`${LETZTER('Auswerfen')}?.disabled === false`))
