      <nav class="flex-1 overflow-y-auto px-2" aria-label="Hauptnavigation">
        <template v-for="gruppe in navigation" :key="gruppe.titel">
          <p class="px-2 pb-1 pt-3 text-xs font-medium uppercase text-ink-gray-4">
            {{ gruppe.titel }}
          </p>
          <RouterLink
            v-for="eintrag in gruppe.eintraege"
            :key="eintrag.label"
            :to="eintrag.to"
            class="block rounded px-2 py-1.5 text-base text-ink-gray-7 hover:bg-surface-gray-2"
            active-class="bg-surface-gray-3 font-medium text-ink-gray-9"
            @click="navOffen = false"
          >
            {{ eintrag.label }}
          </RouterLink>
        </template>
      </nav>

      <div v-if="USE_MOCK" class="border-t border-outline-gray-2 p-3">
        <p class="mb-2 text-xs leading-4 text-ink-gray-5">
          Testdaten im Browser. Kein Backend verbunden.
        </p>
        <Button size="sm" class="w-full" @click="setzeZurueck">Daten zurücksetzen</Button>
      </div>
    </aside>

    <main class="flex-1 overflow-y-auto pt-14 lg:pt-0">
      <slot />
    </main>

    <GlobalSearch ref="suche" />
  </div>
</template>

<script setup>
import { onBeforeUnmount, onMounted, ref, watch } from 'vue'
import { useRoute } from 'vue-router'
import { Button, createResource, toast } from 'frappe-ui'
import GlobalSearch from '@/components/GlobalSearch.vue'
import { useSessionStore } from '@/stores/session'
import { useUiStore } from '@/stores/ui'
import { USE_MOCK } from '@/api'

const route = useRoute()
const session = useSessionStore()
const ui = useUiStore()
const suche = ref(null)
const navOffen = ref(false)

const mandanten = createResource({
  url: 'frappe.client.get_list',
  params: { doctype: 'Tenant', fields: ['name', 'tenant_name'], limit_page_length: 0 },
  auto: true,
})

// Aufbau nach Fachkonzept Kapitel 6.
const navigation = [
  {
    titel: 'Betrieb',
    eintraege: [
      { label: 'Lage', to: '/' },
      { label: 'Alarme', to: '/alerts' },
      { label: 'Drift', to: '/drift' },
      { label: 'Backup', to: '/backup' },
      { label: 'Dienste', to: '/services' },
      { label: 'Changes', to: '/changes' },
      { label: 'Tickets', to: '/tickets' },
      { label: 'Audit', to: '/audit' },
    ],
  },
  {
    titel: 'DCIM',
    eintraege: [
      { label: 'Geräte', to: '/devices' },
      { label: 'Racks', to: '/racks' },
      { label: 'Verkabelung', to: '/cables' },
      { label: 'Topologie', to: '/topology' },
      { label: 'Virtualisierung', to: '/virtualization' },
      { label: 'Cloud', to: '/cloud' },
      { label: 'Strompfad', to: '/power' },
      { label: 'Grundrisse', to: '/floorplan' },
      { label: 'Fernwartung', to: '/remote' },
    ],
  },
  {
    titel: 'IPAM & Firewall',
    eintraege: [
      { label: 'Präfixe', to: '/ipam' },
      { label: 'VLANs', to: '/vlans' },
      { label: 'Pfadanalyse', to: '/path' },
      { label: 'Regelwerk', to: '/firewall' },
      { label: 'Matrix', to: '/matrix' },
      { label: 'Netzdienste', to: '/netservices' },
    ],
  },
  {
    titel: 'Dokumentation',
    eintraege: [
      { label: 'Dokumente', to: '/documents' },
      { label: 'Checklisten', to: '/checklists' },
      { label: 'Verträge', to: '/contracts' },
      { label: 'Compliance', to: '/compliance' },
    ],
  },
  {
    titel: 'Security',
    eintraege: [
      { label: 'Schwachstellen', to: '/vulnerabilities' },
      { label: 'Angriffsfläche', to: '/exposure' },
      { label: 'Identitäten', to: '/identities' },
      { label: 'Vorfälle', to: '/incidents' },
      { label: 'E-Mail', to: '/mail' },
      { label: 'Leitstand', to: '/control-room' },
    ],
  },
]

// Beim Seitenwechsel schließt sich die Schublade – sonst verdeckt sie genau
// das, wohin man gerade wollte.
watch(
  () => route.fullPath,
  () => {
    navOffen.value = false
  },
)

function tastatur(event) {
  if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
    event.preventDefault()
    suche.value?.open()
  }
  if (event.key === 'Escape') navOffen.value = false
}

onMounted(() => window.addEventListener('keydown', tastatur))
onBeforeUnmount(() => window.removeEventListener('keydown', tastatur))

async function setzeZurueck() {
  const { resetMockData } = await import('@/api/mock/server.js')
  resetMockData()
  toast.create({ message: 'Testdaten zurückgesetzt', type: 'success' })
  // Einfachster Weg, alle gecachten Resourcen zu verwerfen.
  window.location.reload()
}
</script>
