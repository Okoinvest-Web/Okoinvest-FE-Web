# -*- coding: utf-8 -*-
"""Baut die Unterseiten aus den ausgeschnittenen Bloecken.

Die Vorlagenteile stehen als Dateien daneben; hier kommt nur der Rahmen
und das Skript dazu. So bleibt der Text, den die alte Seite schon hatte,
unveraendert - beim Abschreiben geht sonst eine Kleinigkeit verloren.
"""
import io
import os
import re

SP = os.environ['TMP_SP']


def teil(n):
    p = os.path.join(SP, 'teil-%s.html' % n)
    return io.open(p, encoding='utf-8').read().rstrip()


def entferne_vif(t):
    """Die v-if des alten Umschalters fallen weg: jede Seite ist jetzt
    ihre eigene Route."""
    t = re.sub(r'<section v-if="ansicht === \'[a-z]+\'">', '<section>', t)
    t = re.sub(r'<section v-else-if="ansicht === \'[a-z]+\'">', '<section>', t)
    t = re.sub(
        r'<section v-else-if="ansicht === \'[a-z]+\' && pruefung\.data">',
        '<section v-if="pruefung.data">',
        t,
    )
    return t


SCHLUSS = (
    '      <p class="mt-6 max-w-3xl text-xs text-ink-gray-4">\n'
    '        Diese Plattform kann Sicherungen <strong>nicht löschen oder ausdünnen</strong> –\n'
    '        auch nicht mit Nachdruck. Wer die Verwaltung übernimmt, löscht sonst zuerst die\n'
    '        Sicherungen und verschlüsselt dann in Ruhe. Aufbewahrung und Bereinigung bleiben im\n'
    '        jeweiligen Sicherungssystem.\n'
    '      </p>'
)


def schreibe(pfad, vorlage, skript):
    inhalt = '<template>\n  <div class="p-6">\n' + vorlage + '\n' + SCHLUSS + '\n  </div>\n'
    inhalt += skript
    io.open(pfad, 'w', encoding='utf-8').write(inhalt)
    print(os.path.basename(pfad))


