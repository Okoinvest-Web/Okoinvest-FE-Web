// --- Abhängigkeitskette (Fachkonzept 2.9) ----------------------------------

/**
 * Die Kette Geschäftsdienst → Anwendung → VM → Host → Switch → Firewall →
 * Provider als Beziehungen. Sie wird in fixtures-ops.js an den DocType
 * `Object Relation` angehängt und von `impact_analysis` durchlaufen.
 *
 * Leserichtung ist immer gleich: "from hängt ab von to". Nur so lässt sich
 * der Graph in beide Richtungen sinnvoll auswerten.
 */
const kette = (fromType, fromName, toType, toName, relationType, tenant = AT) => ({
  from_type: fromType,
  from_name: fromName,
  to_type: toType,
  to_name: toName,
  relation_type: relationType,
  tenant,
})

