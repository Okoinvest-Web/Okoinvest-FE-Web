defineDoctype('Mail Flow Stat', {
  naming: (doc, i) => 'MFS-' + String(i).padStart(5, '0'),
  titleField: 'day',
  fields: ['day', 'total', 'spam', 'virus', 'bounced', 'rejected', 'delivered'],
  seed: Array.from({ length: 7 }, (_, i) => {
    const tag = 6 - i
    const gesamt = 4200 + tag * 130
    const spam = Math.round(gesamt * 0.31)
    const virus = 4 + (tag % 3)
    const abgewiesen = Math.round(gesamt * 0.12)
    return {
      day: tageVersetzt(-tag),
      total: gesamt,
      spam,
      virus,
      bounced: 18 + tag,
      rejected: abgewiesen,
      delivered: gesamt - spam - virus - abgewiesen,
      tenant: AT,
    }
  }),
})

