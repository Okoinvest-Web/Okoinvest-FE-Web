<template>
  <div>
    <PageHeader title="Audit" :subtitle="untertitel">
      <template #actions>
        <Button :loading="kette.loading" @click="kette.fetch()">Kette prüfen</Button>
      </template>
    </PageHeader>

    <div class="p-6">
      <!--
        „Unversehrt" heißt nicht „vollständig". Der Unterschied gehört auf
        den Schirm, sonst liest man mehr hinein, als dasteht.
      -->
      <div
        v-if="kette.data"
        class="mb-6 rounded-lg border p-4"
        :class="
          kette.data.ok
            ? 'border-outline-gray-2 bg-surface-white'
            : 'border-outline-red-2 bg-surface-red-1'
        "
      >
        <StatusDot
          :level="kette.data.ok ? 'ok' : 'critical'"
          :text="kette.data.ok ? 'Kette unversehrt' : 'Kette gebrochen bei ' + kette.data.broken_at"
        />
        <p class="mt-1 max-w-3xl text-sm text-ink-gray-6">{{ kette.data.note }}</p>
        <p v-if="!kette.data.ok" class="mt-1 text-sm text-ink-gray-7">
          {{ kette.data.reason }}
        </p>

        <!-- Ohne Umfeld sieht ein Bruch aus wie ein Programmfehler. -->
        <ol v-if="kette.data.context?.length" class="mt-3 space-y-1">
          <li
            v-for="e in kette.data.context"
            :key="e.name"
            class="rounded border px-3 py-2 font-mono text-xs"
            :class="e.is_break ? 'border-outline-red-2 bg-surface-red-2' : 'border-outline-gray-2'"
          >
            <span class="text-ink-gray-5">#{{ e.index }}</span>
            {{ e.name }} · {{ e.action }} {{ e.object_name }}
            <span class="block text-ink-gray-5">
              ← {{ e.prev_hash_short }} · {{ e.entry_hash_short }}
            </span>
          </li>
        </ol>
      </div>

      <!-- Filter -->
      <div class="mb-3 flex flex-wrap items-end gap-2">
        <FormControl v-model="bereich" type="select" :options="bereichOptionen" />
        <FormControl v-model="person" type="select" :options="personOptionen" />
        <FormControl v-model="zeitraum" type="select" :options="zeitraeume" />
        <FormControl v-model="suchbegriff" type="text" placeholder="Objekt, Aktion, Person …" />
        <Button v-if="objektFilter" variant="subtle" @click="objektFilterLoeschen">
          Filter „{{ objektFilter }}" entfernen
        </Button>
      </div>

      <DataTable
        tabellen-id="AuditView"
        :columns="spalten"
        :rows="eintraege.data?.rows || []"
        :loading="eintraege.loading"
        export-name="protokoll"
        empty-text="Kein Eintrag mit diesem Filter."
      >
        <template #zelle-timestamp="{ zeile }">
          <span class="tabular-nums">{{ String(zeile.timestamp).slice(0, 16) }}</span>
          <span class="block text-sm text-ink-gray-5">vor {{ zeile.age_hours }} h</span>
        </template>
        <template #zelle-area_label="{ zeile }">
          <Badge theme="gray">{{ zeile.area_label }}</Badge>
        </template>
        <template #zelle-action="{ zeile }">
          <span class="font-mono text-sm text-ink-gray-9">{{ zeile.action }}</span>
        </template>
        <template #zelle-object="{ zeile }">
          <button
            class="block text-left text-ink-gray-8 underline"
            @click="objektFilter = zeile.object_name"
          >
            {{ zeile.object_name }}
          </button>
          <span class="block text-sm text-ink-gray-5">{{ zeile.object_type }}</span>
        </template>
        <template #zelle-user="{ zeile }">
          <span class="text-sm">{{ kurzName(zeile.user) }}</span>
        </template>
        <template #zelle-kette="{ zeile }">
          <span class="block font-mono text-xs text-ink-gray-5">
            ← {{ zeile.prev_hash_short }}
          </span>
          <span class="block font-mono text-xs text-ink-gray-7">{{ zeile.entry_hash_short }}</span>
        </template>
        <template #zelle-aktion="{ zeile }">
          <Button
            v-if="zeile.has_payload"
            size="sm"
            variant="subtle"
            @click="nachweisFragen(zeile)"
          >
            Nutzlast prüfen
          </Button>
        </template>
      </DataTable>

      <!-- Wer war in welchem Bereich unterwegs -->
      <section v-if="aktivitaet.data" class="mt-8">
        <h2 class="mb-1 text-base font-semibold text-ink-gray-8">Aktivität</h2>
        <p class="mb-3 max-w-3xl text-sm text-ink-gray-6">
          Keine Leistungsmessung. Der Zweck ist die Ausnahme: eine Aktion, die sonst niemand macht,
          oder eine Person, die plötzlich in einem Bereich auftaucht, in dem sie sonst nicht
          vorkommt.
        </p>
        <div class="mb-4 flex flex-wrap gap-x-6 gap-y-2 text-sm">
          <span v-for="b in aktivitaet.data.summary.areas" :key="b.area" class="text-ink-gray-7">
            {{ b.label }}: <span class="tabular-nums font-medium">{{ b.count }}</span>
          </span>
        </div>
        <DataTable :columns="aktivitaetSpalten" :rows="aktivitaet.data.rows" :seiten-groesse="0">
          <template #zelle-user="{ zeile }">
            <span class="text-ink-gray-9">{{ kurzName(zeile.user) }}</span>
          </template>
          <template #zelle-areas="{ zeile }">
            <Badge v-for="a in zeile.areas" :key="a" class="mr-1" theme="gray">{{ a }}</Badge>
          </template>
          <template #zelle-unique_actions="{ zeile }">
            <span v-if="!zeile.unique_actions.length" class="text-sm text-ink-gray-4">–</span>
            <span
              v-for="a in zeile.unique_actions"
              :key="a"
              class="mr-1 font-mono text-xs text-ink-gray-7"
            >
              {{ a }}
            </span>
          </template>
        </DataTable>
      </section>

      <p class="mt-6 max-w-3xl text-xs text-ink-gray-4">
        Von jeder Nutzlast steht nur der SHA-256-Hash im Protokoll – ein Protokoll, das Pfade,
        Gründe und Werte im Klartext führt, wird selbst zur Beute. Damit der Hash trotzdem etwas
        beweist, lässt sich eine behauptete Nutzlast dagegen prüfen.
      </p>
    </div>

    <!-- Nutzlast nachweisen -->
    <Dialog v-model="nachweisOffen" :options="{ title: 'Nutzlast prüfen', size: 'xl' }">
      <template #body-content>
        <p class="mb-1 font-mono text-sm text-ink-gray-9">
          {{ gewaehlt?.name }} · {{ gewaehlt?.action }} {{ gewaehlt?.object_name }}
        </p>
        <p class="mb-3 max-w-2xl text-sm text-ink-gray-6">
          Tragen Sie ein, was Ihrer Meinung nach übergeben wurde. Die Antwort sagt, ob das zum
          Protokoll passt – den tatsächlichen Inhalt gibt es hier nicht, und aus dem Hash lässt er
          sich nicht zurückrechnen.
        </p>
        <FormControl
          v-model="nutzlastText"
          label="Nutzlast als JSON"
          type="textarea"
          :rows="6"
          placeholder='{ "state": "rejected", "reason": "…" }'
        />
        <p v-if="jsonFehler" class="mt-2 text-sm text-ink-red-3">{{ jsonFehler }}</p>

        <div
          v-if="nachweis.data"
          class="mt-4 rounded border p-3"
          :class="nachweis.data.ok ? 'border-outline-green-2' : 'border-outline-red-2'"
        >
          <StatusDot
            :level="nachweis.data.ok ? 'ok' : 'critical'"
            :text="nachweis.data.ok ? 'Stimmt überein' : 'Stimmt nicht überein'"
          />
          <p class="mt-1 text-sm text-ink-gray-7">
            {{ nachweis.data.note || nachweis.data.reason }}
          </p>
          <dl v-if="nachweis.data.stored_hash" class="mt-2 space-y-0.5 font-mono text-xs">
            <div>
              <dt class="inline text-ink-gray-5">gespeichert</dt>
              <dd class="inline text-ink-gray-8">{{ nachweis.data.stored_hash }}</dd>
            </div>
            <div>
              <dt class="inline text-ink-gray-5">gerechnet</dt>
              <dd class="inline text-ink-gray-8">{{ nachweis.data.computed_hash }}</dd>
            </div>
          </dl>
        </div>
      </template>
      <template #actions>
        <Button variant="solid" :loading="nachweis.loading" @click="nachweisPruefen">Prüfen</Button>
      </template>
    </Dialog>
  </div>
</template>

<script setup>
import { computed, ref, watch } from 'vue'
import { Badge, Button, Dialog, FormControl, createResource } from 'frappe-ui'
import PageHeader from '@/components/PageHeader.vue'
import DataTable from '@/components/DataTable.vue'
import StatusDot from '@/components/StatusDot.vue'
import { mengeText } from '@/viz'
import { useRoute } from 'vue-router'

const route = useRoute()
const bereich = ref('')
const person = ref('')
const zeitraum = ref('')
const suchbegriff = ref('')
const objektFilter = ref(route.query.object || '')

const eintraege = createResource({
  url: 'netops.api.audit.audit_search',
  makeParams: () => ({
    area: bereich.value || null,
    user: person.value || null,
    since_hours: zeitraum.value || null,
    search: suchbegriff.value || null,
    object_name: objektFilter.value || null,
  }),
  auto: true,
})
const kette = createResource({ url: 'netops.api.audit.audit_chain_report', auto: true })
const aktivitaet = createResource({ url: 'netops.api.audit.audit_activity', auto: true })
const nachweis = createResource({ url: 'netops.api.audit.audit_verify_payload' })

watch([bereich, person, zeitraum, suchbegriff, objektFilter], () => eintraege.fetch())

const nachweisOffen = ref(false)
const gewaehlt = ref(null)
const nutzlastText = ref('')
const jsonFehler = ref('')

const BEREICHE = {
  backup: 'Sicherung',
  connector: 'Konnektoren',
  drift: 'Abweichungen',
  change: 'Changes',
  ticket: 'Tickets',
  network: 'Netz',
  inventory: 'Inventar',
  identity: 'Zugänge',
  sonstiges: 'Sonstiges',
}

const bereichOptionen = computed(() => [
  { label: 'Alle Bereiche', value: '' },
  ...(eintraege.data?.summary?.areas || []).map((a) => ({ label: BEREICHE[a] || a, value: a })),
])

const personOptionen = computed(() => [
  { label: 'Alle Personen', value: '' },
  ...(aktivitaet.data?.rows || []).map((p) => ({ label: kurzName(p.user), value: p.user })),
])

const zeitraeume = [
  { label: 'Ganzer Zeitraum', value: '' },
  { label: 'Letzte 24 Stunden', value: '24' },
  { label: 'Letzte 7 Tage', value: '168' },
  { label: 'Letzte 30 Tage', value: '720' },
]

const spalten = [
  { key: 'timestamp', label: 'Zeitpunkt', width: '170px' },
  { key: 'area_label', label: 'Bereich', width: '140px' },
  { key: 'action', label: 'Aktion', width: '190px' },
  { key: 'object', label: 'Objekt', width: '240px' },
  { key: 'user', label: 'Person', width: '150px' },
  { key: 'kette', label: 'Kette', width: '180px' },
  { key: 'aktion', label: '', align: 'right', width: '150px' },
]

const aktivitaetSpalten = [
  { key: 'user', label: 'Person', width: '180px' },
  { key: 'entries', label: 'Einträge', align: 'right', numeric: true, width: '110px' },
  { key: 'areas', label: 'Bereiche', width: '320px' },
  { key: 'unique_actions', label: 'Nur von dieser Person' },
]

const untertitel = computed(() => {
  const s = eintraege.data?.summary
  if (!s) return 'Änderungshistorie mit Hash-Kette'
  return (
    mengeText(s.total, 'Eintrag', 'Einträge') +
    (s.matched !== s.total ? ` · ${s.matched} im Filter` : '') +
    ` · ${s.with_payload} mit prüfbarer Nutzlast`
  )
})

function kurzName(mail) {
  return String(mail || '')
    .split('@')[0]
    .replace('.', ' ')
}

function objektFilterLoeschen() {
  objektFilter.value = ''
}

function nachweisFragen(e) {
  gewaehlt.value = e
  nutzlastText.value = ''
  jsonFehler.value = ''
  nachweis.data = null
  nachweisOffen.value = true
}

function nachweisPruefen() {
  jsonFehler.value = ''
  let nutzlast
  try {
    nutzlast = JSON.parse(nutzlastText.value || '{}')
  } catch {
    // Ein Tippfehler im JSON ist kein Beweis für eine Abweichung - das
    // gehört unterschieden.
    jsonFehler.value = 'Das ist kein gültiges JSON. Ein Tippfehler hier beweist nichts.'
    return
  }
  nachweis.fetch({ entry: gewaehlt.value.name, payload: nutzlast })
}
</script>
