/**
 * Synchrone SHA-256-Implementierung nach FIPS 180-4.
 *
 * Warum nicht Web Crypto? `crypto.subtle.digest` ist im Browser ausschliesslich
 * asynchron. Die Hash-Kette der Audit-Eintraege wird aber auch beim synchronen
 * Seeden der Testdaten gebraucht - und im echten Backend rechnet Python
 * ebenfalls synchron. Diese Variante verhaelt sich in Node und im Browser
 * gleich und ist gegen die offiziellen Testvektoren geprueft
 * (siehe tests/audit.test.js).
 */

const K = [
  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
]

/**
 * @param {string} text UTF-8-Text
 * @returns {string} 64 Zeichen Hex, Kleinbuchstaben
 */
export function sha256(text) {
  const bytes = utf8Bytes(String(text))

  const h = [
    0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
  ]

  // Padding: 0x80, dann Nullen, dann die Laenge in Bit als 64-Bit-Big-Endian.
  const bitLaenge = bytes.length * 8
  const gepolstert = [...bytes, 0x80]
  while (gepolstert.length % 64 !== 56) gepolstert.push(0)
  // Nachrichten über 2^32 Bit kommen hier nicht vor - die oberen 32 Bit sind 0.
  gepolstert.push(0, 0, 0, 0)
  gepolstert.push((bitLaenge >>> 24) & 0xff, (bitLaenge >>> 16) & 0xff, (bitLaenge >>> 8) & 0xff, bitLaenge & 0xff)

  const w = new Array(64)

  for (let block = 0; block < gepolstert.length; block += 64) {
    for (let i = 0; i < 16; i++) {
      const p = block + i * 4
      w[i] =
        ((gepolstert[p] << 24) | (gepolstert[p + 1] << 16) | (gepolstert[p + 2] << 8) | gepolstert[p + 3]) >>> 0
    }
    for (let i = 16; i < 64; i++) {
      const s0 = (rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >>> 3)) >>> 0
      const s1 = (rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >>> 10)) >>> 0
      w[i] = (w[i - 16] + s0 + w[i - 7] + s1) >>> 0
    }

    let [a, b, c, d, e, f, g, hh] = h

    for (let i = 0; i < 64; i++) {
      const S1 = (rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)) >>> 0
      const ch = ((e & f) ^ (~e & g)) >>> 0
      const temp1 = (hh + S1 + ch + K[i] + w[i]) >>> 0
      const S0 = (rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)) >>> 0
      const maj = ((a & b) ^ (a & c) ^ (b & c)) >>> 0
      const temp2 = (S0 + maj) >>> 0

      hh = g
      g = f
      f = e
      e = (d + temp1) >>> 0
      d = c
      c = b
      b = a
      a = (temp1 + temp2) >>> 0
    }

    h[0] = (h[0] + a) >>> 0
    h[1] = (h[1] + b) >>> 0
    h[2] = (h[2] + c) >>> 0
    h[3] = (h[3] + d) >>> 0
    h[4] = (h[4] + e) >>> 0
    h[5] = (h[5] + f) >>> 0
    h[6] = (h[6] + g) >>> 0
    h[7] = (h[7] + hh) >>> 0
  }

  return h.map((wert) => wert.toString(16).padStart(8, '0')).join('')
}

function rotr(wert, bits) {
  return ((wert >>> bits) | (wert << (32 - bits))) >>> 0
}

/** UTF-8-Kodierung ohne TextEncoder, damit die Funktion überall gleich läuft. */
function utf8Bytes(text) {
  const bytes = []
  for (let i = 0; i < text.length; i++) {
    let code = text.charCodeAt(i)

    if (code >= 0xd800 && code <= 0xdbff && i + 1 < text.length) {
      const niedrig = text.charCodeAt(i + 1)
      if (niedrig >= 0xdc00 && niedrig <= 0xdfff) {
        code = 0x10000 + ((code - 0xd800) << 10) + (niedrig - 0xdc00)
        i++
      }
    }

    if (code < 0x80) {
      bytes.push(code)
    } else if (code < 0x800) {
      bytes.push(0xc0 | (code >> 6), 0x80 | (code & 0x3f))
    } else if (code < 0x10000) {
      bytes.push(0xe0 | (code >> 12), 0x80 | ((code >> 6) & 0x3f), 0x80 | (code & 0x3f))
    } else {
      bytes.push(
        0xf0 | (code >> 18),
        0x80 | ((code >> 12) & 0x3f),
        0x80 | ((code >> 6) & 0x3f),
        0x80 | (code & 0x3f),
      )
    }
  }
  return bytes
}

/**
 * Kanonische JSON-Form: Schlüssel sortiert, damit derselbe Inhalt immer
 * denselben Hash ergibt - unabhängig von der Reihenfolge im Objekt.
 */
export function kanonisch(wert) {
  if (wert === null || typeof wert !== 'object') return JSON.stringify(wert) ?? 'null'
  if (Array.isArray(wert)) return '[' + wert.map(kanonisch).join(',') + ']'

  const schluessel = Object.keys(wert).sort()
  return (
    '{' +
    schluessel
      .filter((k) => wert[k] !== undefined)
      .map((k) => JSON.stringify(k) + ':' + kanonisch(wert[k]))
      .join(',') +
    '}'
  )
}
