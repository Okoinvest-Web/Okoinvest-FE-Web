<template>
  <div
    class="relative h-[640px] overflow-hidden rounded-lg border border-outline-gray-2 bg-surface-white"
  >
    <VueFlow
      :nodes="knoten"
      :edges="kanten"
      :nodes-draggable="false"
      :nodes-connectable="false"
      :elements-selectable="true"
      :min-zoom="0.3"
      :max-zoom="2"
      fit-view-on-init
      class="netops-topologie"
      @node-click="({ node }) => $emit('select', node)"
      @edge-mouse-enter="({ edge }) => (aktiveKante = edge.id)"
      @edge-mouse-leave="aktiveKante = null"
    >
      <template #node-geraet="{ data }">
        <div
          class="min-w-[150px] rounded-lg border-2 bg-surface-white px-3 py-2 shadow-sm"
          :style="{ borderColor: rahmenFarbe(data) }"
          @mouseenter="aktiv = data"
          @mouseleave="aktiv = null"
        >
          <div class="flex items-center gap-1.5">
            <span
              class="inline-block size-2 shrink-0 rounded-full"
              :style="{ background: statusFarbe(data.lifecycle_status) }"
            />
            <span class="truncate text-sm font-semibold text-ink-gray-9">{{ data.label }}</span>
          </div>
          <!-- Rolle als Text, nicht als Farbe: sieben Rollen wären farblich
               nicht sicher unterscheidbar. -->
          <p class="mt-0.5 truncate text-xs text-ink-gray-6">{{ data.device_role }}</p>
          <p v-if="data.sublabel" class="truncate text-xs tabular-nums text-ink-gray-5">
            {{ data.sublabel }}
          </p>
        </div>
      </template>

      <template #node-dose="{ data }">
        <div
          class="min-w-[110px] rounded-lg border-2 border-dashed px-3 py-2"
          style="border-color: var(--viz-neutral); background: var(--viz-neutral-soft)"
          @mouseenter="aktiv = data"
          @mouseleave="aktiv = null"
        >
          <p class="truncate text-sm font-medium text-ink-gray-8">{{ data.label }}</p>
          <p class="truncate text-xs text-ink-gray-6">Dose · {{ data.sublabel }}</p>
        </div>
      </template>
    </VueFlow>

    <!-- Legende -->
    <div
      class="pointer-events-none absolute bottom-3 left-3 rounded-lg border border-outline-gray-2 bg-surface-white/95 px-3 py-2 text-xs text-ink-gray-6"
    >
      <p class="mb-1 font-medium text-ink-gray-8">Legende</p>
      <p class="flex items-center gap-1.5">
        <span class="inline-block size-2 rounded-full" style="background: var(--viz-good)" />
        produktiv
      </p>
      <p class="mt-1 flex items-center gap-1.5">
        <svg width="26" height="6" aria-hidden="true">
          <line x1="0" y1="3" x2="26" y2="3" stroke="var(--viz-series-1)" stroke-width="3" />
        </svg>
        10 Gbit/s
      </p>
      <p class="mt-1 flex items-center gap-1.5">
        <svg width="26" height="6" aria-hidden="true">
          <line x1="0" y1="3" x2="26" y2="3" stroke="var(--viz-neutral)" stroke-width="1.5" />
        </svg>
        1 Gbit/s
      </p>
      <p class="mt-1 text-ink-gray-5">Kante berühren zeigt die Ports</p>
    </div>
  </div>
</template>

<script setup>
import { computed, ref } from 'vue'
import { VueFlow } from '@vue-flow/core'
import '@vue-flow/core/dist/style.css'
import '@vue-flow/core/dist/theme-default.css'

const props = defineProps({
  graph: { type: Object, required: true },
})
defineEmits(['select'])

const aktiv = ref(null)
const aktiveKante = ref(null)

// Die Positionen kommen fertig vom Server, damit derselbe Plan bei jedem
// Aufruf gleich aussieht (siehe netops.api.dcim.topology).
const knoten = computed(() =>
  props.graph.nodes.map((n) => ({
    id: n.id,
    type: n.kind === 'outlet' ? 'dose' : 'geraet',
    position: n.position,
    data: n,
  })),
)

const kanten = computed(() =>
  props.graph.edges.map((e) => {
    const beruehrt = aktiveKante.value === e.id
    const schnell = e.speed_mbps >= 10000

    return {
      id: e.id,
      source: e.source,
      target: e.target,
      // Beschriftung nur bei Berührung: alle Kanten einer Ebene haben
      // denselben Mittelpunkt-y, feste Labels würden übereinander liegen.
      label: beruehrt ? e.label + ' · ' + e.source_port + ' ↔ ' + e.target_port : '',
      type: 'smoothstep',
      style: {
        // Bandbreite über die Strichstärke, nicht über eine zweite Farbskala.
        stroke: beruehrt || schnell ? 'var(--viz-series-1)' : 'var(--viz-neutral)',
        strokeWidth: beruehrt ? 4 : schnell ? 3 : 1.5,
      },
      labelStyle: { fontSize: '11px', fill: 'var(--viz-ink)' },
      labelBgStyle: { fill: 'var(--viz-surface)', stroke: 'var(--viz-chassis-line)' },
      labelBgPadding: [6, 3],
      labelBgBorderRadius: 4,
    }
  }),
)

function statusFarbe(lebenszyklus) {
  switch (lebenszyklus) {
    case 'production':
      return 'var(--viz-good)'
    case 'testing':
      return 'var(--viz-series-1)'
    case 'retired':
      return 'var(--viz-critical)'
    default:
      return 'var(--viz-neutral)'
  }
}

function rahmenFarbe(data) {
  return data.device_role === 'Firewall' ? 'var(--viz-series-2)' : 'var(--viz-chassis-line)'
}
</script>

<style scoped>
.netops-topologie :deep(.vue-flow__edge-text) {
  font-size: 10px;
}
</style>
