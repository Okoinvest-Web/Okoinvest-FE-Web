import { beforeEach, describe, expect, it } from 'vitest'
import { mockRequest, resetMockData } from '@/api/mock/server.js'
import { seedAuditLog } from '@/api/mock/seed-audit.js'

const ruf = (url, params) => mockRequest({ url, params })

beforeEach(() => {
  resetMockData()
  seedAuditLog()
})

describe('netops.api.security.vulnerability_list', () => {
  it('stellt eine aktiv ausgenutzte Lücke nach vorne', async () => {
    const liste = await ruf('netops.api.security.vulnerability_list', { state: 'open' })
    expect(liste[0].kev).toBe(1)
    expect(liste[0].cve).toBe('CVE-2026-1001')
  })

  it('leitet die Frist aus der Einstufung ab', async () => {
    const liste = await ruf('netops.api.security.vulnerability_list', { state: 'open' })
    const kev = liste.find((v) => v.kev)
    const hoch = liste.find((v) => !v.kev && v.severity === 'high')
    expect(kev.sla_days).toBe(3)
    expect(hoch.sla_days).toBe(30)
  })

  it('stuft nach CVSS ein', async () => {
    const liste = await ruf('netops.api.security.vulnerability_list', {})
    expect(liste.find((v) => v.cve === 'CVE-2026-1001').severity).toBe('critical')
    expect(liste.find((v) => v.cve === 'CVE-2026-1042').severity).toBe('high')
    expect(liste.find((v) => v.cve === 'CVE-2025-5501').severity).toBe('medium')
  })

  it('markiert überschrittene Fristen nur bei offenen Einträgen', async () => {
    const alle = await ruf('netops.api.security.vulnerability_list', {})
    const ueberfaellig = alle.filter((v) => v.overdue)
    expect(ueberfaellig).toHaveLength(1)
    expect(ueberfaellig[0].cve).toBe('CVE-2025-9912')
    // Behoben und Ausnahme haben ebenfalls alte Fristen, gelten aber nicht als überfällig.
    expect(alle.find((v) => v.vuln_state === 'fixed').overdue).toBe(false)
    expect(alle.find((v) => v.vuln_state === 'accepted_risk').overdue).toBe(false)
  })

  it('bewertet aktive Ausnutzung höher als reines CVSS', async () => {
    const liste = await ruf('netops.api.security.vulnerability_list', {})
    const kev = liste.find((v) => v.cve === 'CVE-2026-1001')
    const hoehererCvssOhneKev = liste.find((v) => v.cve === 'CVE-2026-1042')
    expect(kev.risk_score).toBeGreaterThan(hoehererCvssOhneKev.risk_score)
  })
})

describe('netops.api.security.incident_list', () => {
  it('stellt offene Vorfälle nach vorne', async () => {
    const liste = await ruf('netops.api.security.incident_list', {})
    expect(liste[0].open).toBe(true)
    expect(liste[liste.length - 1].incident_state).toBe('closed')
  })

  it('rechnet die Meldefristen nur für offene Vorfälle', async () => {
    const liste = await ruf('netops.api.security.incident_list', {})
    const offen = liste.find((i) => i.open)
    const geschlossen = liste.find((i) => !i.open)
    expect(typeof offen.hours_to_early_warning).toBe('number')
    expect(geschlossen.hours_to_early_warning).toBeNull()
  })

  it('kennt die DSGVO-Frist nur, wo sie gesetzt ist', async () => {
    const liste = await ruf('netops.api.security.incident_list', {})
    const phishing = liste.find((i) => i.title.includes('Phishing'))
    const anmeldung = liste.find((i) => i.title.includes('Anmeldeversuche'))
    expect(typeof phishing.hours_to_gdpr).toBe('number')
    expect(anmeldung.hours_to_gdpr).toBeNull()
  })
})

