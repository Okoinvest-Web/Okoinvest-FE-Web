import { spawn } from 'node:child_process'
import { mkdtempSync } from 'node:fs'
import { tmpdir } from 'node:os'
import { join } from 'node:path'
const EDGE = 'C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe'
const port = 9380
const profil = mkdtempSync(join(tmpdir(), 'edge-cdp-'))
const kind = spawn(EDGE, ['--headless=new','--disable-gpu','--no-first-run','--no-default-browser-check','--window-size=1500,1150',`--remote-debugging-port=${port}`,`--user-data-dir=${profil}`,'about:blank'], { stdio: 'ignore' })
const schlafe = (ms) => new Promise((r) => setTimeout(r, ms))
let ziel = null
for (let i = 0; i < 40 && !ziel; i++) { await schlafe(250); try { ziel = (await (await fetch(`http://127.0.0.1:${port}/json/list`)).json()).find((t) => t.type === 'page') } catch {} }
const ws = new WebSocket(ziel.webSocketDebuggerUrl); await new Promise((r) => (ws.onopen = r))
let id = 0; const offen = new Map(); const fehler = []
ws.onmessage = (ev) => {
  const m = JSON.parse(ev.data)
  if (m.id && offen.has(m.id)) { offen.get(m.id)(m.result); offen.delete(m.id) }
  if (m.method === 'Runtime.exceptionThrown') fehler.push(String(m.params.exceptionDetails.exception?.description || m.params.exceptionDetails.text).split('\n').slice(0, 3).join(' / '))
  if (m.method === 'Runtime.consoleAPICalled' && m.params.type === 'error') fehler.push('console: ' + m.params.args.map((a) => a.description || a.value).join(' ').split('\n')[0])
}
const sende = (me, p = {}) => new Promise((r) => { const n = ++id; offen.set(n, r); ws.send(JSON.stringify({ id: n, method: me, params: p })) })
const js = async (a) => (await sende('Runtime.evaluate', { returnByValue: true, expression: a, awaitPromise: true })).result.value
await sende('Runtime.enable'); await sende('Page.enable')
async function klick(ausdruck) {
  const r = await js(`(() => { const e = ${ausdruck}; if (!e) return null; e.scrollIntoView({block:'center'}); const b = e.getBoundingClientRect(); return JSON.stringify({x: b.x + b.width/2, y: b.y + b.height/2}) })()`)
  if (!r) return 'nicht gefunden'
  const { x, y } = JSON.parse(r)
  // mouseMoved zuerst und `buttons` mitgeben: ohne beides erzeugt Chrome
  // kein click-Ereignis, und die Vue-Handler laufen nie an.
  await sende('Input.dispatchMouseEvent', { type: 'mouseMoved', x, y })
  await sende('Input.dispatchMouseEvent', { type: 'mousePressed', x, y, button: 'left', buttons: 1, clickCount: 1 })
  await sende('Input.dispatchMouseEvent', { type: 'mouseReleased', x, y, button: 'left', buttons: 0, clickCount: 1 })
  return 'geklickt'
}
await sende('Page.navigate', { url: 'http://localhost:8080/backup' })
for (let i = 0; i < 80; i++) { if ((await js('document.body.innerText.trim().length')) > 500) break; await schlafe(250) }
await schlafe(900)

console.log('Treffer unter dem Klickpunkt:', await js("(() => { const e=[...document.querySelectorAll('button')].find(x=>x.innerText.trim()==='Jetzt sichern'); e.scrollIntoView({block:'center'}); const b=e.getBoundingClientRect(); const t=document.elementFromPoint(b.x+b.width/2,b.y+b.height/2); return (t===e||e.contains(t)) ? 'der Knopf' : t.tagName+'.'+String(t.className).slice(0,60) })()"))
await js("window.__klicks=0; [...document.querySelectorAll('button')].find(x=>x.innerText.trim()==='Jetzt sichern').addEventListener('click',()=>window.__klicks++)")
console.log('DOM-click:', await js("(() => { const b=[...document.querySelectorAll('button')].find(x=>x.innerText.trim()==='Jetzt sichern'); b.click(); return 'ausgeloest' })()"))
await schlafe(1500)
console.log('body-Kinder:', await js("[...document.body.children].map(e=>e.tagName+'.'+String(e.id||e.className||'').slice(0,30)).join(' | ')"))
console.log('ausserhalb #inhalt:', (await js("[...document.querySelectorAll('body > div')].filter(e=>!e.querySelector('#inhalt')).map(e=>e.innerText.trim()).filter(Boolean).join(' ### ')")).slice(0, 600))
console.log('Knoepfe (Ende):', (await js("[...document.querySelectorAll('button')].map(b=>b.innerText.trim()).filter(Boolean).join(' | ')")).slice(-260))
console.log('Klicks angekommen:', await js('window.__klicks'))
console.log('Inputs:', await js("[...document.querySelectorAll('input')].map(i=>i.type+':'+(i.placeholder||'')).join(' | ')"))
console.log('Ausnahmen:', fehler.join(' ;; ') || '(keine)')
ws.close(); kind.kill()
