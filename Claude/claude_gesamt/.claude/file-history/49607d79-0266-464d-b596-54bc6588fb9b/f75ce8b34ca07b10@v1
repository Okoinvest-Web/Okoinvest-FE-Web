<template>
  <div>
    <PageHeader title="Tickets" :subtitle="untertitel">
      <template #actions>
        <FormControl v-model="zustand" type="select" :options="zustandOptionen" />
      </template>
    </PageHeader>

    <div class="p-6">
      <DataTable
        tabellen-id="TicketView"
        :columns="spalten"
        :rows="tickets.data || []"
        :loading="tickets.loading"
        empty-text="Kein Ticket mit diesem Filter."
      >
        <template #zelle-ticket_key="{ zeile }">
          <span class="block font-mono text-sm text-ink-gray-9">{{ zeile.ticket_key }}</span>
        </template>
        <template #zelle-subject="{ zeile }">
          <span class="block text-ink-gray-9">{{ zeile.subject }}</span>
          <span class="block text-sm text-ink-gray-5">
            {{ doctypeLabel(zeile.object_type) }} {{ zeile.object_name }}
          </span>
        </template>
        <template #zelle-priority="{ zeile }">
          <StatusDot :level="schweregradStufe(zeile.priority)" :text="PRIO[zeile.priority]" klein />
        </template>
        <template #zelle-assignee="{ zeile }">
          <StatusDot v-if="zeile.unassigned" level="warning" text="nicht zugewiesen" klein />
          <span v-else class="text-sm">{{ zeile.assignee || '–' }}</span>
        </template>
        <template #zelle-sla="{ zeile }">
          <StatusDot
            v-if="zeile.sla_breached"
            level="critical"
            :text="'SLA um ' + Math.abs(zeile.sla_remaining_hours) + ' h überschritten'"
            klein
          />
          <StatusDot
            v-else-if="
              zeile.open && zeile.sla_remaining_hours !== null && zeile.sla_remaining_hours < 24
            "
            level="warning"
            :text="'noch ' + zeile.sla_remaining_hours + ' h'"
            klein
          />
          <span v-else-if="zeile.open" class="text-sm tabular-nums text-ink-gray-6">
            noch {{ zeile.sla_remaining_hours }} h
          </span>
          <span v-else class="text-sm text-ink-gray-4">geschlossen</span>
        </template>
        <template #zelle-ticket_state="{ zeile }">
          <Badge :theme="zustandThema(zeile.ticket_state)">
            {{ ZUSTAND[zeile.ticket_state] || zeile.ticket_state }}
          </Badge>
        </template>
      </DataTable>

      <p class="mt-3 text-xs text-ink-gray-4">
        Jedes Ticket hat einen Objektbezug – dadurch lässt sich von jedem Gerät aus sehen, was daran
        gerade offen ist. Der Vorfall-Modus mit Zeitleiste und Beweisobjekten aus Fachkonzept 2.11
        setzt das Backend voraus.
      </p>
    </div>
  </div>
</template>

<script setup>
import { computed, ref, watch } from 'vue'
import { Badge, FormControl, createResource } from 'frappe-ui'
import PageHeader from '@/components/PageHeader.vue'
import DataTable from '@/components/DataTable.vue'
import StatusDot from '@/components/StatusDot.vue'
import { doctypeLabel } from '@/labels'
import { schweregradStufe } from '@/viz'

const PRIO = { critical: 'Kritisch', high: 'Hoch', medium: 'Mittel', low: 'Niedrig' }
const ZUSTAND = { open: 'Offen', in_progress: 'In Arbeit', closed: 'Geschlossen' }

const zustand = ref('')

const tickets = createResource({
  url: 'netops.api.netsvc.ticket_list',
  makeParams: () => ({ state: zustand.value || null }),
  auto: true,
})

watch(zustand, () => tickets.fetch())

const zustandOptionen = [
  { label: 'Alle Zustände', value: '' },
  { label: 'Offen', value: 'open' },
  { label: 'In Arbeit', value: 'in_progress' },
  { label: 'Geschlossen', value: 'closed' },
]

const spalten = [
  { key: 'ticket_key', label: 'Nummer', width: '110px' },
  { key: 'subject', label: 'Betreff', width: '340px' },
  { key: 'priority', label: 'Priorität', width: '130px' },
  { key: 'assignee', label: 'Bearbeiter', width: '210px' },
  { key: 'age_hours', label: 'Alter (h)', align: 'right', numeric: true, width: '100px' },
  { key: 'sla', label: 'SLA', width: '230px' },
  { key: 'ticket_state', label: 'Zustand', width: '130px' },
]

const untertitel = computed(() => {
  const liste = tickets.data || []
  const offen = liste.filter((t) => t.open).length
  const gerissen = liste.filter((t) => t.sla_breached).length
  return (
    liste.length +
    ' Tickets · ' +
    offen +
    ' offen' +
    (gerissen ? ' · ' + gerissen + ' über SLA' : '')
  )
})

function zustandThema(zustandWert) {
  return { open: 'orange', in_progress: 'blue', closed: 'green' }[zustandWert] || 'gray'
}
</script>
