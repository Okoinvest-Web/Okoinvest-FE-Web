<template>
  <div>
    <PageHeader title="Tickets" :subtitle="untertitel">
      <template #actions>
        <FormControl v-model="zustand" type="select" :options="zustandOptionen" />
        <Button :variant="nurMeine ? 'solid' : 'subtle'" @click="nurMeine = !nurMeine">
          Meine ({{ board.data?.summary?.mine ?? 0 }})
        </Button>
      </template>
    </PageHeader>

    <div class="p-6">
      <div v-if="board.data" class="mb-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
        <StatCard
          label="Offen"
          :wert="board.data.summary.open"
          :hinweis="
            board.data.summary.next_due ? 'nächste Frist: ' + board.data.summary.next_due : null
          "
          :level="board.data.summary.open ? 'neutral' : 'ok'"
        />
        <StatCard
          label="Frist gerissen"
          :wert="board.data.summary.breached"
          hinweis="ohne Wartezeit gerechnet"
          :level="board.data.summary.breached ? 'critical' : 'ok'"
        />
        <StatCard
          label="Ohne Namen"
          :wert="board.data.summary.unassigned"
          hinweis="niemand fühlt sich zuständig"
          :level="board.data.summary.unassigned ? 'warning' : 'ok'"
        />
        <StatCard
          label="Wartet auf Rückmeldung"
          :wert="board.data.summary.waiting"
          hinweis="Frist steht solange"
          level="neutral"
        />
      </div>

      <p v-if="board.data" class="mb-3 text-sm text-ink-gray-6">{{ board.data.summary.note }}</p>

      <DataTable
        tabellen-id="TicketView"
        :columns="spalten"
        :rows="board.data?.rows || []"
        :loading="board.loading"
        export-name="tickets"
        empty-text="Kein Ticket mit diesem Filter."
      >
        <template #zelle-ticket_key="{ zeile }">
          <span class="block font-mono text-sm text-ink-gray-9">{{ zeile.ticket_key }}</span>
          <StatusDot :level="schweregradStufe(zeile.priority)" :text="zeile.priority_label" klein />
        </template>
        <template #zelle-subject="{ zeile }">
          <span class="block text-ink-gray-9">{{ zeile.subject }}</span>
          <RouterLink
            v-if="zeile.object_name"
            :to="'/audit?object=' + zeile.object_name"
            class="block text-sm text-ink-gray-5 underline"
          >
            {{ doctypeLabel(zeile.object_type) }} {{ zeile.object_name }}
          </RouterLink>
          <span v-if="zeile.resolution" class="mt-1 block text-sm text-ink-gray-6">
            Lösung: {{ zeile.resolution }}
          </span>
        </template>
        <template #zelle-assignee="{ zeile }">
          <span v-if="zeile.assignee" class="text-sm">{{ kurzName(zeile.assignee) }}</span>
          <StatusDot v-else-if="zeile.open" level="warning" text="niemand" klein />
          <span v-else class="text-sm text-ink-gray-4">–</span>
        </template>
        <!--
          Die Frist zeigt die Uhr, die tatsächlich läuft. Steht sie, sagt
          die Zelle das - sonst sieht ein pausiertes Ticket aus wie ein
          vergessenes.
        -->
        <template #zelle-sla="{ zeile }">
          <StatusDot
            v-if="zeile.sla_breached"
            level="critical"
            :text="'um ' + Math.abs(zeile.sla_remaining_hours) + ' h überschritten'"
            klein
          />
          <template v-else-if="zeile.open && zeile.sla_remaining_hours !== null">
            <StatusDot
              :level="zeile.sla_remaining_hours < 8 ? 'warning' : 'ok'"
              :text="'noch ' + zeile.sla_remaining_hours + ' h'"
              klein
            />
            <span v-if="zeile.sla_paused" class="block text-sm text-ink-gray-5">
              Uhr steht seit {{ zeile.waiting_hours }} h
            </span>
          </template>
          <span v-else class="text-sm text-ink-gray-4">geschlossen</span>
        </template>
        <template #zelle-ticket_state="{ zeile }">
          <Badge :theme="zustandThema(zeile.ticket_state)">{{ zeile.state_label }}</Badge>
        </template>
        <template #zelle-aktion="{ zeile }">
          <div class="flex flex-wrap justify-end gap-1">
            <Button size="sm" variant="subtle" @click="zuweisenFragen(zeile)">Zuweisen</Button>
            <Button
              v-for="z in zeile.next_states"
              :key="z"
              size="sm"
              :variant="z === 'closed' ? 'subtle' : 'solid'"
              @click="zustandFragen(zeile, z)"
            >
              {{ ZUSTAND[z] }}
            </Button>
          </div>
        </template>
      </DataTable>

      <!--
        Fünf Tickets an demselben Switch sind kein Ticketproblem. Diese
        Liste beantwortet „was tauschen wir als Nächstes aus" - eine Frage,
        die sonst niemand stellt, bis das Gerät ausfällt.
      -->
      <section v-if="auffaellige.length" class="mt-8">
        <h2 class="mb-1 text-base font-semibold text-ink-gray-8">Häufungen</h2>
        <p class="mb-3 text-sm text-ink-gray-6">
          Objekte, die wiederholt Tickets erzeugen. Das ist die Ersatzliste, nicht die Ticketliste.
        </p>
        <DataTable :columns="haeufungSpalten" :rows="auffaellige" :seiten-groesse="0">
          <template #zelle-object_name="{ zeile }">
            <span class="font-mono text-sm text-ink-gray-9">{{ zeile.object_name }}</span>
            <span class="block text-sm text-ink-gray-5">{{ zeile.object_type }}</span>
          </template>
          <template #zelle-subjects="{ zeile }">
            <span v-for="s in zeile.subjects" :key="s" class="block text-sm text-ink-gray-6">
              · {{ s }}
            </span>
          </template>
          <template #zelle-befund="{ zeile }">
            <StatusDot :level="zeile.level" :text="zeile.reasons[0] || 'unauffällig'" klein />
          </template>
        </DataTable>
      </section>

      <p class="mt-6 max-w-3xl text-xs text-ink-gray-4">
        Die Frist steht, solange auf eine Rückmeldung gewartet wird. Liefe sie weiter, misst sie
        nicht die eigene Bearbeitung, sondern ein fremdes Postfach – und nach ein paar solchen
        Überschreitungen ist die Kennzahl wertlos.
      </p>
    </div>

    <!-- Zustand wechseln -->
    <Dialog v-model="zustandOffen" :options="{ title: ZUSTAND[zielZustand] || '' }">
      <template #body-content>
        <p class="mb-3 text-sm text-ink-gray-6">
          <span class="font-mono">{{ gewaehlt?.ticket_key }}</span> – {{ gewaehlt?.subject }}
        </p>
        <p v-if="zielZustand === 'waiting'" class="mb-3 text-sm text-ink-gray-6">
          Die Frist steht ab jetzt still und läuft erst weiter, wenn das Ticket zurück in Arbeit
          geht.
        </p>
        <FormControl
          v-if="zielZustand === 'closed'"
          v-model="notiz"
          label="Was war es? (kommt ans Ticket)"
          type="text"
          placeholder="Kabel war lose, neu gesteckt"
        />
        <p v-if="zielZustand === 'closed'" class="mt-2 text-xs text-ink-gray-5">
          Ohne ein Wort zur Lösung ist das Ticket beim nächsten gleichen Vorfall wertlos.
        </p>
      </template>
      <template #actions>
        <Button
          variant="solid"
          :disabled="zielZustand === 'closed' && !notiz"
          :loading="setzen.loading"
          @click="zustandAusfuehren"
        >
          {{ ZUSTAND[zielZustand] }}
        </Button>
      </template>
    </Dialog>

    <!-- Zuweisen -->
    <Dialog v-model="zuweisenOffen" :options="{ title: 'Ticket zuweisen' }">
      <template #body-content>
        <p class="mb-3 text-sm text-ink-gray-6">
          <span class="font-mono">{{ gewaehlt?.ticket_key }}</span> – {{ gewaehlt?.subject }}
        </p>
        <FormControl v-model="person" label="Bearbeitung" type="select" :options="personOptionen" />
        <FormControl
          v-if="!person"
          v-model="abgabeGrund"
          label="Grund für die Abgabe"
          type="text"
          class="mt-3"
          placeholder="Zuständigkeit liegt beim Dienstleister"
        />
      </template>
      <template #actions>
        <Button
          variant="solid"
          :disabled="!person && !abgabeGrund"
          :loading="zuweisung.loading"
          @click="zuweisenAusfuehren"
        >
          {{ person ? 'Zuweisen' : 'Abgeben' }}
        </Button>
      </template>
    </Dialog>
  </div>
</template>

<script setup>
import { computed, ref, watch } from 'vue'
import { Badge, Button, Dialog, FormControl, createResource, toast } from 'frappe-ui'
import PageHeader from '@/components/PageHeader.vue'
import DataTable from '@/components/DataTable.vue'
import StatCard from '@/components/StatCard.vue'
import StatusDot from '@/components/StatusDot.vue'
import { doctypeLabel } from '@/labels'
import { fehlerText, mengeText, schweregradStufe } from '@/viz'
import { useUiStore } from '@/stores/ui'

const ZUSTAND = {
  open: 'Offen',
  in_progress: 'In Arbeit',
  waiting: 'Wartet',
  closed: 'Schließen',
}

const ui = useUiStore()
const zustand = ref('')
const nurMeine = ref(false)

const board = createResource({
  url: 'netops.api.tickets.ticket_board',
  makeParams: () => ({
    state: zustand.value || null,
    mine: nurMeine.value,
    tenant: ui.mandant || null,
  }),
  auto: true,
})
const haeufungen = createResource({ url: 'netops.api.tickets.ticket_hotspots', auto: true })
const optionen = createResource({ url: 'netops.api.tickets.ticket_options', auto: true })
const setzen = createResource({ url: 'netops.api.tickets.ticket_set_state' })
const zuweisung = createResource({ url: 'netops.api.tickets.ticket_assign' })

watch([zustand, nurMeine, () => ui.mandant], () => board.fetch())

const zustandOffen = ref(false)
const zuweisenOffen = ref(false)
const gewaehlt = ref(null)
const zielZustand = ref('')
const notiz = ref('')
const person = ref('')
const abgabeGrund = ref('')

const zustandOptionen = [
  { label: 'Alle Zustände', value: '' },
  { label: 'Offen', value: 'open' },
  { label: 'In Arbeit', value: 'in_progress' },
  { label: 'Wartet auf Rückmeldung', value: 'waiting' },
  { label: 'Geschlossen', value: 'closed' },
]

const personOptionen = computed(() => [
  { label: '– abgeben –', value: '' },
  ...(optionen.data?.assignees || []),
])

const spalten = [
  { key: 'ticket_key', label: 'Ticket', width: '140px' },
  { key: 'subject', label: 'Betreff' },
  { key: 'assignee', label: 'Bearbeitung', width: '150px' },
  { key: 'sla', label: 'Frist', width: '200px' },
  { key: 'ticket_state', label: 'Zustand', width: '150px' },
  { key: 'aktion', label: '', align: 'right', width: '330px' },
]

const haeufungSpalten = [
  { key: 'object_name', label: 'Objekt', width: '230px' },
  { key: 'tickets', label: 'Tickets', align: 'right', numeric: true, width: '100px' },
  { key: 'open', label: 'offen', align: 'right', numeric: true, width: '90px' },
  { key: 'subjects', label: 'Worum ging es' },
  { key: 'befund', label: 'Bewertung', width: '300px' },
]

const auffaellige = computed(() => (haeufungen.data || []).filter((h) => h.tickets > 1))

const untertitel = computed(() => {
  const s = board.data?.summary
  if (!s) return ''
  return (
    mengeText(s.open, 'offenes Ticket', 'offene Tickets') +
    (s.breached ? ` · ${s.breached} über der Frist` : '') +
    (s.unassigned ? ` · ${s.unassigned} ohne Namen` : '')
  )
})

function kurzName(mail) {
  return String(mail || '')
    .split('@')[0]
    .replace('.', ' ')
}

function zustandThema(z) {
  return { open: 'orange', in_progress: 'blue', waiting: 'gray', closed: 'green' }[z] || 'gray'
}

function zustandFragen(t, ziel) {
  gewaehlt.value = t
  zielZustand.value = ziel
  notiz.value = ''
  zustandOffen.value = true
}

async function zustandAusfuehren() {
  try {
    const e = await setzen.submit({
      ticket: gewaehlt.value.ticket_key,
      state: zielZustand.value,
      note: notiz.value || null,
    })
    toast.create({ message: e.note, type: 'success' })
    zustandOffen.value = false
    board.fetch()
    haeufungen.fetch()
  } catch (fehler) {
    toast.create({ message: fehlerText(fehler), type: 'error' })
  }
}

function zuweisenFragen(t) {
  gewaehlt.value = t
  person.value = t.assignee || ''
  abgabeGrund.value = ''
  zuweisenOffen.value = true
}

async function zuweisenAusfuehren() {
  try {
    const e = await zuweisung.submit({
      ticket: gewaehlt.value.ticket_key,
      assignee: person.value || null,
      reason: abgabeGrund.value || null,
    })
    toast.create({ message: e.note, type: 'success' })
    zuweisenOffen.value = false
    board.fetch()
  } catch (fehler) {
    toast.create({ message: fehlerText(fehler), type: 'error' })
  }
}
</script>
