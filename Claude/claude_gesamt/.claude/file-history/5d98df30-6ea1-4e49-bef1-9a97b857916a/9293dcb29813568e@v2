def stil(name, txt, w):
    saetze = [s for s in re.split(r'(?<=[.!?]) ', txt) if len(s.split()) > 2]
    ln = [len(s.split()) for s in saetze]
    print(f'{name}')
    print(f'   Sätze: {len(saetze)}   Ø Satzlänge: {sum(ln)/len(ln):.1f} Wörter   '
          f'längster: {max(ln)}')
    print(f'   Types/Tokens: {len(set(w))}/{len(w)} = {len(set(w))/len(w):.3f}')
    for marker, pat in [('„Verdacht"', r'verdacht'), ('„zu prüfen"', r'zu prüfen'),
                        ('„nicht auszuschließen"', r'nicht auszuschließen'),
                        ('„Schutzbehauptung"', r'schutzbehauptung'),
                        ('„Prozessbetrug"', r'prozessbetrug'),
                        ('„Nachweis(e)"', r'nachweis'),
                        ('„vorgelegt"', r'vorgelegt'),
                        ('„Verdächtige(r)"', r'verdächtig')]:
        print(f'      {marker:24s} {len(re.findall(pat, txt.lower())):3d}')
