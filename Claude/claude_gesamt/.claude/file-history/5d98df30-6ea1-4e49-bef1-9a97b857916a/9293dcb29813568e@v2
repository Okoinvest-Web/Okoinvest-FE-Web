BOILER = re.compile(r'Erstellt für Stefan ZAJIC am 16\.04\.2026 um 14:35:57 durch Verrechnungsstelle')

def extract(on, naechste):
    pat = r'ON ' + re.escape(on) + r', \d+'
    starts = [m.start() for m in re.finditer(pat, t)]
    end = t.find('ON ' + naechste + ', 1', starts[-1])
    if end == -1:
        end = starts[-1] + 12000
    raw = t[starts[0]:end]
    raw = BOILER.sub(' ', raw)
    raw = re.sub(r'ON \d+\.\d+, \d+', ' ', raw)
    raw = re.sub(r'816 018 ST 14/26 m', ' ', raw)
    raw = re.sub(r'-\s*\n\s*', '', raw)          # Silbentrennung
    raw = re.sub(r'\s+', ' ', raw)
    return raw.strip()

