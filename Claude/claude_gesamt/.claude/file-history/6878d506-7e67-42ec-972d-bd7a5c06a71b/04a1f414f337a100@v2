"use client";

import { useEffect, useState } from "react";
import { CircleCheck, CircleX } from "lucide-react";

type Toast = { id: number; text: string; kind: "ok" | "error" };

// Kurze Rückmeldung nach Aktionen; von überall per toast("…") auslösbar
export function toast(text: string, kind: Toast["kind"] = "ok") {
  window.dispatchEvent(new CustomEvent("crm-toast", { detail: { text, kind } }));
}

export function Toaster() {
  const [items, setItems] = useState<Toast[]>([]);

  useEffect(() => {
    let id = 0;
    function onToast(e: Event) {
      const { text, kind } = (e as CustomEvent<{ text: string; kind: Toast["kind"] }>).detail;
      const t = { id: ++id, text, kind };
      setItems((xs) => [...xs.slice(-2), t]);
      setTimeout(() => setItems((xs) => xs.filter((x) => x.id !== t.id)), 3200);
    }
    window.addEventListener("crm-toast", onToast);
    return () => window.removeEventListener("crm-toast", onToast);
  }, []);

  return (
    <div aria-live="polite" className="pointer-events-none fixed bottom-5 right-5 z-[60] flex flex-col items-end gap-2">
      {items.map((t) => (
        <div
          key={t.id}
          className="pointer-events-auto flex items-center gap-2.5 rounded-lg bg-gray-900 py-2.5 pl-3 pr-4 text-[13px] text-white shadow-pop toast-in"
        >
          {t.kind === "ok" ? <CircleCheck className="size-4 text-brand-300" /> : <CircleX className="size-4 text-rose-300" />}
          {t.text}
        </div>
      ))}
    </div>
  );
}
