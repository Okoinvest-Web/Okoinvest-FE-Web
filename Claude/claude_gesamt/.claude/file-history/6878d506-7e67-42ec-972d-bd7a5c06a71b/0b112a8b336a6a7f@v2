import type { DataSource } from "./source";
import { mockSource } from "./mock";
import { createErpNextSource } from "./erpnext";

let cached: DataSource | undefined;

// ERPNEXT_URL gesetzt → echte API, sonst Demo-Daten.
// Standard ist die Anmeldung je Nutzer (ERPNext-Berechtigungen greifen).
// Nur mit ERPNEXT_AUTH=token werden API-Key/Secret als gemeinsames Dienstkonto genutzt.
export function db(): DataSource {
  if (cached) return cached;
  const url = process.env.ERPNEXT_URL;
  const key = process.env.ERPNEXT_API_KEY;
  const secret = process.env.ERPNEXT_API_SECRET;
  if (!url) cached = mockSource;
  else if (process.env.ERPNEXT_AUTH === "token" && key && secret) cached = createErpNextSource({ url, auth: "token", key, secret });
  else cached = createErpNextSource({ url, auth: "user" });
  return cached;
}
''')
