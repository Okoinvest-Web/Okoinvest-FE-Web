import { Info, MapPin, Store, Sun, Zap } from "lucide-react";
import { db } from "@/lib/data";
import { isManager, requireUser } from "@/lib/auth";
import { isWithinDays, money, relative } from "@/lib/format";
import { LEAD_PRICE_TIERS } from "@/lib/leadprice";
import { COUNTRY_LABEL } from "@/lib/types";
import { Empty, PageBody, PageHeader } from "@/components/ui";
import { UnlockButton } from "@/components/UnlockButton";

export const metadata = { title: "Lead-Börse" };

// Freie Website-Anfragen: Vorschau ohne Kontaktdaten, kostenpflichtige Freischaltung durch Handelsvertreter
export default async function PoolPage() {
  const user = await requireUser();
  const manager = isManager(user);
  const [pool, myLeads] = await Promise.all([db().listPoolLeads(), db().listLeads({ limit: 500 })]);
  // Gebiete, in denen der Vertreter schon aktiv ist – dort sind Anfahrt und Empfehlungen einfacher
  const myRegions = new Set(myLeads.map((l) => l.territory).filter(Boolean));

  return (
    <>
      <PageHeader title="Lead-Börse" subtitle={`${pool.length} freie Website-Anfragen · Preis je nach Anlagengröße`} />
      <PageBody className="grid grid-cols-1 gap-6">
        {manager && (
          <div className="flex items-start gap-3 rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 text-gray-700">
            <Info className="mt-0.5 size-4 shrink-0 text-gray-500" />
            Ansicht der Vertriebsleitung: Handelsvertreter schalten diese Anfragen kostenpflichtig frei. Die Buchungen siehst du unter „Lead-Kosten“.
          </div>
        )}

        {pool.length === 0 ? (
          <Empty icon={Store}>Aktuell keine freien Anfragen. Neue Website-Leads erscheinen hier automatisch.</Empty>
        ) : (
          <div className="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
            {pool.map((p) => {
              const mine = !!p.territory && myRegions.has(p.territory);
              const summary = `${p.is_business ? "Gewerbe" : "Privat"}, ${p.kwp ? `ca. ${p.kwp.toLocaleString("de-DE")} kWp` : "Größe unbekannt"}, ${p.territory ?? COUNTRY_LABEL[p.country]}.`;
              return (
                <article key={p.name} className="flex flex-col rounded-xl border border-gray-200 bg-white p-4 shadow-xs">
                  <div className="flex items-start justify-between gap-2">
                    <div>
                      <div className="flex items-center gap-1.5 text-[12px] text-gray-500">
                        <MapPin className="size-3.5" />
                        {p.territory ?? "Region unbekannt"} · {COUNTRY_LABEL[p.country]}
                      </div>
                      <div className="mt-1 text-[20px] font-semibold tracking-[-0.02em] text-gray-900">
                        {p.kwp ? `${p.kwp.toLocaleString("de-DE")} kWp` : "PV-Anfrage"}
                      </div>
                    </div>
                    <div className="flex flex-col items-end gap-1">
                      {isWithinDays(p.creation, 1) && <span className="rounded bg-brand-50 px-1.5 py-0.5 text-[11px] font-medium text-brand-700">Neu</span>}
                      {mine && !manager && <span className="rounded bg-sky-50 px-1.5 py-0.5 text-[11px] font-medium text-sky-700">In deinem Gebiet</span>}
                    </div>
                  </div>
                  <div className="mt-3 flex flex-wrap gap-1.5">
                    <span className="inline-flex h-[22px] items-center gap-1 rounded-md border border-gray-200 px-1.5 text-[12px] text-gray-700">
                      {p.is_business ? <Store className="size-3" /> : <Sun className="size-3" />}
                      {p.is_business ? "Gewerbe" : "Privat"}
                    </span>
                    {p.interests.map((i) => (
                      <span key={i} className="inline-flex h-[22px] items-center gap-1 rounded-md border border-gray-200 px-1.5 text-[12px] text-gray-700">
                        <Zap className="size-3 text-amber-500" /> {i}
                      </span>
                    ))}
                  </div>
                  <div className="mt-3 text-[12px] text-gray-500">
                    Anfrage {relative(p.creation)} über {p.source ?? "Website"}
                  </div>
                  <div className="mt-4 border-t border-gray-100 pt-4">
                    {manager ? (
                      <div className="flex items-baseline justify-between text-gray-600">
                        Preis <span className="tnum text-[16px] font-semibold text-gray-900">{money(p.price)}</span>
                      </div>
                    ) : (
                      <UnlockButton name={p.name} price={p.price} summary={summary} />
                    )}
                  </div>
                </article>
              );
            })}
          </div>
        )}

        <section className="rounded-xl border border-gray-200">
          <h2 className="border-b border-gray-150 px-4 py-2.5 font-semibold text-gray-900">Preise je Anlagengröße</h2>
          <table className="w-full text-left">
            <thead>
              <tr className="text-[12px] text-gray-500">
                <th className="px-4 py-2 font-medium">Anlage</th>
                <th className="px-4 py-2 text-right font-medium">Privat</th>
                <th className="px-4 py-2 text-right font-medium">Gewerbe</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-gray-100">
              {LEAD_PRICE_TIERS.map((t) => (
                <tr key={t.label}>
                  <td className="px-4 py-2">{t.label}</td>
                  <td className="tnum px-4 py-2 text-right">{money(t.privat)}</td>
                  <td className="tnum px-4 py-2 text-right">{money(t.gewerbe)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      </PageBody>
    </>
  );
}
