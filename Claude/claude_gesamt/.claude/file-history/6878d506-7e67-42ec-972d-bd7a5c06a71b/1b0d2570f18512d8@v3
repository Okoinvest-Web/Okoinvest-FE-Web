@import "tailwindcss";

/*
  Ökovolt Designsystem
  - Warme Neutraltöne statt kaltem Grau, Grün nur als Akzent
  - Haarlinien statt Schatten, 13px Grundschrift, Tabellenziffern für Beträge
*/
@theme inline {
  --font-sans: var(--font-geist), ui-sans-serif, system-ui, sans-serif;
  --font-mono: var(--font-geist-mono), ui-monospace, monospace;

  /* Neutral (warm) – überschreibt Tailwinds gray */
  --color-gray-25: #fcfcfb;
  --color-gray-50: #f8f8f6;
  --color-gray-100: #f1f1ee;
  --color-gray-150: #eaeae6;
  --color-gray-200: #e3e3de;
  --color-gray-300: #d1d1cb;
  --color-gray-400: #a3a39c;
  --color-gray-500: #7a7a73;
  --color-gray-600: #5c5c56;
  --color-gray-700: #42423d;
  --color-gray-800: #2b2b27;
  --color-gray-900: #1c1c19;
  --color-gray-950: #111110;

  /* Markengrün */
  --color-brand-50: #eff8f2;
  --color-brand-100: #d9efe1;
  --color-brand-200: #b4dec5;
  --color-brand-300: #82c5a0;
  --color-brand-400: #4fa77a;
  --color-brand-500: #2b8a5e;
  --color-brand-600: #1d704b;
  --color-brand-700: #185b3e;
  --color-brand-800: #154933;
  --color-brand-900: #123c2b;
  --color-brand-950: #082418;

  --color-sun-300: #fcd34d;
  --color-sun-400: #fbbf24;
  --color-sun-500: #f59e0b;

  --shadow-card: 0 0 0 0 transparent;
  --shadow-xs: 0 1px 1px 0 rgb(28 28 25 / 0.04);
  --shadow-btn: 0 1px 2px 0 rgb(28 28 25 / 0.06), inset 0 -1px 0 0 rgb(28 28 25 / 0.04);
  --shadow-pop: 0 0 0 1px rgb(28 28 25 / 0.06), 0 16px 40px -12px rgb(28 28 25 / 0.25), 0 4px 12px -4px rgb(28 28 25 / 0.08);
  --shadow-lift: 0 0 0 1px rgb(28 28 25 / 0.05), 0 4px 12px -4px rgb(28 28 25 / 0.12);
}

:root {
  color-scheme: light;
}

html {
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

body {
  background: #ffffff;
  color: var(--color-gray-900);
  font-feature-settings: "ss01", "cv11";
  letter-spacing: -0.003em;
}

.tnum {
  font-variant-numeric: tabular-nums;
}

::selection {
  background: var(--color-brand-100);
}

* {
  scrollbar-width: thin;
  scrollbar-color: var(--color-gray-200) transparent;
}

:focus-visible {
  outline: 2px solid var(--color-brand-500);
  outline-offset: 2px;
}
