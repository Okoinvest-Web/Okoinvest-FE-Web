import Link from "next/link";
import { AlertTriangle, ArrowRight, CircleCheck, Flame, Lightbulb, Snowflake, Sparkles, ThermometerSun } from "lucide-react";
import type { DealHealth, Hint, LeadScore, Level } from "@/lib/insights";

const GRADE = {
  Heiß: { icon: Flame, cls: "text-rose-600", bar: "bg-rose-500" },
  Warm: { icon: ThermometerSun, cls: "text-amber-600", bar: "bg-amber-500" },
  Kalt: { icon: Snowflake, cls: "text-sky-600", bar: "bg-sky-400" },
};

// Neutraler Chip: Symbol + Stufe + Wert; Begründung im Tooltip
export function ScoreBadge({ s, withValue = true }: { s: LeadScore; withValue?: boolean }) {
  const g = GRADE[s.grade];
  return (
    <span
      title={s.reasons.join("\n")}
      className="inline-flex h-[22px] cursor-help items-center gap-1 whitespace-nowrap rounded-md border border-gray-200 bg-white px-1.5 text-[12px] font-medium text-gray-700"
    >
      <g.icon className={`size-3 ${g.cls}`} strokeWidth={2.25} />
      {s.grade}
      {withValue && <span className="tnum text-gray-400">{s.score}</span>}
    </span>
  );
}

// Score im Eigenschaftenpanel: Wert, Balken, Begründung
export function ScorePanel({ s }: { s: LeadScore }) {
  const g = GRADE[s.grade];
  return (
    <div>
      <div className="flex items-center justify-between">
        <span className="flex items-center gap-1.5 text-[12px] font-medium text-gray-500">
          <Sparkles className="size-3.5 text-gray-400" /> Lead-Score
        </span>
        <ScoreBadge s={s} withValue={false} />
      </div>
      <div className="mt-2 flex items-baseline gap-1">
        <span className="tnum text-[28px] font-semibold leading-none tracking-[-0.02em]">{s.score}</span>
        <span className="text-gray-400">/ 100</span>
      </div>
      <div className="mt-3 h-1 overflow-hidden rounded-full bg-gray-150">
        <div className={`h-full rounded-full ${g.bar}`} style={{ width: `${s.score}%` }} />
      </div>
      <ul className="mt-3 grid gap-1 text-[12px]">
        {s.reasons.map((r) => {
          const [pts, ...rest] = r.split(" ");
          return (
            <li key={r} className="flex gap-2">
              <span className={`tnum w-7 shrink-0 text-right font-medium ${pts.startsWith("−") ? "text-rose-600" : "text-gray-900"}`}>{pts}</span>
              <span className="text-gray-500">{rest.join(" ")}</span>
            </li>
          );
        })}
      </ul>
    </div>
  );
}

const LEVEL = {
  risk: { icon: AlertTriangle, cls: "text-rose-600" },
  warn: { icon: Lightbulb, cls: "text-amber-600" },
  good: { icon: CircleCheck, cls: "text-brand-600" },
};

export function HintList({ hints }: { hints: Hint[] }) {
  return (
    <ul className="divide-y divide-gray-100">
      {hints.map((h) => {
        const l = LEVEL[h.level];
        return (
          <li key={h.text} className="flex items-start gap-3 px-4 py-2.5">
            <l.icon className={`mt-0.5 size-3.5 shrink-0 ${l.cls}`} strokeWidth={2.25} />
            <span className="flex-1 text-gray-700">{h.text}</span>
            {h.action && (
              <Link href={h.action.href} className="inline-flex shrink-0 items-center gap-1 font-medium text-brand-700 hover:text-brand-800">
                {h.action.label} <ArrowRight className="size-3.5" />
              </Link>
            )}
          </li>
        );
      })}
    </ul>
  );
}

// Empfehlungskasten: dezent getönt, damit er sich vom Inhalt abhebt, ohne zu schreien
export function NextSteps({ hints, title = "Empfohlene nächste Schritte" }: { hints: Hint[]; title?: string }) {
  return (
    <section className="overflow-hidden rounded-xl border border-gray-200 bg-gray-25">
      <div className="flex h-10 items-center gap-2 border-b border-gray-150 px-4">
        <Sparkles className="size-3.5 text-brand-600" />
        <h2 className="text-[13px] font-semibold text-gray-900">{title}</h2>
        <span className="text-[12px] text-gray-500">{hints.length ? `${hints.length} Punkte` : "Alles erledigt"}</span>
      </div>
      {hints.length === 0 ? (
        <div className="flex items-center gap-2 px-4 py-3 text-gray-600">
          <CircleCheck className="size-3.5 text-brand-600" /> Keine offenen Punkte.
        </div>
      ) : (
        <HintList hints={hints} />
      )}
    </section>
  );
}

const DOT: Record<Level, string> = { good: "bg-brand-500", warn: "bg-amber-500", risk: "bg-rose-500" };
const HEALTH_LABEL: Record<Level, string> = { good: "Auf Kurs", warn: "Beobachten", risk: "Gefährdet" };

export function HealthDot({ h }: { h: DealHealth }) {
  return (
    <span
      title={`${HEALTH_LABEL[h.level]}${h.hints.length ? "\n• " + h.hints.map((x) => x.text).join("\n• ") : ""}`}
      className="inline-flex cursor-help items-center gap-1.5 whitespace-nowrap text-[12px] text-gray-600"
    >
      <span className={`size-1.5 rounded-full ${DOT[h.level]}`} />
      {HEALTH_LABEL[h.level]}
    </span>
  );
}
