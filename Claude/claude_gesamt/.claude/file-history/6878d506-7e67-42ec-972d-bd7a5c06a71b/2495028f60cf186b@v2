const itemOf = (code: string) => ITEMS.find((i) => i.item_code === code)!;

export function lines(spec: [string, number][]): QuoteItem[] {
  return spec.map(([code, qty]) => {
    const it = itemOf(code);
    return { item_code: code, item_name: it.item_name, qty, rate: it.rate, amount: Math.round(qty * it.rate * 100) / 100, uom: it.stock_uom };
  });
}

type Dates = { d: (daysAgo: number) => string; day: (daysAhead: number) => string };

function quote(q: Omit<Quotation, "net_total" | "total_taxes_and_charges" | "grand_total" | "currency">): Quotation {
  const t = calcTotals(q.items, q.tax_rate);
  return { ...q, currency: "EUR", net_total: t.net, total_taxes_and_charges: t.tax, grand_total: t.gross };
}

