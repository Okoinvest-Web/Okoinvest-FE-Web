// ---------- Angebote ----------

type QuoteLine = { item_code: string; qty: number; rate: number };

export async function createQuotationAction(_prev: FormState, form: FormData): Promise<FormState> {
  const user = await requireUser();
  const oppName = str(form, "opportunity");
  const opp = oppName ? await db().getOpportunity(oppName) : null;
  if (!opp) return { error: "Chance nicht gefunden." };

  let lines: QuoteLine[];
  try {
    lines = JSON.parse(str(form, "items") || "[]");
  } catch {
    return { error: "Positionen sind ungültig." };
  }
  if (!Array.isArray(lines) || lines.length === 0) return { error: "Bitte mindestens eine Position hinzufügen." };
  if (lines.length > 100) return { error: "Zu viele Positionen." };

  // Nur Artikel aus dem Katalog, Mengen und Preise plausibel
  const catalog = new Map((await db().listItems({ limit: 1000 })).map((i) => [i.item_code, i]));
  for (const l of lines) {
    if (!catalog.has(l.item_code)) return { error: `Unbekannter Artikel: ${String(l.item_code).slice(0, 40)}` };
    if (!(typeof l.qty === "number" && l.qty > 0 && l.qty <= 100000)) return { error: "Menge ist ungültig." };
    if (!(typeof l.rate === "number" && l.rate >= 0 && l.rate <= 10_000_000)) return { error: "Preis ist ungültig." };
  }

  const country = (str(form, "country") || "Germany") as Country;
  if (!COUNTRIES.includes(country)) return { error: "Ungültiges Land." };
  const taxRate = Number(str(form, "tax_rate"));
  if (!TAX_OPTIONS[country].some((t) => t.rate === taxRate)) return { error: "Ungültiger Steuersatz." };
  const validTill = str(form, "valid_till");
  if (!DATE.test(validTill)) return { error: "Bitte ein gültiges Datum für „gültig bis“ wählen." };

  const q = await db().createQuotation(
    {
      quotation_to: opp.opportunity_from,
      party_name: opp.party_name,
      opportunity: opp.name,
      title: str(form, "title").slice(0, 140) || opp.title,
      valid_till: validTill,
      tax_rate: taxRate,
      items: lines.map((l) => ({ item_code: l.item_code, qty: l.qty, rate: l.rate })),
    },
    user.user,
  );
  revalidatePath("/", "layout");
  redirect(`/quotations/${encodeURIComponent(q.name)}`);
}

// ---------- Lead-Börse ----------

// Kostenpflichtige Freischaltung: Preis und Verfügbarkeit prüft ausschließlich der Server
export async function unlockLeadAction(name: string): Promise<FormState> {
  const user = await requireUser();
  if (user.role !== "agent") return { error: "Nur Handelsvertreter können Leads freischalten." };
  if (!/^[\w\- .]{1,80}$/.test(name)) return { error: "Ungültiger Lead." };
  let charge;
  try {
    charge = await db().unlockLead(name);
  } catch (e) {
    return { error: e instanceof Error ? e.message : "Freischaltung fehlgeschlagen." };
  }
  revalidatePath("/", "layout");
  redirect(`/leads/${encodeURIComponent(charge.lead)}?freigeschaltet=${charge.amount}`);
}

// ---------- E-Mail-Vorlagen ----------

// Versand über das eigene Mailprogramm; hier wird nur die Aktivität protokolliert
export async function logEmailAction(doctype: string, name: string, templateId: string, subject: string): Promise<FormState> {
  const user = await requireUser();
  if (!NOTE_DOCTYPES.includes(doctype)) return { error: "Ungültiger Bezug." };
  const t = EMAIL_TEMPLATES.find((x) => x.id === templateId);
  if (!t) return { error: "Unbekannte Vorlage." };
  await db().addNote(doctype, name, encodeActivity("mail", "Gesendet", `Vorlage „${t.label}“: ${subject.slice(0, 200)}`), user);
  // Erster Kontakt per E-Mail: neuer Lead wird "Offen"
  if (doctype === "Lead") {
    const lead = await db().getLead(name);
    if (lead?.status === "Lead") await db().setLeadStatus(name, "Open");
  }
  revalidatePath("/", "layout");
  return {};
}
