"use client";

import { useState } from "react";
import { Calculator, FileText, Info } from "lucide-react";
import { BTN, Card, CardHeader, INPUT } from "@/components/ui";
import { money } from "@/lib/format";
import { calcPv, pvDefaults, YIELD, type PvInput } from "@/lib/pv";

function Num({ label, value, onChange, step = 1, suffix }: { label: string; value: number; onChange: (v: number) => void; step?: number; suffix: string }) {
  return (
    <label className="flex flex-col gap-1">
      <span className="text-[12px] font-medium text-gray-500">{label}</span>
      <div className="relative">
        <input
          type="number"
          min={0}
          step={step}
          value={Number.isFinite(value) ? value : 0}
          onChange={(e) => onChange(parseFloat(e.target.value) || 0)}
          className={`${INPUT} w-full pr-14 tabular-nums`}
        />
        <span className="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-xs text-gray-400">{suffix}</span>
      </div>
    </label>
  );
}

// sheetHref: Basis-URL des Kundenblatts; die aktuellen Eingaben werden als Parameter angehängt
export function PvCalculator({
  kwp,
  storage,
  invest,
  country,
  sheetHref,
}: {
  kwp?: number;
  storage?: number;
  invest?: number;
  country?: "Germany" | "Austria";
  sheetHref?: string;
}) {
  const [v, setV] = useState<PvInput>(() => pvDefaults(kwp, storage, invest, country));
  const set = (k: keyof PvInput) => (n: number) => setV((s) => ({ ...s, [k]: n }));

  const r = calcPv(v);
  const fmt = (n: number, d = 0) => new Intl.NumberFormat("de-DE", { maximumFractionDigits: d }).format(n);
  const sheet = sheetHref ? `${sheetHref}?${new URLSearchParams(Object.entries(v).map(([k, n]) => [k, String(n)]))}` : undefined;

  return (
    <Card className="overflow-hidden">
      <CardHeader
        title="PV-Schnellrechner"
        icon={Calculator}
        sub="Wirtschaftlichkeit fürs Kundengespräch"
        action={
          sheet && (
            <a href={sheet} target="_blank" rel="noreferrer" className={BTN.secondary}>
              <FileText /> Kundenblatt
            </a>
          )
        }
      />
      <div className="grid gap-3 p-4 sm:grid-cols-3">
        <Num label="Anlagengröße" value={v.kwp} onChange={set("kwp")} step={0.1} suffix="kWp" />
        <Num label="Speicher" value={v.storage} onChange={set("storage")} step={0.5} suffix="kWh" />
        <Num label="Verbrauch / Jahr" value={v.use} onChange={set("use")} step={100} suffix="kWh" />
        <Num label="Strompreis" value={v.price} onChange={set("price")} step={0.5} suffix="ct/kWh" />
        <Num label="Einspeisevergütung" value={v.feed} onChange={set("feed")} step={0.1} suffix="ct/kWh" />
        <Num label="Investition" value={v.invest} onChange={set("invest")} step={500} suffix="EUR" />
      </div>
      <div className="grid grid-cols-2 gap-px border-t border-gray-150 bg-gray-150 sm:grid-cols-4">
        {[
          { l: "Ertrag / Jahr", v: `${fmt(r.prod)} kWh` },
          { l: "Autarkiegrad", v: `${fmt(r.autarky * 100)} %`, sub: `Eigenverbrauch ${fmt(r.selfShare * 100)} %` },
          { l: "Ersparnis / Jahr", v: money(r.saving), accent: true },
          { l: "Amortisation", v: Number.isFinite(r.payback) ? `${fmt(r.payback, 1)} Jahre` : "–" },
        ].map((x) => (
          <div key={x.l} className="bg-white px-4 py-3">
            <div className="text-[12px] text-gray-500">{x.l}</div>
            <div className={`mt-0.5 text-lg font-semibold tabular-nums ${x.accent ? "text-brand-700" : "text-gray-900"}`}>{x.v}</div>
            {x.sub && <div className="text-xs text-gray-500">{x.sub}</div>}
          </div>
        ))}
      </div>
      <div className="flex flex-wrap items-center justify-between gap-2 border-t border-gray-150 bg-gray-25 px-4 py-2.5 text-[12px]">
        <span className="text-gray-600">
          <strong className="font-semibold">{fmt(r.co2, 1)} t CO₂</strong> weniger pro Jahr · Überschuss nach 20 Jahren{" "}
          <strong className="font-semibold">{money(r.over20)}</strong>
        </span>
        <span className="inline-flex items-center gap-1 text-gray-500">
          <Info className="size-3.5" /> Richtwerte ({fmt(YIELD)} kWh/kWp), keine Ertragsprognose
        </span>
      </div>
    </Card>
  );
}
