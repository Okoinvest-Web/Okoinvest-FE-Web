import Link from "next/link";
import { Columns3, List, Plus } from "lucide-react";
import { db } from "@/lib/data";
import { OPPORTUNITY_STAGES } from "@/lib/types";
import { LEAD_STATUS_LABEL, date, money, STAGE_LABEL } from "@/lib/format";
import { Avatar, Badge, ButtonLink, Card, PageBody, PageHeader, Progress, Table, TD } from "@/components/ui";
import { Kanban } from "@/components/Kanban";
import { HealthDot } from "@/components/Insights";
import { dealHealth } from "@/lib/insights";

export const metadata = { title: "Chancen" };

export default async function OpportunitiesPage({ searchParams }: PageProps<"/opportunities">) {
  const view = (await searchParams).view === "list" ? "list" : "kanban";
  const [all, todos] = await Promise.all([db().listOpportunities(), db().listToDos({ limit: 1000 })]);
  const health = Object.fromEntries(all.map((o) => [o.name, dealHealth(o, todos)]));
  const atRisk = Object.values(health).filter((h) => h.level === "risk").length;
  const open = all.filter((o) => o.status === "Open" || o.status === "Quotation");
  const pipeline = open.reduce((s, o) => s + o.opportunity_amount, 0);
  const weighted = open.reduce((s, o) => s + (o.opportunity_amount * o.probability) / 100, 0);

  const tab = (v: string, label: string, Icon: typeof List) => (
    <Link
      href={v === "kanban" ? "/opportunities" : "/opportunities?view=list"}
      className={`inline-flex items-center gap-1.5 rounded-md px-2.5 py-1.5 text-sm transition ${
        view === v ? "bg-white font-medium text-gray-900 shadow-sm ring-1 ring-gray-200" : "text-gray-600 hover:text-gray-900"
      }`}
    >
      <Icon className="size-4" /> {label}
    </Link>
  );

  return (
    <>
      <PageHeader
        title="Chancen"
        subtitle={
          <>
            {open.length} offen · <span className="font-medium text-gray-700">{money(pipeline)}</span> Pipeline ·{" "}
            <span className="font-medium text-gray-700">{money(weighted)}</span> gewichtet
            {atRisk > 0 && <span className="font-medium text-rose-600"> · {atRisk} gefährdet</span>}
          </>
        }
        actions={
          <>
            <div className="flex gap-1 rounded-lg bg-gray-100 p-1">
              {tab("kanban", "Kanban", Columns3)}
              {tab("list", "Liste", List)}
            </div>
            <ButtonLink href="/opportunities/new">
              <Plus className="size-4" /> Neue Chance
            </ButtonLink>
          </>
        }
      />
      {view === "kanban" ? (
        <Kanban stages={OPPORTUNITY_STAGES} items={open} health={health} />
      ) : (
        <PageBody>
          <Card className="overflow-hidden">
            <Table head={["Titel", "Phase", "Status", "Zustand", "Betrag", "Wahrscheinlichkeit", "Abschluss", "Berater"]} align={{ 4: "right" }}>
              {all.map((o) => (
                <tr key={o.name} className="transition-colors hover:bg-brand-50/40">
                  <td className="px-5 py-3">
                    <Link href={`/opportunities/${encodeURIComponent(o.name)}`} className="group block">
                      <div className="font-medium text-gray-900 group-hover:text-brand-700">{o.title ?? o.name}</div>
                      <div className="text-xs text-gray-500">{o.customer_name ?? o.party_name}</div>
                    </Link>
                  </td>
                  <td className={TD}>{STAGE_LABEL[o.sales_stage] ?? o.sales_stage}</td>
                  <td className={TD}>
                    <Badge value={o.status} label={LEAD_STATUS_LABEL[o.status]} />
                  </td>
                  <td className={TD}>{(o.status === "Open" || o.status === "Quotation") && <HealthDot h={health[o.name]} />}</td>
                  <td className={`${TD} text-right font-semibold tabular-nums text-gray-900`}>{money(o.opportunity_amount, o.currency)}</td>
                  <td className={TD}>
                    <div className="flex items-center gap-2">
                      <Progress value={o.probability} className="w-20" />
                      <span className="tabular-nums">{o.probability} %</span>
                    </div>
                  </td>
                  <td className={`${TD} whitespace-nowrap`}>{date(o.expected_closing)}</td>
                  <td className={TD}>{o.opportunity_owner && <Avatar name={o.opportunity_owner} />}</td>
                </tr>
              ))}
            </Table>
          </Card>
        </PageBody>
      )}
    </>
  );
}
