import Link from "next/link";
import { connection } from "next/server";
import { ArrowUpRight, CalendarCheck2, Flame, ShieldAlert, Sparkles, CheckSquare, Handshake, Plus, TrendingUp, UserPlus, Users, Wallet } from "lucide-react";
import { db } from "@/lib/data";
import { requireUser } from "@/lib/auth";
import { OPPORTUNITY_STAGES } from "@/lib/types";
import { daysUntil, greeting, isWithinDays, LEAD_STATUS_LABEL, longDate, money, relative, STAGE_LABEL } from "@/lib/format";
import { Avatar, Badge, BTN, ButtonLink, Card, CardHeader, PageBody, PageHeader, Progress, Stat } from "@/components/ui";
import { TodoList } from "@/components/TodoList";
import { HealthDot, ScoreBadge } from "@/components/Insights";
import { dealHealth, scoreLead } from "@/lib/insights";

export const metadata = { title: "Übersicht" };

const STAGE_COLOR = ["bg-brand-200", "bg-brand-300", "bg-brand-400", "bg-brand-500", "bg-brand-700"];

export default async function Dashboard() {
  await connection();
  const user = await requireUser();
  const [leads, opps, todos] = await Promise.all([db().listLeads(), db().listOpportunities(), db().listToDos({ filters: { status: "Open" } })]);

  const open = opps.filter((o) => o.status === "Open" || o.status === "Quotation");
  const pipeline = open.reduce((s, o) => s + o.opportunity_amount, 0);
  const weighted = open.reduce((s, o) => s + (o.opportunity_amount * o.probability) / 100, 0);
  const avgProb = open.length ? Math.round(open.reduce((s, o) => s + o.probability, 0) / open.length) : 0;
  const newLeads = leads.filter((l) => isWithinDays(l.creation, 14)).length;
  const uncontacted = leads.filter((l) => l.status === "Lead").length;
  const quotes = open.filter((o) => o.status === "Quotation").length;

  const stages = OPPORTUNITY_STAGES.map((s) => {
    const col = open.filter((o) => o.sales_stage === s);
    return { stage: s, count: col.length, sum: col.reduce((a, o) => a + o.opportunity_amount, 0) };
  });
  const maxStage = Math.max(1, ...stages.map((s) => s.sum));

  const closing = open
    .filter((o) => {
      const n = daysUntil(o.expected_closing);
      return n !== undefined && n <= 45;
    })
    .sort((a, b) => (a.expected_closing ?? "").localeCompare(b.expected_closing ?? ""))
    .slice(0, 5);

  const dueTodos = [...todos].sort((a, b) => (a.date ?? "9999").localeCompare(b.date ?? "9999")).slice(0, 6);
  const overdue = todos.filter((t) => (daysUntil(t.date) ?? 1) < 0).length;
  const firstName = user.fullName.split(" ")[0];
  const refLabels = Object.fromEntries([...leads.map((l) => [l.name, l.lead_name]), ...opps.map((o) => [o.name, o.title ?? o.name])]);

  // Fokus: heiße, noch offene Leads und gefährdete Chancen – nach Hebel sortiert
  const hotLeads = leads
    .filter((l) => ["Lead", "Open", "Replied", "Interested"].includes(l.status))
    .map((l) => ({ l, s: scoreLead(l) }))
    .filter((x) => x.s.score >= 55)
    .sort((a, b) => b.s.score - a.s.score)
    .slice(0, 4);
  const risky = open
    .map((o) => ({ o, h: dealHealth(o, todos) }))
    .filter((x) => x.h.level !== "good")
    .sort((a, b) => (a.h.level === b.h.level ? b.o.opportunity_amount - a.o.opportunity_amount : a.h.level === "risk" ? -1 : 1))
    .slice(0, 4);
  const riskVolume = risky.filter((x) => x.h.level === "risk").reduce((s, x) => s + x.o.opportunity_amount, 0);

  return (
    <>
      <PageHeader
        title={`${greeting()}, ${firstName}`}
        subtitle={longDate()}
        actions={
          <>
            <ButtonLink href="/leads/new" variant="secondary">
              <UserPlus className="size-4" /> Neuer Lead
            </ButtonLink>
            <ButtonLink href="/opportunities/new">
              <Plus className="size-4" /> Neue Chance
            </ButtonLink>
          </>
        }
      />
      <PageBody className="grid gap-6">
        <div className="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
          <Stat label="Pipeline offen" value={money(pipeline)} icon={Wallet} hint={`${open.length} offene Chancen · ${quotes} im Angebot`} />
          <Stat label="Gewichtete Prognose" value={money(weighted)} icon={TrendingUp} accent="sun" hint={`Ø Abschlusswahrscheinlichkeit ${avgProb} %`} />
          <Stat label="Neue Leads (14 Tage)" value={newLeads} icon={Users} hint={`${uncontacted} noch nicht kontaktiert`} />
          <Stat
            label="Offene Aufgaben"
            value={todos.length}
            icon={CheckSquare}
            hint={overdue > 0 ? <span className="font-medium text-rose-600">{overdue} überfällig</span> : "Nichts überfällig"}
          />
        </div>

        <Card className="overflow-hidden">
          <div className="flex flex-wrap items-center justify-between gap-3 border-b border-gray-100 bg-linear-to-r from-brand-900 to-brand-700 px-5 py-4 text-white">
            <div className="flex items-center gap-3">
              <span className="flex size-9 items-center justify-center rounded-lg bg-white/10 ring-1 ring-white/15">
                <Sparkles className="size-[18px] text-sun-300" />
              </span>
              <div>
                <h2 className="font-semibold">Fokus heute</h2>
                <p className="text-xs text-brand-200">Automatisch priorisiert nach Lead-Score und Deal-Risiko</p>
              </div>
            </div>
            {riskVolume > 0 && (
              <span className="rounded-full bg-rose-500/20 px-3 py-1 text-xs font-medium text-rose-100 ring-1 ring-rose-300/30">
                {money(riskVolume)} Pipeline gefährdet
              </span>
            )}
          </div>
          <div className="grid divide-y divide-gray-100 lg:grid-cols-2 lg:divide-x lg:divide-y-0">
            <div>
              <div className="flex items-center gap-2 px-5 pb-1 pt-4 text-xs font-semibold uppercase tracking-wider text-gray-500">
                <Flame className="size-3.5 text-rose-500" /> Heiße Leads jetzt anrufen
              </div>
              {hotLeads.length === 0 ? (
                <p className="px-5 py-6 text-gray-500">Keine heißen Leads offen.</p>
              ) : (
                <ul>
                  {hotLeads.map(({ l, s }) => (
                    <li key={l.name}>
                      <Link href={`/leads/${encodeURIComponent(l.name)}`} className="flex items-center gap-3 px-5 py-2.5 transition-colors hover:bg-gray-50/70">
                        <Avatar name={l.lead_name} size="md" />
                        <div className="min-w-0 flex-1">
                          <div className="truncate font-medium text-gray-900">{l.lead_name}</div>
                          <div className="truncate text-xs text-gray-500">
                            {l.source ?? "–"} · {relative(l.creation)}
                          </div>
                        </div>
                        <ScoreBadge s={s} />
                      </Link>
                    </li>
                  ))}
                </ul>
              )}
            </div>
            <div>
              <div className="flex items-center gap-2 px-5 pb-1 pt-4 text-xs font-semibold uppercase tracking-wider text-gray-500">
                <ShieldAlert className="size-3.5 text-amber-500" /> Chancen mit Handlungsbedarf
              </div>
              {risky.length === 0 ? (
                <p className="px-5 py-6 text-gray-500">Alle Chancen auf Kurs.</p>
              ) : (
                <ul>
                  {risky.map(({ o, h }) => (
                    <li key={o.name}>
                      <Link href={`/opportunities/${encodeURIComponent(o.name)}`} className="flex items-center gap-3 px-5 py-2.5 transition-colors hover:bg-gray-50/70">
                        <div className="min-w-0 flex-1">
                          <div className="truncate font-medium text-gray-900">{o.title}</div>
                          <div className="truncate text-xs text-gray-500">{h.hints[0]?.text}</div>
                        </div>
                        <div className="flex flex-col items-end gap-0.5">
                          <span className="font-semibold tabular-nums text-gray-900">{money(o.opportunity_amount)}</span>
                          <HealthDot h={h} />
                        </div>
                      </Link>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        </Card>

        <div className="grid gap-6 xl:grid-cols-[1.6fr_1fr]">
          <Card>
            <CardHeader
              title="Pipeline nach Phase"
              icon={Handshake}
              sub="Offene Chancen, Volumen in EUR"
              action={
                <Link href="/opportunities" className={BTN.ghost}>
                  Kanban öffnen <ArrowUpRight className="size-3.5" />
                </Link>
              }
            />
            <div className="grid gap-4 p-5">
              {stages.map((s, i) => (
                <div key={s.stage} className="grid grid-cols-[130px_1fr_110px] items-center gap-4">
                  <div>
                    <div className="font-medium text-gray-800">{STAGE_LABEL[s.stage]}</div>
                    <div className="text-xs text-gray-500">{s.count} {s.count === 1 ? "Chance" : "Chancen"}</div>
                  </div>
                  <div className="h-2 overflow-hidden rounded-full bg-gray-100">
                    <div className={`h-full rounded-full ${STAGE_COLOR[i]}`} style={{ width: `${Math.max(s.sum ? 2 : 0, (s.sum / maxStage) * 100)}%` }} />
                  </div>
                  <span className="text-right font-semibold tabular-nums text-gray-900">{money(s.sum)}</span>
                </div>
              ))}
              <div className="mt-1 flex items-center justify-between border-t border-gray-100 pt-4 text-sm">
                <span className="text-gray-500">Summe offen</span>
                <span className="font-semibold tabular-nums text-gray-900">{money(pipeline)}</span>
              </div>
            </div>
          </Card>

          <Card>
            <CardHeader title="Anstehende Abschlüsse" icon={CalendarCheck2} sub="Nächste 45 Tage" />
            {closing.length === 0 ? (
              <p className="px-5 py-8 text-center text-gray-500">Keine Abschlüsse in Sicht.</p>
            ) : (
              <ul className="divide-y divide-gray-100">
                {closing.map((o) => {
                  const n = daysUntil(o.expected_closing) ?? 0;
                  return (
                    <li key={o.name}>
                      <Link href={`/opportunities/${encodeURIComponent(o.name)}`} className="flex items-center gap-3 px-5 py-3 transition-colors hover:bg-gray-50/70">
                        <div className={`flex w-12 shrink-0 flex-col items-center rounded-lg py-1 ${n < 0 ? "bg-rose-50 text-rose-700" : n <= 14 ? "bg-amber-50 text-amber-700" : "bg-gray-100 text-gray-600"}`}>
                          <span className="text-base font-semibold leading-none tabular-nums">{Math.abs(n)}</span>
                          <span className="mt-0.5 text-[10px] font-medium">{n < 0 ? "T über" : "Tage"}</span>
                        </div>
                        <div className="min-w-0 flex-1">
                          <div className="truncate font-medium text-gray-900">{o.title}</div>
                          <div className="truncate text-xs text-gray-500">{o.customer_name ?? o.party_name}</div>
                          <Progress value={o.probability} className="mt-1.5 w-24" />
                        </div>
                        <div className="text-right">
                          <div className="font-semibold tabular-nums text-gray-900">{money(o.opportunity_amount, o.currency)}</div>
                          <div className="text-xs text-gray-500">{o.probability} %</div>
                        </div>
                      </Link>
                    </li>
                  );
                })}
              </ul>
            )}
          </Card>
        </div>

        <div className="grid gap-6 xl:grid-cols-2">
          <Card>
            <CardHeader
              title="Meine nächsten Aufgaben"
              icon={CheckSquare}
              action={
                <Link href="/todos" className={BTN.ghost}>
                  Alle <ArrowUpRight className="size-3.5" />
                </Link>
              }
            />
            <TodoList todos={dueTodos} showRef refLabels={refLabels} empty="Keine offenen Aufgaben – stark!" />
          </Card>

          <Card>
            <CardHeader
              title="Zuletzt aktive Leads"
              icon={Users}
              action={
                <Link href="/leads" className={BTN.ghost}>
                  Alle <ArrowUpRight className="size-3.5" />
                </Link>
              }
            />
            <ul className="divide-y divide-gray-100">
              {leads.slice(0, 6).map((l) => (
                <li key={l.name}>
                  <Link href={`/leads/${encodeURIComponent(l.name)}`} className="flex items-center gap-3 px-5 py-3 transition-colors hover:bg-gray-50/70">
                    <Avatar name={l.lead_name} size="md" />
                    <div className="min-w-0 flex-1">
                      <div className="truncate font-medium text-gray-900">{l.lead_name}</div>
                      <div className="truncate text-xs text-gray-500">{l.company_name ?? l.territory ?? "–"}</div>
                    </div>
                    <Badge value={l.status} label={LEAD_STATUS_LABEL[l.status]} />
                    <span className="hidden w-24 text-right text-xs text-gray-500 sm:block">{relative(l.modified)}</span>
                  </Link>
                </li>
              ))}
            </ul>
          </Card>
        </div>
      </PageBody>
    </>
  );
}
