import Link from "next/link";
import { connection } from "next/server";
import { ArrowRight, Flame, Plus, ShieldAlert, UserPlus } from "lucide-react";
import { db } from "@/lib/data";
import { requireUser } from "@/lib/auth";
import { OPPORTUNITY_STAGES } from "@/lib/types";
import { daysUntil, greeting, isWithinDays, LEAD_STATUS_LABEL, longDate, money, relative, STAGE_LABEL } from "@/lib/format";
import { dealHealth, scoreLead, weekly } from "@/lib/insights";
import { Avatar, Badge, BTN, ButtonLink, Card, CardHeader, PageBody, PageHeader, Stat, StatBand } from "@/components/ui";
import { HealthDot, ScoreBadge } from "@/components/Insights";
import { TodoList } from "@/components/TodoList";

export const metadata = { title: "Übersicht" };

const MONTH = new Intl.DateTimeFormat("de-DE", { month: "short" });

export default async function Dashboard() {
  await connection();
  const user = await requireUser();
  const [leads, opps, todos] = await Promise.all([db().listLeads(), db().listOpportunities(), db().listToDos({ filters: { status: "Open" } })]);

  const open = opps.filter((o) => o.status === "Open" || o.status === "Quotation");
  const pipeline = open.reduce((s, o) => s + o.opportunity_amount, 0);
  const weighted = open.reduce((s, o) => s + (o.opportunity_amount * o.probability) / 100, 0);
  const avgProb = open.length ? Math.round(open.reduce((s, o) => s + o.probability, 0) / open.length) : 0;
  const newLeads = leads.filter((l) => isWithinDays(l.creation, 14)).length;
  const uncontacted = leads.filter((l) => l.status === "Lead").length;
  const overdue = todos.filter((t) => (daysUntil(t.date) ?? 1) < 0).length;

  const leadSeries = weekly(leads, (l) => l.creation);
  const volSeries = weekly(opps, (o) => o.creation, (o) => o.opportunity_amount);

  const stages = OPPORTUNITY_STAGES.map((s) => {
    const col = open.filter((o) => o.sales_stage === s);
    return { stage: s, count: col.length, sum: col.reduce((a, o) => a + o.opportunity_amount, 0) };
  });
  const maxStage = Math.max(1, ...stages.map((s) => s.sum));

  const closing = open
    .filter((o) => (daysUntil(o.expected_closing) ?? 999) <= 45)
    .sort((a, b) => (a.expected_closing ?? "").localeCompare(b.expected_closing ?? ""))
    .slice(0, 5);

  const hotLeads = leads
    .filter((l) => ["Lead", "Open", "Replied", "Interested"].includes(l.status))
    .map((l) => ({ l, s: scoreLead(l) }))
    .filter((x) => x.s.score >= 55)
    .sort((a, b) => b.s.score - a.s.score)
    .slice(0, 4);
  const risky = open
    .map((o) => ({ o, h: dealHealth(o, todos) }))
    .filter((x) => x.h.level !== "good")
    .sort((a, b) => (a.h.level === b.h.level ? b.o.opportunity_amount - a.o.opportunity_amount : a.h.level === "risk" ? -1 : 1))
    .slice(0, 4);

  const dueTodos = [...todos].sort((a, b) => (a.date ?? "9999").localeCompare(b.date ?? "9999")).slice(0, 5);
  const refLabels = Object.fromEntries([...leads.map((l) => [l.name, l.lead_name]), ...opps.map((o) => [o.name, o.title ?? o.name])]);
  const attention = hotLeads.length + risky.filter((r) => r.h.level === "risk").length + overdue;

  return (
    <>
      <PageHeader
        title="Übersicht"
        actions={
          <>
            <ButtonLink href="/leads/new" variant="secondary">
              <UserPlus /> Lead
            </ButtonLink>
            <ButtonLink href="/opportunities/new">
              <Plus /> Chance
            </ButtonLink>
          </>
        }
      />
      <PageBody className="grid gap-8">
        <div>
          <h2 className="text-[22px] font-semibold tracking-[-0.02em] text-gray-900">
            {greeting()}, {user.fullName.split(" ")[0]}
          </h2>
          <p className="mt-1 text-gray-500">
            {longDate()} · {attention > 0 ? `${attention} Punkte brauchen heute deine Aufmerksamkeit` : "Alles im grünen Bereich"}
          </p>
        </div>

        <StatBand>
          <Stat label="Pipeline offen" value={money(pipeline)} hint={`${open.length} Chancen`} spark={volSeries.values} sparkLabels={volSeries.labels} />
          <Stat label="Gewichtete Prognose" value={money(weighted)} hint={`Ø ${avgProb} % Wahrscheinlichkeit`} />
          <Stat label="Neue Leads · 14 Tage" value={newLeads} hint={`${uncontacted} noch ohne Kontakt`} spark={leadSeries.values} sparkLabels={leadSeries.labels} />
          <Stat label="Offene Aufgaben" value={todos.length} hint={overdue > 0 ? <span className="text-rose-600">{overdue} überfällig</span> : "Nichts überfällig"} />
        </StatBand>

        {/* Fokus: was heute den größten Hebel hat */}
        <Card>
          <CardHeader title="Fokus heute" sub="Priorisiert nach Lead-Score und Deal-Risiko" />
          <div className="grid lg:grid-cols-2 lg:divide-x lg:divide-gray-150">
            <div>
              <div className="flex items-center gap-1.5 px-4 pb-1 pt-3 text-[12px] font-medium text-gray-500">
                <Flame className="size-3.5 text-rose-500" /> Jetzt anrufen
              </div>
              {hotLeads.length === 0 ? (
                <p className="px-4 py-5 text-gray-500">Keine heißen Leads offen.</p>
              ) : (
                <ul className="pb-1.5">
                  {hotLeads.map(({ l, s }) => (
                    <li key={l.name}>
                      <Link href={`/leads/${encodeURIComponent(l.name)}`} className="mx-1.5 flex h-12 items-center gap-3 rounded-md px-2.5 transition-colors hover:bg-gray-50">
                        <Avatar name={l.lead_name} />
                        <div className="min-w-0 flex-1">
                          <div className="truncate font-medium text-gray-900">{l.lead_name}</div>
                          <div className="truncate text-[12px] text-gray-500">
                            {l.source ?? "–"} · {relative(l.creation)}
                          </div>
                        </div>
                        <ScoreBadge s={s} />
                      </Link>
                    </li>
                  ))}
                </ul>
              )}
            </div>
            <div className="border-t border-gray-150 lg:border-t-0">
              <div className="flex items-center gap-1.5 px-4 pb-1 pt-3 text-[12px] font-medium text-gray-500">
                <ShieldAlert className="size-3.5 text-amber-500" /> Chancen mit Handlungsbedarf
              </div>
              {risky.length === 0 ? (
                <p className="px-4 py-5 text-gray-500">Alle Chancen auf Kurs.</p>
              ) : (
                <ul className="pb-1.5">
                  {risky.map(({ o, h }) => (
                    <li key={o.name}>
                      <Link href={`/opportunities/${encodeURIComponent(o.name)}`} className="mx-1.5 flex h-12 items-center gap-3 rounded-md px-2.5 transition-colors hover:bg-gray-50">
                        <div className="min-w-0 flex-1">
                          <div className="truncate font-medium text-gray-900">{o.title}</div>
                          <div className="truncate text-[12px] text-gray-500">{h.hints[0]?.text}</div>
                        </div>
                        <div className="flex shrink-0 flex-col items-end gap-0.5">
                          <span className="tnum font-medium text-gray-900">{money(o.opportunity_amount)}</span>
                          <HealthDot h={h} />
                        </div>
                      </Link>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        </Card>

        <div className="grid items-start gap-6 xl:grid-cols-[1.35fr_1fr]">
          <Card>
            <CardHeader
              title="Pipeline nach Phase"
              sub={money(pipeline)}
              action={
                <Link href="/opportunities" className={BTN.ghost}>
                  Board <ArrowRight />
                </Link>
              }
            />
            <div className="grid gap-3.5 p-4">
              {stages.map((s) => (
                <div key={s.stage} className="grid grid-cols-[124px_1fr_96px] items-center gap-4" title={`${STAGE_LABEL[s.stage]}: ${s.count} Chancen, ${money(s.sum)}`}>
                  <div className="flex items-baseline justify-between gap-2">
                    <span className="text-gray-700">{STAGE_LABEL[s.stage]}</span>
                    <span className="tnum text-[12px] text-gray-400">{s.count}</span>
                  </div>
                  <div className="h-1.5 rounded-full bg-gray-100">
                    <div className="h-full rounded-full bg-brand-500" style={{ width: `${s.sum ? Math.max(2, (s.sum / maxStage) * 100) : 0}%` }} />
                  </div>
                  <span className="tnum text-right font-medium text-gray-900">{money(s.sum)}</span>
                </div>
              ))}
              <div className="mt-1 grid grid-cols-[124px_1fr_96px] items-center gap-4 border-t border-gray-150 pt-3.5">
                <span className="text-gray-500">Gewichtet</span>
                <span className="text-[12px] text-gray-400">Betrag × Wahrscheinlichkeit</span>
                <span className="tnum text-right font-medium text-gray-900">{money(weighted)}</span>
              </div>
            </div>
          </Card>

          <Card>
            <CardHeader title="Anstehende Abschlüsse" sub="45 Tage" />
            {closing.length === 0 ? (
              <p className="px-4 py-6 text-gray-500">Keine Abschlüsse in Sicht.</p>
            ) : (
              <ul className="divide-y divide-gray-100">
                {closing.map((o) => {
                  const d = new Date(o.expected_closing!);
                  const n = daysUntil(o.expected_closing) ?? 0;
                  return (
                    <li key={o.name}>
                      <Link href={`/opportunities/${encodeURIComponent(o.name)}`} className="flex h-14 items-center gap-3 px-4 transition-colors hover:bg-gray-50">
                        <div className="flex w-10 shrink-0 flex-col items-center rounded-md border border-gray-200 py-0.5 leading-tight">
                          <span className="text-[10px] font-medium uppercase text-gray-400">{MONTH.format(d)}</span>
                          <span className="tnum text-[14px] font-semibold text-gray-900">{d.getDate()}</span>
                        </div>
                        <div className="min-w-0 flex-1">
                          <div className="truncate font-medium text-gray-900">{o.title}</div>
                          <div className="truncate text-[12px] text-gray-500">
                            {o.customer_name ?? o.party_name} · <span className={n < 0 ? "text-rose-600" : ""}>{n < 0 ? `${-n} T überfällig` : `in ${n} T`}</span>
                          </div>
                        </div>
                        <div className="text-right">
                          <div className="tnum font-medium text-gray-900">{money(o.opportunity_amount, o.currency)}</div>
                          <div className="tnum text-[12px] text-gray-500">{o.probability} %</div>
                        </div>
                      </Link>
                    </li>
                  );
                })}
              </ul>
            )}
          </Card>
        </div>

        <div className="grid gap-6 xl:grid-cols-2">
          <Card>
            <CardHeader
              title="Meine Aufgaben"
              sub={`${todos.length} offen`}
              action={
                <Link href="/todos" className={BTN.ghost}>
                  Alle <ArrowRight />
                </Link>
              }
            />
            <TodoList todos={dueTodos} showRef refLabels={refLabels} empty="Keine offenen Aufgaben." />
          </Card>

          <Card>
            <CardHeader
              title="Zuletzt aktive Leads"
              action={
                <Link href="/leads" className={BTN.ghost}>
                  Alle <ArrowRight />
                </Link>
              }
            />
            <ul className="divide-y divide-gray-100">
              {leads.slice(0, 5).map((l) => (
                <li key={l.name}>
                  <Link href={`/leads/${encodeURIComponent(l.name)}`} className="flex h-12 items-center gap-3 px-4 transition-colors hover:bg-gray-50">
                    <Avatar name={l.lead_name} />
                    <div className="min-w-0 flex-1 truncate">
                      <span className="font-medium text-gray-900">{l.lead_name}</span>
                      <span className="ml-2 text-gray-500">{l.company_name ?? l.territory}</span>
                    </div>
                    <Badge value={l.status} label={LEAD_STATUS_LABEL[l.status]} />
                    <span className="hidden w-24 text-right text-[12px] text-gray-400 sm:block">{relative(l.modified)}</span>
                  </Link>
                </li>
              ))}
            </ul>
          </Card>
        </div>
      </PageBody>
    </>
  );
}
