import Link from "next/link";
import { notFound } from "next/navigation";
import { db } from "@/lib/data";
import { OPPORTUNITY_STAGES } from "@/lib/types";
import { date, LEAD_STATUS_LABEL, money, PRIORITY_LABEL, STAGE_LABEL } from "@/lib/format";
import { Badge, Field, PageHeader } from "@/components/ui";
import { ToDoCheck } from "@/components/interactive";
import { ToDoForm } from "@/components/forms";
import { Timeline } from "@/components/Timeline";

export default async function OpportunityPage({ params }: PageProps<"/opportunities/[name]">) {
  const opp = await db().getOpportunity(decodeURIComponent((await params).name));
  if (!opp) notFound();
  const todos = await db().listToDos({ filters: { reference_name: opp.name } });

  const partyHref = opp.opportunity_from === "Lead" ? `/leads/${encodeURIComponent(opp.party_name)}` : `/customers/${encodeURIComponent(opp.party_name)}`;
  const stageIdx = OPPORTUNITY_STAGES.indexOf(opp.sales_stage as (typeof OPPORTUNITY_STAGES)[number]);

  return (
    <>
      <PageHeader title={opp.title ?? opp.name} crumbs={[{ href: "/opportunities", label: "Chancen" }]} actions={<Badge value={opp.status} label={LEAD_STATUS_LABEL[opp.status]} />} />
      <div className="p-5">
        <ol className="flex gap-1">
          {OPPORTUNITY_STAGES.map((s, i) => (
            <li
              key={s}
              className={`flex-1 rounded-md px-3 py-2 text-center text-xs font-medium ${i <= stageIdx ? "bg-gray-900 text-white" : "bg-gray-100 text-gray-500"}`}
            >
              {STAGE_LABEL[s]}
            </li>
          ))}
        </ol>

        <div className="mt-6 grid grid-cols-3 gap-3">
          <div className="rounded-lg border border-gray-200 p-4">
            <div className="text-xs text-gray-500">Betrag</div>
            <div className="mt-1 text-xl font-semibold tabular-nums">{money(opp.opportunity_amount, opp.currency)}</div>
          </div>
          <div className="rounded-lg border border-gray-200 p-4">
            <div className="text-xs text-gray-500">Wahrscheinlichkeit</div>
            <div className="mt-1 text-xl font-semibold tabular-nums">{opp.probability} %</div>
          </div>
          <div className="rounded-lg border border-gray-200 p-4">
            <div className="text-xs text-gray-500">Erwarteter Abschluss</div>
            <div className="mt-1 text-xl font-semibold">{date(opp.expected_closing)}</div>
          </div>
        </div>

        <dl className="mt-6 max-w-xl">
          <Field label="ID">{opp.name}</Field>
          <Field label={opp.opportunity_from === "Lead" ? "Lead" : "Kunde"}>
            <Link href={partyHref} className="text-blue-700 hover:underline">
              {opp.customer_name ?? opp.party_name}
            </Link>
          </Field>
          <Field label="Verantwortlich">{opp.opportunity_owner}</Field>
          <Field label="Angelegt">{date(opp.creation)}</Field>
          <Field label="Geändert">{date(opp.modified)}</Field>
        </dl>

        <section className="mt-6 max-w-3xl">
          <h3 className="mb-2 font-medium">Aufgaben</h3>
          <div className="mb-2">
            <ToDoForm referenceType="Opportunity" referenceName={opp.name} compact />
          </div>
          {todos.length > 0 && (
            <ul className="divide-y divide-gray-100 rounded-md border border-gray-200">
              {todos.map((t) => (
                <li key={t.name} className="flex items-center gap-3 px-3 py-2.5">
                  <ToDoCheck name={t.name} done={t.status === "Closed"} />
                  <span className={`flex-1 ${t.status === "Closed" ? "text-gray-400 line-through" : ""}`}>{t.description}</span>
                  <Badge value={t.priority} label={PRIORITY_LABEL[t.priority]} />
                  <span className="text-xs text-gray-500">{date(t.date)}</span>
                </li>
              ))}
            </ul>
          )}
        </section>

        <div className="max-w-3xl">
          <Timeline doctype="Opportunity" name={opp.name} />
        </div>
      </div>
    </>
  );
}
