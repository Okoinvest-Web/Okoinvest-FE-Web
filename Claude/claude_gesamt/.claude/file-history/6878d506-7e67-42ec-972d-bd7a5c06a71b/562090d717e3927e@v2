  const contact = (c: Contact) =>
    all ||
    c.links.some((k) =>
      k.link_doctype === "Customer"
        ? store.customers.some((x) => x.name === k.link_name && customer(x))
        : k.link_doctype === "Lead" && store.leads.some((x) => x.name === k.link_name && lead(x)),
    );
  const todo = (t: ToDo) => all || t.allocated_to === me;
  const doc = (doctype: string, name: string) =>
    doctype === "Lead"
      ? store.leads.some((x) => x.name === name && lead(x))
      : doctype === "Opportunity"
        ? store.opportunities.some((x) => x.name === name && opp(x))
        : doctype === "Customer" && store.customers.some((x) => x.name === name && customer(x));
  return { me, lead, opp, customer, contact, todo, doc };
}

function deny(): never {
  throw new Error("Keine Berechtigung für diesen Datensatz");
}

