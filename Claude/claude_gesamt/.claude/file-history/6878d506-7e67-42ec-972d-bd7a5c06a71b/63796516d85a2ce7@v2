// ---------- Chance ----------

type PartyOption = { value: string; label: string };

export function OpportunityForm({
  leads,
  customers,
  defaultFrom = "Customer",
  defaultParty,
}: {
  leads: PartyOption[];
  customers: PartyOption[];
  defaultFrom?: "Lead" | "Customer";
  defaultParty?: string;
}) {
  const [state, action, pending] = useActionState<FormState, FormData>(createOpportunityAction, {});
  const [from, setFrom] = useState(defaultFrom);
  const [prob, setProb] = useState(STAGE_PROB[0]);
  const [probTouched, setProbTouched] = useState(false);
  const options = from === "Lead" ? leads : customers;

  return (
    <form action={action} className="mx-auto max-w-3xl">
      <Group title="Projekt" desc="Ein aussagekräftiger Titel mit Anlagengröße, z. B. „PV 12 kWp + Speicher 10 kWh“ – so erkennt der PV-Rechner die Werte.">
        <L label="Titel *" className="col-span-2">
          <input name="title" required autoFocus className={inputCls} placeholder="z. B. PV 12 kWp + Speicher 10 kWh" />
        </L>
        <L label="Bezug">
          <select name="opportunity_from" value={from} onChange={(e) => setFrom(e.target.value as "Lead" | "Customer")} className={inputCls}>
            <option value="Customer">Bestehender Kunde</option>
            <option value="Lead">Lead</option>
          </select>
        </L>
        <L label={from === "Lead" ? "Lead *" : "Kunde *"}>
          <select key={from} name="party_name" required defaultValue={from === defaultFrom ? defaultParty ?? "" : ""} className={inputCls}>
            <option value="" disabled>
              Bitte wählen …
            </option>
            {options.map((o) => (
              <option key={o.value} value={o.value}>
                {o.label}
              </option>
            ))}
          </select>
        </L>
      </Group>
      <Group title="Prognose" desc="Die Wahrscheinlichkeit folgt automatisch der Phase, bis du sie selbst änderst.">
        <L label="Auftragswert">
          <div className="relative">
            <input name="opportunity_amount" inputMode="decimal" placeholder="0" className={`${inputCls} w-full pr-8`} />
            <span className="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-gray-400">€</span>
          </div>
        </L>
        <L label="Erwarteter Abschluss">
          <input name="expected_closing" type="date" className={inputCls} />
        </L>
        <L label="Phase">
          <select
            name="sales_stage"
            defaultValue={OPPORTUNITY_STAGES[0]}
            onChange={(e) => {
              const i = OPPORTUNITY_STAGES.indexOf(e.target.value as (typeof OPPORTUNITY_STAGES)[number]);
              if (!probTouched && i >= 0) setProb(STAGE_PROB[i]);
            }}
            className={inputCls}
          >
            {OPPORTUNITY_STAGES.map((s) => (
              <option key={s} value={s}>
                {STAGE_LABEL[s]}
              </option>
            ))}
          </select>
        </L>
        <L label="Wahrscheinlichkeit" hint={probTouched ? "Manuell gesetzt" : "Automatisch aus Phase"}>
          <div className="relative">
            <input
              name="probability"
              type="number"
              min={0}
              max={100}
              step={5}
              value={prob}
              onChange={(e) => {
                setProbTouched(true);
                setProb(Number(e.target.value));
              }}
              className={`${inputCls} w-full pr-8`}
            />
            <span className="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-gray-400">%</span>
          </div>
        </L>
      </Group>
      <Footer state={state} pending={pending} label="Chance anlegen" cancelHref="/opportunities" />
    </form>
  );
}
