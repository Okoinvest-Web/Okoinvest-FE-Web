"use client";

import Link from "next/link";
import { useActionState, useEffect, useRef, useState, useTransition } from "react";
import { ArrowRight, UserCheck } from "lucide-react";
import {
  addNoteAction,
  convertLeadAction,
  createLeadAction,
  createOpportunityAction,
  createToDoAction,
  loginAction,
  updateLeadAction,
  type FormState,
} from "@/lib/actions";
import { LEAD_STATUSES, OPPORTUNITY_STAGES, type Lead } from "@/lib/types";
import { LEAD_STATUS_LABEL, STAGE_LABEL } from "@/lib/format";
import { STAGE_PROB } from "@/lib/insights";
import { BTN, INPUT } from "@/components/ui";
import { toast } from "@/components/Toaster";

export const inputCls = INPUT;
const textareaCls = `${INPUT} h-auto py-2 leading-relaxed resize-y`;
const SOURCES = ["Website", "Empfehlung", "Messe", "Kaltakquise", "LinkedIn"];

function ErrorBox({ state }: { state: FormState }) {
  return state.error ? <p className="rounded-md border border-rose-200 bg-rose-50 px-3 py-2 text-rose-700">{state.error}</p> : null;
}

function L({ label, hint, children, className = "" }: { label: string; hint?: string; children: React.ReactNode; className?: string }) {
  return (
    <label className={`flex flex-col gap-1.5 ${className}`}>
      <span className="text-[12px] font-medium text-gray-700">{label}</span>
      {children}
      {hint && <span className="text-[12px] text-gray-400">{hint}</span>}
    </label>
  );
}

// Formularabschnitt: Titel + Erklärung links, Felder rechts
function Group({ title, desc, children }: { title: string; desc?: string; children: React.ReactNode }) {
  return (
    <div className="grid gap-x-12 gap-y-4 border-b border-gray-150 py-7 first:pt-0 md:grid-cols-[220px_1fr]">
      <div>
        <h3 className="font-semibold text-gray-900">{title}</h3>
        {desc && <p className="mt-1 text-[12px] leading-relaxed text-gray-500">{desc}</p>}
      </div>
      <div className="grid grid-cols-2 gap-x-4 gap-y-5">{children}</div>
    </div>
  );
}

function Footer({ state, pending, label, cancelHref }: { state: FormState; pending: boolean; label: string; cancelHref: string }) {
  return (
    <div className="flex items-center justify-end gap-2 pt-5">
      <div className="mr-auto">
        <ErrorBox state={state} />
      </div>
      <Link href={cancelHref} className={BTN.secondary}>
        Abbrechen
      </Link>
      <button disabled={pending} className={BTN.primary}>
        {pending ? "Speichern …" : label}
      </button>
    </div>
  );
}

// Nach erfolgreichem Absenden: Formular leeren und Rückmeldung zeigen
function useResetOnSuccess(pending: boolean, state: FormState, message: string) {
  const ref = useRef<HTMLFormElement>(null);
  const wasPending = useRef(false);
  useEffect(() => {
    if (wasPending.current && !pending) {
      if (state.error) toast(state.error, "error");
      else {
        ref.current?.reset();
        toast(message);
      }
    }
    wasPending.current = pending;
  }, [pending, state, message]);
  return ref;
}

// ---------- Login ----------

export function LoginForm({ next, demo }: { next?: string; demo: boolean }) {
  const [state, action, pending] = useActionState<FormState, FormData>(loginAction, {});
  return (
    <form action={action} className="flex flex-col gap-4">
      <input type="hidden" name="next" value={next ?? ""} />
      <L label="E-Mail">
        <input name="usr" type="email" autoComplete="username" required autoFocus className={`${inputCls} h-9`} defaultValue={demo ? "max@firma.example" : ""} />
      </L>
      <L label="Passwort">
        <input name="pwd" type="password" autoComplete="current-password" required className={`${inputCls} h-9`} />
      </L>
      <ErrorBox state={state} />
      <button disabled={pending} className={`${BTN.primary} h-9 w-full`}>
        {pending ? (
          "Anmelden …"
        ) : (
          <>
            Anmelden <ArrowRight />
          </>
        )}
      </button>
    </form>
  );
}

// ---------- Notizen ----------

export function NoteComposer({ doctype, name }: { doctype: string; name: string }) {
  const [state, action, pending] = useActionState<FormState, FormData>(addNoteAction.bind(null, doctype, name), {});
  const ref = useResetOnSuccess(pending, state, "Notiz gespeichert");

  return (
    <form ref={ref} action={action} className="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-xs transition focus-within:border-brand-500 focus-within:ring-2 focus-within:ring-brand-500/20">
      <textarea
        name="content"
        rows={3}
        placeholder="Gespräch, Vor-Ort-Termin oder Absprache festhalten …"
        className="block w-full resize-y px-3 py-2.5 leading-relaxed outline-none placeholder:text-gray-400"
        onKeyDown={(e) => {
          if (e.key === "Enter" && (e.ctrlKey || e.metaKey)) e.currentTarget.form?.requestSubmit();
        }}
      />
      <div className="flex items-center justify-end gap-3 border-t border-gray-100 bg-gray-25 px-2 py-1.5">
        <span className="text-[12px] text-gray-400">Strg + Enter</span>
        <button disabled={pending} className={`${BTN.primary} h-7`}>
          {pending ? "Speichern …" : "Notiz speichern"}
        </button>
      </div>
    </form>
  );
}

// ---------- Aufgaben ----------

export function ToDoForm({ referenceType, referenceName }: { referenceType?: string; referenceName?: string; compact?: boolean }) {
  const [state, action, pending] = useActionState<FormState, FormData>(createToDoAction, {});
  const ref = useResetOnSuccess(pending, state, "Aufgabe angelegt");

  return (
