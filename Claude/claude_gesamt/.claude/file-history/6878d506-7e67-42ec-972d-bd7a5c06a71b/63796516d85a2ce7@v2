        <L label="Vorname *">
          <input name="first_name" required autoFocus defaultValue={lead?.first_name} className={inputCls} />
        </L>
        <L label="Nachname">
          <input name="last_name" defaultValue={lead?.last_name} className={inputCls} />
        </L>
        <L label="Firma / Betrieb" className="col-span-2" hint="Leer lassen bei Privatkunden">
          <input name="company_name" defaultValue={lead?.company_name} className={inputCls} />
        </L>
      </Group>
      <Group title="Kontakt" desc="Telefonnummer erhöht den Lead-Score – Rückruf binnen 24 h ist der stärkste Hebel.">
        <L label="E-Mail">
          <input name="email_id" type="email" defaultValue={lead?.email_id} className={inputCls} placeholder="name@beispiel.de" />
        </L>
        <L label="Mobil">
          <input name="mobile_no" type="tel" defaultValue={lead?.mobile_no} className={inputCls} placeholder="+49 …" />
        </L>
      </Group>
      <Group title="Herkunft" desc="Woher kam die Anfrage? Fließt in Lead-Score und Auswertungen ein.">
        <L label="Quelle">
          <select name="source" defaultValue={lead?.source ?? ""} className={inputCls}>
            <option value="">Nicht angegeben</option>
            {SOURCES.map((s) => (
              <option key={s}>{s}</option>
            ))}
          </select>
        </L>
        {withStatus ? (
          <L label="Status">
            <select name="status" defaultValue="Lead" className={inputCls}>
              {LEAD_STATUSES.map((s) => (
                <option key={s} value={s}>
                  {LEAD_STATUS_LABEL[s]}
