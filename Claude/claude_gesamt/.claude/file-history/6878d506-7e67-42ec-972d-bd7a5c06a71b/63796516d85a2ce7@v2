      {referenceName && <input type="hidden" name="reference_name" value={referenceName} />}
      <input name="description" required placeholder="Neue Aufgabe, z. B. Rückruf wegen Dachfotos …" className={`${inputCls} min-w-56 flex-1`} />
      <input name="date" type="date" className={`${inputCls} w-36`} aria-label="Fällig am" />
      <select name="priority" defaultValue="Medium" className={`${inputCls} w-28`} aria-label="Priorität">
