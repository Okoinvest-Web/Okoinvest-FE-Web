// ---------- Lead ----------

export function ConvertLeadButton({ name, label }: { name: string; label: string }) {
  const [pending, start] = useTransition();
  return (
    <button
      disabled={pending}
      onClick={() => {
        if (!confirm(`„${label}“ in einen Kunden umwandeln? Offene Chancen werden auf den Kunden übertragen.`)) return;
        start(async () => {
          try {
            await convertLeadAction(name);
          } catch (e) {
            // redirect() wirft absichtlich – nur echte Fehler anzeigen
            if (e instanceof Error && !e.message.includes("NEXT_REDIRECT")) toast(e.message, "error");
            else throw e;
          }
        });
      }}
      title="In Kunde umwandeln"
      className={BTN.secondary}
    >
      <UserCheck className="text-brand-600" />
      <span className="hidden sm:inline">{pending ? "Konvertiere …" : "In Kunde umwandeln"}</span>
    </button>
  );
}

