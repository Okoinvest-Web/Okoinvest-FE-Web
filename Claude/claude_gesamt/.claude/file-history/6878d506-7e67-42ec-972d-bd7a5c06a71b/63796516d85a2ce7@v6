const DUPE_FIELDS = ["email_id", "mobile_no", "first_name", "last_name"];

export function NewLeadForm() {
  const [state, action, pending] = useActionState<FormState, FormData>(createLeadAction, {});
  const [dupes, setDupes] = useState<DuplicateHit[]>([]);

  // Beim Verlassen von E-Mail/Telefon/Name prüfen, ob es den Kontakt schon gibt
  async function check(form: HTMLFormElement) {
    const f = new FormData(form);
    setDupes(
      await findDuplicatesAction({
        email: String(f.get("email_id") ?? ""),
        mobile: String(f.get("mobile_no") ?? ""),
        firstName: String(f.get("first_name") ?? ""),
        lastName: String(f.get("last_name") ?? ""),
      }),
    );
  }

  return (
    <form
      action={action}
      className="mx-auto max-w-3xl"
      onBlur={(e) => {
        const field = e.target.getAttribute("name") ?? "";
        if (DUPE_FIELDS.includes(field)) void check(e.currentTarget);
      }}
    >
      {dupes.length > 0 && (
        <div className="mb-6 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3" role="alert">
          <div className="flex items-center gap-2 font-medium text-amber-900">
            <AlertTriangle className="size-4" /> Möglicherweise schon vorhanden
          </div>
          <ul className="mt-2 grid gap-1">
            {dupes.map((d) => (
              <li key={d.href + d.title}>
                {d.href ? (
                  <Link href={d.href} className="text-amber-900 underline-offset-2 hover:underline">
                    {d.type}: {d.title}
                  </Link>
                ) : (
                  <span className="font-medium text-amber-900">{d.title}</span>
                )}
                {d.detail && <span className="text-amber-800/80"> · {d.detail}</span>}
              </li>
            ))}
          </ul>
        </div>
      )}
      <LeadFields withStatus />
      <Footer state={state} pending={pending} label="Lead anlegen" cancelHref="/leads" />
    </form>
  );
}

