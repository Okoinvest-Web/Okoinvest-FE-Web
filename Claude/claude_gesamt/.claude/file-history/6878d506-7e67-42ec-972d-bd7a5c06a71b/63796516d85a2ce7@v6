export const inputCls = INPUT;
const textareaCls = `${INPUT} h-auto py-2 leading-relaxed resize-y`;

function ErrorBox({ state }: { state: FormState }) {
  return state.error ? <p className="rounded-md border border-rose-200 bg-rose-50 px-3 py-2 text-rose-700">{state.error}</p> : null;
}

function L({ label, hint, children, className = "" }: { label: string; hint?: string; children: React.ReactNode; className?: string }) {
  return (
    <label className={`flex flex-col gap-1.5 ${className}`}>
      <span className="text-[12px] font-medium text-gray-700">{label}</span>
      {children}
      {hint && <span className="text-[12px] text-gray-400">{hint}</span>}
    </label>
  );
}

// Formularabschnitt: Titel + Erklärung links, Felder rechts
function Group({ title, desc, children }: { title: string; desc?: string; children: React.ReactNode }) {
  return (
    <div className="grid gap-x-12 gap-y-4 border-b border-gray-150 py-7 first:pt-0 md:grid-cols-[220px_1fr]">
      <div>
        <h3 className="font-semibold text-gray-900">{title}</h3>
        {desc && <p className="mt-1 text-[12px] leading-relaxed text-gray-500">{desc}</p>}
      </div>
      <div className="grid grid-cols-2 gap-x-4 gap-y-5">{children}</div>
    </div>
  );
}

function Footer({ state, pending, label, cancelHref }: { state: FormState; pending: boolean; label: string; cancelHref: string }) {
  return (
    <div className="flex items-center justify-end gap-2 pt-5">
      <div className="mr-auto">
        <ErrorBox state={state} />
      </div>
      <Link href={cancelHref} className={BTN.secondary}>
        Abbrechen
      </Link>
      <button disabled={pending} className={BTN.primary}>
        {pending ? "Speichern …" : label}
      </button>
    </div>
  );
}

// Nach erfolgreichem Absenden: Formular leeren und Rückmeldung zeigen
function useResetOnSuccess(pending: boolean, state: FormState, message: string) {
  const ref = useRef<HTMLFormElement>(null);
  const wasPending = useRef(false);
  useEffect(() => {
    if (wasPending.current && !pending) {
      if (state.error) toast(state.error, "error");
      else {
        ref.current?.reset();
        toast(message);
      }
    }
    wasPending.current = pending;
  }, [pending, state, message]);
  return ref;
}

