import Link from "next/link";
import { Suspense } from "react";
import { Contact, Phone } from "lucide-react";
import { db } from "@/lib/data";
import { Avatar, Empty, PageHeader, Table, TD } from "@/components/ui";
import { ListToolbar } from "@/components/ListToolbar";

export const metadata = { title: "Kontakte" };

export default async function ContactsPage({ searchParams }: PageProps<"/contacts">) {
  const sp = await searchParams;
  const contacts = await db().listContacts({ search: typeof sp.q === "string" ? sp.q : undefined });

  return (
    <>
      <PageHeader title="Kontakte" subtitle="Ansprechpartner bei Kunden" />
      <div>
          <Suspense>
            <ListToolbar count={contacts.length} />
          </Suspense>
          {contacts.length === 0 ? (
            <Empty icon={Contact}>Keine Kontakte gefunden.</Empty>
          ) : (
            <>
{/* Handy: Karten mit Direktwahl */}
<ul className="divide-y divide-gray-100 sm:hidden">
  {contacts.map((c) => (
    <li key={c.name} className="flex items-center gap-3 px-4 py-3">
      <Avatar name={c.full_name} size="md" />
      <div className="min-w-0 flex-1">
        <div className="truncate font-medium text-gray-900">{c.full_name}</div>
        <div className="truncate text-[12px] text-gray-500">{[c.designation, c.company_name].filter(Boolean).join(" · ") || "–"}</div>
      </div>
      {c.mobile_no && (
        <a href={`tel:${c.mobile_no.replace(/\s/g, "")}`} aria-label={`${c.full_name} anrufen`} className="rounded-md border border-gray-200 p-2 text-gray-600">
          <Phone className="size-4" />
        </a>
      )}
    </li>
  ))}
</ul>
<div className="hidden sm:block">
<Table head={["Name", "Firma", "E-Mail", "Mobil"]}>
              {contacts.map((c) => (
                <tr key={c.name} className="transition-colors hover:bg-gray-50">
                  <td className={TD}>
                    <span className="flex items-center gap-3">
                      <Avatar name={c.full_name} />
                      <span className="min-w-0">
                        <span className="block font-medium text-gray-900">{c.full_name}</span>
                        <span className="block text-xs text-gray-500">{c.designation ?? "–"}</span>
                      </span>
                    </span>
                  </td>
                  <td className={TD}>
                    {c.company_name ? (
                      <Link href={`/customers/${encodeURIComponent(c.company_name)}`} className="hover:text-brand-700 hover:underline">
                        {c.company_name}
                      </Link>
                    ) : (
                      "–"
                    )}
                  </td>
                  <td className={TD}>
                    {c.email_id ? (
                      <a href={`mailto:${c.email_id}`} className="hover:text-brand-700 hover:underline">
                        {c.email_id}
                      </a>
                    ) : (
                      "–"
                    )}
                  </td>
                  <td className={`${TD} whitespace-nowrap`}>
                    {c.mobile_no ? (
                      <a href={`tel:${c.mobile_no.replace(/\s/g, "")}`} className="hover:text-brand-700 hover:underline">
                        {c.mobile_no}
                      </a>
                    ) : (
                      "–"
                    )}
                  </td>
                </tr>
              ))}
            </Table>
</div>
</>
          )}
      </div>
    </>
  );
}
