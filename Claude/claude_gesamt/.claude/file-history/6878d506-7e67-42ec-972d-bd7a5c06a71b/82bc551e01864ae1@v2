// Platzhalter: {name}, {vorname}, {kwp}, {berater}, {berater_email}, {titel}
// Anrede bewusst neutral ("Guten Tag Vorname Nachname") – aus dem Namen lässt sich keine Anrede ableiten.

export type EmailTemplate = {
  id: string;
  label: string;
  hint: string;
  marketing: boolean; // Werbung → nur mit Einwilligung (bei Privatkunden)
  subject: string;
  body: string;
};

