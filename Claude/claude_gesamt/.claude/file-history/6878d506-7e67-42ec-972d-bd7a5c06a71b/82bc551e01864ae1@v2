export type TemplateContext = { name: string; kwp?: number; advisor: string; advisorEmail: string; title?: string };

export function fillTemplate(t: EmailTemplate, c: TemplateContext) {
  const vars: Record<string, string> = {
    name: c.name,
    vorname: c.name.split(" ")[0],
    kwp: c.kwp ? `${c.kwp.toLocaleString("de-DE")} kWp` : "",
    kwp_satz: c.kwp ? ` für eine Photovoltaikanlage mit rund ${c.kwp.toLocaleString("de-DE")} kWp` : "",
    berater: c.advisor,
    berater_email: c.advisorEmail,
    titel: c.title ?? "Ihre Photovoltaikanlage",
  };
  const fill = (s: string) => s.replace(/\{(\w+)\}/g, (_, k: string) => vars[k] ?? "");
  return { subject: fill(t.subject), body: fill(t.body) };
}
