rep("// Kleine künstliche Latenz", '''// Änderungsverlauf wie ERPNext "Version": nur tatsächlich geänderte Felder
async function track<T extends object>(doctype: string, name: string, before: T, patch: Partial<T>) {
  const changes = Object.entries(patch)
    .filter(([k, v]) => v !== undefined && String(before[k as keyof T] ?? "") !== String(v ?? ""))
    .map(([k, v]) => [k, String(before[k as keyof T] ?? ""), String(v ?? "")] as [string, string, string]);
  if (!changes.length) return;
  const u = await getUser();
  store.versions.push({ name: nextId("VER-"), ref_doctype: doctype, docname: name, owner: u?.user ?? "system", creation: now(), changes });
}

