def wrap(p, table_start, cards):
    s = open(p, encoding="utf-8").read()
    i = s.index(table_start)
    j = s.index("</Table>", i) + len("</Table>")
    table = s[i:j]
    new = "<>\n" + cards + '\n<div className="hidden sm:block">\n' + table + "\n</div>\n</>"
    s = s[:i] + new + s[j:]
    open(p, "w", encoding="utf-8", newline="\n").write(s)

