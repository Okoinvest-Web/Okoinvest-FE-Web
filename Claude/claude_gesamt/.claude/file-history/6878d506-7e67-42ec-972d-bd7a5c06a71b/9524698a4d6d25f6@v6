import Link from "next/link";
import { CheckSquare } from "lucide-react";
import { db } from "@/lib/data";
import { requireUser } from "@/lib/auth";
import { daysUntil } from "@/lib/format";
import { Empty, PageHeader } from "@/components/ui";
import { ToDoForm } from "@/components/forms";
import { TodoList } from "@/components/TodoList";

export const metadata = { title: "Aufgaben" };

// Offene Aufgaben nach Fälligkeit gruppiert – so sieht man sofort, was heute dran ist
const BUCKETS = [
  { id: "overdue", label: "Überfällig", test: (n?: number) => n !== undefined && n < 0, tone: "text-rose-600" },
  { id: "today", label: "Heute", test: (n?: number) => n === 0, tone: "text-amber-700" },
  { id: "week", label: "Nächste 7 Tage", test: (n?: number) => n !== undefined && n > 0 && n <= 7, tone: "text-gray-900" },
  { id: "later", label: "Später", test: (n?: number) => n !== undefined && n > 7, tone: "text-gray-900" },
  { id: "none", label: "Ohne Termin", test: (n?: number) => n === undefined, tone: "text-gray-900" },
];

export default async function ToDosPage({ searchParams }: PageProps<"/todos">) {
  const sp = await searchParams;
  const user = await requireUser();
  const mine = sp.mine === "1";
  const showDone = sp.done === "1";

  const [all, leads, opps] = await Promise.all([db().listToDos({ limit: 500 }), db().listLeads({ limit: 500 }), db().listOpportunities({ limit: 500 })]);
  const refLabels = Object.fromEntries([...leads.map((l) => [l.name, l.lead_name]), ...opps.map((o) => [o.name, o.title ?? o.name])]);

  const scoped = mine ? all.filter((t) => t.allocated_to === user.user) : all;
  // Innerhalb einer Gruppe: früheste Fälligkeit zuerst, bei Gleichstand hohe Priorität vorn
  const open = scoped
    .filter((t) => t.status === "Open")
    .sort((a, b) => (a.date ?? "9999").localeCompare(b.date ?? "9999") || Number(b.priority === "High") - Number(a.priority === "High"));
  const done = scoped.filter((t) => t.status !== "Open").sort((a, b) => b.modified.localeCompare(a.modified));
  const groups = BUCKETS.map((b) => ({ ...b, items: open.filter((t) => b.test(daysUntil(t.date))) })).filter((g) => g.items.length);
  const overdue = groups.find((g) => g.id === "overdue")?.items.length ?? 0;

  const href = (next: { mine?: boolean; done?: boolean }) => {
    const p = new URLSearchParams();
    if (next.mine ?? mine) p.set("mine", "1");
    if (next.done ?? showDone) p.set("done", "1");
    return `/todos${p.size ? `?${p}` : ""}`;
  };
  const seg = (on: boolean, to: string, label: string) => (
    <Link
      href={to}
      className={`inline-flex h-7 items-center rounded-[5px] px-2.5 text-[13px] transition ${
        on ? "bg-white font-medium text-gray-900 shadow-xs ring-1 ring-gray-200" : "text-gray-500 hover:text-gray-900"
      }`}
    >
      {label}
    </Link>
  );

  return (
    <>
      <PageHeader
        title="Aufgaben"
        subtitle={`${open.length} offen${overdue ? ` · ${overdue} überfällig` : ""}`}
        actions={
          <div className="flex gap-0.5 rounded-md bg-gray-100 p-0.5">
            {seg(!mine, href({ mine: false }), "Alle")}
            {seg(mine, href({ mine: true }), "Nur meine")}
          </div>
        }
      />
      <div className="border-b border-gray-150 px-4 py-3 sm:px-6">
        <ToDoForm />
      </div>

      {open.length === 0 && <Empty icon={CheckSquare}>Keine offenen Aufgaben{mine ? " für dich" : ""}.</Empty>}

      {groups.map((g) => (
        <section key={g.id}>
          <h2 className="sticky top-[52px] z-10 flex h-9 items-center gap-2 border-b border-gray-150 bg-gray-50/95 px-4 text-[12px] font-semibold backdrop-blur sm:px-6">
            <span className={g.tone}>{g.label}</span>
            <span className="tnum font-normal text-gray-400">{g.items.length}</span>
          </h2>
          <TodoList todos={g.items} showRef showOwner refLabels={refLabels} inset="px-4 sm:px-6" />
        </section>
      ))}

      {done.length > 0 && (
        <section>
          <h2 className="flex h-9 items-center gap-2 border-y border-gray-150 bg-gray-50/95 px-4 text-[12px] font-semibold text-gray-500 sm:px-6">
            Erledigt
            <span className="tnum font-normal text-gray-400">{done.length}</span>
            <Link href={href({ done: !showDone })} className="ml-auto font-normal text-gray-500 hover:text-gray-900">
              {showDone ? "Ausblenden" : "Anzeigen"}
            </Link>
          </h2>
          {showDone && <TodoList todos={done.slice(0, 50)} showRef showOwner refLabels={refLabels} inset="px-4 sm:px-6" />}
        </section>
      )}
    </>
  );
}
