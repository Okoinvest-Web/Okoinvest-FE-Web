import Link from "next/link";
import type { ReactNode } from "react";
import { initials, STATUS_TONE, type Tone } from "@/lib/format";

const TONES: Record<Tone, string> = {
  gray: "bg-gray-100 text-gray-700",
  blue: "bg-blue-50 text-blue-700",
  green: "bg-green-50 text-green-700",
  amber: "bg-amber-50 text-amber-800",
  red: "bg-red-50 text-red-700",
  violet: "bg-violet-50 text-violet-700",
};

export function Badge({ value, label, tone }: { value: string; label?: string; tone?: Tone }) {
  const t = tone ?? STATUS_TONE[value] ?? "gray";
  return (
    <span className={`inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 text-xs font-medium ${TONES[t]}`}>
      <span className="size-1.5 rounded-full bg-current opacity-70" />
      {label ?? value}
    </span>
  );
}

export function Avatar({ name, size = "sm" }: { name: string; size?: "sm" | "lg" }) {
  return (
    <span
      className={`inline-flex shrink-0 items-center justify-center rounded-full bg-gray-200 font-medium text-gray-700 ${
        size === "lg" ? "size-12 text-base" : "size-6 text-[10px]"
      }`}
    >
      {initials(name)}
    </span>
  );
}

export function PageHeader({ title, crumbs, actions }: { title: string; crumbs?: { href: string; label: string }[]; actions?: ReactNode }) {
  return (
    <header className="flex h-12 shrink-0 items-center justify-between border-b border-gray-200 px-5">
      <div className="flex items-center gap-1.5 text-gray-500">
        {crumbs?.map((c) => (
          <span key={c.href} className="flex items-center gap-1.5">
            <Link href={c.href} className="hover:text-gray-900">
              {c.label}
            </Link>
            <span>/</span>
          </span>
        ))}
        <h1 className="font-medium text-gray-900">{title}</h1>
      </div>
      <div className="flex items-center gap-2">{actions}</div>
    </header>
  );
}

export function ButtonLink({ href, children }: { href: string; children: ReactNode }) {
  return (
    <Link href={href} className="inline-flex h-8 items-center gap-1.5 rounded-md bg-gray-900 px-3 text-sm font-medium text-white hover:bg-gray-800">
      {children}
    </Link>
  );
}

export function Empty({ children }: { children: ReactNode }) {
  return <div className="px-5 py-16 text-center text-gray-500">{children}</div>;
}

export function Field({ label, children }: { label: string; children: ReactNode }) {
  return (
    <div className="grid grid-cols-[140px_1fr] items-start gap-3 py-1.5">
      <dt className="text-gray-500">{label}</dt>
      <dd className="min-w-0 break-words text-gray-900">{children ?? "–"}</dd>
    </div>
  );
}

export function Table({ head, children }: { head: string[]; children: ReactNode }) {
  return (
    <div className="overflow-x-auto">
      <table className="w-full text-left">
        <thead>
          <tr className="border-b border-gray-200 text-xs text-gray-500">
            {head.map((h) => (
              <th key={h} className="whitespace-nowrap px-5 py-2 font-medium">
                {h}
              </th>
            ))}
          </tr>
        </thead>
        <tbody className="divide-y divide-gray-100">{children}</tbody>
      </table>
    </div>
  );
}
