// ---------- Statusanzeigen ----------

const TONES: Record<Tone, string> = {
  gray: "bg-gray-100 text-gray-700 ring-gray-200",
  blue: "bg-sky-50 text-sky-700 ring-sky-200",
  green: "bg-brand-50 text-brand-700 ring-brand-200",
  amber: "bg-amber-50 text-amber-800 ring-amber-200",
  red: "bg-rose-50 text-rose-700 ring-rose-200",
  violet: "bg-violet-50 text-violet-700 ring-violet-200",
};

export function Badge({ value, label, tone }: { value: string; label?: string; tone?: Tone }) {
  const t = tone ?? STATUS_TONE[value] ?? "gray";
  return (
    <span className={`inline-flex items-center gap-1.5 whitespace-nowrap rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset ${TONES[t]}`}>
      <span className="size-1.5 rounded-full bg-current opacity-70" />
      {label ?? value}
    </span>
  );
}

// Feste Farbe je Name, damit dieselbe Person überall gleich aussieht
const AVATAR_COLORS = [
  "bg-brand-100 text-brand-800",
  "bg-sky-100 text-sky-800",
  "bg-amber-100 text-amber-800",
  "bg-violet-100 text-violet-800",
  "bg-rose-100 text-rose-800",
  "bg-teal-100 text-teal-800",
  "bg-lime-100 text-lime-800",
];

function hash(s: string) {
  let h = 0;
  for (const c of s) h = (h * 31 + c.charCodeAt(0)) | 0;
  return Math.abs(h);
}

export function Avatar({ name: raw, size = "sm" }: { name: string; size?: "sm" | "md" | "lg" }) {
  const name = personName(raw);
  const sz = size === "lg" ? "size-14 text-lg" : size === "md" ? "size-9 text-xs" : "size-7 text-[10px]";
  return (
    <span title={name} className={`inline-flex shrink-0 items-center justify-center rounded-full font-semibold ${sz} ${AVATAR_COLORS[hash(name) % AVATAR_COLORS.length]}`}>
      {initials(name)}
    </span>
  );
}

export function Progress({ value, className = "" }: { value: number; className?: string }) {
  const v = Math.max(0, Math.min(100, value));
  const color = v >= 70 ? "bg-brand-500" : v >= 35 ? "bg-sun-400" : "bg-gray-300";
  return (
    <div className={`h-1.5 overflow-hidden rounded-full bg-gray-100 ${className}`}>
      <div className={`h-full rounded-full ${color}`} style={{ width: `${v}%` }} />
    </div>
  );
}

