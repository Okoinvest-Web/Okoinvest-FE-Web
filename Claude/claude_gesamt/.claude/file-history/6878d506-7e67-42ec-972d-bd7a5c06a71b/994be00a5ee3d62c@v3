  icon: ComponentType<{ className?: string }>;
  accent?: "brand" | "sun" | "sky" | "violet";
}) {
  const acc = accent === "sun" ? "bg-amber-50 text-amber-600" : "bg-brand-50 text-brand-700";
  return (
    <Card className="p-5">
      <div className="flex items-start justify-between gap-3">
        <div className="text-sm font-medium text-gray-500">{label}</div>
        <span className={`flex size-9 items-center justify-center rounded-lg ${acc}`}>
