const AVATAR_COLORS = [
  "bg-[#e7efe9] text-[#2f5a43]",
  "bg-[#e6edf3] text-[#2f4d66]",
  "bg-[#f3ece1] text-[#6b4f22]",
  "bg-[#ece8f3] text-[#4c3d6b]",
  "bg-[#f3e6e6] text-[#6b3333]",
  "bg-[#e3eeee] text-[#2c5757]",
];

function hash(s: string) {
  let h = 0;
  for (const c of s) h = (h * 31 + c.charCodeAt(0)) | 0;
  return Math.abs(h);
}

export function Avatar({ name: raw, size = "sm", square }: { name: string; size?: "xs" | "sm" | "md" | "lg"; square?: boolean }) {
  const name = personName(raw);
  const sz = { xs: "size-5 text-[9px]", sm: "size-6 text-[10px]", md: "size-8 text-[11px]", lg: "size-11 text-[15px]" }[size];
  return (
    <span
      title={name}
      className={`inline-flex shrink-0 select-none items-center justify-center font-semibold ${square ? "rounded-lg" : "rounded-full"} ${sz} ${AVATAR_COLORS[hash(name) % AVATAR_COLORS.length]}`}
    >
      {initials(name)}
    </span>
  );
}

// Wahrscheinlichkeit: eine Farbe, die Länge trägt die Information
export function Progress({ value, className = "" }: { value: number; className?: string }) {
  const v = Math.max(0, Math.min(100, value));
  return (
    <div className={`h-1 overflow-hidden rounded-full bg-gray-150 ${className}`} role="meter" aria-valuenow={v} aria-valuemin={0} aria-valuemax={100}>
      <div className="h-full rounded-full bg-brand-500" style={{ width: `${v}%` }} />
    </div>
  );
}

// Kleine Verlaufslinie für Kennzahlen; jeder Punkt hat einen Tooltip
export function Sparkline({ values, labels, className = "h-8 w-28" }: { values: number[]; labels?: string[]; className?: string }) {
  if (values.length < 2) return null;
  const W = 112, H = 32, P = 2;
  const max = Math.max(...values, 1);
  const min = Math.min(...values, 0);
  const x = (i: number) => P + (i * (W - 2 * P)) / (values.length - 1);
  const y = (v: number) => H - P - ((v - min) / (max - min || 1)) * (H - 2 * P);
  const line = values.map((v, i) => `${i ? "L" : "M"}${x(i).toFixed(1)},${y(v).toFixed(1)}`).join("");
  const step = (W - 2 * P) / (values.length - 1);
  return (
    <svg viewBox={`0 0 ${W} ${H}`} className={className} preserveAspectRatio="none" aria-hidden>
      <defs>
        <linearGradient id="spark-fill" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0" stopColor="var(--color-brand-500)" stopOpacity="0.16" />
          <stop offset="1" stopColor="var(--color-brand-500)" stopOpacity="0" />
        </linearGradient>
      </defs>
      <path d={`${line}L${x(values.length - 1)},${H}L${x(0)},${H}Z`} fill="url(#spark-fill)" />
      <path d={line} fill="none" stroke="var(--color-brand-600)" strokeWidth="1.75" strokeLinejoin="round" strokeLinecap="round" vectorEffect="non-scaling-stroke" />
      <circle cx={x(values.length - 1)} cy={y(values[values.length - 1])} r="2.5" fill="var(--color-brand-600)" stroke="#fff" strokeWidth="1.5" />
      {values.map((v, i) => (
        <rect key={i} x={x(i) - step / 2} y={0} width={step} height={H} fill="transparent">
          <title>{`${labels?.[i] ?? ""} ${v}`.trim()}</title>
        </rect>
      ))}
    </svg>
  );
}

