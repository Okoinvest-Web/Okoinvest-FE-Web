def edit(p, pairs):
    s = open(p, encoding="utf-8").read()
    for a, b in pairs:
        if a not in s:
            sys.exit(f"{p}: fehlt {a[:80]!r}")
        s = s.replace(a, b, 1)
    open(p, "w", encoding="utf-8", newline="\n").write(s)

