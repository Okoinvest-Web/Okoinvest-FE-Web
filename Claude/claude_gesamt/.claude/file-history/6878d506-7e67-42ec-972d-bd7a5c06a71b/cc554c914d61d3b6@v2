edit("src/lib/insights.ts", [
    ('''// Verbraucher (kein Firmenname) ohne dokumentierte Einwilligung → keine Werbeanrufe''', '''// ---------- Reaktionszeit (SLA) ----------
// Neue Leads (Status "Neu") müssen binnen 24 h kontaktiert werden – schneller Rückruf ist der stärkste Abschlusshebel.
export const SLA_HOURS = 24;

export type Sla = { state: "ok" | "due" | "breached"; label: string };

export function slaOf(lead: Lead, now = Date.now()): Sla | null {
  if (lead.status !== "Lead") return null;
  const left = (new Date(lead.creation).getTime() + SLA_HOURS * 3_600_000 - now) / 3_600_000;
  if (left < 0) {
    const over = -left;
    return { state: "breached", label: over >= 48 ? `SLA seit ${Math.floor(over / 24)} T überschritten` : `SLA seit ${Math.ceil(over)} h überschritten` };
  }
  return { state: left <= 4 ? "due" : "ok", label: `Erstkontakt in ${Math.max(1, Math.floor(left))} h fällig` };
}

// Verbraucher (kein Firmenname) ohne dokumentierte Einwilligung → keine Werbeanrufe'''),
