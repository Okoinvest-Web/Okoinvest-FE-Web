import { db } from "@/lib/data";
import { relative } from "@/lib/format";
import { MessageSquareText } from "lucide-react";
import { Avatar, Card, CardHeader } from "@/components/ui";
import { NoteComposer } from "@/components/forms";

// Notizen zu einem Datensatz (ERPNext: Comment) – Server-Komponente mit Eingabefeld.
export async function Timeline({ doctype, name }: { doctype: string; name: string }) {
  const notes = await db().listNotes(doctype, name);
  return (
    <Card>
      <CardHeader title="Aktivitäten & Notizen" icon={MessageSquareText} sub={`${notes.length} Einträge`} />
      <div className="p-5">
        <NoteComposer doctype={doctype} name={name} />
        <ol className="relative mt-6 flex flex-col gap-5 before:absolute before:bottom-2 before:left-[13px] before:top-2 before:w-px before:bg-gray-200">
        {notes.map((n) => (
          <li key={n.name} className="relative flex gap-3">
            <Avatar name={n.comment_by ?? n.comment_email} />
            <div className="min-w-0 flex-1">
              <div className="text-xs text-gray-500">
                <span className="font-medium text-gray-900">{n.comment_by ?? n.comment_email}</span> · {relative(n.creation)}
              </div>
              <p className="mt-1.5 whitespace-pre-wrap rounded-lg border border-gray-100 bg-gray-50/80 px-3.5 py-2.5 leading-relaxed text-gray-800">{n.content}</p>
            </div>
          </li>
        ))}
        {notes.length === 0 && <li className="pl-10 text-gray-500">Noch keine Notizen.</li>}
        </ol>
      </div>
    </Card>
  );
}
