import { db } from "@/lib/data";
import { relative } from "@/lib/format";
import { Avatar } from "@/components/ui";
import { NoteComposer } from "@/components/forms";

// Notizen zu einem Datensatz (ERPNext: Comment) – Server-Komponente mit Eingabefeld.
export async function Timeline({ doctype, name }: { doctype: string; name: string }) {
  const notes = await db().listNotes(doctype, name);
  return (
    <div className="grid gap-6">
      <NoteComposer doctype={doctype} name={name} />
      {notes.length === 0 ? (
        <p className="text-gray-500">Noch keine Notizen. Halte Gespräche, Vor-Ort-Termine und Absprachen hier fest.</p>
      ) : (
        <ol className="relative grid gap-5 before:absolute before:bottom-3 before:left-[11px] before:top-3 before:w-px before:bg-gray-200">
          {notes.map((n) => (
            <li key={n.name} className="relative flex gap-3">
              <span className="rounded-full ring-4 ring-white">
                <Avatar name={n.comment_by ?? n.comment_email} />
              </span>
              <div className="min-w-0 flex-1">
                <div className="flex items-baseline gap-2 text-[12px]">
                  <span className="font-medium text-gray-900">{n.comment_by ?? n.comment_email}</span>
                  <span className="text-gray-400">hat eine Notiz hinzugefügt · {relative(n.creation)}</span>
                </div>
                <p className="mt-1.5 whitespace-pre-wrap rounded-lg border border-gray-150 bg-white px-3.5 py-2.5 leading-relaxed text-gray-800 shadow-xs">{n.content}</p>
              </div>
            </li>
          ))}
        </ol>
      )}
    </div>
  );
}
