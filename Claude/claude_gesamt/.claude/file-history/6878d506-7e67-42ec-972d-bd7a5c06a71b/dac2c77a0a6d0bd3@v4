import { History, Mail, MapPin, Phone, StickyNote } from "lucide-react";
import { db } from "@/lib/data";
import { LEAD_STATUS_LABEL, money, personName, relative, STAGE_LABEL } from "@/lib/format";
import { decodeActivity, type ActivityKind } from "@/lib/activity";
import { COUNTRY_LABEL, type Country, type Note, type Version } from "@/lib/types";
import { NoteComposer } from "@/components/forms";

const KIND = {
  note: { icon: StickyNote, verb: "hat eine Notiz hinzugefügt", cls: "bg-gray-100 text-gray-500" },
  call: { icon: Phone, verb: "hat telefoniert", cls: "bg-sky-50 text-sky-600" },
  visit: { icon: MapPin, verb: "war vor Ort", cls: "bg-brand-50 text-brand-700" },
  mail: { icon: Mail, verb: "hat eine E-Mail erfasst", cls: "bg-violet-50 text-violet-600" },
} satisfies Record<ActivityKind, unknown>;

// Negative Ergebnisse dezent rot, damit Nachfassbedarf auffällt
const NEGATIVE = ["Nicht erreicht", "Mailbox", "Abgesagt", "Verschoben"];

// Feldnamen und Werte im Änderungsverlauf lesbar machen
const FIELD: Record<string, string> = {
  status: "Status",
  sales_stage: "Phase",
  probability: "Wahrscheinlichkeit",
  opportunity_amount: "Auftragswert",
  expected_closing: "Abschluss",
  title: "Titel",
  first_name: "Vorname",
  last_name: "Nachname",
  company_name: "Firma",
  email_id: "E-Mail",
  mobile_no: "Mobil",
  territory: "Region",
  source: "Quelle",
  notes: "Bedarf",
  country: "Land",
  custom_consent: "Einwilligung",
  custom_consent_source: "Nachweis Einwilligung",
  lead_owner: "Berater",
  order_lost_reason: "Verlustgrund",
};
const HIDDEN = new Set(["custom_consent_date", "modified", "lead_name"]);

function fmt(field: string, v: string) {
  if (!v) return "leer";
  if (field === "status") return LEAD_STATUS_LABEL[v] ?? v;
  if (field === "sales_stage") return STAGE_LABEL[v] ?? v;
  if (field === "opportunity_amount") return money(Number(v));
  if (field === "probability") return `${v} %`;
  if (field === "country") return COUNTRY_LABEL[v as Country] ?? v;
  if (field === "lead_owner") return personName(v);
  if (field === "expected_closing") return new Date(v).toLocaleDateString("de-DE");
  return v.length > 60 ? `${v.slice(0, 60)} …` : v;
}

type Entry = { at: string; note?: Note; version?: Version };

// Aktivitäten und Änderungsverlauf zu einem Datensatz – Server-Komponente mit Erfassung.
export async function Timeline({ doctype, name }: { doctype: string; name: string }) {
  const [notes, versions] = await Promise.all([db().listNotes(doctype, name), db().listVersions(doctype, name)]);
  const entries: Entry[] = [
    ...notes.map((n) => ({ at: n.creation, note: n })),
    ...versions.filter((v) => v.changes.some(([f]) => !HIDDEN.has(f))).map((v) => ({ at: v.creation, version: v })),
  ].sort((a, b) => b.at.localeCompare(a.at));

  return (
    <div className="grid gap-6">
      <NoteComposer doctype={doctype} name={name} />
      {entries.length === 0 ? (
        <p className="text-gray-500">Noch keine Aktivitäten. Halte Anrufe, Vor-Ort-Termine und Absprachen hier fest.</p>
      ) : (
        <ol className="relative grid gap-5 before:absolute before:bottom-3 before:left-[11px] before:top-3 before:w-px before:bg-gray-200">
          {entries.map((e) => {
            if (e.version) {
              const v = e.version;
              const shown = v.changes.filter(([f]) => !HIDDEN.has(f));
              return (
                <li key={v.name} className="relative flex gap-3">
                  <span className="flex size-6 shrink-0 items-center justify-center rounded-full bg-white text-gray-400 ring-4 ring-white">
                    <History className="size-3.5" />
                  </span>
                  <div className="min-w-0 flex-1 pt-0.5 text-[12px] text-gray-500">
                    <span className="font-medium text-gray-700">{personName(v.owner)}</span> hat{" "}
                    {shown.map(([f, from, to], i) => (
                      <span key={f}>
                        {i > 0 && ", "}
                        <span className="text-gray-700">{FIELD[f] ?? f}</span> von <span className="text-gray-700">{fmt(f, from)}</span> auf{" "}
                        <span className="font-medium text-gray-900">{fmt(f, to)}</span>
                      </span>
                    ))}{" "}
                    geändert · {relative(v.creation)}
                  </div>
                </li>
              );
            }
            const n = e.note!;
            const a = decodeActivity(n.content);
            const k = KIND[a.kind];
            return (
              <li key={n.name} className="relative flex gap-3">
                <span className={`flex size-6 shrink-0 items-center justify-center rounded-full ring-4 ring-white ${k.cls}`}>
                  <k.icon className="size-3" />
                </span>
                <div className="min-w-0 flex-1">
                  <div className="flex flex-wrap items-baseline gap-x-2 text-[12px]">
                    <span className="font-medium text-gray-900">{n.comment_by ?? n.comment_email}</span>
                    <span className="text-gray-500">{k.verb}</span>
                    {a.outcome && (
                      <span className={`rounded border px-1.5 text-[11px] font-medium ${NEGATIVE.includes(a.outcome) ? "border-rose-200 text-rose-700" : "border-gray-200 text-gray-700"}`}>
                        {a.outcome}
                      </span>
                    )}
                    <span className="text-gray-400">· {relative(n.creation)}</span>
                  </div>
                  {a.text && (
                    <p className="mt-1.5 whitespace-pre-wrap rounded-lg border border-gray-150 bg-white px-3.5 py-2.5 leading-relaxed text-gray-800 shadow-xs">{a.text}</p>
                  )}
                </div>
              </li>
            );
          })}
        </ol>
      )}
    </div>
  );
}
