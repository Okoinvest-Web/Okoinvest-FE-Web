import Link from "next/link";
import { notFound } from "next/navigation";
import { CircleCheck, Pencil, Phone, Plus, ShieldAlert } from "lucide-react";
import { db } from "@/lib/data";
import { date, LEAD_STATUS_LABEL, money, personName, STAGE_LABEL } from "@/lib/format";
import { leadHints, needsConsent, parsePv, scoreLead, slaOf } from "@/lib/insights";
import { Avatar, Badge, BTN, Field, PageHeader, Progress, Section, Tabs } from "@/components/ui";
import { LeadStatusSelect } from "@/components/interactive";
import { ConvertLeadButton, ToDoForm } from "@/components/forms";
import { NextSteps, ScorePanel, SlaBadge } from "@/components/Insights";
import { PvCalculator } from "@/components/PvCalculator";
import { EmailMenu } from "@/components/EmailMenu";
import { Timeline } from "@/components/Timeline";
import { TodoList } from "@/components/TodoList";
import { InlineField } from "@/components/editing";
import { updateLeadFieldAction } from "@/lib/actions";
import { CONSENT_SOURCES, COUNTRY_LABEL, LEAD_SOURCES, type Country } from "@/lib/types";

export async function generateMetadata({ params }: PageProps<"/leads/[name]">) {
  const lead = await db().getLead(decodeURIComponent((await params).name));
  return { title: lead?.lead_name ?? "Lead" };
}

export default async function LeadPage({ params, searchParams }: PageProps<"/leads/[name]">) {
  const name = decodeURIComponent((await params).name);
  const sp = await searchParams;
  const tab = sp.tab;
  const unlockedFor = typeof sp.freigeschaltet === "string" ? Number(sp.freigeschaltet) : undefined;
  const lead = await db().getLead(name);
  if (!lead) notFound();

  const [opps, todos] = await Promise.all([
    db().listOpportunities({ filters: { party_name: lead.name } }),
    db().listToDos({ filters: { reference_name: lead.name } }),
  ]);
  const score = scoreLead(lead);
  const hints = leadHints(lead, opps, todos);
  const pv = parsePv([lead.notes, ...opps.map((o) => o.title)].join(" "));
  const base = `/leads/${encodeURIComponent(lead.name)}`;
  const active = typeof tab === "string" && ["aufgaben", "rechner", "aktivitaet"].includes(tab) ? tab : "uebersicht";
  const openTodos = todos.filter((t) => t.status === "Open").length;
  const edit = (field: string) => updateLeadFieldAction.bind(null, lead.name, field);

  return (
    <>
      <PageHeader
        title={lead.lead_name}
        crumbs={[{ href: "/leads", label: "Leads" }]}
        actions={
          <>
            <LeadStatusSelect name={lead.name} status={lead.status} />
            <Link href={`${base}/edit`} className={BTN.secondary}>
              <Pencil /> <span className="hidden sm:inline">Bearbeiten</span>
            </Link>
            {lead.status !== "Converted" && <ConvertLeadButton name={lead.name} label={lead.lead_name} />}
          </>
        }
      />
      <div className="grid grid-cols-1 min-h-0 flex-1 xl:grid-cols-[1fr_320px]">
        <div className="min-w-0 px-4 py-6 sm:px-8 sm:py-7">
          {/* Datensatzkopf */}
          <div className="flex flex-wrap items-center gap-4">
            <Avatar name={lead.lead_name} size="lg" />
            <div className="min-w-0 flex-1">
              <h2 className="flex flex-wrap items-center gap-2 text-[22px] font-semibold tracking-[-0.02em] text-gray-900">
                <span className="truncate">{lead.lead_name}</span>
                <SlaBadge sla={slaOf(lead)} />
              </h2>
              <p className="mt-0.5 truncate text-gray-500">
                {[lead.company_name ?? "Privatkunde", lead.territory, lead.source && `über ${lead.source}`].filter(Boolean).join(" · ")}
              </p>
            </div>
            <div className="flex basis-full gap-2 sm:basis-auto">
              {lead.email_id && (
                <EmailMenu
                  to={lead.email_id}
                  doctype="Lead"
                  name={lead.name}
                  consentMissing={needsConsent(lead)}
                  context={{ name: lead.lead_name, kwp: lead.custom_kwp ?? pv.kwp, advisor: personName(lead.lead_owner) || lead.lead_owner || "", advisorEmail: lead.lead_owner ?? "", title: opps[0]?.title }}
                />
              )}
              {lead.mobile_no && (
                <a
                  href={`tel:${lead.mobile_no.replace(/\s/g, "")}`}
                  className={needsConsent(lead) ? BTN.secondary : BTN.primary}
                  title={needsConsent(lead) ? "Keine dokumentierte Einwilligung – nur anrufen, wenn der Kunde den Rückruf gewünscht hat" : undefined}
                >
                  {needsConsent(lead) ? <ShieldAlert className="text-amber-600" /> : <Phone />} Anrufen
                </a>
              )}
            </div>
          </div>

          {unlockedFor !== undefined && Number.isFinite(unlockedFor) && (
            <div className="mt-6 flex items-center gap-3 rounded-lg border border-brand-200 bg-brand-50 px-4 py-3 text-brand-800">
              <CircleCheck className="size-4" />
              <span>
                Lead freigeschaltet – <strong className="font-semibold">{money(unlockedFor)}</strong> als Lead-Kosten gebucht. Jetzt zügig Kontakt aufnehmen.
              </span>
            </div>
          )}

          {hints.length > 0 && (
            <div className="mt-6">
              <NextSteps hints={hints} />
            </div>
          )}

          <div className="mt-6">
            <Tabs
              base={base}
              active={active}
              tabs={[
                { id: "uebersicht", label: "Übersicht" },
                { id: "aufgaben", label: "Aufgaben", count: openTodos },
                { id: "rechner", label: "PV-Rechner" },
                { id: "aktivitaet", label: "Aktivität" },
              ]}
            />
          </div>

          <div className="pt-6">
            {active === "uebersicht" && (
              <div className="grid grid-cols-1 gap-8">
                <Section title="Bedarf">
                  <div className="max-w-3xl text-gray-700">
                    <InlineField
                      type="textarea"
                      value={lead.notes ?? ""}
                      placeholder="Dachfläche, Ausrichtung, Verbrauch, Wünsche erfassen – z. B. „12 kWp, Speicher 10 kWh“"
                      action={edit("notes")}
                    />
                  </div>
                </Section>

                <Section
                  title="Chancen"
                  count={opps.length}
                  action={
                    <Link href={`/opportunities/new?from=Lead&party=${encodeURIComponent(lead.name)}`} className={BTN.ghost}>
                      <Plus /> Neue Chance
                    </Link>
                  }
                >
                  {opps.length === 0 ? (
                    <p className="text-gray-400">Noch keine Chance zu diesem Lead.</p>
                  ) : (
                    <ul className="divide-y divide-gray-100 rounded-lg border border-gray-200">
                      {opps.map((o) => (
                        <li key={o.name}>
                          <Link href={`/opportunities/${encodeURIComponent(o.name)}`} className="flex h-14 items-center gap-4 px-4 transition-colors hover:bg-gray-50">
                            <div className="min-w-0 flex-1">
                              <div className="truncate font-medium text-gray-900">{o.title}</div>
                              <div className="text-[12px] text-gray-500">
                                {STAGE_LABEL[o.sales_stage]} · Abschluss {date(o.expected_closing)}
                              </div>
                            </div>
                            <div className="hidden w-28 items-center gap-2 sm:flex">
                              <Progress value={o.probability} className="flex-1" />
                              <span className="tnum w-8 text-right text-[12px] text-gray-500">{o.probability} %</span>
                            </div>
                            <span className="tnum w-24 text-right font-medium text-gray-900">{money(o.opportunity_amount, o.currency)}</span>
                          </Link>
                        </li>
                      ))}
                    </ul>
                  )}
                </Section>
              </div>
            )}

            {active === "aufgaben" && (
              <div className="grid grid-cols-1 gap-4">
                <ToDoForm referenceType="Lead" referenceName={lead.name} compact />
                <div className="overflow-hidden rounded-lg border border-gray-200">
                  <TodoList todos={todos} />
                </div>
              </div>
            )}

            {active === "rechner" && <PvCalculator kwp={pv.kwp} storage={pv.storage} invest={opps[0]?.opportunity_amount} country={lead.country} sheetHref={`/kundenblatt/lead/${encodeURIComponent(lead.name)}`} />}

            {active === "aktivitaet" && <Timeline doctype="Lead" name={lead.name} />}
          </div>
        </div>

        {/* Eigenschaften */}
        <aside className="border-t border-gray-150 bg-gray-25 px-6 py-7 xl:border-l xl:border-t-0">
          <ScorePanel s={score} />
          <div className="my-6 h-px bg-gray-150" />
          <div className="mb-2 text-[12px] font-medium text-gray-500">Eigenschaften</div>
          <dl>
            <Field label="Status">
              <Badge value={lead.status} label={LEAD_STATUS_LABEL[lead.status]} />
            </Field>
            <Field label="E-Mail">
              <InlineField type="email" value={lead.email_id ?? ""} action={edit("email_id")} />
            </Field>
            <Field label="Mobil">
              <InlineField type="tel" value={lead.mobile_no ?? ""} action={edit("mobile_no")} />
            </Field>
            <Field label="Firma">
              <InlineField value={lead.company_name ?? ""} placeholder="Privat" action={edit("company_name")} />
            </Field>
            <Field label="Land">
              <InlineField
                type="select"
                value={lead.country ?? "Germany"}
                options={(Object.keys(COUNTRY_LABEL) as Country[]).map((c) => ({ value: c, label: COUNTRY_LABEL[c] }))}
                action={edit("country")}
              />
            </Field>
            <Field label="Einwilligung">
              <InlineField
                type="select"
                value={lead.custom_consent ?? ""}
                options={[
                  { value: "Ja", label: "Ja – liegt vor" },
                  { value: "Nein", label: "Nein" },
                ]}
                display={
                  lead.custom_consent === "Ja" ? (
                    <span className="text-brand-700">Ja · seit {date(lead.custom_consent_date)}</span>
                  ) : lead.custom_consent === "Nein" ? (
                    <span className="text-rose-600">Nein</span>
                  ) : undefined
                }
                placeholder="Nicht erfasst"
                action={edit("custom_consent")}
              />
            </Field>
            {lead.custom_consent === "Ja" && (
              <Field label="Nachweis">
                <InlineField
                  type="select"
                  value={lead.custom_consent_source ?? ""}
                  options={CONSENT_SOURCES.map((s) => ({ value: s, label: s }))}
                  placeholder="Quelle ergänzen"
                  action={edit("custom_consent_source")}
                />
              </Field>
            )}
            <Field label="Quelle">
              <InlineField type="select" value={lead.source ?? ""} options={LEAD_SOURCES.map((s) => ({ value: s, label: s }))} action={edit("source")} />
            </Field>
            <Field label="Region">
              <InlineField value={lead.territory ?? ""} action={edit("territory")} />
            </Field>
            <Field label="Berater">
              {lead.lead_owner && (
                <span className="flex items-center gap-2">
                  <Avatar name={lead.lead_owner} size="xs" /> {personName(lead.lead_owner)}
                </span>
              )}
            </Field>
            <Field label="Angelegt">{date(lead.creation)}</Field>
            <Field label="Geändert">{date(lead.modified)}</Field>
            <Field label="ID">
              <span className="font-mono text-[12px] text-gray-500">{lead.name}</span>
            </Field>
          </dl>
        </aside>
      </div>
    </>
  );
}
