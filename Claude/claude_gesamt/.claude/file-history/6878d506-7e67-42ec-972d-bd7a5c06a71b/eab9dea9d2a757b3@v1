"use client";

import Link from "next/link";
import { useOptimistic, useState, useTransition } from "react";
import { setOpportunityStageAction } from "@/lib/actions";
import { money, date, STAGE_LABEL } from "@/lib/format";
import type { Opportunity } from "@/lib/types";
import { Avatar, Progress } from "@/components/ui";
import { CalendarDays } from "lucide-react";
import { HealthDot } from "@/components/Insights";
import type { DealHealth } from "@/lib/insights";

// Kopfstreifen je Phase: heller (früh) bis kräftig grün (kurz vor Abschluss)
const STAGE_BAR = ["bg-brand-100", "bg-brand-200", "bg-brand-300", "bg-brand-400", "bg-brand-600"];

// Chancen per Drag & Drop zwischen Vertriebsphasen verschieben.
export function Kanban({ stages, items, health }: { stages: readonly string[]; items: Opportunity[]; health: Record<string, DealHealth> }) {
  const [, start] = useTransition();
  const [over, setOver] = useState<string | null>(null);
  const [opps, move] = useOptimistic(items, (state, { name, stage }: { name: string; stage: string }) =>
    state.map((o) => (o.name === name ? { ...o, sales_stage: stage } : o)),
  );

  function drop(stage: string, name: string) {
    setOver(null);
    const current = opps.find((o) => o.name === name);
    if (!current || current.sales_stage === stage) return;
    start(async () => {
      move({ name, stage });
      await setOpportunityStageAction(name, stage);
    });
  }

  return (
    <div className="flex min-h-0 flex-1 gap-3 overflow-x-auto px-6 py-6">
      {stages.map((stage, idx) => {
        const col = opps.filter((o) => o.sales_stage === stage);
        const sum = col.reduce((s, o) => s + o.opportunity_amount, 0);
        return (
          <section
            key={stage}
            onDragOver={(e) => {
              e.preventDefault();
              setOver(stage);
            }}
            onDragLeave={() => setOver((s) => (s === stage ? null : s))}
            onDrop={(e) => drop(stage, e.dataTransfer.getData("text/plain"))}
            className={`flex min-w-[208px] flex-1 basis-0 flex-col rounded-xl border p-1.5 transition-colors ${over === stage ? "border-brand-300 bg-brand-50" : "border-gray-200/70 bg-gray-100/60"}`}
          >
            <div className="px-2 pb-3 pt-1.5">
              <div className={`mb-2.5 h-1 rounded-full ${STAGE_BAR[idx % STAGE_BAR.length]}`} />
              <div className="flex items-center justify-between">
                <h2 className="font-semibold text-gray-900">{STAGE_LABEL[stage] ?? stage}</h2>
                <span className="rounded-full bg-white px-2 py-0.5 text-xs font-medium text-gray-600 ring-1 ring-gray-200">{col.length}</span>
              </div>
              <div className="mt-0.5 text-xs font-medium tabular-nums text-gray-500">{money(sum)}</div>
            </div>
            <div className="flex min-h-24 flex-col gap-2">
              {col.map((o) => (
                <Link
                  key={o.name}
                  href={`/opportunities/${encodeURIComponent(o.name)}`}
                  draggable
                  onDragStart={(e) => e.dataTransfer.setData("text/plain", o.name)}
                  className="group cursor-grab rounded-lg border border-gray-200/80 bg-white p-3 shadow-card transition hover:-translate-y-px hover:border-brand-300 hover:shadow-md active:cursor-grabbing"
                >
                  <div className="flex items-start justify-between gap-2">
                    <div className="min-w-0">
                      <div className="text-[13px] font-medium leading-snug text-gray-900 group-hover:text-brand-800">{o.title ?? o.name}</div>
                      <div className="mt-0.5 truncate text-xs text-gray-500">{o.customer_name ?? o.party_name}</div>
                    </div>
                    {o.opportunity_owner && <Avatar name={o.opportunity_owner} />}
                  </div>
                  <div className="mt-3 text-base font-semibold tabular-nums text-gray-900">{money(o.opportunity_amount, o.currency)}</div>
                  <div className="mt-2 flex items-center gap-2">
                    <Progress value={o.probability} className="flex-1" />
                    <span className="w-9 text-right text-xs font-medium tabular-nums text-gray-600">{o.probability} %</span>
                  </div>
                  <div className="mt-2.5 flex items-center justify-between gap-2 border-t border-gray-100 pt-2.5">
                    <span className="flex items-center gap-1.5 text-xs text-gray-500">
                      <CalendarDays className="size-3.5" /> {date(o.expected_closing)}
                    </span>
                    {health[o.name] && <HealthDot h={health[o.name]} />}
                  </div>
                </Link>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  );
}
