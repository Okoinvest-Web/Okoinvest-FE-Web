"use client";

import Link from "next/link";
import { usePathname } from "next/navigation";
import { Building2, CheckSquare, Contact, Handshake, LayoutDashboard, LogOut, Search, Users } from "lucide-react";
import { logoutAction } from "@/lib/actions";
import { initials } from "@/lib/format";
import type { SessionUser } from "@/lib/types";

const NAV = [
  { href: "/", label: "Übersicht", icon: LayoutDashboard },
  { href: "/leads", label: "Leads", icon: Users },
  { href: "/opportunities", label: "Chancen", icon: Handshake },
  { href: "/customers", label: "Kunden", icon: Building2 },
  { href: "/contacts", label: "Kontakte", icon: Contact },
  { href: "/todos", label: "Aufgaben", icon: CheckSquare },
];

export function Sidebar({ source, user }: { source: "mock" | "erpnext"; user: SessionUser }) {
  const pathname = usePathname();

  return (
    <aside className="flex w-56 shrink-0 flex-col border-r border-gray-200 bg-gray-50">
      <div className="flex h-12 items-center gap-2 px-4">
        <div className="flex size-6 items-center justify-center rounded-md bg-gray-900 text-xs font-semibold text-white">C</div>
        <span className="font-semibold text-gray-900">CRM</span>
      </div>
      <div className="px-2">
        <button
          onClick={() => window.dispatchEvent(new Event("open-search"))}
          className="flex w-full items-center gap-2.5 rounded-md border border-gray-200 bg-white px-2.5 py-1.5 text-gray-500 hover:text-gray-900"
        >
          <Search className="size-4" strokeWidth={1.75} />
          Suchen
          <kbd className="ml-auto rounded border border-gray-200 px-1 text-[10px]">Strg K</kbd>
        </button>
      </div>
      <nav className="flex flex-col gap-0.5 px-2 py-2">
        {NAV.map(({ href, label, icon: Icon }) => {
          const active = href === "/" ? pathname === "/" : pathname.startsWith(href);
          return (
            <Link
              key={href}
              href={href}
              className={`flex items-center gap-2.5 rounded-md px-2.5 py-1.5 ${
                active ? "bg-white font-medium text-gray-900 shadow-sm ring-1 ring-gray-200" : "text-gray-600 hover:bg-gray-100 hover:text-gray-900"
              }`}
            >
              <Icon className="size-4" strokeWidth={1.75} />
              {label}
            </Link>
          );
        })}
      </nav>
      <div className="mt-auto flex flex-col gap-2 p-3">
        <div
          className={`rounded-md px-2.5 py-2 text-xs ${
            source === "mock" ? "bg-amber-50 text-amber-800 ring-1 ring-amber-200" : "bg-green-50 text-green-800 ring-1 ring-green-200"
          }`}
        >
          {source === "mock" ? "Demo-Modus: Beispieldaten" : "Verbunden mit ERPNext"}
        </div>
        <div className="flex items-center gap-2 px-1">
          <span className="inline-flex size-7 shrink-0 items-center justify-center rounded-full bg-gray-200 text-[11px] font-medium text-gray-700">
            {initials(user.fullName)}
          </span>
          <div className="min-w-0 flex-1">
            <div className="truncate text-sm font-medium text-gray-900">{user.fullName}</div>
            <div className="truncate text-xs text-gray-500">{user.user}</div>
          </div>
          <form action={logoutAction}>
            <button title="Abmelden" className="rounded-md p-1.5 text-gray-500 hover:bg-gray-200 hover:text-gray-900">
              <LogOut className="size-4" />
            </button>
          </form>
        </div>
      </div>
    </aside>
  );
}
