"use client";

import Link from "next/link";
import { usePathname } from "next/navigation";
import { Building2, CheckSquare, Contact, Handshake, LayoutDashboard, LogOut, Search, Sun, Users } from "lucide-react";
import { logoutAction } from "@/lib/actions";
import { initials } from "@/lib/format";
import type { SessionUser } from "@/lib/types";
import { LogoMark } from "@/components/ui";

const NAV = [
  { group: "Vertrieb", items: [
    { href: "/", label: "Übersicht", icon: LayoutDashboard },
    { href: "/leads", label: "Leads", icon: Users },
    { href: "/opportunities", label: "Chancen", icon: Handshake },
    { href: "/todos", label: "Aufgaben", icon: CheckSquare },
  ] },
  { group: "Stammdaten", items: [
    { href: "/customers", label: "Kunden", icon: Building2 },
    { href: "/contacts", label: "Kontakte", icon: Contact },
  ] },
];

export function Sidebar({ source, user }: { source: "mock" | "erpnext"; user: SessionUser }) {
  const pathname = usePathname();

  return (
    <aside className="relative flex w-64 shrink-0 flex-col overflow-hidden bg-brand-950 text-brand-100">
      {/* dezenter Sonnenschein oben */}
      <div className="pointer-events-none absolute -left-16 -top-24 size-64 rounded-full bg-sun-400/10 blur-3xl" />

      <div className="relative flex h-[72px] items-center gap-2.5 px-5">
        <LogoMark className="size-9" />
        <div className="leading-tight">
          <div className="text-[15px] font-semibold tracking-tight text-white">Ökovolt</div>
          <div className="text-[10.5px] font-medium uppercase tracking-[0.16em] text-brand-300">Vertrieb · CRM</div>
        </div>
      </div>

      <div className="relative px-3">
        <button
          onClick={() => window.dispatchEvent(new Event("open-search"))}
          className="flex w-full items-center gap-2.5 rounded-lg bg-white/[0.06] px-3 py-2 text-brand-200/80 ring-1 ring-white/10 transition hover:bg-white/10 hover:text-white"
