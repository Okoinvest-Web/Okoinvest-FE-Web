            <div className="flex flex-col gap-0.5">
              {g.items.map(({ href, label, icon: Icon }) => {
                const active = href === "/" ? pathname === "/" : pathname.startsWith(href);
                return (
                  <Link
                    key={href}
                    href={href}
                    className={`group relative flex items-center gap-3 rounded-lg px-3 py-2 transition-colors ${
                      active ? "bg-white/10 font-medium text-white" : "text-brand-100/75 hover:bg-white/[0.05] hover:text-white"
                    }`}
                  >
                    {active && <span className="absolute inset-y-2 left-0 w-[3px] rounded-r bg-sun-400" />}
                    <Icon className={`size-[18px] ${active ? "text-sun-300" : "text-brand-300/70 group-hover:text-brand-200"}`} strokeWidth={1.75} />
                    {label}
                  </Link>
                );
              })}
            </div>
          </div>
        ))}
      </nav>

      <div className="relative mt-auto flex flex-col gap-3 p-3">
