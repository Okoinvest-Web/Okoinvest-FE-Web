            <div className="truncate text-sm font-medium text-white">{user.fullName}</div>
            <div className="truncate text-xs text-brand-300/80">{user.user}</div>
          </div>
          <form action={logoutAction}>
            <button title="Abmelden" className="rounded-md p-2 text-brand-300 transition hover:bg-white/10 hover:text-white">
              <LogOut className="size-4" />
