"use client";

import { useRef, useTransition } from "react";
import { LockOpen } from "lucide-react";
import { unlockLeadAction } from "@/lib/actions";
import { money } from "@/lib/format";
import { BTN } from "@/components/ui";
import { toast } from "@/components/Toaster";

// Freischaltung mit ausdrücklicher Bestätigung des Preises – die Buchung ist kostenpflichtig
export function UnlockButton({ name, price, summary }: { name: string; price: number; summary: string }) {
  const [pending, start] = useTransition();
  const dialog = useRef<HTMLDialogElement>(null);

  function confirm() {
    start(async () => {
      try {
        const res = await unlockLeadAction(name);
        if (res?.error) {
          dialog.current?.close();
          toast(res.error, "error");
        }
      } catch (e) {
        // redirect() nach erfolgreicher Freischaltung wirft absichtlich
        if (e instanceof Error && !e.message.includes("NEXT_REDIRECT")) toast(e.message, "error");
        else throw e;
      }
    });
  }

  return (
    <>
      <button type="button" onClick={() => dialog.current?.showModal()} className={`${BTN.primary} w-full`}>
        <LockOpen /> Für {money(price)} freischalten
      </button>
      <dialog ref={dialog} className="fade-in m-auto w-[calc(100%-32px)] max-w-sm rounded-xl border border-gray-200 bg-white p-0 text-[13px] text-gray-900 shadow-pop backdrop:bg-gray-950/25">
        <div className="px-5 pt-5">
          <h2 className="text-[15px] font-semibold">Lead freischalten?</h2>
          <p className="mt-1 text-gray-600">{summary}</p>
          <div className="mt-4 flex items-baseline justify-between rounded-lg border border-gray-200 bg-gray-50 px-3 py-2.5">
            <span className="text-gray-600">Lead-Kosten</span>
            <span className="tnum text-[18px] font-semibold">{money(price)}</span>
          </div>
          <p className="mt-3 text-[12px] text-gray-500">
            Der Betrag wird dir als Lead-Kosten gebucht und mit deiner Provision verrechnet. Danach siehst du Name und Kontaktdaten.
          </p>
        </div>
        <div className="mt-4 flex justify-end gap-2 border-t border-gray-150 px-5 py-3">
          <button type="button" onClick={() => dialog.current?.close()} className={BTN.secondary}>
            Abbrechen
          </button>
          <button type="button" disabled={pending} onClick={confirm} className={BTN.primary}>
            {pending ? "Wird gebucht …" : `Kostenpflichtig freischalten`}
          </button>
        </div>
      </dialog>
    </>
  );
}
