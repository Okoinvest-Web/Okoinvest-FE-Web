import Link from "next/link";
import { notFound } from "next/navigation";
import { Contact, FileText, Globe, Handshake, Mail, MapPin, Phone, Plus } from "lucide-react";
import { db } from "@/lib/data";
import { date, LEAD_STATUS_LABEL, money, STAGE_LABEL } from "@/lib/format";
import { Avatar, Badge, BTN, Card, CardHeader, Field, PageBody, PageHeader } from "@/components/ui";
import { Timeline } from "@/components/Timeline";

export async function generateMetadata({ params }: PageProps<"/customers/[name]">) {
  const c = await db().getCustomer(decodeURIComponent((await params).name));
  return { title: c?.customer_name ?? "Kunde" };
}

export default async function CustomerPage({ params }: PageProps<"/customers/[name]">) {
  const customer = await db().getCustomer(decodeURIComponent((await params).name));
  if (!customer) notFound();

  const [opps, contacts] = await Promise.all([
    db().listOpportunities({ filters: { customer_name: customer.customer_name } }),
    db().listContacts({ filters: { company_name: customer.customer_name } }),
  ]);
  const won = opps.filter((o) => o.status === "Converted").reduce((s, o) => s + o.opportunity_amount, 0);
  const isCompany = customer.customer_type === "Company";

  return (
    <>
      <PageHeader
        title={customer.customer_name}
        crumbs={[{ href: "/customers", label: "Kunden" }]}
        actions={
          <Link href={`/opportunities/new?from=Customer&party=${encodeURIComponent(customer.name)}`} className={BTN.primary}>
            <Plus className="size-4" /> Neue Chance
          </Link>
        }
      />
      <PageBody className="grid items-start gap-6 xl:grid-cols-[1fr_340px]">
        <div className="grid min-w-0 gap-6">
          <Card className="overflow-hidden">
            <div className="flex flex-wrap items-center gap-4 px-6 py-5">
              <span>
                <Avatar name={customer.customer_name} size="lg" />
              </span>
              <div className="min-w-0 flex-1">
                <div className="flex items-center gap-2">
                  <h2 className="text-lg font-semibold text-gray-900">{customer.customer_name}</h2>
                  <Badge value={customer.customer_type} label={isCompany ? "Firma" : "Privatperson"} tone={isCompany ? "blue" : "violet"} />
                </div>
                <p className="flex flex-wrap items-center gap-x-3 text-sm text-gray-500">
                  <span>{customer.customer_group}</span>
                  <span className="inline-flex items-center gap-1">
                    <MapPin className="size-3.5" /> {customer.territory}
                  </span>
                </p>
              </div>
              <div className="flex gap-2">
                {customer.email_id && (
                  <a href={`mailto:${customer.email_id}`} className={BTN.secondary}>
                    <Mail className="size-4 text-brand-600" /> E-Mail
                  </a>
                )}
                {customer.mobile_no && (
                  <a href={`tel:${customer.mobile_no.replace(/\s/g, "")}`} className={BTN.primary}>
                    <Phone className="size-4" /> Anrufen
                  </a>
                )}
              </div>
            </div>
            <div className="grid grid-cols-3 divide-x divide-gray-100 border-t border-gray-100">
              <div className="px-6 py-3">
                <div className="text-xs text-gray-500">Chancen</div>
                <div className="text-lg font-semibold tabular-nums">{opps.length}</div>
              </div>
              <div className="px-6 py-3">
                <div className="text-xs text-gray-500">Umsatz gewonnen</div>
                <div className="text-lg font-semibold tabular-nums">{money(won)}</div>
              </div>
              <div className="px-6 py-3">
                <div className="text-xs text-gray-500">Kunde seit</div>
                <div className="text-lg font-semibold">{date(customer.creation)}</div>
              </div>
            </div>
          </Card>

          <Card>
            <CardHeader title="Chancen" icon={Handshake} />
            {opps.length === 0 ? (
              <p className="px-5 py-8 text-center text-gray-500">Keine Chancen.</p>
            ) : (
              <ul className="divide-y divide-gray-100">
                {opps.map((o) => (
                  <li key={o.name}>
                    <Link href={`/opportunities/${encodeURIComponent(o.name)}`} className="flex items-center gap-4 px-5 py-3 transition-colors hover:bg-gray-50/70">
                      <div className="min-w-0 flex-1">
                        <div className="font-medium text-gray-900">{o.title}</div>
                        <div className="text-xs text-gray-500">{STAGE_LABEL[o.sales_stage]}</div>
                      </div>
                      <Badge value={o.status} label={LEAD_STATUS_LABEL[o.status]} />
                      <span className="w-28 text-right font-semibold tabular-nums">{money(o.opportunity_amount, o.currency)}</span>
                    </Link>
                  </li>
                ))}
              </ul>
            )}
          </Card>

          <Card>
            <CardHeader title="Ansprechpartner" icon={Contact} />
            {contacts.length === 0 ? (
              <p className="px-5 py-8 text-center text-gray-500">Keine Kontakte.</p>
            ) : (
              <ul className="divide-y divide-gray-100">
                {contacts.map((c) => (
                  <li key={c.name} className="flex items-center gap-3 px-5 py-3">
                    <Avatar name={c.full_name} size="md" />
                    <div className="min-w-0 flex-1">
                      <div className="font-medium text-gray-900">{c.full_name}</div>
                      <div className="text-xs text-gray-500">{c.designation ?? "–"}</div>
                    </div>
                    {c.email_id && (
                      <a href={`mailto:${c.email_id}`} className="text-sm text-gray-600 hover:text-brand-700 hover:underline">
                        {c.email_id}
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </Card>

          <Timeline doctype="Customer" name={customer.name} />
        </div>

        <Card>
          <CardHeader title="Details" icon={FileText} />
          <dl className="px-5 py-2">
            <Field label="Typ">{isCompany ? "Firma" : "Privatperson"}</Field>
            <Field label="Gruppe">{customer.customer_group}</Field>
            <Field label="Region">{customer.territory}</Field>
            <Field label="E-Mail">{customer.email_id}</Field>
            <Field label="Telefon">{customer.mobile_no}</Field>
            <Field label="Website">
              {customer.website && (
                <a href={customer.website} target="_blank" rel="noreferrer" className="inline-flex items-center gap-1 text-brand-700 hover:underline">
                  <Globe className="size-3.5" />
                  {customer.website.replace(/^https?:\/\//, "")}
                </a>
              )}
            </Field>
            <Field label="Kunde seit">{date(customer.creation)}</Field>
          </dl>
        </Card>
      </PageBody>
    </>
  );
}
