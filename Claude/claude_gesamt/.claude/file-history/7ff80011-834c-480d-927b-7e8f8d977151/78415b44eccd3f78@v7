<tr><td>Aufsichtsbeschwerde</td><td>Heuking (DE)</td><td>Entgegennahme, Speicherung, Auswertung, ungeschwärzte Vorlage</td><td class="n">20 Mio. oder 4 %</td></tr>
<tr><td>Aufsichtsbeschwerde</td><td>DORDA (AT)</td><td>soweit dasselbe Urteil in österreichischen Verfahren eingebracht wurde</td><td class="n">20 Mio. oder 4 %</td></tr>
<tr><td>Strafanzeige</td><td>natürliche Personen</td><td>§ 63 DSG — Datenverarbeitung in Gewinn- oder Schädigungsabsicht</td><td class="n">1 Jahr Freiheitsstrafe oder 720 Tagessätze</td></tr>
<tr><td>Verbandsverantwortlichkeit</td><td>Salzburg AG und Berufsausübungsgesellschaften</td><td>VbVG bei Anlasstat nach § 63 DSG</td><td class="n">55 × EUR 30.000 = EUR 1,65 Mio.</td></tr>
<tr><td>Schadenersatz</td><td>alle Verantwortlichen, gesamtschuldnerisch</td><td>Art. 82 DSGVO, Abs 4 für die Solidarhaftung</td><td class="n">ohne gesetzliche Höchstgrenze</td></tr>
