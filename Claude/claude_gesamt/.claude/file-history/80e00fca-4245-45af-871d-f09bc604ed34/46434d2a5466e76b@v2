<section class="hero">
  <div class="wrap hero-in">
    <div class="hero-grid">
      <div>
        <span class="kicker s">Direktvermarktung</span>
        <h1>Ihr Überschuss ist nicht <span class="gl">gleich viel wert</span> wie der Jahresmittelpreis.</h1>
        <p class="lede">Photovoltaik erzeugt dann, wenn viele erzeugen. Genau deshalb liegt der erzielbare Marktwert unter dem Durchschnitt. Wie weit darunter, entscheidet die Ausrichtung Ihrer Anlage.</p>
        <div class="hero-acts">
          <a class="btn btn-v" href="#tool">Erlös berechnen</a>
          <a class="btn btn-o" href="#details">Vertragsformen</a>
        </div>
      </div>
      <div class="chips">
        <div class="chip s"><div><i>Marktwertfaktor</i><p>Erzielter Preis im Verhältnis zum Mittel</p></div><b>0,78–0,95</b></div>
        <div class="chip c"><div><i>Ost-West-Bonus</i><p>Höherer Marktwert durch flachere Mittagsspitze</p></div><b>+6–10<span class="unit">%</span></b></div>
        <div class="chip v"><div><i>Abrechnung</i><p>Viertelstundenscharf über den Bilanzkreis</p></div><b>15<span class="unit">min</span></b></div>
      </div>
    </div>
  </div>
</section>

<section class="sec" id="tool">
  <div class="wrap">
    <div class="sec-head">
      <div><span class="kicker">Erlösrechner</span><h2>Marktpreis gegen fixen Abnahmepreis.</h2></div>
      <p class="lede">Der Rechner bewertet jede Kilowattstunde mit dem Preis des Monats, in dem sie anfällt, und gewichtet sie mit dem Marktwertfaktor Ihrer Ausrichtung.</p>
    </div>

    <div class="console glass chamf">
      <div class="con-t"><span><span class="pulse"></span>Erlösprognose · Jahr</span><span id="stamp">Ausrichtung: Süd</span></div>
      <div class="con-l">
        <div class="field">
          <div class="field-h"><label for="kwp">Anlagenleistung</label><span class="field-v" id="v-kwp">500<span class="unit">kWp</span></span></div>
          <input id="kwp" type="range" min="30" max="5000" step="10" value="500">
          <div class="scale"><span>30</span><span>5.000 kWp</span></div>
        </div>
        <div class="field">
          <span class="lbl" id="al">Ausrichtung</span>
          <div class="seg" role="group" aria-labelledby="al">
            <button type="button" data-a="sued" aria-pressed="true">Süd · steile Mittagsspitze</button>
            <button type="button" data-a="ow" aria-pressed="false">Ost-West · breites Profil</button>
            <button type="button" data-a="track" aria-pressed="false">Nachgeführt · flach</button>
          </div>
        </div>
        <div class="field">
          <div class="field-h"><label for="lvl">Marktpreisniveau</label><span class="field-v" id="v-lvl">85<span class="unit">€/MWh</span></span></div>
          <input id="lvl" type="range" min="15" max="220" step="5" value="85">
          <div class="scale"><span>15</span><span>220 €/MWh</span></div>
        </div>
        <div class="field">
          <div class="field-h"><label for="fee">Vermarktungsentgelt</label><span class="field-v" id="v-fee">3,0<span class="unit">€/MWh</span></span></div>
          <input id="fee" type="range" min="0.5" max="8" step="0.5" value="3">
          <div class="scale"><span>0,5</span><span>8 €/MWh</span></div>
        </div>
        <div class="field">
          <div class="field-h"><label for="fix">Fixer Abnahmepreis</label><span class="field-v" id="v-fix">7,0<span class="unit">ct/kWh</span></span></div>
          <input id="fix" type="range" min="2" max="20" step="0.5" value="7">
          <div class="scale"><span>2</span><span>20 ct/kWh</span></div>
        </div>
        <details class="as">
          <summary>Rechenannahmen</summary>
          <ul>
            <li>Spezifischer Ertrag 1.030 bis 1.180 kWh/kWp je Ausrichtung</li>
            <li>Monatliche Preisindizes mit Winterhoch und Sommertief</li>
            <li>Marktwertfaktor Süd 0,82, Ost-West 0,90, nachgeführt 0,93</li>
            <li>Vollständige Einspeisung ohne Eigenverbrauchsanteil</li>
            <li>Ohne Ausgleichsenergiekosten und Prognoseabweichungen</li>
            <li>Ohne Marktprämie oder sonstige Zuschüsse</li>
          </ul>
        </details>
      </div>

      <div class="con-r">
        <div class="stats">
          <div class="stat s"><i>Jahresertrag</i><b id="o-y">—<span class="unit">MWh</span></b><small id="o-spec">—</small></div>
          <div class="stat"><i>Erzielter Marktwert</i><b id="o-mw">—<span class="unit">€/MWh</span></b><small id="o-mwf">Faktor —</small></div>
          <div class="stat s"><i>Erlös Direktvermarktung</i><b id="o-dv">—<span class="unit">€/a</span></b><small id="o-dv2">nach Entgelt</small></div>
          <div class="stat"><i>Erlös Fixabnahme</i><b id="o-fx">—<span class="unit">€/a</span></b><small id="o-fx2">—</small></div>
          <div class="stat v"><i>Differenz</i><b id="o-diff">—<span class="unit">€/a</span></b><small id="o-diff2">—</small></div>
          <div class="stat c"><i>Break-even Marktpreis</i><b id="o-be">—<span class="unit">€/MWh</span></b><small>ab hier lohnt der Markt</small></div>
        </div>

        <div class="panel dk">
          <div class="panel-h"><h4>Monatserlös im Vergleich</h4><span id="c-note">—</span></div>
          <svg id="ch" viewBox="0 0 760 220" role="img" aria-label="Monatlicher Erlös aus Direktvermarktung gegenüber fixer Abnahme"></svg>
          <div class="legend">
            <span><i style="background:#FFB43D"></i>Direktvermarktung</span>
            <span><i style="background:#3A4C66"></i>Fixer Abnahmepreis</span>
          </div>
        </div>

        <div class="panel">
          <div class="panel-h"><h4>Erzeugung und Preisniveau im Jahresverlauf</h4><span id="c-cap">—</span></div>
          <svg id="cap" viewBox="0 0 760 170" role="img" aria-label="Monatliche Erzeugung und Preisindex"></svg>
          <div class="legend">
            <span><i style="background:#8CE04B"></i>Anteil am Jahresertrag</span>
            <span><i style="background:#45E0FF;height:3px"></i>Preisindex</span>
          </div>
        </div>
        <p class="fine">Der Marktwertfaktor ist ein Erfahrungswert und schwankt mit dem Ausbaustand der Photovoltaik im Netzgebiet. Verbindliche Konditionen nennt Ihr Vermarkter.</p>
      </div>
    </div>
  </div>
</section>

<section class="sec" id="details">
  <div class="wrap">
    <div class="sec-head">
      <div><span class="kicker c">Vertragsformen</span><h2>Drei Wege, den Überschuss zu verkaufen.</h2></div>
      <p class="lede">Welcher passt, hängt von der Risikobereitschaft ab und davon, ob die Anlage über Fremdkapital finanziert ist. Banken bewerten planbare Erlöse anders als Marktpreise.</p>
    </div>
    <div class="cards">
      <article class="card">
        <span class="n">WEG A</span>
        <svg class="ic" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 24 11 14l5 6 6-11 6 9"/><path d="M4 28h24"/></svg>
        <h3>Spotmarkt ungesichert</h3>
        <p>Der Erlös folgt dem Stundenpreis der Börse. Höchste Chance, höchstes Risiko. Sinnvoll für Betriebe, die Schwankungen tragen können und keine feste Tilgung bedienen müssen.</p>
        <ul><li>Abrechnung viertelstundenscharf</li><li>Erlös schwankt monatlich</li><li>Kurze Kündigungsfristen üblich</li></ul>
      </article>
      <article class="card">
        <span class="n">WEG B</span>
        <svg class="ic" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="5" y="6" width="22" height="20"/><path d="M10 16h12M16 10v12"/></svg>
        <h3>Abnahmevertrag mit Fixpreis</h3>
        <p>Ein fester Preis über mehrere Jahre. Der Erlös ist planbar und finanzierungsfreundlich, liegt im Schnitt aber unter dem, was der Markt in guten Jahren hergibt.</p>
        <ul><li>Laufzeit meist fünf bis fünfzehn Jahre</li><li>Bonität des Abnehmers prüfen</li><li>Mengenrisiko klar regeln</li></ul>
      </article>
      <article class="card">
        <span class="n">WEG C</span>
        <svg class="ic" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 26V10M16 26V5M26 26v-9"/><path d="M3 29h26"/></svg>
        <h3>Gemischte Vermarktung</h3>
        <p>Ein Teil der Menge fix abgesichert, der Rest am Markt. In der Praxis die häufigste Lösung, weil sie die Tilgung absichert und trotzdem an guten Preisen teilnimmt.</p>
        <ul><li>Absicherungsquote nach Tilgungsplan</li><li>Jährliche Anpassung möglich</li><li>Preisobergrenze verhandelbar</li></ul>
      </article>
    </div>
  </div>
</section>

<section class="sec" id="faq">
  <div class="wrap">
    <div class="sec-head"><div><span class="kicker">Häufige Fragen</span><h2>Fragen zur Vermarktung.</h2></div></div>
    <div class="faq">
      <details class="qa" open><summary>Warum liegt der Marktwert unter dem Durchschnittspreis?</summary><p>Weil alle Photovoltaikanlagen zur selben Zeit erzeugen. In den Mittagsstunden ist das Angebot am größten und der Preis am niedrigsten. Der Marktwertfaktor misst genau diesen Effekt: Er setzt den mengengewichteten Erlös ins Verhältnis zum einfachen Durchschnitt.</p></details>
      <details class="qa"><summary>Bringt eine Ost-West-Anlage wirklich mehr Erlös?</summary><p>Pro Kilowattpeak erzeugt sie etwas weniger, verteilt die Erzeugung aber über den Tag. Damit trifft sie seltener das Mittagstief und erzielt einen höheren Marktwertfaktor. Bei reiner Einspeisung kann das den geringeren Ertrag mehr als ausgleichen.</p></details>
      <details class="qa"><summary>Was sind Ausgleichsenergiekosten?</summary><p>Weicht die tatsächliche Erzeugung von der gemeldeten Prognose ab, muss die Differenz ausgeglichen werden. Diese Kosten trägt üblicherweise der Vermarkter und rechnet sie im Entgelt ein. Bei sehr großen Anlagen wird das gesondert verhandelt.</p></details>
      <details class="qa"><summary>Kann ich Eigenverbrauch und Direktvermarktung kombinieren?</summary><p>Ja, das ist der Normalfall im Gewerbe. Zuerst wird der eigene Bedarf gedeckt, nur der Überschuss geht in die Vermarktung. Der Rechner hier betrachtet bewusst den Fall vollständiger Einspeisung, weil er den Marktwert isoliert zeigt.</p></details>
    </div>
  </div>
</section>

<script>
(function(){
"use strict";
var $=function(i){return document.getElementById(i);},
de=function(n,d){d=d||0;return Number(n).toLocaleString("de-AT",{minimumFractionDigits:d,maximumFractionDigits:d});};
var PVM=[2.8,4.6,8.3,11.2,12.9,13.0,13.5,12.0,9.2,6.5,3.4,2.6];
var PIX=[1.25,1.18,1.02,.88,.80,.78,.82,.86,.95,1.05,1.18,1.28];
var MN=["J","F","M","A","M","J","J","A","S","O","N","D"];
var MF=["Jänner","Februar","März","April","Mai","Juni","Juli","August","September","Oktober","November","Dezember"];
var OR={sued:{n:"Süd",y:1080,f:.82},ow:{n:"Ost-West",y:1030,f:.90},track:{n:"Nachgeführt",y:1180,f:.93}};
var ori="sued";

function render(){
 var kwp=+$("kwp").value,lvl=+$("lvl").value,fee=+$("fee").value,fix=+$("fix").value/100,O=OR[ori];
 var yMWh=kwp*O.y/1000,i,dv=[],fx=[],sDv=0,sFx=0,wIdx=0;
 for(i=0;i<12;i++){
   var e=yMWh*PVM[i]/100;
   var pr=lvl*PIX[i]*O.f-fee;
   var a=e*pr,b=e*fix*1000;
   dv.push(a);fx.push(b);sDv+=a;sFx+=b;wIdx+=PIX[i]*PVM[i]/100;
 }
 var mw=yMWh>0?sDv/yMWh:0,diff=sDv-sFx;
 var be=(fix*1000+fee)/(O.f*wIdx);

 $("v-kwp").innerHTML=de(kwp)+'<span class="unit">kWp</span>';
 $("v-lvl").innerHTML=de(lvl)+'<span class="unit">€/MWh</span>';
 $("v-fee").innerHTML=de(fee,1)+'<span class="unit">€/MWh</span>';
 $("v-fix").innerHTML=de(fix*100,1)+'<span class="unit">ct/kWh</span>';
 $("stamp").textContent="Ausrichtung: "+O.n;

 $("o-y").innerHTML=de(yMWh)+'<span class="unit">MWh</span>';
 $("o-spec").textContent=de(O.y)+" kWh/kWp";
 $("o-mw").innerHTML=de(mw,1)+'<span class="unit">€/MWh</span>';
 $("o-mwf").textContent="Faktor "+de(O.f,2)+" · Index "+de(wIdx,2);
 $("o-dv").innerHTML=de(sDv)+'<span class="unit">€/a</span>';
 $("o-dv2").textContent="Entgelt "+de(yMWh*fee)+" € abgezogen";
 $("o-fx").innerHTML=de(sFx)+'<span class="unit">€/a</span>';
 $("o-fx2").textContent=de(fix*100,1)+" ct je kWh";
 $("o-diff").innerHTML=(diff>=0?"+":"−")+de(Math.abs(diff))+'<span class="unit">€/a</span>';
 $("o-diff").parentNode.className="stat "+(diff>=0?"v":"r");
 $("o-diff2").textContent=diff>=0?"Markt liegt vorn":"Fixpreis liegt vorn";
 $("o-be").innerHTML=de(be)+'<span class="unit">€/MWh</span>';
 $("c-note").textContent="Jahressumme "+de(sDv)+" € gegenüber "+de(sFx)+" €";

 var W=760,H=220,L=56,R=14,T=16,B=30,pw=W-L-R,ph=H-T-B,cw=pw/12;
 var mx=Math.max(Math.max.apply(null,dv),Math.max.apply(null,fx))*1.12||1;
 var y=function(v){return T+ph*(1-Math.max(0,v)/mx);},s="",gv,gy;
 for(i=0;i<=3;i++){gv=mx*i/3;gy=y(gv);
  s+='<line x1="'+L+'" y1="'+gy.toFixed(1)+'" x2="'+(W-R)+'" y2="'+gy.toFixed(1)+'" stroke="rgba(150,180,220,.11)"/>';
  s+='<text x="'+(L-7)+'" y="'+(gy+3.5).toFixed(1)+'" text-anchor="end" fill="#617595" font-family="JetBrains Mono, monospace" font-size="9.5">'+de(gv/1000)+'k</text>';}
 for(i=0;i<12;i++){
  var x=L+i*cw,bw=cw/2-4;
  s+='<rect x="'+(x+3).toFixed(1)+'" y="'+y(dv[i]).toFixed(1)+'" width="'+bw.toFixed(1)+'" height="'+(ph-(y(dv[i])-T)).toFixed(1)+'" fill="#FFB43D"><title>'+MF[i]+' Direktvermarktung '+de(dv[i])+' €</title></rect>';
  s+='<rect x="'+(x+bw+6).toFixed(1)+'" y="'+y(fx[i]).toFixed(1)+'" width="'+bw.toFixed(1)+'" height="'+(ph-(y(fx[i])-T)).toFixed(1)+'" fill="#3A4C66"><title>'+MF[i]+' Fixpreis '+de(fx[i])+' €</title></rect>';
  s+='<text x="'+(x+cw/2).toFixed(1)+'" y="'+(H-9)+'" text-anchor="middle" fill="#617595" font-family="JetBrains Mono, monospace" font-size="9.5">'+MN[i]+'</text>';
 }
 s+='<text x="'+(L-7)+'" y="'+(T-4)+'" text-anchor="end" fill="#617595" font-family="JetBrains Mono, monospace" font-size="9">€</text>';
 $("ch").innerHTML=s;

 var W2=760,H2=170,L2=46,R2=46,T2=14,B2=28,pw2=W2-L2-R2,ph2=H2-T2-B2,cw2=pw2/12;
 var mxE=Math.max.apply(null,PVM)*1.15,mxP=Math.max.apply(null,PIX)*1.15,s2="";
 for(i=0;i<12;i++){
  var hh=ph2*PVM[i]/mxE;
  s2+='<rect x="'+(L2+i*cw2+5).toFixed(1)+'" y="'+(T2+ph2-hh).toFixed(1)+'" width="'+(cw2-10).toFixed(1)+'" height="'+hh.toFixed(1)+'" fill="#8CE04B" opacity=".85"><title>'+MF[i]+' '+de(PVM[i],1)+' % des Jahresertrags</title></rect>';
  s2+='<text x="'+(L2+i*cw2+cw2/2).toFixed(1)+'" y="'+(H2-9)+'" text-anchor="middle" fill="#617595" font-family="JetBrains Mono, monospace" font-size="9.5">'+MN[i]+'</text>';
 }
 var d="";for(i=0;i<12;i++)d+=(i?"L":"M")+(L2+i*cw2+cw2/2).toFixed(1)+" "+(T2+ph2*(1-PIX[i]/mxP)).toFixed(1)+" ";
 s2+='<path d="'+d+'" fill="none" stroke="#45E0FF" stroke-width="2"/>';
 s2+='<text x="'+(L2-6)+'" y="'+(T2+8)+'" text-anchor="end" fill="#8CE04B" font-family="JetBrains Mono, monospace" font-size="9">%</text>';
 s2+='<text x="'+(W2-R2+6)+'" y="'+(T2+8)+'" fill="#45E0FF" font-family="JetBrains Mono, monospace" font-size="9">Index</text>';
 $("cap").innerHTML=s2;
 $("c-cap").textContent="Erzeugungsgewichteter Preisindex "+de(wIdx,2);
}
["kwp","lvl","fee","fix"].forEach(function(i){$(i).addEventListener("input",render);});
Array.prototype.forEach.call(document.querySelectorAll("[data-a]"),function(b){
 b.addEventListener("click",function(){
  Array.prototype.forEach.call(document.querySelectorAll("[data-a]"),function(o){o.setAttribute("aria-pressed","false");});
  b.setAttribute("aria-pressed","true");ori=b.dataset.a;render();});});
render();
})();
</script>
