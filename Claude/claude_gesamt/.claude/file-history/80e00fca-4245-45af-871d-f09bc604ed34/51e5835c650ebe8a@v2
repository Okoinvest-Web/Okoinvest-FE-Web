<section class="hero">
  <div class="wrap hero-in">
    <div class="hero-grid">
      <div>
        <span class="kicker c">Mieterstrom</span>
        <h1>Ein Dach, <span class="gc">vierundzwanzig Parteien</span>, eine Abrechnung.</h1>
        <p class="lede">Die gemeinschaftliche Erzeugungsanlage verteilt den Strom vom gemeinsamen Dach auf die Einheiten im Haus. Der Rechner zeigt, was bei jeder Partei ankommt und was für die Betreiberin übrig bleibt.</p>
        <div class="hero-acts">
          <a class="btn btn-v" href="#tool">Verteilung rechnen</a>
          <a class="btn btn-o" href="#details">Modell &amp; Abrechnung</a>
        </div>
      </div>
      <div class="chips">
        <div class="chip v"><div><i>Teilnahmequote</i><p>Übliche Beteiligung nach dem ersten Jahr</p></div><b>60–85<span class="unit">%</span></b></div>
        <div class="chip c"><div><i>Eigenverbrauch</i><p>Direkt im Haus genutzter Anteil der Erzeugung</p></div><b>25–45<span class="unit">%</span></b></div>
        <div class="chip s"><div><i>Netzebene</i><p>Abrechnung innerhalb des Objekts</p></div><b>Zähler<span class="unit">punktgenau</span></b></div>
      </div>
    </div>
  </div>
</section>

<section class="sec" id="tool">
  <div class="wrap">
    <div class="sec-head">
      <div><span class="kicker">Verteilungsrechner</span><h2>Wer wie viel bekommt und was es bringt.</h2></div>
      <p class="lede">Statische Aufteilung vergibt feste Anteile, dynamische Aufteilung verteilt nach tatsächlichem Verbrauch in jeder Viertelstunde. Der Unterschied ist größer, als die meisten erwarten.</p>
    </div>

    <div class="console glass chamf">
      <div class="con-t"><span><span class="pulse"></span>Aufteilung · Jahresbilanz</span><span id="stamp">Modell: dynamisch</span></div>
      <div class="con-l">
        <div class="field">
          <div class="field-h"><label for="par">Einheiten im Objekt</label><span class="field-v" id="v-par">24</span></div>
          <input id="par" type="range" min="3" max="150" step="1" value="24">
          <div class="scale"><span>3</span><span>150</span></div>
        </div>
        <div class="field">
          <div class="field-h"><label for="kwp">Dachleistung</label><span class="field-v" id="v-kwp">120<span class="unit">kWp</span></span></div>
          <input id="kwp" type="range" min="10" max="900" step="5" value="120">
          <div class="scale"><span>10</span><span>900 kWp</span></div>
        </div>
        <div class="field">
          <div class="field-h"><label for="quo">Teilnahmequote</label><span class="field-v" id="v-quo">70<span class="unit">%</span></span></div>
          <input id="quo" type="range" min="10" max="100" step="5" value="70">
          <div class="scale"><span>10</span><span>100 %</span></div>
        </div>
        <div class="field">
          <div class="field-h"><label for="con">Verbrauch je Einheit</label><span class="field-v" id="v-con">2.600<span class="unit">kWh/a</span></span></div>
          <input id="con" type="range" min="800" max="12000" step="100" value="2600">
          <div class="scale"><span>800</span><span>12.000 kWh</span></div>
        </div>
        <div class="field">
          <div class="field-h"><label for="rab">Rabatt auf den Netztarif</label><span class="field-v" id="v-rab">15<span class="unit">%</span></span></div>
          <input id="rab" type="range" min="0" max="40" step="1" value="15">
          <div class="scale"><span>0</span><span>40 %</span></div>
        </div>
        <div class="field">
          <span class="lbl" id="ml">Aufteilungsmodell</span>
          <div class="seg c2" role="group" aria-labelledby="ml">
            <button type="button" data-m="stat" aria-pressed="false">Statisch</button>
            <button type="button" data-m="dyn" aria-pressed="true">Dynamisch</button>
          </div>
        </div>
        <details class="as">
          <summary>Rechenannahmen</summary>
          <ul>
            <li>Spezifischer Ertrag 1.000 kWh je kWp und Jahr</li>
            <li>Netztarif der Haushalte 26 ct/kWh inklusive Abgaben</li>
            <li>Überschusseinspeisung 6 ct/kWh</li>
            <li>Dynamische Aufteilung nutzt rund zwölf Prozent mehr Erzeugung als die statische</li>
            <li>Investition 1.100 €/kWp inklusive Messkonzept und Zählerkaskade</li>
            <li>Betriebskosten für Abrechnung und Messung 18 € je Einheit und Jahr</li>
          </ul>
        </details>
      </div>

      <div class="con-r">
        <div class="stats">
          <div class="stat s"><i>Jahresertrag</i><b id="o-y">—<span class="unit">kWh</span></b><small id="o-y2">—</small></div>
          <div class="stat c"><i>Im Haus genutzt</i><b id="o-use">—<span class="unit">%</span></b><small id="o-use2">—</small></div>
          <div class="stat v"><i>Ersparnis je Einheit</i><b id="o-sav">—<span class="unit">€/a</span></b><small id="o-sav2">—</small></div>
          <div class="stat"><i>Deckung je Einheit</i><b id="o-cov">—<span class="unit">%</span></b><small id="o-cov2">Reststrom —</small></div>
          <div class="stat v"><i>Erlös Betreiber</i><b id="o-rev">—<span class="unit">€/a</span></b><small id="o-rev2">nach Betriebskosten</small></div>
          <div class="stat"><i>Amortisation</i><b id="o-pay">—<span class="unit">Jahre</span></b><small id="o-inv">Investition —</small></div>
        </div>

        <div class="panel dk">
          <div class="panel-h"><h4>Einheiten im Objekt</h4><span id="c-note">—</span></div>
          <svg id="bld" viewBox="0 0 760 220" role="img" aria-label="Darstellung der Einheiten im Objekt nach Teilnahme"></svg>
          <div class="legend">
            <span><i style="background:#8CE04B"></i>nimmt teil</span>
            <span><i style="background:#26364F"></i>nimmt nicht teil</span>
          </div>
        </div>

        <div class="panel">
          <div class="panel-h"><h4>Wohin der Strom fließt</h4><span id="c-flow">—</span></div>
          <svg id="split" viewBox="0 0 760 130" role="img" aria-label="Aufteilung des Jahresertrags"></svg>
        </div>
        <p class="fine">Modellrechnung für ein Objekt mit Wohn- und Gewerbeeinheiten. Die tatsächliche Aufteilung hängt vom Lastgang jeder Einheit und vom gewählten Messkonzept ab.</p>
      </div>
    </div>
  </div>
</section>

<section class="sec" id="details">
  <div class="wrap">
    <div class="sec-head">
      <div><span class="kicker s">Umsetzung</span><h2>Drei Fragen, die vor dem Dach geklärt werden.</h2></div>
      <p class="lede">Die Technik ist der einfache Teil. Entscheidend sind Eigentümerbeschluss, Messkonzept und die Frage, wer die Abrechnung dauerhaft betreibt.</p>
    </div>
    <div class="cards">
      <article class="card">
        <span class="n">FRAGE 1</span>
        <svg class="ic" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 28h24M6 28V12l10-7 10 7v16"/><path d="M12 28v-7h8v7M12 15h3M17 15h3"/></svg>
        <h3>Wem gehört die Anlage?</h3>
        <p>Eigentümergemeinschaft, Einzeleigentümerin oder ein Betreibermodell mit Dachpacht. Davon hängen Beschlussfassung, Finanzierung und die steuerliche Behandlung ab.</p>
        <ul><li>Beschluss der Eigentümerversammlung</li><li>Dachnutzungsvereinbarung</li><li>Steuerliche Zuordnung klären</li></ul>
      </article>
      <article class="card">
        <span class="n">FRAGE 2</span>
        <svg class="ic" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="4" y="6" width="24" height="20"/><path d="M4 13h24M9 19h4M17 19h6"/></svg>
        <h3>Welches Messkonzept?</h3>
        <p>Die Verrechnung läuft über die Zählpunkte der Einheiten. Erzeugung und Verbrauch werden im Viertelstundenraster gegenübergestellt, der Netzbetreiber liefert die Daten.</p>
        <ul><li>Zählpunkte je Einheit</li><li>Erzeugungszählpunkt am Dach</li><li>Datenfreigabe der Teilnehmenden</li></ul>
      </article>
      <article class="card">
        <span class="n">FRAGE 3</span>
        <svg class="ic" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="16" cy="16" r="12"/><path d="M16 9v7l5 3"/></svg>
        <h3>Wer rechnet ab?</h3>
        <p>Monatlich Anteile ermitteln, Rechnungen erstellen, Zu- und Abgänge verwalten. Das ist Dauerbetrieb und kein Projekt. Ohne klaren Betreiber scheitert das Modell nach dem zweiten Jahr.</p>
        <ul><li>Abrechnungsdienstleister oder Hausverwaltung</li><li>Ein- und Austritt geregelt</li><li>Transparente Jahresabrechnung</li></ul>
      </article>
    </div>
  </div>
</section>

<section class="sec" id="faq">
  <div class="wrap">
    <div class="sec-head"><div><span class="kicker">Häufige Fragen</span><h2>Was Eigentümer und Verwaltungen fragen.</h2></div></div>
    <div class="faq">
      <details class="qa" open><summary>Muss jede Partei mitmachen?</summary><p>Nein. Die Teilnahme ist freiwillig und jederzeit kündbar. Wer nicht teilnimmt, bezieht weiter vom eigenen Lieferanten. Genau deshalb ist die Teilnahmequote im Rechner ein eigener Regler, denn sie bestimmt die Wirtschaftlichkeit maßgeblich.</p></details>
      <details class="qa"><summary>Was ist der Unterschied zwischen statisch und dynamisch?</summary><p>Statisch bekommt jede Einheit einen festen Prozentsatz der Erzeugung, unabhängig davon, ob sie gerade Strom braucht. Dynamisch wird in jeder Viertelstunde nach tatsächlichem Verbrauch verteilt. Das nutzt die Erzeugung deutlich besser aus, verlangt aber ein leistungsfähigeres Abrechnungssystem.</p></details>
      <details class="qa"><summary>Was passiert bei Mieterwechsel?</summary><p>Der Vertrag hängt am Zählpunkt und wird beim Wechsel neu abgeschlossen. Eine saubere Übergaberegelung in der Hausordnung erspart später viel Abstimmung, gerade bei häufigem Wechsel in Wohnobjekten.</p></details>
      <details class="qa"><summary>Bleibt der bisherige Stromliefervertrag bestehen?</summary><p>Ja. Die gemeinschaftliche Erzeugung deckt nur einen Teil des Bedarfs, der Rest kommt weiter vom gewählten Lieferanten. Die Teilnehmenden behalten ihre freie Lieferantenwahl für den Reststrom.</p></details>
    </div>
  </div>
</section>

<script>
(function(){
"use strict";
var $=function(i){return document.getElementById(i);},
de=function(n,d){d=d||0;return Number(n).toLocaleString("de-AT",{minimumFractionDigits:d,maximumFractionDigits:d});};
var TARIF=.26,FEED=.06,SPEZ=1100,OPEX=18,mod="dyn";

function render(){
 var par=+$("par").value,kwp=+$("kwp").value,quo=+$("quo").value/100,con=+$("con").value,rab=+$("rab").value/100;
 var teil=Math.max(1,Math.round(par*quo)),bedarf=teil*con,ertrag=kwp*1000;
 var r=bedarf>0?ertrag/bedarf:99;
 var sf=Math.max(.08,Math.min(.62,.95*Math.exp(-.7*r)))*(mod==="dyn"?1.12:.92);
 sf=Math.min(sf,.68);
 var genutzt=Math.round(ertrag*sf),ueber=ertrag-genutzt;
 var jeEinheit=genutzt/teil,msPreis=TARIF*(1-rab);
 var savUnit=Math.round(jeEinheit*(TARIF-msPreis));
 var cov=con>0?Math.min(100,jeEinheit/con*100):0;
 var rev=Math.round(genutzt*msPreis+ueber*FEED-teil*OPEX);
 var inv=Math.round(kwp*SPEZ),pay=rev>0?inv/rev:0;

 $("v-par").textContent=de(par);
 $("v-kwp").innerHTML=de(kwp)+'<span class="unit">kWp</span>';
 $("v-quo").innerHTML=de(quo*100)+'<span class="unit">%</span>';
 $("v-con").innerHTML=de(con)+'<span class="unit">kWh/a</span>';
 $("v-rab").innerHTML=de(rab*100)+'<span class="unit">%</span>';
 $("stamp").textContent="Modell: "+(mod==="dyn"?"dynamisch":"statisch");

 $("o-y").innerHTML=de(ertrag)+'<span class="unit">kWh</span>';
 $("o-y2").textContent=de(teil)+" von "+de(par)+" Einheiten dabei";
 $("o-use").innerHTML=de(sf*100)+'<span class="unit">%</span>';
 $("o-use2").textContent=de(genutzt)+" kWh im Haus";
 $("o-sav").innerHTML=de(savUnit)+'<span class="unit">€/a</span>';
 $("o-sav2").textContent=de(msPreis*100,1)+" ct statt "+de(TARIF*100,1)+" ct";
 $("o-cov").innerHTML=de(cov)+'<span class="unit">%</span>';
 $("o-cov2").textContent="Reststrom "+de(Math.max(0,con-jeEinheit))+" kWh";
 $("o-rev").innerHTML=de(rev)+'<span class="unit">€/a</span>';
 $("o-pay").innerHTML=(rev>0?de(pay,1):"—")+'<span class="unit">Jahre</span>';
 $("o-inv").textContent="Investition "+de(inv)+" €";
 $("c-note").textContent=de(teil)+" Teilnehmende · "+de(Math.round(jeEinheit))+" kWh je Einheit";

 /* building grid */
 var W=760,H=220,shown=Math.min(par,72),cols=Math.min(12,Math.ceil(Math.sqrt(shown*1.9)));
 var rows=Math.ceil(shown/cols),bw=Math.min(56,(W-40)/cols-6),bh=Math.min(30,(H-46)/rows-6),s="",i;
 var x0=(W-(cols*(bw+6)-6))/2,y0=16;
 for(i=0;i<shown;i++){
   var cx=x0+(i%cols)*(bw+6),cy=y0+Math.floor(i/cols)*(bh+6);
   var act=i<Math.round(shown*quo);
   s+='<rect x="'+cx.toFixed(1)+'" y="'+cy.toFixed(1)+'" width="'+bw.toFixed(1)+'" height="'+bh.toFixed(1)+'" fill="'+(act?"#8CE04B":"#26364F")+'" opacity="'+(act?".9":".75")+'"/>';
   if(bw>26)s+='<rect x="'+(cx+5).toFixed(1)+'" y="'+(cy+5).toFixed(1)+'" width="'+(bw-10).toFixed(1)+'" height="'+(bh-10).toFixed(1)+'" fill="'+(act?"#0B1A0A":"#0D1A2B")+'" opacity=".55"/>';
 }
 s+='<text x="'+x0.toFixed(1)+'" y="'+(H-10)+'" fill="#617595" font-family="JetBrains Mono, monospace" font-size="10">'+(par>72?"Darstellung auf 72 Einheiten begrenzt":de(par)+" Einheiten")+'</text>';
 $("bld").innerHTML=s;

 /* split bar */
 var W2=760,y=26,h=34,tot=ertrag||1,parts=[["Im Haus genutzt",genutzt,"#8CE04B"],["Eingespeist",ueber,"#FFB43D"]];
 var s2="",x=0;
 for(i=0;i<2;i++){
   var w=W2*parts[i][1]/tot;
   s2+='<rect x="'+x.toFixed(1)+'" y="'+y+'" width="'+Math.max(0,w-2).toFixed(1)+'" height="'+h+'" fill="'+parts[i][2]+'"><title>'+parts[i][0]+': '+de(parts[i][1])+' kWh</title></rect>';
   if(w>120){
     s2+='<text x="'+(x+12).toFixed(1)+'" y="'+(y-8)+'" fill="'+parts[i][2]+'" font-family="JetBrains Mono, monospace" font-size="11">'+parts[i][0]+'</text>';
     s2+='<text x="'+(x+12).toFixed(1)+'" y="'+(y+h+18)+'" fill="#EDF4FF" font-family="JetBrains Mono, monospace" font-size="12">'+de(parts[i][1])+' kWh</text>';
   }
   x+=w;
 }
 s2+='<text x="0" y="'+(y+h+44)+'" fill="#617595" font-family="JetBrains Mono, monospace" font-size="10">Gesamtertrag '+de(ertrag)+' kWh im Jahr</text>';
 $("split").innerHTML=s2;
 $("c-flow").textContent=de(sf*100)+" % Eigennutzung im Objekt";
}
["par","kwp","quo","con","rab"].forEach(function(i){$(i).addEventListener("input",render);});
Array.prototype.forEach.call(document.querySelectorAll("[data-m]"),function(b){
 b.addEventListener("click",function(){
  Array.prototype.forEach.call(document.querySelectorAll("[data-m]"),function(o){o.setAttribute("aria-pressed","false");});
  b.setAttribute("aria-pressed","true");mod=b.dataset.m;render();});});
render();
})();
</script>
