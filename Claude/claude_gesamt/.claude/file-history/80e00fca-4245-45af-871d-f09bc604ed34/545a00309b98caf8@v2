<title>__TITLE__</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,400..800&family=JetBrains+Mono:wght@400;500&family=Sora:wght@300;400;600&display=swap">
<style>
:root{
  --void:#04070E; --deep:#070D18; --raise:#121E33;
  --line:rgba(150,180,220,.13); --line-2:rgba(150,180,220,.26); --line-3:rgba(150,180,220,.42);
  --ink:#EDF4FF; --ink-2:#9FB4CE; --muted:#617595;
  --volt:#8CE04B; --volt-dim:#5C9E2C; --volt-glow:rgba(140,224,75,.30);
  --solar:#FFB43D; --solar-dim:#B07620; --solar-glow:rgba(255,180,61,.26);
  --cyan:#45E0FF; --cyan-dim:#2A8DA6; --cyan-glow:rgba(69,224,255,.24);
  --rose:#FF6B8A; --rose-dim:#A63B52;
  --f-d:"Archivo","Arial Narrow",system-ui,sans-serif;
  --f-b:"Sora","Segoe UI",system-ui,sans-serif;
  --f-m:"JetBrains Mono",ui-monospace,"Cascadia Mono",monospace;
  --pad:clamp(18px,4.5vw,58px); --cut:14px;
}
*,*::before,*::after{box-sizing:border-box}
body{background:var(--void);color:var(--ink);font-family:var(--f-b);font-weight:300;font-size:16.5px;line-height:1.62;-webkit-font-smoothing:antialiased;overflow-x:hidden}
h1,h2,h3,h4{font-family:var(--f-d);font-weight:700;font-variation-settings:"wdth" 116;letter-spacing:-.02em;line-height:1.05;text-wrap:balance;margin:0}
p{margin:0}
a{color:inherit}
button,input,select{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--volt);outline-offset:3px}
.wrap{max-width:1300px;margin:0 auto;padding-inline:var(--pad)}
.chamf{clip-path:polygon(var(--cut) 0,100% 0,100% calc(100% - var(--cut)),calc(100% - var(--cut)) 100%,0 100%,0 var(--cut))}
.glass{background:linear-gradient(160deg,rgba(18,30,51,.82),rgba(10,18,32,.92));border:1px solid var(--line)}
.kicker{font-family:var(--f-m);font-size:11px;letter-spacing:.24em;text-transform:uppercase;color:var(--volt);display:inline-flex;align-items:center;gap:11px}
.kicker::before{content:"";width:26px;height:1px;background:var(--volt);box-shadow:0 0 10px var(--volt-glow)}
.kicker.c{color:var(--cyan)}.kicker.c::before{background:var(--cyan);box-shadow:0 0 10px var(--cyan-glow)}
.kicker.s{color:var(--solar)}.kicker.s::before{background:var(--solar);box-shadow:0 0 10px var(--solar-glow)}
.lede{font-size:clamp(16.5px,1.35vw,19px);color:var(--ink-2);max-width:62ch}
.unit{font-size:.44em;font-family:var(--f-m);font-weight:400;color:var(--muted);margin-left:5px;letter-spacing:0}
.mono{font-family:var(--f-m);font-variant-numeric:tabular-nums}

.top{position:sticky;top:0;z-index:90;background:rgba(4,7,14,.8);backdrop-filter:blur(16px);border-bottom:1px solid var(--line)}
.top-in{display:flex;align-items:center;gap:22px;height:66px}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none;flex:none}
.mark{--cut:9px;width:32px;height:32px;display:grid;place-items:center;background:linear-gradient(150deg,var(--volt),var(--volt-dim));box-shadow:0 0 24px -4px var(--volt-glow);clip-path:polygon(var(--cut) 0,100% 0,100% calc(100% - var(--cut)),calc(100% - var(--cut)) 100%,0 100%,0 var(--cut))}
.mark svg{width:16px;height:16px}
.brand b{font-family:var(--f-d);font-weight:800;font-variation-settings:"wdth" 120;font-size:18px;letter-spacing:.04em;display:block;line-height:1}
.brand small{font-family:var(--f-m);font-size:8px;letter-spacing:.3em;color:var(--muted);text-transform:uppercase;display:block;margin-top:3px}
.nav{display:flex;gap:24px;margin-left:auto;font-family:var(--f-m);font-size:11.5px;letter-spacing:.1em;text-transform:uppercase}
.nav a{text-decoration:none;color:var(--ink-2);position:relative;padding:4px 0}
.nav a::after{content:"";position:absolute;left:0;bottom:-2px;width:0;height:1px;background:var(--volt);transition:width .25s}
.nav a:hover{color:var(--ink)}.nav a:hover::after{width:100%}
.top-r{display:flex;align-items:center;gap:13px;flex:none;margin-left:auto}
.nav ~ .top-r{margin-left:0}
.tel{font-family:var(--f-m);font-size:12px;color:var(--ink-2);text-decoration:none;white-space:nowrap}
.tel:hover{color:var(--volt)}
.btn{--cut:11px;display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:13px 22px;font-family:var(--f-m);font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;text-decoration:none;cursor:pointer;border:1px solid transparent;background:none;transition:transform .16s ease,box-shadow .2s ease,background .2s ease,color .2s ease;clip-path:polygon(var(--cut) 0,100% 0,100% calc(100% - var(--cut)),calc(100% - var(--cut)) 100%,0 100%,0 var(--cut))}
.btn-v{background:var(--volt);color:#06170A;font-weight:500;box-shadow:0 0 30px -8px var(--volt-glow)}
.btn-v:hover{transform:translateY(-2px);box-shadow:0 0 44px -6px var(--volt-glow)}
.btn-o{border-color:var(--line-2);color:var(--ink)}
.btn-o:hover{border-color:var(--volt);color:var(--volt);transform:translateY(-2px)}
@media(max-width:1020px){.nav,.tel{display:none}}

.hero{position:relative;border-bottom:1px solid var(--line);overflow:hidden;isolation:isolate}
.hero::before{content:"";position:absolute;inset:0;z-index:-2;opacity:.55;
  background-image:linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px);
  background-size:58px 58px;
  -webkit-mask-image:radial-gradient(78% 70% at 50% 30%,#000,transparent 76%);mask-image:radial-gradient(78% 70% at 50% 30%,#000,transparent 76%)}
.hero::after{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;
  background:radial-gradient(100% 70% at 82% 0%,rgba(69,224,255,.11),transparent 60%),radial-gradient(90% 80% at 10% 100%,rgba(140,224,75,.11),transparent 62%)}
.hero-in{padding-block:clamp(44px,6.5vw,84px) clamp(30px,4vw,46px)}
.hero-grid{display:grid;grid-template-columns:minmax(0,1.12fr) minmax(0,.88fr);gap:clamp(24px,4vw,60px);align-items:center}
@media(max-width:980px){.hero-grid{grid-template-columns:1fr}}
h1{font-size:clamp(34px,5.4vw,72px);font-weight:800;font-variation-settings:"wdth" 122;letter-spacing:-.035em;line-height:.98;margin-block:20px 22px}
h1 .gl{background:linear-gradient(96deg,var(--volt) 8%,var(--solar) 94%);-webkit-background-clip:text;background-clip:text;color:transparent}
h1 .gc{background:linear-gradient(96deg,var(--cyan) 8%,var(--volt) 94%);-webkit-background-clip:text;background-clip:text;color:transparent}
.hero-acts{display:flex;flex-wrap:wrap;gap:12px;margin-top:26px}
.chips{display:grid;gap:10px}
.chip{--cut:11px;border:1px solid var(--line);background:rgba(13,23,41,.6);padding:15px 17px;display:grid;grid-template-columns:1fr auto;align-items:center;gap:14px;clip-path:polygon(var(--cut) 0,100% 0,100% calc(100% - var(--cut)),calc(100% - var(--cut)) 100%,0 100%,0 var(--cut))}
.chip i{font-style:normal;font-family:var(--f-m);font-size:9.5px;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);display:block;margin-bottom:5px}
.chip p{font-size:13.5px;color:var(--ink-2);line-height:1.4}
.chip b{font-family:var(--f-d);font-weight:800;font-variation-settings:"wdth" 118;font-size:clamp(22px,2.6vw,30px);letter-spacing:-.04em;font-variant-numeric:tabular-nums;line-height:1;white-space:nowrap;text-align:right}
.chip.v b{color:var(--volt)}.chip.s b{color:var(--solar)}.chip.c b{color:var(--cyan)}

.sec{position:relative;border-bottom:1px solid var(--line);padding-block:clamp(48px,6.5vw,92px)}
.sec-head{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:clamp(18px,4vw,56px);align-items:end;margin-bottom:clamp(26px,3.5vw,46px)}
.sec-head h2{font-size:clamp(26px,3.5vw,44px);margin-top:15px}
@media(max-width:880px){.sec-head{grid-template-columns:1fr}}

.console{--cut:22px;display:grid;grid-template-columns:330px minmax(0,1fr);position:relative}
@media(max-width:1020px){.console{grid-template-columns:1fr}}
.con-t{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:12px 18px;border-bottom:1px solid var(--line);grid-column:1/-1;font-family:var(--f-m);font-size:10.5px;letter-spacing:.2em;text-transform:uppercase;color:var(--muted)}
.pulse{width:7px;height:7px;background:var(--volt);border-radius:50%;animation:pl 2.4s infinite;display:inline-block;margin-right:9px;vertical-align:middle}
@keyframes pl{0%{box-shadow:0 0 0 0 rgba(140,224,75,.5)}70%{box-shadow:0 0 0 9px rgba(140,224,75,0)}100%{box-shadow:0 0 0 0 rgba(140,224,75,0)}}
.con-l{border-right:1px solid var(--line);padding:24px 22px;display:flex;flex-direction:column;gap:22px;background:rgba(7,13,24,.6)}
@media(max-width:1020px){.con-l{border-right:0;border-bottom:1px solid var(--line)}}
.con-r{padding:24px;display:flex;flex-direction:column;gap:18px;min-width:0}
.field{display:flex;flex-direction:column;gap:9px}
.field-h{display:flex;justify-content:space-between;align-items:baseline;gap:10px}
.field-h label,.lbl{font-family:var(--f-m);font-size:10.5px;letter-spacing:.17em;text-transform:uppercase;color:var(--muted)}
.lbl{display:block;margin-bottom:8px}
.field-v{font-family:var(--f-d);font-weight:700;font-variation-settings:"wdth" 114;font-size:21px;letter-spacing:-.035em;font-variant-numeric:tabular-nums}
.field-v .unit{font-size:11px}
input[type=range]{-webkit-appearance:none;appearance:none;width:100%;height:20px;background:transparent;cursor:pointer;margin:0}
input[type=range]::-webkit-slider-runnable-track{height:2px;background:var(--line-2)}
input[type=range]::-moz-range-track{height:2px;background:var(--line-2)}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:14px;height:14px;background:var(--volt);margin-top:-6px;box-shadow:0 0 14px var(--volt-glow);clip-path:polygon(50% 0,100% 50%,50% 100%,0 50%)}
input[type=range]::-moz-range-thumb{width:14px;height:14px;border:0;background:var(--volt);box-shadow:0 0 14px var(--volt-glow);clip-path:polygon(50% 0,100% 50%,50% 100%,0 50%)}
.scale{display:flex;justify-content:space-between;font-family:var(--f-m);font-size:10px;color:var(--muted)}
.seg{display:grid;gap:7px}
.seg.c2{grid-template-columns:repeat(2,1fr)}
.seg.c3{grid-template-columns:repeat(3,1fr)}
.seg button{--cut:8px;background:rgba(18,30,51,.5);border:1px solid var(--line);padding:10px 8px;cursor:pointer;display:flex;align-items:center;gap:8px;font-family:var(--f-m);font-size:10.5px;letter-spacing:.05em;color:var(--ink-2);transition:all .18s;text-align:left;clip-path:polygon(var(--cut) 0,100% 0,100% calc(100% - var(--cut)),calc(100% - var(--cut)) 100%,0 100%,0 var(--cut))}
.seg button svg{width:22px;height:14px;flex:none}
.seg button:hover{border-color:var(--line-3);color:var(--ink)}
.seg button[aria-pressed=true]{border-color:var(--volt);color:var(--volt);background:rgba(140,224,75,.09)}
.sw{display:flex;align-items:center;justify-content:space-between;gap:12px;border:1px solid var(--line);background:rgba(18,30,51,.42);padding:11px 13px;cursor:pointer;width:100%;font-family:var(--f-m);font-size:11px;letter-spacing:.06em;color:var(--ink-2);transition:all .18s}
.sw:hover{border-color:var(--line-3)}
.sw span.tr{width:34px;height:16px;border:1px solid var(--line-2);position:relative;flex:none}
.sw span.tr::after{content:"";position:absolute;top:2px;left:2px;width:10px;height:10px;background:var(--muted);transition:all .2s}
.sw[aria-pressed=true]{border-color:var(--volt);color:var(--volt)}
.sw[aria-pressed=true] span.tr{border-color:var(--volt)}
.sw[aria-pressed=true] span.tr::after{left:20px;background:var(--volt);box-shadow:0 0 10px var(--volt-glow)}

.stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:11px}
@media(max-width:760px){.stats{grid-template-columns:repeat(2,minmax(0,1fr))}}
.stat{--cut:10px;border:1px solid var(--line);background:rgba(13,23,41,.55);padding:14px 15px 15px;clip-path:polygon(var(--cut) 0,100% 0,100% calc(100% - var(--cut)),calc(100% - var(--cut)) 100%,0 100%,0 var(--cut))}
.stat i{font-style:normal;font-family:var(--f-m);font-size:9.5px;letter-spacing:.17em;text-transform:uppercase;color:var(--muted);display:block;margin-bottom:8px}
.stat b{font-family:var(--f-d);font-weight:800;font-variation-settings:"wdth" 116;font-size:clamp(22px,2.5vw,31px);letter-spacing:-.045em;font-variant-numeric:tabular-nums;line-height:1;display:block}
.stat small{display:block;margin-top:7px;font-size:11.5px;color:var(--muted);line-height:1.4;font-family:var(--f-m)}
.stat.v b{color:var(--volt)}.stat.s b{color:var(--solar)}.stat.c b{color:var(--cyan)}.stat.r b{color:var(--rose)}
.stat.v{border-color:rgba(140,224,75,.3)}

.panel{--cut:10px;border:1px solid var(--line);background:rgba(13,23,41,.55);padding:16px 16px 12px;clip-path:polygon(var(--cut) 0,100% 0,100% calc(100% - var(--cut)),calc(100% - var(--cut)) 100%,0 100%,0 var(--cut))}
.panel.dk{background:rgba(7,13,24,.72)}
.panel-h{display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin-bottom:14px;flex-wrap:wrap}
.panel-h h4{font-family:var(--f-m);font-weight:400;font-size:9.5px;letter-spacing:.17em;text-transform:uppercase;color:var(--muted)}
.panel-h span{font-family:var(--f-m);font-size:11px;color:var(--ink-2)}
.panel svg{width:100%;height:auto;display:block}
.legend{display:flex;flex-wrap:wrap;gap:7px 16px;margin-top:12px;font-family:var(--f-m);font-size:10.5px;color:var(--ink-2)}
.legend span{display:inline-flex;align-items:center;gap:7px}
.legend i{width:10px;height:10px;display:block;flex:none}
.grid2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px}
@media(max-width:900px){.grid2{grid-template-columns:1fr}}
details.as{border-top:1px solid var(--line);padding-top:14px}
details.as summary{font-family:var(--f-m);font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);cursor:pointer}
details.as summary:hover{color:var(--volt)}
details.as ul{margin:13px 0 0;padding-left:17px;font-family:var(--f-m);font-size:11.5px;color:var(--ink-2);line-height:1.7}
.fine{font-family:var(--f-m);font-size:11px;color:var(--muted);line-height:1.6}

.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px}
@media(max-width:940px){.cards{grid-template-columns:1fr}}
.card{--cut:16px;border:1px solid var(--line);background:linear-gradient(165deg,rgba(18,30,51,.7),rgba(8,14,26,.85));padding:26px 24px 28px;display:flex;flex-direction:column;gap:14px;transition:border-color .25s,transform .25s;clip-path:polygon(var(--cut) 0,100% 0,100% calc(100% - var(--cut)),calc(100% - var(--cut)) 100%,0 100%,0 var(--cut))}
.card:hover{border-color:var(--line-3);transform:translateY(-4px)}
.card .n{font-family:var(--f-m);font-size:10px;letter-spacing:.2em;color:var(--muted)}
.card svg.ic{width:34px;height:34px;color:var(--volt)}
.card:nth-child(2) svg.ic{color:var(--solar)}
.card:nth-child(3) svg.ic{color:var(--cyan)}
.card h3{font-size:19.5px}
.card p{font-size:14.5px;color:var(--ink-2)}
.card ul{margin:auto 0 0;padding:15px 0 0;list-style:none;display:flex;flex-direction:column;gap:8px;border-top:1px solid var(--line)}
.card li{font-family:var(--f-m);font-size:11.5px;color:var(--ink-2);display:flex;gap:9px;align-items:baseline}
.card li::before{content:"▸";color:var(--volt);flex:none;font-size:10px}
.card:nth-child(2) li::before{color:var(--solar)}
.card:nth-child(3) li::before{color:var(--cyan)}

.tbl-s{overflow-x:auto}
table.fd{width:100%;border-collapse:collapse;font-size:14.5px;min-width:600px}
table.fd th{text-align:left;font-family:var(--f-m);font-size:9.5px;letter-spacing:.19em;text-transform:uppercase;color:var(--muted);font-weight:400;padding:0 16px 12px 0;border-bottom:1px solid var(--line-2)}
table.fd td{padding:16px 16px 16px 0;border-bottom:1px solid var(--line);vertical-align:top;color:var(--ink-2)}
table.fd td:first-child{color:var(--ink);font-family:var(--f-d);font-weight:600;font-variation-settings:"wdth" 112;width:26%}
table.fd td.k{font-family:var(--f-m);font-size:12.5px;color:var(--cyan);width:18%}
table.fd td.num{font-family:var(--f-m);font-variant-numeric:tabular-nums;color:var(--volt);text-align:right}

.faq{border-top:1px solid var(--line);max-width:940px}
.qa{border-bottom:1px solid var(--line)}
.qa summary{display:flex;justify-content:space-between;align-items:center;gap:22px;padding:20px 0;cursor:pointer;font-family:var(--f-d);font-weight:600;font-variation-settings:"wdth" 112;font-size:17.5px;letter-spacing:-.015em;list-style:none;transition:color .2s}
.qa summary:hover{color:var(--volt)}
.qa summary::-webkit-details-marker{display:none}
.qa summary::after{content:"";width:10px;height:10px;border-right:1.5px solid var(--volt);border-bottom:1.5px solid var(--volt);transform:rotate(45deg) translateY(-3px);flex:none;transition:transform .25s}
.qa[open] summary::after{transform:rotate(225deg) translateY(-3px)}
.qa p{padding-bottom:21px;font-size:15px;color:var(--ink-2);max-width:74ch}

.cta{position:relative;border-bottom:1px solid var(--line);overflow:hidden}
.cta::before{content:"";position:absolute;inset:0;z-index:-1;background:radial-gradient(90% 120% at 12% 0%,rgba(69,224,255,.12),transparent 55%),radial-gradient(80% 110% at 92% 100%,rgba(140,224,75,.14),transparent 58%),var(--deep)}
.cta-in{display:grid;grid-template-columns:minmax(0,1fr) 420px;gap:clamp(26px,4vw,60px);padding-block:clamp(46px,6vw,84px);align-items:start}
@media(max-width:980px){.cta-in{grid-template-columns:1fr}}
.cta h2{font-size:clamp(28px,3.8vw,48px);margin-top:15px}
.cta-l{color:var(--ink-2);font-size:17px;max-width:48ch;margin-top:18px}
.cts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px;margin-top:34px;padding-top:26px;border-top:1px solid var(--line)}
.cts i{font-style:normal;font-family:var(--f-m);font-size:9.5px;letter-spacing:.19em;text-transform:uppercase;color:var(--muted);display:block;margin-bottom:8px}
.cts a,.cts p{color:var(--ink);text-decoration:none;font-size:14.5px;line-height:1.55}
.cts a:hover{color:var(--volt)}
.form{--cut:18px;border:1px solid var(--line);background:linear-gradient(165deg,rgba(18,30,51,.85),rgba(8,14,26,.92));padding:24px;display:flex;flex-direction:column;gap:15px;clip-path:polygon(var(--cut) 0,100% 0,100% calc(100% - var(--cut)),calc(100% - var(--cut)) 100%,0 100%,0 var(--cut))}
.form h3{font-size:18.5px}
.form input,.form select{width:100%;background:rgba(4,7,14,.7);border:1px solid var(--line);padding:11px 12px;font-size:14px;font-family:var(--f-b)}
.form input::placeholder{color:var(--muted)}
.form input:focus,.form select:focus{border-color:var(--volt);outline:none}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:11px}
.sent{display:none;border:1px solid var(--volt-dim);background:rgba(140,224,75,.07);padding:14px;font-size:13px;color:var(--ink-2)}
.sent.on{display:block}
.sent b{display:block;color:var(--volt);font-family:var(--f-m);font-size:11px;letter-spacing:.12em;text-transform:uppercase;margin-bottom:7px}

footer{padding-block:clamp(40px,5vw,60px) 22px;background:var(--void)}
.fg{display:grid;grid-template-columns:1.5fr repeat(3,1fr);gap:clamp(18px,3vw,40px)}
@media(max-width:880px){.fg{grid-template-columns:1fr 1fr}}
.fg h4{font-family:var(--f-m);font-weight:400;font-size:9.5px;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);margin-bottom:15px}
.fg ul{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:9px}
