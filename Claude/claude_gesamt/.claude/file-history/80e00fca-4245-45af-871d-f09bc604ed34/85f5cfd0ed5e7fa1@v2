<title>ÖKOVOLT Solartechnik</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Source+Sans+3:wght@400;600&display=swap">
<style>
:root{
  --bg:#EDF0F4; --surface:#FFFFFF; --surface-2:#F5F8FA; --inset:#E4E9EF;
  --ink:#0A1A2F; --ink-2:#33465F; --muted:#6A7C93;
  --rule:#D5DCE6; --rule-2:#B7C3D2;
  --navy:#003473; --on-navy:#EAF1FA; --on-navy-dim:#A6BEDC;
  --accent:#669933; --accent-ink:#446E1D; --accent-soft:#E8F1DD; --accent-line:#A9CB7E;
  --solar:#C9820C; --solar-soft:#FAF0DB;
  --shadow:0 1px 2px rgba(10,26,47,.05),0 14px 30px -18px rgba(10,26,47,.28);
  --f-disp:"Archivo","Segoe UI",system-ui,sans-serif;
  --f-body:"Source Sans 3","Segoe UI",system-ui,sans-serif;
  --f-mono:"IBM Plex Mono",ui-monospace,"Cascadia Mono",monospace;
  --pad:clamp(20px,5vw,64px);
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#07101D; --surface:#0D1A2B; --surface-2:#122336; --inset:#0A1626;
  --ink:#E7EEF7; --ink-2:#B0C1D5; --muted:#7C91AB;
  --rule:#1D2F47; --rule-2:#2B4262;
  --navy:#0A2B52; --on-navy:#EAF1FA; --on-navy-dim:#A6BEDC;
  --accent:#7FB93E; --accent-ink:#9FD05C; --accent-soft:#17281B; --accent-line:#3C6021;
  --solar:#E6A63C; --solar-soft:#2A1E0A;
  --shadow:0 1px 2px rgba(0,0,0,.5),0 16px 36px -20px rgba(0,0,0,.8);
}}
:root[data-theme="dark"]{
  --bg:#07101D; --surface:#0D1A2B; --surface-2:#122336; --inset:#0A1626;
  --ink:#E7EEF7; --ink-2:#B0C1D5; --muted:#7C91AB;
  --rule:#1D2F47; --rule-2:#2B4262;
  --navy:#0A2B52; --on-navy:#EAF1FA; --on-navy-dim:#A6BEDC;
  --accent:#7FB93E; --accent-ink:#9FD05C; --accent-soft:#17281B; --accent-line:#3C6021;
  --solar:#E6A63C; --solar-soft:#2A1E0A;
  --shadow:0 1px 2px rgba(0,0,0,.5),0 16px 36px -20px rgba(0,0,0,.8);
}
*,*::before,*::after{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:17px;line-height:1.6;-webkit-font-smoothing:antialiased}
h1,h2,h3,h4{font-family:var(--f-disp);font-weight:700;letter-spacing:-.02em;line-height:1.1;text-wrap:balance;margin:0}
p{margin:0}
a{color:inherit}
button,input,select{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:2px}
.wrap{max-width:1240px;margin:0 auto;padding-inline:var(--pad)}
.eyebrow{font-family:var(--f-mono);font-size:11.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);display:flex;align-items:center;gap:10px}
.eyebrow::before{content:"";width:22px;height:1px;background:var(--accent);flex:none}
.lede{font-size:clamp(17px,1.5vw,19.5px);color:var(--ink-2);max-width:62ch}
.mono{font-family:var(--f-mono);font-variant-numeric:tabular-nums}

/* header */
.top{position:sticky;top:0;z-index:60;background:var(--bg);border-bottom:1px solid var(--rule)}
.top-in{display:flex;align-items:center;gap:26px;height:66px}
.brand{display:flex;align-items:center;gap:11px;font-family:var(--f-disp);font-weight:700;font-size:19px;letter-spacing:-.03em;text-decoration:none;flex:none}
.mark{width:30px;height:30px;border-radius:7px;background:var(--accent);display:grid;place-items:center;flex:none}
.mark svg{width:16px;height:16px;display:block}
.brand small{font-family:var(--f-mono);font-weight:400;font-size:9px;letter-spacing:.2em;color:var(--muted);display:block;text-transform:uppercase;margin-top:-2px}
.nav{display:flex;gap:22px;margin-left:auto;font-size:14.5px}
.nav a{text-decoration:none;color:var(--ink-2);padding:6px 0;border-bottom:1.5px solid transparent}
.nav a:hover{color:var(--ink);border-bottom-color:var(--accent)}
.top-cta{display:flex;align-items:center;gap:14px;flex:none;margin-left:auto}
.nav+.top-cta{margin-left:0}
.tel{font-family:var(--f-mono);font-size:13.5px;text-decoration:none;color:var(--ink-2);white-space:nowrap}
.tel:hover{color:var(--accent-ink)}
.btn{display:inline-flex;align-items:center;gap:9px;border:1px solid transparent;border-radius:3px;padding:11px 20px;font-family:var(--f-disp);font-weight:600;font-size:14.5px;letter-spacing:-.01em;text-decoration:none;cursor:pointer;transition:transform .12s ease,background .15s ease,border-color .15s ease}
.btn-pri{background:var(--accent);color:#fff}
.btn-pri:hover{background:var(--accent-ink);transform:translateY(-1px)}
.btn-gho{background:transparent;color:var(--ink);border-color:var(--rule-2)}
.btn-gho:hover{border-color:var(--ink);transform:translateY(-1px)}
.btn-lt{background:#fff;color:#003473}
.btn-lt:hover{transform:translateY(-1px)}
.themer{background:none;border:1px solid var(--rule);border-radius:3px;width:34px;height:34px;display:grid;place-items:center;cursor:pointer;color:var(--ink-2);flex:none}
.themer:hover{border-color:var(--rule-2);color:var(--ink)}
@media(max-width:1100px){.nav,.tel{display:none}}

/* hero */
.hero{border-bottom:1px solid var(--rule);background:var(--surface)}
.hero-in{display:grid;grid-template-columns:1.08fr .92fr;gap:clamp(28px,4vw,60px);padding-block:clamp(44px,6vw,76px);align-items:start}
h1{font-size:clamp(35px,5vw,62px);letter-spacing:-.035em;line-height:1.04}
h1 em{font-style:normal;color:var(--accent-ink)}
.hero-copy{display:flex;flex-direction:column;gap:24px}
.hero-acts{display:flex;flex-wrap:wrap;gap:12px;align-items:center}
.hero-note{font-family:var(--f-mono);font-size:12px;color:var(--muted)}
.sig{border:1px solid var(--rule);border-radius:4px;background:var(--surface-2);overflow:hidden}
.sig-h{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 16px;border-bottom:1px solid var(--rule);font-family:var(--f-mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
.dot{width:7px;height:7px;border-radius:50%;background:var(--accent);display:inline-block;margin-right:7px;vertical-align:middle}
.sig-row{display:grid;grid-template-columns:1fr auto;gap:18px;align-items:center;padding:16px;border-bottom:1px solid var(--rule)}
.sig-row b{font-family:var(--f-disp);font-size:clamp(26px,3vw,36px);font-weight:700;letter-spacing:-.04em;font-variant-numeric:tabular-nums;line-height:1;text-align:right}
.sig-row b u{text-decoration:none;font-size:.5em;letter-spacing:0;color:var(--muted);margin-left:3px}
.sig-row span{font-size:14.5px;color:var(--ink-2);line-height:1.35}
.sig-row i{font-style:normal;font-family:var(--f-mono);font-size:10.5px;letter-spacing:.13em;text-transform:uppercase;color:var(--muted);display:block;margin-bottom:5px}
.sig-foot{padding:12px 16px;font-family:var(--f-mono);font-size:11px;color:var(--muted);background:var(--inset)}
@media(max-width:900px){.hero-in{grid-template-columns:1fr}}

/* client strip */
.strip{border-bottom:1px solid var(--rule)}
.strip-in{display:flex;align-items:center;gap:clamp(16px,3vw,40px);flex-wrap:wrap;padding-block:18px}
.strip-in p{font-family:var(--f-mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
.strip-in span{font-family:var(--f-disp);font-weight:600;font-size:15.5px;letter-spacing:-.01em;color:var(--ink-2)}

/* section frame */
.sec{border-bottom:1px solid var(--rule);padding-block:clamp(52px,7vw,92px)}
.sec-head{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:clamp(20px,4vw,56px);align-items:end;margin-bottom:clamp(28px,4vw,46px)}
.sec-head h2{font-size:clamp(27px,3.3vw,41px)}
.sec-head .eyebrow{margin-bottom:14px}
@media(max-width:860px){.sec-head{grid-template-columns:1fr}}

/* calculator */
.calc{display:grid;grid-template-columns:360px minmax(0,1fr);gap:0;border:1px solid var(--rule);border-radius:5px;background:var(--surface);box-shadow:var(--shadow);overflow:hidden}
.calc-in{border-right:1px solid var(--rule);padding:26px 24px;display:flex;flex-direction:column;gap:26px;background:var(--surface-2)}
.calc-out{padding:26px 24px;display:flex;flex-direction:column;gap:26px;min-width:0}
@media(max-width:940px){.calc{grid-template-columns:1fr}.calc-in{border-right:0;border-bottom:1px solid var(--rule)}}
.field{display:flex;flex-direction:column;gap:9px}
.field-top{display:flex;justify-content:space-between;align-items:baseline;gap:10px}
.field-top label{font-family:var(--f-mono);font-size:11px;letter-spacing:.13em;text-transform:uppercase;color:var(--muted)}
.field-val{font-family:var(--f-disp);font-weight:700;font-size:21px;letter-spacing:-.03em;font-variant-numeric:tabular-nums}
.field-val u{text-decoration:none;font-size:12px;font-family:var(--f-mono);font-weight:400;color:var(--muted);margin-left:4px;letter-spacing:0}
input[type=range]{-webkit-appearance:none;appearance:none;width:100%;height:22px;background:transparent;cursor:pointer;margin:0}
input[type=range]::-webkit-slider-runnable-track{height:3px;background:var(--rule-2);border-radius:2px}
input[type=range]::-moz-range-track{height:3px;background:var(--rule-2);border-radius:2px}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:17px;height:17px;border-radius:50%;background:var(--accent);border:3px solid var(--surface-2);box-shadow:0 0 0 1px var(--accent);margin-top:-7px}
input[type=range]::-moz-range-thumb{width:12px;height:12px;border-radius:50%;background:var(--accent);border:3px solid var(--surface-2);box-shadow:0 0 0 1px var(--accent)}
.scale{display:flex;justify-content:space-between;font-family:var(--f-mono);font-size:10.5px;color:var(--muted)}
.seg{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
.seg button{background:var(--surface);border:1px solid var(--rule);border-radius:3px;padding:10px 4px 9px;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:6px;font-family:var(--f-mono);font-size:10.5px;letter-spacing:.04em;color:var(--ink-2);transition:border-color .15s,background .15s}
.seg button svg{width:30px;height:17px;display:block}
.seg button:hover{border-color:var(--rule-2)}
.seg button[aria-pressed=true]{border-color:var(--accent);background:var(--accent-soft);color:var(--accent-ink)}
.readout{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:var(--rule);border:1px solid var(--rule);border-radius:4px;overflow:hidden}
.cell{background:var(--surface);padding:15px 16px}
.cell i{font-style:normal;font-family:var(--f-mono);font-size:10.5px;letter-spacing:.13em;text-transform:uppercase;color:var(--muted);display:block;margin-bottom:7px}
.cell b{font-family:var(--f-disp);font-weight:700;font-size:clamp(23px,2.5vw,30px);letter-spacing:-.04em;font-variant-numeric:tabular-nums;line-height:1;display:block}
.cell b u{text-decoration:none;font-size:.46em;color:var(--muted);margin-left:4px;letter-spacing:0}
.cell.hi{background:var(--accent-soft)}
.cell.hi b{color:var(--accent-ink)}
.cell small{display:block;margin-top:6px;font-size:12.5px;color:var(--muted);line-height:1.35}
.flow{border:1px solid var(--rule);border-radius:4px;background:var(--inset);padding:8px}
.flow svg{width:100%;height:auto;display:block}
.chart-box{border:1px solid var(--rule);border-radius:4px;background:var(--surface);padding:16px 16px 10px}
.chart-h{display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin-bottom:14px}
.chart-h h4{font-size:15px;letter-spacing:-.01em}
.chart-h span{font-family:var(--f-mono);font-size:11px;color:var(--muted)}
.bars{display:grid;grid-template-columns:repeat(12,1fr);gap:5px;align-items:end;height:112px}
.bar{position:relative;background:var(--accent);border-radius:3px 3px 0 0;min-height:3px;transition:height .35s cubic-bezier(.2,.7,.3,1);cursor:default}
.bar:hover{background:var(--accent-ink)}
.bar span{position:absolute;bottom:calc(100% + 8px);left:50%;transform:translateX(-50%);background:var(--ink);color:var(--bg);font-family:var(--f-mono);font-size:11px;padding:5px 8px;border-radius:3px;white-space:nowrap;opacity:0;pointer-events:none;transition:opacity .12s;z-index:5}
.bar:hover span,.bar:focus-visible span{opacity:1}
.bar-x{display:grid;grid-template-columns:repeat(12,1fr);gap:5px;margin-top:7px;border-top:1px solid var(--rule);padding-top:7px}
.bar-x i{font-style:normal;font-family:var(--f-mono);font-size:10px;color:var(--muted);text-align:center}
details.assum{border-top:1px solid var(--rule);padding-top:14px}
details.assum summary{font-family:var(--f-mono);font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);cursor:pointer}
details.assum summary:hover{color:var(--ink-2)}
details.assum ul{margin:12px 0 0;padding-left:18px;font-size:13.5px;color:var(--ink-2);line-height:1.6}
details.assum li{margin-bottom:4px}

/* services */
.svcs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:var(--rule);border-block:1px solid var(--rule)}
@media(max-width:900px){.svcs{grid-template-columns:1fr}}
.svc{background:var(--surface);padding:28px 26px 30px;display:flex;flex-direction:column;gap:15px}
.svc-i{width:36px;height:36px;color:var(--accent);}
.svc h3{font-size:20px}
.svc p{font-size:15.5px;color:var(--ink-2)}
.svc ul{margin:auto 0 0;padding:0;list-style:none;display:flex;flex-direction:column;gap:7px;padding-top:6px}
.svc li{font-family:var(--f-mono);font-size:12.5px;color:var(--ink-2);display:flex;gap:9px;align-items:baseline}
.svc li::before{content:"";width:5px;height:5px;border-radius:1px;background:var(--accent);flex:none;transform:translateY(-2px)}

/* process */
.steps{display:flex;flex-direction:column}
.step{display:grid;grid-template-columns:58px minmax(0,1fr) 170px;gap:clamp(16px,3vw,40px);padding:22px 0;border-top:1px solid var(--rule);align-items:start}
.step:last-child{border-bottom:1px solid var(--rule)}
.step-n{font-family:var(--f-mono);font-size:13px;color:var(--accent-ink);padding-top:3px;letter-spacing:.06em}
.step h3{font-size:19px;margin-bottom:6px}
.step p{font-size:15.5px;color:var(--ink-2);max-width:60ch}
.step-t{font-family:var(--f-mono);font-size:12.5px;color:var(--muted);text-align:right;padding-top:4px}
@media(max-width:760px){.step{grid-template-columns:44px 1fr}.step-t{grid-column:2;text-align:left;padding-top:0}}

/* refs + foerderung */
.two{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
@media(max-width:900px){.two{grid-template-columns:1fr}}
.ref{border:1px solid var(--rule);border-radius:4px;background:var(--surface);padding:22px;display:flex;flex-direction:column;gap:14px}
.ref h3{font-size:18px}
.ref .branch{font-family:var(--f-mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.ref dl{margin:0;display:grid;grid-template-columns:1fr auto;gap:9px 12px;font-size:14px;border-top:1px solid var(--rule);padding-top:14px}
.ref dt{color:var(--muted);font-size:13.5px}
.ref dd{margin:0;font-family:var(--f-mono);font-variant-numeric:tabular-nums;text-align:right;color:var(--ink-2)}
.tag{align-self:flex-start;font-family:var(--f-mono);font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--solar);background:var(--solar-soft);border:1px solid var(--solar);border-radius:2px;padding:3px 7px}
.fund{width:100%;border-collapse:collapse;font-size:15px}
.fund th{text-align:left;font-family:var(--f-mono);font-size:10.5px;letter-spacing:.13em;text-transform:uppercase;color:var(--muted);font-weight:400;padding:0 14px 10px 0;border-bottom:1px solid var(--rule-2)}
.fund td{padding:15px 14px 15px 0;border-bottom:1px solid var(--rule);vertical-align:top;color:var(--ink-2)}
.fund td:first-child{color:var(--ink);font-family:var(--f-disp);font-weight:600;letter-spacing:-.01em;width:26%}
.fund td:last-child{padding-right:0}
.table-scroll{overflow-x:auto}

/* faq */
.faq{border-top:1px solid var(--rule);max-width:900px}
.qa{border-bottom:1px solid var(--rule)}
.qa summary{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:19px 0;cursor:pointer;font-family:var(--f-disp);font-weight:600;font-size:17.5px;letter-spacing:-.015em;list-style:none}
.qa summary::-webkit-details-marker{display:none}
.qa summary::after{content:"+";font-family:var(--f-mono);font-size:19px;color:var(--accent-ink);flex:none;line-height:1}
.qa[open] summary::after{content:"–"}
.qa p{padding-bottom:20px;font-size:15.5px;color:var(--ink-2);max-width:72ch}

/* cta / form */
.cta{background:var(--navy);color:var(--on-navy);border-bottom:1px solid var(--rule)}
.cta-in{display:grid;grid-template-columns:minmax(0,1fr) 420px;gap:clamp(28px,4vw,64px);padding-block:clamp(48px,6vw,80px);align-items:start}
@media(max-width:940px){.cta-in{grid-template-columns:1fr}}
.cta h2{font-size:clamp(28px,3.4vw,42px);color:#fff}
.cta .eyebrow{color:var(--on-navy-dim)}
.cta .eyebrow::before{background:var(--on-navy-dim)}
.cta-lede{color:var(--on-navy-dim);font-size:18px;max-width:50ch;margin-top:16px}
.contacts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px;margin-top:34px;padding-top:26px;border-top:1px solid rgba(255,255,255,.16)}
.contacts div i{font-style:normal;font-family:var(--f-mono);font-size:10.5px;letter-spacing:.13em;text-transform:uppercase;color:var(--on-navy-dim);display:block;margin-bottom:7px}
.contacts a,.contacts p{color:#fff;text-decoration:none;font-size:15.5px;line-height:1.5}
.contacts a:hover{text-decoration:underline}
.form{background:var(--surface);border-radius:5px;padding:24px;display:flex;flex-direction:column;gap:16px;color:var(--ink)}
.form h3{font-size:19px}
.form label.lbl{font-family:var(--f-mono);font-size:10.5px;letter-spacing:.13em;text-transform:uppercase;color:var(--muted);display:block;margin-bottom:8px}
.form input[type=text],.form input[type=email],.form select{width:100%;background:var(--surface-2);border:1px solid var(--rule);border-radius:3px;padding:11px 12px;font-size:15px}
.form input:focus,.form select:focus{border-color:var(--accent);outline:none}
.form .row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.form .fine{font-size:12.5px;color:var(--muted);line-height:1.45}
.sent{display:none;border:1px solid var(--accent-line);background:var(--accent-soft);border-radius:3px;padding:14px;font-size:14px;color:var(--accent-ink)}
.sent.on{display:block}
.sent b{display:block;font-family:var(--f-disp);margin-bottom:5px}
.sent code{font-family:var(--f-mono);font-size:12.5px;color:var(--ink-2);display:block;margin-top:8px;line-height:1.6}

/* footer */
footer{background:var(--bg);padding-block:clamp(40px,5vw,60px) 26px}
.f-grid{display:grid;grid-template-columns:1.4fr repeat(3,1fr);gap:clamp(20px,3vw,40px)}
@media(max-width:860px){.f-grid{grid-template-columns:1fr 1fr}}
.f-grid h4{font-family:var(--f-mono);font-weight:500;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-bottom:14px}
.f-grid ul{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:9px}
.f-grid a{text-decoration:none;color:var(--ink-2);font-size:14.5px}
.f-grid a:hover{color:var(--accent-ink)}
.f-addr{font-size:14.5px;color:var(--ink-2);line-height:1.6;margin-top:14px}
.f-bot{display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap;margin-top:clamp(32px,4vw,50px);padding-top:20px;border-top:1px solid var(--rule);font-family:var(--f-mono);font-size:11.5px;color:var(--muted)}
