<script>
(function(){
  "use strict";
  var root=document.documentElement, tb=document.getElementById("themer");
  function cur(){ var s=root.getAttribute("data-theme"); if(s) return s;
    return window.matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light"; }
  tb.addEventListener("click",function(){ root.setAttribute("data-theme", cur()==="dark"?"light":"dark"); });

  var ROOF={
    flach:{m2:2.6, use:.75, y:1030, label:"Flachdach"},
    pult:{m2:1.95, use:.80, y:1080, label:"Pultdach"},
    sattel:{m2:1.95, use:.70, y:1060, label:"Satteldach"},
    sonst:{m2:2.2, use:.60, y:950, label:"Sonstige"}
  };
  var MONTH=[2.8,4.6,8.3,11.2,12.9,13.0,13.5,12.0,9.2,6.5,3.4,2.6];
  var MN=["J","F","M","A","M","J","J","A","S","O","N","D"];
  var MFULL=["Jänner","Februar","März","April","Mai","Juni","Juli","August","September","Oktober","November","Dezember"];
  var FEED=0.06, CO2=0.227, MODW=0.45;

  var roof="flach";
  var elArea=document.getElementById("area"), elUse=document.getElementById("use"), elPrice=document.getElementById("price");
  var $=function(id){return document.getElementById(id);};
  var de=function(n,d){ return Number(n).toLocaleString("de-AT",{minimumFractionDigits:d||0,maximumFractionDigits:d||0}); };

  function costPerKwp(k){ if(k<30)return 1300; if(k<100)return 1100; if(k<300)return 950; if(k<1000)return 820; return 740; }

  var barsBuilt=false;
  function buildBars(){
    var b=$("bars"), x=$("barsx"), i;
    for(i=0;i<12;i++){
      var d=document.createElement("div"); d.className="bar"; d.tabIndex=0;
      var s=document.createElement("span"); s.id="bt"+i; d.appendChild(s); b.appendChild(d);
      var t=document.createElement("i"); t.textContent=MN[i]; x.appendChild(t);
    }
    barsBuilt=true;
  }

  function render(){
    var r=ROOF[roof];
    var area=+elArea.value, useMWh=+elUse.value, price=+elPrice.value/100;
    var useKwh=useMWh*1000;

    var kwp=Math.round(area*r.use/r.m2);
    var yieldKwh=Math.round(kwp*r.y);
    var ratio=useKwh>0?yieldKwh/useKwh:99;
    var evq=Math.max(.12, Math.min(.95, .95*Math.exp(-0.8*ratio)));
    var evKwh=Math.round(yieldKwh*evq);
    var feedKwh=yieldKwh-evKwh;
    var rest=Math.max(0,useKwh-evKwh);
    var save=Math.round(evKwh*price+feedKwh*FEED);
    var invest=Math.round(kwp*costPerKwp(kwp));
    var pay=save>0?invest/save:0;
    var co2=Math.round(yieldKwh*CO2/1000);
    var cover=useKwh>0?Math.round(evKwh/useKwh*100):0;

    $("v-area").innerHTML=de(area)+"<u>m²</u>";
    $("v-use").innerHTML=de(useMWh)+"<u>MWh</u>";
    $("v-price").innerHTML=de(price*100,1)+"<u>ct/kWh</u>";

    $("o-kwp").innerHTML=de(kwp)+"<u>kWp</u>";
    $("o-mod").textContent="ca. "+de(Math.round(kwp/MODW))+" Module · "+r.label;
    $("o-yield").innerHTML=de(yieldKwh)+"<u>kWh</u>";
    $("o-spec").textContent=de(r.y)+" kWh je kWp und Jahr";
    $("o-save").innerHTML=de(save)+"<u>€</u>";
    $("o-save-sub").textContent="davon "+de(Math.round(evKwh*price))+" € vermiedener Strombezug";
    $("o-pay").innerHTML=de(pay,1)+"<u>Jahre</u>";
    $("o-invest").textContent="Investition ca. "+de(invest)+" € ohne Förderung";
    $("o-ev").innerHTML=de(Math.round(evq*100))+"<u>%</u>";
    $("o-ev-sub").textContent="deckt "+cover+" % Ihres Strombedarfs";
    $("o-co2").innerHTML=de(co2)+"<u>t</u>";

    $("f-kwp").textContent=de(kwp)+" kWp";
    $("f-ev").textContent=de(evKwh)+" kWh/a";
    $("f-feed").textContent=de(feedKwh)+" kWh/a";
    $("f-grid").textContent="Restbezug "+de(rest)+" kWh/a";
    var p2=document.getElementById("p2"), p3=document.getElementById("p3");
    p2.setAttribute("stroke-width", (3+11*evq).toFixed(1));
    p3.setAttribute("stroke-width", (3+11*(1-evq)).toFixed(1));

    if(!barsBuilt) buildBars();
    var bars=$("bars").children, max=Math.max.apply(null,MONTH), i, peak=0, pi=0;
    for(i=0;i<12;i++){
      var v=Math.round(yieldKwh*MONTH[i]/100);
      bars[i].style.height=(MONTH[i]/max*100)+"%";
      bars[i].setAttribute("aria-label", MFULL[i]+": "+de(v)+" kWh");
      document.getElementById("bt"+i).textContent=MFULL[i]+" · "+de(v)+" kWh";
      if(v>peak){peak=v;pi=i;}
    }
    $("chart-peak").textContent="Spitze "+MFULL[pi]+" · "+de(peak)+" kWh";
  }

  [elArea,elUse,elPrice].forEach(function(el){ el.addEventListener("input",render); });
  Array.prototype.forEach.call(document.querySelectorAll(".seg button"),function(b){
    b.addEventListener("click",function(){
      Array.prototype.forEach.call(document.querySelectorAll(".seg button"),function(o){o.setAttribute("aria-pressed","false");});
      b.setAttribute("aria-pressed","true"); roof=b.dataset.roof; render();
    });
  });
  render();

  if(!window.matchMedia("(prefers-reduced-motion: reduce)").matches){
    var off=0;
    setInterval(function(){ off=(off-1.6)%26;
      ["p1","p2","p3"].forEach(function(id){ document.getElementById(id).setAttribute("stroke-dashoffset",off); });
      document.getElementById("p4").setAttribute("stroke-dashoffset",-off*0.5);
    },40);
  }

  document.getElementById("form").addEventListener("submit",function(e){
    e.preventDefault();
    var s=$("sent");
    s.className="sent on";
    s.innerHTML="<b>Vorschau – es wurde nichts versendet.</b>Dieses Formular ist in der Designstudie noch nicht angebunden. Für den Livebetrieb an CRM oder Postfach koppeln.<code>Dachform: "+$("f-roof").value+"<br>Fläche: "+($("f-area").value||"–")+" m²<br>Verbrauch: "+($("f-use").value||"–")+" MWh/a<br>Unternehmen: "+($("f-comp").value||"–")+"</code>";
  });

  document.querySelectorAll('a[href^="#"]').forEach(function(a){
    a.addEventListener("click",function(e){
      var t=document.querySelector(a.getAttribute("href"));
      if(t){ e.preventDefault(); t.scrollIntoView({behavior:"smooth",block:"start"}); }
    });
  });
})();
</script>
