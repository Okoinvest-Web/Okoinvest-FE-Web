<script>
(function(){
"use strict";
var RM=window.matchMedia("(prefers-reduced-motion: reduce)").matches;
var $=function(i){return document.getElementById(i);};
var de=function(n,d){d=d||0;return Number(n).toLocaleString("de-AT",{minimumFractionDigits:d,maximumFractionDigits:d});};

/* ---------- mobile menu ---------- */
var bg=$("burger"),mb=$("mob");
bg.addEventListener("click",function(){var o=mb.classList.toggle("on");bg.setAttribute("aria-expanded",o?"true":"false");});
mb.addEventListener("click",function(e){if(e.target.tagName==="A"){mb.classList.remove("on");bg.setAttribute("aria-expanded","false");}});

/* ---------- hero canvas: receding module array ---------- */
(function(){
  var cv=$("field"),ctx=cv.getContext("2d"),W=0,H=0,dpr=Math.min(window.devicePixelRatio||1,2);
  var COLS=26,ROWS=13;
  function size(){
    var r=cv.parentNode.getBoundingClientRect();
    W=r.width;H=r.height;cv.width=W*dpr;cv.height=H*dpr;
    ctx.setTransform(dpr,0,0,dpr,0,0);
  }
  function proj(cx,cy){
    var hz=H*0.40, vx=W*0.5;
    var t=cy/ROWS, k=Math.pow(t,2.1);
    var y=hz+(H-hz)*k;
    var spread=0.06+2.05*k;
    var x=vx+(cx-COLS/2)*(W/COLS)*spread;
    return [x,y];
  }
  var t0=performance.now();
  function frame(now){
    var el=(now-t0)/1000;
    ctx.clearRect(0,0,W,H);
    /* horizon glow */
    var g=ctx.createLinearGradient(0,H*0.24,0,H*0.52);
    g.addColorStop(0,"rgba(69,224,255,0)");g.addColorStop(.55,"rgba(69,224,255,.10)");g.addColorStop(1,"rgba(140,224,75,.05)");
    ctx.fillStyle=g;ctx.fillRect(0,H*0.24,W,H*0.30);
    var sweep=((el*0.16)%1.35)-0.18;
    for(var r=0;r<ROWS;r++){
      for(var c=0;c<COLS;c++){
        var a=proj(c,r),b=proj(c+1,r),d=proj(c+1,r+1),e=proj(c,r+1);
        if(e[1]<H*0.40)continue;
        var t=r/ROWS;
        var dist=Math.abs(t-sweep);
        var lit=Math.max(0,1-dist/0.20);
        var base=0.045+0.10*t;
        ctx.beginPath();ctx.moveTo(a[0],a[1]);ctx.lineTo(b[0],b[1]);ctx.lineTo(d[0],d[1]);ctx.lineTo(e[0],e[1]);ctx.closePath();
        ctx.fillStyle="rgba(20,44,74,"+(base+lit*0.30).toFixed(3)+")";ctx.fill();
        ctx.strokeStyle="rgba("+(lit>0.05?"140,224,75,":"90,140,190,")+(0.06+lit*0.55).toFixed(3)+")";
        ctx.lineWidth=lit>0.05?1.1:0.7;ctx.stroke();
      }
    }
    /* drifting photons */
    for(var i=0;i<44;i++){
      var s=(i*97)%1000/1000;
      var px=((s*1.7+el*0.012*(0.4+s))%1)*W;
      var py=H*0.10+((s*3.1+el*0.030*(0.3+s))%1)*H*0.34;
      var al=0.10+0.34*Math.abs(Math.sin(el*0.6+i));
      ctx.fillStyle="rgba(255,180,61,"+al.toFixed(3)+")";
      ctx.fillRect(px,py,1.6,1.6);
    }
    if(!RM)raf=requestAnimationFrame(frame);
  }
  var raf;
  window.addEventListener("resize",function(){size();if(RM)frame(performance.now());});
  size();
  if(RM){frame(performance.now());}else{raf=requestAnimationFrame(frame);}
})();

/* ---------- hero counters ---------- */
if(!RM){
  Array.prototype.forEach.call(document.querySelectorAll("[data-cnt]"),function(el){
    var target=+el.dataset.cnt,unit=el.querySelector(".unit"),u=unit?unit.outerHTML:"",t0=performance.now();
    function step(n){
      var p=Math.min(1,(n-t0)/1100),e=1-Math.pow(1-p,3);
      el.innerHTML=de(Math.round(target*(0.45+0.55*e)))+u;
      if(p<1)requestAnimationFrame(step);else el.innerHTML=de(target)+u;
    }
    requestAnimationFrame(step);
  });
}

/* ---------- configurator ---------- */
var ROOF={
  flach:{m2:2.6,use:.75,y:1030,l:"Flachdach Ost-West"},
  pult:{m2:1.95,use:.80,y:1080,l:"Pultdach dachparallel"},
  sattel:{m2:1.95,use:.70,y:1060,l:"Satteldach beidseitig"},
  sonst:{m2:2.2,use:.60,y:950,l:"Sonderkonstruktion"}
};
var MONTH=[2.8,4.6,8.3,11.2,12.9,13.0,13.5,12.0,9.2,6.5,3.4,2.6];
var MN=["J","F","M","A","M","J","J","A","S","O","N","D"];
var MF=["Jänner","Februar","März","April","Mai","Juni","Juli","August","September","Oktober","November","Dezember"];
var FEED=0.06,CO2F=0.227,MODW=0.45,ESC=0.02,DEG=0.005,YRS=20;
var roof="flach",built=false;
var eA=$("area"),eU=$("use"),eP=$("price");
function cpk(k){return k<30?1300:k<100?1100:k<300?950:k<1000?820:740;}

function build(){
  var b=$("bars"),x=$("barsx");
  for(var i=0;i<12;i++){
    var d=document.createElement("div");d.className="bar";d.tabIndex=0;
    var s=document.createElement("span");s.id="bt"+i;d.appendChild(s);b.appendChild(d);
    var t=document.createElement("i");t.textContent=MN[i];x.appendChild(t);
  }
  built=true;
}

function cashflow(invest,save){
  var pts=[],cum=-invest,i,s=save;
  pts.push(cum);
  for(i=1;i<=YRS;i++){ s=save*Math.pow(1+ESC,i-1)*Math.pow(1-DEG,i-1); cum+=s; pts.push(cum); }
  return pts;
}

function drawCash(pts){
  var svg=$("cash"),W=420,H=176,L=44,R=8,T=12,B=26;
  var min=Math.min.apply(null,pts),max=Math.max.apply(null,pts);
  var pad=(max-min)*0.12||1; min-=pad; max+=pad;
  var px=function(i){return L+(W-L-R)*(i/YRS);};
  var py=function(v){return T+(H-T-B)*(1-(v-min)/(max-min));};
  var zero=py(0),d="",a="",i;
  for(i=0;i<pts.length;i++){ d+=(i?"L":"M")+px(i).toFixed(1)+" "+py(pts[i]).toFixed(1)+" "; }
  a="M"+px(0).toFixed(1)+" "+zero.toFixed(1)+" "+d.substring(1)+"L"+px(YRS).toFixed(1)+" "+zero.toFixed(1)+"Z";
  /* break-even crossing */
  var bx=null;
  for(i=1;i<pts.length;i++){ if(pts[i-1]<0&&pts[i]>=0){ var f=(0-pts[i-1])/(pts[i]-pts[i-1]); bx=px(i-1)+(px(i)-px(i-1))*f; break; } }
  var fmt=function(v){ return (v>=0?"+":"−")+de(Math.abs(v)/1000)+"k"; };
  var s='<defs><linearGradient id="cg" x1="0" y1="0" x2="0" y2="1">'
    +'<stop offset="0%" stop-color="#8CE04B" stop-opacity=".42"/><stop offset="100%" stop-color="#8CE04B" stop-opacity="0"/></linearGradient></defs>';
  s+='<line x1="'+L+'" y1="'+zero.toFixed(1)+'" x2="'+(W-R)+'" y2="'+zero.toFixed(1)+'" stroke="rgba(150,180,220,.30)" stroke-width="1"/>';
  s+='<path d="'+a+'" fill="url(#cg)"/>';
  s+='<path d="'+d+'" fill="none" stroke="#8CE04B" stroke-width="2" stroke-linejoin="round"/>';
  if(bx!==null){
    s+='<line x1="'+bx.toFixed(1)+'" y1="'+T+'" x2="'+bx.toFixed(1)+'" y2="'+(H-B)+'" stroke="#FFB43D" stroke-width="1" stroke-dasharray="3 4"/>';
    s+='<circle cx="'+bx.toFixed(1)+'" cy="'+zero.toFixed(1)+'" r="4" fill="#FFB43D"/>';
    s+='<text x="'+Math.min(bx+7,W-92).toFixed(1)+'" y="'+(T+12)+'" fill="#FFB43D" font-family="JetBrains Mono, monospace" font-size="10">Break-even</text>';
  }
  s+='<circle cx="'+px(YRS).toFixed(1)+'" cy="'+py(pts[YRS]).toFixed(1)+'" r="3.5" fill="#8CE04B"/>';
  s+='<text x="'+(L-6)+'" y="'+(zero+3.5).toFixed(1)+'" text-anchor="end" fill="rgba(159,180,206,.9)" font-family="JetBrains Mono, monospace" font-size="9.5">0 €</text>';
  s+='<text x="'+(L-6)+'" y="'+(py(pts[YRS])+3.5).toFixed(1)+'" text-anchor="end" fill="#8CE04B" font-family="JetBrains Mono, monospace" font-size="9.5">'+fmt(pts[YRS])+'</text>';
  s+='<text x="'+(L-6)+'" y="'+(py(pts[0])+3.5).toFixed(1)+'" text-anchor="end" fill="rgba(159,180,206,.75)" font-family="JetBrains Mono, monospace" font-size="9.5">'+fmt(pts[0])+'</text>';
  s+='<text x="'+L+'" y="'+(H-8)+'" fill="rgba(97,117,149,1)" font-family="JetBrains Mono, monospace" font-size="9.5">Jahr 0</text>';
  s+='<text x="'+(W-R)+'" y="'+(H-8)+'" text-anchor="end" fill="rgba(97,117,149,1)" font-family="JetBrains Mono, monospace" font-size="9.5">Jahr 20</text>';
  svg.innerHTML=s;
}

function render(){
  var r=ROOF[roof],area=+eA.value,useM=+eU.value,price=+eP.value/100,useK=useM*1000;
  var kwp=Math.round(area*r.use/r.m2), yld=Math.round(kwp*r.y);
  var ratio=useK>0?yld/useK:99;
  var evq=Math.max(.12,Math.min(.95,.95*Math.exp(-0.8*ratio)));
  var evK=Math.round(yld*evq), feed=yld-evK, rest=Math.max(0,useK-evK);
  var save=Math.round(evK*price+feed*FEED), inv=Math.round(kwp*cpk(kwp));
  var pay=save>0?inv/save:0, co2=Math.round(yld*CO2F/1000), cov=useK>0?Math.round(evK/useK*100):0;

  $("v-area").innerHTML=de(area)+'<span class="unit">m²</span>';
  $("v-use").innerHTML=de(useM)+'<span class="unit">MWh</span>';
  $("v-price").innerHTML=de(price*100,1)+'<span class="unit">ct/kWh</span>';
  $("stamp").textContent="Profil: "+r.l;

  $("o-kwp").innerHTML=de(kwp)+'<span class="unit">kWp</span>';
  $("o-mod").textContent=de(Math.round(kwp/MODW))+" Module";
  $("o-yield").innerHTML=de(yld)+'<span class="unit">kWh</span>';
  $("o-spec").textContent=de(r.y)+" kWh/kWp";
  $("o-save").innerHTML=de(save)+'<span class="unit">€</span>';
  $("o-savesub").textContent=de(Math.round(evK*price))+" € Strombezug vermieden";
  $("o-inv").innerHTML=de(inv)+'<span class="unit">€</span>';
  $("o-spez").textContent=de(cpk(kwp))+" €/kWp";
  $("o-pay").innerHTML=de(pay,1)+'<span class="unit">Jahre</span>';
  $("o-co2").innerHTML=de(co2)+'<span class="unit">t</span>';

  var pct=Math.round(evq*100);
  $("g-val").textContent=pct+"%";
  $("g-arc").setAttribute("stroke-dashoffset",(367-367*evq*0.935).toFixed(1));
  $("g-sub").textContent="deckt "+cov+" % des Strombedarfs";

  $("f-kwp").textContent=de(kwp)+" kWp";
  $("f-ev").textContent=de(evK)+" kWh/a";
  $("f-feed").textContent=de(feed)+" kWh/a";
  $("f-grid").textContent="Restbezug "+de(rest)+" kWh";
  $("p2").setAttribute("stroke-width",(3+12*evq).toFixed(1));
  $("p3").setAttribute("stroke-width",(3+12*(1-evq)).toFixed(1));

  if(!built)build();
  var bars=$("bars").children,mx=Math.max.apply(null,MONTH),i,pk=0,pi=0;
  for(i=0;i<12;i++){
    var v=Math.round(yld*MONTH[i]/100);
    bars[i].style.height=(MONTH[i]/mx*100)+"%";
    bars[i].setAttribute("aria-label",MF[i]+": "+de(v)+" kWh");
    $("bt"+i).textContent=MF[i]+" · "+de(v)+" kWh";
    if(v>pk){pk=v;pi=i;}
  }
  $("c-peak").textContent=MF[pi]+" · "+de(pk)+" kWh";

  var cf=cashflow(inv,save);
  drawCash(cf);
  $("c-net").textContent="Netto nach 20 J · "+(cf[YRS]>=0?"+":"−")+de(Math.abs(cf[YRS])/1e6,2)+" Mio €";
}

[eA,eU,eP].forEach(function(el){el.addEventListener("input",render);});
Array.prototype.forEach.call(document.querySelectorAll(".seg button"),function(b){
  b.addEventListener("click",function(){
    Array.prototype.forEach.call(document.querySelectorAll(".seg button"),function(o){o.setAttribute("aria-pressed","false");});
    b.setAttribute("aria-pressed","true");roof=b.dataset.roof;render();
  });
});
render();

