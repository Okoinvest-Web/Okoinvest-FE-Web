if(!RM){
  var off=0;
  setInterval(function(){
    off=(off-1.4)%28;
    ["p1","p2","p3"].forEach(function(id){$(id).setAttribute("stroke-dashoffset",off);});
    $("p4").setAttribute("stroke-dashoffset",-off*0.5);
  },42);
}

