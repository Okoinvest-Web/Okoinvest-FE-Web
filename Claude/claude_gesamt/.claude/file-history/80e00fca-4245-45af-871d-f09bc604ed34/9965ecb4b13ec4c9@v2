        <div class="panel dk">
          <div class="panel-h"><h4>Deckung des Betriebstags</h4><span id="c-note">—</span></div>
          <svg id="ch" viewBox="0 0 760 232" role="img" aria-label="Stündliche Deckung des Lastgangs durch PV, Speicher und Netz"></svg>
          <div class="legend">
