<section class="hero">
  <div class="wrap hero-in">
    <div class="hero-grid">
      <div>
        <span class="kicker s">Dynamischer Stromtarif</span>
        <h1>Strom kostet um 13 Uhr etwas anderes als um <span class="gl">19 Uhr</span>.</h1>
        <p class="lede">Im dynamischen Tarif folgt der Arbeitspreis dem Börsenpreis jeder Stunde. Wer Prozesse verschieben kann, holt sich die Differenz. Probieren Sie es direkt am Tagesverlauf aus.</p>
        <div class="hero-acts">
          <a class="btn btn-v" href="#tool">Lasten verschieben</a>
          <a class="btn btn-o" href="#details">Voraussetzungen</a>
        </div>
      </div>
      <div class="chips">
        <div class="chip s"><div><i>Spreizung</i><p>Abstand zwischen teuerster und günstigster Stunde</p></div><b>3–5<span class="unit">fach</span></b></div>
        <div class="chip v"><div><i>Verschiebepotenzial</i><p>Typisch verschiebbarer Anteil im Gewerbe</p></div><b>10–30<span class="unit">%</span></b></div>
        <div class="chip c"><div><i>Voraussetzung</i><p>Viertelstundenwerte über die Kundenschnittstelle</p></div><b>Smart<span class="unit">Meter</span></b></div>
      </div>
    </div>
  </div>
</section>

<section class="sec" id="tool">
  <div class="wrap">
    <div class="sec-head">
      <div><span class="kicker">Lastverschiebung</span><h2>Klicken Sie Ihre Prozesse in die günstigen Stunden.</h2></div>
      <p class="lede">Jeder Block steht für einen verschiebbaren Prozess von einer Stunde. Setzen Sie die Blöcke per Klick auf eine Stunde, oder lassen Sie sie automatisch optimal platzieren.</p>
    </div>

    <div class="console glass chamf">
      <div class="con-t"><span><span class="pulse"></span>Börsenpreise · Beispieltag</span><span id="stamp">0 von 4 Blöcken gesetzt</span></div>
      <div class="con-l">
        <div class="field">
          <div class="field-h"><label for="base">Grundlast</label><span class="field-v" id="v-base">80<span class="unit">kW</span></span></div>
          <input id="base" type="range" min="5" max="600" step="5" value="80">
          <div class="scale"><span>5</span><span>600 kW</span></div>
        </div>
        <div class="field">
          <div class="field-h"><label for="shift">Verschiebbare Leistung</label><span class="field-v" id="v-shift">120<span class="unit">kW</span></span></div>
          <input id="shift" type="range" min="10" max="800" step="10" value="120">
          <div class="scale"><span>10</span><span>800 kW</span></div>
        </div>
        <div class="field">
          <div class="field-h"><label for="blocks">Prozessblöcke</label><span class="field-v" id="v-blocks">4<span class="unit">×1h</span></span></div>
          <input id="blocks" type="range" min="1" max="10" step="1" value="4">
          <div class="scale"><span>1</span><span>10</span></div>
        </div>
        <div class="field">
          <div class="field-h"><label for="lvl">Preisniveau</label><span class="field-v" id="v-lvl">95<span class="unit">€/MWh</span></span></div>
          <input id="lvl" type="range" min="20" max="260" step="5" value="95">
          <div class="scale"><span>20</span><span>260 €/MWh</span></div>
        </div>
        <div class="field">
          <div class="field-h"><label for="fix">Fixtarif Energie</label><span class="field-v" id="v-fix">11,0<span class="unit">ct/kWh</span></span></div>
          <input id="fix" type="range" min="4" max="30" step="0.5" value="11">
          <div class="scale"><span>4</span><span>30 ct/kWh</span></div>
        </div>
        <button class="sw" id="opt" type="button" aria-pressed="false">Optimal platzieren<span class="tr"></span></button>
        <button class="sw" id="clr" type="button" aria-pressed="false">Alle Blöcke entfernen<span class="tr"></span></button>
        <details class="as">
          <summary>Rechenannahmen</summary>
          <ul>
            <li>Beispieltag mit typischem Winterprofil, Morgen- und Abendspitze</li>
            <li>Der Regler Preisniveau skaliert die gesamte Kurve auf den gewünschten Tagesmittelwert</li>
            <li>Lieferantenaufschlag im dynamischen Tarif 1,5 ct/kWh</li>
            <li>Netzentgelte und Abgaben 12 ct/kWh, in beiden Varianten gleich</li>
            <li>Die Grundlast läuft konstant über alle 24 Stunden</li>
            <li>250 vergleichbare Betriebstage im Jahr</li>
          </ul>
        </details>
      </div>

      <div class="con-r">
        <div class="stats">
          <div class="stat s"><i>Ø Börsenpreis</i><b id="o-avg">—<span class="unit">ct/kWh</span></b><small id="o-rng">—</small></div>
          <div class="stat"><i>Ihr Bezugspreis</i><b id="o-eff">—<span class="unit">ct/kWh</span></b><small id="o-eff2">mengengewichtet</small></div>
          <div class="stat"><i>Kosten dynamisch</i><b id="o-dyn">—<span class="unit">€</span></b><small>am Beispieltag</small></div>
          <div class="stat"><i>Kosten Fixtarif</i><b id="o-fixc">—<span class="unit">€</span></b><small>gleiche Energiemenge</small></div>
          <div class="stat v"><i>Differenz am Tag</i><b id="o-diff">—<span class="unit">€</span></b><small id="o-diff2">—</small></div>
          <div class="stat v"><i>Hochgerechnet</i><b id="o-year">—<span class="unit">€/a</span></b><small>250 Betriebstage</small></div>
        </div>

        <div class="panel dk">
          <div class="panel-h"><h4>Börsenpreis und Ihre Blöcke</h4><span id="c-note">Stunde anklicken, um einen Block zu setzen</span></div>
          <svg id="ch" viewBox="0 0 760 260" role="img" aria-label="Stündliche Börsenpreise mit gesetzten Lastblöcken"></svg>
          <div class="legend">
            <span><i style="background:#FFB43D"></i>Börsenpreis je Stunde</span>
            <span><i style="background:#8CE04B"></i>Block gesetzt</span>
            <span><i style="background:#45E0FF;height:3px"></i>Tagesmittel</span>
          </div>
        </div>
        <p class="fine">Der Beispieltag zeigt das Prinzip. In der Praxis liefern wir die Auswertung auf Basis Ihrer echten Viertelstundenwerte und der Preishistorie Ihres Bilanzgruppenverantwortlichen.</p>
      </div>
    </div>
  </div>
</section>

<section class="sec" id="details">
  <div class="wrap">
    <div class="sec-head">
      <div><span class="kicker c">Voraussetzungen</span><h2>Wann sich ein dynamischer Tarif rechnet.</h2></div>
      <p class="lede">Der Tarif allein spart nichts. Er belohnt ausschließlich Betriebe, die Lasten tatsächlich verschieben können und das auch organisatorisch durchhalten.</p>
    </div>
    <div class="cards">
      <article class="card">
        <span class="n">A — TECHNIK</span>
        <svg class="ic" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="16" cy="16" r="12"/><path d="M16 16l6-5M16 8v2M24 16h-2M16 24v-2M8 16h2"/></svg>
        <h3>Smart Meter und Schnittstelle</h3>
        <p>Abgerechnet wird auf Basis der Viertelstundenwerte. Die Kundenschnittstelle des Zählers muss freigeschaltet sein, damit Steuerung und Auswertung überhaupt funktionieren.</p>
        <ul><li>Viertelstundenwerte aktivieren</li><li>Datenfreigabe beim Netzbetreiber</li><li>Anbindung an die Steuerung</li></ul>
      </article>
      <article class="card">
        <span class="n">B — PROZESS</span>
        <svg class="ic" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 8h22M5 16h14M5 24h18"/><circle cx="24" cy="16" r="3"/><circle cx="27" cy="24" r="3"/></svg>
        <h3>Verschiebbare Lasten</h3>
        <p>Kälteanlagen, Druckluft, Trocknung, Ladeinfrastruktur und Wärmepumpen lassen sich zeitlich verlagern. Eine laufende Produktionslinie dagegen nicht. Das Potenzial ist meist kleiner als erhofft, aber selten null.</p>
        <ul><li>Kälte und Wärme puffern</li><li>Ladevorgänge zeitlich steuern</li><li>Chargenprozesse einplanen</li></ul>
      </article>
      <article class="card">
        <span class="n">C — RISIKO</span>
        <svg class="ic" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M16 4 3 27h26L16 4Z"/><path d="M16 13v7M16 23v.5"/></svg>
        <h3>Preisrisiko bewusst tragen</h3>
        <p>Der dynamische Tarif gibt Marktbewegungen ungefiltert weiter, nach oben wie nach unten. Sinnvoll ist oft eine Aufteilung, bei der ein Teil der Menge fix abgesichert bleibt.</p>
        <ul><li>Teilmengen absichern</li><li>Preisobergrenze vereinbaren</li><li>Monatliches Monitoring</li></ul>
      </article>
    </div>
  </div>
</section>

<section class="sec" id="faq">
  <div class="wrap">
    <div class="sec-head"><div><span class="kicker">Häufige Fragen</span><h2>Fragen zum dynamischen Tarif.</h2></div></div>
    <div class="faq">
      <details class="qa" open><summary>Kann ich mit Photovoltaik zusätzlich profitieren?</summary><p>Ja, in beide Richtungen. Der Eigenverbrauch ersetzt teuren Netzbezug in den Abendstunden, und der Überschuss wird in der Direktvermarktung zum jeweiligen Marktpreis verkauft. Mittags fallen beide Effekte zusammen, weil dann die Preise am niedrigsten sind.</p></details>
      <details class="qa"><summary>Wie stark schwanken die Preise wirklich?</summary><p>An einem durchschnittlichen Tag liegt zwischen der günstigsten und der teuersten Stunde ein Faktor von drei bis fünf. An sonnigen Frühlingstagen kann der Mittagspreis auf null oder darunter fallen, während die Abendstunde ein Vielfaches kostet.</p></details>
      <details class="qa"><summary>Was passiert bei negativen Preisen?</summary><p>Dann wird der Bezug in dieser Stunde rechnerisch vergütet. Für Betriebe mit steuerbaren Lasten ist das der interessanteste Fall überhaupt, weil sich Kälte- oder Wärmespeicher in diesen Stunden gezielt füllen lassen.</p></details>
      <details class="qa"><summary>Muss ich den ganzen Verbrauch dynamisch beziehen?</summary><p>Nein. Üblich ist eine Aufteilung, bei der die Grundlast fix abgesichert wird und nur der verschiebbare Anteil dem Markt folgt. Damit bleibt das Risiko begrenzt und der Hebel dort, wo er wirkt.</p></details>
    </div>
  </div>
</section>

<script>
(function(){
"use strict";
var $=function(i){return document.getElementById(i);},
de=function(n,d){d=d||0;return Number(n).toLocaleString("de-AT",{minimumFractionDigits:d,maximumFractionDigits:d});};
var SHAPE=[78,72,68,66,70,85,112,138,145,120,95,72,58,52,60,78,105,142,168,152,128,108,95,85];
var mean0=SHAPE.reduce(function(a,b){return a+b;},0)/24;
var ADD=.015,NET=.12,DAYS=250;
var placed={};

function prices(){var lvl=+$("lvl").value;return SHAPE.map(function(v){return v/mean0*lvl/1000;});}

function render(){
 var p=prices(),base=+$("base").value,sh=+$("shift").value,nb=+$("blocks").value,fix=+$("fix").value/100;
 var keys=Object.keys(placed).filter(function(k){return placed[k];});
 while(keys.length>nb){delete placed[keys.pop()];}
 var set=keys.length,i;
 var avg=p.reduce(function(a,b){return a+b;},0)/24;
 var eBase=base*24,eShift=sh*set,eTot=eBase+eShift;
 var cDyn=0;
 for(i=0;i<24;i++){cDyn+=base*(p[i]+ADD+NET);if(placed[i])cDyn+=sh*(p[i]+ADD+NET);}
 var cFix=eTot*(fix+NET);
 var eff=eTot>0?(cDyn/eTot-NET):0;
 var diff=cFix-cDyn;
 var mn=Math.min.apply(null,p),mx=Math.max.apply(null,p);

 $("v-base").innerHTML=de(base)+'<span class="unit">kW</span>';
 $("v-shift").innerHTML=de(sh)+'<span class="unit">kW</span>';
 $("v-blocks").innerHTML=de(nb)+'<span class="unit">×1h</span>';
 $("v-lvl").innerHTML=de(+$("lvl").value)+'<span class="unit">€/MWh</span>';
 $("v-fix").innerHTML=de(fix*100,1)+'<span class="unit">ct/kWh</span>';
 $("stamp").textContent=set+" von "+nb+" Blöcken gesetzt";

 $("o-avg").innerHTML=de(avg*100,1)+'<span class="unit">ct/kWh</span>';
 $("o-rng").textContent=de(mn*100,1)+" bis "+de(mx*100,1)+" ct";
 $("o-eff").innerHTML=de(eff*100,1)+'<span class="unit">ct/kWh</span>';
 $("o-dyn").innerHTML=de(cDyn)+'<span class="unit">€</span>';
 $("o-fixc").innerHTML=de(cFix)+'<span class="unit">€</span>';
 $("o-diff").innerHTML=(diff>=0?"+":"−")+de(Math.abs(diff))+'<span class="unit">€</span>';
 $("o-diff").parentNode.className="stat "+(diff>=0?"v":"r");
 $("o-diff2").textContent=diff>=0?"günstiger als fix":"teurer als fix";
 $("o-year").innerHTML=(diff>=0?"+":"−")+de(Math.abs(diff*DAYS))+'<span class="unit">€/a</span>';
 $("o-year").parentNode.className="stat "+(diff>=0?"v":"r");

 var W=760,H=260,L=52,R=14,T=18,B=40,pw=W-L-R,ph=H-T-B,cw=pw/24;
 var pmx=mx*1.25||1,y=function(v){return T+ph*(1-v/pmx);},s="",gv,gy;
 for(i=0;i<=3;i++){gv=pmx*i/3;gy=y(gv);
  s+='<line x1="'+L+'" y1="'+gy.toFixed(1)+'" x2="'+(W-R)+'" y2="'+gy.toFixed(1)+'" stroke="rgba(150,180,220,.11)"/>';
  s+='<text x="'+(L-7)+'" y="'+(gy+3.5).toFixed(1)+'" text-anchor="end" fill="#617595" font-family="JetBrains Mono, monospace" font-size="9.5">'+de(gv*100,1)+'</text>';}
 for(i=0;i<24;i++){
  var nrm=(p[i]-mn)/((mx-mn)||1),op=(.22+.78*nrm).toFixed(2);
  var bh=ph-(y(p[i])-T);
  s+='<rect class="hb" data-h="'+i+'" x="'+(L+i*cw+2).toFixed(1)+'" y="'+T+'" width="'+(cw-4).toFixed(1)+'" height="'+ph.toFixed(1)+'" fill="transparent" style="cursor:pointer"><title>'+i+':00 — '+de(p[i]*100,1)+' ct/kWh, klicken zum Setzen</title></rect>';
  s+='<rect x="'+(L+i*cw+2).toFixed(1)+'" y="'+y(p[i]).toFixed(1)+'" width="'+(cw-4).toFixed(1)+'" height="'+bh.toFixed(1)+'" fill="#FFB43D" opacity="'+op+'" pointer-events="none"/>';
  if(placed[i]){
   s+='<rect x="'+(L+i*cw+2).toFixed(1)+'" y="'+(y(p[i])-13).toFixed(1)+'" width="'+(cw-4).toFixed(1)+'" height="11" fill="#8CE04B" pointer-events="none"/>';
   s+='<rect x="'+(L+i*cw+2).toFixed(1)+'" y="'+y(p[i]).toFixed(1)+'" width="'+(cw-4).toFixed(1)+'" height="'+bh.toFixed(1)+'" fill="none" stroke="#8CE04B" stroke-width="1.5" pointer-events="none"/>';
  }
 }
 s+='<line x1="'+L+'" y1="'+y(avg).toFixed(1)+'" x2="'+(W-R)+'" y2="'+y(avg).toFixed(1)+'" stroke="#45E0FF" stroke-width="1.5" stroke-dasharray="5 5" pointer-events="none"/>';
 s+='<text x="'+(W-R)+'" y="'+(y(avg)-6).toFixed(1)+'" text-anchor="end" fill="#45E0FF" font-family="JetBrains Mono, monospace" font-size="10" pointer-events="none">Mittel '+de(avg*100,1)+' ct</text>';
 for(i=0;i<24;i+=3)s+='<text x="'+(L+i*cw+cw/2).toFixed(1)+'" y="'+(H-18)+'" text-anchor="middle" fill="#617595" font-family="JetBrains Mono, monospace" font-size="9.5" pointer-events="none">'+i+'</text>';
 s+='<text x="'+(W-R)+'" y="'+(H-18)+'" text-anchor="end" fill="#617595" font-family="JetBrains Mono, monospace" font-size="9.5" pointer-events="none">Stunde</text>';
 s+='<text x="'+(L-7)+'" y="'+(T-4)+'" text-anchor="end" fill="#617595" font-family="JetBrains Mono, monospace" font-size="9" pointer-events="none">ct</text>';
 $("ch").innerHTML=s;
 Array.prototype.forEach.call(document.querySelectorAll("#ch .hb"),function(r){
   r.addEventListener("click",function(){
     var h=+this.dataset.h,n=+$("blocks").value;
     if(placed[h]){delete placed[h];}
     else{var c=Object.keys(placed).filter(function(k){return placed[k];}).length;
          if(c>=n){var first=Object.keys(placed)[0];delete placed[first];}
          placed[h]=true;}
     render();
   });
 });
}
["base","shift","blocks","lvl","fix"].forEach(function(i){$(i).addEventListener("input",render);});
$("opt").addEventListener("click",function(){
 var p=prices(),n=+$("blocks").value,idx=p.map(function(v,i){return [v,i];});
 idx.sort(function(a,b){return a[0]-b[0];});
 placed={};for(var i=0;i<n;i++)placed[idx[i][1]]=true;
 this.setAttribute("aria-pressed","true");$("clr").setAttribute("aria-pressed","false");render();
});
$("clr").addEventListener("click",function(){placed={};this.setAttribute("aria-pressed","true");$("opt").setAttribute("aria-pressed","false");render();});
render();
})();
</script>
