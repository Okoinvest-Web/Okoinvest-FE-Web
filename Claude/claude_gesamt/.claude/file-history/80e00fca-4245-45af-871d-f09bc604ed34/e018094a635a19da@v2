      <span class="mark"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M13.5 2 4 13.5h6L9.5 22 20 10.5h-6.5L13.5 2Z" fill="#06170A"/></svg></span>
      <span><b>ÖKOVOLT</b><small>Solartechnik</small></span>
