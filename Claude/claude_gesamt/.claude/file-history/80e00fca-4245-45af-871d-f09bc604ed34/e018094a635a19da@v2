<title>ÖKOVOLT Themenwelt</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,400..800&family=JetBrains+Mono:wght@400;500&family=Sora:wght@300;400;600&display=swap">
<style>
:root{
  --void:#04070E; --deep:#070D18;
  --line:rgba(150,180,220,.13); --line-2:rgba(150,180,220,.26); --line-3:rgba(150,180,220,.42);
  --ink:#EDF4FF; --ink-2:#9FB4CE; --muted:#617595;
  --volt:#8CE04B; --volt-dim:#5C9E2C; --volt-glow:rgba(140,224,75,.30);
  --solar:#FFB43D; --cyan:#45E0FF;
  --f-d:"Archivo","Arial Narrow",system-ui,sans-serif;
  --f-b:"Sora","Segoe UI",system-ui,sans-serif;
  --f-m:"JetBrains Mono",ui-monospace,monospace;
  --pad:clamp(18px,4.5vw,58px);
}
*,*::before,*::after{box-sizing:border-box}
body{background:var(--void);color:var(--ink);font-family:var(--f-b);font-weight:300;font-size:16.5px;line-height:1.62;-webkit-font-smoothing:antialiased;overflow-x:hidden}
h1,h2,h3{font-family:var(--f-d);font-weight:700;font-variation-settings:"wdth" 116;letter-spacing:-.025em;line-height:1.05;text-wrap:balance;margin:0}
p{margin:0}
a{color:inherit}
:focus-visible{outline:2px solid var(--volt);outline-offset:3px}
.wrap{max-width:1300px;margin:0 auto;padding-inline:var(--pad)}
.kicker{font-family:var(--f-m);font-size:11px;letter-spacing:.24em;text-transform:uppercase;color:var(--volt);display:inline-flex;align-items:center;gap:11px}
.kicker::before{content:"";width:26px;height:1px;background:var(--volt);box-shadow:0 0 10px var(--volt-glow)}
.top{position:sticky;top:0;z-index:60;background:rgba(4,7,14,.82);backdrop-filter:blur(16px);border-bottom:1px solid var(--line)}
.top-in{display:flex;align-items:center;gap:20px;height:66px}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none}
.mark{--c:9px;width:32px;height:32px;display:grid;place-items:center;background:linear-gradient(150deg,var(--volt),var(--volt-dim));box-shadow:0 0 24px -4px var(--volt-glow);clip-path:polygon(var(--c) 0,100% 0,100% calc(100% - var(--c)),calc(100% - var(--c)) 100%,0 100%,0 var(--c))}
.mark svg{width:16px;height:16px}
.brand b{font-family:var(--f-d);font-weight:800;font-variation-settings:"wdth" 120;font-size:18px;letter-spacing:.04em;display:block;line-height:1}
.brand small{font-family:var(--f-m);font-size:8px;letter-spacing:.3em;color:var(--muted);text-transform:uppercase;display:block;margin-top:3px}
.tel{margin-left:auto;font-family:var(--f-m);font-size:12px;color:var(--ink-2);text-decoration:none}
.tel:hover{color:var(--volt)}
.hero{position:relative;border-bottom:1px solid var(--line);overflow:hidden;isolation:isolate}
.hero::before{content:"";position:absolute;inset:0;z-index:-2;opacity:.5;
 background-image:linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px);background-size:58px 58px;
 -webkit-mask-image:radial-gradient(72% 76% at 50% 26%,#000,transparent 76%);mask-image:radial-gradient(72% 76% at 50% 26%,#000,transparent 76%)}
.hero::after{content:"";position:absolute;inset:0;z-index:-1;background:radial-gradient(90% 70% at 84% 0%,rgba(69,224,255,.11),transparent 60%),radial-gradient(80% 80% at 8% 100%,rgba(140,224,75,.12),transparent 62%)}
.hero-in{padding-block:clamp(46px,7vw,92px) clamp(32px,4vw,54px);max-width:860px}
h1{font-size:clamp(34px,5.4vw,70px);font-weight:800;font-variation-settings:"wdth" 122;letter-spacing:-.04em;line-height:.98;margin-block:20px 22px}
h1 .gl{background:linear-gradient(96deg,var(--volt) 8%,var(--solar) 94%);-webkit-background-clip:text;background-clip:text;color:transparent}
.lede{font-size:clamp(16.5px,1.4vw,19.5px);color:var(--ink-2);max-width:62ch}
.grp{border-bottom:1px solid var(--line);padding-block:clamp(40px,5.5vw,72px)}
.grp-h{display:flex;align-items:baseline;justify-content:space-between;gap:20px;flex-wrap:wrap;margin-bottom:26px}
.grp-h h2{font-size:clamp(22px,2.6vw,32px)}
.grp-h span{font-family:var(--f-m);font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--muted)}
.tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px}
.tile{--c:16px;position:relative;display:flex;flex-direction:column;gap:13px;padding:24px 22px 26px;text-decoration:none;border:1px solid var(--line);
 background:linear-gradient(165deg,rgba(18,30,51,.72),rgba(8,14,26,.88));transition:border-color .25s,transform .25s,box-shadow .25s;
 clip-path:polygon(var(--c) 0,100% 0,100% calc(100% - var(--c)),calc(100% - var(--c)) 100%,0 100%,0 var(--c))}
.tile:hover{border-color:var(--line-3);transform:translateY(-4px);box-shadow:0 26px 50px -34px #000}
.tile .n{font-family:var(--f-m);font-size:10px;letter-spacing:.2em;color:var(--muted)}
.tile svg.ic{width:34px;height:34px;color:var(--volt)}
.tile.s svg.ic{color:var(--solar)}.tile.c svg.ic{color:var(--cyan)}
.tile h3{font-size:20px}
.tile p{font-size:14.5px;color:var(--ink-2)}
.tile .tool{margin-top:auto;padding-top:15px;border-top:1px solid var(--line);font-family:var(--f-m);font-size:11.5px;color:var(--volt);display:flex;align-items:center;gap:9px}
.tile.s .tool{color:var(--solar)}.tile.c .tool{color:var(--cyan)}
.tile .tool::after{content:"→";margin-left:auto;transition:transform .2s}
.tile:hover .tool::after{transform:translateX(4px)}
.tile.lead{grid-column:1/-1;background:linear-gradient(120deg,rgba(20,44,30,.75),rgba(8,14,26,.9));border-color:rgba(140,224,75,.28)}
@media(min-width:860px){.tile.lead{display:grid;grid-template-columns:1fr auto;align-items:center;gap:28px}.tile.lead .tool{border-top:0;padding-top:0;margin:0}}
.tile.lead h3{font-size:clamp(22px,2.4vw,30px)}
footer{padding-block:44px 26px}
.fb{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font-family:var(--f-m);font-size:11px;color:var(--muted)}
.dis{max-width:1300px;margin:0 auto;padding:18px var(--pad) 0;font-family:var(--f-m);font-size:10.5px;line-height:1.8;color:var(--muted)}
@media (prefers-reduced-motion:reduce){*{transition-duration:.001ms !important}}
</style>

