"use client";

import { useActionState } from "react";

import { Meldung } from "@/components/ui";

import {
  gibFahrplanFrei,
  rechneFahrplanNeu,
  verwerfeFahrplan,
  type HandelErgebnis,
} from "./aktionen";

/**
 * Die Handgriffe an einem Fahrplan.
 *
 * Bewusst nur drei: freigeben, verwerfen, neu rechnen. Ein
 * Fahrplaneditor, in dem sich einzelne Viertelstunden von Hand
 * verschieben lassen, klingt mächtig - im Betrieb erzeugt er
 * Fahrpläne, die niemand mehr nachrechnen kann und für die im
 * Streitfall niemand geradesteht.
 */
export function FahrplanSteuerung({
  planId,
  speicherId,
  tag,
  status,
  darfFreigeben,
}: {
  planId: string;
  speicherId: string;
  tag: string;
  status: string;
  darfFreigeben: boolean;
}) {
  const [frei, freiAktion, freiLaeuft] = useActionState<
    HandelErgebnis | null,
    FormData
  >(gibFahrplanFrei, null);

  const [verworfen, verwerfAktion, verwerfLaeuft] = useActionState<
    HandelErgebnis | null,
    FormData
  >(verwerfeFahrplan, null);

  const [gerechnet, rechneAktion, rechneLaeuft] = useActionState<
    HandelErgebnis | null,
    FormData
  >(rechneFahrplanNeu, null);

  const rueckmeldung = frei ?? verworfen ?? gerechnet;
  const laeuft = freiLaeuft || verwerfLaeuft || rechneLaeuft;

  if (!darfFreigeben) {
    return (
      <p className="t-mikro">
        Ihre Rolle erlaubt das Ansehen der Fahrpläne, nicht die Freigabe.
      </p>
    );
  }

  return (
    <div className="space-y-3">
      <div className="flex flex-wrap gap-2">
        {status === "Entwurf" && (
          <form action={freiAktion}>
            <input type="hidden" name="plan" value={planId} />
            <button
              type="submit"
              disabled={laeuft}
              className="knopf knopf-voll"
            >
              {freiLaeuft ? "Wird freigegeben …" : "Fahrplan freigeben"}
            </button>
          </form>
        )}

        {(status === "Entwurf" || status === "Freigegeben") && (
          <form action={verwerfAktion}>
            <input type="hidden" name="plan" value={planId} />
            <button
              type="submit"
              disabled={laeuft}
              className="knopf knopf-leise"
            >
              {verwerfLaeuft ? "Wird verworfen …" : "Verwerfen"}
            </button>
          </form>
        )}

        {status === "Entwurf" && (
          <form action={rechneAktion}>
            <input type="hidden" name="speicher" value={speicherId} />
            <input type="hidden" name="tag" value={tag} />
            <button
              type="submit"
              disabled={laeuft}
              className="knopf knopf-rand"
            >
              {rechneLaeuft ? "Wird gerechnet …" : "Neu rechnen"}
            </button>
          </form>
        )}

        {status === "Gefahren" && (
          <p className="t-mikro">
            Dieser Fahrplan ist gefahren und Teil des Betriebsprotokolls. Er
            wird nicht mehr verändert.
          </p>
        )}

        {status === "Verworfen" && (
          <p className="t-mikro">
            Verworfen. Der Speicher fuhr an diesem Tag die Grundeinstellung
            aus der Steuerung.
          </p>
        )}
      </div>

      {rueckmeldung && (
        <Meldung ton={rueckmeldung.ok ? "gut" : "kritisch"}>
          {rueckmeldung.meldung}
        </Meldung>
      )}
    </div>
  );
}
