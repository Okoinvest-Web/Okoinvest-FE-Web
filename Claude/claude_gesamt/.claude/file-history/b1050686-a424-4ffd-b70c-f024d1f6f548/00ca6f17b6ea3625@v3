}

export function ladeBetriebskosten(anlageId: string) {
  return alle<{ id: string; art: string; betrag_jahr: number; bemerkung: string | null }>(
    "SELECT id, art, betrag_jahr, bemerkung FROM betriebskosten WHERE anlage_id = ?",
    anlageId,
  );
}

/* ------------------------------------------------------------------ */
/* Strangverlauf für eine Strangmeldung                                */
/* ------------------------------------------------------------------ */

export interface StrangVerlaufsPunkt {
  zeitpunkt: string;
  /** Spezifischer Strom des betroffenen Strangs, A je kWp. */
  betroffen: number;
  /** Median der übrigen Stränge am selben Gerät, A je kWp. */
  vergleich: number;
}

/**
 * Tagesverlauf eines Strangs gegen seine Nachbarn am selben Gerät.
 *
 * Bei einer Strangmeldung ist der Verlauf der ganzen Anlage
 * unbrauchbar: Ein Strang trägt bei einem großen Dach unter zwei
 * Prozent zur Gesamtleistung bei - ein Verlust von zwanzig Prozent an
 * ihm bleibt in der Summenkurve unter dem Rauschen. Aussagekräftig ist
 * nur der Vergleich mit den Strängen daneben, die dieselbe
 * Einstrahlung, dieselbe Ausrichtung und dasselbe Gerät haben.
 *
 * Verglichen wird der auf die Strangleistung bezogene Strom, weil
 * Stränge unterschiedlich viele Module tragen können.
 */
export function ladeStrangTagesverlauf(
  strangId: string,
  tag: Date,
): StrangVerlaufsPunkt[] {
  const beginn = new Date(tag);
  beginn.setHours(0, 0, 0, 0);
  const ende = verschiebeTage(beginn, 1);

  const zeilen = alle<{
    zeitpunkt: string;
    strang_id: string;
    strom_a: number;
    leistung_kwp: number;
  }>(
    `SELECT m.zeitpunkt, m.strang_id, m.strom_a, s.leistung_kwp
       FROM strang_messwert m
       JOIN strang s ON s.id = m.strang_id
      WHERE s.wechselrichter_id = (SELECT wechselrichter_id
                                     FROM strang WHERE id = ?)
        AND m.zeitpunkt >= ? AND m.zeitpunkt < ?
      ORDER BY m.zeitpunkt`,
    strangId,
    messStempel(beginn),
    messStempel(ende),
  );

  const jeZeitpunkt = new Map<
    string,
    { betroffen: number | null; uebrige: number[] }
  >();

  for (const z of zeilen) {
    const eintrag = jeZeitpunkt.get(z.zeitpunkt) ?? {
      betroffen: null,
      uebrige: [],
    };
    const spezifisch = z.leistung_kwp > 0 ? z.strom_a / z.leistung_kwp : 0;

    if (z.strang_id === strangId) {
      eintrag.betroffen = spezifisch;
    } else {
      eintrag.uebrige.push(spezifisch);
    }
    jeZeitpunkt.set(z.zeitpunkt, eintrag);
  }

  return [...jeZeitpunkt.entries()].map(([zeitpunkt, e]) => ({
    zeitpunkt,
    betroffen: Number((e.betroffen ?? 0).toFixed(3)),
    vergleich: Number(medianVon(e.uebrige).toFixed(3)),
  }));
}

/* ------------------------------------------------------------------ */
/* Portfolio: alle Anlagen nebeneinander                               */
/* ------------------------------------------------------------------ */

export interface PortfolioZeile extends AnlagenStamm {
  /** Erster Zählpunkt der Anlage, für die Netzsicht. */
  zaehlpunkt: string | null;
  netzebene: number | null;
  anzahlWechselrichter: number;
  kennzahlen: AnlagenKennzahlen;
  /** Tagesertrag der letzten Tage, kWh - für den Verlaufsstrich. */
  tagesreihe: number[];
  /**
   * Anteil am anteiligen Jahresziel, 1 = Ziel erreicht.
   *
   * `null`, wenn für die Anlage kein Sollertrag hinterlegt ist. Ohne
   * Sollwert lässt sich nicht sagen, ob ein Ertrag gut ist - dieselbe
   * Anlage liefert im Juni das Dreifache des Dezembers.
   */
  zielerreichung: number | null;
}

/**
 * Kennzahlen aller Anlagen für die Portfolioansicht.
 *
 * Verglichen werden Anlagen über den spezifischen Ertrag und die
 * Performance Ratio, nie über die absolute Erzeugung: Die größte
 * Anlage liefert immer am meisten, auch wenn sie am schlechtesten
 * läuft. Erst der Bezug auf die installierte Leistung macht ein
 * Carport mit 186 kWp und eine Halle mit 1,2 MWp vergleichbar.
 */
export function ladePortfolio(fenster: Zeitfenster): PortfolioZeile[] {
  const anlagen = ladeAnlagen();

  // Tageserträge für alle Anlagen in einem Zug.
  //
  // Die Messstempel stehen in UTC. Für eine Tagessumme ist das in
  // Österreich unkritisch: Die Verschiebung beträgt höchstens zwei
  // Stunden und fällt in die Nacht, in der ohnehin nichts erzeugt wird.
  const tage = alle<{ anlage_id: string; tag: string; kwh: number }>(
    `SELECT wr.anlage_id,
            substr(m.zeitpunkt, 1, 10)   AS tag,
            SUM(m.leistung_kw) * 0.25    AS kwh
       FROM wr_messwert m
       JOIN wechselrichter wr ON wr.id = m.wechselrichter_id
      WHERE m.zeitpunkt >= ? AND m.zeitpunkt < ?
      GROUP BY wr.anlage_id, tag
      ORDER BY tag`,
    fenster.von,
    fenster.bis,
  );

  const reihen = new Map<string, number[]>();
  for (const t of tage) {
    const liste = reihen.get(t.anlage_id) ?? [];
    liste.push(Number(t.kwh.toFixed(1)));
    reihen.set(t.anlage_id, liste);
  }

  const netz = alle<{
    anlage_id: string;
    bezeichnung: string;
    netzebene: number | null;
  }>(
    `SELECT anlage_id, bezeichnung, netzebene
       FROM zaehlpunkt
      WHERE anlage_id IS NOT NULL AND art IN ('Erzeugung', 'Kombiniert')
      ORDER BY bezeichnung`,
  );

  const geraete = alle<{ anlage_id: string; anzahl: number }>(
    `SELECT anlage_id, COUNT(*) AS anzahl FROM wechselrichter
      GROUP BY anlage_id`,
  );
  const geraeteJeAnlage = new Map(geraete.map((g) => [g.anlage_id, g.anzahl]));

  return anlagen.map((anlage) => {
    const kennzahlen = ladeKennzahlen(anlage.id, fenster, anlage.leistung_kwp);
    const zp = netz.find((n) => n.anlage_id === anlage.id);

    // Jahresziel über das Ertragsprofil auf den Zeitraum verteilen,
    // nicht gleichmäßig über die Tage: Ein Julitag trägt rund das
    // Sechsfache eines Dezembertags bei.
    const anteiligesZiel = anteiligerSollwert(
      anlage.soll_ertrag_kwh,
      fenster.vonTag,
      fenster.bisTag,
    );

    return {
      ...anlage,
      zaehlpunkt: zp?.bezeichnung ?? null,
      netzebene: zp?.netzebene ?? null,
      anzahlWechselrichter: geraeteJeAnlage.get(anlage.id) ?? 0,
      kennzahlen,
      tagesreihe: reihen.get(anlage.id) ?? [],
      zielerreichung:
        anteiligesZiel && anteiligesZiel > 0
          ? Number((kennzahlen.ertragKwh / anteiligesZiel).toFixed(3))
          : null,
    };
  });
}
