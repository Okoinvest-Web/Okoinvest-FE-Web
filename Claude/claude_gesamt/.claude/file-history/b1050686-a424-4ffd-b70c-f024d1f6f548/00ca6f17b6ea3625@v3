export interface AlarmZeile {
  id: string;
  anlage_id: string;
  wechselrichter_id: string | null;
  strang_id: string | null;
  anlage: string;
  wechselrichter: string | null;
  strang: string | null;
  art: string;
  schweregrad: string;
  titel: string;
  beschreibung: string | null;
  ist_wert: number | null;
  soll_wert: number | null;
  status: string;
  ausfall_kwh: number;
  ausfall_eur: number;
  ausgeloest_am: string;
  beendet_am: string | null;
  quittiert_am: string | null;
  quittiert_von: string | null;
  notiz: string | null;
  regel: string | null;
  /**
   * Dauer in Stunden, in der Datenbank berechnet.
   * Nicht beim Rendern: Ein Renderdurchlauf muss bei gleichen Eingaben
   * dasselbe Ergebnis liefern, `Date.now()` tut das nicht.
   */
  dauer_stunden: number;
}

export function ladeAlarme(filter?: {
  anlageId?: string;
  nurOffene?: boolean;
  grenze?: number;
}): AlarmZeile[] {
  const bedingungen: string[] = [];
  const werte: (string | number)[] = [];

  if (filter?.anlageId) {
    bedingungen.push("a.anlage_id = ?");
    werte.push(filter.anlageId);
  }
  if (filter?.nurOffene) {
    bedingungen.push("a.status IN ('Offen','Quittiert')");
  }

  const wo = bedingungen.length ? `WHERE ${bedingungen.join(" AND ")}` : "";

  return alle<AlarmZeile>(
    `SELECT a.*, anl.bezeichnung AS anlage,
            -- Siehe ladeAlarm: Geraet notfalls ueber den Strang.
            COALESCE(wr.bezeichnung, wrs.bezeichnung) AS wechselrichter,
            s.bezeichnung  AS strang,
            r.bezeichnung  AS regel,
            ROUND((julianday(COALESCE(a.beendet_am, 'now')) -
                   julianday(a.ausgeloest_am)) * 24, 2) AS dauer_stunden
       FROM alarm a
       JOIN anlage anl ON anl.id = a.anlage_id
       LEFT JOIN wechselrichter wr ON wr.id = a.wechselrichter_id
       LEFT JOIN strang s          ON s.id = a.strang_id
       LEFT JOIN wechselrichter wrs ON wrs.id = s.wechselrichter_id
       LEFT JOIN alarmregel r      ON r.id = a.regel_id
       ${wo}
      ORDER BY
        CASE a.status WHEN 'Offen' THEN 0 WHEN 'Quittiert' THEN 1 ELSE 2 END,
        CASE a.schweregrad
          WHEN 'Kritisch' THEN 0 WHEN 'Hoch' THEN 1 WHEN 'Mittel' THEN 2
          WHEN 'Niedrig' THEN 3 ELSE 4 END,
        a.ausgeloest_am DESC
      LIMIT ?`,
    ...werte,
    filter?.grenze ?? 100,
  );
}

export function ladeAlarm(id: string): AlarmZeile | null {
  return (
    alle<AlarmZeile>(
      `SELECT a.*, anl.bezeichnung AS anlage,
              -- Ein Strang haengt immer an einem Geraet. Traegt die
              -- Meldung selbst keines, wird es ueber den Strang
              -- bestimmt - sonst steht auf der Seite "an demselben
              -- Geraet", ohne dass dort je eines genannt wurde.
              COALESCE(wr.bezeichnung, wrs.bezeichnung) AS wechselrichter,
              s.bezeichnung  AS strang,
              r.bezeichnung  AS regel,
              ROUND((julianday(COALESCE(a.beendet_am, 'now')) -
                     julianday(a.ausgeloest_am)) * 24, 2) AS dauer_stunden
         FROM alarm a
         JOIN anlage anl ON anl.id = a.anlage_id
         LEFT JOIN wechselrichter wr ON wr.id = a.wechselrichter_id
         LEFT JOIN strang s          ON s.id = a.strang_id
         LEFT JOIN wechselrichter wrs ON wrs.id = s.wechselrichter_id
         LEFT JOIN alarmregel r      ON r.id = a.regel_id
        WHERE a.id = ?`,
      id,
    )[0] ?? null
  );
}

export interface AlarmRegelZeile {
  id: string;
  bezeichnung: string;
  art: string;
  schweregrad: string;
  schwellwert: number | null;
  dauer_minuten: number;
  nur_tagsueber: number;
  min_einstrahlung: number | null;
  aktiv: number;
  beschreibung: string | null;
  /** Wie oft diese Regel bereits ausgelöst hat. */
  ausloesungen: number;
}

export function ladeAlarmregeln(): AlarmRegelZeile[] {
  return alle<AlarmRegelZeile>(
    `SELECT r.*,
            (SELECT COUNT(*) FROM alarm a WHERE a.regel_id = r.id) AS ausloesungen
       FROM alarmregel r
      ORDER BY
        CASE r.schweregrad
          WHEN 'Kritisch' THEN 0 WHEN 'Hoch' THEN 1 WHEN 'Mittel' THEN 2
          WHEN 'Niedrig' THEN 3 ELSE 4 END`,
  );
}

