import Link from "next/link";
import { notFound } from "next/navigation";

import { Badge, Card, Fehlerhinweis, Kennzahl, LeerZustand } from "@/components/ui";
import { Tabelle, Zelle } from "@/components/tabelle";
import { DOCTYPE, type PvAnlage, getDoc } from "@/lib/doctypes";
import { FrappeError } from "@/lib/frappe";
import { fehlerText } from "@/lib/fehler";
import { formatDatum, formatEnergie, formatZahl } from "@/lib/format";
import { ladeErtraege } from "@/lib/portal-daten";
import { statusFarbe } from "../page";

export default async function AnlagenDetail({
  params,
}: {
  params: Promise<{ name: string }>;
}) {
  const { name } = await params;
  const id = decodeURIComponent(name);

  let anlage: PvAnlage;
  let ertraege;

  try {
    [anlage, ertraege] = await Promise.all([
      getDoc<PvAnlage>(DOCTYPE.anlage, id),
      ladeErtraege(id),
    ]);
  } catch (error) {
    // Frappe meldet sowohl "gibt es nicht" als auch "darfst du nicht sehen"
    // als 404 - in beiden Faellen ist die 404-Seite die richtige Antwort.
    if (error instanceof FrappeError && error.status === 404) notFound();
    return <Fehlerhinweis meldung={fehlerText(error, DOCTYPE.anlage)} />;
  }

  const gesamt = ertraege.reduce((summe, e) => summe + (e.ertrag_kwh ?? 0), 0);
  const gesamtEnergie = formatEnergie(gesamt);

  return (
    <div className="space-y-6">
      <div>
        <Link
          href="/portal/anlagen"
          className="text-sm text-slate-500 hover:underline dark:text-slate-400"
        >
          ← Zurück zur Übersicht
        </Link>
        <div className="mt-2 flex flex-wrap items-center gap-3">
          <h1 className="text-2xl font-semibold text-slate-900 dark:text-slate-50">
            {anlage.anlagen_name || anlage.name}
          </h1>
          <Badge farbe={statusFarbe(anlage.status)}>
            {anlage.status ?? "Unbekannt"}
          </Badge>
        </div>
        {anlage.standort && (
          <p className="mt-1 text-slate-500 dark:text-slate-400">
            {anlage.standort}
          </p>
        )}
      </div>

      <div className="grid gap-4 sm:grid-cols-3">
        <Kennzahl
          label="Nennleistung"
          wert={formatZahl(anlage.leistung_kwp)}
          einheit="kWp"
        />
        <Kennzahl
          label="Speicher"
          wert={formatZahl(anlage.speicher_kwh)}
          einheit="kWh"
        />
        <Kennzahl
          label="Ertrag"
          wert={gesamtEnergie.wert}
          einheit={gesamtEnergie.einheit}
          hinweis={`letzte ${ertraege.length} Messwerte`}
        />
      </div>

      <Card title="Stammdaten">
        <dl className="grid gap-x-8 gap-y-3 sm:grid-cols-2">
          {(
            [
              ["Inbetriebnahme", formatDatum(anlage.inbetriebnahme)],
              ["Modultyp", anlage.modul_typ ?? "–"],
              ["Wechselrichter", anlage.wechselrichter_typ ?? "–"],
              ["Anlagen-ID", anlage.name],
            ] as const
          ).map(([label, wert]) => (
            <div key={label} className="flex justify-between gap-4 text-sm">
              <dt className="text-slate-500 dark:text-slate-400">{label}</dt>
              <dd className="text-right font-medium">{wert}</dd>
            </div>
          ))}
        </dl>
      </Card>

      <Card title="Erträge">
        {ertraege.length === 0 ? (
          <LeerZustand text="Für diese Anlage liegen noch keine Ertragsdaten vor." />
        ) : (
          <Tabelle spalten={["Datum", "Ertrag", "Eigenverbrauch", "Einspeisung"]}>
            {ertraege.map((eintrag) => (
              <tr key={eintrag.name}>
                <Zelle zahl>{formatDatum(eintrag.datum)}</Zelle>
                <Zelle zahl>{formatZahl(eintrag.ertrag_kwh)} kWh</Zelle>
                <Zelle zahl>{formatZahl(eintrag.eigenverbrauch_kwh)} kWh</Zelle>
                <Zelle zahl>{formatZahl(eintrag.einspeisung_kwh)} kWh</Zelle>
              </tr>
            ))}
          </Tabelle>
        )}
      </Card>
    </div>
  );
}
