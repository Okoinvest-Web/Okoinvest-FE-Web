import "server-only";

import { alle, eine, skalar } from "../db/verbindung.ts";
import { messStempel, verschiebeTage } from "../datum.ts";

/**
 * Auswertungen der Ladeinfrastruktur.
 *
 * Gerechnet wird in der Datenbank. Ein Betrieb mit fünfzehn
 * Ladepunkten sammelt im Jahr einige tausend Vorgänge; sie in die
 * Anwendung zu laden, um sie dort zu summieren, wäre Verschwendung.
 */

export interface LadeZeitfenster {
  von: string;
  bis: string;
  tage: number;
}

export function letzteTageLaden(tage: number): LadeZeitfenster {
  const heute = new Date();
  heute.setHours(23, 59, 59, 999);
  const start = verschiebeTage(heute, -tage + 1);
  start.setHours(0, 0, 0, 0);

  return {
    von: messStempel(start),
    bis: messStempel(new Date(heute.getTime() + 1)),
    tage,
  };
}

/* ------------------------------------------------------------------ */
/* Ladepunkte                                                          */
/* ------------------------------------------------------------------ */

export interface LadepunktZeile {
  id: string;
  anlage_id: string | null;
  anlage: string | null;
  bezeichnung: string;
  evse_id: string | null;
  hersteller: string | null;
  modell: string | null;
  firmware: string | null;
  leistung_kw: number;
  strom_art: string;
  steckertyp: string | null;
  standort: string | null;
  eichrecht: number;
  status: string;
  /** Vorgänge im Zeitfenster. */
  vorgaenge: number;
  energie_kwh: number;
  pv_kwh: number;
  /** Summe der Belegungsstunden im Zeitfenster. */
  belegt_stunden: number;
  /** Summe der reinen Ladestunden im Zeitfenster. */
  ladestunden: number;
}

/**
 * Ladepunkte mit ihrer Nutzung im Zeitraum.
 *
 * Belegungszeit und Ladezeit werden getrennt geführt. Der Unterschied
 * ist die eigentliche Kennzahl der Ladeinfrastruktur: Ein Ladepunkt,
 * der zehn Stunden belegt ist und zwei Stunden lädt, ist nicht
 * ausgelastet, sondern blockiert. Wer nur auf die Belegung schaut,
 * baut den nächsten Ladepunkt, obwohl er keinen braucht.
 */
export function ladeLadepunkte(fenster: LadeZeitfenster): LadepunktZeile[] {
  return alle<LadepunktZeile>(
    `SELECT p.id, p.anlage_id, a.bezeichnung AS anlage, p.bezeichnung,
            p.evse_id, p.hersteller, p.modell, p.firmware, p.leistung_kw,
            p.strom_art, p.steckertyp, p.standort, p.eichrecht, p.status,
            COUNT(v.id)                                    AS vorgaenge,
            ROUND(COALESCE(SUM(v.energie_kwh), 0), 1)      AS energie_kwh,
            ROUND(COALESCE(SUM(v.pv_kwh), 0), 1)          AS pv_kwh,
            ROUND(COALESCE(SUM(
              (julianday(v.ende) - julianday(v.beginn)) * 24), 0), 1)
                                                           AS belegt_stunden,
            ROUND(COALESCE(SUM(
              (julianday(COALESCE(v.ladeende, v.ende)) - julianday(v.beginn)) * 24), 0), 1)
                                                           AS ladestunden
       FROM ladepunkt p
       LEFT JOIN anlage a ON a.id = p.anlage_id
       LEFT JOIN ladevorgang v
              ON v.ladepunkt_id = p.id
             AND v.beginn >= ? AND v.beginn < ?
             AND v.status = 'Beendet'
      GROUP BY p.id
      ORDER BY p.id`,
    fenster.von,
    fenster.bis,
  );
}

/* ------------------------------------------------------------------ */
/* Karten                                                              */
/* ------------------------------------------------------------------ */

export interface LadekarteZeile {
  id: string;
  kennung: string;
  bezeichnung: string;
  inhaber: string | null;
  kennzeichen: string | null;
  fahrzeug: string | null;
  kostenstelle: string;
  art: string;
  aktiv: number;
  sachbezug_ct_kwh: number | null;
  tarif_id: string | null;
  tarif: string | null;
  ct_kwh: number | null;
  vorgaenge: number;
  energie_kwh: number;
  pv_kwh: number;
  /** Letzter Ladevorgang, für die Erkennung stiller Karten. */
  zuletzt: string | null;
  /**
   * Tage seit dem letzten Ladevorgang, in der Datenbank gerechnet.
   *
   * Nicht beim Rendern: Ein Renderdurchlauf muss bei gleichen Eingaben
   * dasselbe Ergebnis liefern, `Date.now()` tut das nicht. `null`
   * heißt: mit dieser Karte wurde noch nie geladen.
   */
  tage_ohne_nutzung: number | null;
}

export function ladeLadekarten(fenster: LadeZeitfenster): LadekarteZeile[] {
  return alle<LadekarteZeile>(
    `SELECT k.id, k.kennung, k.bezeichnung, k.inhaber, k.kennzeichen,
            k.fahrzeug, k.kostenstelle, k.art, k.aktiv, k.sachbezug_ct_kwh,
            k.tarif_id, t.bezeichnung AS tarif, t.ct_kwh,
            COUNT(v.id)                               AS vorgaenge,
            ROUND(COALESCE(SUM(v.energie_kwh), 0), 1) AS energie_kwh,
            ROUND(COALESCE(SUM(v.pv_kwh), 0), 1)      AS pv_kwh,
            (SELECT MAX(beginn) FROM ladevorgang WHERE karte_id = k.id)
                                                      AS zuletzt,
            CAST(julianday('now') -
                 julianday((SELECT MAX(beginn) FROM ladevorgang
                             WHERE karte_id = k.id)) AS INTEGER)
                                                      AS tage_ohne_nutzung
       FROM ladekarte k
       LEFT JOIN ladetarif t ON t.id = k.tarif_id
       LEFT JOIN ladevorgang v
              ON v.karte_id = k.id
             AND v.beginn >= ? AND v.beginn < ?
             AND v.status = 'Beendet'
      GROUP BY k.id
      ORDER BY k.kostenstelle, k.bezeichnung`,
    fenster.von,
    fenster.bis,
  );
}

