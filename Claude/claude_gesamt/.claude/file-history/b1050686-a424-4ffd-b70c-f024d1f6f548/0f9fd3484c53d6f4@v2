/* ------------------------------------------------------------------ */
/* Vorgänge                                                            */
/* ------------------------------------------------------------------ */

export interface VorgangZeile {
  id: string;
  beginn: string;
  ende: string | null;
  ladeende: string | null;
  ladepunkt: string;
  ladepunkt_id: string;
  karte: string | null;
  kostenstelle: string | null;
  fahrzeug: string | null;
  art: string | null;
  energie_kwh: number;
  pv_kwh: number;
  hoechstleistung_kw: number | null;
  status: string;
  abrechnung_id: string | null;
  /** Belegungsdauer in Stunden, in der Datenbank gerechnet. */
  dauer_stunden: number;
  /** Standzeit nach Ladeende in Stunden. */
  standzeit_stunden: number;
}

export function ladeVorgaenge(optionen: {
  fenster?: LadeZeitfenster;
  karteId?: string;
  ladepunktId?: string;
  abrechnungId?: string;
  grenze?: number;
}): VorgangZeile[] {
  const bedingungen: string[] = [];
  const werte: (string | number)[] = [];

  if (optionen.fenster) {
    bedingungen.push("v.beginn >= ? AND v.beginn < ?");
    werte.push(optionen.fenster.von, optionen.fenster.bis);
  }
  if (optionen.karteId) {
    bedingungen.push("v.karte_id = ?");
    werte.push(optionen.karteId);
  }
  if (optionen.ladepunktId) {
    bedingungen.push("v.ladepunkt_id = ?");
    werte.push(optionen.ladepunktId);
  }
  if (optionen.abrechnungId) {
    bedingungen.push("v.abrechnung_id = ?");
    werte.push(optionen.abrechnungId);
  }

  const wo = bedingungen.length ? `WHERE ${bedingungen.join(" AND ")}` : "";
  werte.push(optionen.grenze ?? 100);

  return alle<VorgangZeile>(
    `SELECT v.id, v.beginn, v.ende, v.ladeende, v.ladepunkt_id,
            p.bezeichnung AS ladepunkt,
            k.bezeichnung AS karte, k.kostenstelle, k.fahrzeug, k.art,
            v.energie_kwh, v.pv_kwh, v.hoechstleistung_kw, v.status,
            v.abrechnung_id,
            ROUND((julianday(v.ende) - julianday(v.beginn)) * 24, 2)
              AS dauer_stunden,
            ROUND(MAX(0, (julianday(v.ende) - julianday(v.ladeende)) * 24), 2)
              AS standzeit_stunden
       FROM ladevorgang v
       JOIN ladepunkt p ON p.id = v.ladepunkt_id
       LEFT JOIN ladekarte k ON k.id = v.karte_id
       ${wo}
      ORDER BY v.beginn DESC
      LIMIT ?`,
    ...werte,
  );
}

/* ------------------------------------------------------------------ */
/* Kennzahlen und Verteilungen                                         */
/* ------------------------------------------------------------------ */

export interface LadeKennzahlen {
  vorgaenge: number;
  energieKwh: number;
  pvKwh: number;
  pvAnteil: number;
  /** Summe der Belegungsstunden. */
  belegtStunden: number;
  ladestunden: number;
  /** Anteil der Ladezeit an der Belegungszeit. */
  ladeanteil: number;
  hoechstleistungKw: number;
  aktiveKarten: number;
  ladepunkte: number;
  gestoerteLadepunkte: number;
}

export function ladeKennzahlenLaden(
  fenster: LadeZeitfenster,
): LadeKennzahlen {
  const z = eine<{
    vorgaenge: number;
    energie: number;
    pv: number;
    belegt: number;
    laden: number;
    spitze: number;
    karten: number;
  }>(
    `SELECT COUNT(*)                                   AS vorgaenge,
            COALESCE(SUM(energie_kwh), 0)              AS energie,
            COALESCE(SUM(pv_kwh), 0)                   AS pv,
            COALESCE(SUM((julianday(ende) - julianday(beginn)) * 24), 0)
                                                       AS belegt,
            COALESCE(SUM((julianday(COALESCE(ladeende, ende)) -
                          julianday(beginn)) * 24), 0) AS laden,
            COALESCE(MAX(hoechstleistung_kw), 0)       AS spitze,
            COUNT(DISTINCT karte_id)                   AS karten
       FROM ladevorgang
      WHERE beginn >= ? AND beginn < ? AND status = 'Beendet'`,
    fenster.von,
    fenster.bis,
  );

  const punkte =
    skalar<number>("SELECT COUNT(*) FROM ladepunkt") ?? 0;
  const gestoert =
    skalar<number>(
      "SELECT COUNT(*) FROM ladepunkt WHERE status IN ('Gestoert','Offline')",
    ) ?? 0;

  const energie = z?.energie ?? 0;
  const belegt = z?.belegt ?? 0;
  const laden = z?.laden ?? 0;

  return {
    vorgaenge: z?.vorgaenge ?? 0,
    energieKwh: Number(energie.toFixed(1)),
    pvKwh: Number((z?.pv ?? 0).toFixed(1)),
    pvAnteil: energie > 0 ? (z?.pv ?? 0) / energie : 0,
    belegtStunden: Number(belegt.toFixed(1)),
    ladestunden: Number(laden.toFixed(1)),
    ladeanteil: belegt > 0 ? laden / belegt : 0,
    hoechstleistungKw: Number((z?.spitze ?? 0).toFixed(1)),
    aktiveKarten: z?.karten ?? 0,
    ladepunkte: punkte,
    gestoerteLadepunkte: gestoert,
  };
}

export interface StundenAnteil {
  stunde: number;
  energieKwh: number;
  pvKwh: number;
  vorgaenge: number;
}

/**
 * Verteilung der geladenen Energie über den Tag.
 *
 * Die Energie wird der Stunde des Ladebeginns zugeschlagen. Das ist
 * eine Vereinfachung - ein Vorgang über vier Stunden verteilt sich in
 * Wirklichkeit über vier Stunden -, für die Frage "wann wird
 * angesteckt" ist aber genau der Beginn die richtige Größe. Für ein
 * echtes Lastprofil bräuchte es die Leistungswerte des Ladepunkts.
 */
export function ladeTagesverteilung(
  fenster: LadeZeitfenster,
): StundenAnteil[] {
  // Die Messstempel stehen in UTC; für eine Aussage über den
  // Arbeitstag muss auf Ortszeit umgerechnet werden.
  const zeilen = alle<{
    stunde: number;
    energie: number;
    pv: number;
    anzahl: number;
  }>(
    `SELECT CAST(strftime('%H', beginn, 'localtime') AS INTEGER) AS stunde,
            SUM(energie_kwh) AS energie,
            SUM(pv_kwh)      AS pv,
            COUNT(*)         AS anzahl
       FROM ladevorgang
      WHERE beginn >= ? AND beginn < ? AND status = 'Beendet'
      GROUP BY stunde
      ORDER BY stunde`,
    fenster.von,
    fenster.bis,
  );

  const karte = new Map(zeilen.map((z) => [z.stunde, z]));

  return Array.from({ length: 24 }, (_, stunde) => {
    const z = karte.get(stunde);
    return {
      stunde,
      energieKwh: Number((z?.energie ?? 0).toFixed(1)),
      pvKwh: Number((z?.pv ?? 0).toFixed(1)),
      vorgaenge: z?.anzahl ?? 0,
    };
  });
}

export interface KostenstellenAnteil {
  kostenstelle: string;
  vorgaenge: number;
  energieKwh: number;
  pvKwh: number;
  karten: number;
}

export function ladeKostenstellen(
  fenster: LadeZeitfenster,
): KostenstellenAnteil[] {
  return alle<KostenstellenAnteil>(
    `SELECT k.kostenstelle,
            COUNT(v.id)                               AS vorgaenge,
            ROUND(COALESCE(SUM(v.energie_kwh), 0), 1) AS energieKwh,
            ROUND(COALESCE(SUM(v.pv_kwh), 0), 1)      AS pvKwh,
            COUNT(DISTINCT k.id)                      AS karten
       FROM ladekarte k
       LEFT JOIN ladevorgang v
              ON v.karte_id = k.id
             AND v.beginn >= ? AND v.beginn < ?
             AND v.status = 'Beendet'
      GROUP BY k.kostenstelle
      ORDER BY energieKwh DESC`,
    fenster.von,
    fenster.bis,
  );
}

