  netto: number;
  ust_betrag: number;
  brutto: number;
  angelegt_am: string;
  festgeschrieben_am: string | null;
  belege: number;
}

export function ladeAbrechnungen(grenze = 24): AbrechnungZeile[] {
  return alle<AbrechnungZeile>(
    `SELECT a.*, (SELECT COUNT(*) FROM ladebeleg b WHERE b.abrechnung_id = a.id)
              AS belege
       FROM ladeabrechnung a
      ORDER BY a.zeitraum_von DESC
      LIMIT ?`,
    grenze,
  );
}

export function ladeAbrechnung(id: string): AbrechnungZeile | null {
  return eine<AbrechnungZeile>(
    `SELECT a.*, (SELECT COUNT(*) FROM ladebeleg b WHERE b.abrechnung_id = a.id)
              AS belege
       FROM ladeabrechnung a
      WHERE a.id = ?`,
    id,
  );
}

