/**
 * Belege eines Laufs, nach Kostenstelle geordnet.
 *
 * Sortiert wird in der Anwendung, nicht in der Abfrage: SQLite
 * vergleicht Text zeichenweise, dabei landet "Gaeste" hinter
 * "Geschaeftsfuehrung", weil der Umlaut einen hoeheren Codepunkt hat.
 * Die Belegnummern wurden nach deutscher Sortierung vergeben - weichen
 * beide Ordnungen voneinander ab, springen die Nummern in der Liste.
 */
export function ladeLadebelege(abrechnungId: string): LadebelegZeile[] {
  const zeilen = alle<LadebelegZeile>(
    `SELECT b.*, k.bezeichnung AS karte, k.fahrzeug, k.inhaber,
            t.bezeichnung AS tarif
       FROM ladebeleg b
       LEFT JOIN ladekarte k  ON k.id = b.karte_id
       LEFT JOIN ladetarif t  ON t.id = k.tarif_id
      WHERE b.abrechnung_id = ?`,
    abrechnungId,
  );

  return zeilen.sort(
    (a, b) =>
      a.kostenstelle.localeCompare(b.kostenstelle, "de-AT") ||
      a.nummer.localeCompare(b.nummer, "de-AT"),
  );
}
