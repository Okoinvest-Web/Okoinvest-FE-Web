import assert from "node:assert/strict";
import { describe, it } from "node:test";

import {
  feiertagName,
  feiertage,
  istArbeitsfrei,
  istFeiertag,
  ostersonntag,
} from "./feiertage.ts";

/**
 * An diesen Tagen laufen keine Fristen. Ein falscher Feiertag
 * verschiebt jede Reaktionszeit eines Wartungsvertrags.
 */
describe("ostersonntag", () => {
  it("trifft bekannte Jahre", () => {
    // Nachschlagbare Werte; die Osterformel ist leicht falsch
    // abzuschreiben und der Fehler fällt erst Jahre später auf.
    const erwartet: [number, number, number][] = [
      [2024, 2, 31], // 31. März 2024
      [2025, 3, 20], // 20. April 2025
      [2026, 3, 5], // 5. April 2026
      [2027, 2, 28], // 28. März 2027
      [2030, 3, 21], // 21. April 2030
      [2038, 3, 25], // 25. April 2038
    ];

    for (const [jahr, monat, tag] of erwartet) {
      const o = ostersonntag(jahr);
      assert.equal(o.getFullYear(), jahr);
      assert.equal(o.getMonth(), monat, `Monat ${jahr}`);
      assert.equal(o.getDate(), tag, `Tag ${jahr}`);
    }
  });

  it("fällt immer auf einen Sonntag", () => {
    for (let jahr = 2020; jahr <= 2060; jahr++) {
      assert.equal(ostersonntag(jahr).getDay(), 0, `Jahr ${jahr}`);
    }
  });

  it("liegt immer zwischen dem 22. März und dem 25. April", () => {
    for (let jahr = 1900; jahr <= 2100; jahr++) {
      const o = ostersonntag(jahr);
      const fruehestens = new Date(jahr, 2, 22);
      const spaetestens = new Date(jahr, 3, 25);

      assert.ok(o >= fruehestens && o <= spaetestens, `Jahr ${jahr}: ${o}`);
    }
  });
});

describe("feiertage", () => {
  it("kennt dreizehn gesetzliche Feiertage", () => {
    assert.equal(feiertage(2026).length, 13);
  });

  it("enthält den Nationalfeiertag am 26. Oktober", () => {
    const tage = feiertage(2026);
    const national = tage.find((f) => f.bezeichnung === "Nationalfeiertag");

    assert.ok(national);
    assert.equal(national.datum.getMonth(), 9);
    assert.equal(national.datum.getDate(), 26);
  });

  it("führt den Karfreitag nicht als gesetzlichen Feiertag", () => {
    // Seit 2019 ein persönlicher Feiertag auf Verlangen, kein
    // gesetzlicher. Wer ihn mitzählt, verschiebt Fristen zu Unrecht.
    const karfreitag = new Date(ostersonntag(2026));
    karfreitag.setDate(karfreitag.getDate() - 2);

    assert.equal(istFeiertag(karfreitag), false);
  });

  it("führt den 24. und 31. Dezember nicht als gesetzlichen Feiertag", () => {
    assert.equal(istFeiertag(new Date(2026, 11, 24)), false);
    assert.equal(istFeiertag(new Date(2026, 11, 31)), false);
  });

  it("setzt die beweglichen Feiertage im richtigen Abstand zu Ostern", () => {
    const ostern = ostersonntag(2026);
    const tage = feiertage(2026);
    const tag = 24 * 3600 * 1000;

    const abstand = (name: string) => {
      const f = tage.find((x) => x.bezeichnung === name);
      assert.ok(f, name);
      return Math.round((f.datum.getTime() - ostern.getTime()) / tag);
    };

    assert.equal(abstand("Ostermontag"), 1);
    assert.equal(abstand("Christi Himmelfahrt"), 39);
    assert.equal(abstand("Pfingstmontag"), 50);
    assert.equal(abstand("Fronleichnam"), 60);
  });

  it("liefert die Liste chronologisch", () => {
    const tage = feiertage(2027);
    for (let i = 1; i < tage.length; i++) {
      assert.ok(tage[i].datum >= tage[i - 1].datum);
    }
  });
});

describe("istFeiertag und istArbeitsfrei", () => {
  it("erkennt feste Feiertage", () => {
    assert.equal(istFeiertag(new Date(2026, 0, 1)), true);
    assert.equal(istFeiertag(new Date(2026, 9, 26)), true);
    assert.equal(istFeiertag(new Date(2026, 11, 8)), true);
  });

  it("erkennt gewöhnliche Werktage nicht als Feiertag", () => {
    // 15. September 2026 ist ein Dienstag ohne Feiertag.
    assert.equal(istFeiertag(new Date(2026, 8, 15)), false);
  });

  it("nennt den Feiertag beim Namen", () => {
    assert.equal(feiertagName(new Date(2026, 9, 26)), "Nationalfeiertag");
    assert.equal(feiertagName(new Date(2026, 8, 15)), null);
  });

  it("zählt Wochenenden zur arbeitsfreien Zeit", () => {
    // 12. und 13. September 2026 sind Samstag und Sonntag.
    assert.equal(istArbeitsfrei(new Date(2026, 8, 12)), true);
    assert.equal(istArbeitsfrei(new Date(2026, 8, 13)), true);
    assert.equal(istArbeitsfrei(new Date(2026, 8, 15)), false);
  });

  it("beachtet die Uhrzeit nicht", () => {
    assert.equal(istFeiertag(new Date(2026, 9, 26, 23, 59)), true);
  });
});
