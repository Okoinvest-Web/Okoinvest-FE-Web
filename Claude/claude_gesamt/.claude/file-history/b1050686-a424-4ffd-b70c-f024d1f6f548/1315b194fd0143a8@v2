"use client";

import { useMemo, useState } from "react";

import { Legende } from "@/components/ui";
import { formatZahl } from "@/lib/format";

/**
 * Gestapeltes Balkendiagramm, etwa fuer Monatsertraege.
 *
 * Zwischen den gestapelten Abschnitten bleibt eine schmale Luecke in
 * Flaechenfarbe. Sie trennt die Abschnitte auch dann, wenn die Farben
 * bei Farbfehlsichtigkeit nahe beieinander liegen.
 */

export interface BalkenReihe {
  schluessel: string;
  label: string;
  farbe: string;
  werte: number[];
}

export function Balkendiagramm({
  beschriftungen,
  reihen,
  einheit,
  kompakt = false,
  hoehe = 240,
  /** Vergleichslinie, etwa der Sollwert aus der Auslegung. */
  sollwert,
  sollLabel = "Soll",
}: {
  beschriftungen: string[];
  reihen: BalkenReihe[];
  einheit: string;
  /**
   * Kuerzt grosse Zahlen auf Tausender ("12k"). Als Schalter statt als
   * Funktion, weil Serverkomponenten keine Funktionen an
   * Clientkomponenten uebergeben duerfen.
   */
  kompakt?: boolean;
  hoehe?: number;
  sollwert?: number;
  sollLabel?: string;
}) {
  const [aktiv, setAktiv] = useState<number | null>(null);

  const formatWert = (wert: number) =>
    kompakt && Math.abs(wert) >= 1000
      ? `${formatZahl(wert / 1000, 0)}k`
      : formatZahl(wert, 0);

  const BREITE = 720;
  const RAND = { oben: 12, rechts: 8, unten: 26, links: 48 };

  const { maximum, skalaY, balkenBreite, schritt, teilstriche } =
    useMemo(() => {
      const summen = beschriftungen.map((_, i) =>
        reihen.reduce((s, r) => s + (r.werte[i] ?? 0), 0),
      );
      const roh = Math.max(1, ...summen, sollwert ?? 0);
      const stufe = 10 ** Math.floor(Math.log10(roh));
      const maximum = Math.ceil(roh / (stufe / 2)) * (stufe / 2);

      const innenH = hoehe - RAND.oben - RAND.unten;
      const innenB = BREITE - RAND.links - RAND.rechts;
      const schritt = innenB / beschriftungen.length;

      return {
        maximum,
        skalaY: (wert: number) =>
          RAND.oben + innenH - (wert / maximum) * innenH,
        balkenBreite: Math.min(46, schritt * 0.62),
        schritt,
        teilstriche: Array.from({ length: 5 }, (_, i) => (maximum / 4) * i),
      };
    }, [
      beschriftungen,
      reihen,
      hoehe,
      sollwert,
      RAND.links,
      RAND.oben,
      RAND.rechts,
      RAND.unten,
    ]);

  const nullLinie = skalaY(0);

  return (
    <div>
      {reihen.length >= 2 && (
        <div className="mb-3">
          <Legende
            eintraege={reihen.map((r) => ({ farbe: r.farbe, label: r.label }))}
          />
        </div>
      )}

      <div className="relative">
        {/*
        Mindestbreite mit eigenem Querlauf: Auf schmalen Bildschirmen
        wuerde das SVG sonst so weit herunterskaliert, dass die
        Achsenbeschriftung unleserlich wird. Gescrollt wird nur das
        Diagramm, nicht die Seite.
      */}
        <div className="-mx-5 min-w-0 overflow-x-auto px-5">
          <svg
            viewBox={`0 0 ${BREITE} ${hoehe}`}
            className="w-full"
            style={{ height: hoehe, minWidth: 560 }}
            role="img"
            aria-label={`Balkendiagramm: ${reihen.map((r) => r.label).join(", ")} in ${einheit}`}
            onPointerLeave={() => setAktiv(null)}
          >
            {teilstriche.map((wert) => (
              <g key={wert}>
                <line
                  x1={RAND.links}
                  y1={skalaY(wert)}
                  x2={BREITE - RAND.rechts}
                  y2={skalaY(wert)}
                  className="stroke-slate-200 dark:stroke-slate-800"
                  strokeWidth="1"
                />
                <text
                  x={RAND.links - 8}
                  y={skalaY(wert)}
                  textAnchor="end"
                  dominantBaseline="middle"
                  className="fill-slate-400 text-[11px] tabular-nums"
                >
                  {formatWert(wert)}
                </text>
              </g>
            ))}

            {sollwert !== undefined && (
              <g>
                <line
                  x1={RAND.links}
                  y1={skalaY(sollwert)}
                  x2={BREITE - RAND.rechts}
                  y2={skalaY(sollwert)}
                  className="stroke-slate-500 dark:stroke-slate-400"
                  strokeWidth="1.5"
                  strokeDasharray="6 4"
                />
                <text
                  x={BREITE - RAND.rechts}
                  y={skalaY(sollwert) - 5}
                  textAnchor="end"
                  className="fill-slate-500 text-[11px] dark:fill-slate-400"
                >
                  {sollLabel}
                </text>
              </g>
            )}

            {beschriftungen.map((beschriftung, i) => {
              const mitte = RAND.links + schritt * (i + 0.5);
              const x = mitte - balkenBreite / 2;
              let unterkante = nullLinie;

              return (
                <g
                  key={`${beschriftung}-${i}`}
                  onPointerEnter={() => setAktiv(i)}
                  className="cursor-default"
                >
                  {/* Grosszuegige Trefferflaeche, unabhaengig von der Balkenhoehe. */}
                  <rect
                    x={mitte - schritt / 2}
                    y={RAND.oben}
                    width={schritt}
                    height={hoehe - RAND.oben - RAND.unten}
                    fill="transparent"
                  />

                  {aktiv === i && (
                    <rect
                      x={mitte - schritt / 2}
                      y={RAND.oben}
                      width={schritt}
                      height={hoehe - RAND.oben - RAND.unten}
                      className="fill-slate-100/70 dark:fill-slate-800/50"
                    />
                  )}

                  {reihen.map((reihe, reihenIndex) => {
                    const wert = reihe.werte[i] ?? 0;
                    if (wert <= 0) return null;

                    const hoeheAbschnitt =
                      (wert / maximum) * (hoehe - RAND.oben - RAND.unten);
                    // 2 px Luecke zwischen den Abschnitten.
                    const luecke = reihenIndex === 0 ? 0 : 2;
                    const y = unterkante - hoeheAbschnitt;
                    unterkante = y - luecke;

                    const obersterAbschnitt = reihenIndex === reihen.length - 1;

                    return (
                      <rect
                        key={reihe.schluessel}
                        x={x}
                        y={y}
                        width={balkenBreite}
                        height={Math.max(0, hoeheAbschnitt)}
                        fill={reihe.farbe}
                        // Nur oben runden, damit der Stapel geschlossen wirkt.
                        rx={obersterAbschnitt ? 4 : 0}
                        className="animate-aufsteigen"
                        style={{ animationDelay: `${i * 25}ms` }}
                      />
                    );
                  })}

                  <text
                    x={mitte}
                    y={hoehe - 8}
                    textAnchor="middle"
                    className={`text-[11px] ${
                      aktiv === i
                        ? "fill-slate-700 dark:fill-slate-200"
                        : "fill-slate-400"
                    }`}
                  >
                    {beschriftung}
                  </text>
                </g>
              );
            })}
          </svg>
        </div>

        {aktiv !== null && (
          <div
            className="animate-einblenden pointer-events-none absolute top-2 right-2 z-10 min-w-[9rem] rounded-lg border border-slate-200 bg-white/95 p-2.5 shadow-lg backdrop-blur dark:border-slate-700 dark:bg-slate-900/95"
            role="status"
          >
            <p className="mb-1.5 text-xs font-medium text-slate-500 dark:text-slate-400">
              {beschriftungen[aktiv]}
            </p>
            <ul className="space-y-1">
              {reihen.map((reihe) => (
                <li
                  key={reihe.schluessel}
                  className="flex items-center justify-between gap-3 text-xs"
                >
                  <span className="flex items-center gap-1.5 text-slate-600 dark:text-slate-300">
                    <span
                      aria-hidden
                      className="h-2 w-2 shrink-0 rounded-[2px]"
                      style={{ background: reihe.farbe }}
                    />
                    {reihe.label}
                  </span>
                  <span className="font-medium text-slate-900 tabular-nums dark:text-slate-100">
                    {formatWert(reihe.werte[aktiv] ?? 0)}
                    <span className="ml-0.5 font-normal text-slate-400">
                      {einheit}
                    </span>
                  </span>
                </li>
              ))}
              {reihen.length > 1 && (
                <li className="flex items-center justify-between gap-3 border-t border-slate-200 pt-1 text-xs dark:border-slate-700">
                  <span className="text-slate-500 dark:text-slate-400">
                    Gesamt
                  </span>
                  <span className="font-semibold text-slate-900 tabular-nums dark:text-slate-100">
                    {formatWert(
                      reihen.reduce((s, r) => s + (r.werte[aktiv] ?? 0), 0),
                    )}
                    <span className="ml-0.5 font-normal text-slate-400">
                      {einheit}
                    </span>
                  </span>
                </li>
              )}
            </ul>
          </div>
        )}
      </div>
    </div>
  );
}
