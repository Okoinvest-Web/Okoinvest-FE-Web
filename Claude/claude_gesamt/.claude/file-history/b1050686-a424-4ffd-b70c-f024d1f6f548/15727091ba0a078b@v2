/** Alle Eintraege flach - fuer die Suche nach dem aktiven Pfad. */
export const ALLE_EINTRAEGE = NAVIGATION.flatMap((g) => g.eintraege);

/**
 * Ist der Eintrag fuer den aktuellen Pfad aktiv?
 * "/portal" nur exakt, sonst waere es auf jeder Unterseite markiert.
 */
export function istAktiv(eintrag: NavEintrag, pfad: string): boolean {
  return eintrag.pfad === "/portal"
    ? pfad === "/portal"
    : pfad.startsWith(eintrag.pfad);
}
