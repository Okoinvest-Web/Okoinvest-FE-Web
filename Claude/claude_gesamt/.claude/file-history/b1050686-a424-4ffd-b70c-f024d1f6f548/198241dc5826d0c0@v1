import type { ReactNode } from "react";

/** Karte als Grundbaustein aller Portalflaechen. */
export function Card({
  title,
  action,
  children,
}: {
  title?: string;
  action?: ReactNode;
  children: ReactNode;
}) {
  return (
    <section className="rounded-xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      {(title || action) && (
        <header className="mb-4 flex items-center justify-between gap-3">
          {title && (
            <h2 className="text-sm font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-400">
              {title}
            </h2>
          )}
          {action}
        </header>
      )}
      {children}
    </section>
  );
}

/** Kennzahl fuer die Dashboard-Uebersicht. */
export function Kennzahl({
  label,
  wert,
  einheit,
  hinweis,
}: {
  label: string;
  wert: string;
  einheit?: string;
  hinweis?: string;
}) {
  return (
    <div className="rounded-xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <p className="text-sm text-slate-500 dark:text-slate-400">{label}</p>
      <p className="mt-2 text-3xl font-semibold text-slate-900 tabular-nums dark:text-slate-50">
        {wert}
        {einheit && (
          <span className="ml-1 text-lg font-normal text-slate-400">
            {einheit}
          </span>
        )}
      </p>
      {hinweis && (
        <p className="mt-1 text-xs text-slate-400 dark:text-slate-500">
          {hinweis}
        </p>
      )}
    </div>
  );
}

const badgeFarben: Record<string, string> = {
  gruen:
    "bg-emerald-50 text-emerald-700 ring-emerald-600/20 dark:bg-emerald-950 dark:text-emerald-300",
  gelb: "bg-amber-50 text-amber-700 ring-amber-600/20 dark:bg-amber-950 dark:text-amber-300",
  rot: "bg-rose-50 text-rose-700 ring-rose-600/20 dark:bg-rose-950 dark:text-rose-300",
  grau: "bg-slate-100 text-slate-600 ring-slate-500/20 dark:bg-slate-800 dark:text-slate-300",
};

export type BadgeFarbe = keyof typeof badgeFarben;

export function Badge({
  children,
  farbe = "grau",
}: {
  children: ReactNode;
  farbe?: BadgeFarbe;
}) {
  return (
    <span
      className={`inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset ${badgeFarben[farbe]}`}
    >
      {children}
    </span>
  );
}

/** Einheitliche Darstellung, wenn eine Liste nichts enthaelt. */
export function LeerZustand({ text }: { text: string }) {
  return (
    <p className="rounded-lg border border-dashed border-slate-300 px-4 py-8 text-center text-sm text-slate-500 dark:border-slate-700 dark:text-slate-400">
      {text}
    </p>
  );
}

/**
 * Fehlerhinweis fuer Seiten, deren Frappe-Aufruf fehlgeschlagen ist.
 * Zeigt bewusst die Klartextmeldung - im Portal steht sie nur
 * angemeldeten Benutzern offen und hilft beim Einrichten.
 */
export function Fehlerhinweis({ meldung }: { meldung: string }) {
  return (
    <div className="rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900 dark:border-amber-800 dark:bg-amber-950 dark:text-amber-200">
      <p className="font-medium">Daten konnten nicht geladen werden</p>
      <p className="mt-1 text-amber-800 dark:text-amber-300">{meldung}</p>
    </div>
  );
}
