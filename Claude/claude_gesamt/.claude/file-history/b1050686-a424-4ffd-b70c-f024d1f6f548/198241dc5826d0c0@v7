import type { ReactNode } from "react";

import { IconInfo, IconWarnung } from "./icon";
import { Zaehlwerk } from "./zaehlwerk";

/**
 * Bausteine des Leitstands.
 *
 * Eine Tafel ist ein Feld auf einer Schalttafel: Rahmen, Kopfzeile,
 * Inhalt. Kein Schatten, keine Rundung, keine Hebung unter dem Zeiger -
 * nichts an einem Leitstand schwebt.
 *
 * Drei Regeln halten die Bausteine zusammen:
 *
 *  - Jede Zahl steht in der Zahlenschrift. Wo Werte untereinander
 *    stehen, liegen Komma und Nachkommastellen übereinander.
 *  - Jeder Zustand trägt ein Wort. Farbe ist die zweite Kodierung,
 *    nie die erste.
 *  - Etiketten stehen in Versalien über dem Wert, nicht daneben. Das
 *    ist die Beschriftungsweise einer Schalttafel und spart eine
 *    Spalte.
 */

/* ------------------------------------------------------------------ */
/* Flaechen                                                            */
/* ------------------------------------------------------------------ */

export function Tafel({
  titel,
  hinweis,
  aktion,
  fusszeile,
  children,
  klasse = "",
  dicht = false,
}: {
  titel?: string;
  hinweis?: string;
  aktion?: ReactNode;
  fusszeile?: ReactNode;
  children: ReactNode;
  klasse?: string;
  /** Ohne Innenabstand - fuer Tabellen, die bis an den Rand gehen. */
  dicht?: boolean;
}) {
  return (
    <section
      className={`tafel relative min-w-0 overflow-hidden ${klasse}`}
    >
      {(titel || aktion) && (
        <header
          className="flex flex-wrap items-center justify-between gap-x-4 gap-y-1.5 border-b px-3.5 py-2.5"
          style={{
            borderColor: "var(--linie)",
            background: "var(--f-vertieft)",
          }}
        >
          <div className="min-w-0">
            {/*
              Der Tafelkopf traegt das Etikett, nicht die Ueberschrift:
              klein, versal, gesperrt. Die Aufmerksamkeit gehoert dem
              Inhalt darunter - der Kopf sagt nur, was es ist.
            */}
            {titel && <h2 className="t-etikett">{titel}</h2>}
            {hinweis && <p className="t-mikro mt-0.5">{hinweis}</p>}
          </div>
          {aktion && (
            // Kein shrink-0: Ein Aktionsbereich, der nicht schrumpfen
            // darf, draengt auf schmalen Bildschirmen die ganze Seite
            // auseinander. Er bricht stattdessen um.
            <div className="flex min-w-0 flex-wrap gap-1.5">{aktion}</div>
          )}
        </header>
      )}

      <div className={dicht ? "" : "p-3.5"}>{children}</div>

      {fusszeile && (
        <footer
          className="border-t px-3.5 py-2"
          style={{
            borderColor: "var(--linie)",
            background: "var(--f-vertieft)",
          }}
        >
          {fusszeile}
        </footer>
      )}
    </section>
  );
}

/**
 * Der Seitenkopf.
 *
 * Eine Zeile, eine Haarlinie darunter - wie die Beschriftung über
 * einer Schalttafel. Er nimmt so wenig Platz wie möglich: Der Titel
 * sagt, wo man ist, und wer das weiß, will die Daten sehen.
 */
export function Seitenkopf({
  titel,
  hinweis,
  aktion,
  zurueck,
}: {
  titel: string;
  hinweis?: string;
  aktion?: ReactNode;
  zurueck?: ReactNode;
}) {
  return (
    <div className="a-seitlich">
      {/*
        Der Rückweg ist eine Hilfe zum Blättern und gehört nicht auf
        ein Blatt Papier: Auf einem ausgedruckten Beleg steht sonst
        "Zurück zum Abrechnungslauf" über der Rechnungsnummer.
      */}
      {zurueck && <div className="mb-1.5 print:hidden">{zurueck}</div>}

      <div
        className="flex flex-wrap items-end justify-between gap-x-4 gap-y-2 border-b pb-2.5"
        style={{ borderColor: "var(--linie)" }}
      >
        <div className="min-w-0">
          <h1 className="t-titel flex items-center gap-2">
            {/* Der Strich vor dem Titel: das Zeichen einer Schalttafel
                dafuer, dass hier ein Abschnitt beginnt. */}
            <span
              aria-hidden
              className="inline-block h-3.5 w-0.5 shrink-0"
              style={{ background: "var(--akzent)" }}
            />
            {titel}
          </h1>
          {hinweis && <p className="t-mikro mt-1">{hinweis}</p>}
        </div>
        {aktion && (
          <div className="flex min-w-0 flex-wrap items-center gap-1.5">
            {aktion}
          </div>
        )}
      </div>
    </div>
  );
}

/* ------------------------------------------------------------------ */
/* Kennzahlen                                                          */
/* ------------------------------------------------------------------ */

/**
 * Kennzahlenleiste.
 *
 * Die Werte liegen als Felder aneinander und teilen sich ihre Linien.
 * Das bindet sie zu einer Aussage zusammen, statt gleichwertige
 * Kacheln nebeneinanderzustellen - und es ist genau die Anordnung, in
 * der eine Schalttafel ihre Anzeigen führt.
 */
export function Kennzahlenleiste({ children }: { children: ReactNode }) {
  return (
    <div className="raster grid-cols-2 lg:grid-cols-4">{children}</div>
  );
}

export function Kennzahl({
  label,
  wert,
  einheit,
  hinweis,
  trend,
  akzent = false,
  ton,
}: {
  label: string;
  wert: string;
  einheit?: string;
  hinweis?: string;
  trend?: { wert: number };
  /** Hebt die wichtigste Zahl der Leiste hervor - in der Markenfarbe. */
  akzent?: boolean;
  /**
   * Faerbt die Zahl nach ihrem Zustand.
   *
   * Der Unterschied zu `akzent` ist keiner der Gestaltung, sondern
   * der Bedeutung: Gruen heisst in dieser Oberflaeche "in Ordnung"
   * oder "das ist die fuehrende Zahl". Ein Ertragsausfall in Gruen
   * sagt das Gegenteil dessen, was gemeint ist.
   */
  ton?: StatusTon;
}) {
  /*
   * Die Groesse folgt der Laenge, nicht dem Platz.
   *
   * Eine Kennzahl steht auf dem Telefon in einer halben Bildschirm-
   * breite. Ein Betrag wie "€ 13.326,73" passt dort nicht in die
   * grosse Stufe - und ein Umbruch ist keine Loesung, weil er die
   * Zahl mitten in der Ziffernfolge trennt: "€ 2.221,1" ueber
   * "2" liest niemand richtig.
   */
  const groesse =
    wert.length > 12
      ? "t-zahl-klein"
      : wert.length > 7
        ? "t-zahl-mittel"
        : "t-zahl";

  const farbe = ton
    ? STATUS_FARBEN[ton].text
    : akzent
      ? "var(--akzent-text)"
      : undefined;
  const streifen = ton
    ? STATUS_FARBEN[ton].text
    : akzent
      ? "var(--akzent)"
      : undefined;

  return (
    <div className="relative min-w-0 px-3.5 py-3">
      {/* Die hervorgehobene Zahl traegt einen Streifen an der Kante -
          die Hervorhebung einer Schalttafel, nicht eine zweite Farbe. */}
      {streifen && (
        <span
          aria-hidden
          className="absolute inset-y-0 left-0 w-0.5"
          style={{ background: streifen }}
        />
      )}

      {/*
        Das Etikett bricht um, statt abgeschnitten zu werden. Auf einem
        Telefon stehen zwei Kacheln nebeneinander; "Aus eigener
        Erzeugung" endete dort als "Aus eigener Erzeu…" - und damit
        erklaert die Zahl darunter nichts mehr.
      */}
      <p className="t-etikett">{label}</p>
      <p
        className={`mt-1.5 ${groesse}`}
        style={farbe ? { color: farbe } : undefined}
      >
        <Zaehlwerk wert={wert} />
        {einheit && (
          <span
            className="ml-1 text-[0.75rem] font-normal"
            style={{ color: "var(--t-zart)", fontFamily: "var(--font-sans)" }}
          >
            {einheit}
          </span>
        )}
      </p>
      {(hinweis || trend) && (
        <p className="t-mikro mt-1 flex flex-wrap items-center gap-x-1.5">
          {trend && <Trend wert={trend.wert} />}
          {hinweis}
        </p>
      )}
    </div>
  );
}

function Trend({ wert }: { wert: number }) {
  const steigt = wert >= 0;
  return (
    <span
      className="zahl font-medium"
      style={{
        color: steigt ? "var(--ton-gut)" : "var(--ton-ernst)",
      }}
    >
      <span aria-hidden>{steigt ? "▲" : "▼"}</span>{" "}
      {Math.abs(wert).toLocaleString("de-AT", { maximumFractionDigits: 1 })} %
    </span>
  );
}

/* ------------------------------------------------------------------ */
/* Status                                                              */
/* ------------------------------------------------------------------ */

export type StatusTon =
  | "gut"
  | "hinweis"
  | "ernst"
  | "kritisch"
  | "neutral"
  | "akzent";

/**
 * Die Farben der Zustandstoene - eine Quelle fuer alle.
 *
 * Auch Seiten, die keinen `Status` verwenden, brauchen dieselben
 * Toene: eine ueberfaellige Frist muss so aussehen wie ein kritischer
 * Alarm. Wer die Farbe an der Verwendungsstelle noch einmal waehlt,
 * bekommt zwei Rottoene, die fast gleich sind - und das sieht man.
 */
export const STATUS_FARBEN: Record<
  StatusTon,
  { text: string; flaeche: string; rand: string }
> = {
  gut: {
    text: "var(--ton-gut)",
    flaeche: "var(--ton-gut-flaeche)",
    rand: "var(--ton-gut-rand)",
  },
  hinweis: {
    text: "var(--ton-hinweis)",
    flaeche: "var(--ton-hinweis-flaeche)",
    rand: "var(--ton-hinweis-rand)",
  },
  ernst: {
    text: "var(--ton-ernst)",
    flaeche: "var(--ton-ernst-flaeche)",
    rand: "var(--ton-ernst-rand)",
  },
  kritisch: {
    text: "var(--ton-kritisch)",
    flaeche: "var(--ton-kritisch-flaeche)",
    rand: "var(--ton-kritisch-rand)",
  },
  neutral: {
    text: "var(--t-leise)",
    flaeche: "var(--f-belegt)",
    rand: "var(--linie)",
  },
  akzent: {
    text: "var(--akzent-text)",
    flaeche: "color-mix(in oklch, var(--akzent), transparent 88%)",
    rand: "color-mix(in oklch, var(--akzent), transparent 70%)",
  },
};

/**
 * Statuskennzeichen.
 *
 * Rechteckig statt Pille, mit einem quadratischen Melder davor: So
 * sieht eine Zustandsanzeige an einem Schaltschrank aus. Sie traegt
 * immer Text - die Farbe allein darf die Aussage nie tragen.
 */
export function Status({
  ton = "neutral",
  children,
  punkt = true,
}: {
  ton?: StatusTon;
  children: ReactNode;
  punkt?: boolean;
}) {
  const farben = STATUS_FARBEN[ton];

  return (
    <span
      className="inline-flex items-center gap-1.5 border px-1.5 py-px text-[0.6875rem] leading-[1.35] font-semibold tracking-wide whitespace-nowrap"
      style={{
        color: farben.text,
        background: farben.flaeche,
        borderColor: farben.rand,
        borderRadius: "var(--radius-feld)",
      }}
    >
      {punkt && (
        <span
          aria-hidden
          className="h-1.5 w-1.5 shrink-0"
          style={{ background: "currentColor" }}
        />
      )}
      {children}
    </span>
  );
}

/**
 * Rueckmeldung einer Bedienhandlung.
 *
 * Nicht `Status`: Das ist eine Marke fuer ein Etikett - ein Wort, das
 * nicht umbrechen darf. Was eine Aktion zurueckmeldet, ist ein Satz,
 * oft mehrere. In eine Marke gesteckt wird er abgeschnitten, und
 * ausgerechnet der Teil, der sagt, was als Naechstes zu tun ist, faellt
 * weg. Diese Meldung bricht um und behaelt den Ton bei.
 */
export function Meldung({
  ton = "neutral",
  children,
}: {
  ton?: StatusTon;
  children: ReactNode;
}) {
  const farben = STATUS_FARBEN[ton];

  return (
    <div
      role="status"
      className="a-einblenden flex min-w-0 items-start gap-2 border-y border-r px-3 py-2 text-[0.8125rem] leading-relaxed"
      style={{
        background: farben.flaeche,
        borderColor: farben.rand,
        // Der Ton steht als Balken an der Kante, nicht als Rahmen um
        // alles herum: So bleibt der Text ruhig und der Zustand
        // trotzdem ablesbar.
        borderLeft: `2px solid ${farben.text}`,
        color: "var(--t-normal)",
      }}
    >
      <span className="min-w-0">{children}</span>
    </div>
  );
}

export function LivePunkt({ aktiv = true }: { aktiv?: boolean }) {
  return (
    <span className="relative flex h-2 w-2" aria-hidden>
      {aktiv && (
        <span
          className="a-atmen absolute inline-flex h-full w-full"
          style={{ background: "var(--ton-gut)" }}
        />
      )}
      <span
        className="relative inline-flex h-2 w-2"
        style={{ background: aktiv ? "var(--ton-gut)" : "var(--t-zart)" }}
      />
    </span>
  );
}

/* ------------------------------------------------------------------ */
/* Werte und Beschriftung                                              */
/* ------------------------------------------------------------------ */

/**
 * Eine Angabe: Bezeichnung links, Wert rechts.
 *
 * Mit Haarlinie zwischen den Zeilen. Ohne sie wandert das Auge bei
 * einer langen Liste von einer Zeile in die naechste - und liest den
 * Wert der falschen.
 */
export function Angabe({
  label,
  children,
  untereinander = false,
}: {
  label: string;
  children: ReactNode;
  untereinander?: boolean;
}) {
  if (untereinander) {
    return (
      <div className="min-w-0">
        <dt className="t-etikett">{label}</dt>
        <dd className="t-zahl-klein mt-1 break-words">{children}</dd>
      </div>
    );
  }

  return (
    <div
      className="flex items-baseline justify-between gap-4 border-b py-1.5 last:border-b-0"
      style={{ borderColor: "var(--linie-zart)" }}
    >
      <dt className="t-mikro shrink-0">{label}</dt>
      <dd className="t-zahl-klein text-right break-words">{children}</dd>
    </div>
  );
}

/**
 * Ein Balken.
 *
 * Rechteckig und flach an der Grundlinie - eine Skala, kein
 * Fortschrittsring. Die Schiene bleibt sichtbar, damit der Rest
 * ablesbar ist: Bei 82 Prozent will man auch die fehlenden 18 sehen.
 */
export function Balken({
  label,
  anteil,
  wertText,
  farbe,
}: {
  label: string;
  /** 0 bis 100. */
  anteil: number;
  wertText: string;
  farbe?: string;
}) {
  const begrenzt = Math.max(0, Math.min(100, anteil));

  return (
    <div>
      <div className="mb-1 flex items-baseline justify-between gap-3">
        <span className="t-mikro truncate">{label}</span>
        <span className="t-zahl-klein shrink-0">{wertText}</span>
      </div>
      <div
        className="h-1.5 overflow-hidden"
        style={{
          background: "var(--f-belegt)",
          borderRadius: "1px",
        }}
        role="img"
        aria-label={`${label}: ${wertText}`}
      >
        <div
          className="h-full transition-[width] duration-500"
          style={{
            width: `${begrenzt}%`,
            background: farbe ?? "var(--akzent)",
            transitionTimingFunction: "var(--ease-aus)",
          }}
        />
      </div>
    </div>
  );
}

/* ------------------------------------------------------------------ */
/* Zustaende und Hinweise                                              */
/* ------------------------------------------------------------------ */

export function LeerZustand({
  text,
  hinweis,
  aktion,
}: {
  text: string;
  hinweis?: string;
  aktion?: ReactNode;
}) {
  return (
    <div
      className="border border-dashed px-4 py-8 text-center"
      style={{
        borderRadius: "var(--radius-feld)",
        borderColor: "var(--linie-stark)",
      }}
    >
      <p className="t-leise">{text}</p>
      {hinweis && <p className="t-mikro mx-auto mt-1.5 max-w-md">{hinweis}</p>}
      {aktion && <div className="mt-3">{aktion}</div>}
    </div>
  );
}

/**
 * Ein Hinweis über einer Tafel.
 *
 * Der Ton steht als Balken an der linken Kante. Eine vollflächig
 * eingefärbte Meldung über die halbe Seite macht einen Aussetzer
 * größer, als er ist - und wer drei davon untereinander hat, liest
 * keinen mehr.
 */
export function Hinweis({
  ton = "neutral",
  titel,
  children,
}: {
  ton?: StatusTon;
  titel?: string;
  children: ReactNode;
}) {
  const farben = STATUS_FARBEN[ton];
  const Zeichen = ton === "neutral" || ton === "akzent" ? IconInfo : IconWarnung;

  return (
    <div
      className="a-einblenden flex gap-2.5 border-y border-r px-3.5 py-2.5"
      style={{
        background: farben.flaeche,
        borderColor: farben.rand,
        borderLeft: `2px solid ${farben.text}`,
        borderRadius: "var(--radius-feld)",
      }}
    >
      <span className="mt-0.5 shrink-0" style={{ color: farben.text }}>
        <Zeichen groesse={14} />
      </span>
      <div className="mass min-w-0 text-[0.8125rem] leading-relaxed">
        {titel && (
          <p className="font-semibold" style={{ color: farben.text }}>
            {titel}
          </p>
        )}
        <div style={{ color: "var(--t-normal)" }}>{children}</div>
      </div>
    </div>
  );
}

export function Skelett({ klasse = "h-4 w-full" }: { klasse?: string }) {
  return <div className={`skelett ${klasse}`} aria-hidden />;
}

export function Legende({
  eintraege,
}: {
  eintraege: { farbe: string; label: string; wert?: string }[];
}) {
  return (
    <ul className="flex flex-wrap items-center gap-x-4 gap-y-1.5">
      {eintraege.map((eintrag) => (
        <li key={eintrag.label} className="t-mikro flex items-center gap-1.5">
          <span
            aria-hidden
            className="h-2 w-2 shrink-0"
            style={{ background: eintrag.farbe }}
          />
          {eintrag.label}
          {eintrag.wert && <span className="t-zahl-klein">{eintrag.wert}</span>}
        </li>
      ))}
    </ul>
  );
}
