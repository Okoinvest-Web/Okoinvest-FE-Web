    ["Konformitaetserklaerung_SMA.pdf", "ANL-0001", 412_004],
    ["Brandschutzkonzept_TRVB_E133.pdf", "ANL-0001", 2_118_764],
    ["Statiknachweis_Dachaufbau.pdf", "ANL-0001", 5_442_119],
    ["Netzzugangsvertrag_Saegewerk.pdf", "ANL-0002", 301_887],
    ["Erstpruefung_Saegewerk_2023.pdf", "ANL-0002", 1_664_223],
    ["Wartungsvertrag_2026.pdf", "ANL-0002", 188_442],
    ["Versicherungspolizze_Elektronik.pdf", "ANL-0003", 622_190],
    ["Foerderzusage_EAG_Investitionszuschuss.pdf", "ANL-0005", 214_663],
    ["Vollmacht_Oekovolt_CO2.pdf", "ANL-0001", 96_338],
  ] as const;

  const basis = new Date();

  return vorlagen.map(([dateiname, anlage, groesse], i) => {
