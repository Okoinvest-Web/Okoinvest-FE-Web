    return {
      name: `FILE-${String(i + 1).padStart(4, "0")}`,
      file_name: dateiname,
      file_url: `/files/${dateiname}`,
      file_size: groesse,
      attached_to_doctype: "PV Anlage",
      attached_to_name: anlage,
      is_private: 1,
      creation: datum.toISOString(),
    };
  });
