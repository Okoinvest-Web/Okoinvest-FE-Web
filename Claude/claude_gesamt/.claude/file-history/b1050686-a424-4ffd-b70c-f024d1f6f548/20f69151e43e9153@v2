/** Standort der Anlagen für die Sonnenstandsrechnung. */
const STANDORT: Record<string, { breite: number; laenge: number }> = {
  "ANL-0001": { breite: 48.204, laenge: 15.624 },
  "ANL-0004": { breite: 48.204, laenge: 15.624 },
  "ANL-0005": { breite: 48.41, laenge: 15.61 },
};

export interface LadeErgebnis {
  ladepunkte: number;
  tarife: number;
  karten: number;
  vorgaenge: number;
  dauerMs: number;
}

export function befuelleLaden(erzwingen = false): LadeErgebnis {
  const start = Date.now();

  const vorhanden = skalar<number>("SELECT COUNT(*) FROM ladepunkt") ?? 0;
  if (vorhanden > 0 && !erzwingen) {
    return { ladepunkte: 0, tarife: 0, karten: 0, vorgaenge: 0, dauerMs: 0 };
  }

  let vorgaenge = 0;

  imBlock(() => {
    if (erzwingen) {
      for (const tabelle of [
        "ladebeleg",
        "ladeabrechnung",
        "ladevorgang",
        "ladekarte",
        "ladetarif",
        "ladepunkt",
      ]) {
        schreibe(`DELETE FROM ${tabelle}`);
      }
    }

    for (const t of TARIFE) {
      schreibe(
        `INSERT INTO ladetarif
           (id, bezeichnung, beschreibung, ct_kwh, ct_kwh_pv, ct_minute,
            blocking_ab_minute, ct_minute_blocking, blocking_hoechst_eur,
            grundpreis_monat_eur, ust_satz, gueltig_ab, aktiv)
         VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 20, '2024-01-01', 1)`,
        t.id,
        t.bezeichnung,
        t.beschreibung,
        t.ctKwh,
        t.ctKwhPv,
        t.ctMinute,
        t.blockingAbMinute,
        t.ctMinuteBlocking,
        t.blockingHoechstEur,
        t.grundpreisMonatEur,
      );
    }

    for (const p of LADEPUNKTE) {
      schreibe(
        `INSERT INTO ladepunkt
           (id, anlage_id, bezeichnung, evse_id, ocpp_id, hersteller, modell,
            seriennummer, firmware, leistung_kw, strom_art, steckertyp,
            standort, eichrecht, max_anteil, status, inbetriebnahme)
         VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?,
                 (SELECT inbetriebnahme FROM anlage WHERE id = ?))`,
        p.id,
        p.anlageId,
        p.bezeichnung,
        p.evse,
        p.id.toLowerCase().replace("-", ""),
        p.hersteller,
        p.modell,
        `SN-${p.id.slice(3)}-${startwertAus(p.id) % 100000}`,
        "1.14.2",
        p.leistungKw,
        p.stromArt,
        p.steckertyp,
        p.standort,
        p.eichrecht ? 1 : 0,
        p.stromArt === "DC" ? 1 : 0.35,
        p.status ?? "Verfuegbar",
        p.anlageId,
      );
    }

    for (const k of KARTEN) {
      schreibe(
        `INSERT INTO ladekarte
           (id, kennung, bezeichnung, inhaber, kennzeichen, fahrzeug,
            kostenstelle, tarif_id, art, sachbezug_ct_kwh, aktiv)
         VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
        k.id,
        k.kennung,
        k.bezeichnung,
        k.inhaber,
        k.kennzeichen,
        k.fahrzeug,
        k.kostenstelle,
        k.tarif,
        k.art,
        k.sachbezugCtKwh,
        k.aktiv === false ? 0 : 1,
      );
    }

    vorgaenge = erzeugeVorgaenge();
  });

  return {
    ladepunkte: LADEPUNKTE.length,
    tarife: TARIFE.length,
    karten: KARTEN.length,
    vorgaenge,
    dauerMs: Date.now() - start,
  };
}

/**
 * Erzeugt die Ladevorgänge über den Betrachtungszeitraum.
 *
 * Der PV-Anteil wird aus dem Sonnenstand am Standort abgeleitet: Wer
 * nachts lädt, lädt aus dem Netz - daran ändert auch die größte Anlage
 * nichts. Genau diese Unterscheidung trägt später die ermäßigten
 * Arbeitspreise und macht sichtbar, was eine Ladesteuerung brächte.
 */
function erzeugeVorgaenge(): number {
  const heute = new Date();
  heute.setHours(0, 0, 0, 0);

  const punkte = new Map(LADEPUNKTE.map((p) => [p.id, p]));

  const einfuegen = db().prepare(
    `INSERT INTO ladevorgang
       (id, ladepunkt_id, karte_id, transaktion, beginn, ende, ladeende,
        zaehler_start, zaehler_ende, energie_kwh, pv_kwh,
        hoechstleistung_kw, status)
     VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
  );

  // Zählerstände laufen je Ladepunkt fort - eine Rechnung gegenüber
  // Dritten muss sich auf Anfangs- und Endstand berufen können.
  const zaehlerstand = new Map<string, number>(
    LADEPUNKTE.map((p) => [p.id, 1000 + (startwertAus(p.id) % 9000)]),
  );

  let nummer = 0;

  for (let tag = TAGE - 1; tag >= 0; tag--) {
    const datum = verschiebeTage(heute, -tag);
    const wochentag = datum.getDay();

    for (const karte of KARTEN) {
      if (karte.proWoche <= 0) continue;

      const zufall = zufallsfolge(
        startwertAus(`${karte.id}:${datum.toDateString()}`),
      );

      // Wahrscheinlichkeit, dass diese Karte heute lädt. Am Wochenende
      // fahren Montagefahrzeuge nicht, Mitarbeiter kommen nicht ins
      // Büro - der Betrieb steht.
      const werktags = wochentag >= 1 && wochentag <= 5;
      const chance = werktags
        ? karte.proWoche / 5
        : karte.art === "Gast"
          ? 0.05
          : 0.02;

      if (zufall() > chance) continue;

      const punkt = punkte.get(
        karte.punkte[Math.floor(zufall() * karte.punkte.length)],
      );
      if (!punkt || punkt.status === "Gestoert") continue;

      // Startzeit um die übliche Stunde herum, mit anderthalb Stunden
      // Streuung nach beiden Seiten. Ohne diese Streuung lägen alle
      // Vorgänge einer Karte auf derselben vollen Stunde, und jede
      // Lastganggrafik zeigte Blöcke statt eines Tagesverlaufs.
      const beginn = new Date(datum);
      const versatz = Math.round((zufall() - 0.5) * 180);
      beginn.setHours(karte.startstunde, versatz, 0, 0);

      const energie = Number(
        (karte.menge * (0.65 + zufall() * 0.7)).toFixed(2),
      );

      // Ladeleistung: der Ladepunkt begrenzt, das Fahrzeug meist auch.
      const fahrzeugGrenze = punkt.stromArt === "DC" ? 50 : 11;
      const leistung = Math.min(punkt.leistungKw, fahrzeugGrenze);
      const ladeMinuten = Math.max(12, (energie / leistung) * 60);

      const ladeende = new Date(beginn.getTime() + ladeMinuten * 60000);

      // Stehzeit nach dem Laden. Wer morgens ansteckt, bleibt bis zum
      // Feierabend; wer abends ansteckt, bis zum nächsten Morgen.
      const stehMinuten =
        karte.startstunde <= 9
          ? 240 + zufall() * 300
          : karte.startstunde >= 16
            ? 480 + zufall() * 240
            : 20 + zufall() * 90;

      const ende = new Date(ladeende.getTime() + stehMinuten * 60000);

      // PV-Anteil über die Ladedauer aus dem Sonnenstand mitteln.
      const pvAnteil = pvAnteilUeber(
        punkt.anlageId,
        beginn,
        ladeende,
        zufall,
      );

      const start = zaehlerstand.get(punkt.id) ?? 0;
      const neu = Number((start + energie).toFixed(2));
      zaehlerstand.set(punkt.id, neu);

      nummer += 1;
      einfuegen.run(
        `LV-${String(nummer).padStart(5, "0")}`,
        punkt.id,
        karte.id,
        `TX-${String(100000 + nummer)}`,
        messStempel(beginn),
        messStempel(ende),
        messStempel(ladeende),
        start,
        neu,
        energie,
        Number((energie * pvAnteil).toFixed(2)),
        Number((leistung * (0.9 + zufall() * 0.1)).toFixed(1)),
        "Beendet",
      );
    }
  }

  return nummer;
}

/**
 * Mittlerer Anteil der eigenen Erzeugung über einen Ladezeitraum.
 *
 * Abgetastet wird in Zehn-Minuten-Schritten über die Sonnenhöhe. Das
 * ist bewusst einfach gehalten: Für eine belastbare Zuordnung bräuchte
 * es die tatsächliche Erzeugung und den übrigen Verbrauch der Anlage
 * zur selben Viertelstunde. Was hier entsteht, ist ein plausibler
 * Demonstrationswert, keine Abrechnungsgrundlage.
 */
function pvAnteilUeber(
  anlageId: string,
  von: Date,
  bis: Date,
  zufall: () => number,
): number {
  const ort = STANDORT[anlageId] ?? { breite: 48.2, laenge: 15.6 };

  // Bewölkung des Tages - über den ganzen Vorgang gleich.
  const wetter = 0.45 + zufall() * 0.5;

  let summe = 0;
  let schritte = 0;

  for (
    let t = von.getTime();
    t <= bis.getTime();
    t += 10 * 60 * 1000
  ) {
    const hoehe = sonnenposition(new Date(t), ort.breite, ort.laenge).hoehe;
    // Unter fünf Grad trägt die Anlage praktisch nichts bei.
    summe += hoehe > 5 ? Math.min(1, Math.sin((hoehe * Math.PI) / 180) * 1.6) : 0;
    schritte += 1;
  }

  if (schritte === 0) return 0;
  return Math.min(0.95, (summe / schritte) * wetter);
}

/**
 * Legt die Abrechnungsläufe der zurückliegenden Monate an.
 *
 * Bewusst außerhalb von `befuelleLaden`: Jeder Lauf führt seine eigene
 * Schreibklammer, und eine Klammer innerhalb einer anderen kennt die
 * Datenbankschicht nicht.
 *
 * Die abgeschlossenen Monate werden festgeschrieben, der laufende
 * bleibt Entwurf - so zeigt die Oberfläche beide Zustände, und der
 * Unterschied zwischen "gerechnet" und "gebucht" wird sichtbar.
 */
export function befuelleLadeabrechnungen(): {
  laeufe: number;
  belege: number;
  brutto: number;
} {
  const heute = new Date();
  let laeufe = 0;
  let belege = 0;
  let brutto = 0;

  // Die drei abgeschlossenen Monate vor dem laufenden, dann der
  // laufende Monat als Entwurf.
  for (let zurueck = 3; zurueck >= 0; zurueck--) {
    const stichtag = new Date(
      heute.getFullYear(),
      heute.getMonth() - zurueck,
      1,
    );
    const jahr = stichtag.getFullYear();
    const monat = stichtag.getMonth() + 1;

    const id = legeLadelaufAn(jahr, monat);
    const ergebnis = rechneLadelauf(id, "Automatischer Lauf");

    if (ergebnis.belege === 0) continue;

    laeufe += 1;
    belege += ergebnis.belege;
    brutto += ergebnis.brutto;

    if (zurueck > 0) schreibeLadelaufFest(id);
  }

  return { laeufe, belege, brutto: Number(brutto.toFixed(2)) };
}
