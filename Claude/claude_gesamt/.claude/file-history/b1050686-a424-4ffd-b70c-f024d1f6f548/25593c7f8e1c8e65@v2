import io

# ------------------------------------------------------------------
# 1. Schema
# ------------------------------------------------------------------
p = "src/lib/db/schema-technik.sql"
s = io.open(p, encoding="utf-8").read()
s += '''
-- ====================================================================
-- Abnahmepruefung nach OEVE/OENORM E 8001-4-712 und EN 62446-1
--
-- Ohne Pruefprotokoll gibt es keine Inbetriebnahmemeldung beim
-- Netzbetreiber, keine Foerderung und im Schadensfall keine
-- Versicherungsleistung. Deshalb werden nicht nur die Ergebnisse
-- abgelegt, sondern die Messwerte selbst samt der Bedingungen, unter
-- denen sie entstanden sind: Ein Spannungswert ohne Modultemperatur
-- und ein Stromwert ohne Einstrahlung sind nicht bewertbar.
-- ====================================================================

CREATE TABLE IF NOT EXISTS abnahme (
  id               TEXT PRIMARY KEY,
  anlage_id        TEXT NOT NULL REFERENCES anlage(id),
  geprueft_am      TEXT NOT NULL,
  pruefer          TEXT NOT NULL,
  pruefstelle      TEXT,
  -- Hoechste Systemspannung der Anlage; sie bestimmt Pruefspannung
  -- und Mindestisolationswiderstand.
  systemspannung_v REAL NOT NULL,
  -- Bedingungen waehrend der Messung.
  einstrahlung     REAL NOT NULL,
  modultemperatur  REAL NOT NULL,
  -- Schutzeinrichtungen.
  rcd_ausloesung_ms REAL,
  rcd_bemessung_ma  REAL,
  netzschutz_geprueft  INTEGER NOT NULL DEFAULT 0,
  inselschutz_geprueft INTEGER NOT NULL DEFAULT 0,
  bemerkung        TEXT
);

CREATE INDEX IF NOT EXISTS idx_abnahme_anlage ON abnahme(anlage_id);

CREATE TABLE IF NOT EXISTS abnahme_strang (
  id                TEXT PRIMARY KEY,
  abnahme_id        TEXT NOT NULL REFERENCES abnahme(id) ON DELETE CASCADE,
  strang_id         TEXT REFERENCES strang(id),
  bezeichnung       TEXT NOT NULL,
  module            INTEGER NOT NULL,
  uoc_modul_v       REAL NOT NULL,
  isc_modul_a       REAL NOT NULL,
  gemessene_uoc_v   REAL NOT NULL,
  gemessener_isc_a  REAL NOT NULL,
  isolation_mohm    REAL NOT NULL,
  pruefspannung_v   REAL NOT NULL,
  schutzleiter_ohm  REAL,
  polaritaet_richtig INTEGER NOT NULL DEFAULT 1
);

CREATE INDEX IF NOT EXISTS idx_abnahme_strang ON abnahme_strang(abnahme_id);
'''
io.open(p, "w", encoding="utf-8").write(s)
print("Schema")

