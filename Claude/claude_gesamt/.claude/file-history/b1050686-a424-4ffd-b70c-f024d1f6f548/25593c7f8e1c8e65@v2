p = "src/lib/db/befuellen-technik.ts"
s = io.open(p, encoding="utf-8").read()

s = s.replace('''        "wr_messwert",
        "sensor_messwert",''', '''        "abnahme_strang",
        "abnahme",
        "wr_messwert",
        "sensor_messwert",''', 1)

zusatz = '''
/**
 * Abnahmeprotokolle je Anlage.
 *
 * Gemessen wird an einem Tag mit brauchbarer Einstrahlung, und die
 * Werte streuen so, wie sie es an einem echten Dach tun: ein Prozent
 * Messunsicherheit, nicht Null.
 *
 * Zwei eingebaute Befunde, weil sich nur an ihnen zeigt, ob die
 * Pruefung taugt:
 *
 * - Der Lagerhalle fehlt ein Modul in einem Strang. Das ist der
 *   haeufigste Fehler bei der Erstinbetriebnahme und aus der
 *   Leerlaufspannung direkt ablesbar.
 * - Beim Carport wurde mit zu geringer Pruefspannung isoliert
 *   gemessen. Der Wert sieht gut aus und ist wertlos.
 */
function befuelleAbnahmen(): number {
  const anlagen = alle<{
    id: string;
    bezeichnung: string;
    inbetriebnahme: string | null;
  }>("SELECT id, bezeichnung, inbetriebnahme FROM anlage ORDER BY id");

  let anzahl = 0;

  for (const anlage of anlagen) {
    const zufall = zufallsfolge(startwertAus(`${anlage.id}-abnahme`));

    const straenge = alle<{
      id: string;
      bezeichnung: string;
      module: number;
      wechselrichter_id: string;
    }>(
      `SELECT s.id, s.bezeichnung, s.module, s.wechselrichter_id
         FROM strang s
         JOIN wechselrichter w ON w.id = s.wechselrichter_id
        WHERE w.anlage_id = ?
        ORDER BY s.id`,
      anlage.id,
    );

    if (straenge.length === 0) continue;

    const abnahmeId = `ABN-${anlage.id.slice(4)}`;
    const geprueft = anlage.inbetriebnahme ?? "2024-05-14";

    // Messbedingungen: ein klarer Vormittag im Mai.
    const einstrahlung = anlage.id === "ANL-0003" ? 320 : 780 + zufall() * 120;
    const modultemperatur = 18 + zufall() * 8;

    schreibe(
      `INSERT INTO abnahme
         (id, anlage_id, geprueft_am, pruefer, pruefstelle, systemspannung_v,
          einstrahlung, modultemperatur, rcd_ausloesung_ms, rcd_bemessung_ma,
          netzschutz_geprueft, inselschutz_geprueft, bemerkung)
       VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 1, 1, ?)`,
      abnahmeId,
      anlage.id,
      geprueft,
      "Ing. M. Hofbauer",
      "Ökovolt Technik, akkreditierte Prüfstelle",
      1000,
      Number(einstrahlung.toFixed(0)),
      Number(modultemperatur.toFixed(1)),
      Number((18 + zufall() * 12).toFixed(0)),
      30,
      anlage.id === "ANL-0003"
        ? "Strommessung wegen Bewölkung nicht verwertbar, Nachmessung vereinbart."
        : null,
    );

    for (const [i, strang] of straenge.entries()) {
      const module = strang.module > 0 ? strang.module : 20;
      const uocModul = 41.3;
      const iscModul = 13.9;

      // Der Erwartungswert bei den Messbedingungen.
      const sollUoc =
        module * uocModul * (1 - 0.0029 * (modultemperatur - 25));
      const sollIsc = iscModul * (einstrahlung / 1000);

      // Ein fehlendes Modul in der Lagerhalle, erster Strang.
      const fehlendesModul = anlage.id === "ANL-0003" && i === 0;

      const gemesseneUoc = fehlendesModul
        ? (sollUoc / module) * (module - 1)
        : sollUoc * (0.995 + zufall() * 0.01);

      schreibe(
        `INSERT INTO abnahme_strang
           (id, abnahme_id, strang_id, bezeichnung, module, uoc_modul_v,
            isc_modul_a, gemessene_uoc_v, gemessener_isc_a, isolation_mohm,
            pruefspannung_v, schutzleiter_ohm, polaritaet_richtig)
         VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 1)`,
        `${abnahmeId}-S${String(i + 1).padStart(2, "0")}`,
        abnahmeId,
        strang.id,
        strang.bezeichnung,
        module,
        uocModul,
        iscModul,
        Number(gemesseneUoc.toFixed(1)),
        Number((sollIsc * (0.98 + zufall() * 0.04)).toFixed(2)),
        Number((12 + zufall() * 40).toFixed(1)),
        // Beim Carport wurde mit der falschen Stufe gemessen.
        anlage.id === "ANL-0005" ? 500 : 1000,
        Number((0.12 + zufall() * 0.35).toFixed(2)),
      );
    }

    anzahl += 1;
  }

  return anzahl;
}
'''

s = s.replace("export function befuelleTechnik(", zusatz + "\nexport function befuelleTechnik(", 1)
io.open(p, "w", encoding="utf-8").write(s)
print("Befuellung ergaenzt")
