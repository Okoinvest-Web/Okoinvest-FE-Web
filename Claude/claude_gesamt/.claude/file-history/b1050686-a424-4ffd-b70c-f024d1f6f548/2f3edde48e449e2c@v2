"use client";

import { useActionState, useState } from "react";

import { Hinweis, Meldung } from "@/components/ui";

import {
  erzeugeLastschrift,
  reicheLastschriftEin,
  storniereLastschrift,
  type LastschriftErgebnis,
} from "./lastschrift-aktionen";

/**
 * Rückmeldung mit ausklappbaren Einzelheiten.
 *
 * Die Hinweiszeilen beantworten die Frage, warum ein Beleg nicht im
 * Sammler steht - bevor sie jemand telefonisch stellt.
 */
function Rueckmeldung({ ergebnis }: { ergebnis: LastschriftErgebnis }) {
  const [offen, setOffen] = useState(false);
  const hinweise = ergebnis.hinweise ?? [];

  return (
    <Hinweis
      ton={ergebnis.ok ? "gut" : "kritisch"}
      titel={ergebnis.ok ? "Sammler erstellt" : "Nicht erstellt"}
    >
      <span className="block">{ergebnis.meldung}</span>

      {hinweise.length > 0 && (
        <>
          <button
            type="button"
            onClick={() => setOffen((w) => !w)}
            className="mt-2 text-[0.75rem] font-medium underline underline-offset-2"
          >
            {offen
              ? "Einzelheiten ausblenden"
              : `${hinweise.length} Hinweis${hinweise.length === 1 ? "" : "e"} ansehen`}
          </button>

          {offen && (
            <ul className="mt-2 space-y-1">
              {hinweise.map((h) => (
                <li key={h} className="t-mikro leading-relaxed">
                  {h}
                </li>
              ))}
            </ul>
          )}
        </>
      )}
    </Hinweis>
  );
}

/**
 * Der Lastschriftlauf.
 *
 * Ein Knopf, weil es nichts zu wählen gibt: Eingezogen wird, was offen
 * ist und wofür ein Mandat vorliegt. Eine Auswahl einzelner Belege von
 * Hand wäre schneller falsch bedient, als sie Zeit spart - und ein
 * vergessener Beleg bleibt liegen, bis jemand ihn sucht.
 */
export function Lastschriftlauf({
  einziehbar,
  summeEur,
  nichtEinziehbar,
  darfBuchen,
}: {
  einziehbar: number;
  summeEur: number;
  nichtEinziehbar: number;
  darfBuchen: boolean;
}) {
  const [ergebnis, aktion, laeuft] = useActionState<
    LastschriftErgebnis | null,
    FormData
  >(erzeugeLastschrift, null);

  if (!darfBuchen) {
    return (
      <p className="t-mikro leading-relaxed">
        Ihre Rolle erlaubt das Ansehen, nicht das Einziehen. Einen
        Lastschriftsammler erstellt die Buchhaltung oder die
        Geschäftsführung.
      </p>
    );
  }

  return (
    <div className="space-y-3">
      <form action={aktion} className="flex flex-wrap items-center gap-3">
        <button
          type="submit"
          disabled={laeuft || einziehbar === 0}
          className="knopf knopf-voll"
        >
          {laeuft ? "Wird geprüft …" : "Sammler erstellen"}
        </button>

        <span className="t-mikro">
          {einziehbar === 0
            ? "Zurzeit ist nichts einziehbar."
            : `${einziehbar} Belege über ${summeEur.toLocaleString("de-AT", {
                style: "currency",
                currency: "EUR",
              })}`}
          {nichtEinziehbar > 0
            ? ` · ${nichtEinziehbar} bleiben außen vor`
            : ""}
        </span>
      </form>

      {ergebnis && <Rueckmeldung ergebnis={ergebnis} />}
    </div>
  );
}

/** Einreichen und Stornieren eines erstellten Sammlers. */
export function Sammlersteuerung({
  laufId,
  status,
  darfBuchen,
}: {
  laufId: string;
  status: string;
  darfBuchen: boolean;
}) {
  const [eingereicht, einreichenAktion, einreichenLaeuft] = useActionState<
    LastschriftErgebnis | null,
    FormData
  >(reicheLastschriftEin, null);

  const [storniert, stornoAktion, stornoLaeuft] = useActionState<
    LastschriftErgebnis | null,
    FormData
  >(storniereLastschrift, null);

  const ergebnis = eingereicht ?? storniert;

  if (!darfBuchen) return null;

  if (status === "Eingereicht") {
    return (
      <p className="t-mikro leading-relaxed">
        Eingereicht. Die Datei bleibt abrufbar – sie ist der Nachweis
        darüber, was tatsächlich zur Bank ging.
      </p>
    );
  }

  if (status === "Storniert") {
    return (
      <p className="t-mikro leading-relaxed">
        Storniert. Die Belege sind wieder einziehbar.
      </p>
    );
  }

  return (
    <div className="space-y-3">
      <div className="flex flex-wrap items-center gap-2">
        <form action={einreichenAktion}>
          <input type="hidden" name="lauf" value={laufId} />
          <button
            type="submit"
            disabled={einreichenLaeuft || stornoLaeuft}
            className="knopf knopf-voll"
          >
            {einreichenLaeuft ? "Wird abgegeben …" : "Als eingereicht vermerken"}
          </button>
        </form>

        <a
          href={`/api/finanzen/lastschrift/${laufId}/pain008`}
          className="knopf knopf-rand"
        >
          Datei herunterladen
        </a>

        <form action={stornoAktion}>
          <input type="hidden" name="lauf" value={laufId} />
          <button
            type="submit"
            disabled={einreichenLaeuft || stornoLaeuft}
            className="knopf knopf-leise"
          >
            {stornoLaeuft ? "Wird storniert …" : "Verwerfen"}
          </button>
        </form>
      </div>

      <p className="t-mikro leading-relaxed">
        Die Datei geht über das Onlinebanking an die Bank. Erst danach wird
        hier vermerkt, dass sie abgegeben ist – ein zweimal eingereichter
        Sammler zieht zweimal ein, und das fällt beim Zahler auf, nicht
        beim Einreicher.
      </p>

      {ergebnis && (
        <Meldung ton={ergebnis.ok ? "gut" : "kritisch"}>
          {ergebnis.meldung}
        </Meldung>
      )}
    </div>
  );
}
