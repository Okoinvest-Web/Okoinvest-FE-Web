/**
 * Baut eine IBAN mit richtiger Pruefziffer.
 *
 * Nach ISO 7064 Modulo 97-10: Laenderkennung und zwei Nullen ans
 * Ende, Buchstaben zu Zahlen, Rest der Division durch 97 - und die
 * Pruefziffer ist 98 minus dieser Rest. Stueckweise gerechnet, weil
 * die Zahl sonst die Genauigkeit einer Gleitkommazahl sprengt.
 */
function baueIban(land: string, bankleitzahl: string, konto: string): string {
  const roh = `${bankleitzahl}${konto}${land}00`;

  let rest = 0;
  for (const zeichen of roh) {
    const ziffern =
      zeichen >= "A" && zeichen <= "Z"
        ? String(zeichen.charCodeAt(0) - 55)
        : zeichen;
    for (const ziffer of ziffern) {
      rest = (rest * 10 + Number(ziffer)) % 97;
    }
  }

  const pruefziffer = String(98 - rest).padStart(2, "0");
  return `${land}${pruefziffer}${bankleitzahl}${konto}`;
}

