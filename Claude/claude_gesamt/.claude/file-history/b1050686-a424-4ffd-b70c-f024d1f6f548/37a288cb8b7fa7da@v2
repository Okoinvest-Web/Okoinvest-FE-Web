import io

p = "src/lib/db/befuellen.ts"
s = io.open(p, encoding="utf-8").read()

zusatz = '''
/**
 * Abgeschlossene Quartalsabrechnungen der Energiegemeinschaft.
 *
 * Bewusst ausserhalb von `befuelleDatenbank`: Jeder Lauf fuehrt seine
 * eigene Schreibklammer, und eine Klammer innerhalb einer anderen
 * kennt die Datenbankschicht nicht.
 *
 * Die zurueckliegenden Quartale werden festgeschrieben, das laufende
 * bleibt offen - so zeigt die Oberflaeche beide Zustaende, und der
 * Lastschriftlauf hat Belege, auf die er sich stuetzen kann. Ohne
 * einen abgeschlossenen Lauf waere die halbe kaufmaennische Kette im
 * Demonstrationsbestand leer.
 */
export function befuelleGemeinschaftsabrechnungen(): {
  laeufe: number;
  belege: number;
  brutto: number;
} {
  const gemeinschaft = eine<{ id: string }>(
    "SELECT id FROM gemeinschaft ORDER BY id LIMIT 1",
  );

  let laeufe = 0;
  let belege = 0;
  let brutto = 0;

  if (!gemeinschaft) return { laeufe, belege, brutto };

  const heute = new Date();
  const laufendesQuartal = Math.floor(heute.getMonth() / 3) + 1;

  // Die beiden Quartale vor dem laufenden. Weiter zurueck reicht der
  // Lastgang nicht verlaesslich.
  for (let zurueck = 2; zurueck >= 1; zurueck -= 1) {
    let quartal = laufendesQuartal - zurueck;
    let jahr = heute.getFullYear();
    while (quartal < 1) {
      quartal += 4;
      jahr -= 1;
    }

    const { von, bis } = quartalsZeitraum(jahr, quartal);

    // Fehlen mehr als fuenf Prozent der Messwerte, waere die
    // Abrechnung nicht belastbar - dann lieber kein Lauf.
    const luecken = pruefeDatenbestand(
      gemeinschaft.id,
      messStempel(von),
      messStempel(bis),
    );
    if (luecken.some((l) => l.vorhanden < l.erwartet * 0.95)) continue;

    const id = legeLaufAn(
      gemeinschaft.id,
      von,
      bis,
      "Dynamisch",
      15,
      12,
      20,
      "Automatischer Lauf",
    );

    const ergebnis = rechneLauf(id, "Automatischer Lauf");
    const anzahl =
      ergebnis.uebersicht.anzahlRechnungen +
      ergebnis.uebersicht.anzahlGutschriften;
    if (anzahl === 0) continue;

    schreibeLaufFest(id, "Automatischer Lauf");

    laeufe += 1;
    belege += anzahl;
    brutto += ergebnis.uebersicht.summeRechnungenNetto * 1.2;
  }

  return { laeufe, belege, brutto: Number(brutto.toFixed(2)) };
}
'''

s = s + zusatz
