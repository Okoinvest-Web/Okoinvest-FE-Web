/**
 * Zaehlpunktbezeichnung zusammensetzen.
 * AT + Netzbetreiber (6) + PLZ auf 5 Stellen (1) + Laufnummer (20).
 */
function zp(netzbetreiber: string, plz: string, lauf: string): string {
  return `AT${netzbetreiber}0${plz}${lauf.padStart(20, "0")}`;
}

