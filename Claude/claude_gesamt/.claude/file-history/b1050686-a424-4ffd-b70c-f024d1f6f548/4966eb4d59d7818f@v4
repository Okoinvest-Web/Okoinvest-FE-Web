@import "tailwindcss";

/* ==================================================================
 * Designsprache
 *
 * Übernommen aus dem Auftritt von Ökovolt, damit Portal und Website
 * als ein Haus erkennbar sind. Die Größen dort sind für eine
 * Broschüre gemacht, hier stehen Betriebsdaten - deshalb bleiben
 * Farben, Formen und Bewegung gleich, die Schriftgrade werden
 * enger geführt.
 *
 * Was von dort kommt:
 *
 *  1. Das Grün als einzige Akzentfarbe. Farbe bekommt nur, was
 *     Bedeutung trägt - alles übrige ist Neutralton.
 *  2. Manrope für Überschriften, Inter für alles andere. Die
 *     Überschriften stehen fett und eng; das gibt dem Blatt einen
 *     festen Anfang, ohne laut zu werden.
 *  3. Großzügige Rundungen und ein Ring statt eines Rahmens. Ein
 *     Ring liegt außerhalb der Fläche und verschiebt deshalb nichts,
 *     wenn er beim Überfahren die Farbe wechselt.
 *  4. Eine einzige Bewegungskurve, cubic-bezier(.22, 1, .36, 1).
 * ================================================================== */

@theme {
  /* ---- Neutrale Skala ("ink") -----------------------------------
   * Kühles Grau mit leichtem Blaustich. Dieselben Werte wie auf der
   * Website, damit ein Bildschirmfoto aus dem Portal auf einer
   * Angebotsseite nicht auffällt.
   */
  --color-ink-50: #f7f8fa;
  --color-ink-100: #eef0f4;
  --color-ink-200: #dfe3ea;
  --color-ink-300: #c4cad5;
  --color-ink-400: #97a0b0;
  --color-ink-500: #6b7486;
  --color-ink-600: #4e5667;
  --color-ink-700: #394050;
  --color-ink-800: #252b37;
  --color-ink-900: #151a24;
  /* Zwei Stufen unterhalb der Website-Skala - der dunkle Modus
   * braucht Tiefe, die eine Broschüre nicht braucht. */
  --color-ink-950: #10141b;
  --color-ink-1000: #0b0e14;

  /* ---- Marke: Ökovolt-Grün -------------------------------------- */
  --color-ov-50: #f4f9ee;
  --color-ov-100: #e6f1d8;
  --color-ov-200: #cde3b1;
  --color-ov-300: #aed083;
  --color-ov-400: #8cba58;
  --color-ov-500: #669933;
  --color-ov-600: #558227;
  --color-ov-700: #436621;
  --color-ov-800: #37521e;
  --color-ov-900: #2f461c;

  /* ---- Sand: der warme Untergrund -------------------------------
   * Kein reines Weiß als Seitengrund. Der leichte Sandton nimmt dem
   * Bildschirm die Härte und lässt die weißen Tafeln hervortreten.
   */
  --color-sand-50: #fbfaf6;
  --color-sand-100: #f5f3ea;

  --font-sans:
    var(--font-inter), ui-sans-serif, system-ui, -apple-system, "Segoe UI",
    sans-serif;
  --font-display:
    var(--font-manrope), var(--font-inter), ui-sans-serif, system-ui,
    sans-serif;
  --font-mono:
    ui-monospace, "SF Mono", "Cascadia Code", "Liberation Mono", monospace;

  /* ---- Bewegung --------------------------------------------------
   * Eine Kurve für alles: schnell an, sanft aus. Zwei verschiedene
   * Kurven nebeneinander fallen auf, ohne dass jemand sagen könnte,
   * warum.
   */
  --ease-aus: cubic-bezier(0.22, 1, 0.36, 1);
  --ease-weich: cubic-bezier(0.22, 1, 0.36, 1);
}

/* ==================================================================
 * Flächen und Text je Erscheinungsbild
 *
 * Beide Modi sind eigenständig gesetzt. Der dunkle ist kein
 * umgedrehter heller: Er braucht mehr Abstufungen im unteren
 * Helligkeitsbereich, weniger Buntheit und ein helleres Grün, sonst
 * verschwindet der Akzent.
 * ================================================================== */

:root {
  color-scheme: light;

  --f-grund: var(--color-sand-50);
  --f-ebene: #ffffff;
  --f-ebene-hoch: #ffffff;
  /* Eine Spur heller als ink-50. Gerechnet: Auf ink-50 erreicht die
   * Kleinschrift nur 4,42:1 und verfehlt damit die Anforderung; auf
   * diesem Ton sind es 4,54:1. */
  --f-vertieft: #fafbfc;
  --f-belegt: var(--color-ink-100);

  --linie: var(--color-ink-200);
  --linie-zart: var(--color-ink-100);
  --linie-stark: var(--color-ink-300);

  /* Die Stufen sind gerechnet, nicht nach Augenmass gewaehlt. Die
   * zarteste Stufe traegt die Kleinschrift und muss deshalb 4,5:1
   * gegen jede Flaeche halten, auf der sie vorkommt - ink-400 kam
   * auf 2,63:1 und war damit unbrauchbar. */
  --t-stark: var(--color-ink-900);
  --t-normal: var(--color-ink-700);
  --t-leise: var(--color-ink-600);
  --t-zart: var(--color-ink-500);

  --akzent: var(--color-ov-600);
  --akzent-flaeche: var(--color-ov-50);
  /* Für Text auf hellem Grund die dunklere Stufe: ov-500 erreicht
   * als Fließtext den nötigen Kontrast nicht. */
  --akzent-text: var(--color-ov-700);

  --radius-tafel: 1rem;
  --radius-kachel: 0.75rem;
  --radius-feld: 0.625rem;

  --schatten-kachel: 0 1px 2px rgb(21 26 36 / 0.04);
  --schatten-blase:
    0 1px 2px rgb(21 26 36 / 0.06), 0 8px 24px -6px rgb(21 26 36 / 0.12);
  --schatten-schublade:
    0 0 0 1px rgb(21 26 36 / 0.05), 0 24px 48px -12px rgb(21 26 36 / 0.25);
}

@media (prefers-color-scheme: dark) {
  :root {
    color-scheme: dark;

    --f-grund: var(--color-ink-1000);
    --f-ebene: var(--color-ink-950);
    --f-ebene-hoch: var(--color-ink-900);
    --f-vertieft: var(--color-ink-1000);
    --f-belegt: var(--color-ink-800);

    --linie: #232936;
    --linie-zart: #1b202b;
    --linie-stark: #2f3648;

    --t-stark: var(--color-ink-50);
    --t-normal: var(--color-ink-300);
    --t-leise: var(--color-ink-400);
    /* ink-500 erreicht auf dunklem Grund nur 3,93:1. Dieser Ton
     * liegt dazwischen und kommt auf 5,37:1. */
    --t-zart: #828b9b;

    /* Auf dunklem Grund trägt das satte Grün nicht - es wirkt dort
     * schmutzig. Zwei Stufen heller, und der Akzent steht wieder. */
    --akzent: var(--color-ov-400);
    --akzent-flaeche: #23331a;
    --akzent-text: var(--color-ov-300);

    --schatten-kachel: none;
    --schatten-blase:
      0 1px 2px rgb(0 0 0 / 0.4), 0 8px 24px -6px rgb(0 0 0 / 0.5);
    --schatten-schublade:
      0 0 0 1px rgb(255 255 255 / 0.06), 0 24px 48px -12px rgb(0 0 0 / 0.6);
  }
}

/* ==================================================================
 * Grundlagen
 * ================================================================== */

* {
  border-color: var(--linie);
}

body {
  background: var(--f-grund);
  color: var(--t-normal);
  font-family: var(--font-sans);
  font-size: 0.875rem;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

/* ==================================================================
 * Typografische Skala
 *
 * Überschriften in Manrope, fett und eng. Zahlen tabellarisch, damit
 * Spalten fluchten - eine Kennzahl, deren Ziffern wandern, liest
 * sich schlechter als eine kleinere, die steht.
 * ================================================================== */

.t-titel {
  font-family: var(--font-display);
  font-size: 1.5rem;
  line-height: 1.15;
  font-weight: 800;
  letter-spacing: -0.028em;
  color: var(--t-stark);
}

.t-abschnitt {
  font-family: var(--font-display);
  font-size: 0.9375rem;
  line-height: 1.25;
  font-weight: 700;
  letter-spacing: -0.018em;
  color: var(--t-stark);
}

.t-leise {
  font-size: 0.8125rem;
  line-height: 1.45;
  color: var(--t-leise);
}

.t-mikro {
  font-size: 0.75rem;
  line-height: 1.45;
  color: var(--t-zart);
}

.t-etikett {
  font-size: 0.6875rem;
  line-height: 1;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--t-zart);
}

/* Kennzahl: groß, eng, tabellarisch. */
.t-zahl {
  font-family: var(--font-display);
  font-size: 1.875rem;
  line-height: 1.05;
  font-weight: 800;
  letter-spacing: -0.035em;
  color: var(--t-stark);
  font-variant-numeric: tabular-nums;
}

.t-zahl-gross {
  font-family: var(--font-display);
  font-size: 2.75rem;
  line-height: 1;
  font-weight: 800;
  letter-spacing: -0.04em;
  color: var(--t-stark);
  font-variant-numeric: tabular-nums;
}

.t-zahl-klein {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--t-stark);
  font-variant-numeric: tabular-nums;
}

.zahl {
  font-variant-numeric: tabular-nums;
}

/* ==================================================================
 * Bewegung
 *
 * Kurz, einmalig, richtungsgebend. Wer reduzierte Bewegung
 * eingestellt hat, bekommt keine.
 * ================================================================== */

@keyframes erscheinen {
  from {
    opacity: 0;
    transform: translateY(0.75rem);
    filter: blur(4px);
  }
  to {
    opacity: 1;
    transform: none;
    filter: none;
  }
}

@keyframes einblenden {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes seitlich {
  from {
    opacity: 0;
    transform: translateX(-0.5rem);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

@keyframes schubladeAuf {
  from {
    transform: translateX(-100%);
  }
  to {
    transform: none;
  }
}

@keyframes atmen {
  0%,
  100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.3;
    transform: scale(0.7);
  }
}

@keyframes fliessen {
  to {
    stroke-dashoffset: -24;
  }
}

@keyframes zeichnen {
  from {
    stroke-dashoffset: var(--laenge, 2000);
  }
  to {
    stroke-dashoffset: 0;
  }
}

.a-erscheinen {
  animation: erscheinen 0.55s var(--ease-aus) both;
}

.a-einblenden {
  animation: einblenden 0.35s var(--ease-aus) both;
}

.a-seitlich {
  animation: seitlich 0.45s var(--ease-aus) both;
}

.a-atmen {
  animation: atmen 2.4s ease-in-out infinite;
}

.a-fliessen {
  stroke-dasharray: 6 6;
  animation: fliessen 1.4s linear infinite;
}

.a-zeichnen {
  stroke-dasharray: var(--laenge, 2000);
  animation: zeichnen 1.1s var(--ease-aus) both;
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* ==================================================================
 * Bedienelemente
 *
 * Einheitlich definiert, damit nicht jede Seite eigene Klassenketten
 * mitschleppt - das war der Hauptgrund, warum die Oberfläche
 * zusammengestückelt wirkte.
 * ================================================================== */

.feld {
  width: 100%;
  background: var(--f-ebene);
  border: 1px solid var(--linie);
  border-radius: var(--radius-feld);
  padding: 0.5rem 0.75rem;
  font-size: 0.8125rem;
  color: var(--t-stark);
  transition:
    border-color 0.3s var(--ease-weich),
    box-shadow 0.3s var(--ease-weich);
}

.feld::placeholder {
  color: var(--t-zart);
}

.feld:focus {
  outline: none;
  border-color: var(--akzent);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--akzent), transparent 82%);
}

.feld:disabled {
  background: var(--f-vertieft);
  color: var(--t-leise);
  cursor: not-allowed;
}

/*
 * Knöpfe sind vollständig gerundet - so hält es der Auftritt, und
 * eine runde Form unterscheidet sich auf einen Blick von den
 * eckigen Tafeln, in denen sie stehen.
 */
.knopf {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.375rem;
  border-radius: 999px;
  padding: 0.5rem 1rem;
  font-size: 0.8125rem;
  font-weight: 600;
  letter-spacing: -0.005em;
  white-space: nowrap;
  transition:
    background 0.3s var(--ease-weich),
    border-color 0.3s var(--ease-weich),
    color 0.3s var(--ease-weich),
    transform 0.3s var(--ease-weich);
}

.knopf:active:not(:disabled) {
  transform: scale(0.98);
}

.knopf:focus-visible {
  outline: 2px solid var(--akzent);
  outline-offset: 2px;
}

.knopf:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/*
 * Die eine Handlung, die gemeint ist: im Markengrün.
 *
 * Auf ov-500 erreicht weisse Schrift nur 3,40:1 und bleibt damit
 * unter der Anforderung. Der Auftritt setzt den Knopf trotzdem so;
 * hier steht er eine Stufe dunkler, dann sind es 4,56:1. Der
 * Unterschied faellt nebeneinander kaum auf - der fehlende Kontrast
 * dagegen jedem, der bei Sonnenlicht auf ein Tablet schaut.
 */
.knopf-voll {
  background: var(--color-ov-600);
  color: #ffffff;
  border: 1px solid transparent;
}

.knopf-voll:hover:not(:disabled) {
  background: var(--color-ov-700);
}

.knopf-rand {
  background: var(--f-ebene);
  color: var(--t-stark);
  border: 1px solid var(--linie);
}

.knopf-rand:hover:not(:disabled) {
  background: var(--f-vertieft);
  border-color: var(--linie-stark);
  color: var(--akzent-text);
}

.knopf-leise {
  background: transparent;
  color: var(--t-leise);
  border: 1px solid transparent;
}

.knopf-leise:hover:not(:disabled) {
  background: var(--f-belegt);
  color: var(--t-stark);
}

.knopf-warnung {
  background: transparent;
  color: #b3261e;
  border: 1px solid color-mix(in srgb, #b3261e, transparent 70%);
}

.knopf-warnung:hover:not(:disabled) {
  background: color-mix(in srgb, #b3261e, transparent 92%);
}

/* ==================================================================
 * Bildlaufleisten - schmal und zurückhaltend
 * ================================================================== */

@supports selector(::-webkit-scrollbar) {
  ::-webkit-scrollbar {
    height: 0.5rem;
    width: 0.5rem;
  }
  ::-webkit-scrollbar-thumb {
    background: var(--linie-stark);
    border-radius: 999px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: var(--t-zart);
  }
  ::-webkit-scrollbar-track {
    background: transparent;
  }
}

::selection {
  background: color-mix(in srgb, var(--akzent), transparent 78%);
  color: var(--t-stark);
}
