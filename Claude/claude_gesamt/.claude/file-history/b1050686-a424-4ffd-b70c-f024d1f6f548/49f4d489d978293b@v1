"use client";

import { useRouter, useSearchParams } from "next/navigation";
import { useState, type FormEvent } from "react";

export function LoginForm() {
  const router = useRouter();
  const searchParams = useSearchParams();
  const [fehler, setFehler] = useState<string | null>(null);
  const [laeuft, setLaeuft] = useState(false);

  async function absenden(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    setFehler(null);
    setLaeuft(true);

    const daten = new FormData(event.currentTarget);

    try {
      const antwort = await fetch("/api/auth/login", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          usr: daten.get("usr"),
          pwd: daten.get("pwd"),
        }),
      });

      if (!antwort.ok) {
        const payload = (await antwort.json().catch(() => null)) as {
          error?: string;
        } | null;
        setFehler(payload?.error ?? "Anmeldung fehlgeschlagen.");
        return;
      }

      // Ziel aus dem Proxy-Redirect uebernehmen, sonst aufs Dashboard.
      const weiter = searchParams.get("weiter");
      router.replace(weiter?.startsWith("/portal") ? weiter : "/portal");
      router.refresh();
    } catch {
      setFehler("Verbindung zum Server fehlgeschlagen.");
    } finally {
      setLaeuft(false);
    }
  }

  return (
    <form onSubmit={absenden} className="space-y-4">
      <div>
        <label
          htmlFor="usr"
          className="block text-sm font-medium text-slate-700 dark:text-slate-300"
        >
          E-Mail-Adresse
        </label>
        <input
          id="usr"
          name="usr"
          type="email"
          autoComplete="username"
          required
          className="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-slate-900 outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/30 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
        />
      </div>

      <div>
        <label
          htmlFor="pwd"
          className="block text-sm font-medium text-slate-700 dark:text-slate-300"
        >
          Passwort
        </label>
        <input
          id="pwd"
          name="pwd"
          type="password"
          autoComplete="current-password"
          required
          className="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-slate-900 outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/30 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
        />
      </div>

      {fehler && (
        <p
          role="alert"
          className="rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-700 dark:bg-rose-950 dark:text-rose-300"
        >
          {fehler}
        </p>
      )}

      <button
        type="submit"
        disabled={laeuft}
        className="w-full rounded-lg bg-emerald-600 px-4 py-2.5 font-medium text-white transition hover:bg-emerald-700 focus:ring-2 focus:ring-emerald-500/40 focus:outline-none disabled:opacity-60"
      >
        {laeuft ? "Anmelden …" : "Anmelden"}
      </button>
    </form>
  );
}
