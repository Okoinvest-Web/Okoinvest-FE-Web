"use client";

import { useRouter, useSearchParams } from "next/navigation";
import { useState, type FormEvent } from "react";

import type { DemoKonto } from "@/lib/demo/modus";

export function LoginForm({
  demoKonten,
  demoPasswort,
}: {
  demoKonten: DemoKonto[];
  demoPasswort: string;
}) {
  const router = useRouter();
  const searchParams = useSearchParams();

  const [email, setEmail] = useState("");
  const [passwort, setPasswort] = useState("");
  const [fehler, setFehler] = useState<string | null>(null);
  const [laeuft, setLaeuft] = useState(false);

  async function anmelden(email: string, passwort: string) {
    setFehler(null);
    setLaeuft(true);

    try {
      const antwort = await fetch("/api/auth/login", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ usr: email, pwd: passwort }),
      });

      if (!antwort.ok) {
        const inhalt = (await antwort.json().catch(() => null)) as {
          error?: string;
        } | null;
        setFehler(inhalt?.error ?? "Anmeldung fehlgeschlagen.");
        return;
      }

      // Ziel aus dem Proxy-Redirect uebernehmen, sonst aufs Dashboard.
      const weiter = searchParams.get("weiter");
      router.replace(weiter?.startsWith("/portal") ? weiter : "/portal");
      router.refresh();
    } catch {
      setFehler("Verbindung zum Server fehlgeschlagen.");
    } finally {
      setLaeuft(false);
    }
  }

  function absenden(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    void anmelden(email, passwort);
  }

  return (
    <div className="space-y-6">
      <form onSubmit={absenden} className="space-y-4">
        <Feld
          id="usr"
          label="E-Mail-Adresse"
          typ="email"
          autoComplete="username"
          wert={email}
          onChange={setEmail}
        />
        <Feld
          id="pwd"
          label="Passwort"
          typ="password"
          autoComplete="current-password"
          wert={passwort}
          onChange={setPasswort}
        />

        {fehler && (
          <p
            role="alert"
            className="animate-[einblenden_.2s_ease-out] rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-700 dark:bg-rose-950/60 dark:text-rose-300"
          >
            {fehler}
          </p>
        )}

        <button
          type="submit"
          disabled={laeuft}
          className="w-full rounded-lg bg-emerald-600 px-4 py-2.5 font-medium text-white transition hover:bg-emerald-700 focus-visible:ring-2 focus-visible:ring-emerald-500/50 focus-visible:outline-none disabled:opacity-60"
        >
          {laeuft ? "Anmelden …" : "Anmelden"}
        </button>
      </form>

      {demoKonten.length > 0 && (
        <div>
          <div className="mb-3 flex items-center gap-3">
            <span className="h-px flex-1 bg-slate-200 dark:bg-slate-700" />
            <span className="text-xs font-medium tracking-wide text-slate-400 uppercase">
              Demo-Zugänge
            </span>
            <span className="h-px flex-1 bg-slate-200 dark:bg-slate-700" />
          </div>

          <ul className="space-y-2">
            {demoKonten.map((konto) => (
              <li key={konto.email}>
                <button
                  type="button"
                  disabled={laeuft}
                  onClick={() => {
                    setEmail(konto.email);
                    setPasswort(demoPasswort);
                    void anmelden(konto.email, demoPasswort);
                  }}
                  className="w-full rounded-lg border border-slate-200 px-3 py-2 text-left transition hover:border-emerald-400 hover:bg-emerald-50/60 disabled:opacity-60 dark:border-slate-700 dark:hover:border-emerald-600 dark:hover:bg-emerald-950/40"
                >
                  <span className="flex items-center justify-between gap-2">
                    <span className="text-sm font-medium text-slate-800 dark:text-slate-100">
                      {konto.name}
                    </span>
                    <span className="rounded bg-slate-100 px-1.5 py-0.5 text-[11px] text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                      {konto.rollenBezeichnung}
                    </span>
                  </span>
                  <span className="mt-0.5 block text-xs text-slate-500 dark:text-slate-400">
                    {konto.beschreibung}
                  </span>
                </button>
              </li>
            ))}
          </ul>

          <p className="mt-3 text-center text-xs text-slate-400">
            Alle Demo-Zugänge verwenden das Passwort{" "}
            <code className="rounded bg-slate-100 px-1 py-0.5 font-mono text-slate-600 dark:bg-slate-800 dark:text-slate-300">
              {demoPasswort}
            </code>
          </p>
        </div>
      )}
    </div>
  );
}

function Feld({
  id,
  label,
  typ,
  autoComplete,
  wert,
  onChange,
}: {
  id: string;
  label: string;
  typ: string;
  autoComplete: string;
  wert: string;
  onChange: (wert: string) => void;
}) {
  return (
    <div>
      <label
        htmlFor={id}
        className="block text-sm font-medium text-slate-700 dark:text-slate-300"
      >
        {label}
      </label>
      <input
        id={id}
        name={id}
        type={typ}
        autoComplete={autoComplete}
        required
        value={wert}
        onChange={(e) => onChange(e.target.value)}
        className="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-slate-900 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/30 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
      />
    </div>
  );
}
