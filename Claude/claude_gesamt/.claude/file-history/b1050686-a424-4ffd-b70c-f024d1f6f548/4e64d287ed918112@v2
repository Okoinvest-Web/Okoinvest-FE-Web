import "server-only";

import { alle, eine } from "../db/verbindung.ts";
import { ausMessStempel } from "../datum.ts";
import { untersucheTag } from "../pv/befund.ts";
import type {
  Anlagenkontext,
  Tagespunkt,
  Tagesausbeute,
} from "../pv/befund.ts";

/**
 * Messwerte für die Ursachensuche.
 *
 * Der Befundapparat in `pv/befund.ts` rechnet ohne Datenbank. Hier
 * steht der Weg dorthin: Einstrahlung und Modultemperatur aus der
 * Anlagensensorik, die Wirkleistung als Summe über alle
 * Wechselrichter.
 *
 * Gespeichert wird in UTC, gerechnet wird in Ortszeit. Der
 * Befundapparat braucht die Minute des Ortstages, weil sonst jeder
 * Schatten zur falschen Stunde gemeldet wird - und weil im Oktober
 * sonst eine Stunde doppelt vorkommt.
 */

/** Der jüngste Tag, für den Messwerte vorliegen. */
export function letzterMesstag(anlageId: string): string | null {
  const zeile = eine<{ zeitpunkt: string }>(
    `SELECT MAX(zeitpunkt) AS zeitpunkt FROM sensor_messwert
      WHERE anlage_id = ?`,
    anlageId,
  );

  if (!zeile?.zeitpunkt) return null;

  const ende = ausMessStempel(zeile.zeitpunkt);
  return tagesschluessel(ende);
}

/** "2026-09-13" in Ortszeit. */
function tagesschluessel(zeitpunkt: Date): string {
  const jahr = zeitpunkt.getFullYear();
  const monat = String(zeitpunkt.getMonth() + 1).padStart(2, "0");
  const tag = String(zeitpunkt.getDate()).padStart(2, "0");
  return `${jahr}-${monat}-${tag}`;
}

/** Grenzen eines Ortstags als Messstempel in UTC. */
function tagesgrenzen(tag: string): [string, string] {
  const [jahr, monat, nummer] = tag.split("-").map(Number);
  const beginn = new Date(jahr!, (monat ?? 1) - 1, nummer ?? 1, 0, 0, 0, 0);
  const ende = new Date(jahr!, (monat ?? 1) - 1, (nummer ?? 1) + 1, 0, 0, 0, 0);

  return [
    beginn.toISOString().slice(0, 16) + "Z",
    ende.toISOString().slice(0, 16) + "Z",
  ];
}

/**
 * Die Anlagenkennwerte, gegen die gemessen wird.
 *
 * Die Wechselrichterleistung wird aus den tatsächlich eingebauten
 * Geräten summiert und nicht aus dem Stammdatenfeld gelesen: Wer ein
 * Gerät tauscht und das Feld vergisst, bekommt sonst jahrelang
 * Clipping gemeldet, das es nicht gibt.
 */
export function ladeAnlagenkontext(anlageId: string): Anlagenkontext | null {
  const anlage = eine<{
    leistung_kwp: number;
    wechselrichter_kw: number | null;
  }>(
    "SELECT leistung_kwp, wechselrichter_kw FROM anlage WHERE id = ?",
    anlageId,
  );

  if (!anlage) return null;

  const geraete = eine<{ summe: number | null }>(
    `SELECT SUM(nennleistung_kw) AS summe FROM wechselrichter
      WHERE anlage_id = ? AND aktiv = 1`,
    anlageId,
  );

  const grenze = eine<{ einspeisegrenze_kw: number | null }>(
    `SELECT einspeisegrenze_kw FROM netzanschluss WHERE anlage_id = ?`,
    anlageId,
  );

  return {
    kwp: anlage.leistung_kwp,
    wechselrichterKw:
      geraete?.summe ?? anlage.wechselrichter_kw ?? anlage.leistung_kwp,
    einspeisegrenzeKw: grenze?.einspeisegrenze_kw ?? undefined,
    intervallMinuten: 15,
  };
}

/**
 * Ein Tag in Viertelstunden.
 *
 * Die Leistung ist die Summe über alle Wechselrichter der Anlage. Für
 * die Ursachensuche auf Anlagenebene ist das richtig: Ein einzelnes
 * abgeschaltetes Gerät zeigt sich als Absenkung, und ob es eines oder
 * alle waren, klärt der Gerätevergleich - nicht der Tagesverlauf.
 */
export function ladeTagespunkte(
  anlageId: string,
  tag: string,
): Tagespunkt[] {
  const [von, bis] = tagesgrenzen(tag);

  const zeilen = alle<{
    zeitpunkt: string;
    einstrahlung: number | null;
    modultemperatur: number | null;
    leistung_kw: number | null;
  }>(
    `SELECT s.zeitpunkt,
            s.einstrahlung_w_m2 AS einstrahlung,
            s.modultemperatur,
            (SELECT SUM(m.leistung_kw)
               FROM wr_messwert m
               JOIN wechselrichter w ON w.id = m.wechselrichter_id
              WHERE w.anlage_id = s.anlage_id
                AND m.zeitpunkt = s.zeitpunkt) AS leistung_kw
       FROM sensor_messwert s
      WHERE s.anlage_id = ? AND s.zeitpunkt >= ? AND s.zeitpunkt < ?
      ORDER BY s.zeitpunkt`,
    anlageId,
    von,
    bis,
  );

  return zeilen.map((z) => {
    const zeit = ausMessStempel(z.zeitpunkt);
    return {
      minute: zeit.getHours() * 60 + zeit.getMinutes(),
      einstrahlung: z.einstrahlung ?? 0,
      modultemperatur: z.modultemperatur ?? 25,
      leistungKw: z.leistung_kw ?? 0,
    };
  });
}

/* ------------------------------------------------------------------ */
/* Ein Zeitraum, einmal gelesen                                        */
/* ------------------------------------------------------------------ */

export interface Tagesreihe {
  /** Ortstag als "2026-09-13". */
  tag: string;
  punkte: Tagespunkt[];
}

/**
 * Mehrere Tage in Viertelstunden, in einem Zug gelesen.
 *
 * Die Anlagenseite braucht denselben Zeitraum zweimal: einmal für die
 * Ausbeute je Tag und einmal für die Befunde je Tag. Zweimal gelesen
 * kostete das auf der größten Anlage eine halbe Sekunde zu viel - und
 * eine halbe Sekunde ist bei einer Seite, die jemand fünfzigmal am
 * Tag öffnet, keine Kleinigkeit.
 *
 * Gruppiert wird nach Ortstag, nicht nach UTC-Tag: Ein Messwert vom
 * 1. Oktober um 00:30 in Wien steht als 30. September 22:30 in der
 * Ablage und gehört trotzdem zum Oktober.
 */
export function ladeTagesreihen(anlageId: string, tage = 30): Tagesreihe[] {
  const grenze = eine<{ ab: string }>(
    `SELECT MIN(tag) AS ab FROM (
       SELECT DISTINCT date(zeitpunkt, '+2 hours') AS tag
         FROM sensor_messwert WHERE anlage_id = ?
        ORDER BY tag DESC LIMIT ?
     )`,
    anlageId,
    tage,
  );

  if (!grenze?.ab) return [];

  const [von] = tagesgrenzen(grenze.ab);

  const zeilen = alle<{
    zeitpunkt: string;
    einstrahlung: number | null;
    modultemperatur: number | null;
    leistung_kw: number | null;
  }>(
    `SELECT s.zeitpunkt,
            s.einstrahlung_w_m2 AS einstrahlung,
            s.modultemperatur,
            g.leistung          AS leistung_kw
       FROM sensor_messwert s
       LEFT JOIN (
         SELECT m.zeitpunkt, SUM(m.leistung_kw) AS leistung
           FROM wr_messwert m
           JOIN wechselrichter w ON w.id = m.wechselrichter_id
          WHERE w.anlage_id = ? AND m.zeitpunkt >= ?
          GROUP BY m.zeitpunkt
       ) g ON g.zeitpunkt = s.zeitpunkt
      WHERE s.anlage_id = ? AND s.zeitpunkt >= ?
      ORDER BY s.zeitpunkt`,
    anlageId,
    von,
    anlageId,
    von,
  );

  const jeTag = new Map<string, Tagespunkt[]>();

  for (const z of zeilen) {
    const zeit = ausMessStempel(z.zeitpunkt);
    const tag = tagesschluessel(zeit);

    const liste = jeTag.get(tag) ?? [];
    liste.push({
      minute: zeit.getHours() * 60 + zeit.getMinutes(),
      einstrahlung: z.einstrahlung ?? 0,
      modultemperatur: z.modultemperatur ?? 25,
      leistungKw: z.leistung_kw ?? 0,
    });
    jeTag.set(tag, liste);
  }

  return [...jeTag.entries()].map(([tag, punkte]) => ({ tag, punkte }));
}

/**
 * Ausbeute je Tag aus bereits gelesenen Reihen.
 *
 * Die Ausbeute ist die Performance Ratio nach IEC 61724: erzeugte
 * Energie geteilt durch das Produkt aus Nennleistung und
 * Einstrahlungsstunden. Tage ohne nennenswerte Einstrahlung fallen
 * heraus - eine PR aus einem Nebeltag ist eine Zahl ohne Aussage und
 * verzerrt jeden Trend.
 */
export function ausbeutenAus(
  reihen: Tagesreihe[],
  kwp: number,
): Tagesausbeute[] {
  const stunden = 0.25;

  return reihen
    .map(({ tag, punkte }) => {
      const einstrahlungKwh = punkte.reduce(
        (summe, p) => summe + (p.einstrahlung / 1000) * stunden,
        0,
      );
      const ertragKwh = punkte.reduce(
        (summe, p) => summe + p.leistungKw * stunden,
        0,
      );

      return { tag, einstrahlungKwh, ertragKwh };
    })
    .filter((t) => t.einstrahlungKwh > 1 && t.ertragKwh > 0)
    .map((t) => ({ tag: t.tag, pr: t.ertragKwh / (kwp * t.einstrahlungKwh) }))
    .sort((a, b) => a.tag.localeCompare(b.tag));
}

export interface Befundhaeufigkeit {
  art: string;
  titel: string;
  /** An wie vielen der untersuchten Tage trat der Befund auf? */
  tage: number;
  /** Summe der Verluste über alle Tage, kWh. */
  verlustKwh: number;
  mangel: boolean;
}

/**
 * Zählt, an wie vielen Tagen ein Befund auftrat.
 *
 * Ein einzelner Schattentag kostet zwanzig Kilowattstunden - das
 * klingt nach nichts. Derselbe Schatten an dreißig Tagen kostet
 * sechshundert, und im Jahr ein Vielfaches. Erst die Häufigkeit macht
 * aus einer Beobachtung eine Entscheidungsgrundlage: Ein Baum, der
 * jeden Morgen Geld kostet, wird geschnitten.
 */
export function haeufigkeitenAus(
  reihen: Tagesreihe[],
  kontext: Anlagenkontext,
): { haeufigkeiten: Befundhaeufigkeit[]; untersuchteTage: number } {
  const gesammelt = new Map<string, Befundhaeufigkeit>();

  for (const { punkte } of reihen) {
    for (const befund of untersucheTag(punkte, kontext)) {
      if (befund.art === "unauffaellig") continue;

      const eintrag = gesammelt.get(befund.art) ?? {
        art: befund.art,
        titel: befund.titel,
        tage: 0,
        verlustKwh: 0,
        mangel: befund.mangel,
      };

      eintrag.tage += 1;
      eintrag.verlustKwh += befund.verlustKwh;
      gesammelt.set(befund.art, eintrag);
    }
  }

  return {
    haeufigkeiten: [...gesammelt.values()]
      .map((h) => ({ ...h, verlustKwh: Number(h.verlustKwh.toFixed(0)) }))
      .sort((a, b) => b.verlustKwh - a.verlustKwh),
    untersuchteTage: reihen.length,
  };
}

/**
 * Arbeitspreis der Anlage in Cent je Kilowattstunde.
 *
 * Er bewertet einen Ertragsverlust: Eine fehlende Kilowattstunde ist
 * genau dann den Arbeitspreis wert, wenn sie sonst selbst verbraucht
 * worden wäre - und bei einem Gewerbebetrieb mit hohem Eigenverbrauch
 * ist das der Regelfall. Die Einspeisevergütung wäre der untere Rand
 * der Bewertung, der Arbeitspreis der obere.
 */
export function ladeArbeitspreis(anlageId: string): number | null {
  const zeile = eine<{ arbeitspreis_ct_kwh: number | null }>(
    "SELECT arbeitspreis_ct_kwh FROM netzanschluss WHERE anlage_id = ?",
    anlageId,
  );

  return zeile?.arbeitspreis_ct_kwh ?? null;
}
