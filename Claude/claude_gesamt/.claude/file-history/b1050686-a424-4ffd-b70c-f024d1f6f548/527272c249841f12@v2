/**
 * Übergabe an die Finanzbuchhaltung BMD NTCS.
 *
 * Die Plattform erzeugt Umsätze aus sehr verschiedenen Quellen -
 * Hardwareverkauf, Wartung, Ladeerlöse, Gemeinschaftsabrechnung,
 * Börsenhandel. Für die Buchhaltung sind das nicht Varianten
 * desselben, sondern unterschiedliche Erlöskonten mit
 * unterschiedlichen Steuersätzen.
 *
 * Dieses Modul kontiert und formatiert. Es bucht nicht: Was hier
 * herauskommt, geht als Stapel an den Steuerberater und wird dort
 * eingespielt. Deshalb gilt eine Regel ohne Ausnahme - ein Stapel
 * wird genau einmal übergeben. Ein zweimal eingespielter Stapel
 * verdoppelt den Umsatz, und das fällt erst bei der Umsatzsteuer-
 * voranmeldung auf.
 *
 * Rein rechnend und ohne Datenbank, damit die Kontierung prüfbar
 * bleibt.
 */

/** Woher ein Umsatz stammt. */
export type Erlosquelle =
  | "hardware"
  | "installation"
  | "wartung"
  | "laden_b2b"
  | "laden_adhoc"
  | "gemeinschaft"
  | "einspeisung"
  | "arbitrage"
  | "regelleistung"
  | "lieferant_hardware"
  | "lieferant_wartung";

export interface Kontierung {
  /** Erlös- oder Aufwandskonto. */
  konto: string;
  bezeichnung: string;
  steuersatz: number;
  /** Steuercode der Buchhaltung. */
  steuercode: string;
  /** Handelt es sich um einen Aufwand statt eines Erlöses? */
  aufwand?: boolean;
  /** Erläuterung zur steuerlichen Einordnung. */
  hinweis?: string;
}

