"use client";

import { useActionState } from "react";

import { Status } from "@/components/ui";

import { setzeParameter, type SteuerErgebnis } from "./aktionen";

export interface FeldDefinition {
  schluessel: string;
  bezeichnung: string;
  einheit?: string;
  gesperrt: boolean;
  grundlage?: string;
  hinweis?: string;
  min?: number;
  max?: number;
  optionen?: string[];
  aktuellerWert: string;
}

/**
 * Ein einzelner Steuerungsparameter.
 *
 * Gesperrte Parameter werden nicht versteckt, sondern sichtbar und
 * schreibgeschuetzt dargestellt - mit der Rechtsgrundlage daneben. Wer
 * den Wert kennen muss, sieht ihn; wer ihn aendern will, erfaehrt warum
 * das nicht geht. Das Ausblenden waere weder ehrlich noch sicherer, denn
 * die eigentliche Sperre sitzt ohnehin auf dem Server.
 */
export function ParameterFeld({
  feld,
  anlage,
  darfSchreiben,
}: {
  feld: FeldDefinition;
  anlage: string;
  darfSchreiben: boolean;
}) {
  const [ergebnis, aktion, laeuft] = useActionState<
    SteuerErgebnis | null,
    FormData
  >(setzeParameter, null);

  if (feld.gesperrt) {
    return (
      <div className="rounded-lg border border-slate-200 bg-slate-50/60 p-4 dark:border-slate-800 dark:bg-slate-800/30">
        <div className="flex flex-wrap items-start justify-between gap-2">
          <div>
            <p className="flex items-center gap-2 text-sm font-medium text-slate-800 dark:text-slate-200">
              <span aria-hidden className="text-slate-400">
                🔒
              </span>
              {feld.bezeichnung}
            </p>
            <p className="mt-1 font-mono text-sm text-slate-600 tabular-nums dark:text-slate-300">
              {feld.aktuellerWert}
              {feld.einheit && (
                <span className="ml-1 font-sans text-xs text-slate-400">
                  {feld.einheit}
                </span>
              )}
            </p>
          </div>
          <Status ton="neutral">Netzseitig vorgegeben</Status>
        </div>

        {feld.grundlage && (
          <p className="mt-3 border-t border-slate-200 pt-2.5 text-xs leading-relaxed text-slate-500 dark:border-slate-700 dark:text-slate-400">
            {feld.grundlage}
          </p>
        )}
      </div>
    );
  }

  return (
    <form
      action={aktion}
      className="rounded-lg border border-slate-200 p-4 dark:border-slate-800"
    >
      <input type="hidden" name="anlage" value={anlage} />
      <input type="hidden" name="parameter" value={feld.schluessel} />

      <label
        htmlFor={`p-${feld.schluessel}`}
        className="block text-sm font-medium text-slate-800 dark:text-slate-200"
      >
        {feld.bezeichnung}
      </label>

      {feld.hinweis && (
        <p className="mt-1 text-xs leading-relaxed text-slate-500 dark:text-slate-400">
          {feld.hinweis}
        </p>
      )}

      <div className="mt-3 flex flex-wrap items-center gap-2">
        {feld.optionen ? (
          <select
            id={`p-${feld.schluessel}`}
            name="wert"
            defaultValue={feld.aktuellerWert}
            disabled={!darfSchreiben}
            className="flex-1 rounded-lg border border-slate-300 px-3 py-2 text-sm outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/30 disabled:opacity-60 dark:border-slate-700 dark:bg-slate-950"
          >
            {feld.optionen.map((option) => (
              <option key={option} value={option}>
                {option}
              </option>
            ))}
          </select>
        ) : (
          <span className="flex flex-1 items-center gap-2">
            <input
              id={`p-${feld.schluessel}`}
              name="wert"
              type="number"
              step="any"
              min={feld.min}
              max={feld.max}
              defaultValue={feld.aktuellerWert}
              disabled={!darfSchreiben}
              className="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm tabular-nums outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/30 disabled:opacity-60 dark:border-slate-700 dark:bg-slate-950"
            />
            {feld.einheit && (
              <span className="shrink-0 text-sm text-slate-400">
                {feld.einheit}
              </span>
            )}
          </span>
        )}

        <button
          type="submit"
          disabled={laeuft || !darfSchreiben}
          className="rounded-lg bg-emerald-600 px-3.5 py-2 text-sm font-medium text-white transition hover:bg-emerald-700 disabled:opacity-50"
        >
          {laeuft ? "…" : "Übernehmen"}
        </button>
      </div>

      {feld.min !== undefined && feld.max !== undefined && (
        <p className="mt-1.5 text-xs text-slate-400">
          Zulässig: {feld.min} bis {feld.max}
          {feld.einheit ? ` ${feld.einheit}` : ""}
        </p>
      )}

      {ergebnis && (
        <p
          role="status"
          className={`mt-2.5 rounded-md px-2.5 py-1.5 text-xs leading-relaxed ${
            ergebnis.ok
              ? "bg-emerald-50 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300"
              : "bg-rose-50 text-rose-800 dark:bg-rose-950/60 dark:text-rose-300"
          }`}
        >
          {ergebnis.meldung}
        </p>
      )}
    </form>
  );
}
