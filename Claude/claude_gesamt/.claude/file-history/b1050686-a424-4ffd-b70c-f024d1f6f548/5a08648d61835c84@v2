export type Faktorschluessel = keyof typeof FAKTOREN;

export interface Nachvollziehbarkeit {
  /** Alle Positionen haben eine belegte Faktorquelle. */
  faktorenBelegt: boolean;
  /** Anteil gemessener statt geschätzter Mengen. */
  messanteil: number;
  /** Positionen, die auf Schätzung beruhen. */
  geschaetzt: string[];
  /** Für den Prüfer zusammengefasst. */
  bewertung: string;
}

/**
 * Bewertet, wie belastbar die Bilanz ist.
 *
 * Eine Wirtschaftsprüferin fragt nicht zuerst nach der Zahl, sondern
 * danach, worauf sie beruht. Eine Bilanz, die zu drei Vierteln aus
 * Schätzungen besteht, ist keine schlechtere Bilanz - sie muss es
 * nur sagen.
 */
export function pruefeNachvollziehbarkeit(
  bilanz: Bilanz,
): Nachvollziehbarkeit {
  const geschaetzt = bilanz.positionen
    .filter((p) => p.herkunft === "Geschaetzt")
    .map((p) => p.bezeichnung);

  const faktorenBelegt = bilanz.ohneQuelle === 0;

  let bewertung: string;
  if (!faktorenBelegt) {
    bewertung = `${bilanz.ohneQuelle} Position${bilanz.ohneQuelle > 1 ? "en" : ""} ohne belegte Faktorquelle. Für eine Prüfung nicht ausreichend.`;
  } else if (bilanz.messanteil >= 0.7) {
    bewertung =
      "Überwiegend auf Messwerten beruhend; die Faktoren sind durchgehend belegt.";
  } else if (bilanz.messanteil >= 0.4) {
    bewertung =
      "Teils gemessen, teils aus Belegen abgeleitet. Für die Berichterstattung tragfähig.";
  } else {
    bewertung =
      "Überwiegend aus Belegen und Schätzungen. Der Messanteil sollte erhöht werden.";
  }

  return {
    faktorenBelegt,
    messanteil: bilanz.messanteil,
    geschaetzt,
    bewertung,
  };
}
