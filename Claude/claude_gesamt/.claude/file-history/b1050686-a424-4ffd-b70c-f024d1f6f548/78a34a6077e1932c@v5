import type { ReactNode } from "react";

import { Inhaltswechsel } from "@/components/inhaltswechsel";
import { Kopfleiste } from "@/components/kopfleiste";
import { PortalNav } from "@/components/portal-nav";
import { ladeSchnellziele } from "@/lib/daten/schnellzugriff";
import { DEMO_KUNDE } from "@/lib/demo/stammdaten";
import { NAVIGATION } from "@/lib/navigation";
import { findeRolle } from "@/lib/sicherheit/rollen";
import { aktuelleRechte, requireUser } from "@/lib/session";

export default async function PortalLayout({
  children,
}: {
  children: ReactNode;
}) {
  // Serverseitige Absicherung - der Proxy prueft nur das Cookie.
  const benutzer = await requireUser();
  const rechte = await aktuelleRechte();

  // Navigation serverseitig filtern: Der Client bekommt gar nicht erst
  // zu sehen, was er nicht darf.
  const gruppen = NAVIGATION.map((gruppe) => ({
    ...gruppe,
    eintraege: gruppe.eintraege.filter((e) => rechte.has(e.recht)),
  })).filter((gruppe) => gruppe.eintraege.length > 0);

  // Der Suchindex wird ebenfalls serverseitig gefiltert. Was jemand
  // nicht sehen darf, soll er auch nicht finden - eine Suche, die
  // Treffer nennt und beim Oeffnen abweist, verraet mehr als eine,
  // die schweigt.
  const ziele = ladeSchnellziele()
    .filter((z) => rechte.has(z.recht as never))
    .map((z) => ({
      id: z.id,
      titel: z.titel,
      zusatz: z.zusatz,
      pfad: z.pfad,
      gruppe: z.gruppe,
      stichworte: z.stichworte,
    }));

  const seiten = gruppen.flatMap((gruppe) =>
    gruppe.eintraege.map((e) => ({
      pfad: e.pfad,
      label: e.label,
      gruppe: gruppe.titel,
      beschreibung: e.beschreibung,
    })),
  );

  return (
    <div className="min-h-screen">
      <PortalNav
        gruppen={gruppen}
        benutzer={benutzer.vollname}
        rollenBezeichnung={
          findeRolle(benutzer.rolle)?.bezeichnung ?? "Betrachter"
        }
        firma={DEMO_KUNDE.firma}
        demo={benutzer.demo}
      />

      <div className="lg:pl-56">
        {/*
          Der Inhalt nutzt die Breite des Schirms.
          
          Ein Leitstand steht oft auf einem grossen Monitor, und eine
          auf 1400 Pixel zentrierte Spalte laesst dort ein Drittel der
          Flaeche leer. Die Grenze bei 120 Zeichen bleibt trotzdem:
          Fliesstext ueber die volle Breite eines 27-Zoll-Schirms liest
          niemand.
        */}
        <main className="mx-auto max-w-[130rem] px-3 py-3 sm:px-4 lg:px-5">
          <Kopfleiste ziele={ziele} seiten={seiten} />
          <Inhaltswechsel>{children}</Inhaltswechsel>
        </main>
      </div>
    </div>
  );
}
