import type { ReactNode } from "react";

/**
 * Schlanke Tabelle mit horizontalem Scroll auf schmalen Bildschirmen,
 * damit die Portalseiten auch auf dem Telefon lesbar bleiben.
 */
export function Tabelle({
  spalten,
  children,
}: {
  spalten: string[];
  children: ReactNode;
}) {
  return (
    <div className="-mx-5 overflow-x-auto px-5">
      <table className="w-full min-w-[32rem] text-sm">
        <thead>
          <tr className="border-b border-slate-200 text-left dark:border-slate-800">
            {spalten.map((spalte) => (
              <th
                key={spalte}
                scope="col"
                className="py-2 pr-4 font-medium text-slate-500 dark:text-slate-400"
              >
                {spalte}
              </th>
            ))}
          </tr>
        </thead>
        <tbody className="divide-y divide-slate-100 dark:divide-slate-800">
          {children}
        </tbody>
      </table>
    </div>
  );
}

export function Zelle({
  children,
  zahl = false,
}: {
  children: ReactNode;
  zahl?: boolean;
}) {
  return (
    <td className={`py-3 pr-4 ${zahl ? "tabular-nums" : ""}`}>{children}</td>
  );
}
