import type { ReactNode } from "react";

/**
 * Schlanke Tabelle mit eigenem Querlauf auf schmalen Bildschirmen.
 * Der Seitenkoerper soll nie waagrecht scrollen - nur die Tabelle selbst.
 */
export function Tabelle({
  spalten,
  children,
  /** Spalten, die rechtsbuendig stehen (Zahlen). */
  rechts = [],
}: {
  spalten: string[];
  children: ReactNode;
  rechts?: number[];
}) {
  return (
    <div className="-mx-5 overflow-x-auto px-5">
      <table className="w-full min-w-[34rem] border-collapse text-sm">
        <thead>
          <tr className="border-b border-slate-200 dark:border-slate-800">
            {spalten.map((spalte, i) => (
              <th
                key={spalte}
                scope="col"
                className={`py-2 pr-4 font-medium text-slate-500 dark:text-slate-400 ${
                  rechts.includes(i) ? "text-right" : "text-left"
                }`}
              >
                {spalte}
              </th>
            ))}
          </tr>
        </thead>
        <tbody className="divide-y divide-slate-100 dark:divide-slate-800">
          {children}
        </tbody>
      </table>
    </div>
  );
}

export function Zeile({
  children,
  hervorgehoben = false,
}: {
  children: ReactNode;
  hervorgehoben?: boolean;
}) {
  return (
    <tr
      className={`transition-colors hover:bg-slate-50 dark:hover:bg-slate-800/40 ${
        hervorgehoben ? "bg-amber-50/50 dark:bg-amber-950/20" : ""
      }`}
    >
      {children}
    </tr>
  );
}

export function Zelle({
  children,
  zahl = false,
  gedaempft = false,
}: {
  children: ReactNode;
  zahl?: boolean;
  gedaempft?: boolean;
}) {
  return (
    <td
      className={`py-3 pr-4 align-middle ${zahl ? "text-right tabular-nums" : ""} ${
        gedaempft ? "text-slate-500 dark:text-slate-400" : ""
      }`}
    >
      {children}
    </td>
  );
}
