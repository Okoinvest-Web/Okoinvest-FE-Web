import type { ReactNode } from "react";

/**
 * Datentabelle.
 *
 * Dichter gesetzt als zuvor: In einer Betriebsanwendung zaehlt, wie
 * viele Zeilen ohne Scrollen lesbar sind. Die Kopfzeile bleibt beim
 * Scrollen stehen, Zahlenspalten fluchten durch tabellarische Ziffern.
 */

export interface Spalte {
  titel: string;
  /** Rechtsbuendig - fuer Zahlen. */
  zahl?: boolean;
  /** Auf schmalen Bildschirmen ausblenden. */
  schmalAusblenden?: boolean;
  breite?: string;
}

export function Tabelle({
  spalten,
  children,
  mindestbreite = "44rem",
}: {
  spalten: Spalte[];
  children: ReactNode;
  mindestbreite?: string;
}) {
  return (
    <div className="min-w-0 overflow-x-auto">
      <table
        className="w-full border-collapse text-[0.8125rem]"
        style={{ minWidth: mindestbreite }}
      >
        <thead>
          <tr>
            {spalten.map((spalte, i) => (
              <th
                key={`${spalte.titel}-${i}`}
                scope="col"
                className={`t-etikett sticky top-0 z-10 border-b px-4 py-2.5 whitespace-nowrap ${
                  spalte.zahl ? "text-right" : "text-left"
                } ${spalte.schmalAusblenden ? "hidden md:table-cell" : ""}`}
                style={{
                  background: "var(--f-ebene)",
                  borderColor: "var(--linie)",
                  width: spalte.breite,
                }}
              >
                {spalte.titel}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>{children}</tbody>
      </table>
    </div>
  );
}

export function Zeile({
  children,
  hervorgehoben = false,
  gedaempft = false,
}: {
  children: ReactNode;
  hervorgehoben?: boolean;
  gedaempft?: boolean;
}) {
  return (
    <tr
      className="group border-b transition-colors last:border-0"
      style={{
        borderColor: "var(--linie-zart)",
        background: hervorgehoben
          ? "color-mix(in oklch, var(--akzent), transparent 94%)"
          : undefined,
        opacity: gedaempft ? 0.55 : undefined,
      }}
    >
      {children}
    </tr>
  );
}

export function Zelle({
  children,
  zahl = false,
  leise = false,
  schmalAusblenden = false,
  einrueckung = false,
}: {
  children: ReactNode;
  zahl?: boolean;
  leise?: boolean;
  schmalAusblenden?: boolean;
  /** Fuer untergeordnete Zeilen, etwa Belegpositionen. */
  einrueckung?: boolean;
}) {
  return (
    <td
      className={`px-4 py-2.5 align-middle ${zahl ? "zahl text-right" : ""} ${
        schmalAusblenden ? "hidden md:table-cell" : ""
      } ${einrueckung ? "pl-9" : ""}`}
      style={{ color: leise ? "var(--t-leise)" : undefined }}
    >
      {children}
    </td>
  );
}

/** Zweizeilige Zelle: Hauptwert oben, Zusatz darunter. */
export function ZelleMitZusatz({
  haupt,
  zusatz,
  zahl = false,
}: {
  haupt: ReactNode;
  zusatz?: ReactNode;
  zahl?: boolean;
}) {
  return (
    <td className={`px-4 py-2 align-middle ${zahl ? "zahl text-right" : ""}`}>
      <span className="block" style={{ color: "var(--t-stark)" }}>
        {haupt}
      </span>
      {zusatz && <span className="t-mikro block">{zusatz}</span>}
    </td>
  );
}

/** Zusammenfassungszeile am Tabellenende. */
export function Summenzeile({ children }: { children: ReactNode }) {
  return (
    <tr
      className="border-t-2 font-medium"
      style={{
        borderColor: "var(--linie-stark)",
        background: "var(--f-vertieft)",
      }}
    >
      {children}
    </tr>
  );
}
