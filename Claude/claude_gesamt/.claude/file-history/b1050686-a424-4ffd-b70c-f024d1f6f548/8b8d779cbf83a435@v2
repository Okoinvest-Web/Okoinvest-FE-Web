      stand: "erfuellt",
      beleg: "Bestätigung der Geschäftsführung, keine offenen Verfahren",
    },
  ];

  for (const n of nachweise) {
    schreibe(
      `INSERT INTO taxonomie_nachweis
         (pruefung_id, kriterium, stand, beleg, geprueft_am, geprueft_von, bemerkung)
       VALUES (?, ?, ?, ?, ?, ?, ?)`,
      id,
      n.kriterium,
      n.stand,
      n.beleg ?? null,
      n.stand === "offen" ? null : `${jahr + 1}-03-18`,
      n.stand === "offen"
        ? null
        : "Mag. C. Weinberger, Nachhaltigkeitsbeauftragte",
      n.bemerkung ?? null,
    );
  }
}

