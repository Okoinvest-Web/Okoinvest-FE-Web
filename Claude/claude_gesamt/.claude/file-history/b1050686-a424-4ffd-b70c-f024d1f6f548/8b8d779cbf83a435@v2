  ];

  for (const [i, p] of positionen.entries()) {
    schreibe(
      `INSERT INTO taxonomie_position
         (id, pruefung_id, art, taetigkeit, bezeichnung, betrag, herkunft,
          konto, bemerkung)
       VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)`,
      `${id}-P${String(i + 1).padStart(3, "0")}`,
      id,
      p.art,
      p.taetigkeit,
      p.bezeichnung,
      p.betrag,
      p.herkunft,
      p.konto ?? null,
      p.bemerkung ?? null,
