export function findePunkt(schluessel: string): Freigabepunkt | undefined {
  return FREIGABEPUNKTE.find((p) => p.schluessel === schluessel);
}

/* ------------------------------------------------------------------ */
/* Prüfung                                                             */
/* ------------------------------------------------------------------ */

export interface Geraetestand {
  rolle: Geraeterolle;
  hersteller: string;
  modell: string;
  seriennummer: string | null;
  firmware: string | null;
  secureBoot: boolean;
  /** Nummer der Netzzone, in der das Gerät liegt. */
  vlanNummer: number | null;
  /** Zweck der Zone - "Büro" und "Gast" sind keine Betriebstechnik. */
  vlanZweck: string | null;
  zertifikatBis: Date | null;
  sollstandVersiegelt: boolean;
  inProtokollkette: boolean;
  /** Wie der Fernzugang hergestellt wird. */
  fernzugang: "Zero-Trust" | "Portweiterleitung" | "keiner" | null;
}

export interface Punktbefund {
  punkt: Freigabepunkt;
  stand: Punktstand;
  /** Ob der Punkt für dieses Gerät verbindlich ist. */
  verbindlich: boolean;
  /** Was konkret vorliegt. */
  befund: string;
}

export type Freigabe = "erteilt" | "verweigert" | "offen";

export interface Freigabebefund {
  freigabe: Freigabe;
  punkte: Punktbefund[];
  begruendung: string;
}

/** Zonen, die keine Betriebstechnik führen. */
const FREMDE_ZONEN = ["büro", "buero", "gast", "office", "verwaltung"];

function tageBis(ziel: Date, heute: Date): number {
  return Math.round(
    (new Date(ziel.getFullYear(), ziel.getMonth(), ziel.getDate()).getTime() -
      new Date(
        heute.getFullYear(),
        heute.getMonth(),
        heute.getDate(),
      ).getTime()) /
      86_400_000,
  );
}

/**
 * Prüft ein Gerät gegen die Punkte der Freigabe.
 *
 * Nicht jeder Punkt gilt für jedes Gerät: Ein Switch führt keinen
 * versiegelten Sollstand, und viele Industrie-Switches können kein
 * Secure Boot. Diese Punkte werden dann nicht verschwiegen, sondern
 * als nicht verbindlich geführt - sonst stünde bei jedem Switch eine
 * rote Zeile, und rote Zeilen, die immer dastehen, liest niemand.
 */
export function pruefeFreigabe(
  stand: Geraetestand,
  heute: Date,
): Freigabebefund {
  const punkte: Punktbefund[] = [];

  const nimm = (
    schluessel: string,
    ergebnis: Punktstand,
    befund: string,
    verbindlich = true,
  ) => {
    const punkt = findePunkt(schluessel);
    if (punkt) {
      punkte.push({ punkt, stand: ergebnis, verbindlich, befund });
    }
  };

  /* ---------- Kennung ---------- */

  nimm(
    "identitaet",
    stand.seriennummer?.trim() ? "erfuellt" : "offen",
    stand.seriennummer?.trim()
      ? `${stand.hersteller} ${stand.modell}, Seriennummer ${stand.seriennummer}`
      : "Keine Seriennummer erfasst.",
  );

  /* ---------- Firmware ---------- */

  const mindest = MINDESTFIRMWARE[stand.modell];

  if (!stand.firmware?.trim()) {
    nimm("firmware", "offen", "Kein Firmwarestand erfasst.");
  } else if (!mindest) {
    nimm(
      "firmware",
      "offen",
      `Für ${stand.modell} ist kein Mindeststand festgelegt; ${stand.firmware} lässt sich nicht beurteilen.`,
    );
  } else if (vergleicheVersion(stand.firmware, mindest) < 0) {
    nimm(
      "firmware",
      "verletzt",
      `${stand.firmware} liegt unter dem festgelegten Mindeststand ${mindest}.`,
    );
  } else {
    nimm("firmware", "erfuellt", `${stand.firmware}, Mindeststand ${mindest}.`);
  }

  /* ---------- Secure Boot ---------- */

  const bootPflicht = SECURE_BOOT_PFLICHT.includes(stand.rolle);
  nimm(
    "secure-boot",
    stand.secureBoot ? "erfuellt" : "verletzt",
    stand.secureBoot
      ? "Aktiv."
      : bootPflicht
        ? "Nicht aktiv."
        : `Nicht aktiv. Für die Rolle ${stand.rolle} nicht verbindlich - viele Geräte dieser Art können es nicht.`,
    bootPflicht,
  );

  /* ---------- Netzzone ---------- */

  const zweck = (stand.vlanZweck ?? "").toLowerCase();
  const fremd = FREMDE_ZONEN.some((z) => zweck.includes(z));

  if (stand.vlanNummer === null) {
    nimm("netzzone", "offen", "Keiner Netzzone zugeordnet.");
  } else if (fremd) {
    nimm(
      "netzzone",
      "verletzt",
      `Liegt in VLAN ${stand.vlanNummer} (${stand.vlanZweck}) - das ist keine Zone der Betriebstechnik.`,
    );
  } else {
    nimm(
      "netzzone",
      "erfuellt",
      `VLAN ${stand.vlanNummer}${stand.vlanZweck ? ` (${stand.vlanZweck})` : ""}.`,
    );
  }

  /* ---------- Zertifikat ---------- */

  if (!stand.zertifikatBis || Number.isNaN(stand.zertifikatBis.getTime())) {
    nimm("zertifikat", "offen", "Kein Zertifikat hinterlegt.");
  } else {
    const tage = tageBis(stand.zertifikatBis, heute);

    if (tage < 0) {
      nimm("zertifikat", "verletzt", `Abgelaufen seit ${Math.abs(tage)} Tagen.`);
    } else if (tage <= ZERTIFIKAT_VORLAUF_TAGE) {
      nimm(
        "zertifikat",
        "verletzt",
        `Läuft in ${tage} Tagen ab. Eine Inbetriebnahme mit einem Zertifikat, das im ersten Monat abläuft, erzeugt den ersten Ausfall selbst.`,
      );
    } else {
      nimm("zertifikat", "erfuellt", `Gültig noch ${tage} Tage.`);
    }
  }

  /* ---------- Sollstand ---------- */

  const sollPflicht = SOLLSTAND_PFLICHT.includes(stand.rolle);
  nimm(
    "sollstand",
    stand.sollstandVersiegelt ? "erfuellt" : sollPflicht ? "offen" : "erfuellt",
    stand.sollstandVersiegelt
      ? "Versiegelter Sollstand hinterlegt."
      : sollPflicht
        ? "Kein versiegelter Sollstand hinterlegt."
        : `Für die Rolle ${stand.rolle} nicht erforderlich.`,
    sollPflicht,
  );

  /* ---------- Protokollkette ---------- */

  nimm(
    "protokollkette",
    stand.inProtokollkette ? "erfuellt" : "offen",
    stand.inProtokollkette
      ? "Eintrag vorhanden."
      : "Kein Eintrag zur Inbetriebnahme.",
  );

  /* ---------- Fernzugang ---------- */

  if (stand.fernzugang === null) {
    nimm("fernzugang", "offen", "Nicht erfasst.");
  } else if (stand.fernzugang === "Portweiterleitung") {
    nimm(
      "fernzugang",
      "verletzt",
      "Eingehende Portweiterleitung aus dem Internet.",
    );
  } else {
    nimm(
      "fernzugang",
      "erfuellt",
      stand.fernzugang === "keiner"
        ? "Kein Fernzugang eingerichtet."
        : "Zugriff ausschließlich über den Zugangsdienst.",
    );
  }

  /* ---------- Ergebnis ---------- */

  const verletzt = punkte.filter((p) => p.verbindlich && p.stand === "verletzt");
  const offen = punkte.filter((p) => p.verbindlich && p.stand === "offen");

  if (verletzt.length > 0) {
    return {
      freigabe: "verweigert",
      punkte,
      begruendung: `${verletzt.length === 1 ? "Ein verbindlicher Punkt ist" : `${verletzt.length} verbindliche Punkte sind`} verletzt: ${verletzt
        .map((p) => p.punkt.titel)
        .join(", ")}.`,
    };
  }

  if (offen.length > 0) {
    return {
      freigabe: "offen",
      punkte,
      begruendung: `${offen.length === 1 ? "Eine Angabe fehlt" : `${offen.length} Angaben fehlen`} noch: ${offen
        .map((p) => p.punkt.titel)
        .join(", ")}. Bis dahin ist das Gerät weder freigegeben noch abgelehnt.`,
    };
  }

  return {
    freigabe: "erteilt",
    punkte,
    begruendung: "Alle verbindlichen Punkte sind erfüllt.",
  };
}

/** Kurzfassung über einen ganzen Bestand. */
export function fasseFreigabenZusammen(
  befunde: { geraet: string; befund: Freigabebefund }[],
): string {
  const verweigert = befunde.filter((b) => b.befund.freigabe === "verweigert");
  const offen = befunde.filter((b) => b.befund.freigabe === "offen");

  if (verweigert.length > 0) {
    return `${verweigert.length} von ${befunde.length} Geräten erfüllen die Freigabe nicht.`;
  }

  if (offen.length > 0) {
    return `Zu ${offen.length} von ${befunde.length} Geräten fehlen Angaben für die Freigabe.`;
  }

  return `Alle ${befunde.length} Geräte sind freigegeben.`;
}
