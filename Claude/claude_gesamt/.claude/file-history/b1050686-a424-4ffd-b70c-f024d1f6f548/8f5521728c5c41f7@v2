/**
 * Freigabe eines Geräts zur Inbetriebnahme.
 *
 * Ein Gateway, das ans Netz geht, bevor es geprüft ist, bleibt
 * jahrelang so, wie es an dem Tag war. Die Fernwartungsfreigabe „nur
 * für die Inbetriebnahme“ ist drei Jahre später noch offen, die
 * Firmware von damals hat inzwischen bekannte Lücken, und niemand
 * erinnert sich, warum das Gerät im Büro-VLAN hängt.
 *
 * Deshalb steht vor dem Betrieb eine Freigabe, und deshalb steht sie
 * hier und nicht in einem Formular: Was verbindlich ist, entscheidet
 * nicht die Oberfläche.
 *
 * Drei Ergebnisse, nicht zwei. Zwischen „erteilt“ und „verweigert“
 * liegt „offen“ - der Fall, in dem eine Angabe fehlt. Ein Gerät ohne
 * erfassten Firmwarestand ist nicht sicher und nicht unsicher; es ist
 * unbekannt, und unbekannt gehört nicht in Betrieb.
 *
 * Hintergrund: NIS2 verlangt vom Betreiber ein gepflegtes
 * Anlagenverzeichnis, Zugriffskontrolle und Schwachstellenbehandlung.
 * Diese Liste ist die Stelle, an der beides zusammenkommt.
 */

/* ------------------------------------------------------------------ */
/* Versionen                                                           */
/* ------------------------------------------------------------------ */

/**
 * Vergleicht zwei Versionsangaben.
 *
 * Zeichenweise zu vergleichen ginge daneben: "7.9.1" wäre dann größer
 * als "7.14.2", weil "9" nach "1" kommt. Verglichen wird deshalb
 * Abschnitt für Abschnitt als Zahl.
 *
 * Rückgabe: negativ, wenn `a` älter ist; 0 bei Gleichstand.
 */
export function vergleicheVersion(a: string, b: string): number {
  const teile = (v: string) =>
    v
      .trim()
      .split(/[.\-_]/)
      // Ein vorangestelltes "v" ist verbreitet und traegt keine
      // Bedeutung; alles andere Nichtnumerische zaehlt als null.
      .map((t) => Number.parseInt(t.replace(/^v/i, ""), 10))
      .map((n) => (Number.isFinite(n) ? n : 0));

  const links = teile(a);
  const rechts = teile(b);
  const laenge = Math.max(links.length, rechts.length);

  for (let i = 0; i < laenge; i += 1) {
    const unterschied = (links[i] ?? 0) - (rechts[i] ?? 0);
    if (unterschied !== 0) return unterschied;
  }

  return 0;
}

/**
 * Mindeststände der Firmware.
 *
 * Der Betreiber legt sie fest, üblicherweise anhand der
 * Sicherheitshinweise des Herstellers. Sie stehen hier und nicht im
 * Gerätedatensatz, weil sie für den ganzen Bestand gelten - sonst
 * trägt jedes Gerät seinen eigenen Maßstab, und der Bestand lässt
 * sich nicht mehr als Ganzes beurteilen.
 *
 * Ein Modell, das hier nicht steht, wird nicht als gut bewertet,
 * sondern als unbekannt.
 */
export const MINDESTFIRMWARE: Record<string, string> = {
  "Niagara JACE 9000": "4.14.0",
  RUT142: "7.14.0",
  RUT956: "7.14.0",
  TRB256: "7.14.0",
  TSW202: "1.6.0",
  TRB143: "7.13.0",
};

/* ------------------------------------------------------------------ */
/* Punkte der Freigabe                                                 */
/* ------------------------------------------------------------------ */

export type Punktstand = "erfuellt" | "verletzt" | "offen";

export type Geraeterolle =
  | "Steuerung"
  | "Gateway"
  | "Switch"
  | "Umsetzer"
  | "HMI";

export interface Freigabepunkt {
  schluessel: string;
  titel: string;
  /** Ohne diesen Punkt gibt es keine Freigabe. */
  verbindlich: boolean;
  anforderung: string;
  grundlage: string;
  /** Was geschieht, wenn er übergangen wird. */
  folge: string;
}

/** Rollen, für die Secure Boot verbindlich ist. */
const SECURE_BOOT_PFLICHT: Geraeterolle[] = ["Steuerung", "Gateway"];

/** Rollen, die einen versiegelten Sollstand führen müssen. */
const SOLLSTAND_PFLICHT: Geraeterolle[] = ["Steuerung"];

/** Tage Restlaufzeit, unter denen ein Zertifikat als knapp gilt. */
export const ZERTIFIKAT_VORLAUF_TAGE = 30;

