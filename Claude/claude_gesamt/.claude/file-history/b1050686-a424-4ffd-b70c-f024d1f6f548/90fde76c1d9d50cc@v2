"use client";

import { useActionState, useState } from "react";

import { Meldung } from "@/components/ui";
import { LAENDER, type Regelart } from "@/lib/ot/regel";

import {
  legeRegelAn,
  schalteRegel,
  verteileSperrliste,
  type AbwehrErgebnis,
} from "./aktionen";

/**
 * Was zu einer Regelart einzugeben ist.
 *
 * Die Eingabe folgt der Art, nicht umgekehrt: Eine Geosperre bekommt
 * eine Länderliste, eine Ratenbegrenzung ein Zahlenfeld, eine
 * Freigabe ein Textfeld mit Beispiel. Ein Feld, in das alles passt,
 * nimmt auch alles - und dann steht "nicht-EU" in einer Spalte, die
 * einen Ländercode erwartet.
 */
const ARTEN: {
  art: Regelart;
  titel: string;
  erklaerung: string;
  wirkung: string;
}[] = [
  {
    art: "Geosperre",
    titel: "Geosperre",
    erklaerung:
      "Weist Zugriffe nach Herkunftsland ab, bevor sie das Gateway erreichen.",
    wirkung: "blockieren",
  },
  {
    art: "Ratenbegrenzung",
    titel: "Ratenbegrenzung",
    erklaerung:
      "Begrenzt Anfragen je Minute und Quelladresse. Der übliche Schutz gegen das Durchprobieren von Kennwörtern.",
    wirkung: "begrenzen",
  },
  {
    art: "Subnetzfreigabe",
    titel: "Subnetzfreigabe",
    erklaerung:
      "Lässt einen Adressbereich zum Tunnelaufbau zu. Die einzige Regelart, die etwas öffnet – deshalb die engste Prüfung.",
    wirkung: "erlauben",
  },
];

function Rueckmeldung({ ergebnis }: { ergebnis: AbwehrErgebnis }) {
  const zeilen = [
    ...(ergebnis.beanstandungen ?? []),
    ...(ergebnis.warnungen ?? []),
  ];

  return (
    <Meldung ton={ergebnis.ok ? "gut" : "kritisch"}>
      <span className="block">{ergebnis.meldung}</span>
      {zeilen.length > 0 && (
        <ul className="mt-1.5 space-y-1">
          {zeilen.map((z) => (
            <li key={z} className="t-mikro leading-relaxed">
              {z}
            </li>
          ))}
        </ul>
      )}
    </Meldung>
  );
}

/**
 * Formular für eine neue Perimeterregel.
 *
 * Die Regel entsteht zurückgenommen und wird erst in einem zweiten
 * Schritt scharf geschaltet - die einzige Gelegenheit, sie im
 * Zusammenhang zu lesen, bevor sie wirkt.
 */
export function Regelformular({
  anlagen,
  darfVerwalten,
}: {
  anlagen: { id: string; bezeichnung: string }[];
  darfVerwalten: boolean;
}) {
  const [ergebnis, aktion, laeuft] = useActionState<
    AbwehrErgebnis | null,
    FormData
  >(legeRegelAn, null);

  /*
   * Alle Felder liegen im Zustand, nicht im Formular.
   *
   * React setzt ein Formular nach einer Serveraktion zurueck. Bei
   * einer abgewiesenen Regel waere damit auch die Eingabe weg - und
   * wer gerade erfahren hat, dass sein Praefix zu weit ist, muesste
   * Adressbereich und Bezeichnung neu tippen, um ein Zeichen zu
   * aendern. Zustandsgefuehrte Felder ueberstehen die Antwort.
   */
  const [art, setArt] = useState<Regelart>("Geosperre");
  const [wert, setWert] = useState("");
  const [bezeichnung, setBezeichnung] = useState("");
  const [anlage, setAnlage] = useState("");

  const gewaehlt = ARTEN.find((a) => a.art === art)!;

  /** Beim Wechsel der Art passt der alte Wert nicht mehr. */
  function wechsleArt(neueArt: Regelart) {
    setArt(neueArt);
    setWert(neueArt === "Ratenbegrenzung" ? "60" : "");
  }

  if (!darfVerwalten) {
    return (
      <p className="t-mikro leading-relaxed">
        Das Regelwerk ist einsehbar, aber nur die Sicherheitsverwaltung
        legt Regeln an. Eine Freigabe, die jeder setzen kann, ist keine.
      </p>
    );
  }

  return (
    <div className="space-y-3">
      <form action={aktion} className="space-y-3">
        <div className="grid grid-cols-1 gap-3 sm:grid-cols-3">
          <div className="min-w-0">
            <label htmlFor="regel-art" className="t-etikett mb-1 block">
              Art
            </label>
            <select
              id="regel-art"
              name="art"
              value={art}
              onChange={(e) => wechsleArt(e.target.value as Regelart)}
              className="feld"
            >
              {ARTEN.map((a) => (
                <option key={a.art} value={a.art}>
                  {a.titel}
                </option>
              ))}
            </select>
          </div>

          <div className="min-w-0">
            <label htmlFor="regel-wert" className="t-etikett mb-1 block">
              {art === "Geosperre"
                ? "Herkunftsland"
                : art === "Ratenbegrenzung"
                  ? "Anfragen je Minute"
                  : "Adressbereich"}
            </label>

            {art === "Geosperre" ? (
              <select
                id="regel-wert"
                name="wert"
                value={wert || "RU"}
                onChange={(e) => setWert(e.target.value)}
                className="feld"
              >
                {LAENDER.filter((l) => l.code !== "AT").map((l) => (
                  <option key={l.code} value={l.code}>
                    {l.name} ({l.code})
                  </option>
                ))}
              </select>
            ) : art === "Ratenbegrenzung" ? (
              <input
                id="regel-wert"
                name="wert"
                type="number"
                min={1}
                max={10000}
                value={wert || "60"}
                onChange={(e) => setWert(e.target.value)}
                className="feld"
              />
            ) : (
              <input
                id="regel-wert"
                name="wert"
                type="text"
                value={wert}
                onChange={(e) => setWert(e.target.value)}
                placeholder="193.154.28.0/24"
                className="feld"
              />
            )}
          </div>

          <div className="min-w-0">
            <label htmlFor="regel-anlage" className="t-etikett mb-1 block">
              Gilt für
            </label>
            <select
              id="regel-anlage"
              name="anlage"
              value={anlage}
              onChange={(e) => setAnlage(e.target.value)}
              className="feld"
            >
              <option value="">Alle Anlagen</option>
              {anlagen.map((a) => (
                <option key={a.id} value={a.id}>
                  {a.bezeichnung}
                </option>
              ))}
            </select>
          </div>
        </div>

        <div className="min-w-0">
          <label htmlFor="regel-bez" className="t-etikett mb-1 block">
            Bezeichnung
          </label>
          <input
            id="regel-bez"
            name="bezeichnung"
            type="text"
            required
            minLength={3}
            value={bezeichnung}
            onChange={(e) => setBezeichnung(e.target.value)}
            placeholder="Etwa: Leitwarte Sägewerk, Zugriff über Standleitung"
            className="feld"
          />
        </div>

        <div className="flex flex-wrap items-center gap-2">
          <button type="submit" disabled={laeuft} className="knopf knopf-voll">
            {laeuft ? "Wird geprüft …" : "Regel anlegen"}
          </button>
          <span className="t-mikro">
            Wirkung: {gewaehlt.wirkung}. Die Regel ist nach dem Anlegen noch
            nicht scharf.
          </span>
        </div>
      </form>

      <p className="t-mikro leading-relaxed">{gewaehlt.erklaerung}</p>

      {ergebnis && <Rueckmeldung ergebnis={ergebnis} />}
    </div>
  );
}

/** Scharfschalten und Zurücknehmen einer einzelnen Regel. */
export function Regelschalter({
  regelId,
  aktiv,
  bezeichnung,
  darfVerwalten,
}: {
  regelId: string;
  aktiv: boolean;
  bezeichnung: string;
  darfVerwalten: boolean;
}) {
  const [ergebnis, aktion, laeuft] = useActionState<
    AbwehrErgebnis | null,
    FormData
  >(schalteRegel, null);

  if (!darfVerwalten) return null;

  return (
    <form action={aktion} className="flex flex-col items-start gap-1">
      <input type="hidden" name="regel" value={regelId} />
      <input type="hidden" name="aktiv" value={aktiv ? "0" : "1"} />
      <button
        type="submit"
        disabled={laeuft}
        className={`knopf ${aktiv ? "knopf-leise" : "knopf-rand"}`}
        aria-label={`${bezeichnung} ${aktiv ? "zurücknehmen" : "scharf schalten"}`}
      >
        {laeuft ? "…" : aktiv ? "Zurücknehmen" : "Scharf schalten"}
      </button>

      {ergebnis && !ergebnis.ok && (
        <span className="t-mikro">{ergebnis.meldung}</span>
      )}
    </form>
  );
}

/** Verteilung einer Sperrliste an die Gateways anstoßen. */
export function Verteilungsknopf({
  listeId,
  offen,
  darfVerwalten,
}: {
  listeId: string;
  offen: number;
  darfVerwalten: boolean;
}) {
  const [ergebnis, aktion, laeuft] = useActionState<
    AbwehrErgebnis | null,
    FormData
  >(verteileSperrliste, null);

  if (!darfVerwalten || offen === 0) return null;

  return (
    <form action={aktion} className="flex flex-col items-start gap-1">
      <input type="hidden" name="liste" value={listeId} />
      <button type="submit" disabled={laeuft} className="knopf knopf-rand">
        {laeuft
          ? "Wird verteilt …"
          : `${offen} Gateway${offen === 1 ? "" : "s"} nachziehen`}
      </button>

      {ergebnis && <span className="t-mikro">{ergebnis.meldung}</span>}
    </form>
  );
}
