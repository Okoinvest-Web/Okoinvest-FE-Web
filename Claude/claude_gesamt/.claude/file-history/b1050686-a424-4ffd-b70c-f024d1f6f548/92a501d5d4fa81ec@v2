"use client";

import { useActionState, useState } from "react";

import { FREIGABE_DAUERN, gibZugangFrei, type ZugangErgebnis } from "./aktionen";

const FELD =
  "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/30 dark:border-slate-700 dark:bg-slate-950";

/**
 * Befristete Freigabe eines Fernwartungszugangs.
 *
 * Techniker, Grund und Dauer sind Pflichtangaben. Sie stehen spaeter im
 * Protokoll - und genau diese drei Angaben fehlen erfahrungsgemaess,
 * wenn im Nachhinein geklaert werden soll, wer wann was getan hat.
 */
export function FreigabeFormular({
  zugang,
  geraet,
  darfFreigeben,
}: {
  zugang: string;
  geraet: string;
  darfFreigeben: boolean;
}) {
  const [offen, setOffen] = useState(false);
  const [ergebnis, aktion, laeuft] = useActionState<
    ZugangErgebnis | null,
    FormData
  >(gibZugangFrei, null);

  if (!darfFreigeben) {
    return (
      <p className="text-xs text-slate-500 dark:text-slate-400">
        Die Freigabe eines Fernzugangs ist der technischen Leitung vorbehalten.
      </p>
    );
  }

  if (ergebnis?.ok) {
    return (
      <p
        role="status"
        className="rounded-lg bg-emerald-50 px-3 py-2 text-xs leading-relaxed text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300"
      >
        {ergebnis.meldung}
      </p>
    );
  }

  if (!offen) {
    return (
      <button
        type="button"
        onClick={() => setOffen(true)}
        className="rounded-lg border border-emerald-300 px-3 py-1.5 text-sm font-medium text-emerald-700 transition hover:bg-emerald-50 dark:border-emerald-800 dark:text-emerald-300 dark:hover:bg-emerald-950/40"
      >
        Zugang freigeben
      </button>
    );
  }

  return (
    <form
      action={aktion}
      className="rounded-lg border border-slate-300 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-800/40"
    >
      <input type="hidden" name="zugang" value={zugang} />

      <p className="mb-3 text-xs text-slate-500 dark:text-slate-400">
        Freigabe für <strong className="font-medium">{geraet}</strong>. Alle
        Angaben werden protokolliert.
      </p>

      <div className="grid gap-3 sm:grid-cols-2">
        <label className="block">
          <span className="text-xs font-medium text-slate-700 dark:text-slate-300">
            Techniker
          </span>
          <input name="techniker" required minLength={3} className={FELD} />
        </label>

        <label className="block">
          <span className="text-xs font-medium text-slate-700 dark:text-slate-300">
            Firma
          </span>
          <input name="firma" className={FELD} />
        </label>

        <label className="block sm:col-span-2">
          <span className="text-xs font-medium text-slate-700 dark:text-slate-300">
            Grund des Zugriffs
          </span>
          <input
            name="grund"
            required
            minLength={10}
            placeholder="z. B. Fehlersuche Wechselrichter 2, Störung STOE-0007"
            className={FELD}
          />
        </label>

        <label className="block">
          <span className="text-xs font-medium text-slate-700 dark:text-slate-300">
            Freigabedauer
          </span>
          <select name="dauer" defaultValue="4" className={FELD}>
            {FREIGABE_DAUERN.map((stunden) => (
              <option key={stunden} value={stunden}>
                {stunden} Stunden
              </option>
            ))}
          </select>
        </label>
      </div>

      {ergebnis && !ergebnis.ok && (
        <p
          role="alert"
          className="mt-2.5 rounded-md bg-rose-50 px-2.5 py-1.5 text-xs text-rose-800 dark:bg-rose-950/60 dark:text-rose-300"
        >
          {ergebnis.meldung}
        </p>
      )}

      <div className="mt-3 flex flex-wrap gap-2">
        <button
          type="submit"
          disabled={laeuft}
          className="rounded-lg bg-emerald-600 px-3.5 py-2 text-sm font-medium text-white transition hover:bg-emerald-700 disabled:opacity-60"
        >
          {laeuft ? "Wird freigegeben …" : "Befristet freigeben"}
        </button>
        <button
          type="button"
          onClick={() => setOffen(false)}
          className="rounded-lg border border-slate-300 px-3.5 py-2 text-sm text-slate-600 transition hover:bg-white dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-800"
        >
          Abbrechen
        </button>
      </div>
    </form>
  );
}
