/**
 * Datenzugriff fuer den Portalbereich.
 *
 * Jede Funktion hat zwei Wege: den Demonstrationsbetrieb mit
 * Beispieldaten und den Regelbetrieb gegen Frappe. Die Seiten sehen
 * davon nichts - sie bekommen in beiden Faellen dieselben Typen.
 *
 * Im Regelbetrieb wird bewusst NICHT nach Kunde gefiltert: Frappe wendet
 * die Berechtigungen des angemeldeten Benutzers serverseitig an. Die
 * Zuordnung "Benutzer sieht nur seine Anlagen" gehoert als User
 * Permission nach Frappe - ein Filter hier waere nur Kosmetik.
 */

export async function ladeAnlagen(limit = 50): Promise<PvAnlage[]> {
  if (istDemoModus()) return demo.anlagen();

  return getList<PvAnlage>(DOCTYPE.anlage, {
    fields: [
      "name",
      "anlagen_name",
      "kunde",
      "standort",
      "plz",
      "ort",
      "zaehlpunkt",
      "netzbetreiber",
      "netzebene",
      "tor_typ",
      "leistung_kwp",
      "speicher_kwh",
      "inbetriebnahme",
      "status",
      "soll_ertrag_kwh",
    ],
    orderBy: "anlagen_name asc",
    limit,
  });
}

export async function ladeAnlage(name: string): Promise<PvAnlage | null> {
  if (istDemoModus()) return demo.anlage(name);

  const treffer = await getList<PvAnlage>(DOCTYPE.anlage, {
    filters: [["name", "=", name]],
    limit: 1,
  });
  return treffer[0] ?? null;
}

