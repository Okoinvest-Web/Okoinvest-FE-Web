export async function zaehleOffeneStoerungen(): Promise<number> {
  if (istDemoModus()) {
    return demo
      .stoerungen()
      .filter((s) => s.status !== "Geschlossen").length;
  }

  return getCount(DOCTYPE.stoerung, [["status", "!=", "Geschlossen"]]);
}
