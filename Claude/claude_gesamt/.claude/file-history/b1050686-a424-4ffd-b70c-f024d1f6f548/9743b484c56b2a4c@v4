import Link from "next/link";
import { notFound } from "next/navigation";

import { IconPfeilLinks, IconPfeilRechts } from "@/components/icon";
import { Tabelle, Summenzeile, Zeile, Zelle } from "@/components/tabelle";
import {
  Angabe,
  Hinweis,
  Kennzahl,
  Kennzahlenleiste,
  LeerZustand,
  Seitenkopf,
  Status,
  Tafel,
} from "@/components/ui";
import { kuerzeZaehlpunkt } from "@/lib/at/zaehlpunkt";
import {
  ladeBelege,
  ladeGemeinschaft,
  ladeLauf,
  ladeMeldungsuebersicht,
} from "@/lib/daten/eeg";
import { erwarteteIntervalle } from "@/lib/eeg/messmeldung";
import { ausMessStempel } from "@/lib/datum";
import { findeNetzbetreiber } from "@/lib/at/netzbetreiber";
import { NETZ_ARBEITSPREIS_CT, NETZRABATT } from "@/lib/eeg/abrechnung";
import {
  formatDatum,
  formatDatumZeit,
  formatEnergie,
  formatGeld,
  formatProzent,
  formatZahl,
} from "@/lib/format";
import { hatRecht } from "@/lib/sicherheit/rollen";
import { requireRecht } from "@/lib/session";

import { LaufAktionen } from "./aktionen-leiste";

export default async function LaufSeite({
  params,
}: {
  params: Promise<{ lauf: string }>;
}) {
  const benutzer = await requireRecht("gemeinschaft.lesen");
  const darfVerwalten = hatRecht([benutzer.rolle], "gemeinschaft.verwalten");

  const { lauf: laufId } = await params;
  const lauf = ladeLauf(decodeURIComponent(laufId));
  if (!lauf) notFound();

  const gemeinschaft = ladeGemeinschaft(lauf.gemeinschaft_id);
  const belege = ladeBelege(lauf.id);
  const meldung = ladeMeldungsuebersicht(lauf.id);

  const rechnungen = belege.filter((b) => b.art === "Rechnung");
  const gutschriften = belege.filter((b) => b.art === "Gutschrift");

  const von = new Date(lauf.zeitraum_von);
  const bis = new Date(new Date(lauf.zeitraum_bis).getTime() - 1);
  const quartal = Math.floor(von.getMonth() / 3) + 1;

  const mengeBezogen = rechnungen.reduce((s, b) => s + b.menge_kwh, 0);
  const mengeGeliefert = gutschriften.reduce((s, b) => s + b.menge_kwh, 0);
  const summeRechnungen = rechnungen.reduce((s, b) => s + b.netto, 0);
  const summeGutschriften = gutschriften.reduce((s, b) => s + b.netto, 0);
  const ersparnis = belege.reduce((s, b) => s + b.netzentgelt_ersparnis, 0);

  const menge = formatEnergie(mengeBezogen);

  // Gemeldet wird nur, was gerechnet und nicht zurückgezogen ist.
  const meldungBereit =
    lauf.status === "Berechnet" || lauf.status === "Festgeschrieben";
  const meldungIntervalle = erwarteteIntervalle(
    ausMessStempel(lauf.zeitraum_von),
    ausMessStempel(lauf.zeitraum_bis),
  );
  // Gezählt wird je Zählpunkt, nicht je Zeitpunkt: Fehlt einem
  // einzigen Zählpunkt eine Viertelstunde, ist der Zeitpunkt aus
  // Sicht der Gemeinschaft trotzdem vorhanden - die Meldung hat
  // dort aber eine Lücke.
  const meldungLuecke = Math.max(
    0,
    meldungIntervalle * meldung.zaehlpunkte - meldung.zeilen,
  );
  const netzbetreiber = findeNetzbetreiber(gemeinschaft?.netzbetreiber_kz ?? "");
  const rabatt = NETZRABATT[gemeinschaft?.reichweite ?? "Lokal"] ?? 0;

  return (
    <div className="space-y-5">
      <Seitenkopf
        titel={`Abrechnung ${von.getFullYear()} Q${quartal}`}
        hinweis={`${gemeinschaft?.bezeichnung} · ${formatDatum(von)} bis ${formatDatum(bis)} · Modell ${lauf.modell}`}
        zurueck={
          <Link
            href="/portal/gemeinschaft"
            className="t-leise inline-flex items-center gap-1.5 hover:underline"
          >
            <IconPfeilLinks groesse={14} />
            Energiegemeinschaft
          </Link>
        }
        aktion={
          <>
            <Status
              ton={
                lauf.status === "Festgeschrieben"
                  ? "gut"
                  : lauf.status === "Storniert"
                    ? "neutral"
                    : "akzent"
              }
            >
              {lauf.status}
            </Status>
            {darfVerwalten && (
              <LaufAktionen laufId={lauf.id} status={lauf.status} />
            )}
          </>
        }
      />

      {lauf.status === "Storniert" && (
        <Hinweis ton="kritisch" titel="Dieser Lauf wurde storniert">
          {lauf.storno_grund}
          {lauf.storniert_am && ` (${formatDatumZeit(lauf.storniert_am)})`}
        </Hinweis>
      )}

      {lauf.status === "Berechnet" && darfVerwalten && (
        <Hinweis ton="hinweis" titel="Noch nicht festgeschrieben">
          Die Belege sind gerechnet, aber noch veränderbar. Solange der Lauf
          nicht festgeschrieben ist, können Sie ihn mit geänderten Vorgaben neu
          rechnen. Erst mit dem Festschreiben werden die Belege unveränderlich.
        </Hinweis>
      )}

      <Kennzahlenleiste>
        <Kennzahl
          label="In der Gemeinschaft verteilt"
          wert={menge.wert}
          einheit={menge.einheit}
          akzent
        />
        <Kennzahl
          label="Rechnungen"
          wert={formatGeld(summeRechnungen)}
          hinweis={`${rechnungen.length} Belege, netto`}
        />
        <Kennzahl
          label="Gutschriften"
          wert={formatGeld(summeGutschriften)}
          hinweis={`${gutschriften.length} Belege, netto`}
        />
        <Kennzahl
          label="Deckungsbeitrag"
          wert={formatGeld(summeRechnungen - summeGutschriften)}
          hinweis="verbleibt der Gemeinschaft"
        />
      </Kennzahlenleiste>

      {/* ---------------- Rechnungen ---------------- */}
      <Tafel
        titel="Rechnungen an Verbraucher"
        hinweis={`Bezug aus der Gemeinschaft zu ${formatZahl(lauf.preis_ct_kwh, 2)} ct/kWh`}
        dicht
      >
        {rechnungen.length === 0 ? (
          <div className="p-4">
            <LeerZustand text="Keine Rechnungen in diesem Lauf." />
          </div>
        ) : (
          <Tabelle
            spalten={[
              { titel: "Beleg" },
              { titel: "Mitglied" },
              { titel: "Zählpunkt", schmalAusblenden: true },
              { titel: "Menge", zahl: true },
              { titel: "Netto", zahl: true },
              { titel: "USt", zahl: true, schmalAusblenden: true },
              { titel: "Brutto", zahl: true },
              { titel: "", breite: "3rem" },
            ]}
          >
            {rechnungen.map((beleg) => (
              <Zeile key={beleg.id} gedaempft={beleg.status === "Storniert"}>
                <Zelle>
                  <span className="font-mono text-[0.75rem]">{beleg.nummer}</span>
                </Zelle>
                <Zelle>{beleg.firma ?? "–"}</Zelle>
                <Zelle leise schmalAusblenden>
                  <span className="font-mono text-[0.75rem]">
                    {kuerzeZaehlpunkt(beleg.bezeichnung)}
                  </span>
                </Zelle>
                <Zelle zahl>
                  {formatZahl(beleg.menge_kwh, 0)}
                  <span className="t-mikro"> kWh</span>
                </Zelle>
                <Zelle zahl>{formatGeld(beleg.netto)}</Zelle>
                <Zelle zahl leise schmalAusblenden>
                  {formatGeld(beleg.ust_betrag)}
                </Zelle>
                <Zelle zahl>{formatGeld(beleg.brutto)}</Zelle>
                <Zelle>
                  <Link
                    href={`/portal/gemeinschaft/belege/${beleg.id}`}
                    className="inline-flex opacity-40 transition-opacity group-hover:opacity-100"
                    style={{ color: "var(--t-normal)" }}
                    aria-label={`Beleg ${beleg.nummer} öffnen`}
                  >
                    <IconPfeilRechts groesse={15} />
                  </Link>
                </Zelle>
              </Zeile>
            ))}

            <Summenzeile>
              <Zelle>Summe</Zelle>
              <Zelle>{rechnungen.length} Belege</Zelle>
              <Zelle schmalAusblenden>{null}</Zelle>
              <Zelle zahl>
                {formatZahl(mengeBezogen, 0)}
                <span className="t-mikro"> kWh</span>
              </Zelle>
              <Zelle zahl>{formatGeld(summeRechnungen)}</Zelle>
              <Zelle zahl schmalAusblenden>
                {formatGeld(rechnungen.reduce((s, b) => s + b.ust_betrag, 0))}
              </Zelle>
              <Zelle zahl>
                {formatGeld(rechnungen.reduce((s, b) => s + b.brutto, 0))}
              </Zelle>
              <Zelle>{null}</Zelle>
            </Summenzeile>
          </Tabelle>
        )}
      </Tafel>

      {/* ---------------- Gutschriften ---------------- */}
      <Tafel
        titel="Gutschriften an Erzeuger"
        hinweis={`Lieferung in die Gemeinschaft zu ${formatZahl(lauf.erzeuger_ct_kwh, 2)} ct/kWh`}
        dicht
      >
        {gutschriften.length === 0 ? (
          <div className="p-4">
            <LeerZustand text="Keine Gutschriften in diesem Lauf." />
          </div>
        ) : (
          <Tabelle
            spalten={[
              { titel: "Beleg" },
              { titel: "Mitglied" },
              { titel: "Zählpunkt", schmalAusblenden: true },
              { titel: "Menge", zahl: true },
              { titel: "Netto", zahl: true },
              { titel: "Brutto", zahl: true },
              { titel: "", breite: "3rem" },
            ]}
          >
            {gutschriften.map((beleg) => (
              <Zeile key={beleg.id} gedaempft={beleg.status === "Storniert"}>
                <Zelle>
                  <span className="font-mono text-[0.75rem]">{beleg.nummer}</span>
                </Zelle>
                <Zelle>{beleg.firma ?? "–"}</Zelle>
                <Zelle leise schmalAusblenden>
                  <span className="font-mono text-[0.75rem]">
                    {kuerzeZaehlpunkt(beleg.bezeichnung)}
                  </span>
                </Zelle>
                <Zelle zahl>
                  {formatZahl(beleg.menge_kwh, 0)}
                  <span className="t-mikro"> kWh</span>
                </Zelle>
                <Zelle zahl>{formatGeld(beleg.netto)}</Zelle>
                <Zelle zahl>{formatGeld(beleg.brutto)}</Zelle>
                <Zelle>
                  <Link
                    href={`/portal/gemeinschaft/belege/${beleg.id}`}
                    className="inline-flex opacity-40 transition-opacity group-hover:opacity-100"
                    style={{ color: "var(--t-normal)" }}
                    aria-label={`Beleg ${beleg.nummer} öffnen`}
                  >
                    <IconPfeilRechts groesse={15} />
                  </Link>
                </Zelle>
              </Zeile>
            ))}

            <Summenzeile>
              <Zelle>Summe</Zelle>
              <Zelle>{gutschriften.length} Belege</Zelle>
              <Zelle schmalAusblenden>{null}</Zelle>
              <Zelle zahl>
                {formatZahl(mengeGeliefert, 0)}
                <span className="t-mikro"> kWh</span>
              </Zelle>
              <Zelle zahl>{formatGeld(summeGutschriften)}</Zelle>
              <Zelle zahl>
                {formatGeld(gutschriften.reduce((s, b) => s + b.brutto, 0))}
              </Zelle>
              <Zelle>{null}</Zelle>
            </Summenzeile>
          </Tabelle>
        )}
      </Tafel>

      {/* ---------------- Messdatenmeldung ---------------- */}
      <Tafel
        titel="Messdatenmeldung an den Marktpartner"
        hinweis="MSCONS D.04B, Viertelstundenwerte je Zählpunkt und Richtung"
      >
        {meldungBereit ? (
          <>
            <div className="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <dl className="space-y-0.5">
                <Angabe label="Zählpunkte">
                  {formatZahl(meldung.zaehlpunkte, 0)}
                </Angabe>
                <Angabe label="Messwerte">
                  {formatZahl(meldung.werte, 0)}
                </Angabe>
                <Angabe label="Intervalle im Zeitraum">
                  {formatZahl(meldung.intervalle, 0)} von{" "}
                  {formatZahl(meldungIntervalle, 0)}
                </Angabe>
              </dl>
              <dl className="space-y-0.5">
                <Angabe label="Bezug (1-1:1.29.0)">
                  {formatZahl(meldung.bezugKwh, 0)} kWh
                </Angabe>
                <Angabe label="Einspeisung (1-1:2.29.0)">
                  {formatZahl(meldung.einspeisungKwh, 0)} kWh
                </Angabe>
                <Angabe label="Empfänger">
                  {netzbetreiber?.name ?? gemeinschaft?.netzbetreiber_kz ?? "–"}
                </Angabe>
              </dl>
            </div>

            {meldungLuecke > 0 && (
              <div className="mt-3">
                <Hinweis ton="hinweis" titel="Der Zeitraum ist nicht lückenlos">
                  In {formatZahl(meldungLuecke, 0)} von{" "}
                  {formatZahl(meldungIntervalle * meldung.zaehlpunkte, 0)}{" "}
                  Zählpunkt-Viertelstunden liegt keine Aufteilung vor. Die
                  Nachricht wird trotzdem erzeugt, führt diese Intervalle aber
                  nicht – der Empfänger behandelt sie als nicht vorhanden.
                </Hinweis>
              </div>
            )}

            {meldung.ersatzwerte > 0 && (
              <p className="t-mikro mt-3 leading-relaxed">
                {formatZahl(meldung.ersatzwerte, 0)} Werte beruhen auf
                Ersatzwerten des Netzbetreibers. Sie werden mit der Kennung 67
                statt 220 übertragen, weil sie nachträglich berichtigt werden
                können.
              </p>
            )}

            <div className="mt-4 flex flex-wrap items-center gap-2">
              <a
                className="knopf knopf-rand"
                href={`/api/eeg/lauf/${encodeURIComponent(lauf.id)}/mscons`}
                download
              >
                MSCONS-Datei erzeugen
              </a>
              <span className="t-mikro">
                Wird bei jedem Abruf neu gebaut und vor der Ausgabe geprüft:
                Segmentzähler, Referenzen, Zählpunktlänge, Zeichensatz.
              </span>
            </div>
          </>
        ) : (
          <p className="t-mikro leading-relaxed">
            {lauf.status === "Storniert"
              ? "Ein stornierter Lauf wird nicht gemeldet – seine Werte sind zurückgezogen."
              : "Sobald der Lauf gerechnet ist, lässt sich die Aufteilung als MSCONS-Nachricht ausgeben."}
          </p>
        )}
      </Tafel>

      {/* ---------------- Vorgaben und Nachweis ---------------- */}
      <div className="grid grid-cols-1 gap-5 lg:grid-cols-2">
        <Tafel titel="Vorgaben dieses Laufs">
          <dl className="space-y-0.5">
            <Angabe label="Aufteilungsmodell">{lauf.modell}</Angabe>
            <Angabe label="Bezugspreis Verbraucher">
              {formatZahl(lauf.preis_ct_kwh, 2)} ct/kWh
            </Angabe>
            <Angabe label="Gutschrift Erzeuger">
              {formatZahl(lauf.erzeuger_ct_kwh, 2)} ct/kWh
            </Angabe>
            <Angabe label="Umsatzsteuer">
              {formatProzent(lauf.ust_satz, 0)}
            </Angabe>
            <Angabe label="Angelegt am">{formatDatumZeit(lauf.angelegt_am)}</Angabe>
            {lauf.berechnet_am && (
              <Angabe label="Berechnet am">
                {formatDatumZeit(lauf.berechnet_am)}
              </Angabe>
            )}
            {lauf.festgeschrieben_am && (
              <Angabe label="Festgeschrieben am">
                {formatDatumZeit(lauf.festgeschrieben_am)}
              </Angabe>
            )}
          </dl>
          <p className="t-mikro mt-3 leading-relaxed">
            Die Vorgaben sind im Lauf festgehalten. Werden sie später geändert,
            bleiben die Belege dieses Laufs davon unberührt.
          </p>
        </Tafel>

        <Tafel titel="Ersparnis beim Netznutzungsentgelt">
          <dl className="space-y-0.5">
            <Angabe label="Arbeitspreis Netz">
              {formatZahl(NETZ_ARBEITSPREIS_CT, 2)} ct/kWh
            </Angabe>
            <Angabe label="Rabatt">{formatProzent(rabatt * 100, 0)}</Angabe>
            <Angabe label="Begünstigte Menge">
              {formatZahl(mengeBezogen, 0)} kWh
            </Angabe>
            <Angabe label="Ersparnis gesamt">{formatGeld(ersparnis)}</Angabe>
          </dl>
          <p className="t-mikro mt-3 leading-relaxed">
            Die Ersparnis ist keine Zahlung der Gemeinschaft, sondern eine
            geringere Rechnung des Netzbetreibers. Sie wird deshalb nur
            nachrichtlich ausgewiesen und nicht in die Belegsummen eingerechnet.
          </p>
        </Tafel>
      </div>
    </div>
  );
}
