/**
 * Abnahmeprotokolle je Anlage.
 *
 * Gemessen wird an einem Tag mit brauchbarer Einstrahlung, und die
 * Werte streuen so, wie sie es an einem echten Dach tun: ein Prozent
 * Messunsicherheit, nicht Null.
 *
 * Zwei eingebaute Befunde, weil sich nur an ihnen zeigt, ob die
 * Pruefung taugt:
 *
 * - Der Lagerhalle fehlt ein Modul in einem Strang. Das ist der
 *   haeufigste Fehler bei der Erstinbetriebnahme und aus der
 *   Leerlaufspannung direkt ablesbar.
 * - Beim Carport wurde mit zu geringer Pruefspannung isoliert
 *   gemessen. Der Wert sieht gut aus und ist wertlos.
 */
function befuelleAbnahmen(): number {
  const anlagen = alle<{
    id: string;
    bezeichnung: string;
    inbetriebnahme: string | null;
  }>("SELECT id, bezeichnung, inbetriebnahme FROM anlage ORDER BY id");

  let anzahl = 0;

  for (const anlage of anlagen) {
    const zufall = zufallsfolge(startwertAus(`${anlage.id}-abnahme`));

    const straenge = alle<{
      id: string;
      bezeichnung: string;
      modul_anzahl: number;
      wechselrichter_id: string;
      wechselrichter: string;
    }>(
      `SELECT s.id, s.bezeichnung, s.modul_anzahl, s.wechselrichter_id,
              w.bezeichnung AS wechselrichter
         FROM strang s
         JOIN wechselrichter w ON w.id = s.wechselrichter_id
        WHERE w.anlage_id = ?
        ORDER BY s.wechselrichter_id, s.id`,
      anlage.id,
    );

    if (straenge.length === 0) continue;

    const abnahmeId = `ABN-${anlage.id.slice(4)}`;
    const geprueft = anlage.inbetriebnahme ?? "2024-05-14";

    // Messbedingungen: ein klarer Vormittag im Mai.
    const einstrahlung = anlage.id === "ANL-0003" ? 320 : 780 + zufall() * 120;
    const modultemperatur = 18 + zufall() * 8;

    schreibe(
      `INSERT INTO abnahme
         (id, anlage_id, geprueft_am, pruefer, pruefstelle, systemspannung_v,
          einstrahlung, modultemperatur, rcd_ausloesung_ms, rcd_bemessung_ma,
          netzschutz_geprueft, inselschutz_geprueft, bemerkung)
       VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 1, 1, ?)`,
      abnahmeId,
      anlage.id,
      geprueft,
      "Ing. M. Hofbauer",
      "Ökovolt Technik, akkreditierte Prüfstelle",
      1000,
      Number(einstrahlung.toFixed(0)),
      Number(modultemperatur.toFixed(1)),
      Number((18 + zufall() * 12).toFixed(0)),
      30,
      anlage.id === "ANL-0003"
        ? "Strommessung wegen Bewölkung nicht verwertbar, Nachmessung vereinbart."
        : null,
    );

    for (const [i, strang] of straenge.entries()) {
      /*
       * Module in Reihe, nicht Module am Strang.
       *
       * Im Anlagenstamm steht, wie viele Module an einem Strang
       * haengen; das sind bei einem grossen Feld auch siebzig. In
       * Reihe koennen es keine siebzig sein: Bei 41 Volt je Modul
       * waeren das 2850 Volt und damit weit ueber der zulaessigen
       * Systemspannung von 1000 Volt. Tatsaechlich haengen mehrere
       * Reihen parallel - fuer die Messung zaehlt die Reihe.
       */
      const REIHE = 20;
      const parallel = Math.max(
        1,
        Math.round((strang.modul_anzahl > 0 ? strang.modul_anzahl : REIHE) / REIHE),
      );

      const inReihe = REIHE;
      const uocModul = 41.3;
      // Parallel geschaltete Reihen addieren ihren Strom.
      const iscModul = 13.9 * parallel;

      // Der Erwartungswert bei den Messbedingungen.
      const sollUoc =
        inReihe * uocModul * (1 - 0.0029 * (modultemperatur - 25));
      const sollIsc = iscModul * (einstrahlung / 1000);

      /*
       * Ein nicht durchgesteckter Verbinder in der Lagerhalle.
       *
       * Drei Module der Reihe haengen nicht mit - der haeufigste
       * Befund einer Erstabnahme. Gegen das Datenblatt allein ist das
       * eine Abweichung von fuenfzehn Prozent; gegen die
       * Nachbarstraenge faellt es sofort auf, und genau dafuer gibt
       * es den Strangvergleich.
       */
      const fehlendeModule = anlage.id === "ANL-0003" && i === 0 ? 3 : 0;

      const gemesseneUoc =
        fehlendeModule > 0
          ? (sollUoc / inReihe) * (inReihe - fehlendeModule)
          : sollUoc * (0.995 + zufall() * 0.01);

      schreibe(
        `INSERT INTO abnahme_strang
           (id, abnahme_id, strang_id, bezeichnung, module, uoc_modul_v,
            isc_modul_a, gemessene_uoc_v, gemessener_isc_a, isolation_mohm,
            pruefspannung_v, schutzleiter_ohm, polaritaet_richtig)
         VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 1)`,
        `${abnahmeId}-S${String(i + 1).padStart(2, "0")}`,
        abnahmeId,
        strang.id,
        // Der Strangname allein wiederholt sich je Wechselrichter.
        `${strang.wechselrichter} · ${strang.bezeichnung}`,
        inReihe,
        uocModul,
        iscModul,
        Number(gemesseneUoc.toFixed(1)),
        Number((sollIsc * (0.98 + zufall() * 0.04)).toFixed(2)),
        Number((12 + zufall() * 40).toFixed(1)),
        // Beim Carport wurde mit der falschen Stufe gemessen.
        anlage.id === "ANL-0005" ? 500 : 1000,
        Number((0.12 + zufall() * 0.35).toFixed(2)),
      );
    }

    anzahl += 1;
  }

  return anzahl;
}

/**
 * Wartungsprofile und Prüftermine je Anlage.
 *
 * Der Bestand ist bewusst uneinheitlich, weil er in einem Betrieb
 * dieser Größe uneinheitlich ist:
 *
 * - Das Bürogebäude ist gering beansprucht und darf nach ESV zehn
 *   Jahre laufen - die Anlage sieht deshalb "überfällig" aus, wenn
 *   man nur auf das Datum schaut, und ist es nicht.
 * - Am Sägewerk gilt ein verkürzter Abstand: Holzstaub. Die Frist
 *   steht dort deshalb auf drei Jahre und nicht auf fünf.
 * - Beim Carport fehlt die Prüfung der entkuppelnden Schutz-
 *   einrichtung. Das ist der Fall, der einen Netzzugang kostet, und
 *   er soll auf der Oberfläche zu sehen sein.
 * - Zur Lagerhalle ist zur Thermografie nichts abgelegt. Nicht
 *   "in Ordnung", sondern unbekannt.
 */
function befuelleWartung(): number {
  const anlagen = alle<{ id: string; inbetriebnahme: string | null }>(
    "SELECT id, inbetriebnahme FROM anlage ORDER BY id",
  );

  const profile: Record<
    string,
    { umgebung: string; klasse: number | null; kritisch: number; bemerkung?: string }
  > = {
    "ANL-0001": { umgebung: "normal", klasse: 3, kritisch: 0 },
    "ANL-0002": {
      umgebung: "explosionsgefaehrdet",
      klasse: 2,
      kritisch: 1,
      bemerkung:
        "Holzstaub in der Späneabsaugung: Bereich nach ESV verkürzt geprüft, Blitzschutz als kritisches System geführt.",
    },
    "ANL-0003": { umgebung: "normal", klasse: 3, kritisch: 0 },
    "ANL-0004": {
      umgebung: "gering",
      klasse: 4,
      kritisch: 0,
      bemerkung: "Reines Bürogebäude, keine Fertigung.",
    },
    "ANL-0005": { umgebung: "normal", klasse: 4, kritisch: 0 },
  };

  // Monate zurück, gerechnet von heute. `null` heißt: nichts abgelegt.
  const termine: Record<string, Record<string, number | null>> = {
    "ANL-0001": {
      "esv-anlage": 26,
      "pv-anlagenpruefung": 14,
      // Schutzklasse 3, also 24 Monate: in einem Monat fällig.
      "blitzschutz-sicht": 23,
      "blitzschutz-umfassend": 23,
      "na-schutz": 30,
      "wechselrichter-wartung": 7,
      thermografie: 15,
      modulreinigung: 19,
    },
    "ANL-0002": {
      // Verkürzter Abstand von 36 Monaten, letzte Prüfung 40 Monate
      // her: seit vier Monaten überfällig.
      "esv-anlage": 40,
      "pv-anlagenpruefung": 9,
      "blitzschutz-sicht": 8,
      "blitzschutz-umfassend": 8,
      "na-schutz": 22,
      "wechselrichter-wartung": 4,
      thermografie: 11,
      modulreinigung: 26,
    },
    "ANL-0003": {
      "esv-anlage": 41,
      // 24 Monate Abstand: in einem Monat fällig.
      "pv-anlagenpruefung": 23,
      "blitzschutz-sicht": 21,
      "blitzschutz-umfassend": 44,
      "na-schutz": 41,
      "wechselrichter-wartung": 10,
      thermografie: null,
      modulreinigung: 27,
    },
    "ANL-0004": {
      // Zehn Jahre Abstand: trotz 71 Monaten nicht fällig.
      "esv-anlage": 71,
      "pv-anlagenpruefung": 17,
      "blitzschutz-sicht": 16,
      "blitzschutz-umfassend": 30,
      "na-schutz": 33,
      "wechselrichter-wartung": 9,
      thermografie: 20,
      modulreinigung: 14,
    },
    "ANL-0005": {
      "esv-anlage": 19,
      "pv-anlagenpruefung": 20,
      "blitzschutz-sicht": 22,
      "blitzschutz-umfassend": 46,
      // Nie geprüft - der Fall, der den Netzzugang kostet.
      "na-schutz": null,
      "wechselrichter-wartung": 6,
      thermografie: 18,
      modulreinigung: 8,
    },
  };

  const pruefer: Record<string, string> = {
    "esv-anlage": "Ing. M. Hofbauer, Ökovolt Technik",
    "pv-anlagenpruefung": "Ing. M. Hofbauer, Ökovolt Technik",
    "blitzschutz-sicht": "Blitzschutzbau Hofer GmbH",
    "blitzschutz-umfassend": "Blitzschutzbau Hofer GmbH",
    "na-schutz": "Ökovolt Technik, Protokoll an Netz NÖ",
    "wechselrichter-wartung": "Werkskundendienst",
    thermografie: "TÜV Austria, Thermografie",
    modulreinigung: "Fassaden- und Anlagenreinigung Prem",
  };

  let anzahl = 0;

  for (const anlage of anlagen) {
    const profil = profile[anlage.id];
    if (!profil) continue;

    schreibe(
      `INSERT INTO wartungsprofil
         (anlage_id, umgebung, blitzschutzklasse, kritisch, bemerkung)
       VALUES (?, ?, ?, ?, ?)`,
      anlage.id,
      profil.umgebung,
      profil.klasse,
      profil.kritisch,
      profil.bemerkung ?? null,
    );

    const eintraege = termine[anlage.id] ?? {};

    for (const [regel, monate] of Object.entries(eintraege)) {
      const letzte =
        monate === null
          ? null
          : (() => {
              const d = new Date();
              d.setHours(0, 0, 0, 0);
              d.setMonth(d.getMonth() - monate);
              return tagesSchluessel(d);
            })();

      schreibe(
        `INSERT INTO wartungstermin
           (id, anlage_id, regel, letzte_pruefung, intervall_monate, pruefer,
            protokoll, befund, bemerkung)
         VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)`,
        `WAR-${anlage.id.slice(4)}-${regel}`,
        anlage.id,
        regel,
        letzte,
        // Am Sägewerk schreibt die Behörde drei Jahre vor.
        anlage.id === "ANL-0002" && regel === "esv-anlage" ? 36 : null,
        letzte ? pruefer[regel] : null,
        letzte ? `PRO-${anlage.id.slice(4)}-${regel.toUpperCase()}` : null,
        letzte ? "ohne Beanstandung" : null,
        monate === null
          ? "Zu dieser Prüfung ist nichts abgelegt."
          : null,
      );

      anzahl += 1;
    }
  }

  return anzahl;
}

export function befuelleTechnik(erzwingen = false): TechnikErgebnis {
  const start = Date.now();

  const vorhanden = skalar<number>("SELECT COUNT(*) FROM wechselrichter") ?? 0;
  if (vorhanden > 0 && !erzwingen) {
    return {
      wechselrichter: 0,
      straenge: 0,
      abnahmen: 0,
      wrMesswerte: 0,
      strangMesswerte: 0,
      sensorMesswerte: 0,
      alarme: 0,
      wartungstermine: 0,
      dauerMs: 0,
    };
  }

  const anlagen = holeAnlagen();
  const heute = new Date();
  heute.setHours(0, 0, 0, 0);
  const beginn = verschiebeTage(heute, -TAGE_DETAIL + 1);

  const zaehler = {
    straenge: 0,
    wrMesswerte: 0,
    strangMesswerte: 0,
    sensorMesswerte: 0,
    alarme: 0,
    abnahmen: 0,
    wartungstermine: 0,
  };

  imBlock(() => {
    if (erzwingen) {
      for (const tabelle of [
        "alarm",
        "alarmregel",
        "strang_messwert",
        "wartungstermin",
        "wartungsprofil",
        "abnahme_strang",
        "abnahme",
        "wr_messwert",
        "sensor_messwert",
        "strang",
        "wechselrichter",
        "verguetung",
        "betriebskosten",
      ]) {
        schreibe(`DELETE FROM ${tabelle}`);
      }
    }

    // --- Wechselrichter und Stränge ---
    let strangNummer = 0;

    for (const wr of WECHSELRICHTER) {
      schreibe(
        `INSERT INTO wechselrichter
           (id, anlage_id, bezeichnung, hersteller, modell, seriennummer,
            firmware, nennleistung_kw, modulleistung_kwp, eingebaut_am,
            garantie_bis, ip_adresse)
         VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?,
                 (SELECT inbetriebnahme FROM anlage WHERE id = ?),
                 date((SELECT inbetriebnahme FROM anlage WHERE id = ?), '+10 years'),
                 ?)`,
        wr.id,
        wr.anlageId,
        wr.bezeichnung,
        wr.hersteller,
        wr.modell,
        wr.seriennummer,
        wr.firmware,
        wr.nennleistungKw,
        wr.modulleistungKwp,
        wr.anlageId,
        wr.anlageId,
        wr.ip,
      );

      const anlage = anlagen.get(wr.anlageId);
      const kwpJeStrang = wr.modulleistungKwp / wr.straenge;

      for (let i = 1; i <= wr.straenge; i++) {
        strangNummer += 1;
        const strangId = `STR-${String(strangNummer).padStart(4, "0")}`;

        schreibe(
          `INSERT INTO strang
             (id, wechselrichter_id, bezeichnung, tracker, modul_anzahl,
              leistung_kwp, ausrichtung, neigung)
           VALUES (?, ?, ?, ?, ?, ?, ?, ?)`,
          strangId,
          wr.id,
          `Strang ${i}`,
          Math.ceil(i / 2),
          Math.round(kwpJeStrang / 0.565),
          Number(kwpJeStrang.toFixed(2)),
          anlage?.ausrichtung ?? "Süd",
          anlage?.neigung ?? 15,
        );
        zaehler.straenge += 1;
      }
    }

    const guete = strangGuete();

    // --- Messwerte ---
    const sensorEinfuegen = db().prepare(
      `INSERT OR REPLACE INTO sensor_messwert
         (anlage_id, zeitpunkt, einstrahlung_w_m2, modultemperatur,
          umgebungstemperatur, windgeschwindigkeit)
       VALUES (?, ?, ?, ?, ?, ?)`,
    );

    const wrEinfuegen = db().prepare(
      `INSERT OR REPLACE INTO wr_messwert
         (wechselrichter_id, zeitpunkt, leistung_kw, dc_leistung_kw,
          temperatur, zustand)
       VALUES (?, ?, ?, ?, ?, ?)`,
    );

    const strangEinfuegen = db().prepare(
      `INSERT OR REPLACE INTO strang_messwert
         (strang_id, zeitpunkt, strom_a, spannung_v)
       VALUES (?, ?, ?, ?)`,
    );

    const straengeJeWr = holeStraenge();

    for (let tag = 0; tag < TAGE_DETAIL; tag++) {
      const datum = verschiebeTage(beginn, tag);
      const tagVonHeute = TAGE_DETAIL - 1 - tag;

      for (const [anlageId, anlage] of anlagen) {
        const zufall = zufallsfolge(
          startwertAus(`${anlageId}-technik-${tagesSchluessel(datum)}`),
        );
        const bewoelkung = Math.pow(zufall(), 2) * 0.85;

        for (let viertel = 0; viertel < 96; viertel++) {
          const zeit = new Date(datum);
          zeit.setHours(0, viertel * 15, 0, 0);
          const stempel = messStempel(zeit);

          const sonne = sonnenposition(zeit, anlage.breite, anlage.laenge);

          // --- Sensorik ---
          const klarSicht = Math.max(0, Math.sin((sonne.hoehe * Math.PI) / 180));
          const einstrahlung =
            sonne.hoehe <= 0
              ? 0
              : Math.max(
                  0,
                  1050 * klarSicht * (1 - bewoelkung * (0.4 + 0.45 * zufall())),
                );

          const umgebung =
            8 + 14 * klarSicht + 6 * Math.sin((tag / 60) * Math.PI) + zufall() * 3;
          // Module werden deutlich wärmer als die Umgebung.
          const modultemperatur = umgebung + (einstrahlung / 1000) * 28;

          sensorEinfuegen.run(
            anlageId,
            stempel,
            Number(einstrahlung.toFixed(1)),
            Number(modultemperatur.toFixed(1)),
            Number(umgebung.toFixed(1)),
            Number((1 + zufall() * 5).toFixed(1)),
          );
          zaehler.sensorMesswerte += 1;

          // --- Wechselrichter und Stränge ---
          for (const wr of WECHSELRICHTER.filter((w) => w.anlageId === anlageId)) {
            const moeglich = erwarteteLeistung(
              wr.modulleistungKwp,
              einstrahlung,
              modultemperatur,
              0.86,
            );

            let leistung = moeglich;
            let zustand = "Normal";

            // Eingebaute Fehlerbilder.
            if (wr.stoerung === "ausfall" && tagVonHeute === AUSFALL_VOR_TAGEN) {
              leistung = 0;
              zustand = einstrahlung > 50 ? "Stoerung" : "Aus";
            } else if (wr.stoerung === "abregelung" && moeglich > wr.nennleistungKw) {
              leistung = wr.nennleistungKw;
              zustand = "Abgeregelt";
            } else if (wr.stoerung === "morgenschatten") {
              const minute = zeit.getHours() * 60 + zeit.getMinutes();
              if (
                minute >= SCHATTEN_VON_MINUTE &&
                minute < SCHATTEN_BIS_MINUTE
              ) {
                leistung = moeglich * SCHATTEN_RESTANTEIL;
              }
            }

            // Schmutz auf dem Glas wirkt auf die ganze Anlage.
            leistung *= 1 - verschmutzung(anlageId, tagVonHeute);

            const dcLeistung = leistung > 0 ? leistung / 0.98 : 0;
            const wrTemperatur =
              umgebung + (leistung / Math.max(1, wr.nennleistungKw)) * 32;

            wrEinfuegen.run(
              wr.id,
              stempel,
              Number(leistung.toFixed(2)),
              Number(dcLeistung.toFixed(2)),
              Number(wrTemperatur.toFixed(1)),
              zustand,
            );
            zaehler.wrMesswerte += 1;

            // Strangströme: gleichmäßige Aufteilung mit leichter Streuung.
            const straenge = straengeJeWr.get(wr.id) ?? [];
            for (const strang of straenge) {
              const anteil = strang.leistung_kwp / wr.modulleistungKwp;
              // Rund 620 V Strangspannung im Betrieb.
              const spannung = einstrahlung > 20 ? 600 + zufall() * 40 : 0;
              let strom =
                spannung > 0 ? (leistung * anteil * 1000) / spannung : 0;

              // Dauerhafte Güte des Strangs - siehe strangGuete().
              strom *= guete.get(strang.id) ?? 1;

              // Messrauschen. Anders als die Güte mittelt es sich über
              // längere Zeiträume heraus und verschiebt den Vergleich
              // deshalb nicht.
              strom *= 0.995 + zufall() * 0.01;

              // Fortschreitende Verschattung an einem Strang.
              if (strang.id === VERSCHATTETER_STRANG) {
                const fortschritt = Math.min(1, tag / TAGE_DETAIL);
                strom *= 1 - 0.28 * fortschritt;
              }

              strangEinfuegen.run(
                strang.id,
                stempel,
                Number(Math.max(0, strom).toFixed(2)),
                Number(spannung.toFixed(1)),
              );
              zaehler.strangMesswerte += 1;
            }
          }
        }
      }
    }

    befuelleRegeln();
    zaehler.alarme = befuelleAlarme(heute);
    zaehler.abnahmen = befuelleAbnahmen();
    zaehler.wartungstermine = befuelleWartung();
    befuelleWirtschaft();
  });

  return {
    wechselrichter: WECHSELRICHTER.length,
    ...zaehler,
    dauerMs: Date.now() - start,
  };
}

interface AnlagenZeile {
  id: string;
  bezeichnung: string;
  leistung_kwp: number;
  latitude: number;
  longitude: number;
  ausrichtung: string | null;
  neigung: number | null;
}


/**
 * Dauerhafte Güte je Strang, rund plus/minus zwei Prozent.
 *
 * Stränge derselben Anlage liefern nie exakt gleich viel: Module
 * streuen innerhalb ihrer Leistungstoleranz, Leitungswege sind
 * unterschiedlich lang, Dachflächen verschmutzen ungleichmäßig. Dieser
 * Unterschied ist dauerhaft - er mittelt sich über Wochen nicht heraus.
 *
 * Reines Rauschen je Messwert wäre hier falsch: Über dreißig Tage
 * gemittelt ergäbe es für jeden Strang exakt null Prozent Abweichung.
 * Ein Strangvergleich, in dem alles genau null ist, zeigt weder, dass
 * die Auswertung funktioniert, noch wo die Grenze zum Auffälligen liegt.
 */
function strangGuete(): Map<string, number> {
  const karte = new Map<string, number>();

  const zeilen = db().prepare("SELECT id FROM strang").all() as unknown as {
    id: string;
  }[];

  for (const z of zeilen) {
    // Aus der Kennung abgeleitet: bei gleichem Bestand gleiches Ergebnis.
    const wert = zufallsfolge(startwertAus(`guete:${z.id}`))();
    karte.set(z.id, 0.98 + wert * 0.04);
  }

  return karte;
}

function holeAnlagen(): Map<
  string,
  { bezeichnung: string; kwp: number; breite: number; laenge: number; ausrichtung: string | null; neigung: number | null }
> {
  const zeilen = db()
    .prepare(
      `SELECT id, bezeichnung, leistung_kwp, latitude, longitude, ausrichtung, neigung
         FROM anlage`,
    )
    .all() as unknown as AnlagenZeile[];

  const karte = new Map<
    string,
    { bezeichnung: string; kwp: number; breite: number; laenge: number; ausrichtung: string | null; neigung: number | null }
  >();

  for (const z of zeilen) {
    karte.set(z.id, {
      bezeichnung: z.bezeichnung,
      kwp: z.leistung_kwp,
      breite: z.latitude ?? 48.2,
      laenge: z.longitude ?? 15.6,
      ausrichtung: z.ausrichtung,
      neigung: z.neigung,
    });
  }

  return karte;
}

function holeStraenge(): Map<
  string,
  { id: string; leistung_kwp: number }[]
> {
  const zeilen = db()
    .prepare("SELECT id, wechselrichter_id, leistung_kwp FROM strang")
    .all() as unknown as {
    id: string;
    wechselrichter_id: string;
    leistung_kwp: number;
  }[];

  const karte = new Map<string, { id: string; leistung_kwp: number }[]>();
  for (const z of zeilen) {
    const liste = karte.get(z.wechselrichter_id) ?? [];
    liste.push({ id: z.id, leistung_kwp: z.leistung_kwp });
    karte.set(z.wechselrichter_id, liste);
  }
  return karte;
}

