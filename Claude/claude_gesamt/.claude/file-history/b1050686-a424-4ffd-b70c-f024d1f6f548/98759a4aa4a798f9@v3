      a.bis ? a.bis.toISOString() : null,
      a.status === "Quittiert" ? new Date().toISOString() : null,
      a.status === "Quittiert" ? "m.hofbauer@steiner-holzbau.at" : null,
    );
  }

  return alarme.length;
}

