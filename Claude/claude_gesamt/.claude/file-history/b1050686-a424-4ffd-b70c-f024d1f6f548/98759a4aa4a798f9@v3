/**
 * Legt die Alarme an, die zu den eingebauten Fehlerbildern gehören.
 *
 * Im Regelbetrieb entstünden sie aus der laufenden Auswertung; hier
 * werden sie passend zu den erzeugten Messwerten gesetzt, damit
 * Meldung und Datenlage zusammenpassen.
 */
function befuelleAlarme(heute: Date): number {
  const ausfallTag = verschiebeTage(heute, -AUSFALL_VOR_TAGEN);
  const abbruchTag = verschiebeTage(heute, -ABBRUCH_VOR_TAGEN);

  // Bezeichnungen aus dem Bestand holen statt sie hinzuschreiben: Sonst
  // spricht die Meldung von einem anderen Strang als dem, auf den sie
  // zeigt - und wer ihr folgt, steht vor dem falschen Gerät.
  const betroffen = db()
    .prepare(
      `SELECT s.bezeichnung AS strang, wr.bezeichnung AS wr
         FROM strang s
         JOIN wechselrichter wr ON wr.id = s.wechselrichter_id
        WHERE s.id = ?`,
    )
    .get(VERSCHATTETER_STRANG) as unknown as
    | { strang: string; wr: string }
    | undefined;

  const strangName = betroffen?.strang ?? "Strang";
  const wrName = betroffen?.wr ?? "Wechselrichter";

  const alarme: {
    id: string;
    regel: string;
    anlage: string;
    wr?: string;
    strang?: string;
    art: string;
    grad: string;
    titel: string;
    text: string;
    ist: number;
    soll: number;
    status: string;
    ausfallKwh: number;
    ausfallEur: number;
    von: Date;
    bis: Date | null;
  }[] = [
    {
      id: "ALM-0001",
      regel: "REG-0003",
      anlage: "ANL-0002",
      strang: VERSCHATTETER_STRANG,
      art: "Strangabweichung",
      grad: "Mittel",
      titel: `Strangabweichung: ${strangName}`,
      text:
        `${strangName} an ${wrName} liefert rund 22 Prozent weniger als die ` +
        "übrigen Stränge desselben Geräts. Die Abweichung nimmt seit mehreren " +
        "Wochen zu – das Muster spricht für Bewuchs, nicht für einen " +
        "plötzlichen Defekt.",
      ist: 5.9,
      soll: 7.6,
      status: "Offen",
      ausfallKwh: 640,
      ausfallEur: 76.8,
      von: verschiebeTage(heute, -21),
      bis: null,
    },
    {
      id: "ALM-0002",
      regel: "REG-0004",
      anlage: "ANL-0002",
      wr: "WR-0007",
      art: "Wechselrichterstoerung",
      grad: "Hoch",
      titel: "Wechselrichterstörung: WR 3 Halle West",
      text:
        "WR 3 Halle West meldete Störung und speiste den ganzen Tag nicht ein. Nach dem Wiedereinschalten läuft das Gerät normal; die Ursache ist offen.",
      ist: 0,
      soll: 86.4,
      status: "Behoben",
      ausfallKwh: 712,
      ausfallEur: 85.4,
      von: new Date(ausfallTag.getTime() + 6 * 3600000),
      bis: new Date(ausfallTag.getTime() + 19 * 3600000),
    },
    {
      id: "ALM-0003",
      regel: "REG-0005",
      anlage: "ANL-0004",
      art: "Kommunikation",
      grad: "Mittel",
      titel: "Keine Daten empfangen",
      text:
        "Der Datenlogger war nach einem Stromausfall nicht erreichbar. Die Messwerte wurden nach dem Neustart vollständig nachgeladen.",
      ist: 0,
      soll: 0,
      status: "Behoben",
      ausfallKwh: 0,
      ausfallEur: 0,
      von: new Date(abbruchTag.getTime() + 22 * 3600000),
      bis: new Date(abbruchTag.getTime() + 31 * 3600000),
    },
    {
      id: "ALM-0004",
      regel: "REG-0007",
      anlage: "ANL-0001",
      wr: "WR-0003",
      art: "Abregelung",
      grad: "Info",
      titel: "Abregelung: WR 3 Südfeld",
      text:
        "WR 3 Südfeld erreicht an klaren Tagen die Nennleistung und begrenzt. Bei einem Auslegungsfaktor von 1,25 ist das erwartbar; die abgeregelte Menge liegt im Jahresmittel unter einem Prozent.",
      ist: 150,
      soll: 163.2,
      status: "Quittiert",
      ausfallKwh: 184,
      ausfallEur: 22.1,
      von: verschiebeTage(heute, -4),
      bis: null,
    },
    {
      id: "ALM-0005",
      regel: "REG-0006",
      anlage: "ANL-0003",
      wr: "WR-0016",
      art: "Temperatur",
      grad: "Niedrig",
      titel: "Übertemperatur: WR 2",
      text:
        "Die Innentemperatur lag über mehrere Stunden bei 74 Grad. Der Lüftungsweg sollte bei der nächsten Begehung geprüft werden.",
      ist: 74,
      soll: 70,
      status: "Offen",
      ausfallKwh: 0,
      ausfallEur: 0,
      von: verschiebeTage(heute, -2),
      bis: null,
    },
  ];

  for (const a of alarme) {
    schreibe(
      `INSERT INTO alarm
         (id, regel_id, anlage_id, wechselrichter_id, strang_id, art,
          schweregrad, titel, beschreibung, ist_wert, soll_wert, status,
          ausfall_kwh, ausfall_eur, ausgeloest_am, beendet_am,
          quittiert_am, quittiert_von)
