/* ------------------------------------------------------------------ */
/* Änderung prüfen                                                     */
/* ------------------------------------------------------------------ */

export interface Regelaenderung {
  art: Regelart;
  schwellwert: number | null;
  dauerMinuten: number;
  schweregrad: Schweregrad;
  minEinstrahlung: number | null;
  nurTagsueber: boolean;
  aktiv: boolean;
}

export interface Pruefung {
  ok: boolean;
  /** Was die Änderung verhindert. */
  fehler: string[];
  /** Was zulässig, aber bedenklich ist. */
  warnungen: string[];
}

/** Mindesteinstrahlung, unterhalb derer ein Vergleich nichts aussagt. */
export const MINDESTEINSTRAHLUNG = 100;

export function pruefeAenderung(aenderung: Regelaenderung): Pruefung {
  const fehler: string[] = [];
  const warnungen: string[] = [];

  const grenzen = GRENZEN[aenderung.art];
  if (!grenzen) {
    return { ok: false, fehler: ["Unbekannte Regelart."], warnungen: [] };
  }

  /* ---------- Schwellwert ---------- */

  if (grenzen.mitSchwelle) {
    const wert = aenderung.schwellwert;

    if (wert === null || !Number.isFinite(wert)) {
      fehler.push("Diese Regel braucht einen Schwellwert.");
    } else if (wert < grenzen.von || wert > grenzen.bis) {
      fehler.push(
        `Der Schwellwert muss zwischen ${grenzen.von} und ${grenzen.bis} ${grenzen.einheit} liegen. ${grenzen.begruendung}`,
      );
    }
  }

  /* ---------- Dauer ---------- */

  if (!Number.isInteger(aenderung.dauerMinuten)) {
    fehler.push("Die Mindestdauer muss eine ganze Zahl von Minuten sein.");
  } else if (
    aenderung.dauerMinuten < grenzen.dauerVon ||
    aenderung.dauerMinuten > grenzen.dauerBis
  ) {
    fehler.push(
      `Die Mindestdauer muss zwischen ${grenzen.dauerVon} und ${grenzen.dauerBis} Minuten liegen.`,
    );
  }

  /* ---------- Einstrahlung ---------- */

  const brauchtEinstrahlung =
    aenderung.art === "Minderertrag" ||
    aenderung.art === "Strangabweichung" ||
    aenderung.art === "Performance";

  if (brauchtEinstrahlung) {
    if (!aenderung.nurTagsueber) {
      fehler.push(
        "Eine Ertragsregel ohne Tageslichtbedingung meldet jede Nacht einen Nullertrag.",
      );
    }

    const strahlung = aenderung.minEinstrahlung ?? 0;
    if (strahlung < MINDESTEINSTRAHLUNG) {
      fehler.push(
        `Unter ${MINDESTEINSTRAHLUNG} W/m² ist ein Ertragsvergleich nicht aussagekräftig – bei diffusem Licht weicht jede Anlage ab.`,
      );
    }
  }

  /* ---------- Schwere ---------- */

  if (!SCHWEREGRADE.includes(aenderung.schweregrad)) {
    fehler.push("Unzulässige Einstufung der Schwere.");
  }

  if (
    aenderung.schweregrad === "Kritisch" &&
    (aenderung.art === "Abregelung" || aenderung.art === "Temperatur")
  ) {
    warnungen.push(
      "Als kritisch eingestufte Meldungen wecken die Bereitschaft. Abregelung und Modultemperatur sind selten ein Fall für die Nacht.",
    );
  }

  if (!aenderung.aktiv) {
    warnungen.push(
      "Eine abgeschaltete Regel meldet nichts mehr – auch nicht den Fall, für den sie angelegt wurde.",
    );
  }

  return { ok: fehler.length === 0, fehler, warnungen };
}

/* ------------------------------------------------------------------ */
/* Rückschau                                                           */
/* ------------------------------------------------------------------ */

export type Rauschurteil = "stumm" | "brauchbar" | "laut";

export interface Rauschbefund {
  urteil: Rauschurteil;
  /** Auslösungen je 30 Tage. */
  jeMonat: number;
  text: string;
}

/**
 * Wie sich eine Regel in der Vergangenheit verhalten hat.
 *
 * Die Zahlen stammen aus der Praxis der Anlagenüberwachung und nicht
 * aus einer Norm: Mehr als eine Meldung je Anlage und Woche liest
 * niemand durch; keine einzige in einem halben Jahr heißt entweder,
 * dass nichts passiert ist, oder dass die Regel nie greift. Beides
 * gehört angesehen.
 */
export function bewerteRauschen(
  ausloesungen: number,
  tage: number,
  anlagen = 1,
): Rauschbefund {
  if (tage <= 0 || anlagen <= 0) {
    return {
      urteil: "brauchbar",
      jeMonat: 0,
      text: "Kein Beobachtungszeitraum.",
    };
  }

  const jeMonat =
    Math.round(((ausloesungen / tage) * 30) / anlagen * 100) / 100;

  if (jeMonat > 4) {
    return {
      urteil: "laut",
      jeMonat,
      text: `Diese Regel meldet rund ${jeMonat.toFixed(1).replace(".", ",")} Mal je Monat und Anlage. Bei dieser Häufigkeit wird sie überlesen – Schwelle oder Mindestdauer gehören hinaufgesetzt.`,
    };
  }

  if (ausloesungen === 0 && tage >= 180) {
    return {
      urteil: "stumm",
      jeMonat: 0,
      text: "Diese Regel hat in einem halben Jahr nie ausgelöst. Das kann heißen, dass alles in Ordnung war – oder dass sie so eng gestellt ist, dass sie nie greift.",
    };
  }

  return {
    urteil: "brauchbar",
    jeMonat,
    text:
      ausloesungen === 0
        ? "Noch nicht ausgelöst."
        : `Rund ${jeMonat.toFixed(1).replace(".", ",")} Meldungen je Monat und Anlage.`,
  };
}
