/**
 * Grenzen für das Regelwerk der Überwachung.
 *
 * Eine Meldeschwelle lässt sich in zwei Richtungen falsch stellen, und
 * beide enden gleich:
 *
 * - Zu eng: Die Anlage meldet jede vorbeiziehende Wolke. Nach einer
 *   Woche liest niemand mehr die Meldungen, und die eine echte geht
 *   mit unter.
 * - Zu weit: Ein Strang steht zwei Monate still, und es fällt erst
 *   bei der Jahresabrechnung auf.
 *
 * Deshalb prüft diese Datei jede Änderung gegen fachliche Grenzen -
 * nicht gegen Geschmack. Die Grenzen stammen aus dem, was physikalisch
 * unterscheidbar ist: Eine Ertragsabweichung unter drei Prozent liegt
 * innerhalb der Messunsicherheit von Einstrahlungssensor und Zähler,
 * eine Meldung darüber wäre geraten.
 *
 * Der zweite Teil ist die Rückschau. Wie oft eine Regel in der
 * Vergangenheit ausgelöst hat, sagt mehr über ihre Brauchbarkeit als
 * jede Grenze: Eine Regel, die täglich meldet, ist keine Regel,
 * sondern ein Rauschen.
 */

export type Regelart =
  | "Nullertrag"
  | "Minderertrag"
  | "Strangabweichung"
  | "Kommunikation"
  | "Wechselrichterstoerung"
  | "Performance"
  | "Temperatur"
  | "Abregelung";

export type Schweregrad = "Info" | "Niedrig" | "Mittel" | "Hoch" | "Kritisch";

export const SCHWEREGRADE: Schweregrad[] = [
  "Info",
  "Niedrig",
  "Mittel",
  "Hoch",
  "Kritisch",
];

export interface Grenzen {
  /** Einheit des Schwellwerts, für die Anzeige. */
  einheit: string;
  /** Zulässiger Bereich des Schwellwerts. */
  von: number;
  bis: number;
  /** Mindestdauer in Minuten, die eine Bedingung anhalten muss. */
  dauerVon: number;
  dauerBis: number;
  /** Warum die untere Grenze dort liegt. */
  begruendung: string;
  /** Ob die Art überhaupt einen Schwellwert trägt. */
  mitSchwelle: boolean;
}

