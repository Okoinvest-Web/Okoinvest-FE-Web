/**
 * Prüfabstände des Blitzschutzsystems nach ÖVE/ÖNORM EN 62305-3.
 *
 * Die Schutzklasse ergibt sich aus der Risikoanalyse des Gebäudes.
 * "Kritisch" meint ein System, dessen Ausfall Menschen gefährdet oder
 * einen Betrieb zum Stillstand brächte; dort wird jährlich umfassend
 * geprüft, unabhängig von der Klasse.
 */
export interface BlitzschutzFristen {
  /** Sichtprüfung in Monaten. */
  sicht: number;
  /** Umfassende Prüfung in Monaten. */
  umfassend: number;
}

export function blitzschutzFristen(
  schutzklasse: 1 | 2 | 3 | 4,
  kritisch = false,
): BlitzschutzFristen {
  if (kritisch) return { sicht: 12, umfassend: 12 };
  if (schutzklasse <= 2) return { sicht: 12, umfassend: 24 };
  return { sicht: 24, umfassend: 48 };
}

