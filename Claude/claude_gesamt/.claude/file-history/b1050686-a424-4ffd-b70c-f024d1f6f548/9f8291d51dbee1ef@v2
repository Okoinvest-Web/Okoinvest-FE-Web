/**
 * Wiederkehrende Prüfungen und Wartung.
 *
 * Eine Photovoltaikanlage wird einmal abgenommen und danach
 * jahrzehntelang betrieben. Was in diesen Jahrzehnten zu prüfen ist,
 * steht nicht an einer Stelle, sondern verteilt sich auf
 * Arbeitnehmerschutzrecht, Normen, Netzzugangsbedingungen und
 * Herstellergarantien - und genau deshalb wird es übersehen. Der
 * häufigste Befund einer Betriebsprüfung ist keine kaputte Anlage,
 * sondern eine fehlende Prüfplakette.
 *
 * Diese Datei führt die Fristen zusammen und rechnet sie in Termine
 * um. Sie unterscheidet dabei, worauf eine Frist beruht:
 *
 * - *Vorschrift*: verpflichtend, mit Rechtsfolge. Die ESV 2012 ist
 *   eine Verordnung zum ArbeitnehmerInnenschutzgesetz; wer sie
 *   verletzt, haftet und verliert im Schadensfall den
 *   Versicherungsschutz.
 * - *Norm*: Stand der Technik. Nicht unmittelbar Gesetz, aber der
 *   Maßstab, an dem ein Sachverständiger misst.
 * - *Vertrag*: Netzzugang oder Herstellergarantie. Wer die Frist
 *   versäumt, verliert einen Anspruch.
 * - *Empfehlung*: wirtschaftlich sinnvoll, rechtlich frei.
 *
 * Diese Unterscheidung ist kein Etikettenschmuck. Eine Oberfläche,
 * die eine Empfehlung so dringlich darstellt wie eine Verordnung,
 * erzieht ihre Benutzer dazu, beide zu ignorieren.
 */

/* ------------------------------------------------------------------ */
/* Grundlagen                                                          */
/* ------------------------------------------------------------------ */

export type Fristart = "vorschrift" | "norm" | "vertrag" | "empfehlung";

/**
 * Umgebung nach § 9 Abs. 2 ESV 2012.
 *
 * Sie entscheidet über den Abstand der wiederkehrenden Prüfung der
 * elektrischen Anlage. Die Einstufung trifft der Betrieb, nicht diese
 * Datei - sie kennt die Räume nicht.
 */
export type Umgebung =
  | "gering"
  | "normal"
  | "explosionsgefaehrdet"
  | "aussergewoehnlich"
  | "baustelle"
  | "untertage";

/** Prüfabstand der elektrischen Anlage in Monaten, § 9 Abs. 2 ESV 2012. */
export const ESV_INTERVALL: Record<Umgebung, number> = {
  // Büro, Handel, Dienstleistung - geringe Beanspruchung, höchstens
  // zehn Jahre.
  gering: 120,
  // Der Regelfall: höchstens fünf Jahre.
  normal: 60,
  // Explosionsgefährdete Bereiche: höchstens drei Jahre.
  explosionsgefaehrdet: 36,
  // Außergewöhnliche Beanspruchung im Ex-Bereich: höchstens ein Jahr.
  aussergewoehnlich: 12,
  // Baustellen und übertägiger Rohstoffabbau: höchstens ein Jahr.
  baustelle: 12,
  // Untertagebau: höchstens sechs Monate.
  untertage: 6,
};

