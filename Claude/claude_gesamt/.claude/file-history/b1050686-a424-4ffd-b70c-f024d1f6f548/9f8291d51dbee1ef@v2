export function findeFrist(schluessel: string): Fristregel | undefined {
  return FRISTEN.find((f) => f.schluessel === schluessel);
}

/**
 * Welche Leistung aus dem Katalog eine Frist erfüllt.
 *
 * Der Weg von der überfälligen Prüfung zum Auftrag ist die Stelle, an
 * der ein Prüfkalender nützlich wird. Ohne ihn merkt sich jemand den
 * Termin, öffnet später den Leistungskatalog und sucht dort das
 * Passende - und zwischen beiden Schritten geht es verloren.
 *
 * Nicht jede Frist steht im Katalog: Die wiederkehrende Prüfung der
 * elektrischen Anlage nach ESV gehört zu einer konzessionierten
 * Elektrofachkraft und wird nicht pauschal angeboten. Wo nichts
 * hinterlegt ist, steht auch kein Knopf.
 */
export const LEISTUNG_JE_REGEL: Record<string, string> = {
  "pv-anlagenpruefung": "ART-1002",
  thermografie: "ART-1003",
  modulreinigung: "ART-1001",
};

/* ------------------------------------------------------------------ */
/* Termine                                                             */
/* ------------------------------------------------------------------ */

/** Wie viele Tage vorher ein Termin als "steht an" gilt. */
export const VORLAUF_TAGE = 60;

const TAG_MS = 24 * 60 * 60 * 1000;

/**
 * Nächste Fälligkeit nach einer Prüfung.
 *
 * Gerechnet wird in Kalendermonaten, nicht in Tagen: Eine Frist von
 * fünf Jahren läuft am selben Kalendertag ab, nicht 1825 Tage später -
 * sonst wandert der Termin bei jeder Prüfung um die Schaltjahre.
 *
 * Trifft der Stichtag auf einen Tag, den der Zielmonat nicht hat -
 * der 31. Mai plus ein Monat -, wird auf den Monatsletzten
 * zurückgesetzt statt in den Folgemonat zu rutschen.
 */
export function naechsteFaelligkeit(letzte: Date, monate: number): Date {
  const ziel = new Date(letzte.getFullYear(), letzte.getMonth() + monate, 1);
  const letzterTag = new Date(
    ziel.getFullYear(),
    ziel.getMonth() + 1,
    0,
  ).getDate();

  ziel.setDate(Math.min(letzte.getDate(), letzterTag));
  return ziel;
}

export type Terminstand = "erledigt" | "steht_an" | "ueberfaellig" | "unbekannt";

export interface Terminbefund {
  stand: Terminstand;
  /** Tage bis zur Fälligkeit; negativ, wenn sie vorbei ist. */
  tage: number;
  faellig: Date | null;
}

/**
 * Beurteilt einen Termin gegen den heutigen Tag.
 *
 * Ohne letzte Prüfung ist der Stand nicht "erledigt" und nicht
 * "überfällig", sondern unbekannt. Eine Anlage, zu der nichts
 * abgelegt ist, als geprüft zu führen wäre die gefährlichere
 * Annahme von beiden.
 */
export function bewerteTermin(
  letzte: Date | null,
  monate: number,
  heute: Date,
  vorlaufTage = VORLAUF_TAGE,
): Terminbefund {
  if (!letzte || Number.isNaN(letzte.getTime())) {
    return { stand: "unbekannt", tage: 0, faellig: null };
  }

  const faellig = naechsteFaelligkeit(letzte, monate);

  // Auf den Kalendertag gerechnet, nicht auf die Stunde: Ein Termin
  // ist am Tag seines Ablaufs noch nicht versäumt.
  const tage = Math.round(
    (new Date(
      faellig.getFullYear(),
      faellig.getMonth(),
      faellig.getDate(),
    ).getTime() -
      new Date(
        heute.getFullYear(),
        heute.getMonth(),
        heute.getDate(),
      ).getTime()) /
      TAG_MS,
  );

  if (tage < 0) return { stand: "ueberfaellig", tage, faellig };
  if (tage <= vorlaufTage) return { stand: "steht_an", tage, faellig };
  return { stand: "erledigt", tage, faellig };
}

/* ------------------------------------------------------------------ */
/* Plan                                                                */
/* ------------------------------------------------------------------ */

/** Was zu einer Anlage abgelegt ist. */
export interface Pruefstand {
  schluessel: string;
  /** Letzte durchgeführte Prüfung. */
  letzte: Date | null;
  /** Abweichender Abstand in Monaten, etwa aus einem Bescheid. */
  monate?: number;
  pruefer?: string;
  protokoll?: string;
}

export interface Wartungsposten {
  regel: Fristregel;
  /** Tatsächlich angewandter Abstand. */
  monate: number;
  /** Ob der Abstand vom Katalog abweicht. */
  abweichend: boolean;
  /** Tag der letzten Prüfung, soweit abgelegt. */
  letzte: Date | null;
  befund: Terminbefund;
  pruefer?: string;
  protokoll?: string;
}

const RANG: Record<Terminstand, number> = {
  ueberfaellig: 0,
  unbekannt: 1,
  steht_an: 2,
  erledigt: 3,
};

const ARTRANG: Record<Fristart, number> = {
  vorschrift: 0,
  vertrag: 1,
  norm: 2,
  empfehlung: 3,
};

/**
 * Stellt den Wartungsplan einer Anlage auf.
 *
 * Sortiert nach Dringlichkeit, dann nach Verbindlichkeit: Eine
 * überfällige Verordnung steht vor einer überfälligen Empfehlung, und
 * beide stehen vor allem, was noch Zeit hat.
 *
 * Die Umgebung greift nur an einer Stelle ein - beim Abstand nach der
 * ESV. Die übrigen Fristen hängen an der Anlage, nicht am Raum.
 */
export function planeWartung(
  staende: Pruefstand[],
  heute: Date,
  umgebung: Umgebung = "normal",
  regeln: Fristregel[] = FRISTEN,
): Wartungsposten[] {
  const jeSchluessel = new Map(staende.map((s) => [s.schluessel, s]));

  const posten = regeln.map((regel) => {
    const stand = jeSchluessel.get(regel.schluessel);

    const katalog =
      regel.schluessel === "esv-anlage" ? ESV_INTERVALL[umgebung] : regel.monate;
    const monate = stand?.monate ?? katalog;

    return {
      regel,
      monate,
      abweichend: monate !== regel.monate,
      letzte: stand?.letzte ?? null,
      befund: bewerteTermin(stand?.letzte ?? null, monate, heute),
      pruefer: stand?.pruefer,
      protokoll: stand?.protokoll,
    };
  });

  return posten.sort(
    (a, b) =>
      RANG[a.befund.stand] - RANG[b.befund.stand] ||
      ARTRANG[a.regel.art] - ARTRANG[b.regel.art] ||
      a.befund.tage - b.befund.tage,
  );
}

/**
 * Ein Satz über den Zustand des Plans.
 *
 * Er nennt zuerst, was versäumt ist. Eine Zusammenfassung, die mit
 * dem Erledigten beginnt, wird bis zum Ende gelesen - und die
 * schlechte Nachricht steht dort.
 */
export function fasseWartungZusammen(posten: Wartungsposten[]): string {
  const ueberfaellig = posten.filter((p) => p.befund.stand === "ueberfaellig");
  const unbekannt = posten.filter((p) => p.befund.stand === "unbekannt");
  const anstehend = posten.filter((p) => p.befund.stand === "steht_an");

  if (ueberfaellig.length > 0) {
    const pflicht = ueberfaellig.filter(
      (p) => p.regel.art === "vorschrift" || p.regel.art === "vertrag",
    ).length;

    return pflicht > 0
      ? `${ueberfaellig.length} Prüfungen sind überfällig, davon ${pflicht} verpflichtend.`
      : `${ueberfaellig.length} Prüfungen sind überfällig.`;
  }

  if (unbekannt.length > 0) {
    return `Zu ${unbekannt.length} Prüfungen ist nichts abgelegt. Ob sie stattgefunden haben, lässt sich hier nicht sagen.`;
  }

  if (anstehend.length > 0) {
    const naechster = anstehend.reduce((a, b) =>
      a.befund.tage <= b.befund.tage ? a : b,
    );
    return `${anstehend.length} Prüfungen stehen an, die nächste in ${naechster.befund.tage} Tagen.`;
  }

  return "Alle Prüfungen sind aktuell.";
}
