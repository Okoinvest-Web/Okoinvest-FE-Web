export interface ZugriffZeile {
  id: string;
  anlage_id: string;
  anlage: string;
  geraet_id: string | null;
  geraet: string | null;
  techniker: string;
  techniker_firma: string | null;
  erp_ticket: string | null;
  zweck: string;
  status: string;
  angefragt_am: string;
  freigegeben_am: string | null;
  freigegeben_von: string | null;
  gueltig_bis: string | null;
  beendet_am: string | null;
  mfa_verfahren: string | null;
  quell_ip: string | null;
  massnahmen: string | null;
  /**
   * Verbleibende Minuten des Zeitfensters, in der Datenbank gerechnet.
   * Negativ heißt abgelaufen, `null` heißt kein Fenster gesetzt.
   */
  rest_minuten: number | null;
}

export function ladeZugriffe(grenze = 20): ZugriffZeile[] {
  return alle<ZugriffZeile>(
    `SELECT z.*, a.bezeichnung AS anlage,
            g.modell AS geraet,
            CAST((julianday(z.gueltig_bis) - julianday('now')) * 1440
                 AS INTEGER) AS rest_minuten
       FROM zt_sitzung z
       JOIN anlage a ON a.id = z.anlage_id
       LEFT JOIN edge_geraet g ON g.id = z.geraet_id
      ORDER BY
        CASE z.status WHEN 'Angefragt' THEN 0 WHEN 'Aktiv' THEN 1
                      WHEN 'Freigegeben' THEN 2 ELSE 3 END,
        z.angefragt_am DESC
      LIMIT ?`,
    grenze,
  );
}

/* ------------------------------------------------------------------ */
/* Freigabe zur Inbetriebnahme                                         */
/* ------------------------------------------------------------------ */

export interface Geraetefreigabe {
  geraet: string;
  anlage: string;
  rolle: string;
  bezeichnung: string;
  befund: Freigabebefund;
}

/**
 * Der Stand der Freigabe über den ganzen Gerätebestand.
 *
 * Drei Angaben stehen nicht am Gerät selbst und werden hier
 * zusammengetragen: ob für seine Anlage ein versiegelter Sollstand
 * hinterlegt ist, ob die Protokollkette einen Eintrag zu seiner
 * Inbetriebnahme führt, und in welcher Zone es liegt.
 *
 * Der Eintrag in der Kette wird über die Gerätekennung im Inhalt
 * gesucht. Das ist eine Textsuche und deshalb nicht schön - aber die
 * Kette darf keine Fremdschlüssel tragen: Sie ist unveränderlich, und
 * ein Fremdschlüssel wäre eine Einladung, sie nachträglich zu
 * verknüpfen.
 */
export function ladeGeraetefreigaben(heute = new Date()): Geraetefreigabe[] {
  const zeilen = alle<{
    id: string;
    anlage_id: string;
    anlage: string;
    rolle: string;
    hersteller: string;
    modell: string;
    seriennummer: string | null;
    firmware: string | null;
    secure_boot: number;
    zertifikat_bis: string | null;
    fernzugang: string | null;
    vlan_nummer: number | null;
    vlan_zweck: string | null;
    sollstand: number;
    in_kette: number;
  }>(
    `SELECT g.id, g.anlage_id, a.bezeichnung AS anlage, g.rolle, g.hersteller,
            g.modell, g.seriennummer, g.firmware, g.secure_boot,
            g.zertifikat_bis, g.fernzugang,
            v.nummer AS vlan_nummer, v.zweck AS vlan_zweck,
            (SELECT COUNT(*) FROM sollparameter s
              WHERE s.anlage_id = g.anlage_id AND s.versiegelt = 1) AS sollstand,
            (SELECT COUNT(*) FROM protokollkette k
              WHERE k.anlage_id = g.anlage_id
                AND k.ereignis = 'Inbetriebnahme'
                AND k.inhalt LIKE g.id || '%') AS in_kette
       FROM edge_geraet g
       JOIN anlage a ON a.id = g.anlage_id
       LEFT JOIN vlan v ON v.id = g.vlan_id
      ORDER BY g.anlage_id, g.id`,
  );

  return zeilen.map((z) => ({
    geraet: z.id,
    anlage: z.anlage,
    rolle: z.rolle,
    bezeichnung: `${z.hersteller} ${z.modell}`,
    befund: pruefeFreigabe(
      {
        rolle: z.rolle as Geraeterolle,
        hersteller: z.hersteller,
        modell: z.modell,
        seriennummer: z.seriennummer,
        firmware: z.firmware,
        secureBoot: z.secure_boot === 1,
        vlanNummer: z.vlan_nummer,
        vlanZweck: z.vlan_zweck,
        zertifikatBis: z.zertifikat_bis
          ? ausTagesSchluessel(z.zertifikat_bis)
          : null,
        sollstandVersiegelt: z.sollstand > 0,
        inProtokollkette: z.in_kette > 0,
        fernzugang: (z.fernzugang as "Zero-Trust" | null) ?? null,
      },
      heute,
    ),
  }));
}
