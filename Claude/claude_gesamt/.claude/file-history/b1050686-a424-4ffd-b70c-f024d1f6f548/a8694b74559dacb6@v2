/**
 * Schutzschicht fuer die Anlagensteuerung.
 *
 * Hintergrund: Ein Teil der Regelparameter einer PV-Anlage ist
 * netzbetreiber- bzw. normseitig vorgegeben (TOR Erzeuger, ÖVE/ÖNORM
 * E 8001-4-712, Netz- und Anlagenschutz). Diese Werte darf ein Kunde
 * nicht veraendern - eine Aenderung kann den Netzparallelbetrieb
 * unzulaessig machen, Menschen gefaehrden und den Versicherungsschutz
 * kosten.
 *
 * Deshalb steht die Sperre HIER, im Servercode, und nicht nur in der
 * Oberflaeche: Ein ausgeblendetes Eingabefeld laesst sich umgehen,
 * ein serverseitig abgelehnter Schreibvorgang nicht.
 *
 * Jede Steuerungsaenderung laeuft durch `pruefeParameter()`.
 */

export type ParameterGruppe =
  | "eigenverbrauch"
  | "speicher"
  | "boerse"
  | "laden"
  | "netzschutz"
  | "einspeiseregelung";

export interface ParameterDefinition {
  schluessel: string;
  bezeichnung: string;
  gruppe: ParameterGruppe;
  einheit?: string;
  /**
   * Gesperrt = netzbetreiber- oder normseitig vorgegeben.
   * Nur der Netzbetreiber oder ein autorisierter Errichter darf das
   * aendern, niemals der Portalbenutzer.
   */
  gesperrt: boolean;
  /** Rechtsgrundlage - wird dem Benutzer als Begruendung angezeigt. */
  grundlage?: string;
  min?: number;
  max?: number;
  /** Erlaubte Werte bei Auswahlfeldern. */
  optionen?: string[];
  /** Kurze Erklaerung fuer die Oberflaeche. */
  hinweis?: string;
}

