const NACH_SCHLUESSEL = new Map(PARAMETER.map((p) => [p.schluessel, p]));

export function findeParameter(
  schluessel: string,
): ParameterDefinition | undefined {
  return NACH_SCHLUESSEL.get(schluessel);
}

export function istGesperrt(schluessel: string): boolean {
  // Unbekannt wird wie gesperrt behandelt - im Zweifel nicht schreiben.
  return findeParameter(schluessel)?.gesperrt ?? true;
}

export type PruefErgebnis =
  | { erlaubt: true; wert: number | string }
  | { erlaubt: false; grund: string };

/**
 * Einzige zugelassene Stelle, an der ein Steuerungswert freigegeben wird.
 *
 * Prueft in dieser Reihenfolge:
 *   1. Ist der Parameter ueberhaupt bekannt?  (Positivliste)
 *   2. Ist er gesperrt?                       (Gesetz / Netzbetreiber)
 *   3. Liegt der Wert im zulaessigen Bereich? (Plausibilitaet)
 */
export function pruefeParameter(
  schluessel: string,
  rohwert: unknown,
): PruefErgebnis {
  const definition = findeParameter(schluessel);

  if (!definition) {
    return {
      erlaubt: false,
      grund: `Unbekannter Parameter "${schluessel}". Die Änderung wurde abgelehnt.`,
    };
  }

  if (definition.gesperrt) {
    return {
      erlaubt: false,
      grund:
        definition.grundlage ??
        "Dieser Parameter ist netzseitig vorgegeben und kann im Portal nicht geändert werden.",
    };
  }

  if (definition.optionen) {
    const wert = String(rohwert);
    if (!definition.optionen.includes(wert)) {
      return {
        erlaubt: false,
        grund: `Unzulässiger Wert. Erlaubt sind: ${definition.optionen.join(", ")}.`,
      };
    }
    return { erlaubt: true, wert };
  }

  // Number("") und Number([]) ergeben beide 0. Ohne diese Pruefung wuerde
  // ein leer abgesendetes Feld den Parameter stillschweigend auf 0 setzen -
  // bei der Notstromreserve etwa hiesse das: keine Reserve mehr.
  if (typeof rohwert !== "number" && typeof rohwert !== "string") {
    return { erlaubt: false, grund: "Der Wert ist keine gültige Zahl." };
  }
  if (typeof rohwert === "string" && rohwert.trim() === "") {
    return { erlaubt: false, grund: "Bitte einen Wert angeben." };
  }

  const zahl = typeof rohwert === "number" ? rohwert : Number(rohwert);
  if (!Number.isFinite(zahl)) {
    return { erlaubt: false, grund: "Der Wert ist keine gültige Zahl." };
  }

  const einheit = definition.einheit ? ` ${definition.einheit}` : "";

  if (definition.min !== undefined && zahl < definition.min) {
    return {
      erlaubt: false,
      grund: `Wert unter dem zulässigen Minimum von ${definition.min}${einheit}.`,
    };
  }

  if (definition.max !== undefined && zahl > definition.max) {
    return {
      erlaubt: false,
      grund: `Wert über dem zulässigen Maximum von ${definition.max}${einheit}.`,
    };
  }

  return { erlaubt: true, wert: zahl };
}

export function parameterDerGruppe(
  gruppe: ParameterGruppe,
): ParameterDefinition[] {
  return PARAMETER.filter((p) => p.gruppe === gruppe);
}
