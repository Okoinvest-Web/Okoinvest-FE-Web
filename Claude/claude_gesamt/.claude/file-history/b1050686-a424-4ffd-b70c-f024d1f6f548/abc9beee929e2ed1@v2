/**
 * Prüfung von Perimeterregeln.
 *
 * Eine Firewallregel ist der seltene Fall, in dem ein Tippfehler zwei
 * entgegengesetzte Katastrophen auslösen kann: Sie sperrt den Betrieb
 * aus seiner eigenen Anlage aus, oder sie öffnet sie für alle. Beides
 * fällt ohne Prüfung erst auf, wenn es zu spät ist - im ersten Fall
 * beim nächsten Anruf, im zweiten gar nicht.
 *
 * Die Regelsprache ist deshalb absichtlich eng: drei Arten, ein Wert
 * je Regel. Wer eine freie Regelsprache anbietet, bekommt Regeln, die
 * niemand mehr versteht.
 */

export type Regelart = "Geosperre" | "Ratenbegrenzung" | "Subnetzfreigabe";
export type Regelaktion = "blockieren" | "begrenzen" | "erlauben";

/** Welche Aktion zu welcher Art gehört. Es gibt je Art genau eine. */
export const AKTION_ZU_ART: Record<Regelart, Regelaktion> = {
  Geosperre: "blockieren",
  Ratenbegrenzung: "begrenzen",
  Subnetzfreigabe: "erlauben",
};

/**
 * Länder, die als Herkunft vorkommen.
 *
 * Bewusst eine Liste und kein freies Textfeld: "AU" statt "AT" ist ein
 * Tastendreher, der Australien sperrt und Österreich offen lässt -
 * und in einer Trefferstatistik jahrelang unauffällig bleibt.
 */
export const LAENDER: { code: string; name: string }[] = [
  { code: "AT", name: "Österreich" },
  { code: "DE", name: "Deutschland" },
  { code: "NL", name: "Niederlande" },
  { code: "FR", name: "Frankreich" },
  { code: "CH", name: "Schweiz" },
  { code: "IT", name: "Italien" },
  { code: "SI", name: "Slowenien" },
  { code: "SK", name: "Slowakei" },
  { code: "CZ", name: "Tschechien" },
  { code: "HU", name: "Ungarn" },
  { code: "PL", name: "Polen" },
  { code: "RU", name: "Russische Föderation" },
  { code: "BY", name: "Belarus" },
  { code: "CN", name: "China" },
  { code: "IR", name: "Iran" },
  { code: "KP", name: "Nordkorea" },
  { code: "BR", name: "Brasilien" },
  { code: "IN", name: "Indien" },
  { code: "VN", name: "Vietnam" },
  { code: "US", name: "Vereinigte Staaten" },
];

/**
 * Das Land, in dem der Betrieb sitzt.
 *
 * Es zu sperren hieße, sich selbst auszusperren: Die Techniker, die
 * Fernwartung und das Portal kommen von hier.
 */
export const EIGENES_LAND = "AT";

/** Kleinste zulässige Präfixlänge einer Freigabe. */
export const KLEINSTES_PRAEFIX = 16;

export interface Regelentwurf {
  art: Regelart;
  bezeichnung: string;
  wert: string;
}

export interface Regelpruefung {
  gueltig: boolean;
  /** Der auf Normalform gebrachte Wert, etwa "10.20.0.0/16". */
  wert: string;
  aktion: Regelaktion;
  beanstandungen: string[];
  /** Hinweise, die nicht blockieren, aber jemand lesen sollte. */
  warnungen: string[];
}

/* ------------------------------------------------------------------ */
/* Netzadressen                                                        */
/* ------------------------------------------------------------------ */

export interface Netzbereich {
  /** Die vier Oktette der Netzadresse. */
  oktette: [number, number, number, number];
  praefix: number;
  /** Anzahl Adressen im Bereich. */
  adressen: number;
  /** Normalform, etwa "10.20.0.0/16". */
  text: string;
  /** Lag im eingegebenen Wert ein Hostanteil, der abgeschnitten wurde? */
  gekuerzt: boolean;
}

/**
 * Zerlegt eine CIDR-Angabe.
 *
 * Ein gesetztes Bit hinter der Präfixlänge - etwa 10.20.30.40/16 -
 * ist keine Netzadresse, sondern ein Host darin. Statt das
 * zurückzuweisen, wird auf das Netz gekürzt und der Eingriff
 * gemeldet: Gemeint war fast immer 10.20.0.0/16, und ein Formular,
 * das bei so etwas nur "ungültig" sagt, kostet zehn Minuten.
 */
export function lieseNetzbereich(text: string): Netzbereich | null {
  const sauber = text.trim();
  const teile = sauber.split("/");
  if (teile.length !== 2) return null;

  const adresse = teile[0]!.split(".");
  if (adresse.length !== 4) return null;

  const oktette: number[] = [];
  for (const o of adresse) {
    if (!/^\d{1,3}$/.test(o)) return null;
    const zahl = Number(o);
    if (zahl > 255) return null;
    oktette.push(zahl);
  }

  if (!/^\d{1,2}$/.test(teile[1]!)) return null;
  const praefix = Number(teile[1]);
  if (praefix > 32) return null;

  // Als 32-Bit-Zahl rechnen und die Hostbits streichen.
  const roh =
    ((oktette[0]! << 24) >>> 0) +
    (oktette[1]! << 16) +
    (oktette[2]! << 8) +
    oktette[3]!;
  const maske = praefix === 0 ? 0 : (0xffffffff << (32 - praefix)) >>> 0;
  const netz = (roh & maske) >>> 0;

  const norm: [number, number, number, number] = [
    (netz >>> 24) & 255,
    (netz >>> 16) & 255,
    (netz >>> 8) & 255,
    netz & 255,
  ];

  return {
    oktette: norm,
    praefix,
    adressen: 2 ** (32 - praefix),
    text: `${norm.join(".")}/${praefix}`,
    gekuerzt: netz !== roh,
  };
}

/**
 * Liegt der Bereich in einem privaten Adressraum nach RFC 1918?
 *
 * Eine private Adresse am Perimeter freizugeben hat keine Wirkung:
 * Aus dem Internet kommt niemand mit 192.168.1.10 an. Das ist kein
 * Fehler, aber fast immer ein Missverständnis.
 */
export function istPrivat(bereich: Netzbereich): boolean {
  const [a, b] = bereich.oktette;
  if (a === 10) return true;
  if (a === 192 && b === 168) return true;
  if (a === 172 && b! >= 16 && b! <= 31) return true;
  if (a === 127) return true;
  return false;
}

/* ------------------------------------------------------------------ */
/* Die Prüfung                                                         */
/* ------------------------------------------------------------------ */

/**
 * Prüft einen Regelentwurf, bevor er auf ein Gateway geht.
 *
 * Beanstandungen verhindern das Anlegen, Warnungen nicht. Die
 * Trennung ist wichtig: Eine Regel, die nur ungewöhnlich ist, muss
 * sich anlegen lassen - sonst baut sich jemand einen Weg daran vorbei.
 */
export function pruefeRegel(entwurf: Regelentwurf): Regelpruefung {
  const beanstandungen: string[] = [];
  const warnungen: string[] = [];
  let wert = entwurf.wert.trim();

  if (entwurf.bezeichnung.trim().length < 3) {
    beanstandungen.push(
      "Die Regel braucht eine Bezeichnung. Wer sie in einem Jahr liest, muss ohne Rückfrage wissen, wofür sie da ist.",
    );
  }

  switch (entwurf.art) {
    case "Geosperre": {
      wert = wert.toUpperCase();

      if (!LAENDER.some((l) => l.code === wert)) {
        beanstandungen.push(
          `"${wert}" ist kein hinterlegter Ländercode.`,
        );
        break;
      }

      if (wert === EIGENES_LAND) {
        beanstandungen.push(
          "Das eigene Land lässt sich nicht sperren. Damit wären Portal, Fernwartung und Technikerzugriff gleichzeitig ausgesperrt.",
        );
      }

      if (["DE", "CH"].includes(wert)) {
        warnungen.push(
          `${wert} zu sperren trifft auch Lieferanten und Roamingpartner, die üblicherweise von dort zugreifen.`,
        );
      }
      break;
    }

    case "Ratenbegrenzung": {
      if (!/^\d+$/.test(wert)) {
        beanstandungen.push(
          "Die Ratenbegrenzung ist eine ganze Zahl: Anfragen je Minute.",
        );
        break;
      }

      const rate = Number(wert);

      if (rate < 1) {
        beanstandungen.push(
          "Null Anfragen je Minute wäre eine Sperre, keine Begrenzung.",
        );
        break;
      }

      if (rate > 10000) {
        beanstandungen.push(
          "Über 10.000 Anfragen je Minute begrenzt praktisch nichts mehr.",
        );
        break;
      }

      // Zehn Anmeldeversuche je Minute sind gute Praxis und keine
      // Fehlbedienung. Darunter wird es eng: Das Portal laedt je
      // Seitenaufruf mehrere Ressourcen, und ein Steuerrechner meldet
      // sich im Sekundentakt - eine zu scharfe Grenze trifft dann den
      // eigenen Betrieb zuerst.
      if (rate < 10) {
        warnungen.push(
          `${rate} Anfragen je Minute ist knapp: Ein Seitenaufruf des Portals erzeugt allein mehrere Anfragen.`,
        );
      }
      break;
    }

    case "Subnetzfreigabe": {
      const bereich = lieseNetzbereich(wert);

      if (!bereich) {
        beanstandungen.push(
          `"${wert}" ist keine gültige Netzangabe. Erwartet wird etwa 193.154.0.0/16.`,
        );
        break;
      }

      if (bereich.praefix < KLEINSTES_PRAEFIX) {
        beanstandungen.push(
          `/${bereich.praefix} gibt ${bereich.adressen.toLocaleString("de-AT")} Adressen frei. Freigaben sind erst ab /${KLEINSTES_PRAEFIX} zulässig.`,
        );
        break;
      }

      wert = bereich.text;

      if (bereich.gekuerzt) {
        warnungen.push(
          `Der Hostanteil wurde gestrichen: Die Regel gilt für ${bereich.text}.`,
        );
      }

      if (bereich.praefix < 24) {
        warnungen.push(
          `Die Freigabe umfasst ${bereich.adressen.toLocaleString("de-AT")} Adressen. Enger ist sicherer.`,
        );
      }

      if (istPrivat(bereich)) {
        warnungen.push(
          "Das ist ein privater Adressbereich. Am Perimeter hat eine solche Freigabe keine Wirkung - von außen kommt niemand mit dieser Adresse an.",
        );
      }
      break;
    }
  }

  return {
    gueltig: beanstandungen.length === 0,
    wert,
    aktion: AKTION_ZU_ART[entwurf.art],
    beanstandungen,
    warnungen,
  };
}

/** Klartext zu einem Ländercode. */
export function landesname(code: string): string {
  return LAENDER.find((l) => l.code === code)?.name ?? code;
}

/**
 * Beschreibt eine Regel in einem Satz.
 *
 * Steht in der Tabelle unter der Bezeichnung. Der rohe Wert - "16"
 * oder "CN" - sagt jemandem, der die Regel nicht angelegt hat, nichts.
 */
export function regelsatz(art: string, wert: string): string {
  switch (art) {
    case "Geosperre":
      return `Zugriffe aus ${landesname(wert)} werden am Perimeter abgewiesen.`;
    case "Ratenbegrenzung":
      return `Mehr als ${wert} Anfragen je Minute je Quelladresse werden verzögert.`;
    case "Subnetzfreigabe": {
      const bereich = lieseNetzbereich(wert);
      return bereich
        ? `${bereich.adressen.toLocaleString("de-AT")} Adressen aus ${bereich.text} dürfen den Tunnel aufbauen.`
        : `${wert} darf den Tunnel aufbauen.`;
    }
    default:
      return wert;
  }
}
