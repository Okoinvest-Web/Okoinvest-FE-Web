import assert from "node:assert/strict";
import { describe, it } from "node:test";

import { baueMscons, pruefeMscons } from "./mscons.ts";
import {
  erwarteteIntervalle,
  meldungsDateiname,
  OBIS_BEZUG,
  OBIS_EINSPEISUNG,
  stelleMeldungZusammen,
  uebertragungsreferenz,
  type Aufteilungszeile,
} from "./messmeldung.ts";

const ZP_VERBRAUCH = "AT2000000310000100000000000012345";
const ZP_ERZEUGUNG = "AT2000000310000100000000000054321";

/** Ein Tag mit vier Viertelstunden, damit die Zahlen nachrechenbar bleiben. */
function tag(
  zaehlpunkt: string,
  mengen: { bezogen?: number; geliefert?: number; qualitaet?: string }[],
  beginn = Date.UTC(2026, 6, 1, 10, 0),
): Aufteilungszeile[] {
  return mengen.map((m, i) => ({
    zaehlpunkt,
    zeitpunkt: new Date(beginn + i * 15 * 60_000).toISOString().slice(0, 16) + "Z",
    bezogenKwh: m.bezogen ?? 0,
    geliefertKwh: m.geliefert ?? 0,
    qualitaet: m.qualitaet,
  }));
}

const ZEITRAUM = {
  von: new Date(Date.UTC(2026, 6, 1, 10, 0)),
  bis: new Date(Date.UTC(2026, 6, 1, 11, 0)),
};

describe("Erwartete Intervalle", () => {
  it("zählt eine Stunde als vier Viertelstunden", () => {
    assert.equal(erwarteteIntervalle(ZEITRAUM.von, ZEITRAUM.bis), 4);
  });

  it("zählt den Tag der Zeitumstellung im Oktober länger", () => {
    // In Wien hat der letzte Oktobersonntag 25 Stunden.
    const von = new Date(Date.UTC(2026, 9, 24, 22, 0));
    const bis = new Date(Date.UTC(2026, 9, 25, 23, 0));

    assert.equal(erwarteteIntervalle(von, bis), 100);
  });

  it("gibt bei umgekehrter Reihenfolge null zurück", () => {
    assert.equal(erwarteteIntervalle(ZEITRAUM.bis, ZEITRAUM.von), 0);
  });
});

describe("Meldung zusammenstellen", () => {
  it("trennt Bezug und Einspeisung nach OBIS-Kennzahl", () => {
    const bestand = stelleMeldungZusammen(
      [
        ...tag(ZP_VERBRAUCH, [
          { bezogen: 1 },
          { bezogen: 2 },
          { bezogen: 3 },
          { bezogen: 4 },
        ]),
        ...tag(ZP_ERZEUGUNG, [
          { geliefert: 5 },
          { geliefert: 5 },
          { geliefert: 5 },
          { geliefert: 5 },
        ]),
      ],
      ZEITRAUM,
    );

    assert.equal(bestand.reihen.length, 2);
    assert.equal(bestand.reihen[0]!.obis, OBIS_BEZUG);
    assert.equal(bestand.reihen[1]!.obis, OBIS_EINSPEISUNG);
    assert.equal(bestand.summeBezugKwh, 10);
    assert.equal(bestand.summeEinspeisungKwh, 20);
  });

  it("führt einen Zählpunkt mit beiden Richtungen in zwei Reihen", () => {
    // Ein Speicher bezieht und liefert in derselben Viertelstunde.
    const bestand = stelleMeldungZusammen(
      tag(ZP_VERBRAUCH, [
        { bezogen: 1, geliefert: 0.5 },
        { bezogen: 1, geliefert: 0.5 },
        { bezogen: 1, geliefert: 0.5 },
        { bezogen: 1, geliefert: 0.5 },
      ]),
      ZEITRAUM,
    );

    assert.equal(bestand.reihen.length, 2);
    assert.deepEqual(
      bestand.reihen.map((r) => r.zaehlpunkt),
      [ZP_VERBRAUCH, ZP_VERBRAUCH],
    );
    assert.equal(bestand.werte, 8);
  });

  it("hängt keine leere Reihe an", () => {
    const bestand = stelleMeldungZusammen(
      tag(ZP_VERBRAUCH, [
        { bezogen: 1 },
        { bezogen: 1 },
        { bezogen: 1 },
        { bezogen: 1 },
      ]),
      ZEITRAUM,
    );

    assert.equal(bestand.reihen.length, 1);
  });

  it("lässt eine Viertelstunde ohne Fluss aus", () => {
    // Nachts fließt aus der Gemeinschaft nichts. Eine Null zu melden
    // wäre nicht falsch, aber der Empfänger unterscheidet sie nicht
    // von einem fehlenden Wert.
    const bestand = stelleMeldungZusammen(
      tag(ZP_VERBRAUCH, [
        { bezogen: 1 },
        { bezogen: 0 },
        { bezogen: 2 },
        { bezogen: 0 },
      ]),
      ZEITRAUM,
    );

    assert.equal(bestand.werte, 2);
    // Der Zeitraum gilt trotzdem als vollständig - die Intervalle
    // lagen vor, sie waren nur leer.
    assert.deepEqual(bestand.beanstandungen, []);
  });

  it("setzt Beginn und Ende eine Viertelstunde auseinander", () => {
    const bestand = stelleMeldungZusammen(
      tag(ZP_VERBRAUCH, [{ bezogen: 1 }]),
      { von: ZEITRAUM.von, bis: new Date(ZEITRAUM.von.getTime() + 900_000) },
    );

    const wert = bestand.reihen[0]!.werte[0]!;
    assert.equal(wert.bis.getTime() - wert.von.getTime(), 900_000);
  });

  it("kennzeichnet einen Ersatzwert als nicht gemessen", () => {
    const bestand = stelleMeldungZusammen(
      tag(ZP_VERBRAUCH, [{ bezogen: 1, qualitaet: "Ersatzwert" }]),
      { von: ZEITRAUM.von, bis: new Date(ZEITRAUM.von.getTime() + 900_000) },
    );

    assert.equal(bestand.reihen[0]!.werte[0]!.gemessen, false);
  });

  it("rundet auf die Wattstunde", () => {
    const bestand = stelleMeldungZusammen(
      tag(ZP_VERBRAUCH, [{ bezogen: 1.23456789 }]),
      { von: ZEITRAUM.von, bis: new Date(ZEITRAUM.von.getTime() + 900_000) },
    );

    assert.equal(bestand.reihen[0]!.werte[0]!.wertKwh, 1.235);
  });

  it("meldet fehlende Intervalle", () => {
    const bestand = stelleMeldungZusammen(
      tag(ZP_VERBRAUCH, [{ bezogen: 1 }, { bezogen: 1 }]),
      ZEITRAUM,
    );

    assert.match(bestand.beanstandungen.join(" "), /fehlen 2 von 4/);
  });

  it("erkennt einen doppelten Zeitpunkt", () => {
    const zeilen = tag(ZP_VERBRAUCH, [{ bezogen: 1 }]);
    const bestand = stelleMeldungZusammen([...zeilen, ...zeilen], {
      von: ZEITRAUM.von,
      bis: new Date(ZEITRAUM.von.getTime() + 900_000),
    });

    assert.match(bestand.beanstandungen.join(" "), /doppelt/);
    // Der doppelte Wert darf die Summe nicht verfälschen.
    assert.equal(bestand.summeBezugKwh, 1);
  });

  it("sagt es, wenn nichts aufgeteilt wurde", () => {
    const bestand = stelleMeldungZusammen([], ZEITRAUM);

    assert.equal(bestand.reihen.length, 0);
    assert.match(bestand.beanstandungen.join(" "), /nichts aufgeteilt/);
  });

  it("ordnet nach Zählpunkt und Zeit, auch bei verdrehter Eingabe", () => {
    const zeilen = tag(ZP_VERBRAUCH, [
      { bezogen: 1 },
      { bezogen: 2 },
      { bezogen: 3 },
      { bezogen: 4 },
    ]);

    const bestand = stelleMeldungZusammen([...zeilen].reverse(), ZEITRAUM);

    assert.deepEqual(
      bestand.reihen[0]!.werte.map((w) => w.wertKwh),
      [1, 2, 3, 4],
    );
  });
});

describe("Zusammenspiel mit MSCONS", () => {
  it("erzeugt aus einer Aufteilung eine gültige Nachricht", () => {
    const bestand = stelleMeldungZusammen(
      [
        ...tag(ZP_VERBRAUCH, [
          { bezogen: 1.5 },
          { bezogen: 2.25 },
          { bezogen: 0 },
          { bezogen: 4 },
        ]),
        ...tag(ZP_ERZEUGUNG, [
          { geliefert: 7.777 },
          { geliefert: 8 },
          { geliefert: 9 },
          { geliefert: 10 },
        ]),
      ],
      ZEITRAUM,
    );

    const erzeugtAm = new Date(Date.UTC(2026, 6, 2, 6, 0));
    const nachricht = baueMscons(
      {
        uebertragung: uebertragungsreferenz("ABR-0007", erzeugtAm),
        nachricht: "1",
        dokument: "ABR-0007",
        erstelltAm: erzeugtAm,
        versatzMinuten: 120,
        absender: { kennung: "9900000000001", schema: "9" },
        empfaenger: { kennung: "9900000000002", schema: "9" },
      },
      bestand.reihen,
    );

    const pruefung = pruefeMscons(nachricht);

    assert.ok(pruefung.gueltig, pruefung.beanstandungen.join(" | "));
    assert.equal(pruefung.werte, bestand.werte);
    assert.equal(
      pruefung.summeKwh,
      Math.round((bestand.summeBezugKwh + bestand.summeEinspeisungKwh) * 1000) /
        1000,
    );
  });
});

describe("Referenz und Dateiname", () => {
  it("hält die Übertragungsreferenz innerhalb von 14 Stellen", () => {
    const referenz = uebertragungsreferenz(
      "ABR-2026-Q3-0001",
      new Date(Date.UTC(2026, 6, 2, 6, 0)),
    );

    assert.ok(referenz.length <= 14, referenz);
  });

  it("unterscheidet zwei Übertragungen desselben Laufs", () => {
    const a = uebertragungsreferenz("ABR-0007", new Date(Date.UTC(2026, 6, 2, 6, 0)));
    const b = uebertragungsreferenz("ABR-0007", new Date(Date.UTC(2026, 6, 2, 6, 1)));

    assert.notEqual(a, b);
  });

  it("nennt den Lauf im Dateinamen", () => {
    const name = meldungsDateiname("ABR-0007", new Date(Date.UTC(2026, 6, 2, 6, 0)));

    assert.match(name, /^MSCONS_ABR-0007_\d{12}\.edi$/);
  });
});
