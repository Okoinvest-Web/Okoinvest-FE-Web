/* ------------------------------------------------------------------ */
/* Prüfung                                                             */
/* ------------------------------------------------------------------ */

/** Ergebnis eines einzelnen Kriteriums. */
export type Nachweisstand = "erfuellt" | "nicht_erfuellt" | "offen";

/** Was zu den Kriterien vorliegt, je Schlüssel. */
export type Nachweislage = Record<string, Nachweisstand | undefined>;

/**
 * Wie eine Tätigkeit oder eine Position einzustufen ist.
 *
 * "nicht_faehig" entsteht nie aus einer Prüfung: Was im Katalog steht,
 * ist fähig. Die Einstufung trifft Beträge, die keiner Tätigkeit des
 * Anhangs zugeordnet sind - der Getränkeautomat in der Werkshalle.
 */
export type Einstufung = "nicht_faehig" | "faehig" | "konform" | "offen";

export interface Taetigkeitsbefund {
  taetigkeit: Taetigkeit;
  einstufung: Einstufung;
  /** Kriterien, die verletzt sind. */
  verletzt: Kriterium[];
  /** Kriterien, zu denen noch nichts vorliegt. */
  offen: Kriterium[];
  /** Ein Satz, der das Ergebnis erklärt. */
  begruendung: string;
}

function stand(lage: Nachweislage, schluessel: string): Nachweisstand {
  return lage[schluessel] ?? "offen";
}

/**
 * Prüft eine Tätigkeit gegen die vorliegenden Nachweise.
 *
 * Der Mindestschutz geht in jede Tätigkeit ein, weil er in jeder
 * Tätigkeit Bedingung ist. Ein Betrieb ohne Sorgfaltsprüfung hat
 * keine konforme Tätigkeit - das ist der Punkt, an dem die Taxonomie
 * mehr ist als eine Technikliste.
 */
export function pruefeTaetigkeit(
  taetigkeit: Taetigkeit,
  lage: Nachweislage,
  mindestschutz: Nachweislage = lage,
): Taetigkeitsbefund {
  const verletzt: Kriterium[] = [];
  const offen: Kriterium[] = [];

  const alle = [taetigkeit.beitrag, ...taetigkeit.dnsh, ...MINDESTSCHUTZ];

  for (const kriterium of alle) {
    const quelle = MINDESTSCHUTZ.includes(kriterium) ? mindestschutz : lage;
    const s = stand(quelle, kriterium.schluessel);
    if (s === "nicht_erfuellt") verletzt.push(kriterium);
    else if (s === "offen") offen.push(kriterium);
  }

  // Der wesentliche Beitrag ist die Trennlinie zwischen "fähig" und
  // allem darüber. Fällt er, ist die Tätigkeit zwar weiterhin im
  // Anhang genannt - also fähig -, aber nicht konform.
  const beitragVerletzt = verletzt.includes(taetigkeit.beitrag);

  let einstufung: Einstufung;
  let begruendung: string;

  if (beitragVerletzt) {
    einstufung = "faehig";
    begruendung =
      "Der wesentliche Beitrag ist nicht belegt. Die Tätigkeit bleibt taxonomiefähig, ist aber nicht konform.";
  } else if (verletzt.length > 0) {
    einstufung = "faehig";
    begruendung = `${verletzt.length === 1 ? "Ein Kriterium ist" : `${verletzt.length} Kriterien sind`} verletzt: ${verletzt
      .map((k) => ZIELNAMEN[k.ziel])
      .join(", ")}. Taxonomiefähig, nicht konform.`;
  } else if (offen.length > 0) {
    einstufung = "offen";
    begruendung = `${offen.length === 1 ? "Ein Nachweis fehlt" : `${offen.length} Nachweise fehlen`} noch. Bis dahin ist die Tätigkeit weder als konform noch als nicht konform zu melden.`;
  } else {
    einstufung = "konform";
    begruendung =
      "Wesentlicher Beitrag, alle DNSH-Kriterien und der Mindestschutz sind belegt.";
  }

  return { taetigkeit, einstufung, verletzt, offen, begruendung };
}

/* ------------------------------------------------------------------ */
/* Kennzahlen                                                          */
/* ------------------------------------------------------------------ */

export const KENNZAHLARTEN = ["Umsatz", "CapEx", "OpEx"] as const;
export type Kennzahlart = (typeof KENNZAHLARTEN)[number];

/**
 * Die Wesentlichkeitsschwelle aus der Vereinfachung vom Juli 2025.
 *
 * Tätigkeiten unterhalb von 10 % des Nenners dürfen als unwesentlich
 * behandelt und aus dem Meldebogen gelassen werden. Gerechnet wird die
 * Schwelle je Kennzahl, nicht über alle hinweg: Eine Tätigkeit kann
 * beim Umsatz unwesentlich und beim CapEx wesentlich sein - genau so
 * sieht es bei einem Betrieb aus, der gerade in Photovoltaik
 * investiert und damit noch kaum Umsatz macht.
 */
export const WESENTLICHKEITSSCHWELLE = 0.1;

export interface Kennzahlposition {
  /** Schlüssel der Tätigkeit, etwa "4.1". */
  taetigkeit: string;
  bezeichnung: string;
  betrag: number;
  /** Ergebnis der Prüfung dieser Tätigkeit. */
  einstufung: Einstufung;
}

export interface Kennzahlergebnis {
  art: Kennzahlart;
  /** Gesamtwert des Unternehmens - der Nenner. */
  nenner: number;
  faehigBetrag: number;
  konformBetrag: number;
  faehigAnteil: number;
  konformAnteil: number;
  /** Betrag, der auf noch offene Tätigkeiten entfällt. */
  offenBetrag: number;
  /** Positionen unterhalb der Wesentlichkeitsschwelle. */
  unwesentlich: Kennzahlposition[];
  beanstandungen: string[];
}

function anteil(teil: number, ganzes: number): number {
  if (!(ganzes > 0)) return 0;
  return Math.round((teil / ganzes) * 10000) / 10000;
}

/**
 * Rechnet eine Kennzahl aus.
 *
 * Der Nenner kommt aus dem Jahresabschluss und nicht aus der Summe
 * der Positionen: Was nicht zugeordnet ist, gehört trotzdem dazu.
 * Übersteigt die Summe der Positionen den Nenner, ist etwas doppelt
 * zugeordnet - das ist der häufigste Fehler bei CapEx, weil dieselbe
 * Investition leicht unter 4.1 und 7.6 landet.
 */
export function berechneKennzahl(
  art: Kennzahlart,
  nenner: number,
  positionen: Kennzahlposition[],
): Kennzahlergebnis {
  const beanstandungen: string[] = [];

  const summe = positionen.reduce((s, p) => s + p.betrag, 0);

  if (nenner <= 0) {
    beanstandungen.push(
      `Der Nenner der Kennzahl ${art} ist null. Ein Anteil lässt sich daraus nicht bilden.`,
    );
  } else if (summe > nenner * 1.0001) {
    beanstandungen.push(
      `Die zugeordneten Beträge übersteigen den Nenner der Kennzahl ${art}. Eine Position ist doppelt zugeordnet.`,
    );
  }

  for (const p of positionen) {
    if (p.betrag < 0) {
      beanstandungen.push(
        `Die Position "${p.bezeichnung}" trägt einen negativen Betrag. Kennzahlen der Taxonomie kennen keine negativen Anteile.`,
      );
    }
  }

  const faehigBetrag = positionen.reduce(
    (s, p) => (p.einstufung === "nicht_faehig" ? s : s + p.betrag),
    0,
  );
  const konformBetrag = positionen.reduce(
    (s, p) => (p.einstufung === "konform" ? s + p.betrag : s),
    0,
  );
  const offenBetrag = positionen.reduce(
    (s, p) => (p.einstufung === "offen" ? s + p.betrag : s),
    0,
  );

  const unwesentlich =
    nenner > 0
      ? positionen.filter((p) => p.betrag / nenner < WESENTLICHKEITSSCHWELLE)
      : [];

  return {
    art,
    nenner,
    faehigBetrag,
    konformBetrag,
    offenBetrag,
    faehigAnteil: anteil(faehigBetrag, nenner),
    konformAnteil: anteil(konformBetrag, nenner),
    unwesentlich,
    beanstandungen,
  };
}

/* ------------------------------------------------------------------ */
/* Zusammenfassung                                                     */
/* ------------------------------------------------------------------ */

/**
 * Ein Satz, der das Ergebnis trägt.
 *
 * Er nennt zuerst die Konformität und nicht die Fähigkeit. Berichte,
 * die mit der Fähigkeit aufmachen, lesen sich besser und sagen
 * weniger - taxonomiefähig ist ein Kohlekraftwerk auch.
 */
export function fasseKennzahlZusammen(ergebnis: Kennzahlergebnis): string {
  if (ergebnis.nenner <= 0) {
    return `${ergebnis.art}: kein Nenner hinterlegt.`;
  }

  const konform = (ergebnis.konformAnteil * 100).toFixed(1).replace(".", ",");
  const faehig = (ergebnis.faehigAnteil * 100).toFixed(1).replace(".", ",");

  const offen =
    ergebnis.offenBetrag > 0
      ? ` ${((ergebnis.offenBetrag / ergebnis.nenner) * 100).toFixed(1).replace(".", ",")} % hängen an offenen Nachweisen.`
      : "";

  return `${ergebnis.art}: ${konform} % taxonomiekonform, ${faehig} % taxonomiefähig.${offen}`;
}
