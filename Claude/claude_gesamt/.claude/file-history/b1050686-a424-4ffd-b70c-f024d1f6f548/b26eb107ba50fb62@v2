export interface Kriterium {
  /** Kennung, unter der der Nachweis geführt wird. */
  schluessel: string;
  /** Ziel, dem das Kriterium dient. */
  ziel: Umweltziel;
  /** Was verlangt wird, in einem Satz. */
  anforderung: string;
  /** Woran es sich belegen lässt. */
  nachweis: string;
  /** Fundstelle im Rechtsakt. */
  fundstelle: string;
}

export interface Taetigkeit {
  /** Abschnitt im Anhang, etwa "4.1". */
  schluessel: string;
  bezeichnung: string;
  /** NACE-Codes, unter denen die Tätigkeit geführt wird. */
  nace: string[];
  /** Ziel, zu dem der wesentliche Beitrag geleistet wird. */
  beitragZu: Umweltziel;
  /** Das Kriterium des wesentlichen Beitrags. */
  beitrag: Kriterium;
  /** Die DNSH-Kriterien für die übrigen Ziele. */
  dnsh: Kriterium[];
}

