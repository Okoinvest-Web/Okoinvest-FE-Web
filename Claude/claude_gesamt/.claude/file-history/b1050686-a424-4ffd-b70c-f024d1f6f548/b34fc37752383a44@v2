/** Höchstsatz des Versorgungsinfrastrukturbeitrags in Cent je kWh. */
export const VIB_CT_KWH = 0.05;

/** Einspeiseleistung, bis zu der der Beitrag entfällt, in kW. */
export const VIB_FREIGRENZE_KW = 20;

/** Stichtag der dauerhaften Spitzenkappung. */
