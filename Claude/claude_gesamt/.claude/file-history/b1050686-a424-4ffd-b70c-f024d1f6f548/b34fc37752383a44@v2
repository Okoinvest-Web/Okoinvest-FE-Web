/* Rechnen                                                             */
/* ------------------------------------------------------------------ */

export interface Anlagenlage {
  bezeichnung: string;
  kwp: number;
  /** Netzwirksame Einspeiseleistung in kW. */
  einspeiseleistungKw: number;
  /** Eingespeiste Energie im Jahr, kWh. */
  einspeisungKwhJahr: number;
  /**
   * Viertelstundenwerte der Einspeiseleistung eines Jahres, kW.
   *
   * Daraus wird die Spitzenkappung exakt gerechnet statt geschätzt.
   * Fehlen sie, bleibt die Kappung unbeziffert - eine geschätzte
   * Kappung wäre eine Zahl, die niemand gegenüber dem Netzbetreiber
   * vertreten kann.
   */
  einspeisungViertelstunden?: number[];
}

export interface Betroffenheit {
  schluessel: string;
  titel: string;
  ab: string;
  /** Jährliche Belastung in Euro; null, wenn nicht bezifferbar. */
  euroJahr: number | null;
  /** Betroffene Energiemenge in kWh, soweit ermittelbar. */
  kwhJahr: number | null;
  begruendung: string;
  handlung: string;
}

/** Rundet auf Cent. */
function cent(betrag: number): number {
  return Math.round(betrag * 100) / 100;
}

/**
 * Der Versorgungsinfrastrukturbeitrag für eine Anlage.
 *
 * Die Freigrenze bezieht sich auf die netzwirksame Leistung, nicht
 * auf die Modulleistung: Eine Anlage mit 30 kWp und einer auf 15 kW
 * begrenzten Einspeisung bleibt darunter.
 */
export function versorgungsbeitrag(lage: Anlagenlage): Betroffenheit {
  const befreit = lage.einspeiseleistungKw <= VIB_FREIGRENZE_KW;

  return {
    schluessel: "vib",
    titel: "Versorgungsinfrastrukturbeitrag",
    ab: VIB_AB,
    euroJahr: befreit
      ? 0
      : cent((lage.einspeisungKwhJahr * VIB_CT_KWH) / 100),
    kwhJahr: befreit ? 0 : Math.round(lage.einspeisungKwhJahr),
    begruendung: befreit
      ? `Die netzwirksame Einspeiseleistung liegt bei ${lage.einspeiseleistungKw.toFixed(0)} kW und damit unter der Freigrenze von ${VIB_FREIGRENZE_KW} kW. Der Beitrag fällt nicht an.`
      : `${Math.round(lage.einspeisungKwhJahr).toLocaleString("de-AT")} kWh Einspeisung im Jahr, höchstens ${VIB_CT_KWH.toString().replace(".", ",")} Cent je kWh.`,
    handlung: befreit
      ? ""
      : "Jede Kilowattstunde, die im Betrieb bleibt, fällt nicht darunter.",
  };
}

/**
 * Was die Spitzenkappung gekostet hätte.
 *
 * Gerechnet wird über die tatsächlichen Viertelstundenwerte: Alles
 * über 70 Prozent der Modulleistung wäre im Kappungsfall verloren.
 * Das ist eine Obergrenze - gekappt wird nur bei drohender
 * Netzüberlastung, nicht immer. Genau deshalb steht die Zahl als
 * "höchstens" da und nicht als Erwartungswert.
 */
export function spitzenkappung(
  lage: Anlagenlage,
  verguetungCtKwh: number,
): Betroffenheit {
  const grenzeKw = lage.kwp * SPITZENKAPPUNG_ANTEIL;
  const werte = lage.einspeisungViertelstunden;

  if (!werte || werte.length === 0) {
    return {
      schluessel: "spitzenkappung",
      titel: "Spitzenkappung",
      ab: SPITZENKAPPUNG_AB,
      euroJahr: null,
      kwhJahr: null,
      begruendung: `Die Kappungsgrenze läge bei ${grenzeKw.toFixed(0)} kW. Ohne Viertelstundenwerte lässt sich nicht beziffern, wie viel darüber anfällt - und eine Schätzung wäre gegenüber dem Netzbetreiber wertlos.`,
      handlung: "",
    };
  }

  const ueber = werte.reduce(
    (summe, kw) => summe + Math.max(0, kw - grenzeKw) * 0.25,
    0,
  );

  const stunden = werte.filter((kw) => kw > grenzeKw).length * 0.25;
  const hoechste = werte.reduce((m, kw) => Math.max(m, kw), 0);
  const abstand = grenzeKw - hoechste;

  if (ueber < 1) {
    /*
     * Kein Treffer ist hier die häufigste und die wichtigste Antwort.
     *
     * Anlagen mit einer vertraglich begrenzten Einspeisung liegen
     * meist schon unter der neuen Grenze - für sie ändert sich
     * nichts, und genau das gehört gesagt. Ohne den Abstand wäre die
     * Aussage aber nur halb: Wer erweitert, verschiebt beide Grenzen
     * unterschiedlich, und dann zählt, wie viel Luft heute da ist.
     */
    return {
      schluessel: "spitzenkappung",
      titel: "Spitzenkappung",
      ab: SPITZENKAPPUNG_AB,
      euroJahr: 0,
      kwhJahr: 0,
      begruendung: `Die Einspeisung erreichte im betrachteten Zeitraum höchstens ${hoechste.toFixed(0)} kW. Die Kappungsgrenze läge bei ${grenzeKw.toFixed(0)} kW, das sind ${(SPITZENKAPPUNG_ANTEIL * 100).toFixed(0)} Prozent der Modulleistung. Abstand: ${abstand.toFixed(0)} kW. Für diese Anlage ändert die Regelung nichts.`,
      handlung:
        abstand < grenzeKw * 0.15
          ? "Der Abstand ist knapp. Vor einer Erweiterung sollte gerechnet werden: Die Kappungsgrenze wächst mit der Modulleistung, die vereinbarte Einspeisegrenze im Netzzugangsvertrag nicht."
          : "",
    };
  }

  return {
    schluessel: "spitzenkappung",
    titel: "Spitzenkappung",
    ab: SPITZENKAPPUNG_AB,
    euroJahr: cent((ueber * verguetungCtKwh) / 100),
    kwhJahr: Math.round(ueber),
    begruendung: `In ${stunden.toFixed(0)} Stunden lag die Einspeisung über ${grenzeKw.toFixed(0)} kW, in der Spitze bei ${hoechste.toFixed(0)} kW. Im Kappungsfall wären das höchstens ${Math.round(ueber).toLocaleString("de-AT")} kWh - gekappt wird nur bei drohender Netzüberlastung, nicht immer.`,
    handlung:
      "Diese Energie ist nur zu retten, wenn sie vor dem Zähler bleibt: Speicher in den Mittagsstunden laden, Ladepunkte takten, Prozesswärme vorziehen.",
  };
}

/**
 * Alle bezifferbaren Auswirkungen für eine Anlage.
 *
 * Sortiert nach Betrag, weil danach entschieden wird - und nicht nach
 * Paragraphennummer.
 */
export function betroffenheit(
  lage: Anlagenlage,
  verguetungCtKwh: number,
): Betroffenheit[] {
  return [versorgungsbeitrag(lage), spitzenkappung(lage, verguetungCtKwh)].sort(
    (a, b) => (b.euroJahr ?? -1) - (a.euroJahr ?? -1),
  );
}

/** Steht die Regelung schon in Kraft, gemessen an einem Stichtag? */
export function wirksamkeit(regelung: Regelung, heute: string): Wirksamkeit {
  return regelung.ab <= heute ? "gilt" : "kommt";
}

/** Tage bis zum Inkrafttreten; negativ, wenn schon in Kraft. */
export function tageBis(regelung: Regelung, heute: string): number {
  const ab = Date.parse(regelung.ab + "T00:00:00Z");
  const jetzt = Date.parse(heute + "T00:00:00Z");
  return Math.round((ab - jetzt) / 86400000);
}
