/**
 * Was das neue Elektrizitätswirtschaftsgesetz für diese Anlagen bedeutet.
 *
 * Das ElWG ist Ende Dezember 2025 in Kraft getreten, wirkt aber in
 * Stufen: Der Sozialtarif ab April 2026, die neuen Regeln für
 * Energiegemeinschaften ab Oktober 2026, die neue Entgeltstruktur und
 * der Versorgungsinfrastrukturbeitrag ab Jänner 2027.
 *
 * Warum das in ein Betriebsportal gehört: Für einen Betreiber ist die
 * Frage nicht, was im Gesetz steht, sondern was seine Anlage ab wann
 * kostet. Diese Datei rechnet das aus - aus den tatsächlich
 * eingespeisten Kilowattstunden und der tatsächlichen Anlagenleistung,
 * nicht aus einer Faustformel.
 *
 * Zur Belastbarkeit: Die Beträge stehen im Gesetz als Höchstwerte;
 * die tatsächliche Höhe legt eine Verordnung fest. Wo eine Quelle
 * mehrdeutig ist - etwa bei der Freigrenze des Netzanschlussentgelts,
 * für die sich zwischen Entwurf und Fassung 7 und 15 kW finden -,
 * steht das in der Ausgabe und wird nicht weggerundet. Ein Portal,
 * das eine unsichere Zahl als sicher ausgibt, ist schlimmer als eines,
 * das schweigt.
 *
 * Quellen: WKO Niederösterreich zum finalen ElWG; Oesterreichs
 * Energie; Wiener Stadtwerke zur Struktur der Netzentgelte ab 2027.
 */

export type Wirksamkeit = "gilt" | "kommt";

export interface Regelung {
  schluessel: string;
  titel: string;
  /** Ab wann sie wirkt, als ISO-Datum. */
  ab: string;
  /** Was sie sagt, in einem Absatz. */
  inhalt: string;
  /** Was der Betrieb davon hat oder dagegen tun kann. */
  handlung: string;
  /** Wie belastbar die Zahl ist. */
  belastbarkeit: "gesetzestext" | "verordnung offen" | "quellen uneinheitlich";
  quelle: string;
}

/** Stichtag, ab dem der Versorgungsinfrastrukturbeitrag greift. */
