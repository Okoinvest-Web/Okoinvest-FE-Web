      d.von,
      d.bis,
      d.stufe,
      d.empfaenger,
      d.rolle,
      d.telefon,
      d.email,
      d.kanal,
      d.frist,
    );
  }

  const meldungen = [
    {
      anlage: ANLAGE_MIT_DRIFT,
      quelle: "Drift",
      dringlichkeit: "Kritisch",
      betreff: "Wirkleistungsbegrenzung abweichend",
      text: "Die versiegelte Begrenzung steht auf 100 statt auf 70 Prozent. Die Anlage wurde gesperrt.",
      vorMinuten: 12,
      bestaetigt: false,
      stufe: 2,
    },
    {
      anlage: "ANL-0002",
      quelle: "Alarm",
      dringlichkeit: "Mittel",
      betreff: "Strangabweichung Strang 4",
      text: "Strang 4 an WR 1 Halle Ost liefert 22 Prozent unter den Nachbarsträngen.",
      vorMinuten: 3120,
      bestaetigt: true,
      stufe: 1,
    },
    {
      anlage: "ANL-0005",
      quelle: "Sicherheit",
      dringlichkeit: "Hoch",
      betreff: "Sperrliste auf dem Gateway veraltet",
      text: "Das Gateway hat seit neun Tagen keine Sperrliste übernommen.",
      vorMinuten: 95,
      bestaetigt: false,
      stufe: 2,
    },
    {
      anlage: "ANL-0001",
      quelle: "Markt",
      dringlichkeit: "Niedrig",
      betreff: "Negative Börsenpreise am Folgetag",
      text: "Zwischen 11 und 15 Uhr sind negative Preise angekündigt. Der Fahrplan wurde angepasst.",
      vorMinuten: 420,
      bestaetigt: true,
      stufe: 1,
    },
  ];

  for (const [i, m] of meldungen.entries()) {
    const erzeugt = new Date(jetzt.getTime() - m.vorMinuten * 60000);
    const id = `BN-${String(i + 1).padStart(4, "0")}`;

    schreibe(
      `INSERT INTO benachrichtigung
         (id, anlage_id, quelle, dringlichkeit, betreff, text, erzeugt_am,
          bestaetigt_am, bestaetigt_von, stufe, status)
       VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
      id,
      m.anlage,
      m.quelle,
      m.dringlichkeit,
      m.betreff,
      m.text,
      erzeugt.toISOString(),
      m.bestaetigt
        ? new Date(erzeugt.getTime() + 6 * 60000).toISOString()
        : null,
      m.bestaetigt ? "Michael Hofbauer" : null,
      m.stufe,
      m.bestaetigt ? "Bestaetigt" : m.stufe > 1 ? "Eskaliert" : "Zugestellt",
    );
    z.benachrichtigungen += 1;

    // Zustellversuche je Weg.
    const wege =
      m.dringlichkeit === "Kritisch"
        ? ["Push", "WhatsApp", "SMS", "Anruf"]
        : m.dringlichkeit === "Hoch"
          ? ["Push", "WhatsApp"]
          : m.dringlichkeit === "Mittel"
            ? ["Push"]
            : ["E-Mail"];

    for (const [j, kanal] of wege.entries()) {
      const versucht = new Date(erzeugt.getTime() + j * 1500);
      const fehlgeschlagen = kanal === "SMS" && !m.bestaetigt;

      schreibe(
        `INSERT INTO zustellung
           (id, benachrichtigung_id, kanal, empfaenger, stufe, versucht_am,
            zugestellt_am, gelesen_am, status, fehler)
         VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
        `${id}-Z${j + 1}`,
        id,
        kanal,
        kanal === "Anruf" || kanal === "SMS"
          ? "+43 664 1234501"
          : "m.hofbauer@steiner-holzbau.at",
        m.stufe,
        versucht.toISOString(),
        fehlgeschlagen
          ? null
          : new Date(versucht.getTime() + 2200).toISOString(),
        m.bestaetigt
          ? new Date(versucht.getTime() + 180000).toISOString()
          : null,
        fehlgeschlagen ? "Fehler" : m.bestaetigt ? "Gelesen" : "Zugestellt",
        fehlgeschlagen ? "Zustellbericht des Netzbetreibers ausgeblieben" : null,
      );
    }
  }
}

