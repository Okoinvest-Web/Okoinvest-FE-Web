      Number(((p.menge * p.faktor.faktor) / 1000).toFixed(4)),
      p.herkunft,
      p.marktbasiert
        ? "Marktbasiert: Liefervertrag mit Herkunftsnachweisen."
        : null,
    );
    z.esgPositionen += 1;
  }
}

