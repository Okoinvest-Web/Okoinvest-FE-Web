/**
 * Führt für jede Anlage einen Abgleich durch und schreibt die
 * Protokollkette.
 *
 * Auf einer Anlage steht die Wirkleistungsbegrenzung falsch. Der Lauf
 * erkennt das, sperrt die Anlage und schreibt einen Eintrag, dessen
 * Hash sich später nicht mehr unbemerkt ändern lässt.
 */
function befuelleDrift(): { laeufe: number; eintraege: number } {
  const jetzt = new Date();
  let laeufe = 0;
  let eintraege = 0;

  let vorheriger: Protokolleintrag | null = null;

  for (const anlage of anlagen()) {
    const soll = db()
      .prepare(
        `SELECT schluessel, bezeichnung, register, sollwert, einheit,
                versiegelt, toleranz, grundlage
           FROM sollparameter WHERE anlage_id = ?`,
      )
      .all(anlage.id) as unknown as {
      schluessel: string;
      bezeichnung: string;
      register: string;
      sollwert: number;
      einheit: string;
      versiegelt: number;
      toleranz: number;
      grundlage: string | null;
    }[];

    const sollwerte: Sollwert[] = soll.map((s) => ({
      schluessel: s.schluessel,
      bezeichnung: s.bezeichnung,
      register: s.register,
      sollwert: s.sollwert,
      einheit: s.einheit,
      versiegelt: s.versiegelt === 1,
      toleranz: s.toleranz,
      grundlage: s.grundlage ?? undefined,
    }));

    // Der Istzustand entspricht dem Sollzustand - bis auf eine Anlage.
    const istwerte: Istwert[] = sollwerte.map((s) => ({
      schluessel: s.schluessel,
      wert:
        anlage.id === ANLAGE_MIT_DRIFT &&
        s.schluessel === "wirkleistung_grenze"
          ? 100
          : s.sollwert,
      gelesenAm: jetzt,
    }));

    const ergebnis = pruefeDrift(sollwerte, istwerte);

    const sollHash = konfigurationsFingerabdruck(
      sollwerte.map((s) => ({ schluessel: s.schluessel, wert: s.sollwert })),
    );
    const istHash = konfigurationsFingerabdruck(
      istwerte.map((i) => ({ schluessel: i.schluessel, wert: i.wert })),
    );

    const laufId = `DL-${anlage.id}-${jetzt.getTime()}`;

    imBlock(() => {
      schreibe(
        `INSERT INTO driftlauf
           (id, anlage_id, gelaufen_am, soll_hash, ist_hash, geprueft,
            befunde, hoechste_schwere, gesperrt, dauer_ms, ausloeser)
         VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'Worker')`,
        laufId,
        anlage.id,
        jetzt.toISOString(),
        sollHash,
        istHash,
        ergebnis.geprueft,
        ergebnis.befunde.length,
        ergebnis.hoechsteSchwere,
        ergebnis.sperren ? 1 : 0,
        40 + (startwertAus(anlage.id) % 60),
      );

      for (const [i, b] of ergebnis.befunde.entries()) {
        schreibe(
          `INSERT INTO driftbefund
             (id, lauf_id, schluessel, bezeichnung, register, sollwert,
              istwert, einheit, abweichung, versiegelt, schwere, massnahme,
              begruendung)
           VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
          `${laufId}-B${i + 1}`,
          laufId,
          b.schluessel,
          b.bezeichnung,
          b.register,
          Number.isFinite(b.sollwert) ? b.sollwert : null,
          b.istwert,
          b.einheit,
          b.abweichung,
          b.versiegelt ? 1 : 0,
          b.schwere,
          b.massnahme,
          b.begruendung,
        );
      }
    });

    laeufe += 1;

    // Protokolleinträge: der Lauf selbst, dann jeder Befund.
    const geschehnisse: { ereignis: string; inhalt: string }[] = [
      {
        ereignis: "Konfigurationsabgleich",
        inhalt: `${ergebnis.geprueft} Parameter geprüft, ${ergebnis.befunde.length} Abweichungen. Fingerabdruck Soll ${sollHash.slice(0, 12)}, Ist ${istHash.slice(0, 12)}.`,
      },
    ];

    for (const b of ergebnis.befunde) {
      geschehnisse.push({
        ereignis:
          b.massnahme === "sperren"
            ? "Anlagensperre nach Drift"
            : "Abweichung festgestellt",
        inhalt: b.begruendung,
      });
    }

    for (const g of geschehnisse) {
      vorheriger = haengeAn(vorheriger, {
        zeitpunkt: jetzt.toISOString(),
        ereignis: g.ereignis,
        urheber: "drift-worker",
        herkunft: "10.0.7.14 (Cloud-Worker)",
        inhalt: g.inhalt,
      });

      schreibe(
        `INSERT INTO protokollkette
           (anlage_id, zeitpunkt, ereignis, urheber, herkunft, inhalt,
            vorgaenger, hash)
         VALUES (?, ?, ?, ?, ?, ?, ?, ?)`,
        anlage.id,
        vorheriger.zeitpunkt,
        vorheriger.ereignis,
        vorheriger.urheber,
        vorheriger.herkunft,
        vorheriger.inhalt,
        vorheriger.vorgaenger,
        vorheriger.hash,
      );
      eintraege += 1;
    }
  }

  return { laeufe, eintraege };
}

