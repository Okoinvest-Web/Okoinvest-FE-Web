    const datum = verschiebeTage(heute, tag);
    const zufall = zufallsfolge(startwertAus(`preis:${datum.toDateString()}`));
    const grundniveau = 70 + zufall() * 60;

    for (let viertel = 0; viertel < 96; viertel++) {
      const stunde = viertel / 4;

      // Tagesform: Morgen- und Abendspitze, Mittagstal durch die
      // Photovoltaik. An sonnigen Tagen wird das Tal negativ.
      const morgen = Math.exp(-((stunde - 7.5) ** 2) / 6) * 55;
      const abend = Math.exp(-((stunde - 19.5) ** 2) / 8) * 95;
      const mittag = -Math.exp(-((stunde - 13) ** 2) / 10) * (70 + zufall() * 60);
      const nacht = stunde < 5 || stunde > 22 ? -25 : 0;

      const preis =
        grundniveau + morgen + abend + mittag + nacht + (zufall() - 0.5) * 14;

      preisEinfuegen.run(
        messStempel(new Date(datum.getTime() + viertel * 900000)),
        Number(preis.toFixed(2)),
        verschiebeTage(datum, -1).toISOString().slice(0, 10) + "T12:45:00.000Z",
      );
      z.marktpreise += 1;
    }
  }

  // --- Regelleistung: der große Speicher hält Primärregelleistung ---
  schreibe(
    `INSERT INTO regelleistung
       (id, speicher_id, produkt, von, bis, leistung_kw, preis_eur_mw_h, status)
     VALUES ('RL-0001', 'SP-0001', 'FCR', ?, ?, 120, 14.8, 'Bezuschlagt')`,
    messStempel(heute),
    messStempel(verschiebeTage(heute, 7)),
  );

  // --- Fahrpläne der letzten Tage und für morgen ---
  z.fahrplaene = befuelleFahrplaene();
}

/**
 * Rechnet für jeden Speicher echte Fahrpläne.
 *
 * Nicht ausgedacht, sondern mit demselben Rechenkern erzeugt, der
 * später im Betrieb läuft - sonst zeigte die Oberfläche etwas
 * anderes, als die Anlage täte.
 */
function befuelleFahrplaene(): number {
  const heute = new Date();
  heute.setHours(0, 0, 0, 0);

  const speicher = db()
    .prepare(
      `SELECT s.*, n.bezugsgrenze_kw, n.spitzenziel_kw, n.einspeisegrenze_kw,
              n.arbeitspreis_ct_kwh, n.einspeiseverguetung_ct_kwh,
              n.leistungspreis_eur_kw_monat, a.leistung_kwp
         FROM speicher s
         JOIN netzanschluss n ON n.anlage_id = s.anlage_id
         JOIN anlage a        ON a.id = s.anlage_id`,
    )
    .all() as unknown as Record<string, number | string>[];

  let anzahl = 0;

  const schrittEinfuegen = db().prepare(
    `INSERT INTO fahrplan_schritt
       (fahrplan_id, zeitpunkt, preis_eur_mwh, erzeugung_kwh, verbrauch_kwh,
        laden_kwh, entladen_kwh, netzbezug_kwh, einspeisung_kwh,
        ladestand_kwh, belegung, ergebnis_eur)
     VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
  );

  for (const s of speicher) {
    const anlageId = String(s.anlage_id);
    const kwp = Number(s.leistung_kwp);

    // Vorhaltung aus bezuschlagter Regelleistung.
    const vorhaltung =
      (skalar<number>(
        `SELECT COALESCE(SUM(leistung_kw), 0) FROM regelleistung
          WHERE speicher_id = ? AND status = 'Bezuschlagt'`,
        String(s.id),
      ) ?? 0) || 0;

    for (let tag = -3; tag <= 1; tag++) {
      const datum = verschiebeTage(heute, tag);
      const zufall = zufallsfolge(
        startwertAus(`plan:${s.id}:${datum.toDateString()}`),
      );

      const preise = db()
        .prepare(
          `SELECT zeitpunkt, preis_eur_mwh FROM marktpreis
            WHERE markt = 'EPEX_AT_DA' AND zeitpunkt >= ? AND zeitpunkt < ?
            ORDER BY zeitpunkt`,
        )
        .all(
          messStempel(datum),
          messStempel(verschiebeTage(datum, 1)),
        ) as unknown as { zeitpunkt: string; preis_eur_mwh: number }[];

      if (preise.length === 0) continue;

      const intervalle: Marktintervall[] = preise.map((p, i) => {
        const stunde = i / 4;

        // Erzeugung als Tagesbogen, Verbrauch als Werktagsprofil mit
        // einer Spitze am Nachmittag.
        const sonne = Math.max(
          0,
          Math.sin(((stunde - 5.5) / 13) * Math.PI),
        );
        const erzeugung = sonne * kwp * 0.72 * 0.25 * (0.55 + zufall() * 0.5);

        const werktag = datum.getDay() >= 1 && datum.getDay() <= 5;
        const grundlast = werktag ? 0.16 : 0.05;
        const schicht =
          werktag && stunde >= 6 && stunde < 17 ? 0.34 : 0;
        const spitze =
          werktag && stunde >= 14 && stunde < 15.5 ? 0.42 : 0;

        const verbrauch =
          kwp *
          (grundlast + schicht + spitze) *
          (LASTFAKTOR[anlageId] ?? 1) *
          0.25 *
          (0.9 + zufall() * 0.25);

        return {
          zeitpunkt: new Date(datum.getTime() + i * 900000),
          preisEurMwh: p.preis_eur_mwh,
          erzeugungKwh: Number(erzeugung.toFixed(2)),
          verbrauchKwh: Number(verbrauch.toFixed(2)),
        };
      });

      const plan = erstelleFahrplan(
        intervalle,
        {
          kapazitaetKwh: Number(s.kapazitaet_kwh),
          ladeleistungKw: Number(s.ladeleistung_kw),
          entladeleistungKw: Number(s.entladeleistung_kw),
          wirkungsgradLaden: Number(s.wirkungsgrad_laden),
          wirkungsgradEntladen: Number(s.wirkungsgrad_entladen),
          notstromReserve: Number(s.notstrom_reserve),
          startLadestandKwh:
            Number(s.kapazitaet_kwh) * (0.3 + zufall() * 0.3),
          zykluskostenEurKwh: Number(s.zykluskosten_eur_kwh),
          vorhaltungKw: vorhaltung,
        },
        {
          bezugsgrenzeKw: Number(s.bezugsgrenze_kw),
          spitzenzielKw: Number(s.spitzenziel_kw),
          einspeisegrenzeKw: Number(s.einspeisegrenze_kw),
          arbeitspreisBezugCtKwh: Number(s.arbeitspreis_ct_kwh),
          einspeiseverguetungCtKwh: Number(s.einspeiseverguetung_ct_kwh),
          leistungspreisEurKwMonat: Number(s.leistungspreis_eur_kw_monat),
        },
      );

      const planId = `FP-${s.id}-${datum.toISOString().slice(0, 10)}`;

      // Ohne eigene Schreibklammer: Der Aufrufer haelt bereits eine,
      // und SQLite kennt keine verschachtelten Transaktionen.
      {
        schreibe(
          `INSERT INTO fahrplan
             (id, speicher_id, tag, status, eigenverbrauch_eur, handel_eur,
              spitzenkappung_eur, zykluskosten_eur, gesamt_eur,
              spitze_ohne_kw, spitze_mit_kw, durchsatz_kwh, vollzyklen,
              gerechnet_am, freigegeben_am, freigegeben_von)
           VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
          planId,
          s.id,
          datum.toISOString().slice(0, 10),
          tag < 0 ? "Gefahren" : tag === 0 ? "Freigegeben" : "Entwurf",
          plan.bilanz.eigenverbrauchEur,
          plan.bilanz.handelEur,
          plan.bilanz.spitzenkappungEur,
          plan.bilanz.zykluskostenEur,
          plan.bilanz.gesamtEur,
          plan.bilanz.spitzeOhneSpeicherKw,
          plan.bilanz.spitzeMitSpeicherKw,
          plan.bilanz.durchsatzKwh,
          plan.bilanz.vollzyklen,
          verschiebeTage(datum, -1).toISOString(),
          tag <= 0 ? verschiebeTage(datum, -1).toISOString() : null,
          tag <= 0 ? "Automatische Freigabe" : null,
        );

        for (const schritt of plan.schritte) {
          schrittEinfuegen.run(
            planId,
            messStempel(schritt.zeitpunkt),
            schritt.preisEurMwh,
            schritt.erzeugungKwh,
            schritt.verbrauchKwh,
            schritt.ladenKwh,
            schritt.entladenKwh,
            schritt.netzbezugKwh,
            schritt.einspeisungKwh,
            schritt.ladestandKwh,
            schritt.belegung,
            schritt.ergebnisEur,
          );
        }
      }

      anzahl += 1;
    }
  }

  return anzahl;
}

