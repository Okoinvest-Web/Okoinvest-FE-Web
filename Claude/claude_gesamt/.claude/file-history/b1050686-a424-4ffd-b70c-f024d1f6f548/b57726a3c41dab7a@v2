export interface PlattformErgebnis {
  geraete: number;
  schnittstellen: number;
  vlans: number;
  sollparameter: number;
  driftlaeufe: number;
  protokoll: number;
  wafRegeln: number;
  wafEreignisse: number;
  ztSitzungen: number;
  marktpreise: number;
  fahrplaene: number;
  dokumente: number;
  esgPositionen: number;
  benachrichtigungen: number;
  buchungen: number;
  dauerMs: number;
}

export function befuellePlattform(erzwingen = false): PlattformErgebnis {
  const start = Date.now();

  const vorhanden = skalar<number>("SELECT COUNT(*) FROM edge_geraet") ?? 0;
  if (vorhanden > 0 && !erzwingen) {
    return leer();
  }

  const zaehler = leer();

  imBlock(() => {
    if (erzwingen) {
      for (const tabelle of [
        "buchung",
        "buchungsstapel",
        "zustellung",
        "benachrichtigung",
        "bereitschaft",
        "esg_position",
        "esg_periode",
        "dossier_dokument",
        "regelleistung",
        "fahrplan_schritt",
        "fahrplan",
        "netzanschluss",
        "speicher",
        "marktpreis",
        "zt_sitzung",
        "waf_ereignis",
        "sperrliste_verteilung",
        "sperrliste",
        "waf_regel",
        "protokollkette",
        "driftbefund",
        "driftlauf",
        "sollparameter",
        "vlan_regel",
        "vlan",
        "edge_schnittstelle",
        "edge_geraet",
      ]) {
        schreibe(`DELETE FROM ${tabelle}`);
      }
    }

    befuelleNetzzonen(zaehler);
    befuelleGeraete(zaehler);
    befuelleSollstand(zaehler);
    befuelleFirewall(zaehler);
    befuelleZeroTrust(zaehler);
    befuelleMarkt(zaehler);
    befuelleDossier(zaehler);
    befuelleEsg(zaehler);
    befuelleMeldewege(zaehler);
    befuelleBuchhaltung(zaehler);
  });

  // Drift und Protokoll laufen nach dem Block: Sie schreiben eine
  // Kette, deren Glieder aufeinander aufbauen.
  const driftErgebnis = befuelleDrift();
  zaehler.driftlaeufe = driftErgebnis.laeufe;
  zaehler.protokoll = driftErgebnis.eintraege;

  zaehler.dauerMs = Date.now() - start;
  return zaehler;
}

function leer(): PlattformErgebnis {
  return {
    geraete: 0,
    schnittstellen: 0,
    vlans: 0,
    sollparameter: 0,
    driftlaeufe: 0,
    protokoll: 0,
    wafRegeln: 0,
    wafEreignisse: 0,
    ztSitzungen: 0,
    marktpreise: 0,
    fahrplaene: 0,
    dokumente: 0,
    esgPositionen: 0,
    benachrichtigungen: 0,
    buchungen: 0,
    dauerMs: 0,
  };
}

function anlagen(): { id: string; bezeichnung: string; kwp: number }[] {
  return db()
    .prepare("SELECT id, bezeichnung, leistung_kwp AS kwp FROM anlage ORDER BY id")
    .all() as unknown as { id: string; bezeichnung: string; kwp: number }[];
}

function befuelleNetzzonen(z: PlattformErgebnis): void {
  for (const anlage of anlagen()) {
    const netz = anlage.id.slice(-1);

