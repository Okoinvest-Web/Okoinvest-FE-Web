import type { SVGProps } from "react";

/**
 * Strichzeichnungen statt Schriftzeichen.
 *
 * Zuvor standen hier Unicode-Symbole wie ☀ und ⇅. Die sehen auf jedem
 * Betriebssystem anders aus, lassen sich nicht in Staerke oder Groesse
 * abstimmen und wirken zusammengesucht. Diese Zeichnungen teilen sich
 * ein Raster von 24 Einheiten, eine Strichstaerke von 1,5 und runde
 * Enden - dadurch sitzen sie ruhig neben dem Text.
 *
 * Sie erben die Textfarbe, tragen also nie eigene Farbigkeit.
 */

type IconProps = SVGProps<SVGSVGElement> & {
  /** Kantenlaenge in Pixeln. */
  groesse?: number;
};

function Rahmen({ groesse = 16, children, ...rest }: IconProps) {
  return (
    <svg
      width={groesse}
      height={groesse}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      strokeWidth={1.5}
      strokeLinecap="round"
      strokeLinejoin="round"
      aria-hidden="true"
      focusable="false"
      {...rest}
    >
      {children}
    </svg>
  );
}

