import { DOCTYPE } from "./doctype-namen.ts";

/**
 * Gleicht das Frappe-Schema mit dem ab, was die Anwendung erwartet.
 *
 * Der haeufigste Fehler beim Betrieb einer solchen Loesung ist, dass
 * Backend und Frontend auseinanderlaufen: Ein Feld wird im DocType
 * umbenannt, die Abfrage im Portal fragt es weiter an - und liefert
 * stillschweigend leere Werte statt einer Fehlermeldung.
 *
 * Diese Tests schlagen an, bevor das passiert.
 */

const DOCTYPE_ORDNER = join(
  process.cwd(),
  "frappe",
  "energieportal",
  "energieportal",
  "doctype",
);

interface FrappeFeld {
  fieldname: string;
  fieldtype: string;
  options?: string;
}

interface FrappeDocType {
  name: string;
  fields: FrappeFeld[];
  permissions: { role: string; write: number; delete: number }[];
}

function ladeAlleDocTypes(): Map<string, FrappeDocType> {
  const gefunden = new Map<string, FrappeDocType>();
  if (!existsSync(DOCTYPE_ORDNER)) return gefunden;

  for (const ordner of readdirSync(DOCTYPE_ORDNER, { withFileTypes: true })) {
    if (!ordner.isDirectory()) continue;
    const datei = join(DOCTYPE_ORDNER, ordner.name, `${ordner.name}.json`);
    if (!existsSync(datei)) continue;

    const inhalt = JSON.parse(readFileSync(datei, "utf8")) as FrappeDocType;
    gefunden.set(inhalt.name, inhalt);
  }

  return gefunden;
}

const SCHEMA = ladeAlleDocTypes();

/** DocTypes, die aus Frappe bzw. ERPNext stammen und nicht hier definiert sind. */
