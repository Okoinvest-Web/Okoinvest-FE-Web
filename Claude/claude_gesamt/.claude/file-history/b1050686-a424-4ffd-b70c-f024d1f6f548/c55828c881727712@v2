describe("Frappe-Schema", () => {
  it("ist erzeugt worden", () => {
    assert.ok(
      SCHEMA.size > 0,
      "Keine DocTypes gefunden. Bitte zuerst 'node frappe/erzeuge-doctypes.mjs' ausfuehren.",
    );
  });

  it("enthaelt jeden DocType, den die Anwendung anspricht", () => {
    for (const [schluessel, name] of Object.entries(DOCTYPE)) {
      if (FREMDE_DOCTYPES.has(name)) continue;
      assert.ok(
        SCHEMA.has(name),
        `DOCTYPE.${schluessel} verweist auf "${name}", das Schema kennt ihn nicht`,
      );
    }
  });

  it("enthaelt jedes Feld, das die Anwendung abfragt", () => {
    for (const [doctype, felder] of Object.entries(ABGEFRAGTE_FELDER)) {
      const definition = SCHEMA.get(doctype);
      assert.ok(definition, `DocType "${doctype}" fehlt im Schema`);

      const vorhanden = new Set(definition.fields.map((f) => f.fieldname));

      for (const feld of felder) {
        assert.ok(
          vorhanden.has(feld),
          `"${doctype}" hat kein Feld "${feld}" - die Abfrage im Portal liefe ins Leere`,
        );
      }
    }
  });

  it("verweist mit Link-Feldern nur auf existierende DocTypes", () => {
    for (const [name, definition] of SCHEMA) {
      for (const feld of definition.fields) {
        if (feld.fieldtype !== "Link") continue;

        const ziel = feld.options;
        assert.ok(ziel, `${name}.${feld.fieldname} ist ein Link ohne Ziel`);
        assert.ok(
          SCHEMA.has(ziel) || FREMDE_DOCTYPES.has(ziel),
          `${name}.${feld.fieldname} verweist auf unbekannten DocType "${ziel}"`,
        );
      }
    }
  });

  it("gibt Auswahlfeldern immer Optionen mit", () => {
    for (const [name, definition] of SCHEMA) {
      for (const feld of definition.fields) {
        if (feld.fieldtype !== "Select") continue;
        assert.ok(
          feld.options && feld.options.length > 0,
          `${name}.${feld.fieldname} ist ein Auswahlfeld ohne Optionen`,
        );
      }
    }
  });
});

describe("Auditprotokoll", () => {
  it("ist fuer niemanden aenderbar oder loeschbar", () => {
    const audit = SCHEMA.get("Audit Protokoll");
    assert.ok(audit, "Audit Protokoll fehlt");

    for (const recht of audit.permissions) {
      assert.equal(
        recht.write,
        0,
        `Rolle "${recht.role}" darf das Protokoll nicht aendern duerfen`,
      );
      assert.equal(
        recht.delete,
        0,
        `Rolle "${recht.role}" darf das Protokoll nicht loeschen duerfen`,
      );
    }
  });
});

describe("Berechtigungen", () => {
  it("geben dem Portalkunden nur dort Schreibrecht, wo das Portal es anbietet", () => {
    const erlaubt = new Set(["PV Stoerung", "Support Ticket"]);

    for (const [name, definition] of SCHEMA) {
      const kunde = definition.permissions.find(
        (p) => p.role === "Portalkunde",
      );
      if (!kunde) continue;

      if (!erlaubt.has(name)) {
        assert.equal(
          kunde.write,
          0,
          `Portalkunde sollte "${name}" nicht schreiben duerfen`,
        );
      }
    }
  });

  it("erlauben dem Portalkunden nirgends das Loeschen", () => {
    for (const [name, definition] of SCHEMA) {
      const kunde = definition.permissions.find(
        (p) => p.role === "Portalkunde",
      );
      if (!kunde) continue;

      assert.equal(
        kunde.delete,
        0,
        `Portalkunde sollte "${name}" nicht loeschen duerfen`,
      );
    }
  });
});
