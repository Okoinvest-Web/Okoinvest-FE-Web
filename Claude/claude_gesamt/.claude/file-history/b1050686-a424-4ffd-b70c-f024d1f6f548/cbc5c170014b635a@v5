const { befuelleTechnik } = await import("../src/lib/db/befuellen-technik.ts");
const { befuelleLaden, befuelleLadeabrechnungen } = await import("../src/lib/db/befuellen-laden.ts");
const { befuellePlattform } = await import("../src/lib/db/befuellen-plattform.ts");
