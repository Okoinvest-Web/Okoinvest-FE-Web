// Bei --neu wird das Schema verworfen und neu aufgebaut, nicht nur
// der Inhalt geleert - sonst fehlen nach einer Schemaaenderung
// stillschweigend die neuen Spalten.
if (neu) baueSchemaNeu();

console.log("");
const ergebnis = befuelleDatenbank(neu);

if (ergebnis.uebersprungen) {
  console.log("Datenbank ist bereits befuellt - uebersprungen.");
  console.log("Mit --neu wird sie geleert und neu aufgebaut.\n");
} else {
  console.log(
    `Befuellt: ${ergebnis.zaehlpunkte} Zaehlpunkte, ` +
      `${ergebnis.lastgangZeilen.toLocaleString("de-AT")} Lastgangzeilen ` +
      `in ${(ergebnis.dauerMs / 1000).toFixed(1)} s\n`,
  );
}

// --- Technischer Bestand ---------------------------------------------
const technik = befuelleTechnik(neu);
if (!technik.dauerMs) {
  console.log("Technikdaten bereits vorhanden - uebersprungen.\n");
} else {
  console.log(
    `Technik:  ${technik.wechselrichter} Wechselrichter, ${technik.straenge} Straenge, ` +
      `${technik.wrMesswerte.toLocaleString("de-AT")} WR-Messwerte, ` +
      `${technik.strangMesswerte.toLocaleString("de-AT")} Strangwerte, ` +
      `${technik.sensorMesswerte.toLocaleString("de-AT")} Sensorwerte, ` +
      `${technik.alarme} Alarme in ${(technik.dauerMs / 1000).toFixed(1)} s\n`,
  );
}

// --- Ladeinfrastruktur ------------------------------------------------
const laden = befuelleLaden(neu);
if (!laden.dauerMs) {
  console.log("Ladedaten bereits vorhanden - uebersprungen." + EOL);
} else {
  console.log(
    `Laden:    ${laden.ladepunkte} Ladepunkte, ${laden.tarife} Tarife, ` +
      `${laden.karten} Karten, ${laden.vorgaenge.toLocaleString("de-AT")} Ladevorgaenge ` +
      `in ${(laden.dauerMs / 1000).toFixed(1)} s` + EOL,
  );
}

const ladeLaeufe = laden.dauerMs ? befuelleLadeabrechnungen() : null;

// Die Quartalsabrechnungen der Energiegemeinschaft laufen ebenfalls
// ausserhalb der Schreibklammer - jeder Lauf fuehrt seine eigene.
const eegLaeufe = ergebnis.uebersprungen
  ? null
  : befuelleGemeinschaftsabrechnungen();

if (eegLaeufe) {
  console.log(
    `Energiegemeinschaft: ${eegLaeufe.laeufe} Quartalslaeufe, ` +
      `${eegLaeufe.belege} Belege, ${eegLaeufe.brutto.toFixed(2)} EUR brutto`,
  );
}
if (ladeLaeufe) {
  console.log(
    `Abrechnung: ${ladeLaeufe.laeufe} Ladeabrechnungen, ${ladeLaeufe.belege} Belege, ` +
      `${ladeLaeufe.brutto.toLocaleString("de-AT", { style: "currency", currency: "EUR" })} brutto` + EOL,
  );
}

// --- Plattformebene --------------------------------------------------
const plattform = befuellePlattform(neu);
if (!plattform.dauerMs) {
  console.log("Plattformdaten bereits vorhanden - uebersprungen." + EOL);
} else {
  console.log(
    `Plattform: ${plattform.geraete} Edge-Geraete, ${plattform.vlans} VLANs, ` +
      `${plattform.sollparameter} Sollparameter, ${plattform.driftlaeufe} Driftlaeufe, ` +
      `${plattform.protokoll} Protokolleintraege` + EOL +
      `           ${plattform.wafRegeln} WAF-Regeln, ${plattform.wafEreignisse.toLocaleString("de-AT")} abgewehrte Zugriffe, ` +
      `${plattform.ztSitzungen} Zero-Trust-Sitzungen` + EOL +
      `           ${plattform.marktpreise.toLocaleString("de-AT")} Boersenpreise, ${plattform.fahrplaene} Fahrplaene, ` +
      `${plattform.dokumente} Dokumente, ${plattform.esgPositionen} ESG-Positionen` + EOL +
      `           ${plattform.benachrichtigungen} Meldungen, ${plattform.buchungen} Buchungen ` +
      `in ${(plattform.dauerMs / 1000).toFixed(1)} s` + EOL,
  );
}

