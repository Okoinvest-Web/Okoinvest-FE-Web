import { Sparkline } from "@/components/diagramme/sparkline";
import { Tabelle, Zeile, Zelle, ZelleMitZusatz } from "@/components/tabelle";
import {
  Hinweis,
  Kennzahl,
  Kennzahlenleiste,
  LeerZustand,
  Seitenkopf,
  Status,
  Tafel,
} from "@/components/ui";
import { kuerzeZaehlpunkt } from "@/lib/at/zaehlpunkt";
import { ladePortfolio, letzteTage } from "@/lib/daten/monitoring";
import { ENERGIE_FARBEN, ZUSTANDSFARBE } from "@/lib/farben";
import {
  formatDatum,
  formatEnergie,
  formatProzent,
  formatZahl,
} from "@/lib/format";
