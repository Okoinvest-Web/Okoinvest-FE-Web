alt = """/** Tag des Kommunikationsabbruchs, relativ zu heute. */
const ABBRUCH_VOR_TAGEN = 26;"""
neu = """/** Tag des Kommunikationsabbruchs, relativ zu heute. */
const ABBRUCH_VOR_TAGEN = 26;

/**
 * Morgenschatten durch das Nachbargebäude.
 *
 * Zwischen 07:00 und 09:00 Ortszeit liegt ein Teil des Feldes im
 * Schatten; danach erholt sich die Anlage vollständig. Genau diese
 * Signatur - scharfer Einbruch, Erholung, jeden Tag zur selben
 * Stunde - unterscheidet einen Schatten von einem Defekt.
 */
const SCHATTEN_VON_MINUTE = 7 * 60;
const SCHATTEN_BIS_MINUTE = 9 * 60;
const SCHATTEN_RESTANTEIL = 0.32;

/**
 * Verschmutzung auf dem Carport.
 *
 * Ein Carport an einer Zufahrt bekommt Staub und Bremsabrieb ab. Die
 * Ausbeute sinkt langsam, bis ein kräftiger Regen sie zurücksetzt.
 * Der Sprung nach oben ist das einzige Merkmal, das Verschmutzung von
 * Alterung unterscheidet - ohne ihn wird jahrelang abgeschrieben,
 * was sich waschen ließe.
 */
const VERSCHMUTZTE_ANLAGE = "ANL-0005";
const REGEN_VOR_TAGEN = 9;
/** Verlust je Tag ohne Regen, als Anteil der Leistung. */
const VERSCHMUTZUNG_JE_TAG = 0.004;
const VERSCHMUTZUNG_HOECHSTENS = 0.11;

/**
 * Wie stark die Verschmutzung an einem Tag bremst.
 *
 * Gezählt wird ab dem letzten Regen. Vor dem Regen liegen die Module
 * seit Beginn des Datenbestands ungewaschen da, danach beginnt die
 * Zählung von vorn.
 */
function verschmutzung(anlageId: string, tagVonHeute: number): number {
  if (anlageId !== VERSCHMUTZTE_ANLAGE) return 0;

  const tageSeitRegen =
    tagVonHeute > REGEN_VOR_TAGEN
      ? TAGE_DETAIL - tagVonHeute
      : REGEN_VOR_TAGEN - tagVonHeute;

  return Math.min(
    VERSCHMUTZUNG_HOECHSTENS,
    tageSeitRegen * VERSCHMUTZUNG_JE_TAG,
  );
}"""
assert alt in s
s = s.replace(alt, neu, 1)

