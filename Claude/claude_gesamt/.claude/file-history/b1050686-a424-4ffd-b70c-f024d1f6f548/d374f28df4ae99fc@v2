block_end = s.index("  },", block_start)
block = s[block_start:block_end]
assert "stoerung" not in block, block
s = (
    s[:block_end]
    + "    // Das Nachbargebäude wirft bis neun Uhr einen Schatten.\n"
    + '    stoerung: "morgenschatten",\n'
    + s[block_end:]
)

