const NACH_SCHLUESSEL = new Map(ROLLEN.map((r) => [r.schluessel, r]));

export function findeRolle(schluessel: string): RollenDefinition | undefined {
  return NACH_SCHLUESSEL.get(schluessel);
}

/**
 * Hat eine der Rollen das verlangte Recht?
 *
 * Ohne passende Rolle wird abgelehnt - eine unbekannte Rolle bringt
 * keine Rechte mit.
 */
export function hatRecht(rollen: string[], recht: Recht): boolean {
  return rollen.some((schluessel) =>
    findeRolle(schluessel)?.rechte.includes(recht),
  );
}

/** Alle Rechte, die sich aus mehreren Rollen zusammen ergeben. */
export function rechteVon(rollen: string[]): Set<Recht> {
  const menge = new Set<Recht>();
  for (const schluessel of rollen) {
    for (const recht of findeRolle(schluessel)?.rechte ?? []) {
      menge.add(recht);
    }
  }
  return menge;
}
