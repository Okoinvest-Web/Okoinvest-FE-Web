export interface DemoAnmeldung {
  benutzer: string;
  vollname: string;
  rolle: string;
  kunde: string;
}

/**
 * Prueft eine Anmeldung gegen die Demonstrationskonten.
 * Gibt `null` zurueck, wenn der Demonstrationsbetrieb aus ist oder die
 * Zugangsdaten nicht passen.
 */
export function pruefeDemoAnmeldung(
  email: string,
  passwort: string,
): DemoAnmeldung | null {
  if (!istDemoModus()) return null;
  if (passwort !== DEMO_PASSWORT) return null;

  const gesucht = email.trim().toLowerCase();
  const konto = DEMO_KONTEN.find((k) => k.email.toLowerCase() === gesucht);
  if (!konto) return null;

  const stammdaten = DEMO_BENUTZER.find((b) => b.benutzer === konto.email);

  return {
    benutzer: konto.email,
    vollname: stammdaten?.vollname ?? konto.name,
    rolle: konto.rolle,
    kunde: DEMO_KUNDE.name,
  };
}
