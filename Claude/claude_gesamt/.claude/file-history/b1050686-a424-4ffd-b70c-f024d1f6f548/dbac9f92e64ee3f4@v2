import { DEMO_BENUTZER, DEMO_KUNDE } from "./stammdaten";

/**
 * Demonstrationsbetrieb.
 *
 * Ohne erreichbare Frappe-Instanz haette das Portal nichts anzuzeigen.
 * Im Demonstrationsbetrieb liefert die Datenschicht stattdessen einen
 * vollstaendigen, in sich stimmigen Beispieldatensatz.
 *
 * Die Umschaltung laeuft ueber DEMO_MODUS in .env.local und ist damit
 * eine bewusste Entscheidung beim Betrieb - nicht etwas, das sich zur
 * Laufzeit von aussen aktivieren liesse.
 */

export function istDemoModus(): boolean {
  return process.env.DEMO_MODUS === "1";
}

/**
 * Zugangsdaten fuer die Vorfuehrung.
 *
 * Das Passwort ist fuer alle Demonstrationskonten gleich und bewusst
 * offen dokumentiert - im Demonstrationsbetrieb gibt es nichts zu
 * schuetzen. Ist DEMO_MODUS aus, lehnt die Anmeldung diese Konten ab
 * und es gilt ausschliesslich die Frappe-Anmeldung.
 */
export const DEMO_PASSWORT = "demo";

export interface DemoKonto {
  email: string;
  name: string;
  rolle: string;
  rollenBezeichnung: string;
  beschreibung: string;
}

