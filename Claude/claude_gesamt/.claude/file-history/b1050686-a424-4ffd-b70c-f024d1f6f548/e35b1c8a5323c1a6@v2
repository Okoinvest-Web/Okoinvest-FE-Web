export interface Datenbestand {
  fruehester: string | null;
  spaetester: string | null;
  zeilen: number;
}

export function ladeDatenbestand(gemeinschaftId: string): Datenbestand {
  const zeile = eine<Datenbestand>(
    `SELECT MIN(l.zeitpunkt) AS fruehester,
            MAX(l.zeitpunkt) AS spaetester,
            COUNT(*)         AS zeilen
       FROM lastgang l
      WHERE l.zaehlpunkt_id IN (
              SELECT zaehlpunkt_id FROM teilnahme WHERE gemeinschaft_id = ?)`,
    gemeinschaftId,
  );

  return zeile ?? { fruehester: null, spaetester: null, zeilen: 0 };
}

/**
 * Legt einen Abrechnungslauf an.
 * Gibt die Kennung zurueck; das Rechnen erfolgt getrennt.
 */
export function legeLaufAn(
  gemeinschaftId: string,
  von: Date,
  bis: Date,
  modell: "Statisch" | "Dynamisch",
  preisCt: number,
  erzeugerCt: number,
  ustSatz: number,
  benutzer: string,
): string {
  const jahr = von.getFullYear();
  const quartal = Math.floor(von.getMonth() / 3) + 1;
  let id = `LAUF-${jahr}Q${quartal}`;

  // Bei mehreren Laeufen fuer denselben Zeitraum - etwa nach einem
  // Storno - wird durchnummeriert.
  let versuch = 1;
  while (skalar<number>("SELECT COUNT(*) FROM abrechnungslauf WHERE id = ?", id)) {
    versuch += 1;
    id = `LAUF-${jahr}Q${quartal}-${versuch}`;
  }

  schreibe(
    `INSERT INTO abrechnungslauf
       (id, gemeinschaft_id, zeitraum_von, zeitraum_bis, modell,
        preis_ct_kwh, erzeuger_ct_kwh, ust_satz, angelegt_von)
     VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)`,
    id,
    gemeinschaftId,
    messStempel(von),
    messStempel(new Date(bis.getTime() + 1)),
    modell,
    preisCt,
    erzeugerCt,
    ustSatz,
    benutzer,
  );

  return id;
}
