/** Zaehlpunktbezeichnung: AT + Netzbetreiber (6) + PLZ auf 5 + Lauf (20). */
function zp(netz: string, plz: string, lauf: string): string {
  return `AT${netz}0${plz}${lauf.padStart(20, "0")}`;
}

