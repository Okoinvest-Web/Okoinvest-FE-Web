/**
 * Erzeugt den Lastgang eines Zaehlpunkts.
 *
 * Bezug und Einspeisung entstehen aus der Differenz von Erzeugung und
 * Verbrauch - so, wie ein echter Zweirichtungszaehler misst. Ein
 * Zaehlpunkt kann in derselben Viertelstunde nicht beides aufweisen.
 */
function* lastgangZeilen(
  vorlage: ZaehlpunktVorlage,
  vonTag: Date,
  tage: number,
): Generator<{
  zeitpunkt: string;
  richtung: "Bezug" | "Einspeisung";
  wert: number;
}> {
  for (let versatz = 0; versatz < tage; versatz++) {
    const tag = verschiebeTage(vonTag, versatz);
    const schluessel = tagesSchluessel(tag);

    const bewoelkung = bewoelkungAmTag(tag, vorlage.id);
    const zufall = zufallsfolge(startwertAus(`${vorlage.id}-${schluessel}`));

    // Von Mitternacht Ortszeit bis Mitternacht des Folgetags, in
    // Schritten von 15 Minuten echter Zeit. An Umstellungstagen ergibt
    // das 92 beziehungsweise 100 Werte - genau so, wie ein Zaehler misst.
    const tagBeginn = new Date(tag);
    tagBeginn.setHours(0, 0, 0, 0);
    const tagEnde = verschiebeTage(tagBeginn, 1);
    tagEnde.setHours(0, 0, 0, 0);

    for (
      let zeit = new Date(tagBeginn);
      zeit < tagEnde;
      zeit = new Date(zeit.getTime() + 15 * 60 * 1000)
    ) {

      const erzeugungKwh =
        vorlage.kwp > 0
          ? erzeugungKw(vorlage.kwp, zeit, zufall, bewoelkung) * 0.25
          : 0;

      const verbrauchKwh =
        verbrauchKw(vorlage.grundlast, vorlage.spitzenlast, zeit, zufall) * 0.25;

      const saldo = erzeugungKwh - verbrauchKwh;
      const zeitpunkt = messStempel(zeit);

      if (saldo > 0.0005) {
        yield {
          zeitpunkt,
          richtung: "Einspeisung",
          wert: Number(saldo.toFixed(3)),
        };
      } else {
        // Auch ein Saldo von null wird geschrieben. Ein Zaehler misst
        // in jeder Viertelstunde - eine fehlende Zeile bedeutet
        // "keine Daten", nicht "kein Verbrauch". Die Pruefung auf
        // Datenluecken kann beides nur unterscheiden, wenn Nullwerte
        // tatsaechlich vorliegen.
        yield {
          zeitpunkt,
          richtung: "Bezug",
          wert: Number(Math.max(0, -saldo).toFixed(3)),
        };
      }
    }
  }
}


export interface BefuellErgebnis {
  uebersprungen: boolean;
  zaehlpunkte: number;
  lastgangZeilen: number;
  dauerMs: number;
}

export function befuelleDatenbank(erzwingen = false): BefuellErgebnis {
  const start = Date.now();

  if (istBefuellt() && !erzwingen) {
    return { uebersprungen: true, zaehlpunkte: 0, lastgangZeilen: 0, dauerMs: 0 };
  }

  const heute = new Date();
  heute.setHours(0, 0, 0, 0);
  const beginn = verschiebeTage(heute, -TAGE_LASTGANG + 1);

  let zeilen = 0;

  imBlock(() => {
    if (erzwingen) leereAlles();

    // --- Kunden ---
    schreibe(
      `INSERT INTO kunde (id, firma, uid, firmenbuch, strasse, plz, ort,
                          bundesland, email, telefon, branche)
       VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
      KUNDE.id,
      KUNDE.firma,
      KUNDE.uid,
      KUNDE.firmenbuch,
      KUNDE.strasse,
      KUNDE.plz,
      KUNDE.ort,
      KUNDE.bundesland,
      KUNDE.email,
      KUNDE.telefon,
      KUNDE.branche,
    );

    for (const mitglied of MITGLIEDER) {
      schreibe(
        `INSERT INTO kunde (id, firma, uid, plz, ort, bundesland, branche)
         VALUES (?, ?, ?, '3100', 'St. Pölten', 'Niederösterreich', ?)`,
        mitglied.id,
        mitglied.firma,
        mitglied.uid,
        mitglied.branche,
      );
    }

    // --- Anlagen ---
    for (const anlage of ANLAGEN) {
      schreibe(
        `INSERT INTO anlage (id, kunde_id, bezeichnung, standort, plz, ort,
                             bundesland, leistung_kwp, wechselrichter_kw,
                             speicher_kwh, modul_typ, modul_anzahl,
                             wechselrichter_typ, steuerung_typ, ausrichtung,
                             neigung, inbetriebnahme, status, soll_ertrag_kwh,
                             latitude, longitude)
         VALUES (?, ?, ?, ?, ?, ?, 'Niederösterreich', ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
        anlage.id,
        KUNDE.id,
        anlage.bezeichnung,
        anlage.standort,
        anlage.plz,
        anlage.ort,
        anlage.leistung_kwp,
        anlage.wechselrichter_kw,
        anlage.speicher_kwh,
        anlage.modul_typ,
        anlage.modul_anzahl,
        anlage.wechselrichter_typ,
        anlage.steuerung_typ,
        anlage.ausrichtung,
        anlage.neigung,
        anlage.inbetriebnahme,
        anlage.id === "ANL-0003" ? "Wartung" : "Aktiv",
        anlage.soll_ertrag_kwh,
        anlage.lat,
        anlage.lon,
      );
    }

    // --- Zaehlpunkte ---
    for (const vorlage of ZAEHLPUNKTE) {
      schreibe(
        `INSERT INTO zaehlpunkt (id, bezeichnung, kunde_id, anlage_id, art,
                                 netzbetreiber_kz, netzebene, anschlussleistung,
                                 adresse, plz, ort)
         VALUES (?, ?, ?, ?, ?, '200000', ?, ?, ?, ?, ?)`,
        vorlage.id,
        vorlage.bezeichnung,
        vorlage.kundeId,
        vorlage.anlageId,
        vorlage.art,
        vorlage.netzebene,
        vorlage.anschlussleistung,
        vorlage.adresse,
        vorlage.plz,
        vorlage.ort,
      );
    }

    // --- Lastgang ---
    // Eine vorbereitete Anweisung fuer alle Zeilen: Bei mehreren
    // hunderttausend Einfuegungen macht das den Unterschied zwischen
    // Sekunden und Minuten.
    const einfuegen = db().prepare(
      `INSERT OR REPLACE INTO lastgang
         (zaehlpunkt_id, zeitpunkt, richtung, wert_kwh, qualitaet, quelle)
       VALUES (?, ?, ?, ?, 'Gemessen', 'EDA')`,
    );

    for (const vorlage of ZAEHLPUNKTE) {
      for (const zeile of lastgangZeilen(vorlage, beginn, TAGE_LASTGANG)) {
        einfuegen.run(vorlage.id, zeile.zeitpunkt, zeile.richtung, zeile.wert);
        zeilen += 1;
      }
    }

    befuelleGemeinschaft(beginn);
    befuelleBetrieb();
    befuelleBenutzer();
  });

  return {
    uebersprungen: false,
    zaehlpunkte: ZAEHLPUNKTE.length,
    lastgangZeilen: zeilen,
    dauerMs: Date.now() - start,
  };
}

function befuelleGemeinschaft(beginn: Date): void {
  schreibe(
    `INSERT INTO gemeinschaft (id, bezeichnung, art, rechtsform, reichweite,
                               netzbetreiber_kz, gegruendet_am, aufteilungsmodell, status)
     VALUES ('EEG-0001', 'Energiegemeinschaft Industriepark St. Pölten', 'EEG',
             'Verein', 'Lokal', '200000', '2024-03-18', 'Dynamisch', 'Aktiv')`,
  );

  /**
   * Teilnahmen. Die Anteile gelten nur bei statischer Aufteilung; im
   * dynamischen Modell bleiben sie ungenutzt, werden aber gepflegt,
   * damit ein Wechsel des Modells moeglich ist.
   *
   * Die Zaehlpunkte in Amstetten und Krems nehmen NICHT teil: Eine
   * lokale EEG setzt denselben Netzbereich voraus. Das ist kein Detail,
   * sondern der haeufigste Grund, warum ein Beitritt abgelehnt wird.
   */
  const teilnahmen: [string, string, number, number][] = [
    ["ZP-0001", "Beides", 34.0, 1.0],
    ["ZP-0004", "Beides", 6.0, 1.0],
    ["ZP-0006", "Verbraucher", 21.0, 1.0],
    ["ZP-0007", "Verbraucher", 12.0, 1.0],
    ["ZP-0008", "Verbraucher", 11.0, 1.0],
    ["ZP-0009", "Verbraucher", 9.0, 0.6],
    ["ZP-0010", "Verbraucher", 7.0, 1.0],
  ];

  const beitritt = tagesSchluessel(beginn);

  let nummer = 0;
  for (const [zaehlpunkt, rolle, anteil, faktor] of teilnahmen) {
    nummer += 1;
    schreibe(
      `INSERT INTO teilnahme (id, gemeinschaft_id, zaehlpunkt_id, rolle,
                              anteil_prozent, teilnahmefaktor, gueltig_von)
       VALUES (?, 'EEG-0001', ?, ?, ?, ?, ?)`,
      `TN-${String(nummer).padStart(4, "0")}`,
      zaehlpunkt,
      rolle,
      anteil,
      faktor,
      `${beitritt}T00:00`,
    );
  }

  // EDA-Vorgaenge: die Anmeldungen, ueber die die Teilnahmen zustande kamen.
  nummer = 0;
  for (const [zaehlpunkt] of teilnahmen) {
    nummer += 1;
    schreibe(
      `INSERT INTO eda_prozess (id, gemeinschaft_id, zaehlpunkt_id, art, status,
                                referenz, gesendet_am, beantwortet_am, angelegt_von)
       VALUES (?, 'EEG-0001', ?, 'CCMI', 'Angenommen', ?,
               datetime('now','-120 days'), datetime('now','-118 days'), 'System')`,
      `EDA-${String(nummer).padStart(4, "0")}`,
      zaehlpunkt,
      `NB-2026-${String(40000 + nummer)}`,
    );
  }

  // Ein abgelehnter Vorgang - der Regelfall bei Zaehlpunkten ausserhalb
  // des Netzbereichs. Ohne solche Faelle wäre die Liste unrealistisch.
  schreibe(
    `INSERT INTO eda_prozess (id, gemeinschaft_id, zaehlpunkt_id, art, status,
                              referenz, ablehnungsgrund, gesendet_am,
                              beantwortet_am, angelegt_von)
     VALUES ('EDA-0008', 'EEG-0001', 'ZP-0003', 'CCMI', 'Abgelehnt',
             'NB-2026-40008',
             'Zählpunkt liegt außerhalb des Netzbereichs der lokalen Erneuerbare-Energie-Gemeinschaft (abweichende Trafostation).',
             datetime('now','-95 days'), datetime('now','-93 days'), 'System')`,
  );

  // Ein offener Vorgang - wartet auf die Zustimmung des Inhabers.
  schreibe(
