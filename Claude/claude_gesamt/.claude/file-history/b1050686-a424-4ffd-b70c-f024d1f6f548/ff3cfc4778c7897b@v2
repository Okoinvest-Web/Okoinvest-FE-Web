// Kandidatenpalette in OKLCH definieren und als Hex ausgeben.
export function oklchToHex(L, C, hDeg) {
  const h = (hDeg * Math.PI) / 180;
  const a = C * Math.cos(h);
  const b = C * Math.sin(h);

  const l_ = L + 0.3963377774 * a + 0.2158037573 * b;
  const m_ = L - 0.1055613458 * a - 0.0638541728 * b;
  const s_ = L - 0.0894841775 * a - 1.291485548 * b;

  const l = l_ ** 3;
  const m = m_ ** 3;
  const s = s_ ** 3;

  const lr = +4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s;
  const lg = -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s;
  const lb = -0.0041960863 * l - 0.7034186147 * m + 1.707614701 * s;

  const gamma = (u) =>
    u <= 0.0031308 ? 12.92 * u : 1.055 * Math.pow(u, 1 / 2.4) - 0.055;

  const toByte = (u) =>
    Math.max(0, Math.min(255, Math.round(gamma(u) * 255)))
      .toString(16)
      .padStart(2, "0");

  return `#${toByte(lr)}${toByte(lg)}${toByte(lb)}`;
}

// Reihenfolge = Zuweisungsreihenfolge der Serien.
export const KANDIDAT = {
  erzeugung: [0.7, 0.165, 62],
  eigenverbrauch: [0.585, 0.145, 152],
  einspeisung: [0.6, 0.135, 232],
  netzbezug: [0.44, 0.062, 276],
  speicher: [0.55, 0.205, 325],
  stoerung: [0.56, 0.205, 25],
};

if (import.meta.url.endsWith(process.argv[1]?.replace(/\\/g, "/") ?? "")) {
  const hex = [];
  for (const [name, [L, C, h]] of Object.entries(KANDIDAT)) {
    const wert = oklchToHex(L, C, h);
    hex.push(wert);
    console.log(`${name.padEnd(16)} oklch(${L} ${C} ${h}) -> ${wert}`);
  }
  console.log("\n" + hex.join(","));
}
