def lesefassung_html(e, meta, ordner, bild):
    titel = meta.get("titel") or e.get("titel") or ""
    lead = meta.get("beschreibung") or ""
    hinweis = e.get("hinweis", "")
    koerper = ""
    vtts = sorted(ordner.glob("video/*.vtt"))
    txts = sorted(ordner.glob("audio/*Transkript*.txt"))
    if vtts:
        a = e.get("ausschnitt", {})
        koerper = ("<h3>Transkript (ORF-Untertitel)</h3><div class='transkript'><p>"
                   + html.escape(vtt_text(vtts[0], a.get("von"), a.get("bis"))) + "</p></div>")
    elif txts:
        a = e.get("ausschnitt", {})
        zeilen = txts[0].read_text(encoding="utf-8").splitlines()[2:]
        if a:
            zeilen = [z for z in zeilen
                      if re.match(r"\[(\d+:\d\d:\d\d)", z)
                      and a["von"] <= re.match(r"\[(\d+:\d\d:\d\d)", z).group(1).rjust(8, "0") <= a["bis"]]
        koerper = ("<h3>Transkript (automatisch erstellt, ungeprüft)</h3><div class='transkript'><p>"
                   + html.escape("\n".join(zeilen)) + "</p></div>")
    else:
        text = artikeltext(ordner, titel)
        if lead and lead[:60] in text:
            lead = ""
        koerper = md_zu_html(text)
    bild_html = (f"<figure><img src='{bild.as_uri()}'><figcaption>Bild: aus dem Originalbeitrag "
                 f"({html.escape(e['medium'])})</figcaption></figure>") if bild else ""
    q = [("Medium", e["medium"]), ("Art", e.get("art", "")),
         ("Erschienen", datum_lang(meta.get("datum") or e.get("datum"))),
         ("Autor", autor_sauber(meta.get("autor"), e["medium"])),
         ("Quelle", f"<a href='{html.escape(e['url'])}'>{html.escape(e['url'])}</a>"),
         ("Archiviert", (meta.get("abruf") or "")[:16].replace("T", ", ") + " Uhr")]
    return f"""<!doctype html><html lang="de"><head><meta charset="utf-8"><title>{html.escape(titel)}</title>
<style>{STIL}</style></head><body>
<div class="kopf"><span><b>Pressearchiv</b> · WKStA / Salzburg AG</span><span>{html.escape(e['medium'].split(' (')[0])}</span></div>
<p class="rubrik">{html.escape(e.get('art', ''))} · {datum_lang(meta.get('datum') or e.get('datum'))}</p>
<h1>{html.escape(titel)}</h1>
<div class="zeile"><span>{html.escape(e['medium'])}</span><span>{html.escape(autor_sauber(meta.get('autor'), e['medium']))}</span></div>
{bild_html}
{f"<p class='lead'>{html.escape(lead)}</p>" if lead else ""}
{f"<div class='hinweis'><b>Archivhinweis:</b> {html.escape(hinweis)}</div>" if hinweis else ""}
<div class="text">{koerper}</div>
<div class="quelle">{''.join(f'<b>{k}</b><span>{v}</span>' for k, v in q)}</div>
</body></html>"""


