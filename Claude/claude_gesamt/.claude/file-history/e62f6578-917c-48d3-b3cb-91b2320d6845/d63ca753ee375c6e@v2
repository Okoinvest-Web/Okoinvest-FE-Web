MONATE = ["Jänner", "Februar", "März", "April", "Mai", "Juni", "Juli",
          "August", "September", "Oktober", "November", "Dezember"]
MUELL = re.compile(r"(bevorzugte Google-Quelle|^\s*-?\s*\*\*Mehr zum Thema|Lesen Sie auch|"
                   r"^Lesedauer|^- Anzeige -|^Anzeige$|^\s*#\s*$)", re.I)


def autor_sauber(autor, medium):
    """Entfernt Seitennamen/Kürzel aus dem Autorenfeld (z. B. 'Nachrichten At', 'Red')."""
    if not autor:
        return "Redaktion"
    kurz = medium.split(" (")[0].lower()
    teile = [t.strip() for t in autor.split(";")]
    teile = [t for t in teile if t and t.lower() not in (kurz, "red", "salzburg", "orf 2")
             and not re.search(r"(at|com|de)$", t.lower()) and t.lower() not in medium.lower()]
    return ", ".join(teile) or "Redaktion"


def datum_lang(iso):
    try:
        d = datetime.fromisoformat(iso[:10])
        return f"{d.day}. {MONATE[d.month - 1]} {d.year}"
    except Exception:
        return iso or "unbekannt"


def sha256(p):
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for c in iter(lambda: f.read(1 << 20), b""):
            h.update(c)
    return h.hexdigest()


def groesse(n):
    for e in ("B", "KB", "MB", "GB"):
        if n < 1024:
            return f"{n:.0f} {e}"
        n /= 1024
    return f"{n:.1f} TB"


def md_zu_html(md):
    """Minimaler Markdown-Konverter für Artikeltexte."""
    teile, liste = [], False
    for zeile in md.splitlines():
        z = zeile.strip()
        if not z or MUELL.search(z):
            if liste:
                teile.append("</ul>"); liste = False
            continue
        z = html.escape(z)
        z = re.sub(r"\*\*(.+?)\*\*", r"<strong>\1</strong>", z)
        z = re.sub(r"(?<!\*)\*(?!\*)(.+?)\*", r"<em>\1</em>", z)
        if z.startswith("#"):
            teile.append(f"<h3>{z.lstrip('#').strip()}</h3>")
        elif z.startswith("- "):
            if not liste:
                teile.append("<ul>"); liste = True
            teile.append(f"<li>{z[2:]}</li>")
        else:
            teile.append(f"<p>{z}</p>")
    if liste:
        teile.append("</ul>")
    return "\n".join(teile)


def artikeltext(ordner, titel):
    p = ordner / "artikel.md"
    if not p.exists():
        return ""
    t = p.read_text(encoding="utf-8").split("\n---\n", 1)[-1]
    # doppelte Überschriften / Titelzeilen entfernen
    zeilen = [z for z in t.splitlines()
              if z.strip().lstrip("#").strip() != (titel or "").strip()]
    # doppelte Absätze entfernen
    gesehen, rein = set(), []
    for z in zeilen:
        k = z.strip()
        if k and k in gesehen:
            continue
        gesehen.add(k); rein.append(z)
    return "\n".join(rein)


def vtt_text(vtt, von=None, bis=None):
    """Untertitel (.vtt) in Fließtext mit Zeitmarken umwandeln."""
    bloecke = re.split(r"\n\s*\n", vtt.read_text(encoding="utf-8"))
    aus, letzte_marke = [], -60
    for b in bloecke:
        m = re.search(r"(\d\d:\d\d:\d\d)\.\d+ -->", b)
        if not m:
            continue
        t = m.group(1)
        if von and t < von or bis and t > bis:
            continue
        text = " ".join(l.strip() for l in b.splitlines()[b.splitlines().index(
            next(l for l in b.splitlines() if "-->" in l)) + 1:] if l.strip())
        text = re.sub(r"<[^>]+>", "", text)
        s = sum(int(x) * f for x, f in zip(t.split(":"), (3600, 60, 1)))
        if s - letzte_marke >= 30:
            aus.append(f"\n[{t}] "); letzte_marke = s
        aus.append(text + " ")
    return "".join(aus).strip()


def bild_holen(ordner, meta):
    ziel = ordner / "bild.jpg"
    if ziel.exists():
        return ziel
    for kand in sorted(ordner.glob("video/*.jpg")):
        return kand
    oh = ordner / "original.html"
    if not oh.exists():
        return None
    m = re.search(r'<meta[^>]+property="og:image"[^>]+content="([^"]+)"', oh.read_text(encoding="utf-8")) \
        or re.search(r'<meta[^>]+content="([^"]+)"[^>]+property="og:image"', oh.read_text(encoding="utf-8"))
    if not m:
        return None
    try:
        r = requests.get(html.unescape(m.group(1)), timeout=30,
                         headers={"User-Agent": "Mozilla/5.0"})
        if r.ok and r.headers.get("content-type", "").startswith("image"):
            ziel.write_bytes(r.content)
            return ziel
    except Exception:
        pass
    return None


