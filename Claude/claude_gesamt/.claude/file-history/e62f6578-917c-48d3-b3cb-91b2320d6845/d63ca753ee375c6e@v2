def main():
    quellen = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
    thema = BASIS / quellen[0]["ordner"].split("/")[0]
    eintraege = []
    with sync_playwright() as p:
        browser = p.chromium.launch()
        page = browser.new_page()
        for e in quellen:
            ordner = BASIS / e["ordner"]
            mp = ordner / "meta.json"
            meta = json.loads(mp.read_text(encoding="utf-8")) if mp.exists() else dict(e)
            meta.update({k: e[k] for k in ("titel", "datum", "hinweis", "ausschnitt") if e.get(k)})
            bild = bild_holen(ordner, meta)
            (ordner / "_lesefassung.html").write_text(lesefassung_html(e, meta, ordner, bild), encoding="utf-8")
            page.goto((ordner / "_lesefassung.html").as_uri(), wait_until="networkidle")
            page.pdf(path=str(ordner / "LESEFASSUNG.pdf"), format="A4", print_background=True,
                     display_header_footer=True, header_template="<span></span>",
                     footer_template="<div style='font-size:7pt;width:100%;text-align:center;color:#888;"
                                     "font-family:Arial'>Seite <span class='pageNumber'></span> / "
                                     "<span class='totalPages'></span></div>")
            (ordner / "_lesefassung.html").unlink()
            meta["sha256"] = {str(f.relative_to(ordner)).replace("\\", "/"): sha256(f)
                              for f in sorted(ordner.rglob("*")) if f.is_file() and f.name != "meta.json"}
            mp.write_text(json.dumps(meta, ensure_ascii=False, indent=2), encoding="utf-8")
            eintraege.append((e, meta, ordner, bild))
            print("ok", e["id"])

        eintraege.sort(key=lambda x: (x[1].get("kategorie") != "Berichterstattung", x[1].get("datum") or ""))
        # ---- CSV
        with open(thema / "00_UEBERSICHT.csv", "w", encoding="utf-8-sig", newline="") as f:
            w = csv.writer(f, delimiter=";")
            w.writerow(["Datum", "Medium", "Art", "Titel", "Autor", "Kategorie", "URL", "Ordner",
                        "Archiviert am", "Hinweis"])
            for e, m, o, _ in eintraege:
                w.writerow([m.get("datum"), e["medium"], e.get("art"), m.get("titel"), autor_sauber(m.get("autor"), e["medium"]),
                            e.get("kategorie"), e["url"], str(o.relative_to(thema)),
                            (m.get("abruf") or "")[:19], e.get("hinweis", "")])
        # ---- HTML-Übersicht
        karten, letzter_tag = [], None
        for e, m, o, bild in eintraege:
            tag = ("Hintergrund" if e.get("kategorie") == "Hintergrund"
                   else datum_lang(m.get("datum")))
            if tag != letzter_tag:
                karten.append(f"<div class='tag'>{tag}</div>"); letzter_tag = tag
            rel = lambda f: str(f.relative_to(thema)).replace("\\", "/")
            links = [("Lesefassung", o / "LESEFASSUNG.pdf"), ("Original-PDF", o / "artikel.pdf"),
                     ("Screenshot", o / "screenshot.png"), ("Original-HTML", o / "original.html")]
            links += [("▶ " + f.stem[:40], f) for f in sorted(o.glob("*/*.mp4")) + sorted(o.glob("*/*.mp3"))]
            lk = " ".join(f"<a href='{html.escape(rel(f))}'>{n}</a>" for n, f in links if f.exists())
            img = f"<img src='{html.escape(rel(bild))}'>" if bild else "<img>"
            beschr = m.get("beschreibung") or ""
            karten.append(f"""<div class='karte'>{img}<div>
<div class='med'><b>{html.escape(e['medium'])}</b> · {html.escape(e.get('art', ''))} · {datum_lang(m.get('datum'))}</div>
<h2>{html.escape(m.get('titel') or '')}</h2>
{f"<p>{html.escape(beschr[:300])}</p>" if beschr else ""}
{f"<div class='warn'>Hinweis: {html.escape(e['hinweis'])}</div>" if e.get('hinweis') else ""}
<div class='dateien'>{lk} <a href='{html.escape(e['url'])}'>Online-Quelle ↗</a></div></div></div>""")
        n_bericht = sum(1 for e, *_ in eintraege if e.get("kategorie") == "Berichterstattung")
        heute = datetime.now()
        doc = f"""<!doctype html><html lang="de"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1"><title>Pressespiegel WKStA – Salzburg AG</title>
<style>{UEB_STIL}</style></head><body><div class="wrap">
<div class="kopf"><span><b>Pressearchiv</b> · Pressespiegel</span><span>Stand {heute.day}. {MONATE[heute.month-1]} {heute.year}</span></div>
<div class="titel"><p class="rubrik">Causa Photovoltaik-Auftrag / Ökovolt</p>
<h1>WKStA-Ermittlungen gegen die Salzburg AG</h1>
<p>{n_bericht} Beiträge der Berichterstattung · {len(eintraege) - n_bericht} Hintergrundbeitrag · Text, Original, Video &amp; Audio</p></div>
<div class="zusammenfassung"><b>Worum es geht:</b> Die Wirtschafts- und Korruptionsstaatsanwaltschaft (WKStA)
ermittelt wegen des Verdachts des schweren Betrugs gegen die Salzburg AG und eine natürliche Person. Anlass ist eine
Anzeige der Ökovolt Solartechnik GmbH (Ostermiething, OÖ), die sich 2020 nach eigener Darstellung auf Zusage der
Salzburg AG aus der Ausschreibung für PV-Anlagen auf Hofer-Filialdächern zurückzog; der Auftrag ging dann über eine
Tochter der Salzburg AG an einen Mitbewerber. Ökovolt macht über 20 Mio. Euro Schaden geltend. Die Salzburg AG
(seit 2021 zu 49&nbsp;% an Ökovolt beteiligt) weist die Vorwürfe zurück und spricht von einem Gesellschafterstreit.
Es gilt die Unschuldsvermutung.</div>
{''.join(karten)}
<div class="fuss">Jeder Beitrag liegt in einem eigenen Ordner: LESEFASSUNG.pdf (lesefreundlich), artikel.pdf und
screenshot.png (Originalansicht), original.html (Quellcode), artikel.md (Text), meta.json (Metadaten) sowie
video/ bzw. audio/. Die Datei PRUEFSUMMEN_SHA256.txt belegt den unveränderten Zustand aller Dateien.</div>
</div></body></html>"""
        (thema / "00_UEBERSICHT.html").write_text(doc, encoding="utf-8")
        page.goto((thema / "00_UEBERSICHT.html").as_uri(), wait_until="networkidle")
        page.pdf(path=str(thema / "00_UEBERSICHT.pdf"), format="A4", print_background=True)
        browser.close()
    # ---- Prüfsummen
    zeilen = [f"# SHA-256-Prüfsummen – erstellt {datetime.now().isoformat(timespec='seconds')}",
              "# Prüfen (PowerShell):  Get-FileHash -Algorithm SHA256 <Datei>", ""]
    for f in sorted(thema.rglob("*")):
        if f.is_file() and f.name != "PRUEFSUMMEN_SHA256.txt":
            zeilen.append(f"{sha256(f)}  {groesse(f.stat().st_size):>8}  {f.relative_to(thema)}")
    (thema / "PRUEFSUMMEN_SHA256.txt").write_text("\n".join(zeilen) + "\n", encoding="utf-8")
    print("Übersicht fertig:", thema / "00_UEBERSICHT.html")


if __name__ == "__main__":
    main()
