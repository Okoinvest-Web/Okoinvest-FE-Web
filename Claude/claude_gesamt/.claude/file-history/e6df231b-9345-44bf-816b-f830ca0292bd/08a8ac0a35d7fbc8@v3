/**
 * Vier Wartungszyklen mit leicht fallendem Isolationswiderstand — String 4
 * nähert sich dem Grenzwert und zeigt, wofür die Trendansicht gut ist.
 */
const MESSDATEN_TREND = (() => {
  const zyklen = [tage(-1080), tage(-720), tage(-360), tage(-42)]
  const zeilen: Record<string, unknown>[] = []
  for (let strang = 1; strang <= 6; strang += 1) {
    zyklen.forEach((datum, i) => {
      const verfall = strang === 4 ? i * 340 : i * 60
      zeilen.push({
        string_nr: String(strang),
        anzahl_module: 20,
        pruef_datum: `${datum} 09:00:00`,
        riso: Math.round(2600 - verfall + strang * 35),
        uoc: Number((830 + strang * 1.4 - i * 0.8).toFixed(1)),
        isc: Number((13.6 + strang * 0.05 - i * 0.04).toFixed(2)),
        status: 'OK',
      })
    })
  }
  return zeilen
})()

/** Beantwortet eine Servermethode aus den Demodaten. `undefined` = nicht abgedeckt. */
export function demoAntwort(name: string, parameter: Record<string, unknown>): unknown {
  switch (name) {
    case 'oekovolt_baudoku.api.sync.bootstrap':
      return { ...BOOTSTRAP, server_zeit: new Date().toISOString() }

    case 'oekovolt_baudoku.api.sync.sync_status':
      return { letzter_sync: new Date().toISOString(), fehler_gesamt: 0, server_zeit: new Date().toISOString() }

    case 'oekovolt_baudoku.api.sync.push':
      return {
        ergebnisse: ((parameter.operationen as { lokale_id: string }[]) ?? []).map((op) => ({
          lokale_id: op.lokale_id,
          ergebnis: 'Erfolg',
          name: `DEMO-${op.lokale_id.slice(0, 8)}`,
          modified: new Date().toISOString(),
        })),
        server_zeit: new Date().toISOString(),
      }

    case 'oekovolt_baudoku.api.sync.foto_hochladen':
      return { file_url: '', name: 'demo', hash: 'demo', groesse: 0, dublette: false }

    case 'oekovolt_baudoku.api.protokoll.vorlage_komplett':
