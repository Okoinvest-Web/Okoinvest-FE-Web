/**
 * Demo-Modus für Entwicklung und Abnahmetests ohne laufende Frappe-Bench.
 *
 * Aktivierung:
 *   - `VITE_DEMO=1 npm run dev`, oder
 *   - `?demo=1` an die URL hängen (wird in localStorage gemerkt), oder
 *   - `localStorage.setItem('baudoku-demo', '1')`
 *
 * Im Demo-Modus beantwortet dieses Modul alle Servermethoden aus dem Speicher.
 * Schreibende Aufrufe werden angenommen und quittiert; persistiert wird nur
 * lokal in IndexedDB, genau wie im Offlinebetrieb.
 */

import type { Bootstrap, Vorlage } from './typen'

/**
 * Einmalig beim Laden ausgewertet: `demoAktiv()` läuft bei jedem API-Aufruf und
 * darf weder die URL neu parsen noch localStorage anfassen.
 */
const AKTIV = (() => {
  if (import.meta.env.VITE_DEMO === '1') return true
  if (typeof window === 'undefined') return false

  const parameter = new URLSearchParams(window.location.search)
  if (parameter.get('demo') === '1') {
    localStorage.setItem('baudoku-demo', '1')
    return true
  }
  if (parameter.get('demo') === '0') {
    localStorage.removeItem('baudoku-demo')
    return false
  }
  return localStorage.getItem('baudoku-demo') === '1'
})()

export const demoAktiv = (): boolean => AKTIV

