      const lang = i === 2 && person.name === 'SUM-0002'
      const kurzePause = i === 3 && person.name === 'SUM-0001'
      liste.push({
        name: `ATG-${person.name}-${i}`,
        mitarbeiter: person.vollname,
        supplier: SUPPLIER,
        datum: t,
        anlage: 'ANL-2026-00002',
        beginn: `${t} 07:00:00`,
        ende: lang ? `${t} 18:30:00` : `${t} 16:30:00`,
        arbeitszeit_stunden: lang ? 11 : 9,
        pause_minuten: kurzePause ? 15 : 30,
        pause_ausreichend: kurzePause ? 0 : 1,
        ueber_tagesgrenze: lang ? 1 : 0,
        ueber_wochengrenze: 0,
        status: i <= 2 ? 'Vollstaendig' : 'Freigegeben',
        hinweise: lang
          ? 'Arbeitszeit 11.00 h ueber der Tagesgrenze von 10.0 h.'
          : kurzePause
            ? 'Ruhepause 15 min, erforderlich 30 min.'
            : '',
      })
    }
  }
  return liste
})()

