          maengel: MAENGEL.filter((m) => m.anlage === parameter.dn),
          tagesberichte: BERICHTE.filter((b) => b.anlage === parameter.dn),
        }
      }

      const args = JSON.parse(String(parameter.args ?? '{}')) as Record<string, unknown>

      // Statuswechsel am Subunternehmerauftrag, damit sich das Portal
      // durchspielen laesst.
      if (parameter.dt === 'Subunternehmerauftrag') {
        const auftrag = PORTAL_AUFTRAEGE.find((a) => a.name === parameter.dn)
        if (auftrag && parameter.method === 'annehmen') auftrag.status = 'Angenommen'
        if (auftrag && parameter.method === 'fertigmelden') {
          auftrag.status = 'Fertiggemeldet'
          auftrag.fortschritt_prozent = 100
          auftrag.fertigmeldung_bemerkung = String(args.bemerkung ?? '')
        }
        return {}
      }

      if (parameter.dt === 'Arbeitstag' && parameter.method === 'beanstanden') {
        const tag = ARBEITSTAGE.find((t) => t.name === parameter.dn)
        if (tag) {
          tag.status = 'Beanstandet'
          tag.beanstandung = String(args.grund ?? '')
        }
        return {}
      }

      return {}
    }

    default:
      return undefined
  }
}

/**
 * Schreibende Aufrufe im Demo-Modus.
 *
 * Es geht nichts an einen Server, aber das Ergebnis landet in den Demodaten —
 * damit sich Personalmeldung, Materialanforderung und Bauvertragsmeldung
 * vollstaendig durchspielen lassen.
 */
export function demoAnlegen(
  doctype: string,
  daten: Record<string, unknown>,
): Record<string, unknown> {
  const doc: Record<string, unknown> = {
    ...daten,
    name: daten.name ?? `${doctype.slice(0, 3).toUpperCase()}-DEMO-${Date.now()}`,
    modified: new Date().toISOString(),
  }

  if (doctype === 'Personalmeldung') {
    doc.gemeldet_am = new Date().toISOString()
    doc.alle_nachweise_gueltig = 1
    PERSONALMELDUNGEN.splice(0, PERSONALMELDUNGEN.length, doc)
  }
  if (doctype === 'Materialanforderung') {
    MATERIALANFORDERUNGEN.unshift(doc)
  }
  if (doctype === 'Bauvertragsmeldung') {
    doc.gemeldet_am = new Date().toISOString()
    doc.verzoegerung_stunden = 0
    BAUVERTRAGSMELDUNGEN.unshift(doc)
  }
  return doc
}

/** Ersatz für den Einzelabruf `/api/resource/<doctype>/<name>` im Demo-Modus. */
export function demoDokument(doctype: string, name: string): unknown | undefined {
  const treffer = demoListe(doctype).find(
    (eintrag) => (eintrag as { name?: string }).name === name,
  )
  if (!treffer) return undefined
  // Wie ein echter Server eine frische Fassung liefern. Gaebe der Demo-Modus
  // dasselbe Objekt zurueck, das er intern veraendert, bemerkte Vue die
  // Aenderung nicht — die Mutation ginge am Proxy vorbei.
  const kopie = JSON.parse(JSON.stringify(treffer)) as Record<string, unknown>
  return doctype === 'Mangel'
    ? { ...kopie, beschreibung: 'Demo-Mangel aus der Serverfassung.', fotos: [], erledigt_fotos: [] }
    : kopie
}

/** Ersatz für `/api/resource`-Listen im Demo-Modus. */
export function demoListe(doctype: string): unknown[] {
  switch (doctype) {
    case 'Mangel':
      return MAENGEL
    case 'Pruefprotokoll':
      return PROTOKOLLE
    case 'Tagesbericht':
      return BERICHTE
    case 'Subunternehmerauftrag':
      return PORTAL_AUFTRAEGE
    case 'Materialanforderung':
      return MATERIALANFORDERUNGEN
    case 'Bauvertragsmeldung':
      return BAUVERTRAGSMELDUNGEN
    case 'Personalmeldung':
      return PERSONALMELDUNGEN
    case 'Arbeitstag':
      return ARBEITSTAGE
    case 'PV Anlage':
      return BOOTSTRAP.anlagen
    case 'Checklistenvorlage':
      return BOOTSTRAP.vorlagen
    default:
      return []
  }
}
