<script setup lang="ts">
/** Mängelübersicht mit Filtern nach Status, Schweregrad, Anlage und Frist (FA-062). */
import { computed, onMounted, ref } from 'vue'
import { useRouter } from 'vue-router'

import AppIcon from '@/components/AppIcon.vue'
import LeereListe from '@/components/LeereListe.vue'
import StatusAbzeichen from '@/components/StatusAbzeichen.vue'
import BasisDialog from '@/components/BasisDialog.vue'
import { useDokumentenliste, type ListenZeile } from '@/composables/dokumentenliste'
import { useUrlFilter } from '@/composables/urlfilter'
import { baudoku } from '@/lib/api'
import { datum, isoDatum, tageBis } from '@/lib/format'
import type { Mangel } from '@/lib/typen'
import { useStammdaten } from '@/stores/stammdaten'
import { useUi } from '@/stores/ui'

type Mangelzeile = Partial<Mangel> &
  Pick<Mangel, 'titel' | 'anlage' | 'status' | 'schweregrad'>

type Zeile = Mangelzeile & ListenZeile

const router = useRouter()
const stammdaten = useStammdaten()
const ui = useUi()

const { zeilen, laedt, nurLokalerBestand, laden } = useDokumentenliste<Mangelzeile>({
  doctype: 'Mangel',
  felder: [
    'name', 'titel', 'anlage', 'kategorie', 'schweregrad', 'status',
    'faellig_am', 'ueberfaellig', 'zugewiesen_an', 'gemeldet_am',
  ],
  orderBy: 'faellig_am asc',
  limit: 200,
})

const suche = ref('')
const status = ref('offen')
const schweregrad = ref('')
const anlage = ref('')

useUrlFilter({ suche, status, schweregrad, anlage })

const gefiltert = computed(() =>
  zeilen.value
    .filter((z) => {
      if (status.value === 'offen' && !['Offen', 'In Bearbeitung'].includes(z.status)) return false
      if (status.value && status.value !== 'offen' && z.status !== status.value) return false
      if (schweregrad.value && z.schweregrad !== schweregrad.value) return false
      if (anlage.value && z.anlage !== anlage.value) return false
      const text = suche.value.trim().toLowerCase()
      if (!text) return true
      const anlagenName = stammdaten.anlage(z.anlage)?.anlage_name ?? z.anlage
      return `${z.titel} ${anlagenName} ${z.kategorie ?? ''}`.toLowerCase().includes(text)
    })
    .sort((a, b) => {
      const rang = (z: Zeile) => ({ A: 0, B: 1, C: 2 })[z.schweregrad as 'A' | 'B' | 'C'] ?? 3
      if (rang(a) !== rang(b)) return rang(a) - rang(b)
      return String(a.faellig_am ?? '9999').localeCompare(String(b.faellig_am ?? '9999'))
    }),
)

const statistik = computed(() => ({
  gesamt: gefiltert.value.length,
  ueberfaellig: gefiltert.value.filter((z) => (tageBis(z.faellig_am) ?? 99) < 0).length,
}))

// --- Sammelbearbeitung (Bauleiterwerkzeug) ---------------------------------

const auswahl = ref<Set<string>>(new Set())
const sammelDialogOffen = ref(false)
const sammelLaeuft = ref(false)
const zustaendige = ref<{ name: string; employee_name: string }[]>([])

const sammelWerte = ref({ zugewiesen_an: '', status: '', faellig_am: '', prioritaet: '' })

/** Nur synchronisierte Maengel: Die Sammelaktion laeuft auf dem Server. */
const auswaehlbar = computed(() => gefiltert.value.filter((z) => z.name))

const alleAusgewaehlt = computed(
  () => auswaehlbar.value.length > 0 && auswahl.value.size === auswaehlbar.value.length,
)

function umschalten(name: string) {
  const neu = new Set(auswahl.value)
  if (neu.has(name)) neu.delete(name)
  else neu.add(name)
  auswahl.value = neu
}

function alleUmschalten() {
  auswahl.value = alleAusgewaehlt.value
    ? new Set()
    : new Set(auswaehlbar.value.map((z) => z.name as string))
}

async function sammelDialogOeffnen() {
  sammelWerte.value = { zugewiesen_an: '', status: '', faellig_am: '', prioritaet: '' }
  sammelDialogOffen.value = true
  if (zustaendige.value.length) return
  try {
    zustaendige.value = (await baudoku.zustaendige()) as typeof zustaendige.value
  } catch {
    // Ohne Mitarbeiterliste bleiben die uebrigen Felder nutzbar.
  }
}

async function sammelSpeichern() {
  const felder = Object.fromEntries(
    Object.entries(sammelWerte.value).filter(([, wert]) => wert !== ''),
  )
  if (!Object.keys(felder).length) {
    ui.warnung('Bitte mindestens eine Änderung angeben.')
    return
  }

  sammelLaeuft.value = true
  try {
    const ergebnis = (await baudoku.mangelSammelaktion([...auswahl.value], felder)) as {
      erfolgreich: string[]
      fehlgeschlagen: { name: string; meldung: string }[]
    }
    if (ergebnis.fehlgeschlagen.length) {
      ui.warnung(
        `${ergebnis.erfolgreich.length} geändert, ${ergebnis.fehlgeschlagen.length} fehlgeschlagen: ` +
          ergebnis.fehlgeschlagen[0].meldung,
      )
    } else {
      ui.erfolg(`${ergebnis.erfolgreich.length} Mängel geändert.`)
    }
    sammelDialogOffen.value = false
    auswahl.value = new Set()
    await laden()
  } catch (fehler) {
    ui.fehler((fehler as Error).message)
  } finally {
    sammelLaeuft.value = false
  }
}

/** Frist um eine Woche verlängern — der haeufigste Sammelfall nach einer Begehung. */
function fristVorschlag(tage: number) {
  sammelWerte.value.faellig_am = isoDatum(new Date(Date.now() + tage * 86_400_000))
}

function fristText(zeile: Zeile): { text: string; klasse: string } {
  const tage = tageBis(zeile.faellig_am)
  if (tage === null) return { text: 'ohne Frist', klasse: 'text-slate-400' }
  if (['Erledigt', 'Verifiziert', 'Verworfen'].includes(zeile.status)) {
    return { text: datum(zeile.faellig_am), klasse: 'text-slate-400' }
  }
  if (tage < 0) return { text: `${Math.abs(tage)} Tage überfällig`, klasse: 'text-fehler font-semibold' }
  if (tage === 0) return { text: 'heute fällig', klasse: 'text-warnung font-semibold' }
  if (tage <= 3) return { text: `in ${tage} Tagen`, klasse: 'text-warnung' }
  return { text: datum(zeile.faellig_am), klasse: 'text-slate-400' }
}

onMounted(laden)
</script>

<template>
  <div class="space-y-4">
    <div class="flex flex-wrap items-center gap-2">
      <div class="relative min-w-[180px] flex-1">
        <AppIcon name="suche" :groesse="20" class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" />
        <input v-model="suche" class="feld pl-10" type="search" placeholder="Titel, Anlage, Kategorie …" />
      </div>
      <select v-model="status" class="feld w-auto">
        <option value="offen">Offen und in Arbeit</option>
        <option value="">Alle Status</option>
        <option>Offen</option>
        <option>In Bearbeitung</option>
        <option>Erledigt</option>
        <option>Verifiziert</option>
      </select>
      <select v-model="schweregrad" class="feld w-auto">
        <option value="">Alle Grade</option>
        <option v-for="s in stammdaten.schweregrade" :key="s.code" :value="s.code">
          {{ s.code }} – {{ s.bezeichnung }}
        </option>
      </select>
      <select v-model="anlage" class="feld w-auto max-w-[200px]">
        <option value="">Alle Anlagen</option>
        <option v-for="a in stammdaten.anlagen" :key="a.name" :value="a.name">{{ a.anlage_name }}</option>
      </select>
      <button class="knopf-primaer px-4" @click="router.push({ name: 'mangel-neu' })">
        <AppIcon name="plus" :groesse="18" /> Neu
      </button>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <p class="flex-1 text-sm text-slate-500">
        {{ statistik.gesamt }} Mängel
        <span v-if="statistik.ueberfaellig" class="font-semibold text-fehler">
          · {{ statistik.ueberfaellig }} überfällig
        </span>
      </p>

      <label
        v-if="stammdaten.istBauleiter && auswaehlbar.length"
        class="flex items-center gap-2 text-sm text-slate-500"
      >
        <input type="checkbox" class="h-5 w-5" :checked="alleAusgewaehlt" @change="alleUmschalten" />
        alle auswählen
      </label>
    </div>

    <!-- Sammelaktion: nach einer Begehung zwanzig Mängel auf drei Techniker verteilen -->
    <div
      v-if="auswahl.size"
      class="sticky top-16 z-10 flex flex-wrap items-center gap-3 rounded-xl bg-marke-700 px-4 py-3
             text-sm text-white shadow-karte"
    >
      <span class="flex-1 font-semibold">{{ auswahl.size }} ausgewählt</span>
      <button class="rounded-lg px-3 py-1.5 text-xs font-semibold text-marke-100 hover:bg-marke-600"
              @click="auswahl = new Set()">
        Aufheben
      </button>
      <button class="rounded-lg bg-white px-3 py-1.5 text-xs font-semibold text-marke-700"
              @click="sammelDialogOeffnen">
        Bearbeiten
      </button>
    </div>

    <p
      v-if="nurLokalerBestand && !laedt"
      class="rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-900 dark:bg-amber-900/30 dark:text-amber-200"
    >
      Serverliste nicht erreichbar — angezeigt werden nur die Mängel auf diesem Gerät.
    </p>

    <p v-if="laedt" class="py-8 text-center text-sm text-slate-500">Mängel werden geladen …</p>

    <LeereListe
      v-else-if="!gefiltert.length"
      symbol="mangel"
      titel="Keine Mängel"
      text="Mit den gewählten Filtern ist nichts offen."
      aktion-text="Mangel erfassen"
      @aktion="router.push({ name: 'mangel-neu' })"
    />

    <ul v-else class="space-y-2">
      <li v-for="zeile in gefiltert" :key="zeile.schluessel" class="flex items-center gap-2">
        <input
          v-if="stammdaten.istBauleiter && zeile.name"
          type="checkbox"
          class="h-5 w-5 shrink-0"
          :checked="auswahl.has(zeile.name)"
          :aria-label="`${zeile.titel} auswählen`"
          @change="umschalten(zeile.name)"
        />
        <RouterLink
          :to="{ name: 'mangel-detail', params: { lokaleId: zeile.lokale_id ?? zeile.name } }"
          class="karte flex flex-1 items-center gap-3 p-3"
        >
          <StatusAbzeichen :wert="zeile.schweregrad" />
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2">
              <span class="truncate font-semibold">{{ zeile.titel }}</span>
              <span v-if="zeile.nurLokal" class="abzeichen bg-amber-100 text-amber-900">nur lokal</span>
            </div>
            <div class="truncate text-xs text-slate-500">
              {{ stammdaten.anlage(zeile.anlage)?.anlage_name ?? zeile.anlage }}
              <span v-if="zeile.kategorie"> · {{ zeile.kategorie }}</span>
            </div>
            <div class="text-xs" :class="fristText(zeile).klasse">{{ fristText(zeile).text }}</div>
          </div>
          <StatusAbzeichen :wert="zeile.status" klein />
        </RouterLink>
      </li>
    </ul>

    <BasisDialog
      :offen="sammelDialogOffen"
      :titel="`${auswahl.size} Mängel bearbeiten`"
      @schliessen="sammelDialogOffen = false"
    >
      <div class="space-y-3">
        <p class="text-sm text-slate-500">
          Leer gelassene Felder bleiben unverändert.
        </p>

        <label>
          <span class="beschriftung">Zuweisen an</span>
          <select v-model="sammelWerte.zugewiesen_an" class="feld">
            <option value="">unverändert</option>
            <option v-for="person in zustaendige" :key="person.name" :value="person.name">
              {{ person.employee_name }}
            </option>
          </select>
        </label>

        <label>
          <span class="beschriftung">Status</span>
          <select v-model="sammelWerte.status" class="feld">
            <option value="">unverändert</option>
            <option>Offen</option>
            <option>In Bearbeitung</option>
            <option>Verworfen</option>
          </select>
        </label>

        <label>
          <span class="beschriftung">Priorität</span>
          <select v-model="sammelWerte.prioritaet" class="feld">
            <option value="">unverändert</option>
            <option>Niedrig</option>
            <option>Mittel</option>
            <option>Hoch</option>
            <option>Kritisch</option>
          </select>
        </label>

        <div>
          <span class="beschriftung">Fällig am</span>
          <input v-model="sammelWerte.faellig_am" class="feld" type="date" />
          <div class="mt-2 flex gap-2">
            <button class="knopf-geist px-3 text-xs" @click="fristVorschlag(7)">+1 Woche</button>
            <button class="knopf-geist px-3 text-xs" @click="fristVorschlag(14)">+2 Wochen</button>
            <button class="knopf-geist px-3 text-xs" @click="fristVorschlag(30)">+1 Monat</button>
          </div>
        </div>

        <p class="rounded-lg bg-slate-50 px-3 py-2 text-xs text-slate-500 dark:bg-slate-800">
          Erledigung und Verifizierung sind hier nicht wählbar: Beide verlangen
          Maßnahme und Nachweisfoto je Einzelfall (FA-064).
        </p>

        <div class="flex gap-2 pt-1">
          <button class="knopf-sekundaer flex-1" @click="sammelDialogOffen = false">Abbrechen</button>
          <button class="knopf-primaer flex-[2]" :disabled="sammelLaeuft" @click="sammelSpeichern">
            {{ sammelLaeuft ? 'Wird gespeichert …' : 'Übernehmen' }}
          </button>
        </div>
      </div>
    </BasisDialog>
  </div>
</template>
