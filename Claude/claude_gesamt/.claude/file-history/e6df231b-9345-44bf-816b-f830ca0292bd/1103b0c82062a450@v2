        (
            """/** Lokale Tabelle zu einem synchronisierbaren Dokumenttyp. */""",
            """/**
 * Löst Vue-Reaktivität auf, bevor Daten nach IndexedDB gehen.
 *
 * Der Strukturierte-Klon-Algorithmus lehnt Proxy-Objekte ab
 * (`DataCloneError: … could not be cloned`). Ein aus einem Formular oder Store
 * stammendes Dokument ist aber genau das — auch dann noch, wenn die oberste
 * Ebene per Spread kopiert wurde: Verschachtelte Arrays wie `fotos` oder
 * `messdaten` bleiben reaktiv.
 *
 * Der Umweg über JSON ist hier zulässig, weil diese Dokumente reine Daten sind
 * (Zeichenketten, Zahlen, Listen). Binärdaten liegen in der Tabelle `fotos` und
 * werden nie durch diese Funktion geschickt.
 */
export function entkoppeln<T>(wert: T): T {
  return JSON.parse(JSON.stringify(wert)) as T
}

/** Lokale Tabelle zu einem synchronisierbaren Dokumenttyp. */""",
        ),
        (
            """export async function einreihen(
  doctype: Dokumenttyp,
  lokale_id: string,
  daten: Record<string, unknown>,
  aktion: 'create' | 'update' = 'update',
  basis_modified?: string,
): Promise<void> {
  const vorhanden = await db.warteschlange.where('lokale_id').equals(lokale_id).first()""",
            """export async function einreihen(
  doctype: Dokumenttyp,
  lokale_id: string,
  rohdaten: Record<string, unknown>,
  aktion: 'create' | 'update' = 'update',
  basis_modified?: string,
): Promise<void> {
  const daten = entkoppeln(rohdaten)
  const vorhanden = await db.warteschlange.where('lokale_id').equals(lokale_id).first()""",
        ),
    ],
)

