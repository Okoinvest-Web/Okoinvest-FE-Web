FE = ROOT / "frontend"


def patch(pfad, paare, basis=FE):
    p = basis / pfad
    s = p.read_text(encoding="utf-8")
    for alt, neu in paare:
        if alt not in s:
            raise SystemExit("NICHT GEFUNDEN in %s:\n---\n%s\n---" % (pfad, alt[:300]))
        s = s.replace(alt, neu, 1)
    p.write_text(s, encoding="utf-8")
    print("ok", pfad)


