import pathlib

FE = pathlib.Path(r"C:\Users\SALEADMIN\Documents\Servicetechniker APP\frontend")

p = FE / "vite.config.ts"
s = p.read_text(encoding="utf-8")

ALT_IMPORT = "import { copyFileSync, existsSync, mkdirSync } from 'node:fs'"
NEU_IMPORT = "import { copyFileSync, existsSync, mkdirSync, readdirSync } from 'node:fs'"
assert ALT_IMPORT in s, "Import nicht gefunden"
s = s.replace(ALT_IMPORT, NEU_IMPORT, 1)

ANFANG = "/** Kopiert das Build-Ergebnis als Frappe-Website-Page nach `www/baudoku.html`. */"
ENDE = "export default defineConfig("
start = s.index(ANFANG)
stop = s.index(ENDE)

NEU_BLOCK = '''/**
 * Verteilt das Build-Ergebnis an die Stellen, an denen Frappe es erwartet:
 *
 * - `www/baudoku.html` — die Einstiegsseite der SPA
 * - `www/sw.js` und die Workbox-Laufzeit — der Service Worker **muss** im
 *   Wurzelpfad liegen. Er kontrolliert nur Seiten unterhalb seines eigenen
 *   Verzeichnisses; aus `/assets/oekovolt_baudoku/frontend/` heraus registriert
 *   erreichte er die App unter `/baudoku` nie, und die Offline-Fähigkeit wäre
 *   wirkungslos (NFA-010).
 */
function frappeWebsitePage(): Plugin {
  return {
    name: 'frappe-website-page',
    apply: 'build',
    closeBundle() {
      const bundle = resolve(APP_DIR, 'public/frontend')
      const www = resolve(APP_DIR, 'www')
      if (!existsSync(resolve(bundle, 'index.html'))) return

      mkdirSync(www, { recursive: true })
      copyFileSync(resolve(bundle, 'index.html'), resolve(www, 'baudoku.html'))

      // sw.js und die per importScripts geladene Workbox-Datei; deren Name
      // enthält einen Hash, deshalb aus dem Verzeichnis lesen.
      const wurzeldateien = readdirSync(bundle).filter(
        (datei) => datei === 'sw.js' || /^workbox-[\\w-]+\\.js$/.test(datei),
      )
      for (const datei of wurzeldateien) {
        copyFileSync(resolve(bundle, datei), resolve(www, datei))
      }

      // eslint-disable-next-line no-console
      console.log(
        `\\n  Nach www kopiert: baudoku.html, ${wurzeldateien.join(', ') || '(kein Service Worker)'}\\n`,
      )
    },
  }
}

'''

s = s[:start] + NEU_BLOCK + s[stop:]
p.write_text(s, encoding="utf-8")
print("vite.config.ts angepasst")
