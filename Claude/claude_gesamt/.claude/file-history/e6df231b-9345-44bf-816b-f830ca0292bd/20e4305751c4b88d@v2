/** Typ und Einbauort bleiben zwischen den Scans stehen — beim Abgehen einer
 *  Modulreihe ändert sich nur die Nummer. */
const erfassungsTyp = ref('Modul')
const erfassungsOrt = ref('')
const erfasst = ref<{ komponententyp: string; seriennummer: string; position: string }[]>([])

function seriennummerErkannt(code: string) {
  const nummer = code.trim()
  if (!nummer) return
  if (erfasst.value.some((e) => e.seriennummer === nummer)) {
    ui.warnung(`${nummer} ist in dieser Sitzung bereits erfasst.`)
    return
  }
  if (komponenten.value.some((k) => k.seriennummer === nummer)) {
    ui.warnung(`${nummer} ist an dieser Anlage bereits hinterlegt.`)
    return
  }
  erfasst.value = [
    ...erfasst.value,
    { komponententyp: erfassungsTyp.value, seriennummer: nummer, position: erfassungsOrt.value },
  ]
}

async function erfassungSpeichern() {
  if (!erfasst.value.length) return
  erfassungLaeuft.value = true
  try {
    const ergebnis = (await baudoku.komponentenErfassen(props.name, erfasst.value)) as {
      hinzugefuegt: string[]
      bereits_vorhanden: string[]
    }
    ui.erfolg(
      `${ergebnis.hinzugefuegt.length} Komponente(n) erfasst` +
        (ergebnis.bereits_vorhanden.length
          ? `, ${ergebnis.bereits_vorhanden.length} waren schon vorhanden.`
          : '.'),
    )
    erfasst.value = []
    erfassungOffen.value = false
    scannerAktiv.value = false
    await komponentenLaden()
  } catch (fehler) {
    ui.fehler((fehler as Error).message)
  } finally {
    erfassungLaeuft.value = false
  }
}

async function komponenteEntfernen(seriennummer: string) {
  if (!window.confirm(`Seriennummer ${seriennummer} von dieser Anlage entfernen?`)) return
  try {
    await baudoku.komponenteEntfernen(props.name, seriennummer)
    await komponentenLaden()
  } catch (fehler) {
    ui.fehler((fehler as Error).message)
  }
}

async function komponentenLaden() {
  try {
    komponenten.value = (await baudoku.komponentenListe(props.name)) as Komponente[]
  } catch {
    // Offline: Komponenten liegen nur auf dem Server.
  }
}

/** Garantiewarnung: In den letzten 90 Tagen lohnt die Reklamation noch. */
function garantieHinweis(komponente: Komponente): { text: string; klasse: string } | null {
  const tage = tageBis(komponente.garantie_bis)
  if (tage === null) return null
  if (tage < 0) return { text: 'Garantie abgelaufen', klasse: 'text-slate-400' }
  if (tage <= 90) return { text: `Garantie endet in ${tage} Tagen`, klasse: 'text-warnung font-medium' }
  return { text: `Garantie bis ${datum(komponente.garantie_bis)}`, klasse: 'text-slate-400' }
}"""

