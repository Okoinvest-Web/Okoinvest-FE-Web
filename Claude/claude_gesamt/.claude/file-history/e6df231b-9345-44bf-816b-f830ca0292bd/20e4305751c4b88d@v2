  scannerOffen.value = false
  const name = anlagenNameAusCode(code)

  if (name && stammdaten.anlage(name)) {
    void router.push({ name: 'anlage-detail', params: { name } })
    return
  }

  try {
    const treffer = (await baudoku.seriennummerSuchen(code)) as {
      anlage: { name: string; anlage_name: string }
      komponente: { komponententyp: string }
    } | null

    if (treffer?.anlage) {
      ui.erfolg(
        `${treffer.komponente.komponententyp} ${code} gehört zu ${treffer.anlage.anlage_name}.`,
