SYNC_HAUPT_NEU = """const LEER: SyncErgebnis = {
  uebertragen: 0,
  fehler: 0,
  konflikte: 0,
  fotos: 0,
  empfangen: 0,
  meldung: '',
}

/**
 * Ein vollständiger Synchronisationslauf: Fotos, dann Dokumente hinaus,
 * danach Serveränderungen herein. Mehrfachaufrufe laufen nicht parallel.
 */
export async function synchronisieren(): Promise<SyncErgebnis> {
  if (laeuft) return { ...LEER, meldung: 'Sync läuft bereits.' }

  if (!(await istOnline(true))) {
    melden('offline')
    return { ...LEER, meldung: 'Offline – wird später übertragen.' }
  }

  laeuft = true
  melden('syncing')
  let fotos = 0
  let uebertragen = 0
  let konflikte = 0
  let fehler = 0
  let empfangen = 0

  try {
    fotos = await fotosHochladen()

    const batchGroesse = 25
    let rest = await db.warteschlange.filter((e) => e.versuche < MAX_VERSUCHE).toArray()
    while (rest.length) {
      const batch = rest.slice(0, batchGroesse)
      const ergebnis = await batchSenden(batch)
      uebertragen += ergebnis.erfolge
      konflikte += ergebnis.konflikte
      fehler += ergebnis.fehler
      rest = rest.slice(batchGroesse)
    }

    // Erst senden, dann empfangen: So sind die eigenen Änderungen bereits
    // eingearbeitet und kommen nicht als vermeintlich fremde zurück.
    try {
      const pull = await herunterladen()
      empfangen = pull.empfangen
      anlagenEmpfaenger?.(pull.anlagen)
    } catch (pullFehler) {
      // Ein gescheiterter Pull darf den erfolgreichen Push nicht entwerten.
      console.warn('Serveränderungen konnten nicht geholt werden:', pullFehler)
    }

    const ergebnis: SyncErgebnis = {
      uebertragen,
      fehler,
      konflikte,
      fotos,
      empfangen,
      meldung: zusammenfassung(uebertragen, fotos, konflikte, fehler, empfangen),
    }
    melden(fehler || konflikte ? 'fehler' : 'online', ergebnis)
    return ergebnis
  } catch (ausnahme) {
    const netz = ausnahme instanceof ApiFehler && ausnahme.istNetzfehler
    const ergebnis: SyncErgebnis = {
      uebertragen,
      fehler: fehler + 1,
      konflikte,
      fotos,
      empfangen,
      meldung: netz ? 'Verbindung abgebrochen – Sync wird fortgesetzt.' : String((ausnahme as Error).message),
    }
    melden(netz ? 'offline' : 'fehler', ergebnis)
    return ergebnis
  } finally {
    laeuft = false
  }
}

/**
 * Empfänger für aktualisierte Anlagenstammdaten.
 *
 * Der Sync-Motor kennt den Pinia-Store bewusst nicht — sonst hinge die
