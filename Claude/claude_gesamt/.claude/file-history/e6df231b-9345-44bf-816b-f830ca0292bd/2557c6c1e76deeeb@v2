# ========================================== Stammdaten: Anlagen zusammenführen
patch(
    "src/stores/stammdaten.ts",
    [
        (
            """  function anlage(name: string): Anlage | undefined {""",
            """  /**
   * Anlagen aus einem Sync-Lauf einarbeiten.
   *
   * Der Mängelzähler und der Wartungstermin ändern sich im Betrieb ständig;
   * ohne diesen Weg stünde auf dem Gerät bis zum nächsten App-Start der Stand
   * vom Morgen.
   */
  async function anlagenAktualisieren(neue: Anlage[]): Promise<void> {
    if (!neue.length) return

    const index = new Map(anlagen.value.map((a) => [a.name, a]))
    for (const eintrag of neue) index.set(eintrag.name, { ...index.get(eintrag.name), ...eintrag })
    anlagen.value = [...index.values()].sort((a, b) => a.anlage_name.localeCompare(b.anlage_name))

    const cache = await stammdatenLesen<Bootstrap>('bootstrap')
    if (cache) await stammdatenSchreiben('bootstrap', { ...cache, anlagen: anlagen.value })
  }

  function anlage(name: string): Anlage | undefined {""",
        ),
        (
            """    laden,
    anlage,""",
            """    laden,
    anlagenAktualisieren,
    anlage,""",
        ),
    ],
)

