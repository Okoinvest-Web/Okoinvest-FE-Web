PULL_FUNKTION = '''
// ---------------------------------------------------------------------------
// Pull — die Gegenrichtung
// ---------------------------------------------------------------------------

const LETZTER_PULL = 'letzter_pull'

interface PullAntwort {
  daten: Record<string, Record<string, unknown>[]>
  anlagen: Record<string, unknown>[]
  server_zeit: string
}

/**
 * Holt Serveränderungen und übernimmt sie in den lokalen Bestand.
 *
 * Ohne diesen Weg erfährt das Gerät nie, dass ein Bauleiter einen Mangel
 * zugewiesen oder ein Protokoll verifiziert hat.
 *
 * Vorrangregel: Steht für ein Dokument noch eine Änderung in der
 * Warteschlange, wird die Serverfassung **nicht** übernommen — sie würde die
 * ungesendete Arbeit des Technikers überschreiben. Das Dokument geht im selben
 * Lauf ohnehin hinaus; ist der Serverstand dann neuer, greift die reguläre
 * Konflikterkennung und der Server gewinnt.
 */
export async function herunterladen(): Promise<{ empfangen: number; anlagen: Record<string, unknown>[] }> {
  const seit = await stammdatenLesen<string>(LETZTER_PULL)
  const antwort = (await baudoku.pull(seit)) as PullAntwort

  const ausstehend = new Set((await db.warteschlange.toArray()).map((e) => e.lokale_id))
  let empfangen = 0

  for (const [doctype, dokumente] of Object.entries(antwort.daten ?? {})) {
    if (!['Pruefprotokoll', 'Mangel', 'Tagesbericht'].includes(doctype)) continue
    const tabelle = tabelleFuer(doctype as Dokumenttyp)

    for (const dokument of dokumente) {
      const serverId = dokument.lokale_id as string | undefined
      const vorhanden = serverId
        ? await tabelle.get(serverId)
        : await tabelle.where('name').equals(dokument.name as string).first()

      const lokale_id = serverId || vorhanden?.lokale_id || neueId()
      if (ausstehend.has(lokale_id)) continue

      await tabelle.put({ ...dokument, lokale_id } as never)
      empfangen += 1
    }
  }

  await stammdatenSchreiben(LETZTER_PULL, antwort.server_zeit)
  if (empfangen) window.dispatchEvent(new CustomEvent(PULL_EREIGNIS))

  return { empfangen, anlagen: antwort.anlagen ?? [] }
}

'''

