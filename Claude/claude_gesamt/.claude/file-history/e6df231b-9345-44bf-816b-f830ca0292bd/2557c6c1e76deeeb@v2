 */
type AnlagenEmpfaenger = (anlagen: Record<string, unknown>[]) => void
let anlagenEmpfaenger: AnlagenEmpfaenger | null = null

export function anlagenEmpfaengerSetzen(empfaenger: AnlagenEmpfaenger): void {
