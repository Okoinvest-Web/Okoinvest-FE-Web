KOPF_NEU = """import AnlagenKarte from '@/components/AnlagenKarte.vue'
import AppIcon from '@/components/AppIcon.vue'
import BasisDialog from '@/components/BasisDialog.vue'
import CodeScanner from '@/components/CodeScanner.vue'
import LeereListe from '@/components/LeereListe.vue'
import StatusAbzeichen from '@/components/StatusAbzeichen.vue'
import { anlagenNameAusCode } from '@/lib/code'
import { datum, zahl } from '@/lib/format'
import { entfernung, positionEinmalig, type Position } from '@/lib/geo'
import type { Anlage } from '@/lib/typen'
import { useStammdaten } from '@/stores/stammdaten'
import { useUi } from '@/stores/ui'

const router = useRouter()
const stammdaten = useStammdaten()
const ui = useUi()

const suche = ref('')
const typ = ref('')
const status = ref('')
const ansicht = ref<'liste' | 'karte'>('liste')
const scannerOffen = ref(false)

const standort = ref<Position | null>(null)
const standortLaedt = ref(false)

const gefiltert = computed(() => {
  const treffer = stammdaten.anlagenSuche(suche.value, {
    typ: typ.value || undefined,
    status: status.value || undefined,
  })
  if (!standort.value) return treffer

  // Nach Entfernung sortieren; Anlagen ohne Koordinaten ans Ende.
  return [...treffer].sort((a, b) => (abstand(a) ?? Infinity) - (abstand(b) ?? Infinity))
})

/** Luftlinie zum aktuellen Standort in Metern. */
function abstand(anlage: Anlage): number | null {
  if (!standort.value || !anlage.gps_lat || !anlage.gps_lng) return null
  return entfernung(standort.value, { lat: anlage.gps_lat, lng: anlage.gps_lng })
}

function abstandText(anlage: Anlage): string {
  const meter = abstand(anlage)
  if (meter === null) return ''
  return meter < 1000 ? `${meter} m entfernt` : `${(meter / 1000).toFixed(1)} km entfernt`
}

/** Die Tagestour beginnt mit der naechstgelegenen Baustelle. */
async function standortBestimmen() {
  if (standort.value) {
    standort.value = null
    return
  }
  standortLaedt.value = true
  try {
    standort.value = await positionEinmalig()
  } catch (fehler) {
    ui.warnung((fehler as Error).message)
  } finally {
    standortLaedt.value = false
  }
}

function codeErkannt(code: string) {
  scannerOffen.value = false
  const name = anlagenNameAusCode(code)
  if (name && stammdaten.anlage(name)) {
    void router.push({ name: 'anlage-detail', params: { name } })
    return
  }
  ui.warnung(
    name
      ? `Zu \u201e${name}\u201c ist lokal keine Anlage vorhanden. Bitte synchronisieren.`
      : 'Der Code gehoert zu keiner Anlage.',
  )
}

function oeffnen(anlage: Anlage) {
  void router.push({ name: 'anlage-detail', params: { name: anlage.name } })
}"""

