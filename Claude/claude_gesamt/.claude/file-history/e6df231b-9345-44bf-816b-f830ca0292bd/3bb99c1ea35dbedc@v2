ROOT = pathlib.Path(r"C:\Users\SALEADMIN\Documents\Servicetechniker APP")


def patch(pfad, paare):
    p = ROOT / pfad
    s = p.read_text(encoding="utf-8")
    for alt, neu in paare:
        if alt not in s:
            raise SystemExit(f"NICHT GEFUNDEN in {pfad}:\n---\n{alt[:200]}\n---")
        s = s.replace(alt, neu, 1)
    p.write_text(s, encoding="utf-8")
    print("ok", pfad)


