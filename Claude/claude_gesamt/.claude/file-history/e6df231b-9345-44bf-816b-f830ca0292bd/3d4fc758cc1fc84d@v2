import { createRouter, createWebHistory, type RouteRecordRaw } from 'vue-router'

/**
 * Die App läuft unter `/baudoku`. Alle Views sind lazy — der Startbildschirm
 * soll auch auf 4G unter drei Sekunden interaktiv sein (NFA-030).
 */
const routen: RouteRecordRaw[] = [
  {
    path: '/',
    name: 'dashboard',
    component: () => import('@/views/DashboardView.vue'),
    meta: { titel: 'Dashboard', navigation: true, symbol: 'haus' },
  },

  // --- Anlagen -------------------------------------------------------------
  {
    path: '/anlagen',
    name: 'anlagen',
    component: () => import('@/views/AnlagenView.vue'),
    meta: { titel: 'Anlagen', navigation: true, symbol: 'anlage' },
  },
  {
    path: '/anlagen/:name',
    name: 'anlage-detail',
    component: () => import('@/views/AnlageDetailView.vue'),
    props: true,
    meta: { titel: 'Anlage' },
  },
  {
    path: '/karte',
    name: 'karte',
    component: () => import('@/views/KarteView.vue'),
    meta: { titel: 'Karte', navigation: true, symbol: 'karte' },
  },

  // --- Prüfprotokolle ------------------------------------------------------
  {
    path: '/protokolle',
    name: 'protokolle',
    component: () => import('@/views/ProtokolleView.vue'),
    meta: { titel: 'Protokolle', navigation: true, symbol: 'protokoll' },
  },
  {
    path: '/protokolle/neu',
    name: 'protokoll-neu',
    component: () => import('@/views/ProtokollStartView.vue'),
    meta: { titel: 'Neues Protokoll', schlank: true },
  },
  {
    path: '/protokolle/:lokaleId/ausfuehren',
    name: 'protokoll-ausfuehren',
    component: () => import('@/views/ProtokollAusfuehrenView.vue'),
    props: true,
    // Vollbild: im Feld zählt jeder Pixel (Kapitel 6.2, Schritt 4)
    meta: { titel: 'Protokoll', vollbild: true },
  },
  {
    path: '/protokolle/:lokaleId',
    name: 'protokoll-detail',
    component: () => import('@/views/ProtokollDetailView.vue'),
    props: true,
    meta: { titel: 'Protokoll' },
  },

  // --- Mängel --------------------------------------------------------------
  {
    path: '/maengel',
    name: 'maengel',
    component: () => import('@/views/MaengelView.vue'),
    meta: { titel: 'Mängel', navigation: true, symbol: 'mangel' },
  },
  {
    path: '/maengel/neu',
    name: 'mangel-neu',
    component: () => import('@/views/MangelFormularView.vue'),
    meta: { titel: 'Neuer Mangel', schlank: true },
  },
  {
    path: '/maengel/:lokaleId',
    name: 'mangel-detail',
    component: () => import('@/views/MangelFormularView.vue'),
    props: true,
    meta: { titel: 'Mangel' },
  },

  // --- Tagesberichte -------------------------------------------------------
  {
    path: '/tagesberichte',
    name: 'tagesberichte',
    component: () => import('@/views/TagesberichteView.vue'),
    meta: { titel: 'Tagesberichte', navigation: true, symbol: 'bericht' },
  },
  {
    path: '/tagesberichte/neu',
    name: 'tagesbericht-neu',
    component: () => import('@/views/TagesberichtFormularView.vue'),
    meta: { titel: 'Neuer Tagesbericht', schlank: true },
  },
  {
    path: '/tagesberichte/:lokaleId',
    name: 'tagesbericht-detail',
    component: () => import('@/views/TagesberichtFormularView.vue'),
    props: true,
    meta: { titel: 'Tagesbericht' },
  },

  // --- Verwaltung ----------------------------------------------------------
  {
    path: '/vorlagen',
    name: 'vorlagen',
    component: () => import('@/views/VorlagenView.vue'),
    meta: { titel: 'Vorlagen', navigation: true, symbol: 'vorlage', rolle: 'projektleiter' },
  },
  {
    path: '/vorlagen/:name',
    name: 'vorlage-editor',
    component: () => import('@/views/VorlagenEditorView.vue'),
    props: true,
    meta: { titel: 'Vorlage bearbeiten', rolle: 'projektleiter' },
  },
  {
    path: '/analysen',
    name: 'analysen',
    component: () => import('@/views/AnalysenView.vue'),
    meta: { titel: 'Analysen', navigation: true, symbol: 'analyse', rolle: 'bauleiter' },
  },
  {
    path: '/einstellungen',
    name: 'einstellungen',
    component: () => import('@/views/EinstellungenView.vue'),
    meta: { titel: 'Einstellungen', navigation: true, symbol: 'zahnrad' },
  },

  { path: '/:pfad(.*)*', name: 'nicht-gefunden', component: () => import('@/views/NichtGefundenView.vue') },
]

export const router = createRouter({
  history: createWebHistory('/baudoku'),
  routes: routen,
  scrollBehavior(_zu, _von, gespeichert) {
    return gespeichert ?? { top: 0 }
  },
})

router.afterEach((zu) => {
  const titel = (zu.meta.titel as string) ?? 'Baudoku'
  document.title = `${titel} · ÖKOVOLT Baudoku`
})

export default router
