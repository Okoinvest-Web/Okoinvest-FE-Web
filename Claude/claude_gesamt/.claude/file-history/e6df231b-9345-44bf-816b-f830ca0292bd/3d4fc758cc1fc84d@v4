export const router = createRouter({
  history: createWebHistory('/baudoku'),
  routes: routen,
  scrollBehavior(_zu, _von, gespeichert) {
    return gespeichert ?? { top: 0 }
  },
})

router.afterEach((zu) => {
  const titel = (zu.meta.titel as string) ?? 'Baudoku'
  document.title = `${titel} · ÖKOVOLT Baudoku`
})

/**
 * Nach einem Deployment zeigt der alte Einstiegspunkt auf Chunks, die es nicht
 * mehr gibt. Einmalig neu laden holt die aktuelle Fassung; die Markierung
 * verhindert eine Schleife, falls das Laden aus einem anderen Grund scheitert.
 */
const NEULADEN_SCHLUESSEL = 'baudoku-chunk-neuladen'

router.onError((fehler, zu) => {
  const text = String((fehler as Error)?.message ?? '')
  const istChunkFehler =
    /Failed to fetch dynamically imported module|Importing a module script failed|error loading dynamically imported module/i.test(
      text,
    )
  if (!istChunkFehler) return

  if (sessionStorage.getItem(NEULADEN_SCHLUESSEL)) {
    sessionStorage.removeItem(NEULADEN_SCHLUESSEL)
    return
  }
  sessionStorage.setItem(NEULADEN_SCHLUESSEL, '1')
  window.location.assign(zu.fullPath)
})

router.afterEach(() => sessionStorage.removeItem(NEULADEN_SCHLUESSEL))

export default router
