/** Wird ausgelöst, sobald feststeht, dass die Frappe-Sitzung abgelaufen ist. */
export const SITZUNG_ABGELAUFEN = 'baudoku:sitzung-abgelaufen'

let sitzungspruefungLaeuft = false
let sitzungGemeldet = false

/**
 * Prüft nach einem 403, ob die Sitzung abgelaufen ist oder schlicht die Rechte
 * fehlen.
 *
 * Frappe beantwortet beides mit 403. Unterscheiden lässt es sich über
 * `get_logged_user`: Diese Methode steht jedem angemeldeten Benutzer offen —
 * scheitert sie ebenfalls, ist niemand mehr angemeldet. Ohne diese
 * Unterscheidung sähe der Techniker bei abgelaufener Sitzung nur eine Kette
 * unverständlicher Rechtefehler und würde weiter erfassen, ohne dass etwas
 * übertragen wird.
 */
async function sitzungPruefen(): Promise<void> {
  if (sitzungspruefungLaeuft || sitzungGemeldet) return
  sitzungspruefungLaeuft = true
  try {
    const antwort = await fetch('/api/method/frappe.auth.get_logged_user', {
      credentials: 'same-origin',
      headers: { Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
    })
    if (antwort.status === 401 || antwort.status === 403) {
      sitzungGemeldet = true
      window.dispatchEvent(new CustomEvent(SITZUNG_ABGELAUFEN))
    }
  } catch {
    // Kein Netz: Das ist kein Anmeldeproblem, sondern der Offlinefall.
  } finally {
    sitzungspruefungLaeuft = false
  }
}""",
        ),
        (
            """  if (!antwort.ok) {
    const exception = (daten as { exc_type?: string } | null)?.exc_type
    throw new ApiFehler(fehlertext(daten, rohtext, antwort.status), antwort.status, exception, rohtext)
  }""",
            """  if (!antwort.ok) {
    const exception = (daten as { exc_type?: string } | null)?.exc_type
    if (antwort.status === 401) {
      sitzungGemeldet = true
      window.dispatchEvent(new CustomEvent(SITZUNG_ABGELAUFEN))
    } else if (antwort.status === 403) {
      void sitzungPruefen()
    }
    throw new ApiFehler(fehlertext(daten, rohtext, antwort.status), antwort.status, exception, rohtext)
  }""",
        ),
    ],
)

