  }""",
            """    // `modified` mitschicken: Frappe lehnt das Speichern ab, wenn jemand anderes
    // die Vorlage zwischenzeitlich geändert hat. Ohne diesen Zeitstempel würden
    // sich zwei Projektleiter stillschweigend überschreiben.
    const gespeichert = (await resource.aktualisieren('Checklistenvorlage', props.name, {
      titel: vorlage.value.titel,
      vorlage_typ: vorlage.value.vorlage_typ,
      anlagen_typ: vorlage.value.anlagen_typ,
      beschreibung: vorlage.value.beschreibung,
      sektionen: vorlage.value.sektionen,
      modified: vorlage.value.modified,
    })) as { modified?: string }

    vorlage.value.modified = gespeichert?.modified ?? vorlage.value.modified
    ui.erfolg('Vorlage gespeichert.')
  } catch (fehler) {
    const text = (fehler as Error).message
    ui.fehler(
      /TimestampMismatch|modified/i.test(text)
        ? 'Die Vorlage wurde zwischenzeitlich von jemand anderem geändert. ' +
            'Bitte die Seite neu laden und die Änderung wiederholen.'
        : text,
    )
  } finally {
    speichert.value = false
  }""",
        )
    ],
)
