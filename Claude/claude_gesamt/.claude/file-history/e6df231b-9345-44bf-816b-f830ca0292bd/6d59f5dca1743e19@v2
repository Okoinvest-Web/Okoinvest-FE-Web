/** Wird geworfen, wenn der Offline-Puffer voll ist. */
export class PufferVollFehler extends Error {
  constructor(
    readonly belegtMb: number,
    readonly grenzeMb: number,
  ) {
    super(
      `Der Offline-Speicher ist mit ${belegtMb} von ${grenzeMb} MB belegt. ` +
        'Bitte synchronisieren, bevor weitere Fotos aufgenommen werden.',
    )
    this.name = 'PufferVollFehler'
  }
}""",
        ),
        (
            """export async function fotoErfassen(datei: Blob, optionen: AufnahmeOptionen = {}): Promise<FotoEintrag> {
  const komprimiert = await komprimieren(datei, optionen)""",
            """export async function fotoErfassen(datei: Blob, optionen: AufnahmeOptionen = {}): Promise<FotoEintrag> {
  // Vor der Aufnahme prüfen: Läuft IndexedDB voll, bricht der Browser hart ab
  // und nimmt im schlimmsten Fall bereits erfasste Fotos mit.
  const grenze = optionen.maxPufferMb ?? 100
  const belegt = await fotoPufferMb()
  if (belegt >= grenze) throw new PufferVollFehler(belegt, grenze)

  const komprimiert = await komprimieren(datei, optionen)""",
        ),
    ],
)

