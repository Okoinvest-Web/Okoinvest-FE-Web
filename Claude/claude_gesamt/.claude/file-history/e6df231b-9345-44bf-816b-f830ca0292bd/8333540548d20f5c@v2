def scrub(name: str) -> str:
    return name.lower().replace(" ", "_").replace("-", "_")


def write_all():
    for dt in DOCTYPES:
        folder = MODULE_DIR / scrub(dt["name"])
        folder.mkdir(parents=True, exist_ok=True)
        init = folder / "__init__.py"
        if not init.exists():
            init.write_text("", encoding="utf-8")
        target = folder / f"{scrub(dt['name'])}.json"
        target.write_text(json.dumps(dt, indent=1, ensure_ascii=False) + "\n", encoding="utf-8")
        print(f"  {target.relative_to(ROOT)}")


if __name__ == "__main__":
    print(f"Schreibe {len(DOCTYPES)} Doctypes nach {MODULE_DIR.relative_to(ROOT)}:")
    write_all()
    print("Fertig.")
