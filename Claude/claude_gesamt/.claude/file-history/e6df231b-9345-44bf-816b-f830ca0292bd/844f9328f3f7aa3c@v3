<script setup lang="ts">
/** Einstellungen, Sync-Diagnose, Konfliktliste und Offline-Vorbereitung. */
import { onMounted, ref } from 'vue'

import AppIcon from '@/components/AppIcon.vue'
import SyncIndikator from '@/components/SyncIndikator.vue'
import { aufraeumen, db, type KonfliktEintrag } from '@/lib/db'
import { datumZeit, relativ } from '@/lib/format'
import { CLIENT_VERSION } from '@/lib/sync'
import { useProtokoll } from '@/stores/protokoll'
import { useStammdaten } from '@/stores/stammdaten'
import { useSync } from '@/stores/sync'
import { useUi } from '@/stores/ui'

const stammdaten = useStammdaten()
const sync = useSync()
const ui = useUi()
const protokollStore = useProtokoll()

const konflikte = ref<KonfliktEintrag[]>([])
const vorlaedt = ref(false)
const speicher = ref<{ genutzt: number; gesamt: number } | null>(null)

async function konfliktErledigt(id: number) {
  await sync.konfliktQuittieren(id)
  await konflikteLaden()
}

async function konflikteLaden() {
  konflikte.value = await sync.konflikteLesen()
}

async function vorladen() {
  vorlaedt.value = true
  try {
    await stammdaten.laden()
    const anzahl = await protokollStore.vorlagenVorladen()
    ui.erfolg(`Stammdaten und ${anzahl} Vorlage(n) für den Offlinebetrieb geladen.`)
  } catch (fehler) {
    ui.fehler((fehler as Error).message)
  } finally {
    vorlaedt.value = false
  }
}

async function aufraeumenJetzt() {
  const ergebnis = await aufraeumen()
  await sync.zaehlerAktualisieren()
  ui.erfolg(`${ergebnis.fotos} Fotos und ${ergebnis.konflikte} Konflikte aufgeräumt.`)
}

/**
 * Abmelden und lokalen Bestand löschen.
 *
 * Auf einem Gemeinschaftstablet bleiben sonst Protokolle und Fotos des
 * Vorgängers in IndexedDB liegen. Ausstehende Übertragungen werden vorher
 * abgefragt — gelöscht würde sonst Arbeit, die noch nirgends angekommen ist.
 */
async function abmelden() {
  if (sync.ausstehend > 0) {
    const weiter = window.confirm(
      `${sync.ausstehend} Dokument(e) sind noch nicht übertragen und gehen beim Abmelden ` +
        'verloren. Trotzdem abmelden?',
    )
    if (!weiter) return
  }

  try {
    await Promise.all([
      db.protokolle.clear(),
      db.maengel.clear(),
      db.berichte.clear(),
      db.fotos.clear(),
      db.warteschlange.clear(),
      db.konflikte.clear(),
      db.stammdaten.clear(),
    ])
    localStorage.removeItem('baudoku-zuletzt-anlagen')
  } catch (fehler) {
    ui.fehler(`Lokale Daten konnten nicht gelöscht werden: ${(fehler as Error).message}`)
    return
  }

  window.location.assign('/api/method/logout')
}

async function speicherAbfragen() {
  if (!navigator.storage?.estimate) return
  const schaetzung = await navigator.storage.estimate()
  speicher.value = {
    genutzt: Math.round(((schaetzung.usage ?? 0) / 1024 / 1024) * 10) / 10,
    gesamt: Math.round(((schaetzung.quota ?? 0) / 1024 / 1024) * 10) / 10,
  }
}

onMounted(() => {
  void konflikteLaden()
  void speicherAbfragen()
})
</script>

<template>
  <div class="mx-auto max-w-feld space-y-5">
    <!-- Benutzer -->
    <section class="karte p-4">
      <h2 class="mb-3 flex items-center gap-2 font-bold">
        <AppIcon name="person" :groesse="20" class="text-slate-400" /> Benutzer
      </h2>
      <dl class="space-y-1 text-sm">
        <div class="flex justify-between">
          <dt class="text-slate-500">Name</dt>
          <dd class="font-medium">{{ stammdaten.benutzer?.vollname ?? '–' }}</dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-slate-500">Konto</dt>
          <dd class="font-medium">{{ stammdaten.benutzer?.user ?? '–' }}</dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-slate-500">Mitarbeiter</dt>
          <dd class="font-medium">{{ stammdaten.benutzer?.mitarbeiter?.employee_name ?? 'nicht verknüpft' }}</dd>
        </div>
      </dl>
      <div class="mt-2 flex flex-wrap gap-1">
        <span v-for="rolle in stammdaten.rollen.filter((r) => r.startsWith('Baudoku'))" :key="rolle"
              class="abzeichen bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300">
          {{ rolle.replace('Baudoku ', '') }}
        </span>
      </div>
      <div class="mt-3 flex gap-2">
        <a href="/app" class="knopf-sekundaer flex-1 text-sm">ERPNext-Desk öffnen</a>
        <button class="knopf-sekundaer text-sm text-fehler" @click="abmelden">
          <AppIcon name="person" :groesse="16" /> Abmelden
        </button>
      </div>
      <p class="mt-2 text-xs text-slate-400">
        Beim Abmelden werden alle lokal gespeicherten Protokolle, Mängel und Fotos
        von diesem Gerät entfernt.
      </p>
    </section>

    <!-- Darstellung -->
    <section class="karte p-4">
      <h2 class="mb-3 font-bold">Darstellung</h2>
      <label class="flex items-center gap-3">
        <input v-model="ui.dunkel" type="checkbox" class="h-6 w-11" />
        <span class="flex-1 text-sm">
          Dunkles Design
          <span class="block text-xs text-slate-500">
            Weniger Blendung bei Dacharbeiten in praller Sonne.
          </span>
        </span>
      </label>
    </section>

    <!-- Synchronisation -->
    <section class="karte p-4">
      <h2 class="mb-3 flex items-center gap-2 font-bold">
        <AppIcon name="sync" :groesse="20" class="text-slate-400" /> Synchronisation
      </h2>
      <SyncIndikator ausfuehrlich />

      <dl class="mt-3 space-y-1 text-sm">
        <div class="flex justify-between">
          <dt class="text-slate-500">Client-Version</dt>
          <dd class="font-medium tabular-nums">{{ CLIENT_VERSION }}</dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-slate-500">Stammdaten</dt>
          <dd class="font-medium">{{ stammdaten.ausCache ? 'aus dem Cache' : 'vom Server' }}</dd>
        </div>
        <div v-if="speicher" class="flex justify-between">
          <dt class="text-slate-500">Gerätespeicher</dt>
          <dd class="font-medium tabular-nums">{{ speicher.genutzt }} von {{ speicher.gesamt }} MB</dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-slate-500">Letzte Meldung</dt>
          <dd class="max-w-[60%] text-right font-medium">{{ sync.letzteMeldung || '–' }}</dd>
        </div>
      </dl>

      <div class="mt-3 flex flex-wrap gap-2">
        <button class="knopf-sekundaer flex-1 px-3 text-sm" :disabled="vorlaedt" @click="vorladen">
          <AppIcon name="pfeilUnten" :groesse="18" />
          {{ vorlaedt ? 'Lädt …' : 'Für Offline vorladen' }}
        </button>
        <button class="knopf-geist px-3 text-sm" @click="aufraeumenJetzt">Aufräumen</button>
      </div>
      <p class="mt-2 text-xs text-slate-400">
        Vor Fahrtantritt vorladen: Anlagen, Vorlagen und Stammdaten stehen dann auch ohne Netz bereit.
      </p>
    </section>

    <!-- Konflikte -->
    <section v-if="konflikte.length" class="karte p-4">
      <h2 class="mb-1 flex items-center gap-2 font-bold text-fehler">
        <AppIcon name="warnung" :groesse="20" /> Sync-Konflikte
      </h2>
      <p class="mb-3 text-sm text-slate-600 dark:text-slate-300">
        Diese Dokumente wurden zwischenzeitlich auf dem Server geändert. Die Serverfassung gilt;
        die lokale Fassung ist hier zur Ansicht gesichert.
      </p>
      <ul class="space-y-2">
        <li v-for="konflikt in konflikte" :key="konflikt.id"
            class="rounded-xl border border-slate-200 p-3 text-sm dark:border-slate-800">
          <div class="flex items-center gap-2">
            <span class="font-semibold">{{ konflikt.doctype }}</span>
            <span class="text-xs text-slate-400">{{ datumZeit(konflikt.erkannt_am) }}</span>
            <button
              class="ml-auto text-xs font-semibold text-marke-600 hover:underline"
              @click="konfliktErledigt(konflikt.id!)"
            >
              erledigt
            </button>
          </div>
          <details class="mt-2">
            <summary class="cursor-pointer text-xs text-slate-500">lokale Fassung ansehen</summary>
            <pre class="mt-2 max-h-48 overflow-auto rounded bg-slate-50 p-2 text-[10px] dark:bg-slate-800">{{
              JSON.stringify(konflikt.lokale_fassung, null, 2)
            }}</pre>
          </details>
        </li>
      </ul>
    </section>

    <!-- Grenzwerte -->
    <section class="karte p-4">
      <h2 class="mb-1 font-bold">Plausibilitätsgrenzen</h2>
      <p class="mb-3 text-xs text-slate-500">
        Zentral in ERPNext unter „Baudoku Settings“ gepflegt — hier zur Kontrolle.
      </p>
      <dl class="space-y-1 text-sm">
        <div class="flex justify-between">
          <dt class="text-slate-500">Riso je Modul</dt>
          <dd class="font-medium tabular-nums">{{ stammdaten.einstellungen.riso_pro_modul_kohm }} kΩ</dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-slate-500">Riso-Absolutminimum</dt>
          <dd class="font-medium tabular-nums">{{ stammdaten.einstellungen.riso_minimum_kohm }} kΩ</dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-slate-500">Uoc-Toleranz</dt>
          <dd class="font-medium tabular-nums">± {{ stammdaten.einstellungen.uoc_toleranz_prozent }} %</dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-slate-500">Isc-Toleranz</dt>
          <dd class="font-medium tabular-nums">± {{ stammdaten.einstellungen.isc_toleranz_prozent }} %</dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-slate-500">Max. Fotogröße</dt>
          <dd class="font-medium tabular-nums">{{ stammdaten.einstellungen.max_foto_mb }} MB</dd>
        </div>
      </dl>
    </section>

    <p class="pb-6 text-center text-xs text-slate-400">
      ÖKOVOLT Baudoku {{ CLIENT_VERSION }} · letzter Sync {{ relativ(sync.letzterSync) }}
    </p>
  </div>
</template>
