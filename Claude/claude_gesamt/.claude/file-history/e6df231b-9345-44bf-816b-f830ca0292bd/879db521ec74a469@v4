/**
 * Schmaler Frappe-Client.
 *
 * Bewusst ohne zusätzliche Abhängigkeit: Die App spricht ausschließlich
 * `/api/method` (Whitelisted-Methoden) und `/api/resource` (Doctype-CRUD) an.
 * Authentifiziert wird über das Session-Cookie der Frappe-Site; der CSRF-Token
 * kommt aus `window.csrf_token`, das die Website-Page `www/baudoku.py` setzt.
 */

import { demoAktiv, demoAntwort, demoDokument, demoListe } from './demo'

export class ApiFehler extends Error {
  constructor(
    message: string,
    readonly status: number,
    readonly exception?: string,
    readonly rohtext?: string,
  ) {
    super(message)
    this.name = 'ApiFehler'
  }

  /** Netzwerkausfall statt inhaltlichem Fehler — der Sync darf es später erneut versuchen. */
  get istNetzfehler(): boolean {
    return this.status === 0
  }

  get istAnmeldefehler(): boolean {
    return this.status === 401 || this.status === 403
  }
}

declare global {
  interface Window {
    csrf_token?: string
    frappe_boot?: Record<string, unknown>
  }
}

/** Wird ausgelöst, sobald feststeht, dass die Frappe-Sitzung abgelaufen ist. */
export const SITZUNG_ABGELAUFEN = 'baudoku:sitzung-abgelaufen'

let sitzungspruefungLaeuft = false
let sitzungGemeldet = false

/**
 * Prüft nach einem 403, ob die Sitzung abgelaufen ist oder schlicht die Rechte
 * fehlen.
 *
 * Frappe beantwortet beides mit 403. Unterscheiden lässt es sich über
 * `get_logged_user`: Diese Methode steht jedem angemeldeten Benutzer offen —
 * scheitert sie ebenfalls, ist niemand mehr angemeldet. Ohne diese
 * Unterscheidung sähe der Techniker bei abgelaufener Sitzung nur eine Kette
 * unverständlicher Rechtefehler und würde weiter erfassen, ohne dass etwas
 * übertragen wird.
 */
async function sitzungPruefen(): Promise<void> {
  if (sitzungspruefungLaeuft || sitzungGemeldet) return
  sitzungspruefungLaeuft = true
  try {
    const antwort = await fetch('/api/method/frappe.auth.get_logged_user', {
      credentials: 'same-origin',
      headers: { Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
    })
    if (antwort.status === 401 || antwort.status === 403) {
      sitzungGemeldet = true
      window.dispatchEvent(new CustomEvent(SITZUNG_ABGELAUFEN))
    }
  } catch {
    // Kein Netz: Das ist kein Anmeldeproblem, sondern der Offlinefall.
  } finally {
    sitzungspruefungLaeuft = false
  }
}

function csrfToken(): string {
  return window.csrf_token ?? ''
}

/**
 * Holt den CSRF-Token nach, wenn die App aus dem Offline-Cache gestartet wurde.
 *
 * Frappe setzt den Token beim Rendern der Seite. Startet die App ohne Netz,
 * liefert der Service Worker die gecachte Hülle ohne Token — sobald die
 * Verbindung zurück ist, würde jeder Schreibvorgang mit 400 scheitern. Diese
 * Funktion lädt die gerenderte Seite einmal nach und liest den Token heraus.
 */
export async function csrfNachladen(): Promise<boolean> {
  try {
    const antwort = await fetch('/baudoku', { credentials: 'same-origin', cache: 'no-store' })
    if (!antwort.ok) return false
    const treffer = (await antwort.text()).match(/csrf_token\s*=\s*['"]([^'"]+)['"]/)
    if (!treffer || treffer[1].includes('{{')) return false
    window.csrf_token = treffer[1]
    return true
  } catch {
    return false
  }
}

function kopfzeilen(): HeadersInit {
  const kopf: Record<string, string> = {
    Accept: 'application/json',
    'Content-Type': 'application/json',
    'X-Requested-With': 'XMLHttpRequest',
  }
  const token = csrfToken()
  if (token) kopf['X-Frappe-CSRF-Token'] = token
  return kopf
}

/** Entpackt Frappe-Fehlermeldungen (`_server_messages`, `exc_type`) in lesbaren Text. */
function fehlertext(daten: unknown, rohtext: string, status: number): string {
  if (daten && typeof daten === 'object') {
    const d = daten as Record<string, unknown>
    const messages = d._server_messages
    if (typeof messages === 'string') {
      try {
        const liste = JSON.parse(messages) as string[]
        const texte = liste.map((eintrag) => {
          try {
            const objekt = JSON.parse(eintrag) as { message?: string; title?: string }
            return objekt.message ?? objekt.title ?? eintrag
          } catch {
            return eintrag
          }
        })
        if (texte.length) return texte.join('\n').replace(/<[^>]+>/g, '')
      } catch {
        /* weiter unten */
      }
    }
    if (typeof d.message === 'string') return d.message
    if (typeof d.exc_type === 'string') return d.exc_type
  }
  if (rohtext && rohtext.length < 400) return rohtext.replace(/<[^>]+>/g, '').trim()
  return `Serverfehler (HTTP ${status})`
}

async function anfrage<T>(pfad: string, optionen: RequestInit = {}): Promise<T> {
  let antwort: Response
  try {
    antwort = await fetch(pfad, {
      credentials: 'same-origin',
      headers: kopfzeilen(),
      ...optionen,
    })
  } catch (fehler) {
    throw new ApiFehler(
      'Keine Verbindung zum Server. Die Daten bleiben lokal gespeichert.',
      0,
      (fehler as Error)?.message,
    )
  }

  const rohtext = await antwort.text()
  let daten: unknown = null
  if (rohtext) {
    try {
      daten = JSON.parse(rohtext)
    } catch {
      daten = null
    }
  }

  if (!antwort.ok) {
    const exception = (daten as { exc_type?: string } | null)?.exc_type
    // Fehlender oder veralteter CSRF-Token: einmal nachladen und wiederholen.
    if (
      (antwort.status === 400 || antwort.status === 417) &&
      /csrf/i.test(rohtext) &&
      !optionen.headers &&
      (await csrfNachladen())
    ) {
      return anfrage<T>(pfad, optionen)
    }
    if (antwort.status === 401) {
      sitzungGemeldet = true
      window.dispatchEvent(new CustomEvent(SITZUNG_ABGELAUFEN))
    } else if (antwort.status === 403) {
      void sitzungPruefen()
    }
    throw new ApiFehler(fehlertext(daten, rohtext, antwort.status), antwort.status, exception, rohtext)
  }

  const inhalt = daten as { message?: T; data?: T } | null
  if (inhalt && 'message' in inhalt) return inhalt.message as T
  if (inhalt && 'data' in inhalt) return inhalt.data as T
  return daten as T
}

/** Ruft eine whitelisted Servermethode auf. */
export function methode<T = unknown>(
  name: string,
  parameter: Record<string, unknown> = {},
  methodeHttp: 'GET' | 'POST' = 'POST',
): Promise<T> {
  if (demoAktiv()) {
    const antwort = demoAntwort(name, parameter)
    if (antwort !== undefined) return Promise.resolve(antwort as T)
  }
  const pfad = `/api/method/${name}`
  if (methodeHttp === 'GET') {
    const query = new URLSearchParams()
    for (const [schluessel, wert] of Object.entries(parameter)) {
      if (wert === undefined || wert === null) continue
      query.set(schluessel, typeof wert === 'object' ? JSON.stringify(wert) : String(wert))
    }
    const suffix = query.toString()
    return anfrage<T>(suffix ? `${pfad}?${suffix}` : pfad, { method: 'GET' })
  }
  return anfrage<T>(pfad, { method: 'POST', body: JSON.stringify(parameter) })
}

export interface ListenOptionen {
  filters?: unknown
  or_filters?: unknown
  fields?: string[]
  order_by?: string
  limit_start?: number
  limit_page_length?: number
  parent?: string
}

export const resource = {
  liste<T = Record<string, unknown>>(doctype: string, optionen: ListenOptionen = {}): Promise<T[]> {
    if (demoAktiv()) return Promise.resolve(demoListe(doctype) as T[])
    const query = new URLSearchParams()
    if (optionen.fields) query.set('fields', JSON.stringify(optionen.fields))
    if (optionen.filters) query.set('filters', JSON.stringify(optionen.filters))
    if (optionen.or_filters) query.set('or_filters', JSON.stringify(optionen.or_filters))
    if (optionen.order_by) query.set('order_by', optionen.order_by)
    query.set('limit_start', String(optionen.limit_start ?? 0))
    query.set('limit_page_length', String(optionen.limit_page_length ?? 50))
    return anfrage<T[]>(`/api/resource/${encodeURIComponent(doctype)}?${query}`, { method: 'GET' })
  },

  lesen<T = Record<string, unknown>>(doctype: string, name: string): Promise<T> {
    if (demoAktiv()) {
      const treffer = demoDokument(doctype, name)
      if (treffer) return Promise.resolve(treffer as T)
      return Promise.reject(new ApiFehler(`${doctype} ${name} nicht gefunden`, 404))
    }
    return anfrage<T>(`/api/resource/${encodeURIComponent(doctype)}/${encodeURIComponent(name)}`, {
      method: 'GET',
    })
  },

  anlegen<T = Record<string, unknown>>(doctype: string, daten: Record<string, unknown>): Promise<T> {
    return anfrage<T>(`/api/resource/${encodeURIComponent(doctype)}`, {
      method: 'POST',
      body: JSON.stringify(daten),
    })
  },

  aktualisieren<T = Record<string, unknown>>(
    doctype: string,
    name: string,
    daten: Record<string, unknown>,
  ): Promise<T> {
    return anfrage<T>(`/api/resource/${encodeURIComponent(doctype)}/${encodeURIComponent(name)}`, {
      method: 'PUT',
      body: JSON.stringify(daten),
    })
  },

  loeschen(doctype: string, name: string): Promise<unknown> {
    return anfrage(`/api/resource/${encodeURIComponent(doctype)}/${encodeURIComponent(name)}`, {
      method: 'DELETE',
    })
  },

  anzahl(doctype: string, filters?: unknown): Promise<number> {
    return methode<number>(
      'frappe.client.get_count',
      { doctype, filters: filters ?? {} },
      'GET',
    )
  },
}

