<script setup lang="ts">
/**
 * Anwendungsrahmen mit drei Layouts (NFA-020 bis NFA-022):
 * - Smartphone: Kopfzeile + Tab-Leiste unten, Daumen erreicht alles
 * - Tablet:     wie Smartphone, aber breitere Inhaltsspalte
 * - Desktop:    dauerhafte Seitenleiste, Tab-Leiste entfällt
 *
 * Die Protokollausführung läuft im Vollbild ohne Rahmen.
 */
import { computed, onMounted, ref } from 'vue'
import { useRoute, useRouter } from 'vue-router'

import AppIcon from '@/components/AppIcon.vue'
import SyncIndikator from '@/components/SyncIndikator.vue'
import ToastBereich from '@/components/ToastBereich.vue'
import { aufraeumen } from '@/lib/db'
import { aktualisierungVerfuegbar, aktualisierungVerschieben, jetztAktualisieren } from '@/lib/pwa'
import { useStammdaten } from '@/stores/stammdaten'
import { useSync } from '@/stores/sync'
import { useUi } from '@/stores/ui'

const route = useRoute()
const router = useRouter()
const stammdaten = useStammdaten()
const sync = useSync()
const ui = useUi()

const startfehler = ref<string | null>(null)
const bereit = ref(false)

const vollbild = computed(() => Boolean(route.meta.vollbild))

interface NavEintrag {
  name: string
  titel: string
  symbol: string
  rolle?: string
}

const alleEintraege: NavEintrag[] = [
  { name: 'dashboard', titel: 'Start', symbol: 'haus' },
  { name: 'anlagen', titel: 'Anlagen', symbol: 'anlage' },
  { name: 'protokolle', titel: 'Protokolle', symbol: 'protokoll' },
  { name: 'maengel', titel: 'Mängel', symbol: 'mangel' },
  { name: 'tagesberichte', titel: 'Berichte', symbol: 'bericht' },
  { name: 'karte', titel: 'Karte', symbol: 'karte' },
  { name: 'analysen', titel: 'Analysen', symbol: 'analyse', rolle: 'bauleiter' },
  { name: 'vorlagen', titel: 'Vorlagen', symbol: 'vorlage', rolle: 'projektleiter' },
  { name: 'einstellungen', titel: 'Einstellungen', symbol: 'zahnrad' },
]

function darfSehen(eintrag: NavEintrag): boolean {
  if (eintrag.rolle === 'bauleiter') return stammdaten.istBauleiter
  if (eintrag.rolle === 'projektleiter') return stammdaten.istProjektleiter
  return true
}

const navigation = computed(() => alleEintraege.filter(darfSehen))

/** Auf dem Smartphone bleiben fünf Tabs — der Rest liegt unter „Mehr“. */
const tableiste = computed(() => navigation.value.slice(0, 4))

const seitentitel = computed(() => (route.meta.titel as string) ?? 'Baudoku')

const schnellaktionen = [
  { titel: 'Protokoll', symbol: 'protokoll', ziel: 'protokoll-neu' },
  { titel: 'Mangel', symbol: 'mangel', ziel: 'mangel-neu' },
  { titel: 'Tagesbericht', symbol: 'bericht', ziel: 'tagesbericht-neu' },
]
const aktionsmenueOffen = ref(false)

function schnellaktion(ziel: string) {
  aktionsmenueOffen.value = false
  void router.push({ name: ziel })
}

onMounted(async () => {
  sync.starten()
  try {
    await stammdaten.laden()
  } catch (fehler) {
    startfehler.value = (fehler as Error).message
  } finally {
    bereit.value = true
  }
  // Übertragene Fotos und gesichtete Konflikte nach einer Woche verwerfen.
  void aufraeumen().catch(() => undefined)
})
</script>

<template>
  <div class="flex h-full flex-col bg-slate-100 dark:bg-slate-950">
    <ToastBereich />

    <!-- Neue Fassung verfügbar — der Benutzer entscheidet, wann geladen wird -->
    <div
      v-if="aktualisierungVerfuegbar"
      class="fixed inset-x-0 bottom-0 z-40 flex items-center gap-3 border-t border-marke-600
             bg-marke-700 px-4 py-3 text-sm text-white desktop:inset-x-auto desktop:bottom-4
             desktop:right-4 desktop:max-w-md desktop:rounded-xl desktop:border"
      role="status"
    >
      <AppIcon name="pfeilUnten" :groesse="20" class="shrink-0" />
      <p class="flex-1">
        Eine neue Fassung steht bereit.
        <span class="block text-xs text-marke-100">
          Laufende Erfassungen sind lokal gespeichert und gehen nicht verloren.
        </span>
      </p>
      <button class="shrink-0 rounded-lg px-3 py-1.5 text-xs font-semibold text-marke-100
                     hover:bg-marke-600"
              @click="aktualisierungVerschieben">
        Später
      </button>
      <button class="shrink-0 rounded-lg bg-white px-3 py-1.5 text-xs font-semibold text-marke-700"
              @click="jetztAktualisieren">
        Aktualisieren
      </button>
    </div>

    <!-- Startbildschirm, solange die Stammdaten geladen werden -->
    <div v-if="!bereit" class="flex h-full flex-col items-center justify-center gap-4">
      <AppIcon name="blitz" :groesse="48" class="animate-pulse text-marke-600" />
      <p class="text-sm text-slate-500">Baudoku wird geladen …</p>
    </div>

    <template v-else-if="vollbild">
      <RouterView />
    </template>

    <template v-else>
      <div class="flex h-full min-h-0">
        <!-- Seitenleiste ab Desktop (NFA-022) -->
        <aside
          class="hidden w-60 shrink-0 flex-col border-r border-slate-200 bg-white desktop:flex
                 dark:border-slate-800 dark:bg-slate-900"
        >
          <div class="flex items-center gap-2 px-5 py-4">
            <AppIcon name="blitz" :groesse="26" class="text-marke-600" />
            <div>
              <div class="text-sm font-bold leading-tight">ÖKOVOLT</div>
              <div class="text-xs text-slate-500">Baudoku</div>
            </div>
          </div>

          <nav class="flex-1 space-y-0.5 overflow-y-auto px-3 pb-4 scrollbar-schmal">
            <RouterLink
              v-for="eintrag in navigation"
              :key="eintrag.name"
              :to="{ name: eintrag.name }"
              class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-slate-600
                     transition hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800"
              active-class="bg-marke-50 text-marke-700 dark:bg-marke-900/40 dark:text-marke-300"
            >
              <AppIcon :name="eintrag.symbol" :groesse="20" />
              {{ eintrag.titel }}
              <span
                v-if="eintrag.name === 'maengel' && sync.konflikte"
                class="ml-auto rounded-full bg-fehler px-1.5 text-xs font-bold text-white"
              >
                {{ sync.konflikte }}
              </span>
            </RouterLink>
          </nav>

          <div class="border-t border-slate-200 p-3 dark:border-slate-800">
            <SyncIndikator ausfuehrlich />
            <div class="mt-3 flex items-center gap-2 px-1 text-xs text-slate-500">
              <AppIcon name="person" :groesse="16" />
              <span class="truncate">{{ stammdaten.benutzer?.vollname ?? '–' }}</span>
              <button
                class="ml-auto rounded p-1.5 hover:bg-slate-100 dark:hover:bg-slate-800"
                :title="ui.dunkel ? 'Helles Design' : 'Dunkles Design'"
                @click="ui.dunkel = !ui.dunkel"
              >
                <AppIcon :name="ui.dunkel ? 'sonne' : 'mond'" :groesse="16" />
              </button>
            </div>
          </div>
        </aside>

        <div class="flex min-w-0 flex-1 flex-col">
          <!-- Kopfzeile -->
          <header
            class="sticky top-0 z-20 flex items-center gap-3 border-b border-slate-200 bg-white/95
                   px-4 py-3 backdrop-blur desktop:px-6 dark:border-slate-800 dark:bg-slate-900/95"
          >
            <button
              v-if="route.name !== 'dashboard'"
              class="tap -ml-2 flex items-center justify-center rounded-lg text-slate-500
                     hover:bg-slate-100 desktop:hidden dark:hover:bg-slate-800"
              aria-label="Zurück"
              @click="router.back()"
            >
              <AppIcon name="pfeilLinks" />
            </button>

            <h1 class="min-w-0 flex-1 truncate text-lg font-bold">{{ seitentitel }}</h1>

            <SyncIndikator class="desktop:hidden" />
            <button
              class="tap hidden items-center justify-center rounded-lg text-slate-500 hover:bg-slate-100
                     desktop:flex dark:hover:bg-slate-800"
              :title="ui.dunkel ? 'Helles Design' : 'Dunkles Design'"
              @click="ui.dunkel = !ui.dunkel"
            >
              <AppIcon :name="ui.dunkel ? 'sonne' : 'mond'" :groesse="20" />
            </button>
          </header>

          <div
            v-if="stammdaten.ausCache"
            class="flex items-center gap-2 bg-amber-100 px-4 py-2 text-sm text-amber-900
                   dark:bg-amber-900/40 dark:text-amber-200"
          >
            <AppIcon name="wolkeAus" :groesse="18" />
            Offline-Modus: Stammdaten vom letzten Sync. Neue Daten werden lokal gespeichert.
          </div>
          <div
            v-else-if="startfehler"
            class="flex items-center gap-2 bg-red-100 px-4 py-2 text-sm text-red-900
                   dark:bg-red-900/40 dark:text-red-200"
          >
            <AppIcon name="warnung" :groesse="18" />
            {{ startfehler }}
          </div>

          <!-- Inhalt -->
          <main class="min-h-0 flex-1 overflow-y-auto scrollbar-schmal">
            <div class="mx-auto w-full max-w-6xl px-4 py-4 pb-28 desktop:px-6 desktop:pb-8">
              <RouterView v-slot="{ Component }">
                <component :is="Component" />
              </RouterView>
            </div>
          </main>
        </div>
      </div>

      <!-- Schnellaktionen (Kapitel 6.1: max. 3 Taps bis zur Ausführung) -->
      <div class="fixed bottom-20 right-4 z-30 flex flex-col items-end gap-2 desktop:bottom-6">
        <template v-if="aktionsmenueOffen">
          <button
            v-for="aktion in schnellaktionen"
            :key="aktion.ziel"
            class="flex items-center gap-2 rounded-full bg-white py-2.5 pl-4 pr-5 text-sm font-semibold
                   shadow-karte dark:bg-slate-800"
            @click="schnellaktion(aktion.ziel)"
          >
            <AppIcon :name="aktion.symbol" :groesse="18" class="text-marke-600" />
            {{ aktion.titel }}
          </button>
        </template>
        <button
          class="tap flex h-14 w-14 items-center justify-center rounded-full bg-marke-600 text-white
                 shadow-lg transition active:scale-95"
          :aria-label="aktionsmenueOffen ? 'Menü schließen' : 'Neu anlegen'"
          @click="aktionsmenueOffen = !aktionsmenueOffen"
        >
          <AppIcon :name="aktionsmenueOffen ? 'kreuz' : 'plus'" :groesse="26" />
        </button>
      </div>

      <!-- Tab-Leiste bis Tablet -->
      <nav
        class="fixed inset-x-0 bottom-0 z-20 grid grid-cols-5 border-t border-slate-200 bg-white
               pb-[env(safe-area-inset-bottom)] desktop:hidden dark:border-slate-800 dark:bg-slate-900"
      >
        <RouterLink
          v-for="eintrag in tableiste"
          :key="eintrag.name"
          :to="{ name: eintrag.name }"
          class="flex flex-col items-center gap-0.5 py-2 text-[11px] font-medium text-slate-500"
          active-class="text-marke-600 dark:text-marke-400"
        >
          <AppIcon :name="eintrag.symbol" :groesse="22" />
          {{ eintrag.titel }}
        </RouterLink>
        <RouterLink
          :to="{ name: 'einstellungen' }"
          class="flex flex-col items-center gap-0.5 py-2 text-[11px] font-medium text-slate-500"
          active-class="text-marke-600 dark:text-marke-400"
        >
          <AppIcon name="zahnrad" :groesse="22" />
          Mehr
        </RouterLink>
      </nav>
    </template>
  </div>
</template>
