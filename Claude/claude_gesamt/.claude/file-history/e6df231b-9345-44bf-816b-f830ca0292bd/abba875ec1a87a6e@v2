{% if doc.unterschriften %}
<h2>Unterschrift</h2>
<div class="sig">
	{% for u in doc.unterschriften %}
	<div class="feld">
		<img src="{{ u.signatur }}">
		<div class="linie">{{ u.name_unterzeichner }} ({{ u.rolle }})<br>
			{{ frappe.format(u.unterzeichnet_am, {"fieldtype": "Datetime"}) }}</div>
	</div>
	{% endfor %}
</div>
{% endif %}

<div class="fuss">
	Status: {{ doc.status }}
	{% if doc.genehmigt_von %} - genehmigt von {{ doc.genehmigt_von }} am
		{{ frappe.format(doc.genehmigt_am, {"fieldtype": "Datetime"}) }}{% endif %}
