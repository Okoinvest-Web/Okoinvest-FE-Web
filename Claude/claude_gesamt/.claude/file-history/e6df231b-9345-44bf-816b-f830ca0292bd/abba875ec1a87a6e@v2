</table>

{% if doc.besondere_vorkommnisse or doc.materiallieferungen %}
<h2>Besondere Vorkommnisse</h2>
{% if doc.besondere_vorkommnisse %}<div>{{ doc.besondere_vorkommnisse }}</div>{% endif %}
{% if doc.materiallieferungen %}
<p><b>Materiallieferungen:</b> {{ doc.materiallieferungen }}</p>{% endif %}
{% endif %}

{% if doc.fotos %}
<h2>Fortschrittsfotos</h2>
<div class="fotos">
	{% for foto in doc.fotos %}
	<div class="foto">
		<img src="{{ foto.bild }}">
		<div class="bu">{{ foto.beschriftung or "" }}
			{{ frappe.format(foto.aufgenommen_am, {"fieldtype": "Datetime"}) }}</div>
