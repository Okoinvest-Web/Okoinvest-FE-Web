"""

FORMATE = [
	{
		"name": "Pruefprotokoll OEKOVOLT",
		"doc_type": "Pruefprotokoll",
		"html": PRUEFPROTOKOLL_HTML,
	},
	{
		"name": "Tagesbericht OEKOVOLT",
		"doc_type": "Tagesbericht",
		"html": TAGESBERICHT_HTML,
	},
]


def scrub(name: str) -> str:
	return name.lower().replace(" ", "_").replace("-", "_")


def write_all():
	for fmt in FORMATE:
		doc = {
			"absolute_value": 0,
			"align_labels_right": 0,
			"creation": TS,
			"css": CSS,
			"custom_format": 1,
			"default_print_language": "de",
			"disabled": 0,
			"doc_type": fmt["doc_type"],
			"docstatus": 0,
			"doctype": "Print Format",
			"font_size": 0,
			"html": fmt["html"],
			"idx": 0,
			"line_breaks": 0,
			"margin_bottom": 15.0,
			"margin_left": 12.0,
			"margin_right": 12.0,
			"margin_top": 15.0,
			"modified": TS,
			"modified_by": "Administrator",
			"module": "Baudoku",
			"name": fmt["name"],
			"owner": "Administrator",
			"page_number": "Bottom Right",
			"print_format_builder": 0,
			"print_format_type": "Jinja",
			"show_section_headings": 0,
			"standard": "Yes",
		}
		folder = ZIEL / scrub(fmt["name"])
		folder.mkdir(parents=True, exist_ok=True)
		init = folder / "__init__.py"
		if not init.exists():
			init.write_text("", encoding="utf-8")
		target = folder / f"{scrub(fmt['name'])}.json"
		target.write_text(json.dumps(doc, indent=1, ensure_ascii=False) + "\n", encoding="utf-8")
		print(f"  {target.relative_to(ROOT)}")


if __name__ == "__main__":
	ZIEL.mkdir(parents=True, exist_ok=True)
	init = ZIEL / "__init__.py"
	if not init.exists():
		init.write_text("", encoding="utf-8")
	print(f"Schreibe {len(FORMATE)} Print Formats:")
	write_all()
	print("Fertig.")
