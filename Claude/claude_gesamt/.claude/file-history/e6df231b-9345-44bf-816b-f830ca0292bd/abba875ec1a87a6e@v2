"""

KOPF = """
<div class="kopf">
	<div>
		<h1>{{ titel }}</h1>
		<div class="hinweis">{{ untertitel }}</div>
	</div>
	<div class="firma">
		<b>OEKOVOLT Solartechnik GmbH</b><br>
		Gewerbegebiet 10<br>
		5121 Ostermiething, Oesterreich<br>
		Dokument {{ doc.name }}
	</div>
</div>
"""

PRUEFPROTOKOLL_HTML = """<div class="pf">
""" + KOPF.replace("{{ titel }}", "{{ doc.vorlage_typ }}-Protokoll").replace(
	"{{ untertitel }}", "{{ frappe.db.get_value('Checklistenvorlage', doc.vorlage, 'titel') }} "
	                    "(Rev. {{ doc.vorlage_revision }})") + """
<table class="stamm">
	<tr>
		<td class="l">Anlage</td>
		<td><b>{{ frappe.db.get_value("PV Anlage", doc.anlage, "anlage_name") }}</b> ({{ doc.anlage }})</td>
		<td class="l">Pruefer</td>
		<td>{{ frappe.db.get_value("Employee", doc.pruefer, "employee_name") }}</td>
	</tr>
	<tr>
		<td class="l">Auftraggeber</td><td>{{ doc.customer or "-" }}</td>
		<td class="l">Beginn</td><td>{{ frappe.format(doc.pruef_datum, {"fieldtype": "Datetime"}) }}</td>
