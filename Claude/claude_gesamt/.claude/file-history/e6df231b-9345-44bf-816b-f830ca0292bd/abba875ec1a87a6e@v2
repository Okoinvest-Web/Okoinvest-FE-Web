	{% endfor %}
</table>
{% endfor %}

{% if doc.messdaten %}
<h2>String-Messdaten</h2>
<table>
	<tr><th>String</th><th>WR / MPPT</th><th>Module</th><th>Uoc (V)</th><th>Isc (A)</th>
		<th>Riso (kOhm)</th><th>Status</th></tr>
	{% for m in doc.messdaten %}
	<tr>
		<td>{{ m.string_nr }}</td><td>{{ m.wechselrichter or "-" }}</td><td>{{ m.anzahl_module }}</td>
		<td>{{ m.uoc }}</td><td>{{ m.isc }}</td><td>{{ m.riso }}</td>
		<td><span class="badge" style="background:{{ status_farbe(m.status) }}">{{ m.status }}</span></td>
	</tr>
	{% if m.plausi_meldung and m.status != "OK" %}
	<tr><td colspan="7" class="hinweis">{{ m.plausi_meldung }}
		{% if m.uebersteuert %} - uebersteuert: {{ m.uebersteuerung_grund }}{% endif %}</td></tr>
	{% endif %}
	{% endfor %}
</table>
{% endif %}

<h2>Gesamtbewertung</h2>
<p><span class="badge" style="background:{{ status_farbe(doc.gesamtbewertung) }}; font-size:10pt">
	{{ doc.gesamtbewertung or "ohne Bewertung" }}</span></p>
{% if doc.zusammenfassung %}<div>{{ doc.zusammenfassung }}</div>{% endif %}
<p class="hinweis">{{ doc.anzahl_erledigt }} von {{ doc.anzahl_pruefpunkte }} Pruefpunkten erfasst,
	{{ doc.anzahl_maengel or 0 }} Maengel dokumentiert.</p>

{% if doc.unterschriften %}
<h2>Unterschriften</h2>
<div class="sig">
	{% for u in doc.unterschriften %}
	<div class="feld">
		<img src="{{ u.signatur }}">
		<div class="linie">
			{{ u.name_unterzeichner }} ({{ u.rolle }})<br>
			{{ frappe.format(u.unterzeichnet_am, {"fieldtype": "Datetime"}) }}
			{% if u.ip_adresse %}<br>IP {{ u.ip_adresse }}{% endif %}
		</div>
	</div>
	{% endfor %}
</div>
{% endif %}

<div class="fuss">
	Erstellt mit OEKOVOLT Baudoku - {{ frappe.utils.now() }}.
	Dieses Protokoll wurde digital erfasst und ist ohne Unterschrift nur als Entwurf gueltig.
</div>
</div>
"""

