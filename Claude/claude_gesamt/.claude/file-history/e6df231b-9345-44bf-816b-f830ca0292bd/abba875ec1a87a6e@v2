{% for gruppe in gruppiere_ergebnisse(doc.ergebnisse) %}
<h2>{{ gruppe.sektion }}</h2>
<table>
	<tr><th style="width:12mm">Nr.</th><th>Pruefpunkt</th><th style="width:38mm">Ergebnis</th>
		<th style="width:20mm">Status</th></tr>
	{% for z in gruppe.zeilen %}
	<tr>
		<td>{{ z.nummer or "" }}</td>
		<td>
			{{ z.titel }}
			{% if z.bemerkung %}<br><span class="hinweis">{{ z.bemerkung }}</span>{% endif %}
			{% if z.plausi_meldung and z.status in ("Warnung", "Fehler") %}
				<br><span class="hinweis">{{ z.plausi_meldung }}</span>
			{% endif %}
			{% if z.uebersteuert %}
				<br><span class="hinweis">Uebersteuert: {{ z.uebersteuerung_grund }}</span>
			{% endif %}
			{% if z.mangel %}<br><b>Mangel {{ z.mangel }}</b>{% endif %}
			{% if z.fotos %}
			<div class="fotos">
				{% for foto in z.fotos %}
