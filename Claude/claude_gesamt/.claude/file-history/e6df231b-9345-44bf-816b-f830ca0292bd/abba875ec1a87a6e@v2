						{{ frappe.format(foto.aufgenommen_am, {"fieldtype": "Datetime"}) }}</div>
				</div>
				{% endfor %}
			</div>
			{% endif %}
		</td>
		<td>
			{%- if z.feldtyp == "Bewertung" -%}{{ z.bewertung or "-" }}
			{%- elif z.feldtyp == "Zahlenwert" -%}{{ z.wert_zahl }} {{ z.einheit or "" }}
			{%- elif z.feldtyp == "Ja-Nein" -%}{{ "Ja" if z.wert_ja_nein else "Nein" }}
			{%- elif z.feldtyp == "Datum" -%}{{ frappe.format(z.wert_datum, {"fieldtype": "Date"}) }}
			{%- elif z.feldtyp == "Foto" -%}{{ "siehe Foto" if z.fotos else "-" }}
			{%- else -%}{{ z.wert_text or "-" }}{%- endif -%}
		</td>
		<td><span class="badge" style="background:{{ status_farbe(z.status) }}">{{ z.status }}</span></td>
