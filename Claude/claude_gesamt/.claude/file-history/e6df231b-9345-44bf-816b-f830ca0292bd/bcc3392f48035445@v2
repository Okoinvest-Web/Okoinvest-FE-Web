  }
  if (parameter.get('demo') === '0') {
    localStorage.removeItem('baudoku-demo')
    return false
  }
  return localStorage.getItem('baudoku-demo') === '1'
})()""",
            """/**
 * Einmalig beim Laden ausgewertet: `demoAktiv()` läuft bei jedem API-Aufruf und
 * darf weder die URL neu parsen noch localStorage anfassen.
 *
 * `?demo=1` wirkt ausschließlich in der Entwicklung oder in einem ausdrücklich
 * mit `VITE_DEMO=1` gebauten Demo-Stand. Sonst könnte ein Techniker mit einem
 * weitergereichten Link dauerhaft in erfundenen Daten arbeiten und sie für echt
 * halten — der Schalter bliebe in localStorage stehen.
 */
const DEMO_ERLAUBT = import.meta.env.DEV || import.meta.env.VITE_DEMO === '1'

const AKTIV = (() => {
  if (import.meta.env.VITE_DEMO === '1') return true
  if (!DEMO_ERLAUBT || typeof window === 'undefined') return false

  const parameter = new URLSearchParams(window.location.search)
  if (parameter.get('demo') === '1') {
    localStorage.setItem('baudoku-demo', '1')
    return true
  }
  if (parameter.get('demo') === '0') {
    localStorage.removeItem('baudoku-demo')
    return false
  }
  return localStorage.getItem('baudoku-demo') === '1'
})()""",
