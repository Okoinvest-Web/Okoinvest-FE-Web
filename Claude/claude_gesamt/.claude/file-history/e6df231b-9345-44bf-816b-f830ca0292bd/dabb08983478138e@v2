<script setup lang="ts">
/**
 * Auftragsliste und Wochenkalender des Subunternehmers.
 *
 * „Wann muss ich wo sein" ist die häufigste Frage — deshalb die Kalenderansicht
 * gleichberechtigt neben der Liste, und in beiden immer die Baustelle mit
 * Adresse, damit man direkt hinfahren kann.
 */
import { computed, onMounted, ref } from 'vue'

import AppIcon from '@/components/AppIcon.vue'
import LeereListe from '@/components/LeereListe.vue'
import StatusAbzeichen from '@/components/StatusAbzeichen.vue'
import { datum, isoDatum } from '@/lib/format'
import { portal, type Auftrag } from '@/lib/portal'
import { usePortal } from '@/stores/portal'

const store = usePortal()

const ansicht = ref<'liste' | 'kalender'>('liste')
const mitErledigten = ref(false)
const laedt = ref(true)
const termine = ref<Auftrag[]>([])

const TAGE = ['Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa', 'So']

/** Vier Wochen ab dem Montag dieser Woche. */
const wochen = computed(() => {
  const heute = new Date()
  const montag = new Date(heute)
  montag.setDate(heute.getDate() - ((heute.getDay() + 6) % 7))
  montag.setHours(0, 0, 0, 0)

  return Array.from({ length: 4 }, (_, woche) =>
    Array.from({ length: 7 }, (_, tag) => {
      const d = new Date(montag)
      d.setDate(montag.getDate() + woche * 7 + tag)
      return d
    }),
  )
})

function termineAm(tag: Date): Auftrag[] {
  const iso = isoDatum(tag)
  return termine.value.filter(
    (a) => a.termin_von.slice(0, 10) <= iso && iso <= a.termin_bis.slice(0, 10),
  )
}

const istHeute = (tag: Date) => isoDatum(tag) === isoDatum(new Date())

function tagesklasse(tag: Date): string {
  if (istHeute(tag)) return 'border-marke-600 bg-marke-50 dark:bg-marke-900/30'
  if (tag.getDay() === 0 || tag.getDay() === 6) return 'border-slate-200 bg-slate-50 dark:bg-slate-800/50 dark:border-slate-800'
  return 'border-slate-200 dark:border-slate-800'
}

async function laden() {
  laedt.value = true
  try {
    await store.auftraegeLaden(mitErledigten.value)
    termine.value = await portal.kalender()
  } finally {
    laedt.value = false
  }
}

onMounted(async () => {
  if (!store.geladen) await store.laden()
  await laden()
})
</script>

<template>
  <div class="space-y-4">
    <div class="flex flex-wrap items-center gap-2">
      <div class="flex overflow-hidden rounded-xl border border-slate-300 dark:border-slate-700">
        <button class="tap px-4 text-sm font-medium"
                :class="ansicht === 'liste' ? 'bg-marke-600 text-white' : ''"
                @click="ansicht = 'liste'">
          Liste
        </button>
        <button class="tap px-4 text-sm font-medium"
                :class="ansicht === 'kalender' ? 'bg-marke-600 text-white' : ''"
                @click="ansicht = 'kalender'">
          Kalender
        </button>
      </div>
      <label class="tap ml-auto flex items-center gap-2 text-sm text-slate-500">
        <input v-model="mitErledigten" type="checkbox" class="h-5 w-5" @change="laden" />
        Erledigte zeigen
      </label>
    </div>

    <p v-if="laedt" class="py-8 text-center text-sm text-slate-500">Wird geladen …</p>

    <!-- Liste -->
    <template v-else-if="ansicht === 'liste'">
      <LeereListe
        v-if="!store.auftraege.length"
        symbol="bericht"
        titel="Kein offener Auftrag"
        text="Sobald ÖKOVOLT Ihnen einen Auftrag zuteilt, erscheint er hier."
      />
      <ul v-else class="space-y-2">
        <li v-for="auftrag in store.auftraege" :key="auftrag.name">
          <RouterLink
            :to="{ name: 'portal-auftrag', params: { name: auftrag.name } }"
            class="karte block p-3"
            :class="
              auftrag.verzug
                ? 'border-l-4 border-l-fehler'
                : auftrag.fristwarnung_aktiv
                  ? 'border-l-4 border-l-warnung'
                  : ''
            "
          >
            <div class="flex items-center gap-2">
              <span class="min-w-0 flex-1 truncate font-semibold">{{ auftrag.titel }}</span>
              <span v-if="auftrag.gewaehrleistung"
                    class="abzeichen bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                Gewährleistung
              </span>
              <StatusAbzeichen :wert="auftrag.status" klein />
            </div>
            <div class="mt-1 truncate text-xs text-slate-500">
              {{ store.baustelle(auftrag.anlage)?.anlage_name ?? auftrag.anlage }}
            </div>
            <div class="mt-1 flex items-center gap-3 text-xs">
              <span class="text-slate-400">
                {{ datum(auftrag.termin_von) }} – {{ datum(auftrag.termin_bis) }}
              </span>
              <span v-if="auftrag.verzug" class="font-semibold text-fehler">
                {{ Math.abs(auftrag.tage_bis_frist ?? 0) }} Tage über der Frist
              </span>
              <span v-else-if="auftrag.fristwarnung_aktiv" class="font-semibold text-warnung">
                {{ auftrag.tage_bis_frist === 0 ? 'heute fällig' : `noch ${auftrag.tage_bis_frist} Tage` }}
              </span>
            </div>
            <div v-if="auftrag.fortschritt_prozent"
                 class="mt-2 h-1.5 overflow-hidden rounded-full bg-slate-200 dark:bg-slate-700">
              <div class="h-full rounded-full bg-marke-500"
                   :style="{ width: `${auftrag.fortschritt_prozent}%` }" />
            </div>
          </RouterLink>
        </li>
      </ul>
    </template>

    <!-- Kalender -->
    <template v-else>
      <div class="hidden grid-cols-7 gap-1 text-center text-xs font-semibold text-slate-400 tablet:grid">
        <span v-for="tag in TAGE" :key="tag">{{ tag }}</span>
      </div>
      <div v-for="(woche, wi) in wochen" :key="wi"
           class="grid grid-cols-1 gap-1 tablet:grid-cols-7">
        <div
          v-for="tag in woche"
          :key="tag.toISOString()"
          class="min-h-[84px] rounded-lg border p-2"
          :class="tagesklasse(tag)"
        >
          <div class="mb-1 flex items-center gap-1 text-xs">
            <span class="tablet:hidden">{{ TAGE[(tag.getDay() + 6) % 7] }}</span>
            <span :class="istHeute(tag) ? 'font-bold text-marke-700 dark:text-marke-300' : 'text-slate-400'">
              {{ tag.getDate() }}.{{ tag.getMonth() + 1 }}.
            </span>
          </div>
          <RouterLink
            v-for="a in termineAm(tag)"
            :key="a.name"
            :to="{ name: 'portal-auftrag', params: { name: a.name } }"
            class="mb-1 block truncate rounded px-1.5 py-1 text-[11px] font-medium"
            :class="
              a.verzug
                ? 'bg-red-100 text-red-800 dark:bg-red-900/50 dark:text-red-200'
                : a.fristwarnung_aktiv
                  ? 'bg-amber-100 text-amber-900 dark:bg-amber-900/50 dark:text-amber-200'
                  : 'bg-marke-100 text-marke-800 dark:bg-marke-900/50 dark:text-marke-200'
            "
            :title="`${a.titel} — ${store.baustelle(a.anlage)?.anlage_name ?? a.anlage}`"
          >
            {{ a.titel }}
          </RouterLink>
        </div>
      </div>
      <p class="text-xs text-slate-400">
        <AppIcon name="uhr" :groesse="14" class="inline" />
        Gelb: Frist läuft ab · Rot: Frist überschritten
      </p>
    </template>
  </div>
</template>
