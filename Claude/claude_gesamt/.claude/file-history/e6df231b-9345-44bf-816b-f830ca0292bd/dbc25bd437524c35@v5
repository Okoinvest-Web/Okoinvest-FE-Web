/**
 * Lädt alle noch nicht übertragenen Fotos hoch (älteste zuerst).
 *
 * Die Referenzen in den Dokumenten werden erst *nach* der Schleife in einem
 * einzigen Durchlauf ersetzt — sonst würde jedes Foto alle lokalen Protokolle,
 * Mängel und Berichte erneut laden und schreiben.
 */
export async function fotosHochladen(): Promise<number> {
  const offene = (
    await db.fotos.filter((f) => !f.file_url && (f.versuche ?? 0) < MAX_FOTO_VERSUCHE).toArray()
  ).sort((a, b) => a.aufgenommen_am.localeCompare(b.aufgenommen_am))

  const hochgeladen = new Map<string, string>()

  for (const foto of offene) {
    try {
      const antwort = (await baudoku.fotoHochladen({
        dateiname: foto.dateiname,
        inhalt_base64: await alsDataUrl(foto.blob),
        lokale_id: foto.lokale_id,
      })) as { file_url: string }
      await db.fotos.update(foto.lokale_id, { file_url: antwort.file_url, letzter_fehler: undefined })
      hochgeladen.set(foto.lokale_id, antwort.file_url)
    } catch (fehler) {
      // Netzabbruch: abbrechen und beim nächsten Lauf fortsetzen, ohne den
      // Versuchszähler zu erhöhen — sonst verfällt ein Foto durch Funklöcher.
      if (fehler instanceof ApiFehler && fehler.istNetzfehler) break
      // Inhaltliche Fehler (z. B. zu groß) dürfen die Schlange nicht blockieren.
      await db.fotos.update(foto.lokale_id, {
        versuche: (foto.versuche ?? 0) + 1,
        letzter_fehler: (fehler as Error).message,
      })
    }
  }

  if (hochgeladen.size) await fotoReferenzenAktualisieren(hochgeladen)
  return hochgeladen.size
}

/** Ersetzt die lokalen Blob-Referenzen in allen Dokumenten durch die Server-URLs. */
async function fotoReferenzenAktualisieren(urls: Map<string, string>): Promise<void> {
  const ersetzeIn = (liste?: { lokale_id?: string; bild?: string }[]) => {
    let geaendert = false
    for (const eintrag of liste ?? []) {
      const url = eintrag.lokale_id ? urls.get(eintrag.lokale_id) : undefined
      if (url && eintrag.bild !== url) {
        eintrag.bild = url
        geaendert = true
      }
    }
    return geaendert
  }

  const protokolle = await db.protokolle.toArray()
  const geaenderteProtokolle = protokolle.filter((protokoll) =>
    (protokoll.ergebnisse ?? []).reduce(
      (geaendert, zeile) => ersetzeIn(zeile.fotos) || geaendert,
      false,
    ),
  )
  if (geaenderteProtokolle.length) await db.protokolle.bulkPut(geaenderteProtokolle)

  const maengel = await db.maengel.toArray()
  const geaenderteMaengel = maengel.filter(
    (mangel) => [ersetzeIn(mangel.fotos), ersetzeIn(mangel.erledigt_fotos)].some(Boolean),
  )
  if (geaenderteMaengel.length) await db.maengel.bulkPut(geaenderteMaengel)

  const berichte = await db.berichte.toArray()
  const geaenderteBerichte = berichte.filter((bericht) => ersetzeIn(bericht.fotos))
  if (geaenderteBerichte.length) await db.berichte.bulkPut(geaenderteBerichte)
}

