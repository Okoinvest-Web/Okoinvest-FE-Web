const LETZTER_PULL = 'letzter_pull'

interface PullAntwort {
  daten: Record<string, Record<string, unknown>[]>
  anlagen: Record<string, unknown>[]
  server_zeit: string
}

/**
 * Holt Serveränderungen und übernimmt sie in den lokalen Bestand.
 *
 * Ohne diesen Weg erfährt das Gerät nie, dass ein Bauleiter einen Mangel
 * zugewiesen oder ein Protokoll verifiziert hat.
 *
 * Vorrangregel: Steht für ein Dokument noch eine Änderung in der
 * Warteschlange, wird die Serverfassung **nicht** übernommen — sie würde die
 * ungesendete Arbeit des Technikers überschreiben. Das Dokument geht im selben
 * Lauf ohnehin hinaus; ist der Serverstand dann neuer, greift die reguläre
 * Konflikterkennung und der Server gewinnt.
 */
export async function herunterladen(): Promise<{ empfangen: number; anlagen: Record<string, unknown>[] }> {
  const seit = await stammdatenLesen<string>(LETZTER_PULL)
  const antwort = (await baudoku.pull(seit)) as PullAntwort

  const ausstehend = new Set((await db.warteschlange.toArray()).map((e) => e.lokale_id))
  let empfangen = 0

  for (const [doctype, dokumente] of Object.entries(antwort.daten ?? {})) {
    if (!['Pruefprotokoll', 'Mangel', 'Tagesbericht'].includes(doctype)) continue
    const tabelle = tabelleFuer(doctype as Dokumenttyp)

    for (const dokument of dokumente) {
      const serverId = dokument.lokale_id as string | undefined
      const vorhanden = serverId
        ? await tabelle.get(serverId)
        : await tabelle.where('name').equals(dokument.name as string).first()

      const lokale_id = serverId || vorhanden?.lokale_id || neueId()
      if (ausstehend.has(lokale_id)) continue

      await tabelle.put({ ...dokument, lokale_id } as never)
      empfangen += 1
    }
  }

  await stammdatenSchreiben(LETZTER_PULL, antwort.server_zeit)
  if (empfangen) window.dispatchEvent(new CustomEvent(PULL_EREIGNIS))

  return { empfangen, anlagen: antwort.anlagen ?? [] }
}

const LEER: SyncErgebnis = {
  uebertragen: 0,
  fehler: 0,
  konflikte: 0,
  fotos: 0,
  empfangen: 0,
  meldung: '',
}

/**
 * Ein vollständiger Synchronisationslauf: Fotos, dann Dokumente hinaus,
 * danach Serveränderungen herein. Mehrfachaufrufe laufen nicht parallel.
 */
export async function synchronisieren(): Promise<SyncErgebnis> {
  if (laeuft) return { ...LEER, meldung: 'Sync läuft bereits.' }

  if (!(await istOnline(true))) {
    melden('offline')
    return { ...LEER, meldung: 'Offline – wird später übertragen.' }
  }

  laeuft = true
  melden('syncing')
  let fotos = 0
  let uebertragen = 0
  let konflikte = 0
  let fehler = 0
  let empfangen = 0

  try {
    fotos = await fotosHochladen()

    const batchGroesse = 25
    let rest = await db.warteschlange.filter((e) => e.versuche < MAX_VERSUCHE).toArray()
    while (rest.length) {
      const batch = rest.slice(0, batchGroesse)
      const ergebnis = await batchSenden(batch)
      uebertragen += ergebnis.erfolge
      konflikte += ergebnis.konflikte
      fehler += ergebnis.fehler
      rest = rest.slice(batchGroesse)
    }

    // Erst senden, dann empfangen: So sind die eigenen Änderungen bereits
    // eingearbeitet und kommen nicht als vermeintlich fremde zurück.
    try {
      const pull = await herunterladen()
      empfangen = pull.empfangen
      anlagenEmpfaenger?.(pull.anlagen)
    } catch (pullFehler) {
      // Ein gescheiterter Pull darf den erfolgreichen Push nicht entwerten.
      console.warn('Serveränderungen konnten nicht geholt werden:', pullFehler)
    }

    const ergebnis: SyncErgebnis = {
      uebertragen,
      fehler,
      konflikte,
      fotos,
      empfangen,
      meldung: zusammenfassung(uebertragen, fotos, konflikte, fehler, empfangen),
    }
    melden(fehler || konflikte ? 'fehler' : 'online', ergebnis)
    return ergebnis
  } catch (ausnahme) {
    const netz = ausnahme instanceof ApiFehler && ausnahme.istNetzfehler
    const ergebnis: SyncErgebnis = {
      uebertragen,
      fehler: fehler + 1,
      konflikte,
      fotos,
      empfangen,
      meldung: netz ? 'Verbindung abgebrochen – Sync wird fortgesetzt.' : String((ausnahme as Error).message),
    }
    melden(netz ? 'offline' : 'fehler', ergebnis)
    return ergebnis
  } finally {
    laeuft = false
  }
}

/**
 * Empfänger für aktualisierte Anlagenstammdaten.
 *
 * Der Sync-Motor kennt den Pinia-Store bewusst nicht — sonst hinge die
 * Offline-Logik an der Oberfläche und ließe sich nicht mehr allein testen.
 */
type AnlagenEmpfaenger = (anlagen: Record<string, unknown>[]) => void
let anlagenEmpfaenger: AnlagenEmpfaenger | null = null

export function anlagenEmpfaengerSetzen(empfaenger: AnlagenEmpfaenger): void {
  anlagenEmpfaenger = empfaenger
}

function zusammenfassung(
  uebertragen: number,
  fotos: number,
  konflikte: number,
  fehler: number,
  empfangen = 0,
): string {
  if (!uebertragen && !fotos && !konflikte && !fehler && !empfangen) return 'Alles aktuell.'
  const teile: string[] = []
  if (uebertragen) teile.push(`${uebertragen} Dokument${uebertragen === 1 ? '' : 'e'}`)
  if (fotos) teile.push(`${fotos} Foto${fotos === 1 ? '' : 's'}`)
  let text = teile.length ? `${teile.join(' und ')} übertragen.` : ''
  if (empfangen) text += ` ${empfangen} Änderung${empfangen === 1 ? '' : 'en'} empfangen.`
  if (konflikte) text += ` ${konflikte} Konflikt${konflikte === 1 ? '' : 'e'} – Serverstand übernommen.`
  if (fehler) text += ` ${fehler} Fehler.`
  return text.trim()
}

/** Speichert lokal und reiht für den nächsten Sync ein; überträgt sofort, wenn online. */
export async function speichernUndSynchronisieren(
  doctype: Dokumenttyp,
  lokale_id: string,
  dokument: Record<string, unknown>,
  aktion: 'create' | 'update' = 'update',
): Promise<void> {
  const t = tabelleFuer(doctype)
  await t.put(entkoppeln({ ...dokument, lokale_id }) as never)
  await einreihen(doctype, lokale_id, dokument, aktion, dokument.modified as string | undefined)
  if (await istOnline()) void synchronisieren()
}

let intervall: ReturnType<typeof setInterval> | undefined

/** Startet Hintergrund-Sync bei Verbindungswechsel und alle fünf Minuten. */
export function autoSyncStarten(): () => void {
  const beiOnline = () => {
    void istOnline(true).then((online) => {
      melden(online ? 'online' : 'offline')
      if (online) void synchronisieren()
    })
  }
  const beiOffline = () => melden('offline')

  window.addEventListener('online', beiOnline)
  window.addEventListener('offline', beiOffline)
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') beiOnline()
  })
  intervall = setInterval(() => void synchronisieren(), 5 * 60_000)
  beiOnline()

  return () => {
    window.removeEventListener('online', beiOnline)
    window.removeEventListener('offline', beiOffline)
    if (intervall) clearInterval(intervall)
  }
}
