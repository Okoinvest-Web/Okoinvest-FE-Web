interface PushAntwort {
  ergebnisse: {
    lokale_id: string
    ergebnis: 'Erfolg' | 'Konflikt' | 'Fehler'
    name?: string
    modified?: string
    meldung?: string
    server_dokument?: Record<string, unknown>
  }[]
  server_zeit: string
}

async function batchSenden(eintraege: WarteschlangeEintrag[]) {
  const antwort = (await baudoku.push(
    eintraege.map((eintrag) => ({
      lokale_id: eintrag.lokale_id,
      doctype: eintrag.doctype,
      aktion: eintrag.aktion,
      daten: eintrag.daten,
      basis_modified: eintrag.basis_modified,
    })),
    CLIENT_VERSION,
  )) as PushAntwort

  let erfolge = 0
  let konflikte = 0
  let fehler = 0

  for (const ergebnis of antwort.ergebnisse) {
    const eintrag = eintraege.find((e) => e.lokale_id === ergebnis.lokale_id)
    if (!eintrag?.id) continue

    if (ergebnis.ergebnis === 'Erfolg') {
      await db.warteschlange.delete(eintrag.id)
      await lokalenDatensatzAktualisieren(eintrag.doctype, eintrag.lokale_id, {
        name: ergebnis.name,
        modified: ergebnis.modified,
      })
      erfolge += 1
    } else if (ergebnis.ergebnis === 'Konflikt') {
      // Server gewinnt: lokale Fassung sichern, Serverstand übernehmen.
      await db.konflikte.add({
        lokale_id: eintrag.lokale_id,
        doctype: eintrag.doctype,
        lokale_fassung: eintrag.daten,
        server_fassung: ergebnis.server_dokument ?? {},
        erkannt_am: new Date().toISOString(),
        gesichtet: 0,
      })
      await db.warteschlange.delete(eintrag.id)
      if (ergebnis.server_dokument) {
        await serverFassungUebernehmen(eintrag.doctype, eintrag.lokale_id, ergebnis.server_dokument)
      }
      konflikte += 1
    } else {
      const versuche = eintrag.versuche + 1
      if (versuche >= MAX_VERSUCHE) {
        await db.warteschlange.update(eintrag.id, {
          versuche,
          letzter_fehler: `Nach ${MAX_VERSUCHE} Versuchen aufgegeben: ${ergebnis.meldung ?? ''}`,
        })
      } else {
        await db.warteschlange.update(eintrag.id, { versuche, letzter_fehler: ergebnis.meldung })
      }
      fehler += 1
    }
  }

  return { erfolge, konflikte, fehler }
}

async function lokalenDatensatzAktualisieren(
  doctype: Dokumenttyp,
  lokale_id: string,
  felder: Record<string, unknown>,
): Promise<void> {
  const t = tabelleFuer(doctype)
  const vorhanden = await t.get(lokale_id)
  if (!vorhanden) return
  await t.put({ ...vorhanden, ...felder } as never)
}

async function serverFassungUebernehmen(
  doctype: Dokumenttyp,
  lokale_id: string,
  serverDokument: Record<string, unknown>,
): Promise<void> {
  const t = tabelleFuer(doctype)
  await t.put({ ...serverDokument, lokale_id } as never)
}

