"""Zeilenbasierte Sichtbarkeit je Rolle (Kapitel 8 Rollenkonzept, NFA-042).

Frappe prueft die Doctype- und Feldrechte selbst; hier wird ergaenzend
eingeschraenkt, *welche Datensaetze* eine Rolle sieht:

* Subunternehmer: nur eigene Dokumente bzw. Dokumente ihres Unternehmens
* Kunde: nur abgeschlossene Dokumente der eigenen Anlagen
* alle uebrigen Rollen: uneingeschraenkt
"""

from __future__ import annotations

import frappe

VOLLZUGRIFF = {
	"System Manager", "Administrator", "Baudoku Admin",
	"Baudoku Projektleiter", "Baudoku Bauleiter", "Baudoku Techniker",
}


def _rollen() -> set[str]:
	return set(frappe.get_roles())


def _hat_vollzugriff() -> bool:
	return bool(VOLLZUGRIFF & _rollen())


def _portal_zuordnung(parenttype: str) -> str | None:
	"""Lieferant bzw. Kunde des angemeldeten Portalbenutzers.

	Diese Funktionen laufen in `permission_query_conditions`, also bei *jeder*
	Listenabfrage. Das Ergebnis aendert sich innerhalb eines Requests nicht,
	deshalb wird es dort zwischengespeichert.
	"""
	cache = getattr(frappe.local, "baudoku_portal_cache", None)
	if cache is None:
		cache = {}
		frappe.local.baudoku_portal_cache = cache

	if parenttype not in cache:
		cache[parenttype] = frappe.db.get_value(
			"Portal User", {"user": frappe.session.user, "parenttype": parenttype}, "parent"
		)
	return cache[parenttype]


def _supplier_des_users() -> str | None:
	return _portal_zuordnung("Supplier")


def _customer_des_users() -> str | None:
	return _portal_zuordnung("Customer")


def _q(bedingung: str) -> str:
	return bedingung


def anlage_query(user: str | None = None) -> str:
	if _hat_vollzugriff():
		return ""
	customer = _customer_des_users()
	if customer:
		return _q(f"`tabPV Anlage`.customer = {frappe.db.escape(customer)}")
	supplier = _supplier_des_users()
	if supplier:
		# Subunternehmer sehen Baustellen, auf denen sie Berichte fuehren.
		return _q(
			"`tabPV Anlage`.name in (select distinct anlage from `tabTagesbericht` "
			f"where supplier = {frappe.db.escape(supplier)})"
		)
	return _q("1 = 0")


def protokoll_query(user: str | None = None) -> str:
	if _hat_vollzugriff():
		return ""
	customer = _customer_des_users()
	if customer:
		return _q(
			f"(`tabPruefprotokoll`.customer = {frappe.db.escape(customer)} "
			"and `tabPruefprotokoll`.status in ('Abgeschlossen', 'Verifiziert'))"
		)
	return _q(f"`tabPruefprotokoll`.owner = {frappe.db.escape(user or frappe.session.user)}")


def mangel_query(user: str | None = None) -> str:
	if _hat_vollzugriff():
		return ""
	user = user or frappe.session.user
	customer = _customer_des_users()
	if customer:
		return _q(f"`tabMangel`.customer = {frappe.db.escape(customer)}")
	supplier = _supplier_des_users()
	if supplier:
		return _q(
			f"(`tabMangel`.supplier = {frappe.db.escape(supplier)} "
			f"or `tabMangel`.owner = {frappe.db.escape(user)})"
		)
	return _q(f"`tabMangel`.owner = {frappe.db.escape(user)}")


def tagesbericht_query(user: str | None = None) -> str:
	if _hat_vollzugriff():
		return ""
	user = user or frappe.session.user
	supplier = _supplier_des_users()
	if supplier:
		return _q(f"`tabTagesbericht`.supplier = {frappe.db.escape(supplier)}")
	return _q(f"`tabTagesbericht`.owner = {frappe.db.escape(user)}")


def protokoll_permission(doc, user: str | None = None, permission_type: str | None = None) -> bool:
	if _hat_vollzugriff():
		return True
	user = user or frappe.session.user
	customer = _customer_des_users()
	if customer:
		return doc.customer == customer and doc.status in ("Abgeschlossen", "Verifiziert")
	return doc.owner == user


def tagesbericht_permission(doc, user: str | None = None, permission_type: str | None = None) -> bool:
	if _hat_vollzugriff():
		return True
	user = user or frappe.session.user
	supplier = _supplier_des_users()
	if supplier and doc.supplier == supplier:
		# Eigene Berichte nur aendern, solange sie nicht freigegeben sind.
		if permission_type in ("write", "delete"):
			return doc.status in ("Entwurf", "Abgelehnt")
		return True
	return doc.owner == user
