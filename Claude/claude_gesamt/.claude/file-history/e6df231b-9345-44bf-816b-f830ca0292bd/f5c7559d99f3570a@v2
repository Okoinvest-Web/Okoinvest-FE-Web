<script setup lang="ts">
/**
 * Arbeitszeitfreigabe durch den Bauleiter (ÖKOVOLT-Seite).
 *
 * Erst die Freigabe macht aus einer Stempelung eine Abrechnungsgrundlage.
 * Deshalb steht hier auffällig, wo etwas nicht stimmt: fehlende Pause,
 * überschrittene Tagesgrenze, Stempelung außerhalb der Baustelle.
 */
import { computed, onMounted, ref } from 'vue'

import AppIcon from '@/components/AppIcon.vue'
import BasisDialog from '@/components/BasisDialog.vue'
import LeereListe from '@/components/LeereListe.vue'
import { baudoku } from '@/lib/api'
import { datum, datumZeit } from '@/lib/format'
import { portal, type Arbeitstag } from '@/lib/portal'
import { useUi } from '@/stores/ui'

const ui = useUi()

const tage = ref<Arbeitstag[]>([])
const laedt = ref(true)
const arbeitet = ref(false)
const auswahl = ref<Set<string>>(new Set())
const beanstandungFuer = ref<Arbeitstag | null>(null)
const beanstandungsgrund = ref('')

const auffaellig = computed(() =>
  tage.value.filter(
    (t) => !t.pause_ausreichend || t.ueber_tagesgrenze || t.ueber_wochengrenze,
  ),
)

const summe = computed(() =>
  tage.value
    .filter((t) => auswahl.value.has(t.name))
    .reduce((s, t) => s + (t.arbeitszeit_stunden ?? 0), 0),
)

const alleAusgewaehlt = computed(
  () => tage.value.length > 0 && auswahl.value.size === tage.value.length,
)

function umschalten(name: string) {
  const neu = new Set(auswahl.value)
  if (neu.has(name)) neu.delete(name)
  else neu.add(name)
  auswahl.value = neu
}

function alleUmschalten() {
  auswahl.value = alleAusgewaehlt.value ? new Set() : new Set(tage.value.map((t) => t.name))
}

function hinweise(tag: Arbeitstag): string[] {
  const liste: string[] = []
  if (!tag.pause_ausreichend) liste.push('Ruhepause zu kurz')
  if (tag.ueber_tagesgrenze) liste.push('über Tagesgrenze')
  if (tag.ueber_wochengrenze) liste.push('über Wochengrenze')
  return liste
}

async function laden() {
  laedt.value = true
  try {
    tage.value = await portal.zeitenZurFreigabe()
    auswahl.value = new Set()
  } catch (fehler) {
    ui.fehler((fehler as Error).message)
  } finally {
    laedt.value = false
  }
}

async function freigeben() {
  if (!auswahl.value.size) return
  arbeitet.value = true
  try {
    const ergebnis = (await portal.zeitenFreigeben([...auswahl.value])) as {
      erfolgreich: string[]
      fehlgeschlagen: { name: string; meldung: string }[]
    }
    if (ergebnis.fehlgeschlagen.length) {
      ui.warnung(
        `${ergebnis.erfolgreich.length} freigegeben, ${ergebnis.fehlgeschlagen.length} nicht: ` +
          ergebnis.fehlgeschlagen[0].meldung,
      )
    } else {
      ui.erfolg(`${ergebnis.erfolgreich.length} Arbeitstage freigegeben.`)
    }
    await laden()
  } catch (fehler) {
    ui.fehler((fehler as Error).message)
  } finally {
    arbeitet.value = false
  }
}

async function beanstanden() {
  if (!beanstandungFuer.value || !beanstandungsgrund.value.trim()) return
  arbeitet.value = true
  try {
    await baudoku.dokumentMethode('Arbeitstag', beanstandungFuer.value.name, 'beanstanden', {
      grund: beanstandungsgrund.value,
    })
    ui.toast('Tag beanstandet — der Subunternehmer sieht den Grund.', 'warnung')
    beanstandungFuer.value = null
    beanstandungsgrund.value = ''
    await laden()
  } catch (fehler) {
    ui.fehler((fehler as Error).message)
  } finally {
    arbeitet.value = false
  }
}

function uhrzeit(wert?: string) {
  return wert ? datumZeit(wert).slice(-5) : '–'
}

onMounted(laden)
</script>

<template>
  <div class="space-y-4">
    <header class="flex flex-wrap items-end gap-3">
      <div class="flex-1">
        <h2 class="text-xl font-bold">Arbeitszeiten freigeben</h2>
        <p class="text-sm text-slate-500">
          {{ tage.length }} Tage warten auf Freigabe
          <span v-if="auffaellig.length" class="font-semibold text-warnung">
            · {{ auffaellig.length }} auffällig
          </span>
        </p>
      </div>
      <label v-if="tage.length" class="flex items-center gap-2 text-sm text-slate-500">
        <input type="checkbox" class="h-5 w-5" :checked="alleAusgewaehlt" @change="alleUmschalten" />
        alle
      </label>
    </header>

    <div
      v-if="auswahl.size"
      class="sticky top-16 z-10 flex flex-wrap items-center gap-3 rounded-xl bg-marke-700 px-4
             py-3 text-sm text-white shadow-karte"
    >
      <span class="flex-1 font-semibold">
        {{ auswahl.size }} Tage · {{ summe.toFixed(1) }} h
      </span>
      <button class="rounded-lg px-3 py-1.5 text-xs font-semibold text-marke-100 hover:bg-marke-600"
              @click="auswahl = new Set()">
        Aufheben
      </button>
      <button class="rounded-lg bg-white px-3 py-1.5 text-xs font-semibold text-marke-700"
              :disabled="arbeitet" @click="freigeben">
        Freigeben
      </button>
    </div>

    <p v-if="laedt" class="py-8 text-center text-sm text-slate-500">Wird geladen …</p>

    <LeereListe
      v-else-if="!tage.length"
      symbol="uhr"
      titel="Nichts zur Freigabe"
      text="Alle erfassten Arbeitstage sind bearbeitet."
    />

    <ul v-else class="space-y-2">
      <li v-for="tag in tage" :key="tag.name" class="flex items-center gap-2">
        <input
          type="checkbox"
          class="h-5 w-5 shrink-0"
          :checked="auswahl.has(tag.name)"
          :aria-label="`${tag.mitarbeiter} am ${tag.datum} auswählen`"
          @change="umschalten(tag.name)"
        />
        <div
          class="karte flex flex-1 flex-wrap items-center gap-3 p-3"
          :class="hinweise(tag).length ? 'border-l-4 border-l-warnung' : ''"
        >
          <div class="min-w-0 flex-1">
            <div class="truncate font-semibold">{{ tag.mitarbeiter }}</div>
            <div class="text-xs text-slate-500">
              {{ datum(tag.datum) }} · {{ tag.supplier }} · {{ tag.anlage }}
            </div>
            <div v-if="hinweise(tag).length" class="text-xs font-medium text-warnung">
              {{ hinweise(tag).join(' · ') }}
            </div>
          </div>

          <div class="shrink-0 text-right">
            <div class="font-bold tabular-nums">
              {{ (tag.arbeitszeit_stunden ?? 0).toFixed(2) }} h
            </div>
            <div class="text-xs text-slate-400">
              {{ uhrzeit(tag.beginn) }}–{{ uhrzeit(tag.ende) }}
              <span v-if="tag.pause_minuten"> · {{ tag.pause_minuten }} min Pause</span>
            </div>
          </div>

          <button class="shrink-0 rounded-lg px-2 py-1 text-xs font-semibold text-fehler
                         hover:bg-red-50 dark:hover:bg-red-900/30"
                  @click="beanstandungFuer = tag">
            Beanstanden
          </button>
        </div>
      </li>
    </ul>

    <p v-if="tage.length" class="pb-4 text-xs text-slate-400">
      <AppIcon name="warnung" :groesse="14" class="inline" />
      Auffällige Tage sind nicht gesperrt — die Bewertung bleibt bei Ihnen. Die
      Kennzeichnung soll nur verhindern, dass sie ungeprüft durchlaufen.
    </p>

    <BasisDialog
      :offen="Boolean(beanstandungFuer)"
      titel="Arbeitstag beanstanden"
      @schliessen="beanstandungFuer = null"
    >
      <div class="space-y-3">
        <p class="text-sm text-slate-600 dark:text-slate-300">
          {{ beanstandungFuer?.mitarbeiter }} am {{ datum(beanstandungFuer?.datum) }} ·
          {{ (beanstandungFuer?.arbeitszeit_stunden ?? 0).toFixed(2) }} h
        </p>
        <label>
          <span class="beschriftung">Grund</span>
          <textarea v-model="beanstandungsgrund" class="feld min-h-[96px]" rows="3"
                    placeholder="Was stimmt nicht? Der Subunternehmer sieht diesen Text." />
        </label>
        <div class="flex gap-2">
          <button class="knopf-sekundaer flex-1" @click="beanstandungFuer = null">Abbrechen</button>
          <button class="knopf-gefahr flex-[2]" :disabled="arbeitet || !beanstandungsgrund.trim()"
                  @click="beanstanden">
            Beanstanden
          </button>
        </div>
      </div>
    </BasisDialog>
  </div>
</template>
