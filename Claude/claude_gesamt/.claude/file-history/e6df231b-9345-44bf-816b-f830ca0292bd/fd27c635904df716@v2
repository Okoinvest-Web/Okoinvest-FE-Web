import { fileURLToPath, URL } from 'node:url'
import { copyFileSync, existsSync, mkdirSync } from 'node:fs'
import { resolve } from 'node:path'

import vue from '@vitejs/plugin-vue'
import { defineConfig, type Plugin } from 'vite'
import { VitePWA } from 'vite-plugin-pwa'

/**
 * Die App wird von Frappe unter `/baudoku` ausgeliefert. Die Assets liegen in
 * `oekovolt_baudoku/public/frontend` und sind ueber `/assets/...` erreichbar.
 * `bench build --app oekovolt_baudoku` ruft `yarn build` in diesem Ordner auf.
 */
const BASE = '/assets/oekovolt_baudoku/frontend/'
const APP_DIR = resolve(__dirname, '../oekovolt_baudoku')

/** Kopiert das Build-Ergebnis als Frappe-Website-Page nach `www/baudoku.html`. */
function frappeWebsitePage(): Plugin {
  return {
    name: 'frappe-website-page',
    apply: 'build',
    closeBundle() {
      const quelle = resolve(APP_DIR, 'public/frontend/index.html')
      const ziel = resolve(APP_DIR, 'www/baudoku.html')
      if (!existsSync(quelle)) return
      mkdirSync(resolve(APP_DIR, 'www'), { recursive: true })
      copyFileSync(quelle, ziel)
      // eslint-disable-next-line no-console
      console.log(`\n  Website-Page geschrieben: ${ziel}\n`)
    },
  }
}

export default defineConfig(({ command }) => ({
  base: command === 'build' ? BASE : '/',
  plugins: [
    vue(),
    VitePWA({
      registerType: 'prompt',
      injectRegister: false,
      includeAssets: ['favicon.svg', 'icon-192.svg', 'icon-512.svg'],
      manifest: {
        name: 'ÖKOVOLT Baudoku',
        short_name: 'Baudoku',
        description: 'Baustellendokumentation, Prüfprotokolle und Mängelmanagement',
        lang: 'de-AT',
        theme_color: '#0f172a',
        background_color: '#f8fafc',
        display: 'standalone',
        orientation: 'any',
        start_url: '/baudoku',
        scope: '/baudoku',
        icons: [
          { src: 'icon-192.svg', sizes: '192x192', type: 'image/svg+xml', purpose: 'any' },
          { src: 'icon-512.svg', sizes: '512x512', type: 'image/svg+xml', purpose: 'any maskable' },
        ],
        shortcuts: [
          { name: 'Neues Protokoll', url: '/baudoku/protokolle/neu' },
          { name: 'Neuer Mangel', url: '/baudoku/maengel/neu' },
          { name: 'Neuer Tagesbericht', url: '/baudoku/tagesberichte/neu' },
        ],
      },
      workbox: {
        // App-Shell offline vorhalten (NFA-010)
        globPatterns: ['**/*.{js,css,html,svg,woff2}'],
        navigateFallback: '/baudoku',
        navigateFallbackDenylist: [/^\/api/, /^\/app/, /^\/assets\/frappe/, /^\/files/],
        runtimeCaching: [
          {
            // Stammdaten: erst Netz, bei Ausfall Cache
            urlPattern: /\/api\/method\/oekovolt_baudoku\.api\.sync\.bootstrap/,
            handler: 'NetworkFirst',
            options: {
              cacheName: 'baudoku-bootstrap',
              networkTimeoutSeconds: 5,
              expiration: { maxEntries: 4, maxAgeSeconds: 60 * 60 * 24 * 30 },
            },
          },
          {
            // Fotos und Anhaenge: aus dem Cache, im Hintergrund erneuern
            urlPattern: /\/(files|private\/files)\//,
            handler: 'StaleWhileRevalidate',
            options: {
              cacheName: 'baudoku-dateien',
              expiration: { maxEntries: 400, maxAgeSeconds: 60 * 60 * 24 * 14 },
            },
          },
          {
            urlPattern: /^https:\/\/[a-c]\.tile\.openstreetmap\.org\//,
            handler: 'CacheFirst',
            options: {
              cacheName: 'osm-kacheln',
              expiration: { maxEntries: 600, maxAgeSeconds: 60 * 60 * 24 * 30 },
              cacheableResponse: { statuses: [0, 200] },
            },
          },
        ],
      },
      devOptions: { enabled: false },
    }),
    frappeWebsitePage(),
  ],
  resolve: {
    alias: { '@': fileURLToPath(new URL('./src', import.meta.url)) },
  },
  server: {
    port: 8080,
    // Im Dev-Modus laeuft die Bench unter :8000 und liefert Session-Cookies.
    proxy: {
      '^/(api|files|private|assets)': {
        target: 'http://localhost:8000',
        changeOrigin: false,
        ws: true,
      },
    },
  },
  build: {
    outDir: resolve(APP_DIR, 'public/frontend'),
    emptyOutDir: true,
    target: 'es2022',
    sourcemap: true,
    chunkSizeWarningLimit: 900,
    rollupOptions: {
      output: {
        manualChunks: {
          vendor: ['vue', 'vue-router', 'pinia'],
          karte: ['leaflet'],
          offline: ['dexie'],
        },
      },
    },
  },
  test: {
    environment: 'node',
    include: ['src/**/*.test.ts'],
  },
}))
