{
  "name": "oekoinvest-web",
  "version": "0.4.0",
  "private": true,
  "browserslist": {
    "production": [
      "chrome >= 90",
      "firefox >= 90",
      "safari >= 15",
      "edge >= 90",
      "ios >= 15",
      "android >= 90"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "scripts": {
    "dev": "node --max-old-space-size=3072 node_modules/next/dist/bin/next dev --turbopack -p 3100",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./test/hilfen/registrieren.mjs --test --test-concurrency=1 \"test/**/*.test.mjs\" \"src/**/*.test.mjs\"",
    "test:charakterisierung": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/charakterisierung/rechner.test.mjs",
    "test:selbsttest": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/rechner/selbsttest.test.mjs",
    "test:snapshots:diff": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test/charakterisierung/diff.mjs",
    "test:snapshots:aktualisieren": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test/charakterisierung/aktualisieren.mjs",
    "lint:claims": "node qa/claim-lint.mjs",
    "qa:axe": "node qa/axe.mjs",
    "qa:axe-portal": "node qa/axe-portal.mjs",
    "qa:e2e": "node --test --test-concurrency=1 qa/e2e/funnel.e2e.mjs",
    "verify": "node qa/verify.mjs"
  },
  "dependencies": {
    "cookies-next": "^5.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.511.0",
    "next": "^15.5.26",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "^15.5.26",
    "tailwindcss": "^4"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
